import tokenize
from collections.abc import Callable
from typing import Any, Literal

__revision__: str

def getAutoCompleteList(
    command: str = ...,
    locals: dict[str, Any] | None = ...,
    includeMagic: int = ...,
    includeSingle: int = ...,
    includeDouble: int = ...,
) -> tuple[str, list[str]]: ...
def getAttributeNames(object: object, includeMagic: int = ..., includeSingle: int = ..., includeDouble: int = ...) -> list[str]: ...
def hasattrAlwaysReturnsTrue(object: object) -> bool: ...
def getAllAttributeNames(object: object) -> dict[tuple[str, str, int], list[str]]: ...
def getCallTip(command: str = ..., locals: dict[str, Any] | None = ...) -> tuple[str, str, str]: ...
def getRoot(command: str, terminator: str | None = ...) -> str: ...
def getTokens(command: str) -> list[tokenize.TokenInfo]: ...
def rtrimTerminus(command: str, terminator: str | None = ...) -> str: ...
def getBaseObject(object: object) -> tuple[Any, Literal[0, 1]]: ...
def getConstructor(object: type[object]) -> Callable[..., None] | None: ...

from collections.abc import Iterable, Iterator, Sequence
from typing import Any, ClassVar, Generic, Literal, Never, TypeVar, overload, type_check_only

import _apex
import hou
from apex.control_2 import ControlMapping, ControlTransformData

_T = TypeVar("_T")
_V = TypeVar("_V")

class AbstractControl(Control):
    # The second item is an apex::APEX_TypeDefinitionBase pointer, a C++ type with no python
    # binding: pybind11 raises TypeError for a list that has any, so only an empty one is seen
    # (and the setter rejects every non-empty list).
    spare_promoted: list[tuple[str, Never]]
    def __init__(self, scene: Scene, path: str, rig_path: str, nodeid: int = ...) -> None: ...

class AnimLayer:
    @staticmethod
    def buildLayerDataGeometry(
        geo: hou.Geometry,
        additive: bool = ...,
        muted: bool = ...,
        locked: bool = ...,
        soloed: bool = ...,
        child_layers: Sequence[str] = ...,
        color: hou.Color | None = ...,
        guid: str = ...,
    ) -> None: ...
    def color(self) -> hou.Color: ...
    def setColor(self, arg0: hou.Color) -> None: ...

class ChannelMergeMode:
    __members__: ClassVar[dict[str, ChannelMergeMode]]


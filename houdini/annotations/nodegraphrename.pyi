import hou
from PySide6 import QtGui, QtWidgets

RENAME_WINDOW_KEY: str
ICON_SIZE: int

class RenameWindow(QtWidgets.QDialog):
    editor: hou.NetworkEditor
    error_brush: QtGui.QBrush
    network_string: QtWidgets.QLineEdit
    old_path: str
    help_button: hou.qt.HelpButton
    find_box: QtWidgets.QLineEdit
    replace_box: QtWidgets.QLineEdit
    ignore_case_check: QtWidgets.QCheckBox
    unique_name_check: QtWidgets.QCheckBox
    whole_name_check: QtWidgets.QCheckBox
    selected_check: QtWidgets.QCheckBox
    table_view: QtWidgets.QTableWidget
    status_line: QtWidgets.QLabel
    ok_button: QtWidgets.QPushButton
    def __init__(self, editor: hou.NetworkEditor | None = ...) -> None: ...
    def update_from_editor(self, editor: hou.NetworkEditor) -> None: ...
    def place_near_mouse(self) -> None: ...
    def show_error(self, msg: str) -> None: ...
    def selection_changed(self, node: hou.Node, event_type: hou.EnumValue[hou.nodeEventType]) -> None: ...
    def find_networks(self, pattern: str) -> tuple[hou.Node, ...]: ...
    def change_select_callbacks(self) -> None: ...
    def update(self) -> None: ...
    def accept(self) -> None: ...
    def closeEvent(self, event: QtGui.QCloseEvent) -> None: ...

def show_rename_window(editor: hou.NetworkEditor) -> RenameWindow: ...

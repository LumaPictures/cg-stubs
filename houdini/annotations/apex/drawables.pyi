from typing import Protocol

import hou

class _HasSceneViewer(Protocol):
    @property
    def scene_viewer(self) -> hou.SceneViewer: ...

def getPrimHighlightColor(scene_viewer: hou.SceneViewer) -> tuple[float, float, float, float]: ...
def getPrimPreHighlightColor(scene_viewer: hou.SceneViewer) -> tuple[float, float, float, float]: ...
def createHighlightDrawables(scene_viewer: hou.SceneViewer, name: str) -> tuple[hou.GeometryDrawable]: ...
def createImageHighlightDrawables(scene_viewer: hou.SceneViewer, name: str) -> tuple[hou.GeometryDrawable]: ...
def addPrehighlightDrawable(self: _HasSceneViewer, scene_viewer: hou.SceneViewer, name: str) -> tuple[hou.GeometryDrawable]: ...

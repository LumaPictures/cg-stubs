class _AnimateState(fbik._AnimateState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members of the states it extends."""

# The frame range setting: a hou.Vector2 when it is the playbar's range, else (as the
# default, a bookmark's range or the HUD's value) an apex.IntArray.
_FrameRange: TypeAlias = hou.Vector2 | apex.IntArray

class GeoChannelsChangedUndo:
    path: str
    pre_channels: hou.Geometry | None
    post_channels: hou.Geometry | None
    def __init__(self, state: _AnimateState, path: str) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def cachePostChannels(self) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

def channelName(joint_path: str, name: str) -> str: ...

class FBIKParmHudWidget(fbik.FBIKParmHudWidget):
    ANIMATED_PARMS: tuple[str, ...]
    def __init__(
        self,
        tool: "FBIKAnimTool",
        hud_window: WidgetBundleWindow | None,
        tab_widget_name: str | None,
        tab_name: str | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> "FBIKAnimTool | None": ...
    def focusJoint(self, joint_path: str | None) -> None: ...
    def updateWeight(self) -> None: ...
    def startChannelsUndo(self) -> None: ...
    def endChannelsUndo(self) -> None: ...
    def findOrCreateChannels(self) -> hou.Geometry: ...
    def getChannelIndex(self, name: str) -> int | None: ...
    def getChannel(self, name: str) -> hou.ChannelPrim | None: ...
    def evalChannel(self, name: str, frame: float) -> float | None: ...
    # Channel names to their default values.
    def addChannels(self, channel_dict: Mapping[str, float]) -> None: ...
    def removeChannels(self, channel_dict: Mapping[str, float]) -> None: ...
    def clearChannels(self, channel_dict: Mapping[str, float]) -> None: ...
    def setChannels(self, channel_dict: Mapping[str, float], frame: float, force: bool = ...) -> None: ...
    def removeChannelKeys(self, channel_names: Collection[str], frame: float, all_keys: bool = ...) -> None: ...

RANGE_SETTING: str
AUTO_KEY_SETTING: str
SOLVER_PARM_DEFAULTS: dict[str, int | float | tuple[int, int]]
SETTINGS_DICT: dict[str, _HUDParmTemplate]

class FBIKSettingsHudWidget(fbik.FBIKSettingsHudWidget):
    def __init__(
        self,
        tool: "FBIKAnimTool",
        hud_window: WidgetBundleWindow | None,
        tab_widget_name: str | None,
        tab_name: str | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> "FBIKAnimTool | None": ...
    def getParmDefn(self) -> dict[str, _HUDParmTemplate]: ...

PARM_DICT: dict[str, _HUDParmTemplate]

class FBIKAnimTool(FBIKToolBase["FBIKAnimSubtool", FBIKParmHudWidget, FBIKSettingsHudWidget]):
    bookmark_manager: bm.RangeBookmarkManager
    parm_widget: FBIKParmHudWidget | None
    sett_widget: FBIKSettingsHudWidget | None
    def __init__(self, state: _AnimateState) -> None: ...
    @type_check_only
    @property
    def state(self) -> _AnimateState | None: ...
    def getParmDefn(self) -> dict[str, _HUDParmTemplate]: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def setupWidgets(self, channel_hud_tab_info: _TabInfo, settings_hud_tab_info: _TabInfo) -> None: ...
    def createSubtool(
        self, char_path: str, rest_skel: hou.Geometry, node_name: str, skel_name: str, rest_ctrl_skel: hou.Geometry | None
    ) -> "FBIKAnimSubtool": ...
    def savePlaybackOutputGeometry(self, geo: hou.Geometry) -> None: ...
    def onBakeEvent(self, kwargs: _BakeKwargs) -> Literal[True]: ...
    def onBookmarkChange(self) -> None: ...
    def updateBookmark(self, force: bool = ...) -> None: ...
    def onSolverParmChanged(self, parm_name: str, value: _ParmValue, active: bool) -> None: ...
    def refreshSolverTab(self) -> None: ...
    def solverParmDefaults(self) -> dict[str, int | float | tuple[int, int] | hou.Vector2]: ...
    def frameRange(self) -> _FrameRange: ...
    def autoKeyRange(self) -> bool: ...
    def onHUDParmEvent(self, kwargs: _ParmEventDict) -> Literal[True] | None: ...

class FBIKAnimSubtool(FBIKSubtoolBase):
    show_mapping: bool
    mapping_gadget: apexmapping.MappingGadget | None
    mapping_collection: apexmapping.MappingCollection
    enable_controls: bool
    channel_prims_path: str
    channel_collection_name: str
    preselected_joints: list[str] | None
    def __init__(
        self,
        tool: FBIKAnimTool,
        driven_char_path: str,
        rest_skel: hou.Geometry,
        node_name: str,
        skel_name: str,
        rest_ctrl_skel: hou.Geometry | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> FBIKAnimTool | None: ...
    @type_check_only
    @property
    def state(self) -> _AnimateState | None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def loadConfigFromSkeleton(self) -> None: ...
    def showMapping(self, on: bool) -> None: ...
    def buildMapping(self) -> None: ...
    def _buildFBIKGraph(self) -> apex.Graph: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def onPreSelectionChanged(self, kwargs: _PreSelectionChangedKwargs) -> Literal[False]: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def getJointFromControl(self, ctrl_path: str) -> str: ...
    def updateControlVisuals(self) -> None: ...
    def enableControls(self, on: bool) -> None: ...
    def updateRigParms(self, targets: bool) -> None: ...
    def effectEnabled(self) -> bool: ...
    def onPreEvaluationEvent(self, kwargs: float) -> None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def updateSolverGraphParmsFromTarget(self, frame: float | None) -> None: ...
    def solve(self, frame: float | None = ..., solve_controls: bool = ...) -> None: ...
    def updateFrameRange(self, old_range: _FrameRange) -> None: ...
    def addTargetsToLayer(self, joints: Iterable[str] | None = ...) -> None: ...
    def pinTargets(self) -> None: ...
    def unpinTargets(self) -> None: ...
    def matchTransforms(self) -> None: ...
    def addTargets(self, targets: Iterable[str] | None = ...) -> None: ...
    def removeTargets(self, targets: Iterable[str] | None = ...) -> None: ...
    def resetTargetConfig(self) -> None: ...
    def resetTargetAnimation(self, targets: Collection[str] | None = ...) -> None: ...
    def resetConfigAnimation(self, targets: Collection[str] | None = ..., remove: bool = ...) -> None: ...
    def addConfigChannels(self, targets: Collection[str] | None = ...) -> None: ...
    def keyTargetWeights(
        self, targets: Collection[str] | None = ..., value: float | None = ..., force: bool = ..., active: bool = ...
    ) -> None: ...
    def removeWeightKeys(self, all_keys: bool = ...) -> None: ...
    def addGeometryChannelCallbacks(self, kwargs: _CollectionNamesKwargs) -> None: ...
    def removeGeometryChannelCallbacks(self, kwargs: Mapping[str, object] | None = ...) -> None: ...
    def onChannelsActiveCallback(self, *args: *tuple[tuple[str, ...], str]) -> None: ...
    def onChannelsChangedCallback(self, *args: *tuple[tuple[str, ...], str]) -> None: ...
    def onParmWidgetValueChangeToGraph(self, kwargs: _ParmChangeKwargs) -> None: ...
    def onAnimatedParmAction(self, kwargs: _AnimatedParmActionKwargs) -> bool: ...
    def animatedParms(self) -> list[str]: ...
    def getScopedChannels(self, kwargs: Mapping[str, object]) -> dict[str, list[str]] | Literal[False]: ...
    def scopeChannels(self, kwargs: _ScopeChannelsKwargs) -> None: ...
    def pushChannels(self, kwargs: Mapping[str, object] = ...) -> None: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> bool: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> bool: ...
    def savePlaybackOutputGeometry(self, geo: hou.Geometry) -> None: ...

TOOL_MENU_NAME: str
TOOL_ACTIONS: list[ToolAction[FBIKAnimSubtool, object]]

def bindParametersToTemplate(template: hou.ViewerStateTemplate) -> None: ...
def bindActionsToMenu(menu: hou.ViewerStateMenu, hotkeys: Hotkeys) -> None: ...
def load(viewer_state: _AnimateState) -> FBIKAnimTool: ...

from typing import Any, Protocol

import apex
import hou
import apex.stateutils_2 as asu
from apex.animstack import ApexAnimStack
from apex.sceneevaluators import _SceneCallbacks
from apex.stateutils_2 import Hotkeys

class _AnimateState(asu._AnimateState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): the modules' base class uses only its shared members."""

class ApexAnimateBaseModule:
    def __init__(self, state: _AnimateState) -> None: ...
    # The state owns its modules, so it outlives them.
    @property
    def state(self) -> _AnimateState: ...
    @property
    def scene_viewer(self) -> hou.SceneViewer: ...
    @property
    def hotkeys(self) -> Hotkeys: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def scene_callbacks(self) -> _SceneCallbacks: ...
    @property
    def scene_node(self) -> hou.SopNode | None: ...
    @property
    def animstack(self) -> ApexAnimStack: ...
    @property
    def active_tool(self) -> asu._Tool | None: ...
    @property
    def is_playing_back(self) -> bool: ...
    @property
    def is_scrubbing(self) -> bool: ...
    # The state's toolEvent(eventname, *args, **kwargs): the tool's event handler's result, or False.
    def toolEvent(self, *args: *tuple[str, *tuple[object, ...]], **kwargs: object) -> Any: ...
    def runSceneCallbacks(self, *args: bool, **kwargs: bool) -> None: ...

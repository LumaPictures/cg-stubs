from collections.abc import Callable, Iterable, Mapping, Sequence
from typing import Literal, Protocol, type_check_only

from typing_extensions import TypedDict

import _apex
import apex
import apex.characterpathutils as acpu
import apex.stateutils_2 as asu
import apex.ui.glidehudwidgets as agui
import hou
from apex.xformgadget import _HandleStartUpdateKwargs, _HandleUpdateKwargs
from apex.autorigtool import _ToolActivateKwargs
from apex.characterpathutils import _AnimateState as _CharacterPathState
from apex.xformlimits import TransformLimitGuide
from houtypes import (
    ViewerStateDrawKwargs,
    ViewerStateEventKwargs,
    ViewerStateKwargs,
    ViewerStateMenuActionKwargs,
    ViewerStateMenuPreOpenKwargs,
    ViewerStateParmChangeKwargs,
)
from statehud.parmutils import _HUDParmValue
from statehud.window import _ParmEventDict

class _AnimateState(_CharacterPathState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""

    @property
    def xform_limit_guide(self) -> TransformLimitGuide: ...

# A target as the graph's config stores it (as an apex.Dict once the config is reloaded).
class _TargetConfig(TypedDict):
    id: int
    source_time: float
    time: float
    position: hou.Vector3
    is_anchor: bool

# What the Animate state passes a tool's onUpdateHandlePivotAndSettings().
class _UpdateHandleKwargs(TypedDict):
    update_pivot: bool

class TargetUndo(acpu.Undo):
    # The state's tool of this undo's module.
    @type_check_only
    def tool(self) -> "GlideTool | None": ...

class Target:
    @staticmethod
    def fromParmDict(config_dict: _TargetConfig | apex.Dict) -> Target | None: ...
    def asConfigDict(self) -> _TargetConfig: ...

class TargetSequence:
    @staticmethod
    def fromList(targets: Iterable[Target]) -> TargetSequence: ...
    # The python list until the graph's config is reloaded, an apex.DictArray after.
    @staticmethod
    def fromConfigDictList(config_dict_list: Iterable[_TargetConfig | apex.Dict]) -> TargetSequence: ...
    def asConfigDictList(self) -> list[_TargetConfig]: ...
    # The comparators return the signed time difference.
    def _find(self, comparator: Callable[[Target], float]) -> tuple[bool, int]: ...

class Mode:
    def onUpdateHandlePivotAndSettings(self, kwargs: _UpdateHandleKwargs) -> bool: ...
    def onPreLocateEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onPathControlSelectionChanged(self, ctrl_paths: Sequence[str]) -> None: ...
    def onPrimaryXformGadgetStartEvent(self, kwargs: _HandleStartUpdateKwargs) -> None: ...
    def onToolParmChanged(self, parm_name: str, val: _HUDParmValue) -> None: ...
    # Saved to the graph's config: an apex.Dict once the config is reloaded.
    def config(self) -> dict[str, _apex._ValueArg]: ...
    def loadConfig(self, config: Mapping[str, _apex._ValueArg] | apex.Dict) -> None: ...
    def hudRows(self) -> list[hou._HudRow]: ...

class EditMode(Mode):
    def onUpdateHandlePivotAndSettings(self, kwargs: _UpdateHandleKwargs) -> bool: ...
    def onPathControlSelectionChanged(self, ctrl_paths: Sequence[str]) -> None: ...
    def onPrimaryXformGadgetStartEvent(self, kwargs: _HandleStartUpdateKwargs) -> None: ...
    def onToolParmChanged(self, parm_name: str, val: _HUDParmValue) -> None: ...
    def config(self) -> dict[str, _apex._ValueArg]: ...
    def loadConfig(self, config: Mapping[str, _apex._ValueArg] | apex.Dict) -> None: ...
    def hudRows(self) -> list[hou._HudRow]: ...

class BrushMode(Mode):
    def onPreLocateEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[True]: ...
    def onMouseWheelEvent(self, event: hou.ViewerEvent) -> Literal[True]: ...
    def onToolParmChanged(self, parm_name: str, val: _HUDParmValue) -> None: ...
    def config(self) -> dict[str, _apex._ValueArg]: ...
    def loadConfig(self, config: Mapping[str, _apex._ValueArg] | apex.Dict) -> None: ...
    def hudRows(self) -> list[hou._HudRow]: ...
    def onAdjustRadius(self, delta: float) -> None: ...

class AddMode(Mode):
    def onMouseEvent(self, event: hou.ViewerEvent) -> Literal[True]: ...

class RemoveMode(Mode):
    def onPathControlSelectionChanged(self, ctrl_paths: Sequence[str]) -> None: ...
    def onRemoveTargets(self, ctrl_paths: Iterable[str]) -> None: ...

class RetimeMode(Mode):
    def onPreLocateEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onToolParmChanged(self, parm_name: str, val: _HUDParmValue) -> None: ...
    def config(self) -> dict[str, _apex._ValueArg]: ...
    def loadConfig(self, config: Mapping[str, _apex._ValueArg] | apex.Dict) -> None: ...

class UndoStash:
    graph: apex.Graph | None

class GlideTool(acpu.CharacterPathToolBase[_AnimateState]):
    graph_builder: GraphBuilder
    # None while the tool is inactive.
    hud_widget: agui.GlideParmsWidget | None
    settings_widget: agui.GlideSettingsWidget | None
    hud_rows: list[hou._HudRow]
    def __init__(self, state: _AnimateState) -> None: ...
    def _filterRigControlPaths(self, ctrl_paths: Iterable[str]) -> list[str]: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> bool: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    def onInterrupt(self, kwargs: ViewerStateKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onUpdateHandlePivotAndSettings(self, kwargs: _UpdateHandleKwargs) -> bool: ...
    def onPreLocateEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onSelectionChanged(self, control_selection: Sequence[str]) -> None: ...
    # The mouse event's kwargs, or the transform gadget's.
    def onPoseStartEvent(self, kwargs: ViewerStateEventKwargs | _HandleStartUpdateKwargs) -> None: ...
    def onPrimaryXformGadgetStartEvent(self, kwargs: _HandleStartUpdateKwargs) -> None: ...
    def onPoseEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> None: ...
    def onPoseEndEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> None: ...
    # The bake parameters of the Animate state's settings HUD.
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onToolParmChanged(self, parm_name: str, val: _HUDParmValue) -> None: ...
    def onHUDParmEvent(self, kwargs: _ParmEventDict) -> None: ...
    def createTargets(self, target_templates: Iterable[tuple[float, float, hou.Vector3]]) -> None: ...
    def removeTargets(self, ctrl_paths: Iterable[str]) -> None: ...
    def createAnchors(self, tweak_ctrl_paths: Iterable[str], is_anchor: bool) -> None: ...
    def extractPreselection(self, kwargs: ViewerStateEventKwargs) -> list[str]: ...
    def _sharedHudRows(self) -> list[hou._HudRow]: ...

def load(state: _AnimateState) -> GlideTool: ...
def bindActionsToMenu(menu: hou.ViewerStateMenu, hotkeys: asu.Hotkeys) -> None: ...

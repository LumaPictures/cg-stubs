import ast
from typing import Any

# locals_dict is the snippet's namespace (names to classes, functions, modules, values), and the
# found variables map to an instance of whatever class names their value or annotation: their
# values can be anything. It must be a dict: collectVariables() merges it with `|`.
class VariableCollector:
    myFoundVars: dict[str, Any]
    locals_dict: dict[str, Any]
    def __init__(self, locals_dict: dict[str, Any]) -> None: ...
    def generic_visit(self, node: ast.AST) -> None: ...
    def visit_Assign(self, node: ast.Assign) -> None: ...
    def visit_AnnAssign(self, node: ast.AnnAssign) -> None: ...

def collectVariables(source: str, locals_dict: dict[str, Any]) -> dict[str, Any]: ...

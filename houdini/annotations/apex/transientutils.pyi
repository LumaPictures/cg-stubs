from typing import NoReturn

import _apex
import apex
import hou
from apex.bookmarkmanager import _BookmarkMetadata

def getUniqueTransientID(data: apex.Dict) -> int: ...
def validateTransientEntry(entry: apex.Dict, type_name: str) -> bool: ...

# (path, the transient data, the entry for uuid: an apex.Dict as buildTransientEntry() makes);
# all None when the scene has no data path for the type in that layer.
def getTransientData(
    scene: apex.Scene, type_name: str, folder: str = ..., layer: str | None = ..., uuid: int | str | None = ...
) -> tuple[str, apex.Dict | None, apex.Dict | None] | tuple[None, None, None]: ...
def removeTransientEntry(
    scene: apex.Scene, type_name: str, uuid: int | str, key: str | None = ..., folder: str = ..., layer: str | None = ...
) -> bool: ...
def updateTransientEntryMetadataFromDict(
    scene: apex.Scene, type_name: str, uuid: int | str, metadata: _BookmarkMetadata, folder: str = ..., layer: str | None = ...
) -> bool: ...

# Always raises NameError: it tests an undefined `name` (and calls an undefined updateTransientEntryMetaDataFromDict).
def updateTransientEntryMetadata(
    scene: apex.Scene,
    type_name: str,
    uuid: int | str,
    label: str | None = ...,
    start_frame: int | None = ...,
    end_frame: int | None = ...,
    folder: str = ...,
    layer: str | None = ...,
) -> NoReturn: ...
def getTransientEntryMetadata(
    scene: apex.Scene, type_name: str, uuid: int | str, folder: str = ..., layer: str | None = ...
) -> _BookmarkMetadata | None: ...
def addTransientEntry(scene: apex.Scene, type_name: str, entry: apex.Dict, folder: str = ..., layer: str | None = ...) -> int: ...
def buildTransientEntry(label: str, start_frame: int, end_frame: int, data: _apex._ValueArg, color: hou.Color = ...) -> apex.Dict: ...

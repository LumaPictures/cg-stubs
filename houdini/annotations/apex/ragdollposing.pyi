from collections.abc import Container, Iterable, Mapping, Sequence
from typing import Literal

from typing_extensions import TypedDict

import apex
import apex.stateutils_2 as asu
import hou
from apex.xformgadget import _HandleStartUpdateKwargs, _HandleUpdateKwargs
from apex.ragdollbase import RagdollStateBase, _AnimateState
from apex.ragdolltool_2 import _RagdollActivateKwargs
from apex.scene_2 import SceneOutputDrawable
from apex.ui.ragdollwidgets import RagdollPosingParameterWidget, RagdollPosingSliderWidget
from houtypes import (
    ViewerParmProperties,
    ViewerStateDrawKwargs,
    ViewerStateEventKwargs,
    ViewerStateMenuActionKwargs,
    ViewerStateMenuPreOpenKwargs,
    ViewerStateParmChangeKwargs,
    ViewerStatePlaybackChangeKwargs,
)
from kinefx.stateutils import KinefxPackedHighlighter
from statehud.parmutils import _HUDParmValue
from statehud.window import _ParmEventDict

class _GravityPoseKwargs(TypedDict, total=False):
    """What `RagdollPosing.onMouseWheelEvent` passes its own pose events to pose with gravity."""

    use_gravity: bool
    gravity: hou.Vector3

class RagdollPosing(RagdollStateBase[RagdollPosingSliderWidget, RagdollPosingParameterWidget]):
    slider_hk: str
    activate_shapes_hk: str
    hud_rows: list[hou._HudRow]
    hud_widget: RagdollPosingSliderWidget | None
    settings_widget: RagdollPosingParameterWidget | None
    groundplane_drawable: SceneOutputDrawable | None
    prev_channels: list[hou.Geometry]
    prehighlighters: dict[hou.Drawable, KinefxPackedHighlighter]
    def __init__(self, viewer_state: _AnimateState) -> None: ...
    @property
    def channelprims_extension(self) -> str: ...
    @property
    def key_source_controls(self) -> list[apex.Control]: ...
    @key_source_controls.setter
    def key_source_controls(self, v: list[apex.Control]) -> None: ...
    @property
    def default_display_mode(self) -> int: ...
    @staticmethod
    def setPoseChannelValue(channel: hou.ChannelPrim, newval: float) -> None: ...
    def onActivate(self, kwargs: _RagdollActivateKwargs) -> Literal[True]: ...
    def onPreEvaluationEvent(self, time: float) -> None: ...
    def onPostEvaluationEvent(self, time: float) -> Literal[True]: ...
    def displayModeToken(self, mode: int) -> str: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onHUDSettingEvent(self, kwargs: _ParmEventDict) -> None: ...
    def onCommand(self, command: str, args: Mapping[str, object]) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def selectionSetsSelectControls(
        self, ctrl_paths: Iterable[str], cur_ctrl: str | None, pick_modifier: hou.EnumValue[hou.pickModifier]
    ) -> None: ...
    def selectionSetsShowControls(self, ctrl_paths: Iterable[str], pick_modifier: hou.EnumValue[hou.pickModifier]) -> None: ...
    def getCurrentSelectedControlPath(self) -> str | None: ...
    def selectionSetsPinControls(self, ctrl_paths: Iterable[str], pick_modifier: hou.EnumValue[hou.pickModifier]) -> None: ...
    def frameSelectedControls(self) -> list[hou.Geometry]: ...
    def onUpdateParmsAndControlsFromWidget(self, control_parms: Sequence[str] | None = ...) -> Literal[True]: ...
    def onPoseStartEvent(self, kwargs: ViewerStateEventKwargs | _HandleStartUpdateKwargs | _GravityPoseKwargs) -> None: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onPoseEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs | _GravityPoseKwargs) -> None: ...
    def onPoseEndEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> Literal[True]: ...
    def onStartRecordingEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> Literal[True]: ...
    def onStopRecordingEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> Literal[True]: ...
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> Literal[True]: ...
    def onPoseEndPreKeyEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs | _GravityPoseKwargs) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def addGeometryChannelCallbacks(self, collection_names: Iterable[str]) -> None: ...
    def removeGeometryChannelCallbacks(self) -> None: ...
    def onGeometryChannelsChanged(self, channels: tuple[str, ...], cl_name: str) -> None: ...
    def getScopedChannels(self) -> dict[str, list[str]]: ...
    def scopeChannels(
        self,
        channel_list: hou.ChannelList,
        scoped_channels: Mapping[str, Sequence[str]],
        pinned_channels: Mapping[str, Iterable[str]],
    ) -> None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def resetPosing(self) -> None: ...
    def startPosing(
        self, sel_source_ctrls: Iterable[apex.Control], disable_ragdoll_char_names: Container[str], use_gravity: bool
    ) -> None: ...
    def updatePosing(self, time: float | None = ..., gravity: hou.Vector3 | None = ...) -> None: ...
    def endPosing(self) -> None: ...
    def getSourceControlsFromActiveShapes(self) -> list[apex.Control]: ...
    def updateStateParms(self, state_parms: Mapping[str, ViewerParmProperties]) -> None: ...
    def doDeintersect(self) -> Literal[True]: ...
    def setDoDeintersectOnChannels(self, data_paths: Iterable[str], add: bool) -> apex.Dict: ...
    def restoreChannels(self, prev_channels: apex.Dict) -> None: ...
    def setSolverParms(self, parms: apex.Dict) -> None: ...
    def setChannelValue(
        self,
        cl_name: str,
        channel: hou.ChannelPrim,
        newval: float,
        key: bool = ...,
        interpolation: hou.EnumValue[hou.segmentType] | None = ...,
        frame: float | None = ...,
    ) -> None: ...

class PosingUndo:
    @property
    def state(self) -> RagdollPosing | None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

def load(viewer_state: _AnimateState) -> RagdollPosing: ...
def bindParametersToTemplate(template: hou.ViewerStateTemplate) -> None: ...
def bindActionsToMenu(menu: hou.ViewerStateMenu, hotkeys: asu.Hotkeys) -> None: ...

from collections.abc import Callable, Iterable, KeysView, Mapping
from typing import Literal, Never, Protocol, TypeAlias, TypedDict, TypeVar, type_check_only

import apex
import hou
from apex.autorigtool import _ToolActivateKwargs
from apex.effecttool import (
    EffectParmHudWidget,
    EffectParmSelectable,
    EffectSubtool,
    EffectTool,
    _ActionButtonKwargs,
    _AnimateState as _EffectState,
    _ParmChangeKwargs,
    _ParmValue,
    _PoseKwargs,
    _TabInfo,
)
from houtypes import ViewerStateEventKwargs, ViewerStatePlaybackChangeKwargs
from statehud.parmwidgetset import _HUDParmTemplate, _MenuItem
from statehud.window import WidgetBundleWindow

class _AnimateState(_EffectState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members of the states it extends."""

# A subclass's own kinds of subtools and widgets.
_ST_co = TypeVar("_ST_co", bound="FBIKSubtoolBase", default="FBIKSubtoolBase", covariant=True)
_HW_co = TypeVar("_HW_co", bound="FBIKParmHudWidget", default="FBIKParmHudWidget", covariant=True)
_SW_co = TypeVar("_SW_co", bound="FBIKSettingsHudWidget", default="FBIKSettingsHudWidget", covariant=True)

class _PinType(TypedDict):
    display_name: str
    color: hou.Vector3

# A target's settings (type, priority, weight, usedepth, depth, follow, and the anim tool's pinned).
_TargetConfig: TypeAlias = dict[str, bool | int | float]

UNPINNED_COLOR: hou.Vector3
PINNED_SHAPE_OFFSET: hou.Matrix4
UNPINNED_SHAPE_OFFSET: hou.Matrix4
OTHER_SHAPE_OFFSET: hou.Matrix4
PIN_TYPES: list[_PinType]
SOLVER_PARM_DEFAULTS: dict[str, int | float]
SETTINGS_DICT: dict[str, _HUDParmTemplate]
target_labels: list[str]
target_menu_items: list[_MenuItem]
TARGET_PARM_DEFAULTS: _TargetConfig
PARM_DICT: dict[str, _HUDParmTemplate]

class FBIKSettingsHudWidget(EffectParmHudWidget):
    def __init__(
        self,
        tool: "FBIKToolBase",
        hud_window: WidgetBundleWindow | None,
        tab_widget_name: str | None,
        tab_name: str | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> "FBIKToolBase | None": ...
    def getParmDefn(self) -> dict[str, _HUDParmTemplate]: ...

class FBIKParmHudWidget(EffectParmHudWidget):
    def __init__(
        self,
        tool: "FBIKToolBase",
        hud_window: WidgetBundleWindow | None,
        tab_widget_name: str | None,
        tab_name: str | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> "FBIKToolBase | None": ...
    def getParmDefn(self) -> dict[str, _HUDParmTemplate]: ...

class FBIKTargetsChangedUndo:
    subtool: "FBIKSubtoolBase"
    prev_targets: apex.Dict
    post_targets: apex.Dict
    def __init__(self, subtool: "FBIKSubtoolBase", prev_targets: apex.Dict, post_targets: apex.Dict = ...) -> None: ...

class FBIKSolverSettingsChangedUndo:
    tool: "FBIKToolBase"
    prev_settings: apex.Dict
    post_settings: apex.Dict
    def __init__(self, tool: "FBIKToolBase", prev_settings: apex.Dict, post_settings: apex.Dict) -> None: ...

class FBIKToolBase(EffectTool[_ST_co, _HW_co, _SW_co]):
    name: str
    tool_name: str
    tool_path: str
    posing: bool
    subtools: list[_ST_co]
    add_target_hk: str
    rem_target_hk: str
    confirm_hk: str
    exit_hk: str
    default_hud_rows: list[hou._HudRow]
    solver_settings: apex.Dict
    parm_widget: _HW_co | None
    sett_widget: _SW_co | None
    def __init__(self, state: _AnimateState, name: str, tool_name: str, posing: bool = ...) -> None: ...
    @type_check_only
    @property
    def state(self) -> _AnimateState | None: ...
    def targetParmDefaults(self) -> _TargetConfig: ...
    def solverParmDefaults(self) -> dict[str, int | float]: ...
    def getRigPathMappings(self) -> dict[str, dict[str, str]]: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> bool: ...
    def onDeactivate(self) -> None: ...
    def setupWidgets(self, channel_hud_tab_info: _TabInfo, settings_hud_tab_info: _TabInfo) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> bool | None: ...
    # The channel list module's getScopedControls tool event passes {}.
    def getScopedControls(self, kwargs: Mapping[str, Never]) -> list[str] | Literal[False]: ...
    def onPoseEndEvent(self, kwargs: _PoseKwargs) -> bool | None: ...
    def onPrePlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> bool | None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> bool | None: ...
    def onButtonClick(self, parm_name: str) -> bool | None: ...
    def onParmValueChange(
        self,
        parm_name: str,
        val: _ParmValue,
        active: bool = ...,
        start_slider: bool = ...,
        end_slider: bool = ...,
        focused_subtool_only: bool = ...,
    ) -> bool | None: ...
    def onSolverParmChanged(self, parm_name: str, value: _ParmValue, active: bool) -> None: ...
    def resetSolverParms(self, parms: apex.Dict | None = ...) -> None: ...
    def refreshSolverTab(self) -> None: ...
    def loadSolverSettings(self) -> None: ...
    def saveSolverSettings(self) -> None: ...

class FBIKSubtoolBase(EffectSubtool):
    fbik_rig_path: str
    targets_changed_undo: FBIKTargetsChangedUndo | None
    targets: apex.Dict
    default_targets: apex.Dict | dict[str, _TargetConfig]
    joint_config_name: str
    target_config_name: str
    mapping_property_name: str
    selectable_parm: EffectParmSelectable | None
    def __init__(
        self,
        tool: FBIKToolBase,
        driven_char_path: str,
        rest_skel: hou.Geometry,
        node_name: str,
        skel_name: str,
        rest_ctrl_skel: hou.Geometry | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> FBIKToolBase | None: ...
    @type_check_only
    @property
    def state(self) -> _AnimateState | None: ...
    def targetParmDefaults(self) -> _TargetConfig: ...
    def fbik_rig(self) -> apex.SceneGraph | None: ...
    def fbik_control_manager(self) -> apex.ControlManager | None: ...
    def fbik_control_template(self) -> hou.Geometry | None: ...
    def fbik_anim_binding(self) -> apex.ChannelPrimBindings | None: ...
    def _getMappedJoints(self) -> KeysView[str]: ...
    def _getControlPathFromJointName(self, joint_name: str) -> str | None: ...
    def _buildFBIKGraph(self, animatable: bool = ...) -> apex.Graph: ...
    def updateControlShape(self, pt: hou.Point, is_target: bool, joint_name: str, ctrl_name: str) -> bool: ...
    def updateControlVisuals(self) -> None: ...
    def _startTargetsChangedUndo(self) -> None: ...
    def _endTargetsChangedUndo(self) -> None: ...
    def getDefaultTargetConfig(self, target: str) -> _TargetConfig: ...
    def addTargets(self, targets: Iterable[str] | None = ...) -> list[str]: ...
    def removeTargets(self, targets: Iterable[str] | None = ...) -> list[str]: ...
    def setTargets(self, targets: apex.Dict) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def getJointFromControl(self, ctrl_path: str) -> str: ...
    def getSelectedJoints(self, selection: Iterable[str] | None = ...) -> list[str]: ...
    def getPrimaryJoint(self) -> str: ...
    def hasPrimaryControl(self) -> bool | Literal[""] | None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> Literal[False]: ...
    def setFBIKControlsEnabled(self, on: bool) -> None: ...
    def getSavedConfiguration(self) -> dict[str, _TargetConfig] | None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def createChannelManager(
        self, *args: *tuple[_EffectState, str, Callable[[], object] | None, str, str | None]
    ) -> None: ...
    def getMappedFBIKControlsToSelect(self) -> list[str | None] | None: ...
    def onDeactivate(self) -> Literal[False]: ...
    def onParmWidgetValueChangeToGraph(self, kwargs: _ParmChangeKwargs) -> None: ...
    def onTargetParmChanged(self, parm_name: str, value: _ParmValue, active: bool) -> None: ...
    def onButtonClick(self, kwargs: _ActionButtonKwargs) -> None: ...

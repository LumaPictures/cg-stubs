from collections.abc import Collection, Container, Iterable
from typing import Literal, Protocol

import apex
import hou
from apex.bake import _AnimateState as _BakeState
from apex.constraintutils import _AnimateState as _ConstraintState
from apex.mapping_2 import MappingGadget
from apex.mapping_2 import _AnimateState as _MappingState
from apex.scenebookmarkmanager import SceneBookmarkManager, _DataId
from apex.scenebookmarkmanager import _AnimateState as _BookmarkState
from apex.sceneevaluators import AnimTracker
from houtypes import ViewerStateDrawKwargs, ViewerStateKwargs, ViewerStatePlaybackChangeKwargs

class _AnimateState(_BookmarkState, _BakeState, _ConstraintState, _MappingState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""

    def changingCollections(self) -> bool: ...

class TransientConstraintManager(SceneBookmarkManager):
    # Each driven control of the pushed transient constraints to its entry's id.
    driven_ctrls: dict[str, _DataId]
    # Keyed by the str of the entries' ids.
    mapping_gadgets: dict[str, MappingGadget]
    anim_layer_name: str
    # The active layer before setLayer() switched to the bake layer.
    current_layer: str | None
    bake_mode: "BakeMode"
    control_paths: list[str]
    anim_tracker: AnimTracker
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def setAutoUpdate(self, on: bool) -> None: ...
    def showMapping(self, on: bool) -> None: ...
    def setBakeToNewLayer(self, on: bool) -> None: ...
    def setBakeMode(self, mode: "BakeMode") -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onInterrupt(self, state: _AnimateState, kwargs: ViewerStateKwargs) -> None: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    def onPrePlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def onPostEvaluationEvent(self, time: float) -> None: ...
    def onPoseStartPreInitEvent(self, selected_ctrls: Container[str]) -> Literal[True]: ...
    def onPoseEndEvent(self) -> Literal[True]: ...
    def onChannelsChangeStartEvent(self, collection_name: str, channel_names: Container[str]) -> None: ...
    def onChannelsChangeEndEvent(self, collection_name: str, channel_names: Container[str]) -> None: ...
    def updateTrackedDataIds(self) -> bool: ...
    def pushTransientConstraints(self, frame: float, controls_to_skip: Container[str] = ...) -> None: ...
    def updateConstraintMatrices(self, visible: bool = ..., mode: "MatrixUpdate" = ..., ctrls: Container[str] | None = ...) -> None: ...
    # The entries removed (those visible at the frame), by id.
    def removeConstraints(self, frame: float) -> dict[_DataId, apex.Dict]: ...
    def dirtyConstraints(self, layer: str | None = ...) -> None: ...
    def bakeConstraints(self, frame: float | None = ...) -> bool: ...
    def onBookmarkInteractionStartedEvent(self, bookmark_id: int) -> bool: ...
    def onBookmarkInteractionFinishedEvent(self, bookmark_id: int) -> bool: ...
    def onBookmarkDeletedEvent(self, bookmark_id: int) -> bool: ...
    def onBookmarkModifiedEvent(self, bookmark_id: int) -> bool: ...
    def addBookmarksForControls(self, ctrl_paths: Collection[str]) -> None: ...
    def setLayerName(self, name: str) -> None: ...
    def setLayer(self, driven: Iterable[str]) -> None: ...

def loadLegacyBookmarks(scene: apex.Scene, geo: hou.Geometry | None = ..., remove_bookmarks: bool = ...) -> None: ...

from collections.abc import Mapping
from typing import Literal, Never, type_check_only

import apex
import hou
from apex.autorigtool import _ToolActivateKwargs
from apex.effecttool import _PoseKwargs
from apex.fbikbase import FBIKSubtoolBase, FBIKToolBase, _AnimateState
from apex.stateutils_2 import Hotkeys, SetChannelsUndo
from apex.toolutils import ToolAction
from houtypes import ViewerStateMenuActionKwargs, ViewerStateParmChangeKwargs, ViewerStatePlaybackChangeKwargs

class FBIKonPoseChangeUndo:
    subtool: "FBIKPosingSubtool"
    prev_parms: apex.Dict
    post_parms: apex.Dict
    def __init__(self, subtool: "FBIKPosingSubtool", prev_parms: apex.Dict, post_parms: apex.Dict) -> None: ...

class FBIKsetChannelsUndo:
    subtool: "FBIKPosingSubtool"
    set_channels_undo: SetChannelsUndo
    def __init__(self, subtool: "FBIKPosingSubtool", set_channels_undo: SetChannelsUndo) -> None: ...

class FBIKPosingTool(FBIKToolBase["FBIKPosingSubtool"]):
    def __init__(self, state: _AnimateState) -> None: ...
    def createSubtool(
        self, char_path: str, rest_skel: hou.Geometry, node_name: str, skel_name: str, rest_ctrl_skel: hou.Geometry | None
    ) -> "FBIKPosingSubtool": ...

class FBIKPosingSubtool(FBIKSubtoolBase):
    effect_enabled: bool
    pose_changed: bool
    prev_parms: apex.Dict | None
    test: hou.Geometry
    def __init__(
        self,
        tool: FBIKPosingTool,
        driven_char_path: str,
        rest_skel: hou.Geometry,
        node_name: str,
        skel_name: str,
        rest_ctrl_skel: hou.Geometry | None,
    ) -> None: ...
    @type_check_only
    @property
    def tool(self) -> FBIKPosingTool | None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def onPoseStartEvent(self, kwargs: _PoseKwargs) -> None: ...
    def onPoseEvent(self, kwargs: _PoseKwargs) -> None: ...
    def onPoseEndEvent(self, kwargs: _PoseKwargs) -> None: ...
    def onPrePlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> Literal[True]: ...
    def updateSolverGraphParmsFromTarget(self) -> None: ...
    def solve(self, posing: bool = ...) -> None: ...
    def updateControlTransforms(self, skel: hou.Geometry, posing: bool = ...) -> None: ...
    def updateSkeleton(self, anim: bool = ..., posing: bool = ...) -> None: ...
    def setDrivenRigParms(self, parms: apex.Dict) -> None: ...
    def _createChannelsUndoAction(self, prev_channels: hou.Geometry, current_channels: hou.Geometry | None) -> FBIKsetChannelsUndo: ...
    # The channel list module's getScopedControls tool event passes {}.
    def getScopedControls(self, kwargs: Mapping[str, Never]) -> list[str]: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> bool: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> bool: ...

TOOL_MENU_NAME: str
TOOL_ACTIONS: list[ToolAction[FBIKPosingSubtool, object]]

def bindParametersToTemplate(template: hou.ViewerStateTemplate) -> None: ...
def bindActionsToMenu(menu: hou.ViewerStateMenu, hotkeys: Hotkeys) -> None: ...
def load(viewer_state: _AnimateState) -> FBIKPosingTool: ...

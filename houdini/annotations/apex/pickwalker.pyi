from collections.abc import Callable, Collection, Iterable, Mapping, Sequence
from typing import Protocol

import _apex
import hou
from apex import apexriggraphutils as aru
from apex import stateutils_2 as asu
from hutil.PySide.QtCore import QTimer
from houtypes import ViewerStateEventKwargs

class _AnimateState(asu._AnimateState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""

    def _groupPrimaryToGroup(self, control_path: str) -> str | None: ...
    def _refreshControlData(self) -> None: ...
    def getChildOrdering(self, control_path: str) -> list[str]: ...
    def getPickWalkData(self, sel_controls: Sequence[str] | None = ...) -> tuple[dict[str, "PickWalkRig"], dict[str, list[str]]]: ...

DEFAULT_FINGER_ORDERING: _apex.StringArray
DEFAULT_BODYSIDE_ORDERING: _apex.StringArray
DEFAULT_ROOT_ORDERING: _apex.StringArray
DEFAULT_CHEST_ORDERING: _apex.StringArray
DEFAULT_FOOT_ORDERING: _apex.StringArray
HOTKEY_KEYNAME_MAPPINGS: dict[str, str]

class PickWalkRig:
    rig_path: str
    graph_or_skel: hou.Geometry | _apex.Graph
    skel: hou.Geometry | None
    graph: _apex.Graph | None
    control_to_joint: Callable[[str], str] | None
    joint_to_control: Callable[[str], str] | None
    position_cb: Callable[[str, str], hou.Vector3 | None] | None
    parent_lookup_cb: Callable[[str, str], str | None] | None
    def __init__(
        self,
        rig_path: str,
        graph_or_skel: hou.Geometry | _apex.Graph,
        control_to_joint: Callable[[str], str] | None = ...,
        joint_to_control: Callable[[str], str] | None = ...,
        position_cb: Callable[[str, str], hou.Vector3 | None] | None = ...,
        parent_lookup_cb: Callable[[str, str], str | None] | None = ...,
    ) -> None: ...
    def _parentLookup(self, control_name: str) -> str | None: ...

class PickWalkerCache:
    parent_maps: dict[str, dict[str, str]]
    child_maps: dict[str, dict[str, list[str]]]
    def getDepthMap(self, pick_walk_rig: PickWalkRig, node_name_filter: set[str], roots: Iterable[str] | None = ...) -> dict[str, int]: ...
    def getHeightMap(self, pick_walk_rig: PickWalkRig, node_name_filter: set[str], roots: Collection[str] | None = ..., leaves: Iterable[str] | None = ...) -> dict[str, int]: ...
    def getParentWrapper(self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...) -> str | None: ...
    def getFirstChild(self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...) -> str | None: ...
    def getChildren(self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...) -> list[str]: ...
    def getDescendants(
        self,
        pick_walk_rig: PickWalkRig,
        control_names: Collection[str],
        node_name_filter: set[str],
        first_branch_only: bool = ...,
        child_orderer: aru.ChildOrderer | None = ...,
    ) -> list[str]: ...
    def getNextSibling(self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...) -> str | None: ...
    def getPrevSibling(self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...) -> str | None: ...
    def buildLocalHierarchy(
        self, pick_walk_rig: PickWalkRig, control_name: str, node_name_filter: set[str], child_orderer: aru.ChildOrderer | None = ...
    ) -> tuple[hou.Geometry, hou.Geometry, dict[int, hou.Vector3]]: ...

class PickWalkGuide:
    scene_viewer: hou.SceneViewer
    local_guide_drawable: hou.SimpleDrawable
    local_guide_points_drawable: hou.GeometryDrawable
    primary_pt_circle_drawable: hou.GeometryDrawable
    key_map: dict[int, str]
    text_drawables: dict[int, hou.TextDrawable]
    next_key_posns: dict[int, hou.Vector3]
    timer: QTimer
    def draw(self, draw_handle: int) -> None: ...
    def unloadDrawables(self) -> None: ...
    def setGeometry(self, local_guide_skel: hou.Geometry, p0_geo: hou.Geometry, next_key_posns: dict[int, hou.Vector3]) -> None: ...
    def show(self, val: bool, auto_hide: bool = ...) -> None: ...
    def hide(self) -> None: ...

class PickWalker:
    hotkeys: asu.Hotkeys
    pick_walk_cache: PickWalkerCache
    pick_walk_guide: PickWalkGuide
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def draw(self, draw_handle: int) -> None: ...
    def unloadDrawables(self) -> None: ...
    def hideGuideSkel(self) -> None: ...
    def showGuideSkel(self, local_guide_skel: hou.Geometry, p0_geo: hou.Geometry, next_key_posns: dict[int, hou.Vector3], auto_hide: bool = ...) -> None: ...
    def matchRigs(
        self,
        ctrl_A: str,
        ctrl_B: str,
        rig_to_all_controls: Mapping[str, Iterable[str]] | None = ...,
        names_only: bool = ...,
        child_ordering_fn: Callable[[str], list[str]] | None = ...,
        branch_only: bool = ...,
    ) -> list[tuple[str, str]]: ...
    def selectDescendants(self, controls_list: Sequence[str] | None = ...) -> None: ...
    def getDescendants(self, controls_list: Sequence[str], rig_to_all_controls: Mapping[str, Iterable[str]] | None = ..., first_branch_only: bool = ...) -> list[str]: ...
    def getChildren(self, controls_list: Sequence[str], rig_to_all_controls: Mapping[str, Iterable[str]] | None = ..., exclude_parents: bool = ...) -> list[str]: ...
    def getParentMap(self, controls_list: Sequence[str], rig_to_all_controls: Mapping[str, Iterable[str]] | None = ..., exclude_selected: bool = ...) -> dict[str, str]: ...
    def getDescendantPath(self, ctrl_A: str, ctrl_B: str, rig_to_all_controls: Mapping[str, Iterable[str]] | None = ...) -> list[str]: ...
    # next_controls_fn is one of the cache's getParentWrapper/getFirstChild/getChildren/get*Sibling.
    def _walk(
        self,
        next_controls_fn: Callable[[PickWalkRig, str, set[str], aru.ChildOrderer], str | list[str] | None],
        pick_modifier: hou.EnumValue[hou.pickModifier] | None,
        need_ordering: bool = ...,
    ) -> None: ...
    def walkUp(self, pick_modifier: hou.EnumValue[hou.pickModifier] | None = ...) -> None: ...
    def walkDown(self, pick_modifier: hou.EnumValue[hou.pickModifier] | None = ...) -> None: ...
    def walkLeft(self, pick_modifier: hou.EnumValue[hou.pickModifier] | None = ...) -> None: ...
    def walkRight(self, pick_modifier: hou.EnumValue[hou.pickModifier] | None = ...) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...

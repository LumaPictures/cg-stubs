from collections.abc import Callable, Iterable, Mapping, MutableMapping, Sequence
from typing import Any, ClassVar, ParamSpec, Protocol, TypedDict, TypeVar

import hou
import apex.stateutils_2 as asu
from _apexscene import AnimLayer, Scene
from apex.ui.animationlayers.model import _WeightChangeType

_P = ParamSpec("_P")
_R = TypeVar("_R")

class _ActiveLayerChangedKwargs(TypedDict):
    prev_active: str
    active: str

# The APEX animate viewer state (packages/apex/viewer_states/apexanimate.py's State).
class _AnimateState(asu._AnimateState, Protocol):
    def onPreActiveLayerChanged(self) -> None: ...
    def onActiveLayerChanged(self, kwargs: _ActiveLayerChangedKwargs) -> None: ...
    def onPostActiveLayerChanged(self) -> None: ...
    def saveCatalogData(self) -> None: ...
    def delayedReload(self) -> None: ...


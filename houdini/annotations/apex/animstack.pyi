class ApexAnimStack:
    BAKED_LAYER_NAME: ClassVar[str]
    DEFAULT_ANIMATION_CLIP: ClassVar[str]
    CLIP_PATTERN: ClassVar[str]
    @staticmethod
    def layerChangedEventBlocker(f: Callable[_P, _R]) -> Callable[_P, _R]: ...
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def scene(self) -> Scene: ...
    def setInheritLayers(self, inherit_layers: bool) -> None: ...
    def initializeModel(self, scene_viewer: hou.SceneViewer) -> None: ...
    def onSceneLoaded(self, available_clip_paths: list[str]) -> None: ...
    def unload(self) -> None: ...
    def flattenedLayers(self, start: str = ..., end: str = ...) -> list[AnimLayer]: ...
    def incrLayerChangedEventBlockers(self) -> None: ...
    def decrLayerChangedEventBlockers(self) -> None: ...
    def clearLayerChangedEventBlockers(self) -> None: ...
    def addLayer(self, name: str, parent: str, additive: bool = ..., activate: bool = ..., index: int = ..., color: hou.Color | None = ..., update_state: bool = ..., update_model: bool = ...) -> tuple[bool, str]: ...
    def duplicateLayers(self, original_names: Iterable[str], selected_controls_only: bool, activate: bool, update_state: bool = ..., update_model: bool = ..., insert_after: bool = ...) -> tuple[bool, list[str]]: ...
    def duplicateLayer(self, original_name: str, selected_controls_only: bool, activate: bool, update_state: bool = ..., update_model: bool = ..., after: bool = ..., new_name: str = ...) -> tuple[bool, str]: ...
    def deleteLayers(self, layers: Iterable[str]) -> bool: ...
    def deleteLayer(self, name: str, new_active_layer: str | None = ..., update_state: bool = ..., update_model: bool = ...) -> bool: ...
    def moveLayers(self, source_parent: str, source_indices: Sequence[int], destination_parent: str, destination_index: int) -> bool: ...
    def forkInheritedLayers(self, layers: Sequence[str]) -> None: ...
    def setActiveLayer(self, layer: str, update_state: bool = ..., update_model: bool = ..., create_undo: bool = ...) -> None: ...
    def setLayerWeight(self, layers: Iterable[str], value: float, change_type: _WeightChangeType) -> None: ...
    def insertLayerWeightKeyframe(self, layers: Iterable[str], frame: float) -> None: ...
    def destroyLayerWeightKeyframe(self, layers: Iterable[str], frame: float) -> None: ...
    def scopeLayerWeights(self, layers: Iterable[str]) -> None: ...
    def resetLayerWeightsToDefault(self, layers: Iterable[str], frame: float) -> None: ...
    def setLayerWeightsFromPlaybar(self, layers: Iterable[str]) -> None: ...
    def deleteLayerWeightChannels(self, layers: Iterable[str]) -> None: ...
    def muteLayers(self, layers: Iterable[str], mute: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def muteLayer(self, layer: str, mute: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def lockLayers(self, layers: Iterable[str], lock: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def lockLayer(self, layer: str, lock: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def soloLayers(self, layers: Iterable[str], solo: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def soloLayer(self, layer: str, solo: bool, update_state: bool = ..., update_model: bool = ...) -> None: ...
    def zeroOutUnkeyedChannels(self, layer: str, additive: bool) -> None: ...
    def setLayersAdditive(self, layers: Iterable[str], additive: bool, update_model: bool = ...) -> None: ...
    def setLayerAdditive(self, layer: str, additive: bool, update_model: bool = ...) -> None: ...
    def setLayerColors(self, colors: Mapping[str, hou.Color], update_model: bool = ...) -> None: ...
    def setLayerColor(self, layer: str, color: hou.Color, update_model: bool = ...) -> None: ...
    def renameLayer(self, layer: str, new_name: str, update_model: bool = ...) -> str | None: ...
    def getLayerControls(self, layer: str) -> dict[str, list[str]]: ...
    def getLayerParms(self, layer: str) -> dict[str, list[str]]: ...
    def addControlsToLayer(self, ctrl_paths: Iterable[str], layer: str) -> None: ...
    def removeControlsFromLayer(self, ctrl_paths: Iterable[str], layer: str) -> None: ...
    def addSelectedControlsToLayers(self, layers: Iterable[str]) -> None: ...
    def addSelectedControlsToLayer(self, layer: str, update_model: bool = ...) -> None: ...
    def removeSelectedControlsFromLayers(self, layers: Iterable[str]) -> None: ...
    def removeSelectedControlsFromLayer(self, layer: str, update_model: bool = ...) -> None: ...
    def selectLayerControls(self, layer_name: str) -> None: ...
    def getAllBindingsGeometries(self, layer: str) -> dict[str, hou.Geometry]: ...
    def restoreBindingGeometries(self, layer: str, binding_geometries: Mapping[str, hou.Geometry]) -> None: ...
    def updateState(self, scope_channels: bool = ..., rescope_weights: bool = ..., write_animation: bool = ...) -> None: ...
    def updateAnimationLayersModel(self) -> None: ...
    def updateModelLayerWeights(self) -> None: ...
    def updateModelInheritedIndicators(self) -> None: ...
    def updateModelControlsIndicators(self, scoped_parms: Mapping[str, Iterable[str]]) -> None: ...
    def updateModelClips(self) -> None: ...
    def updateMembershipModel(self) -> None: ...
    def onPlaybackChangeEvent(self, event_type: hou.EnumValue[hou.playbarEvent]) -> None: ...
    def onControlSelectionChanged(self, scoped_parms: Mapping[str, Iterable[str]]) -> None: ...
    def scopeChannels(self, channel_list: hou.ChannelList) -> None: ...
    def addGeometryChannelCallbacks(self) -> None: ...
    def removeGeometryChannelCallbacks(self) -> None: ...
    def bake(self, frame_range: Sequence[float] | None = ..., sample_rate: float = ..., replace: bool = ..., start_layer: str = ..., end_layer: str = ..., keys_only: bool = ...) -> None: ...
    def needsReload(self) -> bool: ...
    def setNeedsReload(self, needs_reload: bool) -> None: ...
    # args is the command_args of any state command (the state tries each module in turn): each
    # command has its own keys and value types.
    def onCommand(self, name: str, args: MutableMapping[str, Any]) -> bool: ...

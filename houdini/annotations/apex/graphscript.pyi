class GraphDecompiler:
    graph: apex.Graph
    geo: hou.Geometry
    registry: apex.Registry
    # Port unique names to the variable names given them.
    identifier_map: dict[str, str]
    # Variable names to their types (None for subnets).
    target_names: dict[str, str | None]
    subnet_names: list[str]
    # Never filled.
    subnet_sig_cache: dict[Never, Never]
    port_name_cache: dict[int, str]
    use_object_oriented: bool
    def __init__(
        self,
        geo: hou.Geometry | None = ...,
        graph: apex.Graph | None = ...,
        subnet_names: list[str] | None = ...,
        use_object_oriented: bool = ...,
    ) -> None: ...
    def isCallbackSubgraph(self, callback_name: str) -> bool: ...
    def nodeCallbackName(self, pt: hou.Point) -> str: ...
    def nodeName(self, pt: hou.Point) -> str: ...
    def nodeParms(self, pt: hou.Point) -> hou._OptionDict: ...
    def nodeColor(self, pt: hou.Point) -> hou.Vector3: ...
    def nodePosition(self, pt: hou.Point) -> hou.Vector3: ...
    def nodeProperties(self, pt: hou.Point) -> hou._OptionDict: ...
    def nodeTags(self, pt: hou.Point) -> tuple[str, ...]: ...
    def nodeSubnetGeo(self, pt: hou.Point) -> hou.Geometry | None: ...
    def subnetGeo(self, subnet_name: str) -> hou.Geometry | None: ...
    # Any value: the name of the apex array class it is an instance of, if any.
    def arrayTypeName(self, arr: object) -> str | None: ...
    # Any value: what it doesn't know how to format it formats with str().
    def formatParm(self, v: object, wrap_lines: bool = ..., indent_level: int = ...) -> str: ...
    # Variadic port names to the names of the variables wired to them.
    def formatVariadicArgDict(self, the_dict: Mapping[str, str], wrap_lines: bool = ..., indent_level: int = ...) -> str: ...
    def nodeMetadata(
        self,
        pt: hou.Point,
        pos: bool = ...,
        col: bool = ...,
        name: bool = ...,
        tags: bool = ...,
        properties: bool = ...,
    ) -> dict[str, str]: ...
    def graphNodeMetadata(
        self,
        nodeid: int,
        pos: bool = ...,
        col: bool = ...,
        name: bool = ...,
        tags: bool = ...,
        properties: bool = ...,
    ) -> dict[str, str]: ...
    # The subnet's callback name and its code.
    def generateSubnetCode(
        self,
        subnet_path: str,
        nodeid: int,
        annotations: bool = ...,
        metadata_pos: bool = ...,
        metadata_col: bool = ...,
        metadata_name: bool = ...,
        metadata_tags: bool = ...,
        metadata_properties: bool = ...,
        wrap_lines: bool = ...,
    ) -> tuple[str, str]: ...
    def writeCodeToFile(self, filepath: StrPath) -> None: ...

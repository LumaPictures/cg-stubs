from collections.abc import Iterable, Mapping, Sequence

import hou
from apex.ui.characterpicker.panel import ApexCharacterPicker
from charpicker.controlbutton import ControlButton
from charpicker.cpglobals import SelectionState
from charpicker.selectionmanager import ButtonSelectionManager, _InitialButtonData, _NodeEventCallback

PYS_SELECT_CONTROLS: str

class ApexButtonSelectionManager(ButtonSelectionManager):
    # The base class's, narrowed to the picker this manager is created with.
    _char_picker: ApexCharacterPicker
    def __init__(self, picker: ApexCharacterPicker) -> None: ...
    def registerWithState(self, scene_viewer: hou.SceneViewer) -> None: ...
    def unregisterFromState(self) -> None: ...
    # Registered with the Animate state, which calls it when the control selection changes.
    def _handleSelectionChanged(
        self, ctrl_paths: list[str], pick_modifier: hou.EnumValue[hou.pickModifier], primary_control: str | None
    ) -> None: ...
    def getEditPathsMenuOptionText(self) -> str: ...
    def getToolTipTitleAndText(self, ctrl_paths: Sequence[str]) -> tuple[str, str]: ...
    def getFullControlPaths(self, char_path: str, ctrl_paths: Iterable[str]) -> list[str]: ...
    def filterValidPaths(self, char_path: str, ctrl_paths: Iterable[str]) -> list[str]: ...
    def addCallbacks(
        self,
        char_path: str,
        ctrl_paths: Sequence[str],
        selection_changed_callback: _NodeEventCallback,
        ctrl_paths_changed_callback: _NodeEventCallback,
    ) -> None: ...
    def removeCallbacks(
        self,
        char_path: str,
        ctrl_paths: Sequence[str],
        selection_changed_callback: _NodeEventCallback,
        ctrl_paths_changed_callback: _NodeEventCallback,
    ) -> None: ...
    def getSelectionState(self, char_path: str, ctrl_paths: Sequence[str]) -> SelectionState: ...
    def getSelectedControlPaths(
        self, char_path: str, ctrl_paths: Sequence[str], parent_selection: Mapping[str, ControlButton]
    ) -> list[str]: ...
    def getViewportSelection(self, char_path: str | None) -> list[str]: ...
    def getControlScreenPositions(self, ctrl_paths: Sequence[str]) -> dict[str, tuple[float, float]]: ...
    def getInitialButtonData(self, char_path: str, group_index: int = ...) -> _InitialButtonData: ...
    def getControlColor(self, ctrl_path: str) -> hou.Color | None: ...
    def getBehaviorForPaths(self, ctrl_paths: Sequence[str]) -> str | None: ...
    def addSelectionHistoryEntry(
        self, ctrl_paths: list[str], pick_modifier: hou.EnumValue[hou.pickModifier], primary_control: str | None, name: str | None = ...
    ) -> None: ...
    def setUseSelectionHistory(self, use: bool) -> None: ...
    def useSelectionHistory(self) -> bool: ...
    def selectionGroupsCount(self) -> int: ...
    def getActiveSelectionGroups(self) -> list[_InitialButtonData]: ...

from collections.abc import Sequence
from typing import ClassVar, NotRequired, TypedDict

import hou
from PySide6 import QtCore, QtWidgets

# What CreateClipWidget.clipData() returns, and SidePanel.newClipCreated carries.
class _ClipData(TypedDict):
    pose: bool
    # PNG data.
    thumbnail: bytes | None
    name: str
    # Animations only.
    frame_range: NotRequired[list[int]]
    # GIF data; animations only.
    preview: NotRequired[bytes | None]

THUMBNAIL_SIZE: int

class InfoGrid(QtWidgets.QWidget):
    ROWS: ClassVar[list[str]]
    ANIMATION_ROWS: ClassVar[list[str]]
    def __init__(self, pose: bool, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setFromDataSource(self, data_source: hou.AssetGalleryDataSource, item_id: str) -> None: ...

class PoseOptionsGrid(QtWidgets.QWidget):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def isNewLayerChecked(self) -> bool: ...

class AnimationOptionsGrid(QtWidgets.QWidget):
    # Emitted with the source range's [start, end].
    rangeChanged: ClassVar[QtCore.Signal]
    resetRangeClicked: ClassVar[QtCore.Signal]
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setRange(self, clip_range: Sequence[int]) -> None: ...
    def isNewLayerChecked(self) -> bool: ...

class CreateClipWidget(QtWidgets.QWidget):
    clipSaved: ClassVar[QtCore.Signal]
    clipCancelled: ClassVar[QtCore.Signal]
    def __init__(self, parent: QtWidgets.QWidget | None = ..., pose: bool = ...) -> None: ...
    def refresh(self) -> None: ...
    def setControlCount(self, control_count: int) -> None: ...
    def clipData(self) -> _ClipData: ...
    def onActivate(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def onDestroy(self) -> None: ...

class SidePanel(QtWidgets.QStackedWidget):
    THUMBNAIL_WIDTH: ClassVar[int]
    THUMBNAIL_HEIGHT: ClassVar[int]
    # Emitted with the new clip's _ClipData.
    newClipCreated: ClassVar[QtCore.Signal]
    newClipCancelled: ClassVar[QtCore.Signal]
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setItem(self, item_id: str | None, force: bool = ...) -> None: ...
    def enableActions(self, enabled: bool) -> None: ...
    def createNewClip(self, pose: bool, control_count: int = ...) -> None: ...
    def setControlCount(self, control_count: int = ...) -> None: ...
    def resetBlendSlider(self) -> None: ...
    def onActivate(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def onDestroy(self) -> None: ...

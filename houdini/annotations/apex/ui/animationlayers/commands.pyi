def muteLayers(layers: Sequence[str], mute: bool, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def soloLayers(layers: Sequence[str], solo: bool, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def setLayersAdditive(layers: Sequence[str], additive: bool, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def setLayersColor(layer: Sequence[str], color: hou.Color, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def insertLayerWeightKeyframe(layers: Sequence[str], frame: float | None = ..., scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def destroyLayerWeightKeyframe(layers: Sequence[str], frame: float | None = ..., scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def resetWeights(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def addWeightToChannelList(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def setWeightFromPlaybarSelection(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def deleteWeightChannels(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def bakeLayers(
    replace: bool = ...,
    start_layer: str | None = ...,
    end_layer: str | None = ...,
    keys_only: bool = ...,
    scene_viewer: hou.SceneViewer | None = ...,
) -> None: ...
# An empty list when no Animate state handles the command.
def getLayerControls(layer: str, scene_viewer: hou.SceneViewer | None = ...) -> dict[str, list[str]] | list[Never]: ...
# Rig path -> parm names.
def getLayerParms(layer: str, scene_viewer: hou.SceneViewer | None = ...) -> dict[str, list[str]]: ...
def removeParmsFromLayer(layer: str, parms: Mapping[str, Sequence[str]], scene_viewer: hou.SceneViewer | None = ...) -> None: ...

def sceneViewer() -> hou.SceneViewer | None: ...
def createEmptyLayer(
    name: str,
    parent_layer: str | None = ...,
    additive: bool = ...,
    activate: bool = ...,
    index: int = ...,
    color: hou.Color | None = ...,
    scene_viewer: hou.SceneViewer | None = ...,
) -> tuple[bool, str]: ...
def duplicateLayers(
    layers: Sequence[str], selected_controls_only: bool = ..., activate: bool = ..., scene_viewer: hou.SceneViewer | None = ...
) -> tuple[bool, list[str]]: ...
def deleteLayers(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> bool: ...
def moveLayers(
    source_parent: str,
    source_indices: Sequence[int],
    destination_parent: str,
    destination_index: int,
    scene_viewer: hou.SceneViewer | None = ...,
) -> bool: ...
def forkInheritedLayers(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def setActiveLayer(layer: str, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def addSelectedControlsToLayers(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def removeSelectedControlsFromLayer(layers: Sequence[str], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def selectLayerControls(layer: str, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def setLayerWeight(layers: Sequence[str], weight: float, change_type: _WeightChangeType, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def renameLayer(previous_name: str, new_name: str, scene_viewer: hou.SceneViewer | None = ...) -> _RenameLayerResult: ...

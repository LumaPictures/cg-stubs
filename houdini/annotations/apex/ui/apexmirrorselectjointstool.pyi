from collections.abc import Iterable, Mapping
from typing import Final, Literal, Protocol, Required, overload

import apex
import apex.bake as apexbake
import hou
import statehud.window as shud
from apex.xformgadget import _HandleStartUpdateKwargs, _HandleUpdateKwargs
from apex.scene_2 import _AnimateState as _SceneState
from apex.ui.selectjointstool import RigData, SelectJointsTool, _SelectJointsActivateKwargs
from apex.ui.selectjointstool import _AnimateState as _SelectJointsState, _RigConfig as _SelectJointsRigConfig
from apex.ui.animationhudwidgets import ParameterWidget
from apex.ui.apexmirror import FlipAxesMode, MirrorPlane, PlaneIntersect, RigMirrorer
from apex.ui.apexmirror import _AnimateState as _MirrorState
from houtypes import (
    ViewerStateCommandKwargs,
    ViewerStateDrawKwargs,
    ViewerStateEventKwargs,
    ViewerStateKwargs,
    ViewerStatePlaybackChangeKwargs,
)
from statehud.parmutils import _HUDParmValue
from statehud.parmwidgetset import ParmWidgetSet, _HUDParmTemplate
from statehud.baseconfig import AbstractConfig

class _AnimateState(_SceneState, _MirrorState, _SelectJointsState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members of the states it extends."""

class _RigConfig(_SelectJointsRigConfig, total=False):
    """A rig's entry of the `config` apexmirror.startMirrorTool() starts the tool with."""

    controls: Required[list[str]]
    use_mirror_point_rots: bool
    mirror_axis: hou.Vector3

CFG_MIRROR_TO_OPPOSITE: Final = "mirror_to_opposite_control"
CFG_CURRENT_COMPONENTS: Final = "components"
CFG_FLIP_AXES_MODE: Final = "flip_axes_mode"
CFG_RIG_MIRROR_PLANE: Final = "rig_mirror_plane"
CFG_PLANE_FOLLOW_JOINT: Final = "plane_follow_joint"
CFG_SHOW_PLANE_INTERSECTION: Final = "show_plane_intersection"
CFG_LIVE_PREVIEW: Final = "live_preview"
CFG_LIVE_PREVIEW_OUTLINE: Final = "preview_outline"

EVALUATION_PARMS: dict[str, _HUDParmTemplate]

def createGraph(scene_viewer: hou.SceneViewer, rig_data_dict: Mapping[str, RigData]) -> apex.Graph: ...
def updateControlShapeOffsets(scene: apex.Scene, rig_data_dict: Mapping[str, "RigMirrorData"]) -> None: ...
def createMirrorRig(state: _AnimateState, rig_graph: apex.Graph) -> apex.SceneGraph: ...
def recreateMirrorRig(state: _AnimateState, rig_path: str, rig_graph: apex.Graph, on: bool) -> apex.SceneGraph | None: ...
def getParentRotationMat(pt: hou.Point) -> hou.Matrix3: ...

class BakeSourceMirrorControlXform(apexbake.BakeSourceXformBase):
    mirror_ctrl_path: str
    ctrl_path: str
    mirrorer: RigMirrorer
    def __init__(self, ctrl_path: str, mirrorer: RigMirrorer, frame_set: apexbake._FrameSetLike | None = ...) -> None: ...
    def addControlsToManager(self, scene: apex.Scene, ctrl_mgr: apex.ControlManager) -> None: ...
    def xform(self, frame: float, ctrl_mgr: apex.ControlManager) -> hou.Matrix4 | None: ...

class MirrorToolSettingsHudWidget(ParameterWidget[_AnimateState]):
    evaluation_parms: ParmWidgetSet
    prev_flip_axes_mode: int
    def __init__(
        self,
        tool: "MirrorTool",
        hud_window: shud.WidgetBundleWindow | None = ...,
        tab_widget_name: str | None = ...,
        tab_name: str | None = ...,
    ) -> None: ...
    @property
    def tool(self) -> "MirrorTool | None": ...
    def onActivate(self) -> None: ...
    def isVisible(self) -> bool: ...
    # default is ignored. The toggles give bools, the menus and strips ints (bit fields for the
    # components and flip axes strips).
    @overload
    def get(
        self,
        key: Literal["mirror_to_opposite_control", "plane_follow_joint", "live_preview", "preview_outline"],
        default: _HUDParmValue = ...,
    ) -> bool: ...
    @overload
    def get(
        self,
        key: Literal["components", "flip_axes_mode", "rig_mirror_plane", "show_plane_intersection"],
        default: _HUDParmValue = ...,
    ) -> int | None: ...
    @overload
    def get(self, key: str, default: _HUDParmValue = ...) -> _HUDParmValue: ...
    def initHud(self) -> None: ...
    # The options are ignored.
    def loadFromConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def saveToConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def onEvaluationParmChanged(self, name: str) -> None: ...
    def updateParms(self) -> None: ...
    # value is the Flip Axes button strip's bit field: auto, x, y, z.
    def getFlipAxes(self, value: int | None = ...) -> FlipAxesMode: ...
    def onFlipAxesChanged(self, value: int) -> None: ...
    # value is the Components icon strip's bit field: t, r, s.
    def getComponents(self, value: int | None = ...) -> str: ...
    def onComponentsChanged(self, value: int) -> None: ...
    def onMirrorPlaneChanged(self, value: int) -> None: ...

def mirrorControlName(rig_path: str) -> str: ...
def mirrorControlPath(rig_path: str) -> str: ...

class RigMirrorData(RigData):
    # Set by MirrorTool.onActivate().
    mirrorer: RigMirrorer | None
    preview_geo: hou.Geometry
    preview_drawable: hou.SimpleDrawable | None
    output_shape_name: str | None
    output_shape_path: str
    input_shape: hou.Geometry | None
    intersection_geo: hou.Geometry | None
    intersection_clip_verb: hou.SopVerb | None
    # Set by MirrorTool.loadIntersectionDrawables().
    intersection_drawable: hou.GeometryDrawable | None
    initial_parent_xform: hou.Matrix4
    eval_graph: apex.Graph

class MirrorTool(SelectJointsTool[_AnimateState, RigMirrorData, _RigConfig]):
    settings_widget: MirrorToolSettingsHudWidget | None
    flip_axes_mode: FlipAxesMode
    show_plane_intersection: PlaneIntersect | None
    # None uses each rig's own mirror axis.
    rig_mirror_normal_override: MirrorPlane | None
    mirror_ctrl_paths: list[str]
    selectable_ctrls: list[str]
    def __init__(self, viewer_state: _AnimateState) -> None: ...
    # None before afterLoadFromConfig() creates the rig, and once onDeactivate() removes it.
    @property
    def mirror_rig(self) -> apex.SceneGraph | None: ...
    def createRigData(self) -> RigMirrorData: ...
    def onActivate(self, kwargs: _SelectJointsActivateKwargs[_RigConfig]) -> None: ...
    def afterLoadFromConfig(self) -> None: ...
    def onConfirmation(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def loadMirrorToolData(self) -> None: ...
    def saveMirrorToolData(self) -> None: ...
    def showIntersectionDrawable(self) -> bool: ...
    def loadIntersectionDrawable(self, scene_viewer: hou.SceneViewer, rig_path: str) -> hou.GeometryDrawable: ...
    def updateIntersectionDrawable(self, rig_path: str, rig_data: RigMirrorData, preview_transform: hou.Matrix4) -> None: ...
    def loadIntersectionDrawables(self) -> None: ...
    def updatePreviewDrawableVisibility(self) -> None: ...
    def setComponents(self, components: str) -> None: ...
    def setFlipAxesMode(self, flip_axes: FlipAxesMode) -> None: ...
    def setMirrorToOpposite(self, value: bool) -> None: ...
    def setPlaneFollowJoint(self, value: bool) -> None: ...
    def setShowPlaneIntersection(self, show: PlaneIntersect | None) -> None: ...
    def setLivePreview(self, value: bool) -> None: ...
    def setOverlayPreview(self, value: bool) -> None: ...
    @property
    def overlay(self) -> bool: ...
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def getSelectedJointXform(self, selected_joint: hou.Point | None) -> hou.Matrix4: ...
    def onJointSelectionChanged(self) -> None: ...
    def setMirrorAxis(self, plane: MirrorPlane | None) -> None: ...
    def updateMirrorXform(self, reset_local: bool = ...) -> None: ...
    def muteAnimBindings(self) -> None: ...
    def unmuteAnimBindings(self) -> None: ...
    # The evaluation events get hou.time().
    def onPreEvaluationEvent(self, kwargs: float) -> None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> None: ...
    def mirrorPose(self, frame: float) -> None: ...
    def previewMirror(self) -> None: ...
    def onPoseStartEvent(self, kwargs: ViewerStateEventKwargs | _HandleStartUpdateKwargs) -> bool: ...
    def onPoseEndEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> bool: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def drawExtraDrawables(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    # Sets kwargs["modified_ctrls"] to the controls of ctrls the tool lets the user select.
    def onPreSelectionSetsSelectControls(self, kwargs: ViewerStateCommandKwargs, ctrls: Iterable[str]) -> None: ...

def load(viewer_state: _AnimateState) -> MirrorTool: ...

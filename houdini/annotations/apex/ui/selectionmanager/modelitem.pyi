from collections.abc import Callable, Collection, Iterable, Mapping, Sequence
from typing import Concatenate, Literal, Never, ParamSpec, TypeAlias, TypedDict, TypeVar, Unpack, overload

import hou
from PySide6 import QtCore, QtGui

from apex.animationcatalog import _ControlTree
from apex.ui.selectionmanager.model import SelectionManagerModel, _Color, _Index, _RigPatternsLookup
from apex.ui.selectionmanager.modelconfig import _ExportedSet, _ItemType, _LabelTree, _SetDiff
from apex.ui.selectionmanager.modelimpl import ModelImpl

_T = TypeVar("_T")
_P = ParamSpec("_P")
_R = TypeVar("_R")
_ItemT = TypeVar("_ItemT", bound="BaseItem")
# Not separate _LabelTree and _ControlTree overloads: mypy (1.18) recurses forever checking
# whether those two recursive aliases overlap, and segfaults.
_TreeT = TypeVar("_TreeT", _ControlTree, _LabelTree)

# What ModelImpl._collectSeparateCharacters() gives per character: the unique ids of the
# items to copy for it, each mapping to the same structure for that item's children.
_CopyStructure: TypeAlias = Mapping[int | None, "_CopyStructure"]

# The keywords of BaseItem.__init__, which RigSubItem forwards.
class _ItemKwargs(TypedDict, total=False):
    name: str
    model: SelectionManagerModel | None
    unique_id: int | None
    modelimpl: ModelImpl | None

ROOT_ITEM_NAME: str
START_SET_NAME: str

TYPE_ROOT_FOLDER: Literal["Folder"]
TYPE_GROUP: Literal["Group"]
TYPE_CONTROL_GROUP: Literal["ControlGroup"]
TYPE_CONTROL: Literal["Control"]
TYPE_CHARACTER: Literal["Character"]
TYPE_CONSTRAINT: Literal["Constraint"]
TYPE_RIG: Literal["Rig"]
TYPE_GEO: Literal["Geo"]
TYPE_TOOL_CHAR: Literal["Tool"]
TYPE_MULTI_CTRL_CHAR: Literal["MultiCtrl"]

TYPE_CHAR_TAG: Literal["char"]
TYPE_RIG_TAG: Literal["rig"]
TYPE_GEO_TAG: Literal["geo"]
TYPE_DIR_TAG: Literal["dir"]
TYPE_TOOL_CHAR_TAG: Literal["tool"]
TYPE_CONSTRAINT_TAG: Literal["constr"]
TYPE_MULTI_CTRL_CHAR_TAG: Literal["ctrl"]

HIDDEN_RIG_TYPES: list[str]

NAME_COLUMN: Literal[0]
ISOLATEICON_COLUMN: Literal[1]
VIEWCHARICON_COLUMN: Literal[2]
VIEWCONSTRICON_COLUMN: Literal[3]
VIEWICON_COLUMN: Literal[4]
SELECTICON_COLUMN: Literal[5]
PINICON_COLUMN: Literal[6]

CONTROLS_SELECTED_KEY: Literal[0]
CONTROLS_VISIBLE_KEY: Literal[1]
CONTROLS_CHARACTER_KEY: Literal[2]
CONTROLS_CONSTRAINT_KEY: Literal[3]
CONTROLS_PINNED_KEY: Literal[4]
CONTROLS_ISOLATE_KEY: Literal[5]
CONTROLS_INTERNAL_ISO_KEY: Literal[6]
CONTROLS_COLOR_KEY: Literal[7]

# One of the CONTROLS_*_KEY values: which state of the items.
_StateKey: TypeAlias = Literal[0, 1, 2, 3, 4, 5, 6, 7]

STATE_OFF: Literal[0]
STATE_PARTIAL: Literal[1]
STATE_ON: Literal[2]

def isCharTypeTag(
    tag: str | None, include_tools: bool = ..., include_motion_paths: bool = ..., include_rigs: bool = ...
) -> bool: ...
def isNameCharTag(
    name: str, include_tools: bool = ..., include_motion_paths: bool = ..., include_rigs: bool = ...
) -> bool: ...
def extractChars(
    controls_tree: _ControlTree,
    include_tools: bool = ...,
    include_motion_paths: bool = ...,
    include_rigs: bool = ...,
    depth: int = ...,
) -> _ControlTree: ...
def filterLabelTree(controls_tree: _TreeT) -> _TreeT: ...
def extractConstraints(controls_tree: _ControlTree) -> _ControlTree: ...
def extractConstraintTree(controls_tree: _ControlTree | None, in_constraint: bool = ...) -> _ControlTree: ...
def mirrorExportedSet(
    export_set_tree: _ExportedSet,
    left_pattern: str | None = ...,
    right_pattern: str | None = ...,
    left_set_pattern: str | None = ...,
    right_set_pattern: str | None = ...,
    rig_patterns_lookup: _RigPatternsLookup | None = ...,
    rig_path: str | None = ...,
) -> None: ...
def uniqueNameDisabler(fn: Callable[Concatenate[_ItemT, _P], _R]) -> Callable[Concatenate[_ItemT, _P], _R]: ...

class BaseItem:
    def __init__(
        self,
        name: str,
        model: SelectionManagerModel | None,
        unique_id: int | None = ...,
        modelimpl: ModelImpl | None = ...,
    ) -> None: ...
    # Item properties: modelconfig.EXPAND_PROPERTY, whether the item is expanded in the view.
    def setProperty(self, key: str, val: bool, and_children: bool = ...) -> None: ...
    def removeProperty(self, key: str, and_children: bool = ...) -> None: ...
    @overload
    def getProperty(self, *args: Unpack[tuple[str]], **kwargs: Never) -> bool | None: ...
    @overload
    def getProperty(self, *args: Unpack[tuple[str, _T]], **kwargs: Never) -> bool | _T: ...
    def labelsTree(self) -> _LabelTree: ...
    def applyLabels(
        self, label_tree: _LabelTree, item_tree: Mapping[str, str | _LabelTree] = ..., full_update: bool = ...
    ) -> None: ...
    def controlTree(
        self, include_ancestors: bool = ..., filter_pred: Callable[["BaseItem"], bool] | None = ...
    ) -> _ControlTree: ...
    # ImmutableRootFolderItem's copies are RootFolderItems.
    def copy(self, new_name: str | None = ...) -> "BaseItem": ...
    def deepcopy(self, new_name: str | None = ...) -> "BaseItem": ...
    def copyStructureForChar(
        self,
        copy_structure: _CopyStructure,
        char_name: str,
        rename_fn: Callable[[str, str], str],
        all_controls_tree: _ControlTree | None,
    ) -> "BaseItem | None": ...
    def resetNumControls(self) -> None: ...
    def updateNumControls(self, all_controls_tree: _ControlTree) -> None: ...
    def getNumControls(self) -> int: ...
    def getNumConstraints(self) -> int: ...
    def isEditable(self) -> bool: ...
    def setEditable(self, editable: bool, and_children: bool = ...) -> None: ...
    def setColor(self, color: _Color, and_children: bool = ...) -> None: ...
    # A QColor when the item has a model, else an RGBA int.
    def color(self) -> QtGui.QColor | int | None: ...
    def acceptsState(self, key: _StateKey) -> bool: ...
    def endsState(self, key: _StateKey) -> bool: ...
    # States are STATE_OFF/STATE_PARTIAL/STATE_ON, or the False/True they start as.
    def updateStateTopDown(
        self, key: _StateKey, control_tree: _ControlTree | None = ..., force_state: int | None = ...
    ) -> int: ...
    def updateSelectStates(self, control_tree: _ControlTree | None = ...) -> None: ...
    def updateVisibleStates(self, control_tree: _ControlTree | None = ...) -> None: ...
    def updateInternalIsolateStates(self, control_tree: _ControlTree | None = ...) -> None: ...
    def updateCharacterStates(self, control_tree: _ControlTree | None = ...) -> None: ...
    def updateConstraintStates(self, control_tree: _ControlTree | None = ...) -> None: ...
    def updatePinStates(self) -> None: ...
    def updateIsolateStates(self) -> None: ...
    def updateColorStates(self) -> None: ...
    def updateStateBottomUp(self, key: _StateKey) -> None: ...
    def updateStateFromChildren(self, key: _StateKey, update_ancestors: bool = ...) -> None: ...
    def setStateBottomUp(self, key: _StateKey, val: int, update_ancestors: bool = ..., check_children: bool = ...) -> None: ...
    def modifyStateBottomUp(
        self, key: _StateKey, pick_modifier: hou.EnumValue[hou.pickModifier], update_ancestors: bool = ...
    ) -> None: ...
    def clearState(self, key: _StateKey, and_children: bool = ..., update_ancestors: bool = ...) -> None: ...
    def modifyState(
        self, key: _StateKey, pick_modifier: hou.EnumValue[hou.pickModifier], update_ancestors: bool = ...
    ) -> None: ...
    def setPin(self, val: int, update_ancestors: bool = ...) -> None: ...
    def modifyPin(self, pick_modifier: hou.EnumValue[hou.pickModifier], update_ancestors: bool = ...) -> None: ...
    def clearPins(self, and_children: bool = ..., update_ancestors: bool = ...) -> None: ...
    def setIsolate(self, val: int, update_ancestors: bool = ...) -> None: ...
    def modifyIsolate(self, pick_modifier: hou.EnumValue[hou.pickModifier], update_ancestors: bool = ...) -> None: ...
    def clearIsolate(self, and_children: bool = ..., update_ancestors: bool = ...) -> None: ...
    def row(self) -> int: ...
    def setRow(self, row: int) -> None: ...
    def parent(self) -> "BaseItem | None": ...
    def topParent(self) -> "BaseItem": ...
    def editableAncestor(self) -> "BaseItem": ...
    # True for the root, else the parent (None: the item is invalid).
    def isValid(self) -> "bool | BaseItem | None": ...
    def setParent(self, parent: "BaseItem | None") -> None: ...
    def isRoot(self) -> bool: ...
    def isFolder(self) -> bool: ...
    def isPresent(self) -> bool: ...
    # Whether the item can be marked as not present.
    def setPresent(self, present: bool) -> bool: ...
    def isCharacter(self) -> bool: ...
    def isControl(self) -> bool: ...
    def isConstraint(self) -> bool: ...
    def isRig(self) -> bool: ...
    def isInRig(self) -> bool: ...
    def isSelectable(self) -> bool: ...
    def enabled(self) -> bool: ...
    def topSortKey(self) -> int: ...
    def addChild(self, child: "BaseItem") -> None: ...
    def insertChild(self, child: "BaseItem", row: int) -> None: ...
    def replaceChild(self, child_row: int, other: "BaseItem", copy_unique_id: bool = ...) -> None: ...
    def removeChildByIndex(self, index: int) -> None: ...
    def removeChildrenByIndex(self, start_index: int, count: int) -> None: ...
    def updateChildRows(self) -> None: ...
    def hasNonFolderChildren(self) -> bool: ...
    def addControlSubTree(
        self, dict_tree: _ControlTree, depth: int = ..., parent_index: _Index | None = ..., use_index: bool = ...
    ) -> None: ...
    # Returns the new number of children.
    def modifyControlSubTree(
        self,
        dict_tree: _ControlTree,
        pick_modifier: hou.EnumValue[hou.pickModifier] | None = ...,
        parent_index: _Index | None = ...,
        modify_patterns: bool = ...,
        use_index: bool = ...,
    ) -> int: ...
    def isPersistant(self) -> bool: ...
    def clear(self, keep_persistant: bool = ...) -> None: ...
    def nextChildName(
        self, base_name: str | None = ..., add_number_if_unique: bool = ..., skip_child: "BaseItem | None" = ...
    ) -> str: ...
    def loadSelectionSets(
        self,
        json_tree: Iterable[_ExportedSet],
        editable: bool = ...,
        replace_char: str | None = ...,
        parent_special: bool = ...,
    ) -> list["BaseItem"]: ...
    def childCount(self) -> int: ...
    def child(self, row: int) -> "BaseItem | None": ...
    def getTag(self) -> str | None: ...
    def checkUniqueFolders(self) -> bool: ...
    def updateName(self, name: str) -> None: ...
    def updateHasPatternUp(self) -> None: ...
    def updateHasPattern(self) -> bool: ...
    def hasPattern(self) -> bool: ...
    def getName(self) -> str: ...
    def getSubtreeKey(self) -> str: ...
    def getLabel(self) -> str | None: ...
    def setLabel(self, label: str | None) -> None: ...
    def getUniqueId(self) -> int | None: ...
    def isNamePattern(self) -> bool: ...
    def getDisplayLabel(self, show_tags: bool = ...) -> str: ...
    def getDescriptionLabel(self, show_count: bool = ..., show_patterns: bool = ..., unique_ids: bool = ...) -> str: ...
    def nameInTree(self, control_tree: Collection[str] | None) -> bool: ...
    @overload
    def getSubTree(self, control_tree: None) -> None: ...
    @overload
    def getSubTree(self, control_tree: _TreeT) -> _TreeT: ...
    def getIcon(self) -> QtGui.QIcon | None: ...
    def getButtonIcon(self, column: int, model: SelectionManagerModel | None = ...) -> hou.qt.Icon | None: ...
    def getButtonToolTip(self, column: int) -> str | None: ...
    def getSelectState(self) -> int: ...
    def getControlState(self) -> int: ...
    def getCharState(self) -> int: ...
    def getConstraintState(self) -> int: ...
    def getPinState(self) -> int: ...
    def getIncludedInPin(self) -> bool: ...
    def getIsolateState(self) -> int: ...
    def getInternalIsolateState(self) -> int: ...
    def setPinnable(self, val: bool, and_children: bool = ...) -> None: ...
    def getChildren(self) -> list["BaseItem"]: ...
    # None without a model.
    def flags(self, column: int) -> QtCore.Qt.ItemFlag | None: ...
    def sort(self, and_children: bool = ...) -> None: ...
    def sortControls(self) -> None: ...
    def getJSONType(self) -> _ItemType: ...
    def export(
        self,
        unique_ids: bool = ...,
        export_properties: Iterable[str] | None = ...,
        parent_is_persistant: bool = ...,
        export_persistant: bool = ...,
    ) -> _ExportedSet: ...
    def exportChildren(
        self,
        unique_ids: bool = ...,
        export_properties: Iterable[str] | None = ...,
        parent_is_persistant: bool = ...,
        export_persistant: bool = ...,
    ) -> list[_ExportedSet]: ...
    def findChild(self, name: str) -> "BaseItem | None": ...
    # With an index (and a model), the found item and its index.
    @overload
    def findChildByPath(
        self, path_parts: Sequence[str], include_sets_path: bool = ..., my_index: None = ...
    ) -> "BaseItem | None": ...
    @overload
    def findChildByPath(
        self, path_parts: Sequence[str], include_sets_path: bool, my_index: _Index
    ) -> "tuple[BaseItem, _Index] | BaseItem | None": ...
    @overload
    def findChildByPath(
        self, path_parts: Sequence[str], include_sets_path: bool = ..., *, my_index: _Index
    ) -> "tuple[BaseItem, _Index] | BaseItem | None": ...
    @overload
    def findChildByPath(
        self, path_parts: Sequence[str], include_sets_path: bool = ..., my_index: _Index | None = ...
    ) -> "tuple[BaseItem, _Index] | BaseItem | None": ...
    def findChildById(self, unique_id: int | None) -> "BaseItem | None": ...
    @overload
    def findChildByUniqueIdPath(self, unique_id_path: Sequence[int | None], my_index: None = ...) -> "BaseItem | None": ...
    @overload
    def findChildByUniqueIdPath(
        self, unique_id_path: Sequence[int | None], my_index: _Index | None = ...
    ) -> "tuple[BaseItem, _Index] | BaseItem | None": ...
    def applyDiff(
        self, diff: Iterable[_SetDiff], index: _Index | None = ..., reverse: bool = ..., use_index: bool = ...
    ) -> None: ...
    def getActiveControl(self, only_valid: bool = ...) -> "ControlItem | None": ...
    # The active control's path, split, with its parts possibly patterns.
    def getActiveControlPattern(self, only_valid: bool = ...) -> list[str] | None: ...
    # The first control the active control's pattern matches in all_controls_tree, split
    # (empty if it matches none).
    def getActiveControlPath(self, all_controls_tree: _ControlTree, only_valid: bool = ...) -> list[str] | None: ...
    def setControlActive(self, val: bool = ...) -> None: ...
    def findItem(self, path_parts: Sequence[str], include_sets_path: bool = ...) -> "BaseItem | None": ...
    def inImportFolder(self) -> bool: ...
    @overload
    def getPath(self, delim: str | None = ..., only_control_path: bool = ..., split: Literal[False] = ...) -> str: ...
    @overload
    def getPath(self, delim: str | None, only_control_path: bool, split: Literal[True]) -> list[str]: ...
    @overload
    def getPath(self, delim: str | None = ..., only_control_path: bool = ..., *, split: Literal[True]) -> list[str]: ...
    @overload
    def getPath(self, delim: str | None = ..., only_control_path: bool = ..., split: bool = ...) -> str | list[str]: ...
    def getUniqueIdPath(self) -> list[int | None]: ...
    def getHUDColumns(self) -> list[int]: ...
    def print(self, level: int = ..., depth: int = ...) -> None: ...


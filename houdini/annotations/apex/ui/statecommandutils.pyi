from collections.abc import Collection, Iterable, Mapping, Sequence
from typing import Any, Final, Protocol, TypedDict

import _apex
import apex
import hou
from apex.apexanimatemodules.base import _AnimateState as _BaseAnimateState

class _AnimateState(_BaseAnimateState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`), as getAnimateState() gives it."""

class _SnapConfig(TypedDict, total=False):
    """An entry of the Animate state's snapSelectedControls() config. Entries without both
    patterns are skipped."""

    pattern_from: str
    pattern_to: str
    use_t: bool
    use_r: bool
    use_s: bool
    lookat: bool
    lookup: hou.Vector3
    lookaxis: hou.Vector3
    snap_to_selections: bool

class _ToolboxParmUpdate(TypedDict, total=False):
    """What updateToolbox() merges into a toolbox state parm's properties."""

    value: bool | int | float | str | list[int] | list[float]
    enable: bool | int
    visible: bool | int
    label: str

GET_STATE: Final = "getState"
GET_SCENE_DATA_CMD: Final = "getSceneData"
FIND_SCENE_DATA_PATHS_CMD: Final = "findSceneDataPaths"
REGISTER_SELECTION_CHANGED_CALLBACK: Final = "registerSelectionChangedCallback"
REMOVE_SELECTION_CHANGED_CALLBACK: Final = "removeSelectionChangedCallback"
SWITCH_HANDLE_TOOL_CMD: Final = "switchHandleTool"
UPDATE_TOOLBOX_CMD: Final = "updateToolbox"
GET_CONTROL_COLORS: Final = "getControlColors"
GET_CALLBACK_CONTROLS: Final = "getCallbackControls"
GET_SCENE_NODE: Final = "getSceneNode"
CHANNELS_CHANGED: Final = "channelsChanged"
BUILD_PATH_REFS: Final = "buildPathRefs"
RESOLVE_PATH_REFS: Final = "resolvePathRefs"

_animate_state_typenames: set[str]

def registerAnimateState(state_typename: str) -> None: ...
def getSceneViewer() -> hou.SceneViewer | None: ...
def inAnimateState(scene_viewer: hou.SceneViewer | None = ...) -> bool: ...
# The state reads the command's arguments from args and writes its results into it (so pass a
# dict to get them back).
def sendCommand(command_name: str, args: Mapping[str, object], scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def getAnimateState(scene_viewer: hou.SceneViewer | None = ...) -> _AnimateState | None: ...
# rig path -> its selected control paths
def getControlsByRig() -> dict[str, list[str]]: ...
def getControlTransforms(ctrl_paths: Iterable[str], group_by_rig: bool = ...) -> dict[str, hou.Matrix4]: ...
# Scene data can be any object (see apex.Scene.getData()).
def getSceneData(path: str, scene_viewer: hou.SceneViewer | None = ...) -> Any: ...
def setSceneData(path: str, data: object, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
def findSceneDataPaths(pattern: str, scene_viewer: hou.SceneViewer | None = ...) -> list[str]: ...
def buildPathRefs(paths: Collection[str], scene_viewer: hou.SceneViewer | None = ...) -> list[str]: ...
def resolvePathRefs(refs: Collection[str], scene_viewer: hou.SceneViewer | None = ...) -> list[str]: ...
# trs: rig path -> {graph parm name: value}
def updateControls(trs: Mapping[str, Mapping[str, _apex._ValueArg]], controls: Iterable[str], update_channel_widget: bool = ...) -> None: ...
def startTool(tool_module_name: str, on_activate_kwargs: Mapping[str, object]) -> None: ...
def switchToPreviousTool() -> None: ...
def exitCurrentTool() -> None: ...
def getSceneControlManager() -> apex.ControlManager: ...
# The Animate state has no handler for this command.
def updateTransientConstraint(bookmark_id: int | None = ..., store: bool = ...) -> None: ...
def snapSelectedControls(snap_config: Iterable[_SnapConfig] = ...) -> None: ...
# mapping: control path -> world transform
def setControlXforms(mapping: Mapping[str, hou.Matrix4] = ..., scope: bool = ...) -> None: ...
def switchHandleTool(tool_name: str) -> None: ...
def setXformForControls(xform: hou.Matrix4, control_paths: Iterable[str] = ...) -> None: ...
def getPrimaryControl(scene_viewer: hou.SceneViewer | None = ...) -> str | None: ...
# control path -> its color, None for a control with none
def getControlColors(control_paths: Iterable[str]) -> dict[str, tuple[float, float, float] | None]: ...
def getCallbackControls(control_paths: Iterable[str]) -> set[str]: ...
def channelList() -> hou.ChannelList: ...
def getGraphOutputData(path: str, scene_viewer: hou.SceneViewer | None = ...) -> _apex._Value | None: ...
# The LOP Animate state's scene node is a LOP.
def getSceneNode(scene_viewer: hou.SceneViewer | None = ...) -> hou.SopNode | hou.LopNode | None: ...
def channelsChanged(
    channels: Sequence[str], collection: str, write_animation: bool, anim_path: str, scene_viewer: hou.SceneViewer | None = ...
) -> None: ...
# parms: toolbox state parm name -> the properties to update
def updateToolbox(scene_viewer: hou.SceneViewer | None, parms: Mapping[str, _ToolboxParmUpdate]) -> None: ...

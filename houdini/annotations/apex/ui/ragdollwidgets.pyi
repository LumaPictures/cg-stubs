from collections.abc import Callable
from typing import ClassVar, Generic, TypeVar

import _apex
import apex
import hou
import statehud.window as shud
from apex.ragdollbase import RagdollStateBase
from apex.ragdollposing import RagdollPosing
from apex.ragdolltool_2 import RagdollTool
from apex.ui.animationhudwidgets import ToolbarWidget
from houtypes import ViewerStateEventKwargs, ViewerStateVolatileClientKwargs
from statehud.baseconfig import AbstractConfig
from statehud.utils import KeyState

SLIDER_MOUSE_RESET_MODIFIER: dict[tuple[int, int], str]

# The values of SOLVER_DEFAULTS: the tool's include the gravity vector, the posing state's
# are all floats.
_V_co = TypeVar("_V_co", bound=float | hou.Vector3, default=float | hou.Vector3, covariant=True)

class RagdollBaseSliderWidget:
    BACKGROUND_COLOR_KEY: ClassVar[dict[int, KeyState | None]]
    JOINT_MATCHWORLD_ATTRIB_DEFAULTS: ClassVar[dict[str, float]]
    CHARACTER_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    JOINT_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    DEBUG_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    tab_widget_name: str | None
    tab_name: str | None
    # None only until a subclass's __init__ binds it.
    hud_window: shud.WidgetBundleWindow
    toolbars: dict[str, ToolbarWidget]
    JOINT_PHYSICAL_DEFAULTS: dict[str, float]
    JOINT_SLIDER_DEFAULTS: dict[str, float]
    @property
    def tool(self) -> RagdollStateBase | None: ...
    def onValueCallback(self, name: str) -> Callable[[str], None]: ...
    @property
    def widgethotkey(self) -> str | None: ...
    @widgethotkey.setter
    def widgethotkey(self, val: str) -> None: ...
    def loadFromConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def saveToConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> bool: ...
    def onStaticSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def onStaticSliderValueChange(self, slider_name: str, v: float) -> None: ...
    # Bound to sliders (a float) and toggles (a bool).
    def onSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def resetColor(self, name: str) -> None: ...
    def updateSlidersFromChannelPrimsGeo(
        self, channel_prims_geo: hou.Geometry, joint_name: str, onlyAnimated: bool = ...
    ) -> None: ...
    def resetSlider(self, name: str) -> None: ...
    def isVisible(self) -> bool: ...
    def _updateSlider(self, name: str, val: float) -> None: ...
    def _getToggleState(self, name: str) -> bool: ...
    def resetValues(self, cur_tab: str | None = ...) -> None: ...
    def keyAll(self, cur_tab: str | None = ...) -> None: ...
    def copyValues(self, cur_tab: str | None = ...) -> None: ...
    def pasteValues(self, cur_tab: str | None = ...) -> None: ...
    def setTitle(self, title: str | None) -> None: ...
    def onSliderValueChange(
        self, slider_name: str, v: float, key: bool = ..., del_keys: bool = ..., single: bool = ...
    ) -> None: ...
    # hk is the hotkey symbol a widget's hotkeyInvoked signal emits.
    def valueAction(self, name: str, hk: str | None = ...) -> None: ...

class RagdollToolSliderWidget(RagdollBaseSliderWidget):
    # The toggles' values are bools.
    CONSTRAINTS_DEFAULTS: ClassVar[dict[str, float]]
    FORCES_DEFAULTS: ClassVar[dict[str, float]]
    DEBUG_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    CONSTRAINTS_TOGGLES: ClassVar[tuple[str, ...]]
    JOINT_PHYSICAL_DEFAULTS: dict[str, float]
    JOINT_SLIDER_DEFAULTS: dict[str, float]
    tab_widget_name: str | None
    tab_name: str | None
    hud_window: shud.WidgetBundleWindow
    def __init__(
        self,
        tool: RagdollTool,
        hud_window: shud.WidgetBundleWindow | None = ...,
        tab_widget_name: str | None = ...,
        tab_name: str | None = ...,
    ) -> None: ...
    @property
    def tool(self) -> RagdollTool | None: ...
    def onStaticSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def onStaticSliderValueChange(self, slider_name: str, v: float) -> None: ...
    def onSliderValueChange(
        self, slider_name: str, v: float, key: bool = ..., del_keys: bool = ..., single: bool = ...
    ) -> None: ...
    def updateSlidersFromChannelPrimsGeo(
        self, channel_prims_geo: hou.Geometry, joint_name: str, onlyAnimated: bool = ...
    ) -> None: ...
    def onConstraintsEnableOverrideCallback(self, toggle_name: str) -> Callable[[bool], None]: ...
    def onConstraintsEnableOverride(self, toggle_name: str, v: bool) -> None: ...
    def enableWidget(self, name: str, on: bool) -> None: ...
    def onConstraintsLockCallback(self, toggle_name: str) -> Callable[[bool], None]: ...
    def onConstraintsLock(self, toggle_name: str, v: bool) -> None: ...
    def onImpulseActivateCallback(self, toggle_name: str) -> Callable[[bool], None]: ...
    def onImpulseActivate(self, toggle_name: str, v: bool) -> None: ...
    def setImpulseThresholdToggle(self, value: bool) -> None: ...
    def updateConstraintSliderFromChannel(self, channel: hou.ChannelPrim, slider_name: str) -> None: ...
    def setConstraintsFieldLabels(self, src: str, dst: str) -> None: ...
    def onConstraintsSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def onConstraintsSliderWidgetValueChange(self, slider_name: str, v: float) -> None: ...

class RagdollBaseParameterWidget(Generic[_V_co]):
    VISUALIZE_CHARACTER_ITEMS: ClassVar[list[str]]
    GROUND_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    DEBUG_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    GROUND_DEFAULTS: ClassVar[dict[str, float]]
    # None only until a subclass's __init__ binds them.
    toolbar: ToolbarWidget
    tab_widget_name: str | None
    tab_name: str | None
    hud_window: shud.WidgetBundleWindow
    SOLVER_TOGGLE_DEFAULTS: dict[str, bool]
    SOLVER_DEFAULTS: dict[str, _V_co]
    ACTION_PARMS: list[str]
    @property
    def tool(self) -> RagdollStateBase | None: ...
    def loadFromConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def saveToConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    @property
    def widgethotkey(self) -> str | None: ...
    @widgethotkey.setter
    def widgethotkey(self, val: str) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> bool: ...
    def isVisible(self) -> bool: ...
    # Bound to float sliders, and to the gravity vector (its values' tuple).
    def onSolverSliderValueChangeCallback(self, slider_name: str) -> Callable[[float | tuple[float, ...]], None]: ...
    def onSolverSliderWidgetValueChange(self, slider_name: str, v: float | tuple[float, ...]) -> None: ...
    def showGroundPlane(self, v: bool) -> None: ...
    def enableGroundPlane(self, v: bool) -> None: ...
    def showVisualiserOffsetHandle(self, v: bool) -> None: ...
    # The Display Mode combo box's index.
    def onDisplayModeChanged(self, v: int) -> None: ...
    def showShapeIntersections(self, v: bool) -> None: ...
    def showShapesOutsideLimits(self, v: bool) -> None: ...
    def getToggleState(self, name: str) -> bool: ...
    def updateParmsFromDict(self, d: apex.Dict) -> None: ...
    def onValueCallback(self, name: str) -> Callable[[str], None]: ...
    def valueAction(self, name: str, hk: str | None = ...) -> None: ...
    # A toggle's bool, a combo box's index, a slider's float, or the gravity vector.
    def updateParm(self, name: str, val: float | _apex.FloatArray | hou.Vector3) -> None: ...
    def resetSlider(self, name: str) -> None: ...

class RagdollToolParameterWidget(RagdollBaseParameterWidget[float | hou.Vector3]):
    SOLVER_TOGGLE_DEFAULTS: dict[str, bool]
    SOLVER_DEFAULTS: dict[str, float | hou.Vector3]
    ACTION_PARMS: list[str]
    tab_widget_name: str | None
    tab_name: str | None
    hud_window: shud.WidgetBundleWindow
    toolbar: ToolbarWidget
    def __init__(
        self,
        tool: RagdollTool,
        hud_window: shud.WidgetBundleWindow | None = ...,
        tab_widget_name: str | None = ...,
        tab_name: str | None = ...,
    ) -> None: ...
    @property
    def tool(self) -> RagdollTool | None: ...
    def onSolverSliderWidgetValueChange(self, slider_name: str, v: float | tuple[float, ...]) -> None: ...
    def setStartFrame(self, v: float) -> None: ...
    def doScopeRagdollParameters(self, v: bool) -> None: ...
    def showConstraints(self, v: int) -> None: ...
    def showMatchWorld(self, v: bool) -> None: ...
    def writeRigToSceneGraph(self, v: bool) -> None: ...
    def updateParmsFromDict(self, d: apex.Dict) -> None: ...
    def resetSlider(self, name: str) -> None: ...


    def enable(self, val: bool) -> None: ...
    def setOpacity(self, weight: float = ..., min_opacity: float = ..., max_opacity: float = ..., max_line_opacity: float = ...) -> None: ...
    def showRotateGuides(self, on: bool) -> None: ...

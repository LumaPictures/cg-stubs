    def setRotLimits(self, limit_min: hou.Vector3 | None = ..., limit_max: hou.Vector3 | None = ...) -> None: ...
    def setGuideRotLimits(self, guide_limit_min: hou.Vector3 | None = ..., guide_limit_max: hou.Vector3 | None = ...) -> None: ...
    def getRotLimitMin(self) -> hou.Vector3 | None: ...
    def getRotLimitMax(self) -> hou.Vector3 | None: ...
    def setTranslateLimits(self, limit_min: hou.Vector3 | None = ..., limit_max: hou.Vector3 | None = ...) -> None: ...

from collections.abc import Callable, Iterable, Mapping, Sequence
from typing import Protocol, TypeAlias, TypeVar

import _apex
import apex
import hou
import apex.stateutils_2 as asu

# apex.Dict() converts only a dict (not another mapping).
_DriverPaths = TypeVar("_DriverPaths", bound=str | Sequence[str])
_V = TypeVar("_V", bound=_apex._ValueArg)

class _AnimateState(asu._AnimateState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members `apex.stateutils_2._AnimateState` declares."""

# A constraint's driven or driver dictionary: each name to a control path, or to several.
_ControlDict: TypeAlias = Mapping[str, str | Sequence[str]] | apex.Dict

CONSTRAINT_GRAPH_PATH: str

def constraintManager(scene: apex.Scene) -> apex.ConstraintManager: ...
def loadConstraint(scene: apex.Scene, state: _AnimateState | None = ..., manager: apex.ConstraintManager | None = ..., last: bool = ...) -> None: ...
def loadConstraintParms(scene: apex.Scene, manager: apex.ConstraintManager | None = ...) -> None: ...
def updateMultiConstraintDrawables(state: _AnimateState, scene: apex.Scene, manager: apex.ConstraintManager | None = ...) -> None: ...
def removeMultiConstraint(scene: apex.Scene, manager: apex.ConstraintManager | None) -> None: ...
def disableControlsFromConstraints(scene: apex.Scene) -> None: ...
def disableControlsFromLegacyConstraints(scene: apex.Scene) -> None: ...
def setConstraintParms(scene: apex.Scene, constraint_path: str, parms: apex.Dict, manager: apex.ConstraintManager | None = ...) -> None: ...
def pushConstraint(scene: apex.Scene, constraint: apex.Constraint, manager: apex.ConstraintManager | None = ..., force_unique: bool = ...) -> None: ...
def popConstraint(scene: apex.Scene, driven_path: str, manager: apex.ConstraintManager | None = ...) -> apex.Constraint | None: ...
def buildOffsetConstraint(
    scene: apex.Scene,
    driven_path: str,
    driver_path: str,
    t: bool = ...,
    r: bool = ...,
    s: bool = ...,
    use_offset: bool = ...,
    blend: float = ...,
    compute_matrices: bool = ...,
) -> apex.Constraint: ...
def buildConstraintFromDict(
    scene: apex.Scene, driven_path: str, entry: apex.Dict | dict[str, _V], compute_matrices: bool = ...
) -> apex.Constraint: ...
def buildConstraint(
    scene: apex.Scene,
    driven_path: str,
    driver_dict: apex.Dict | dict[str, _DriverPaths],
    graph_path: str,
    parms: apex.Dict | dict[str, _V] = ...,
    enable: bool = ...,
    compute_matrices: bool = ...,
) -> apex.Constraint: ...
def updateConstraintMatrices(scene: apex.Scene, constraint: apex.Constraint) -> dict[str, hou.Matrix4 | apex.Matrix4Array]: ...
def computeConstraintMatrices(
    scene: apex.Scene, driven_dict: _ControlDict, driver_dict: _ControlDict, graph_path: str
) -> dict[str, hou.Matrix4 | apex.Matrix4Array]: ...
def getVisibleConstraints(scene: apex.Scene, manager: apex.ConstraintManager | None = ...) -> list[apex.Constraint]: ...
def getPinnedConstraints(scene: apex.Scene, manager: apex.ConstraintManager | None = ...) -> list[apex.Constraint]: ...
def getSelectedConstraints(scene: apex.Scene, manager: apex.ConstraintManager | None = ...) -> list[apex.Constraint]: ...
def setConstraintsVisible(
    scene: apex.Scene, constraint_paths: Iterable[str], pick_mod: hou.EnumValue[hou.pickModifier], manager: apex.ConstraintManager | None = ...
) -> None: ...
def setConstraintsPinned(
    scene: apex.Scene, constraint_paths: Iterable[str], pick_mod: hou.EnumValue[hou.pickModifier], manager: apex.ConstraintManager | None = ...
) -> None: ...
def setConstraintsSelected(
    scene: apex.Scene, constraint_paths: Iterable[str], pick_mod: hou.EnumValue[hou.pickModifier], manager: apex.ConstraintManager | None = ...
) -> None: ...
def updateActiveCameraConstraints(scene_viewer: hou.SceneViewer, scene: apex.Scene) -> None: ...
def isConstrainedAtFrame(scene: apex.Scene, ctrl_path: str, frame: float) -> bool: ...
# fn returns True to stop.
def forEachControl(driver_dict: _ControlDict, fn: Callable[[str], bool | None]) -> None: ...
def getDrivers(driver_dict: _ControlDict) -> list[str]: ...

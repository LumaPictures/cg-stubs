_T = TypeVar("_T")
# What a subclass's widgets, selectables and subtools hold: the subclass's own kinds of them.
_PWS_co = TypeVar("_PWS_co", bound=SceneParmWidgetSet, default=SceneParmWidgetSet, covariant=True)
_HW_co = TypeVar("_HW_co", bound="EffectParmHudWidget", default="EffectParmHudWidget", covariant=True)
_SW_co = TypeVar("_SW_co", bound="EffectParmHudWidget", default="EffectParmHudWidget", covariant=True)
_ST_co = TypeVar("_ST_co", bound="EffectSubtool", default="EffectSubtool", covariant=True)
_SEL_co = TypeVar("_SEL_co", bound="EffectParmSelectable", default="EffectParmSelectable", covariant=True)

class _AnimateState(_ChannelState, _BakeState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""

    def _runSceneCallbacks(self) -> None: ...
    def addMissingChannelsForParms(self, scoped_parms: Mapping[str, Sequence[str]]) -> None: ...

# A parameter widget's value, with its float lists made vectors (EffectParmHudWidget.onParmValueChange).
_ParmValue: TypeAlias = bool | int | float | str | hou.Vector2 | hou.Vector3 | hou.Vector4 | None
# What the effect's parameter widgets are set from: their own values, or the solver graph's parameters.
_WidgetValue: TypeAlias = _HUDParmValue | _apex._Value

class _ParmChangeKwargs(TypedDict, total=False):
    """What `EffectTool.onParmValueChange` passes to the subtools' `onParmWidgetValueChangeToGraph`."""

    parm_name: Required[str]
    val: Required[_ParmValue]
    active: bool
    start_slider: bool
    end_slider: bool
    focused_subtool_only: bool

class _AnimatedParmActionKwargs(TypedDict):
    parm_name: str
    action: str
    frame: float | None
    value: float | None

class _ActionButtonKwargs(TypedDict):
    parm_name: str

class _CollectionNamesKwargs(TypedDict):
    collection_names: Sequence[str]

class _PreSelectionChangedKwargs(TypedDict):
    """What the Animate state's `onPreSelectionChanged` tool event passes; tools may edit `ctrl_paths`."""

    ctrl_paths: list[str]
    pick_modifier: hou.EnumValue[hou.pickModifier]
    primary_control: str | None

class _BakeKwargs(TypedDict, total=False, extra_items=_HUDParmValue):  # type: ignore[call-arg]
    """The Animate state's bake parameters (its settings HUD's `getBakeParms()`), by name.

    The tools set `bake_newlayer` in it, and secondarymotiontool `controls_to_bake`.
    """

    controls_to_bake: set[str]

# What the Animate state's pose events pass: the viewer event's kwargs when dragging a control,
# or the transform gadget's callback dict (a `_HandleStartUpdateKwargs` for onPoseStartEvent).
_PoseKwargs: TypeAlias = ViewerStateEventKwargs | _HandleUpdateKwargs
_PoseStartKwargs: TypeAlias = ViewerStateEventKwargs | _HandleStartUpdateKwargs
_TabInfo: TypeAlias = tuple[WidgetBundleWindow | None, str | None, str | None]

UNDO_TAG: str
EFFECT_ENABLE_PARM: str
EFFECT_LABLE_WIDTH: int
EFFECT_FIELD_WIDTH: int
EFFECT_PARM_TAGS: dict[str, dict[str, bool | str]]
STYLE_SETTINGS: pws._StyleSettings

def loadGraph(graph_path: str) -> apex.Graph: ...

class EffectParmHudWidget(apexhud.ParameterWidget[_AnimateState, WidgetBundleWindow], Generic[_PWS_co]):
    hud_window: WidgetBundleWindow
    parm_widget_set: _PWS_co
    @property
    def tool(self) -> "EffectTool | None": ...
    @property
    def focused_subtool(self) -> "EffectSubtool | None": ...
    @property
    def channel_manager(self) -> SceneChannelManager | None: ...
    def onHotkeyEvent(self, name: str, hk: str | None = ...) -> None: ...
    def createParmWidgetSet(self, tool: EffectTool) -> SceneParmWidgetSet: ...
    def getParmKeys(self) -> list[str]: ...
    def getParmDict(self) -> dict[str, _HUDParmValue]: ...
    def getParmValue(self, parm_name: str) -> _HUDParmValue: ...
    def getParmTags(self, parm_name: str) -> dict[str, str] | None: ...
    def updateParmValue(self, parm_name: str, val: _WidgetValue, refresh_hide_disable: bool = ...) -> bool: ...
    def updateParmValuesFromDict(self, d: Mapping[str, _WidgetValue] | apex.Dict) -> bool: ...
    def setParmWidgetEnabled(self, name: str | list[str], enabled: bool) -> None: ...
    def setParmWidgetVisible(self, name: str | list[str], visible: bool) -> None: ...
    # No-ops, which ignore any options.
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: object) -> None: ...
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: object) -> None: ...

class EffectParmUndo(Generic[_T]):
    prev_parm: _T
    parm: _T
    callback: Callable[[_T], object]
    def __init__(self, prev_parm: _T, parm: _T, callback: Callable[[_T], object]) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class EffectParmSelectable(Generic[_HW_co, _SW_co]):
    class SELECT_MODE(Enum):
        Default = "default"
        SingleSelect = "single_select"

    class SELECT_TARGET(Enum):
        Joints = "joint"
        Controls = "control"

    @dataclass
    class ColConfig:
        targets: set[str]

    DEFAULT_COL_CONFIG: ClassVar[ColConfig]

    @dataclass
    class Parm:
        saved_selection: dict[str, set[str]]

    hud_widget: _HW_co | None
    settings_widget: _SW_co | None
    selected: set[str]
    is_reselecting: bool
    is_selecting: bool
    single_select: bool
    confirm_selection_hk: str
    abort_selection_hk: str
    cur_parm: str
    prev_parm_value: str
    char_path: str
    select_joint_path: str
    joint_rig_name: str
    joint_rig_path: str
    joint_skel_drawable: apexscene.SceneOutputDrawable | None
    joint_hidden: bool | None
    control_rig_path: str
    saved_control_cols: dict[str, tuple[float, ...]]
    control_hidden: bool | None
    debug: "EffectParmSelectable.SELECT_TARGET | None"
    def __init__(self, subtool: EffectSubtool, hud_widget: _HW_co | None = ..., settings_widget: _SW_co | None = ...) -> None: ...
    @property
    def subtool(self) -> "EffectSubtool | None": ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def cur_select_target(self) -> "EffectParmSelectable.SELECT_TARGET | None": ...
    @property
    def prompt_message(self) -> str | None: ...
    @property
    def joint_ctrl_scale(self) -> float: ...
    def endSelection(
        self,
        cancel: bool = ...,
        exit: bool = ...,
        modifier: hou.EnumValue[hou.pickModifier] = ...,
        parm_name: str | None = ...,
        focused_subtool_only: bool = ...,
    ) -> bool: ...
    # cur_val is the parameter's selection string.
    def switchSelectTarget(
        self, parm_name: str, select_target: "EffectParmSelectable.SELECT_TARGET", cur_val: str | None = ...
    ) -> bool: ...
    def onActivate(self, parms: Iterable[str]) -> None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onPlaybackChanged(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...

class EffectTool(Generic[_ST_co, _HW_co, _SW_co]):
    name: str
    subtools: list[_ST_co]
    focused_subtool: _ST_co | None
    default_hud_rows: list[hou._HudRow]
    parm_widget: _HW_co | None
    sett_widget: _SW_co | None
    solver_graph: apex.Graph | None
    tool_path: str
    def __init__(self, state: _AnimateState, solver_graph: apex.Graph | None = ...) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def hud_widget(self) -> _HW_co | None: ...
    @property
    def settings_widget(self) -> _SW_co | None: ...
    def label(self) -> str: ...
    def hudTemplate(self) -> list[hou._HudRow]: ...
    # Calls the named method of each active subtool that has one, and combines their results:
    # whatever those methods return (Any, as the method is looked up by name).
    def subtoolEvent(self, eventname: str, *args: object, default: object = ...) -> Any: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> bool: ...
    def setupWidgets(self, channel_hud_tab_info: _TabInfo, settings_hud_tab_info: _TabInfo) -> None: ...
    def createSubtool(
        self, char_path: str, rest_skel: hou.Geometry, node_name: str, skel_name: str, rest_ctrl_skel: hou.Geometry | None
    ) -> "EffectSubtool": ...
    def createHudWidget(
        self, hud_window: WidgetBundleWindow | None, tab_widget_name: str | None, tab_name: str | None
    ) -> EffectParmHudWidget: ...
    def onDeactivate(self) -> bool: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    # The Animate state's `pushChannels` tool event, whose (always empty) dict is ignored.
    def pushChannels(self, kwargs: Mapping[str, object]) -> None: ...
    def getScopedChannels(self) -> dict[str, list[str]] | Literal[False]: ...
    def scopeChannels(
        self,
        channel_list: hou.ChannelList,
        scoped_channels: dict[str, list[str]],
        pinned_channels: dict[str, list[str]],
    ) -> Literal[False] | None: ...
    def addGeometryChannelCallbacks(self, collection_names: Sequence[str]) -> Literal[False] | None: ...
    def removeGeometryChannelCallbacks(self) -> Literal[False] | None: ...
    def getPendingChannels(self) -> dict[str | None, dict[str, float]] | Literal[False]: ...
    def clearPendingChannels(self) -> Literal[False] | None: ...
    def updateAnimatedParms(self) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> bool | None: ...
    def onPreSelectionChanged(self, kwargs: _PreSelectionChangedKwargs) -> bool | None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> bool | None: ...
    def onPoseStartEvent(self, kwargs: _PoseStartKwargs) -> bool | None: ...
    def onPoseEvent(self, kwargs: _PoseKwargs) -> bool | None: ...
    def onPoseEndEvent(self, kwargs: _PoseKwargs) -> bool | None: ...
    # The Animate state passes the evaluation time.
    def onPreEvaluationEvent(self, kwargs: float) -> bool | None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> bool | None: ...
    def onBakeEvent(self, kwargs: _BakeKwargs) -> Literal[True]: ...
    def onParmValueChange(
        self,
        parm_name: str,
        val: _ParmValue,
        active: bool = ...,
        start_slider: bool = ...,
        end_slider: bool = ...,
        focused_subtool_only: bool = ...,
    ) -> bool | None: ...
    def onAnimatedParmAction(
        self, parm_name: str, action: str, frame: float | None = ..., value: float | None = ...
    ) -> bool: ...
    def onActionButtonEvent(self, parm_name: str) -> bool | None: ...
    def onPreSave(self) -> bool | None: ...
    def onPostSave(self) -> bool | None: ...
    def displayPrompt(self) -> bool: ...

class EffectSubtool(Generic[_SEL_co]):
    rest_skel: hou.Geometry
    node_name: str
    skel_name: str
    rest_ctrl_skel: hou.Geometry | None
    xforms: dict[str, hou.Matrix4]
    anim_skel: hou.Geometry | None
    output_skel: hou.Geometry | None
    selectable_parm: _SEL_co | None
    effect_enabled: bool
    motion_clip: dict[str, hou.Geometry | None]
    anim_tracker: AnimTracker
    driven_char_path: str
    driven_rig_path: str
    ctrl_skel_path: str
    ctrl_skel: hou.Geometry | None
    channel_manager: SceneChannelManager | None
    solver_graph: apex.Graph | None
    is_active: bool
    mapping_property_name: str
    prompt: str | None
    solver_parm_dataId: dict[str, tuple[int, ...]]
    solve_ctrl_rig_baker: apexbake.RigBaker | None
    solve_ctrl_bake_keys: list[str] | KeysView[str]
    anim_xform_ctrls: set[str] | None
    skel_baker: SkeletonBaker
    skin_name: str | None
    def __init__(
        self,
        tool: EffectTool,
        driven_char_path: str,
        rest_skel: hou.Geometry,
        node_name: str,
        skel_name: str,
        rest_ctrl_skel: hou.Geometry | None,
    ) -> None: ...
    @property
    def tool(self) -> EffectTool | None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def anim_binding(self) -> apex.ChannelPrimBindings | None: ...
    @property
    def rig_params(self) -> apex.Dict: ...
    def driven_char(self) -> apex.SceneCharacter: ...
    def driven_rig(self) -> apex.SceneGraph: ...
    def driven_control_manager(self) -> apex.ControlManager: ...
    def driven_control_template(self) -> hou.Geometry: ...
    # Joint names to the paths of the controls mapped to them.
    def mapping(self) -> dict[str, list[str]]: ...
    def displayPrompt(self, kwargs: Mapping[str, object]) -> bool: ...
    def effectEnabled(self) -> bool: ...
    def onPreEvaluationEvent(self, kwargs: float) -> Literal[False] | None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> Literal[False] | None: ...
    def onParmWidgetValueChangeToGraph(self, kwargs: _ParmChangeKwargs) -> None: ...
    def onAnimatedParmAction(self, kwargs: _AnimatedParmActionKwargs) -> bool: ...
    # Default parameter values to reset to (all the solver graph's when None).
    def resetSolverParms(self, parms: dict[str, _apex._Value | ChannelData | None] | None = ...) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onActionButtonEvent(self, kwargs: _ActionButtonKwargs) -> None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def animatedParms(self) -> list[str]: ...
    # The tool events below get an (ignored) dictionary from EffectTool.
    def pushChannels(self, kwargs: Mapping[str, object]) -> bool: ...
    def getScopedChannels(self, kwargs: Mapping[str, object]) -> dict[str, list[str]] | Literal[False]: ...
    def scopeChannels(self, kwargs: _ScopeChannelsKwargs) -> None: ...
    def addGeometryChannelCallbacks(self, kwargs: _CollectionNamesKwargs) -> None: ...
    def removeGeometryChannelCallbacks(self, kwargs: Mapping[str, object] | None = ...) -> None: ...
    def getPendingChannels(self, kwargs: Mapping[str, object]) -> dict[str | None, dict[str, float]]: ...
    def clearPendingChannels(self, kwargs: Mapping[str, object]) -> None: ...
    def setSolverGraph(self, graph: apex.Graph, graph_name: str | None = ...) -> None: ...
    def getSolverGraphParms(self) -> apex.Dict: ...
    def setSolverGraphParms(self, parms: apex.Dict | Mapping[str, _apex._ValueArg]) -> None: ...
    def muteAnimBinding(self) -> bool | None: ...
    def unmuteAnimBinding(self) -> bool | None: ...
    def solve(self, frame: float | None = ..., solve_controls: bool = ...) -> None: ...
    # solver_out is ignored.
    def createSolveCtrlBakeMap(self, solver_out: hou.Geometry | None = ...) -> dict[str, apexbake.BakeSourceXform]: ...
    def createSolveJointTRS(self, solver_out: hou.Geometry | None = ...) -> dict[str, _CtrlParms]: ...
    def onPoseEvent(self, kwargs: _PoseKwargs) -> Literal[False]: ...
    def savePose(self) -> None: ...
    def setDrivenControlsEnabled(self, on: bool) -> None: ...
    def getCurrentSkeleton(self) -> hou.Geometry: ...
    def getCurrentCtrlSkeleton(self) -> hou.Geometry: ...
    def createChannelManager(
        self, *args: *tuple[_AnimateState, str, Callable[[], object] | None, str, str | None]
    ) -> SceneChannelManager | None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def onExit(self) -> None: ...
    def onDeactivate(self) -> Literal[False]: ...
    def loadEffectSettings(self) -> None: ...
    def saveEffectSettings(self) -> None: ...
    def onPreSave(self) -> None: ...
    def onPostSave(self) -> None: ...
    def onBakeEvent(self, kwargs: _BakeKwargs) -> Literal[True]: ...

def load(viewer_state: _AnimateState) -> EffectTool: ...

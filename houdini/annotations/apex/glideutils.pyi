from collections.abc import Mapping
from typing import Never

import apex
import hou

class ModeKind:
    @staticmethod
    def fromToken(name: str) -> ModeKind | None: ...

class BrushKind:
    @staticmethod
    def fromToken(name: str) -> BrushKind | None: ...

# Brush centers and drag positions are hou.UIEventDevice.mouseX()/mouseY(), which are floats.
class BrushShape:
    def setCenter(self, x: float, y: float) -> None: ...
    def setRadius(self, radius: float) -> None: ...

class Brush:
    def updateShape(self) -> None: ...
    def config(self) -> dict[str, float]: ...
    # The tool's saved config: python dicts until the graph's config round-trips through an
    # apex.Dict, which the nested configs then are.
    def loadConfig(self, config: Mapping[str, float] | apex.Dict) -> None: ...
    def x(self) -> float: ...
    def y(self) -> float: ...
    def setCenter(self, x: float, y: float) -> None: ...
    # hou.hmath.clamp() makes the radius a float.
    def radius(self) -> float: ...
    def setRadius(self, radius: float) -> None: ...
    def falloffThreshold(self) -> float: ...
    def setFalloffThreshold(self, falloff_threshold: float) -> None: ...
    def _pixelRadiusToNdcScale(self, length: float) -> hou.Vector2: ...

class SmoothBrush(Brush):
    def config(self) -> dict[str, float]: ...
    def loadConfig(self, config: Mapping[str, float] | apex.Dict) -> None: ...

class BrushManager:
    def onContinueStroke(self, geo: hou.Geometry) -> dict[Never, Never] | None: ...
    def setActiveBrushCenter(self, x: float, y: float) -> None: ...
    def activeBrushRadius(self) -> float: ...
    def setActiveBrushRadius(self, radius: float) -> None: ...
    def activeBrushFalloffThreshold(self) -> float: ...

class DraggerNdc:
    def startDrag(self, mouse_x: float, mouse_y: float) -> None: ...
    def continueDrag(self, mouse_x: float, mouse_y: float) -> None: ...
    def _mouseToNdc(self, mouse_x: float, mouse_y: float) -> hou.Vector2: ...

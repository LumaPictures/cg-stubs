from collections.abc import Iterable
from typing import Protocol

import apex
from apex.scene_2 import SceneOutputDrawable, SceneShapeOutputDrawable
from typing_extensions import TypedDict

class SceneEvaluator:
    # scene_2 adds the rigs' shape and control drawables; tools add their own.
    drawables: list[SceneOutputDrawable | SceneShapeOutputDrawable]
    def __init__(self, scene: apex.Scene, drawables: Iterable[SceneOutputDrawable | SceneShapeOutputDrawable]) -> None: ...
    @property
    def scene(self) -> apex.Scene | None: ...
    # The Animate state calls its scene callbacks with only `time=`.
    def __call__(self, time: float, **kwargs: object) -> None: ...

class AnimationEvaluatorCollection(SceneEvaluator):
    anim_evaluators: dict[str, "AnimationEvaluatorBase"]
    active: bool
    update_blockers: int
    def __init__(self, scene: apex.Scene) -> None: ...
    def __call__(self, time: float, **kwargs: object) -> None: ...
    def __getitem__(self, key: str) -> "AnimationEvaluatorBase": ...
    def __setitem__(self, key: str, value: "AnimationEvaluatorBase") -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str) -> "AnimationEvaluatorBase | None": ...
    def pop(self, key: str) -> "AnimationEvaluatorBase": ...
    def updateAtFrame(self, frame: float) -> None: ...

class AnimationEvaluatorBase:
    anim_tracker: "AnimTracker"
    active: bool
    dirty: bool
    cur_frame: int
    # [start, end], inclusive.
    frame_range: list[int]
    # Never set.
    pending_frame: None
    layer_pattern: str
    def __init__(self, scene: apex.Scene) -> None: ...
    @property
    def scene(self) -> apex.Scene | None: ...
    def __call__(self, time: float, **kwargs: object) -> None: ...
    def setLayerPattern(self, layer_pattern: str) -> None: ...
    def trackRig(self, rig_path: str) -> None: ...
    def trackRigs(self, rig_paths: Iterable[str]) -> None: ...
    def isValidFrame(self, frame: int) -> bool: ...
    def frameDirty(self, frame: int) -> bool: ...
    def setFrameRange(self, start_frame: float, end_frame: float) -> None: ...
    def updateChannelDataIds(self, force: bool = ...) -> bool: ...
    def setFrame(self, frame: int) -> None: ...
    def needsUpdate(self, frame: int) -> bool: ...
    # Does nothing here; MotionPathEvaluator's returns True. Callers ignore the result.
    def update(self, frame: int) -> bool | None: ...
    def setDirty(self, dirty: bool) -> None: ...

def matchLayers(scene: apex.Scene, layer_pattern: str = ...) -> list[str]: ...

class AnimTracker:
    # Each layer's weight channel data ids, then its muted, soloed and additive flags.
    data_ids: dict[str, list[int]]
    rig_trackers: dict[str, "RigAnimTracker"]
    enabled: bool
    # Only clear() sets it (to {}), where it means to reset data_ids.
    channel_data_ids: dict[str, list[int]]
    def __contains__(self, rig_path: str) -> bool: ...
    def trackRig(self, rig_path: str) -> None: ...
    def update(self, scene: apex.Scene, layer_pattern: str = ...) -> bool: ...

class RigAnimTracker:
    # Each layer's channel data ids.
    data_ids: dict[str, list[int]]
    rig_path: str
    def __init__(self, rig_path: str) -> None: ...
    def update(self, scene: apex.Scene, layer_names: Iterable[str]) -> bool: ...

class _SceneCallback(Protocol):
    """A callback in the Animate state's `scene_callbacks`: the state calls each with `time=` when it evaluates the scene."""

    def __call__(self, time: float) -> object: ...

class _SceneCallbacks(TypedDict, extra_items=_SceneCallback):
    """The Animate state's `scene_callbacks`: scene_2.buildEvaluatorsForRigs()'s evaluators (which
    the state makes when it loads its scene, before any tool runs), and those tools add."""

    anim: "AnimationEvaluatorCollection"
    scene: "SceneEvaluator"

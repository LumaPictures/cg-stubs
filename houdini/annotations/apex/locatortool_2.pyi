from collections.abc import Callable, Iterable, Mapping, Sequence
from enum import StrEnum
from typing import Literal, Never, Protocol

import _apex
import apex
import hou
import statehud.window as shud
from apex.ui.animationhudwidgets import BaseHudWidget, ParameterWidget
from apex.autorigtool import _ToolActivateKwargs
from apex.constraintutils import _AnimateState as _ConstraintUtilsState
from apex.mapping_2 import MappingCollection, MappingGadget
from apex.stateutils_2 import Hotkeys
from houtypes import (
    ViewerParmProperties,
    ViewerStateDrawKwargs,
    ViewerStateEventKwargs,
    ViewerStateKwargs,
    ViewerStateMenuActionKwargs,
    ViewerStateMenuPreOpenKwargs,
    ViewerStateParmChangeKwargs,
    ViewerStatePlaybackChangeKwargs,
    ViewerStateVolatileClientKwargs,
)
from statehud.baseconfig import AbstractConfig
from statehud.parmutils import _HUDParmValue
from statehud.window import _ParmEventDict

class _AnimateState(_ConstraintUtilsState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members of the states it extends."""

TOOL_PATH: str
DEFAULT_SHAPES: list[str]

class LocatorToolbox(StrEnum):
    Add = "apex_locator_add"
    Remove = "apex_locator_remove"
    Reparent = "apex_locator_reparent"
    Origin = "apex_locator_origin"
    Tool = "apex_locator"

# control_parm is a ControlMapping attribute: "t", "r", "s", "x" or "y".
def setParms(
    state: _AnimateState,
    control_parm: str,
    value: _apex._ValueArg,
    evaluate: bool = ...,
    control_manager: apex.ControlManager | None = ...,
    ctrl_paths: Iterable[str] | None = ...,
) -> None: ...

class LocatorSettingsWidget(ParameterWidget[_AnimateState]):
    DEFAULT_SIZE: int
    DEFAULT_LABEL_WIDTH: int
    def __init__(
        self, tool: "LocatorTool", hud_window: shud.WidgetBundleWindow | None = ..., tab_widget_name: str | None = ..., tab_name: str | None = ...
    ) -> None: ...
    @property
    def tool(self) -> "LocatorTool | None": ...
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None: ...
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None: ...
    def onOriginCallback(self, name: str) -> Callable[[bool], bool]: ...
    def onOrigin(self, name: str, v: bool) -> Literal[False]: ...

class LocatorHudWidget(BaseHudWidget[_AnimateState, shud.WidgetBundleWindow | None, apex.TransformControl]):
    DEFAULT_SIZE: int
    DEFAULT_LABEL_WIDTH: int
    MOUSE_OFFSET: int
    current_selection_names: list[str]
    current_controls: list[apex.TransformControl]
    mute_value_update: bool
    # Never filled.
    trs_sliders: list[Never]
    transit_hk: str
    def __init__(
        self, tool: "LocatorTool", hud_window: shud.WidgetBundleWindow | None = ..., tab_widget_name: str | None = ..., tab_name: str | None = ...
    ) -> None: ...
    @property
    def tool(self) -> "LocatorTool | None": ...
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None: ...
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None: ...
    def onZeroCallback(self, name: str) -> Callable[[bool], None]: ...
    def onResetCallback(self, name: str) -> Callable[[bool], None]: ...
    def resetCallback(self, name: str, v: bool) -> None: ...
    def zeroCallback(self, name: str, v: bool) -> None: ...
    def setColor(self) -> None: ...
    def onColorChange(self, value: _HUDParmValue) -> Literal[False] | None: ...

class EmptyUpdateHandler:
    def update(self, geo: hou.Geometry) -> Literal[True]: ...

class LocatorTool:
    processor_graph: apex.Graph | None
    processor_parms: apex.Dict
    locator_rig: None
    add_hk: str
    remove_hk: str
    reparent_hk: str
    shape_names: list[str]
    use_hud_widget: bool
    hud_widget: LocatorHudWidget | None
    use_mapping_gadget: bool
    mapping_gadget: MappingGadget
    interrupted: bool
    use_rest_update: bool
    constraint_rig: None
    compute_world: hou.SopVerb
    compute_local: hou.SopVerb
    name: str
    hud_template: None
    hud_rows: list[hou._HudRow]
    settings_widget: LocatorSettingsWidget | None
    create_at_origin: bool
    mapping_collection: MappingCollection
    key_consumed: bool
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    def label(self) -> str: ...
    def hudTemplate(self) -> list[hou._HudRow]: ...
    # None until the locator character is added.
    def rig(self) -> apex.SceneGraph | None: ...
    def initProcessor(self) -> None: ...
    # None when the locators' skeleton is empty.
    def setLocatorSettings(
        self, name: str | None = ..., position: hou.Vector3 | None = ..., parent: apex.Control | Literal[False] = ...
    ) -> tuple[bool, str] | None: ...
    def createLocator(self) -> None: ...
    def addLocator(self, name: str | None = ..., position: hou.Vector3 | None = ..., parent: apex.Control | Literal[False] = ...) -> None: ...
    def addConstraintEntry(self, driver: apex.Control, driven: apex.Control) -> None: ...
    def removeConstraintEntry(self, control: apex.Control) -> bool: ...
    def initGadget(self) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def removeLocator(self, name: str | None = ...) -> None: ...
    def updateMappingGadget(self) -> None: ...
    def evaluatMappingGadget(self) -> None: ...
    # controls is unused: the state's control manager's controls are scaled.
    def updateScale(self, controls: Iterable[str], scale: hou.Vector3, relative: bool = ...) -> None: ...
    def updateColor(self, color: hou.Vector3) -> None: ...
    def updateShape(self, shape_name: str) -> None: ...
    def getControlProperty(self, control: apex.Control) -> apex.Dict: ...
    def setControlProperty(self, control: apex.Control, properties: apex.Dict) -> None: ...
    def getControlShape(self, control: apex.Control) -> str: ...
    def getControlColor(self, control: apex.Control) -> hou.Vector3: ...
    # parent is unused.
    def createDefaultRig(self, parent: apex.Control | None = ...) -> apex.Graph: ...
    def skeleton_from_graph(self) -> None: ...
    def updateLocatorRig(self, settings: apex.Dict | None = ...) -> None: ...
    def setLocatorRig(self, graph: apex.Graph | None = ...) -> None: ...
    def updateGraphForPoseState(self, graph: apex.Graph) -> apex.Graph: ...
    def getLocatorRig(self) -> None: ...
    def addLocatorCharacter(self, parent: apex.Control | None = ...) -> None: ...
    def setParent(self, control: apex.Control, new_parent: apex.Control | None = ...) -> None: ...
    # None when the locators' skeleton is empty.
    def updateRestpostion(self, ctrl_paths: Sequence[str] | None = ..., update: bool = ...) -> hou.Geometry | None: ...
    def updateFromSkeleton(self, skel: hou.Geometry, ctrl_paths: Sequence[str] | None) -> None: ...
    def writeToGeo(self) -> None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    # None until the locator character is added.
    def control_manager(self) -> apex.ControlManager | None: ...
    def onPostPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> Literal[False]: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def onSelectionChanged(self, selection: Sequence[str], **kwargs: Never) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def getShapeOffset(self, control: apex.Control) -> hou.Matrix4: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onPostSelectionEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def onPostEvaluationEvent(self, time: float) -> Literal[False]: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onHUDSettingEvent(self, kwargs: _ParmEventDict) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> Literal[False]: ...
    def updateStateParms(self, state_parms: Mapping[str, ViewerParmProperties]) -> None: ...

def load(viewer_state: _AnimateState) -> LocatorTool: ...
def bindParametersToTemplate(template: hou.ViewerStateTemplate) -> None: ...
def bindActionsToMenu(menu: hou.ViewerStateMenu, hotkeys: Hotkeys) -> None: ...

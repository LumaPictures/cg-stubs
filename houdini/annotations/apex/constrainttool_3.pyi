from collections.abc import Generator, Iterable, Mapping, MutableSequence, Sequence
from contextlib import contextmanager
from typing import Literal, Protocol, TypeAlias

import _apex
import apex
import hou
from apex.animstack import _ActiveLayerChangedKwargs
from apex.autorigtool import _ToolActivateKwargs
from apex.channelbookmarkmanager import ChannelBookmarkManager, _ChannelBookmarkChangedKwargs
from apex.effecttool import _PreSelectionChangedKwargs
from apex.xformgadget import _HandleStartUpdateKwargs, _HandleUpdateKwargs
from apex.mapping_2 import MappingCollection, MappingGadget
from apex.sceneevaluators import AnimTracker
from apex.stateutils_2 import SetChannelsUndo
from apex.transientconstraint_2 import BakeMode, TransientConstraintManager
from apex.transientconstraint_2 import _AnimateState as _TransientConstraintState
from apex.ui.constrainthudwidgets import ConstraintParmWidget, ConstraintSettingsWidget
from houtypes import (
    ViewerStateDrawKwargs,
    ViewerStateEventKwargs,
    ViewerStateParmChangeKwargs,
    ViewerStatePlaybackChangeKwargs,
    ViewerStateVolatileClientKwargs,
)
from statehud.parmutils import _HUDParmValue
from statehud.window import _ParmEventDict
from typing_extensions import TypedDict, TypeVar

# apex.Dict() converts only a dict (not another mapping).
_V = TypeVar("_V", bound=_apex._ValueArg)

class _AnimateState(_TransientConstraintState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""

    # Set by staterecordutils' recorder while recording or playing back a regression test.
    _is_playing_back: bool
    _is_recording: bool

# The command_args of the tool commands this module sends the state.
class _ConstraintCommandArgs(TypedDict, total=False):
    parms_only: bool

# What the selection sets module passes the getControlLabels tool event; the tool fills it in.
class _ControlLabelsKwargs(TypedDict):
    labels: dict[str, str | None]

# The args of the selection sets module's relabel command.
class _ControlRelabeledKwargs(TypedDict, total=False):
    ctrl_path: str
    label: str | None

# A constraint shape parameter: "shape" (a name), "color" (an RGB) or "scale".
_ShapeParmValue: TypeAlias = str | float | Sequence[float] | hou.Vector3

def sendUpdateConstraintsCommand(state: _AnimateState, parms_only: bool = ...) -> None: ...
def sendUpdateConstraintContextCommand(state: _AnimateState) -> None: ...
def sendUpdateConstraintLabelsCommand(state: _AnimateState) -> None: ...

class ConstraintDataUndoStart:
    parms_only: bool
    context_only: bool
    def __init__(self, state: _AnimateState, parms_only: bool = ..., context_only: bool = ...) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

class ConstraintDataUndoEnd:
    parms_only: bool
    context_only: bool
    def __init__(self, state: _AnimateState, parms_only: bool = ..., context_only: bool = ...) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

def startConstraintUndo(state: _AnimateState, parms_only: bool = ..., context_only: bool = ...) -> None: ...
def endConstraintUndo(state: _AnimateState, parms_only: bool = ..., context_only: bool = ...) -> None: ...

class ConstraintDataUndo:
    label: str
    parms_only: bool
    context_only: bool
    undos: list[hou._UndoOperation]
    def __init__(self, state: _AnimateState, label: str, parms_only: bool = ..., context_only: bool = ...) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def append(self, undo: hou._UndoOperation) -> None: ...

@contextmanager
def constraintUndo(state: _AnimateState, label: str) -> Generator[ConstraintDataUndo]: ...
@contextmanager
def constraintParmsUndo(state: _AnimateState, label: str) -> Generator[ConstraintDataUndo]: ...
@contextmanager
def constraintContextUndo(state: _AnimateState, label: str) -> Generator[ConstraintDataUndo]: ...

class ConstraintUndo:
    constraints: Mapping[str, apex.Constraint]
    remove: bool
    def __init__(self, state: _AnimateState, constraints: Mapping[str, apex.Constraint], remove: bool) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

def addConstraintsUndo(state: _AnimateState, constraints: Mapping[str, apex.Constraint], remove: bool = ...) -> None: ...

class ConstraintParmsUndo:
    constraint_path: str
    pre_parms: apex.Dict
    post_parms: apex.Dict
    def __init__(
        self, state: _AnimateState, constraint_path: str, pre_parms: apex.Dict | dict[str, _V], post_parms: apex.Dict | dict[str, _V]
    ) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

class ConstraintEnabledUndo:
    constraint_path: str
    pre_enabled: bool
    post_enabled: bool
    def __init__(self, state: _AnimateState, constraint_path: str, pre_enabled: bool, post_enabled: bool) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

class ConstraintSelectedUndo:
    pre_constraints: list[str]
    post_constraints: list[str]
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

@contextmanager
def selectConstraintsUndo(state: _AnimateState) -> Generator[ConstraintSelectedUndo]: ...

class ConstraintLabelUndo:
    constraint_path: str
    pre_label: str
    post_label: str
    def __init__(self, state: _AnimateState, constraint_path: str, pre_label: str, post_label: str) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...

class TransientConstraintUndo:
    # The entry's key in the transient data, or the id addTransientEntry() gave it.
    data_id: str | int
    entry: apex.Dict
    layer: str
    add: bool
    def __init__(self, tool: "ConstraintTool", data_id: str | int, entry: apex.Dict, layer: str, add: bool = ...) -> None: ...
    @property
    def tool(self) -> "ConstraintTool | None": ...

class TransientConstraintUndoStart:
    layer: str
    add: bool
    def __init__(self, tool: "ConstraintTool", layer: str, add: bool = ...) -> None: ...
    @property
    def tool(self) -> "ConstraintTool | None": ...

class TransientConstraintUndoEnd:
    layer: str
    add: bool
    def __init__(self, tool: "ConstraintTool", layer: str, add: bool = ...) -> None: ...
    @property
    def tool(self) -> "ConstraintTool | None": ...

def startTransientConstraintUndo(tool: "ConstraintTool", layer: str, add: bool = ...) -> None: ...
def endTransientConstraintUndo(tool: "ConstraintTool", layer: str, add: bool = ...) -> None: ...

class ConstraintTool:
    scene_viewer: hou.SceneViewer
    show_mapping: bool
    # None once the tool is deactivated.
    mapping_gadget: MappingGadget | None
    mapping_collection: MappingCollection | None
    preview_mapping_gadget: MappingGadget | None
    preview_mapping_collection: MappingCollection | None
    # None while the tool is inactive.
    hud_widget: ConstraintParmWidget | None
    settings_widget: ConstraintSettingsWidget | None
    add_hk: str
    add_transient_hk: str
    remove_hk: str
    matching_constraints: list[str]
    slider_start_values: dict[str, _apex._Value | None]
    slider_start_channels: dict[str, hou.Geometry]
    blend_slider_channels_undo: SetChannelsUndo | None
    blend_bookmark_manager: ChannelBookmarkManager
    blend_anim_tracker: AnimTracker
    transient_manager: TransientConstraintManager
    anim_parms_dirty: bool
    preselected_constraint_paths: list[str] | None
    def __init__(self, viewer_state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    def constraint_manager(self) -> apex.ConstraintManager: ...
    def label(self) -> str: ...
    def hudTemplate(self) -> list[hou._HudRow]: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> bool: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    # The mouse event's kwargs, or the transform gadget's.
    def onPoseStartPreInitEvent(self, kwargs: ViewerStateEventKwargs | _HandleStartUpdateKwargs) -> Literal[True]: ...
    def onPoseEndEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> bool: ...
    def onPrePlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def enableConstraints(self, on: bool = ...) -> None: ...
    def showConstraints(self, on: bool = ...) -> None: ...
    def selectConstraints(self, on: bool = ...) -> None: ...
    def onHUDParmEvent(self, kwargs: _ParmEventDict) -> bool: ...
    def setConstraintLabel(self, constraint_path: str, label: str) -> None: ...
    def showConstraintControls(self, on: bool = ...) -> None: ...
    def showConstraintDrivenControls(self, on: bool = ...) -> None: ...
    def getConstraintDrivenControlsVisible(self, constraint_path: str) -> bool: ...
    def getConstraintControlsVisible(self, constraint_path: str) -> bool: ...
    def onPreSelectionChanged(self, kwargs: _PreSelectionChangedKwargs) -> None: ...
    def onSelectionChanged(self, selection: Sequence[str], **kwargs: object) -> None: ...
    # The state passes the channels' collection name as rig_path.
    def onChannelsChangeStartEvent(self, rig_path: str, channel_names: Sequence[str]) -> None: ...
    def onChannelsChangeEvent(self, rig_path: str, channel_names: Sequence[str]) -> None: ...
    def onChannelsChangeEndEvent(self, rig_path: str, channel_names: Sequence[str]) -> None: ...
    def onActiveLayerChanged(self, kwargs: _ActiveLayerChangedKwargs) -> None: ...
    def onPostEvaluationEvent(self, time: float) -> Literal[False]: ...
    # A None value keys the parm's current value.
    def updateAnimConstraintParm(
        self, parms: Mapping[str, _apex._ValueArg | None], add_undo: bool = ..., force_key: bool = ..., layer: str = ...
    ) -> None: ...
    def onAnimSliderStartEvent(self, name: str, layer: str = ...) -> None: ...
    def onAnimSliderEndEvent(self, name: str, value: _apex._ValueArg, layer: str = ...) -> None: ...
    def onAnimSliderKeyEvent(self, names: Iterable[str], layer: str = ...) -> None: ...
    def onAnimSliderDeleteKeyEvent(self, names: Iterable[str], layer: str = ...) -> None: ...
    def onAnimSliderClearEvent(self, names: Iterable[str], layer: str = ...) -> None: ...
    def updateStaticConstraintParm(self, name: str, value: _apex._ValueArg, add_undo: bool = ...) -> None: ...
    def onStaticSliderStartEvent(self, name: str) -> None: ...
    def onStaticSliderEndEvent(self, name: str, value: _apex._ValueArg) -> None: ...
    def updateConstraintParm(self, name: str, value: _apex._ValueArg, animatable: bool, add_undo: bool = ...) -> None: ...
    def onSliderStartEvent(self, name: str, animatable: bool) -> None: ...
    def onSliderEndEvent(self, name: str, value: _apex._ValueArg, animatable: bool) -> None: ...
    def updateShapeParm(self, control_name: str, name: str, value: _ShapeParmValue) -> None: ...
    def onShapeSliderStartEvent(self, name: str) -> None: ...
    def onShapeSliderEndEvent(self, control_name: str, name: str, value: _ShapeParmValue) -> None: ...
    def updateConstraintBlend(self, path: str, value: float) -> None: ...
    def onBlendSliderStartEvent(self, path: str) -> None: ...
    def onBlendSliderEndEvent(self, path: str, value: float) -> None: ...
    def onBlendSliderKeyEvent(self, path: str, value: float, force_key: bool = ..., add_undo: bool = ...) -> None: ...
    def onBlendSliderDeleteKeyEvent(self, path: str) -> None: ...
    def onBlendSliderClearEvent(self, path: str) -> None: ...
    def onBlendActionButtonEvent(self, constraint_path: str) -> None: ...
    def selectBlendingConstraints(self, on: bool) -> None: ...
    def onBlendBookmarkChanged(self, kwargs: _ChannelBookmarkChangedKwargs) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    # The bake parameters of the Animate state's settings HUD.
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def onPostBakeEvent(self, handled_by_tool: bool, kwargs: Mapping[str, _HUDParmValue]) -> None: ...
    def getScopedChannels(self) -> dict[str, list[str]]: ...
    def getPinnedChannels(self) -> dict[str, list[str]]: ...
    def scopeChannels(
        self, channel_list: hou.ChannelList, scoped_channels: Mapping[str, Sequence[str]], pinned_channels: Mapping[str, Iterable[str]]
    ) -> None: ...
    # The Animate state's `pushChannels` tool event, whose (always empty) dict is ignored.
    def pushChannels(self, kwargs: Mapping[str, object]) -> None: ...
    def addGeometryChannelCallbacks(self, custom_collection_names: Iterable[str]) -> None: ...
    def onChannelsActiveCallback(self, channel_names: tuple[str, ...], collection_name: str) -> None: ...
    def onChannelsChangedCallback(self, channel_names: tuple[str, ...], collection_name: str) -> None: ...
    # These replace the paths in the list in place.
    def getControlAliases(self, ctrl_paths: MutableSequence[str]) -> None: ...
    def getControlsFromAliases(self, ctrl_aliases: MutableSequence[str]) -> None: ...
    def getAllControlPaths(self) -> list[str]: ...
    def getSelectionSetConstraintPaths(self) -> list[str]: ...
    def getVisibleConstraintPaths(self) -> list[str]: ...
    def getSelectedControlPaths(self) -> list[str]: ...
    def getControlLabels(self, kwargs: _ControlLabelsKwargs) -> None: ...
    def selectionSetsPinControls(self, selection_set_paths: Iterable[str], pick_modifier: hou.EnumValue[hou.pickModifier]) -> None: ...
    def selectionSetsShowConstraints(self, selection_set_paths: Iterable[str], pick_modifier: hou.EnumValue[hou.pickModifier]) -> None: ...
    def selectionSetsRemoveConstraints(self, selection_set_paths: Iterable[str]) -> None: ...
    def selectionSetsSelectControls(
        self, selection_set_paths: Iterable[str], primary_control: str | None, pick_modifier: hou.EnumValue[hou.pickModifier]
    ) -> None: ...
    def onControlRelabeled(self, kwargs: _ControlRelabeledKwargs) -> None: ...
    def setAutoUpdate(self, on: bool) -> None: ...
    def showConstraintVisualizer(self, on: bool) -> None: ...
    def setBakeToNewLayer(self, on: bool) -> None: ...
    def setBakeMode(self, mode: BakeMode) -> None: ...
    def updateConstraints(self, parms_only: bool = ...) -> None: ...
    def updateConstraintContext(self, update_selection_sets: bool = ...) -> None: ...
    def updateConstraintLabels(self, update_selection_sets: bool = ..., update_bookmarks: bool = ...) -> None: ...
    def onCommand(self, name: str, kwargs: _ConstraintCommandArgs) -> None: ...
    def savePlaybackOutputGeometry(self, geo: hou.Geometry) -> None: ...

def load(viewer_state: _AnimateState) -> ConstraintTool: ...
def bindParametersToTemplate(template: hou.ViewerStateTemplate) -> None: ...
def getToolStateParms() -> list[str]: ...
def loadConstraintMapping(collection: MappingCollection, scene: apex.Scene) -> None: ...

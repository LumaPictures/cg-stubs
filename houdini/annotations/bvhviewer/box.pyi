from collections.abc import Sequence

from .colormanager import ColorManager

class Box:
    extents: list[float]
    def __init__(self, extents: list[float] | None = ...) -> None: ...
    def intersects(self, other: "Box") -> bool: ...
    def intersection(self, other: "Box") -> "Box | None": ...
    def volume(self) -> float: ...
    def draw(self, color_manager: ColorManager) -> None: ...
    @staticmethod
    def overlapListFactor(box_list: Sequence["Box"] | None) -> float: ...
    @staticmethod
    def overlapSingleFactor(target: "Box | None", box_list: Sequence["Box"] | None) -> float: ...

class NodeItem:
    def __init__(self, data: str | None, constraintNode: ConstraintFactoryObject | None) -> None: ...
    def data(self, column: int) -> str | None: ...
    def getGroup(self) -> str: ...
    def layers(self) -> list[str]: ...
    def layer(self) -> str: ...
    def setLayer(self, layer: str) -> None: ...
    def isLayerNode(self) -> bool: ...
    def setIsLayerNode(self, isLayerNode: bool) -> None: ...
    def tag(self) -> str: ...
    def setTag(self, tag: str) -> None: ...
    def enabled(self) -> bool: ...
    def setEnabled(self, enabled: bool) -> None: ...
    def constraintType(self) -> str | None: ...
    def setConstraintType(self, constraint_type: str | None) -> None: ...
    def rawData(self) -> list[str | None]: ...
    def columnCount(self) -> int: ...
    def childCount(self, skip_layers: bool = ...) -> int: ...
    def layerCount(self) -> int: ...
    def child(self, row: int) -> "NodeItem | None": ...
    def parent(self) -> "NodeItem | None": ...
    def row(self) -> int: ...
    def addChild(self, child: "NodeItem") -> None: ...
    def isTop(self) -> bool: ...
    def errors(self) -> list[str | None]: ...
    def warnings(self) -> list[str | None]: ...
    def has(self, header: str) -> bool: ...
    def getTop(self) -> "NodeItem": ...
    def childNodeByName(self, name: str) -> "NodeItem | None": ...

def sortByChildren(node: NodeItem) -> list[str | None]: ...
def sort_children_nodes(nodes: Iterable[NodeItem]) -> None: ...

class ConstraintBrowserModel(PySide6.QtCore.QAbstractItemModel):
    def __init__(self, nodes: Iterable[NodeItem], browser: ConstraintBrowser, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def topNode(self, index: PySide6.QtCore.QModelIndex) -> NodeItem | None: ...
    def nodeByHandleType(self, name: str) -> NodeItem | None: ...
    def rowCount(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> int: ...
    def addChild(self, node: NodeItem, parent_index: PySide6.QtCore.QModelIndex | None) -> None: ...
    def index(self, row: int, column: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex = ...) -> PySide6.QtCore.QModelIndex: ...
    def parent(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.QModelIndex: ...
    def columnCount(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> int: ...
    def headerData(self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int) -> str | None: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int | None = ...) -> str | PySide6.QtGui.QIcon | PySide6.QtCore.QSize | None: ...
    def setData(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, value: object, role: int) -> bool: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag: ...
    def getButtonInfos(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> list[tuple[int, hou.qt.Icon | None, Callable[[_ButtonKwargs], object] | None, str | None]]: ...

def createConstraintBrowserModel(items: Iterable[NodeItem], browser: ConstraintBrowser) -> ConstraintBrowserModel: ...
def createConstraintBrowserNodes(selectedNodes: Iterable[hou.Node]) -> collections.OrderedDict[str, list[NodeItem]]: ...

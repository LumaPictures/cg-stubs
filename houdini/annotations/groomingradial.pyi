import hou
from collections.abc import Callable, Mapping, MutableMapping
from typing import Literal, TypeAlias, TypedDict, Unpack, overload
from typing_extensions import NotRequired

from houtypes import RadialMenuKwargs

class _RadialMenuItem(TypedDict):
    type: Literal["script_action"]
    label: str
    icon: str | None
    # Called with RadialMenuKwargs; Callable[..., object] because a lambda capturing defaults
    # (`lambda name=name, **kwargs: ...`) isn't assignable to a `**kwargs: Unpack[...]` protocol.
    script: Callable[..., object]
    check: NotRequired[Callable[..., object]]

_RadialMenu: TypeAlias = MutableMapping[int | str, _RadialMenuItem]

HANDLE_NAME: str
GROOM_STATE: str

def runStateCommand(name: str, **kwargs: Unpack[RadialMenuKwargs]) -> None: ...
def updateStateInfoBox(pane: hou.SceneViewer, args: Mapping[str, object] | None = ...) -> None: ...
def updateStatePrompt(pane: hou.SceneViewer) -> None: ...
def toggleParm(name: str, **kwargs: Unpack[RadialMenuKwargs]) -> None: ...
def checkParm(name: str, **kwargs: Unpack[RadialMenuKwargs]) -> int | float | str: ...
def setParm(name: str, value: hou.ParmArgType, **kwargs: Unpack[RadialMenuKwargs]) -> None: ...
def pressButton(name: str, **kwargs: Unpack[RadialMenuKwargs]) -> None: ...
def compareParmValue(name: str, value: str, **kwargs: Unpack[RadialMenuKwargs]) -> bool: ...
def isParmHidden(parm: hou.Parm) -> Literal[True] | None: ...
def setTool(value: str, parms: Mapping[str, hou.ParmArgType] = ..., **kwargs: Unpack[RadialMenuKwargs]) -> None: ...
def addParmToggler(menu: _RadialMenu, slot: int | str, node: hou.OpNode, name: str, icon: str | None) -> None: ...
def addParmDependentScript(menu: _RadialMenu, slot: int | str, node: hou.OpNode, name: str, label: str, script: Callable[..., object], icon: str | None) -> None: ...
@overload
def slotNameToIndex(slot: int) -> int: ...
@overload
def slotNameToIndex(slot: str) -> int | str: ...
def addParmMenuChooser(menu: _RadialMenu, firstslot: int | str, node: hou.OpNode, name: str, icon: str | None) -> None: ...
def addParmButtonPresser(menu: _RadialMenu, slot: int | str, node: hou.OpNode, name: str, icon: str | None) -> None: ...
def makeToolOptionsMenu(**kwargs: Unpack[RadialMenuKwargs]) -> dict[int | str, _RadialMenuItem]: ...

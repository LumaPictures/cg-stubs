from collections.abc import Callable, Iterable

import PySide6.QtCore
import PySide6.QtGui

ICON_SIZE: int
SIZE_HINT: int
PKG_COL_INDEX: int
PKG_STATE_COL_INDEX: int
PKG_LOCKED_COL_INDEX: int
PKG_LOCKED_ID: int
PKG_AUTOLOAD_ID: int
PKG_MANUALLOAD_ID: int
COL_NUM: int
COL_TO_NAME: dict[int, str]
active_flag_holder: str | None
COL_TIP: dict[int, str | Callable[[], str]]
ITEMS_TO_HIDE: tuple[str, str, str, str]

def colToName(col_index: int) -> str: ...
def colTooltip(tip_index: int) -> str | Callable[[], str]: ...

class NodeItem:
    def __init__(self, data: str | None) -> None: ...
    def data(self, column: int) -> str | None: ...
    def rawData(self) -> list[str | None]: ...
    def name(self) -> str | None: ...
    def columnCount(self) -> int: ...
    def childCount(self) -> int: ...
    def child(self, row: int) -> "NodeItem | None": ...
    def parent(self) -> "NodeItem | None": ...
    def row(self) -> int: ...
    def addChild(self, child: "NodeItem") -> None: ...
    def isTop(self) -> bool: ...
    def isAutoLoadChecked(self) -> bool | int: ...
    def setAutoLoadChecked(self, value: bool | int) -> None: ...
    def isActiveChecked(self) -> bool | int: ...
    def setActiveChecked(self, value: bool | int) -> None: ...
    def isHidden(self) -> bool: ...
    def packageName(self) -> str | None: ...
    def packageFilepath(self) -> str | None: ...
    def packageAutoLoaded(self) -> bool: ...
    def packageManualLoaded(self) -> bool: ...
    def packageValues(self) -> list[str | None]: ...
    def packageVersion(self) -> str | None: ...
    def packageLoadOnlyOnce(self) -> bool: ...
    def packageAsAutoLoaded(self) -> bool: ...
    def packageLocked(self) -> bool: ...
    def packageActive(self) -> bool: ...
    def errors(self) -> list[str | None]: ...
    def warnings(self) -> list[str | None]: ...
    def has(self, header: str) -> bool: ...
    def getTop(self) -> "NodeItem": ...
    def getNodeData(self, header: str) -> str | None: ...
    def childNodeByName(self, name: str) -> "NodeItem | None": ...
    def childNodeByHeader(self, token: str) -> "NodeItem | None": ...

def sortByChildren(node: NodeItem) -> list[str | None]: ...
def sort_children_nodes(nodes: Iterable[NodeItem]) -> None: ...

class PackageModel(PySide6.QtCore.QAbstractItemModel):
    autoLoadUpdateSignal: PySide6.QtCore.Signal
    activateUpdateSignal: PySide6.QtCore.Signal
    ManualLoadedRole: int
    can_send_update: bool
    def __init__(self, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def updateItems(self, reload: bool = ...) -> None: ...
    def itemCache(self) -> "ItemCache": ...
    def topNode(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> NodeItem | None: ...
    def topNodes(self) -> list[NodeItem]: ...
    def findTopNode(self, func: Callable[[NodeItem], object]) -> NodeItem | None: ...
    def errorIcon(self) -> PySide6.QtGui.QIcon: ...
    def warningIcon(self) -> PySide6.QtGui.QIcon: ...
    def topNodeIcon(self) -> PySide6.QtGui.QIcon: ...
    def rowCount(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> int: ...
    def addChild(self, node: NodeItem, parent_index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None) -> None: ...
    def index(self, row: int, column: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex = ...) -> PySide6.QtCore.QModelIndex: ...
    def parent(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.QModelIndex: ...
    def columnCount(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> int: ...
    def headerData(self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int) -> str | None: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> str | bool | int | PySide6.QtGui.QIcon | PySide6.QtGui.QFont | PySide6.QtCore.QSize | PySide6.QtCore.Qt.CheckState | None: ...
    def setData(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, value: bool | int, role: int) -> bool: ...

class ItemCache:
    def __init__(self, model: PackageModel) -> None: ...
    def clear(self) -> None: ...
    def updateItemByRowCol(self, row: int, col: int) -> bool: ...
    def updateItem(self, item_index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...
    def setModelData(self) -> None: ...
    def log(self) -> None: ...

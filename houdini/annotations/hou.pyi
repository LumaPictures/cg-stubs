# Event callbacks are called with keyword arguments: those every event passes, and those of the
# event (houtypes.NodeEventKwargs, ...).  A callback type is a union of one Protocol per set of
# keywords an event passes, so a callback is accepted if it can take the keywords of some event
# (`def name_changed(node, event_type, old_name)`, `def hda_event(event_type, asset_definition,
# **kwargs)`); one for several kinds of events takes **kwargs.  Which events it is added for isn't
# checked.
class _NodeEvent(Protocol):
    def __call__(self, *, event_type: EnumValue[nodeEventType], node: OpNode) -> object: ...

class _NodeEventAppearance(Protocol):
    def __call__(self, *, event_type: EnumValue[nodeEventType], node: OpNode, change_type: EnumValue[appearanceChangeType]) -> object: ...

class _NodeEventInput(Protocol):

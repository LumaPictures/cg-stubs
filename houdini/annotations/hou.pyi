class _NodeEventChildItem(Protocol):
    def __call__(self, *, event_type: EnumValue[nodeEventType], node: OpNode, child_item: NetworkBox | StickyNote | IndirectInput) -> object: ...

class _NodeEventName(Protocol):
    def __call__(self, *, event_type: EnumValue[nodeEventType], node: OpNode, old_name: str) -> object: ...

class _NodeEventWorkItem(Protocol):
    def __call__(self, *, event_type: EnumValue[nodeEventType], node: OpNode, work_item_id: int, selected_node: TopNode) -> object: ...

_NodeEventCallback: TypeAlias = _NodeEvent | _NodeEventAppearance | _NodeEventInput | _NodeEventParmTuple | _NodeEventChild | _NodeEventChildItem | _NodeEventName | _NodeEventWorkItem


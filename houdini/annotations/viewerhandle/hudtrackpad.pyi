from collections.abc import KeysView, Mapping, Sequence
from typing import ClassVar, TypedDict, Unpack

import hou
from viewerhandle.hudapi import _HUDHandle, _HUDParmChangeKwargs, _HUDParmTemplateChangeKwargs, _HUDSettings
import resourceui as rui
import viewerhandle.hudwidgets as hudw
from PySide6 import QtCore, QtGui, QtWidgets
from viewerhandle import hudapi
from viewerhandle.hudwindow import HUDWindow

HANDLE_PARMS: list[str]
TRACKPAD_SCENE_SIZE: int
TRACKPAD_ITEM_SIZE: float
TRACKPAD_DEPTH: int
TRACKPAD_ITEM_COLOR: QtCore.Qt.GlobalColor

# The keywords of rui.LabelEdit's constructor that TrackpadLabel's doesn't set itself.
class _TrackpadLabelKwargs(TypedDict, total=False):
    parent: QtWidgets.QWidget | None
    text: str | None
    tooltip: str | None
    alignment: QtCore.Qt.AlignmentFlag
    width: int | None

class ParmInfo:
    enabled: bool
    index: int
    label: str | None
    parm: hou.Parm | None
    min_val: float
    max_val: float
    default_val: float
    min_locked: bool
    max_locked: bool
    parm_locked: bool

def fromParmInfo(parm_info: ParmInfo) -> hudw.RangeInfo: ...

class Trackpad(QtWidgets.QFrame):
    itemChanged: ClassVar[QtCore.Signal]
    mouseWheelChanged: ClassVar[QtCore.Signal]
    mousePressed: ClassVar[QtCore.Signal]
    mouseReleased: ClassVar[QtCore.Signal]
    DEFAULT_AXIS_MAPPING: dict[str, TrackpadAxis]
    def __init__(
        self,
        parm_info: Mapping[str, ParmInfo],
        parm_axes: Mapping[str, TrackpadAxis] = ...,
        trackpad_type: type[int] | type[float] = ...,
        parent: QtWidgets.QWidget | None = ...,
        width: int = ...,
        height: int = ...,
        item_size: float = ...,
    ) -> None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def wheelEvent(self, event: QtGui.QWheelEvent) -> None: ...
    def isLocked(self) -> bool: ...
    def showScrollTooltip(self, pos: QtCore.QPoint) -> None: ...
    def lockUI(self, value: bool) -> None: ...
    def visualSize(self) -> int: ...
    def setVisualSize(self, visual_size: int) -> None: ...
    def itemPos(self) -> QtCore.QPoint: ...
    def subPixelPos(self) -> tuple[float, float]: ...
    def setSubPixelPos(self, x: float, y: float) -> None: ...
    def factoryStyleSheet(self) -> str: ...
    def validHandleParms(self) -> KeysView[str]: ...
    def usesZAxis(self) -> bool: ...
    def setParmAxes(self, parm_axes: dict[str, TrackpadAxis]) -> None: ...
    def parmToAxis(self, parm_name: str) -> TrackpadAxis: ...
    def axisToParm(self, axis: TrackpadAxis) -> str: ...
    def sizeHint(self) -> QtCore.QSize: ...
    def updatePosFromValue(self, parm_name: str, parm_value: float) -> None: ...
    def setMinimum(self, parm_name: str, value: float) -> None: ...
    def minimum(self, parm_name: str) -> float: ...
    def setMaximum(self, parm_name: str, value: float) -> None: ...
    def maximum(self, parm_name: str) -> float: ...
    def minimumLocked(self, parm_name: str) -> bool: ...
    def setMinimumLocked(self, parm_name: str, value: bool) -> None: ...
    def maximumLocked(self, parm_name: str) -> bool: ...
    def setMaximumLocked(self, parm_name: str, value: bool) -> None: ...
    def mapToView(self, parm_name: str, value: float) -> float: ...
    def mapToParm(self, parm_name: str, pos: float) -> float: ...
    def type(self) -> type[int] | type[float]: ...

class TrackpadLabel(rui.LabelEdit):
    def __init__(self, **kwargs: Unpack[_TrackpadLabelKwargs]) -> None: ...
    def hasShadowEffect(self) -> bool: ...
    def setShadowEffectState(self, value: bool) -> None: ...

class HUDTrackPad(hudapi.HUDWidgetBase):
    def __init__(
        self, handle: _HUDHandle, target_parm: hou.Parm | None, hud_widget_key: str, window_key: str, **kwargs: Unpack[hudw._HUDWidgetOptions]
    ) -> None: ...
    def computeDistance(self, x: float, y: float) -> list[float]: ...
    def setPreviousMousePos(self, x: float, y: float) -> None: ...
    def setValueIndirect(self, mouse_pos: QtCore.QPoint, allowed_parms: Sequence[hou.Parm | None]) -> None: ...
    def indirectParms(self) -> list[hou.Parm | None]: ...
    def onMouseIndirectUpdate(
        self, level: int, mouse_pos: tuple[float, float], index: int, allowed_parms: Sequence[hou.Parm | None]
    ) -> bool: ...
    def onMouseIndirectStart(
        self, level: int, mouse_pos: tuple[float, float], allowed_parms: Sequence[hou.Parm | None]
    ) -> None: ...
    def onParmChangeEvent(self, kwargs: _HUDParmChangeKwargs) -> None: ...
    def onUpdateVisualSize(self) -> None: ...
    def onUpdateShadowEffectState(self, value: bool) -> None: ...
    def hasShadowEffect(self) -> bool: ...
    def onUpdateLabelVisibleState(self, value: bool) -> None: ...
    def onUpdateLabelColor(self, color: QtGui.QColor) -> None: ...
    def onLoadSettings(self, settings: _HUDSettings) -> None: ...
    def settingValues(self) -> _HUDSettings: ...
    def settingEditor(self) -> type[hudw.OrderedRangeSettingDialog]: ...
    def createSettingEditor(
        self, setting_editor: type[hudw.OrderedRangeSettingDialog], parent: HUDWindow
    ) -> hudw.OrderedRangeSettingDialog: ...
    def isLocked(self) -> bool: ...
    def onLockHandle(self, value: bool) -> None: ...
    def onUpdateHandleLock(self, parms_update: list[int] | None = ...) -> None: ...
    def onParmTemplateChangeEvent(self, kwargs: _HUDParmTemplateChangeKwargs) -> None: ...
    def onSceneItemChange(self, scene: Trackpad) -> None: ...
    def onMousePressEvent(self, event: Trackpad) -> None: ...
    def onMouseReleaseEvent(self, event: Trackpad) -> None: ...
    def onSceneWheelChange(self, wheel_event: QtGui.QWheelEvent) -> None: ...
    def eventFilter(self, source: QtCore.QObject, event: QtCore.QEvent) -> bool: ...
    def updateSliderValue(self, value: float) -> None: ...
    def onChangeSliderValue(self, value: float) -> None: ...
    def onUpdateTrackpadSliderVisible(self, value: bool) -> None: ...
    def minimumLocked(self) -> bool: ...
    def maximumLocked(self) -> bool: ...
    def orderingInfo(self) -> dict[str, int]: ...
    def handleOrderingInfoChange(self, ordering_info: Mapping[str, int]) -> None: ...
    def handleRangeInfoChange(self, parm_value: int) -> None: ...
    def rangeInfo(self, use_parm_range: int) -> dict[str, hudw.RangeInfo]: ...
    def useParmRange(self) -> int: ...
    def setLabelVisibleState(self, value: bool) -> None: ...

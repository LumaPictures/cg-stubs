import PySide6.QtCore
import PySide6.QtWidgets
from collections.abc import Callable
from typing import IO, Any

import hou
from typing_extensions import TypedDict


# A command for the browser, as resourceutils.DebugAidBase makes it (a flag naming the command,
# and its arguments), or the kwargs of the custom resource event that delivers one; the browser
# ignores any other key.
class _BrowserCommand(TypedDict, total=False, extra_items=object):  # type: ignore[call-arg]
    args: dict[str, str]
    clear_console: int
    add_marker: int
    console_logging: int
    trace_resource: int
    inspect_resource: int
    reload_resource: int
    edit_resource: int
    enable_trace_resource: int
    get_debug_states: int
    refresh_browser: int

class ViewerHandleBrowser(PySide6.QtWidgets.QFrame):
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def resourceType(self) -> hou.EnumValue[hou.resourceType]: ...
    def printMessage(self, msg: str | list[str], msg_type: hou.EnumValue[hou.severityType] = ..., immediate: bool = ...) -> None: ...
    def onActivate(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def onDestroy(self) -> None: ...
    def onContextMenu(self, pos: PySide6.QtCore.QPoint) -> None: ...
    def onExpandNode(self) -> None: ...
    def onReloadAllHandles(self) -> None: ...
    def onLoadHandleExamples(self) -> None: ...
    def onDeferPrintMessage(self, msg: str, msg_type: hou.EnumValue[hou.severityType], reset_want_timestamp: bool) -> None: ...
    def onLoadFileHandle(self) -> None: ...
    def onReloadHandle(self) -> None: ...
    def reloadHandleByTypeName(self, handle_type: str) -> None: ...
    def onUnloadHandle(self) -> None: ...
    def onDeleteHandle(self) -> None: ...
    def onEditEmbedded(self) -> None: ...
    def onEditFileHandle(self) -> None: ...
    def editFileHandleByTypeName(self, handle_type: str) -> None: ...
    def onEditSelectedHandle(self) -> None: ...
    def onNewHandle(self) -> None: ...
    def onOpenFile(self) -> None: ...
    def onSceneLoaded(self, event_type: hou.EnumValue[hou.hipFileEventType]) -> None: ...
    def onSelectionChanged(self, signal: PySide6.QtCore.QItemSelection) -> None: ...
    def onShowHelp(self) -> None: ...
    def onCategoryChange(self, index: int) -> None: ...
    def onAddMarker(self) -> None: ...
    def onClearMessages(self) -> None: ...
    def onDebugLogHandle(self) -> None: ...
    def onTraceHandle(self) -> None: ...
    def onInspectHandle(self) -> None: ...
    def inspectHandleByInstanceName(self, handle_instance_name: str) -> None: ...
    def onInspectHUDCache(self) -> None: ...
    def onResourceEvent(self, **kwargs: Any) -> None: ...
    def runCommand(self, kwargs: _BrowserCommand) -> dict[str, bool]: ...
    def onEventHandlerTraceOptions(self) -> None: ...

def onApplyAction(**kwargs: str) -> None: ...

class TempFileAuto:
    prefix: str
    suffix: str
    file: IO[str] | None
    def __init__(self, prefix: str = ..., suffix: str = ...) -> None: ...
    def __del__(self) -> None: ...
    def clear(self) -> None: ...

def iterate_model(
    index: PySide6.QtCore.QModelIndex,
    model_obj: PySide6.QtCore.QAbstractItemModel,
    depth: int,
    func: Callable[[PySide6.QtCore.QModelIndex, int], object],
) -> None: ...
def dump_model(view: PySide6.QtWidgets.QAbstractItemView) -> None: ...

    def toScreen(self, pos: hou.Vector3) -> hou.Vector2: ...
    def transform(self) -> hou.Matrix4: ...
    def updateTransform(self, s: hou.Vector3 | Sequence[float] | None = ..., r: hou.Vector3 | Sequence[float] | None = ..., t: hou.Vector3 | Sequence[float] | None = ...) -> hou.Matrix4: ...
    def newTransform(self, s: hou.Vector3 | Sequence[float] | None = ..., r: hou.Vector3 | Sequence[float] | None = ..., t: hou.Vector3 | Sequence[float] | None = ...) -> hou.Matrix4: ...

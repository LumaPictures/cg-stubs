# The keywords rui.ToolBar's constructor takes, which HUDWindow.ToolBar's passes on.
class _ToolBarKwargs(rui._LabelWrapperKwargs, total=False):
    width: int | None
    button_size: PySide6.QtCore.QSize | None
    spacing: int | None
    margin: PySide6.QtCore.QMargins | None
    transparent: bool
    stretch_end: bool

class _ParmEventKwargs(TypedDict):
    node: hou.OpNode
    parm_tuple: NotRequired[hou.ParmTuple | None]

class _SettingEventOptions(TypedDict, total=False):
    value: int | str | None


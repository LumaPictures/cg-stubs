import PySide6.QtGui
import PySide6.QtWidgets
from typing import Any


import hou
from viewerhandle.hudapi import _HUDHandle, _HUDParmChangeKwargs, _HUDParmTemplateChangeKwargs, _HUDSettings
import resourceui as rui
from viewerhandle import hudapi

class Label(rui.LabelEdit):
    def __init__(self, text: str, tooltip: str | None = ..., parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def shadow(self) -> PySide6.QtWidgets.QGraphicsDropShadowEffect: ...
    def factoryStyleSheet(self) -> str: ...

class HUDButton(hudapi.HUDWidgetBase):
    def __init__(
        self, handle: _HUDHandle, target_parm: hou.Parm | None, hud_widget_key: str, window_key: str, **kwargs: Any
    ) -> None: ...
    def factoryStyleSheet(self) -> str: ...
    def onParmChangeEvent(self, kwargs: _HUDParmChangeKwargs) -> None: ...
    def onUpdateShadowEffectState(self, value: bool) -> None: ...
    def hasShadowEffect(self) -> bool: ...
    def onUpdateLabelVisibleState(self, value: bool) -> None: ...
    def onUpdateLabelColor(self, color: PySide6.QtGui.QColor) -> None: ...
    def onUpdateVisualSize(self) -> None: ...
    def settingValues(self) -> _HUDSettings: ...
    def canLockHandle(self) -> bool: ...
    def isLocked(self) -> bool: ...
    def onParmTemplateChangeEvent(self, kwargs: _HUDParmTemplateChangeKwargs) -> None: ...
    def onButtonClicked(self, button_id: int) -> None: ...
    def onDeferSetRadioStripButton(self, default_button_id: int) -> None: ...

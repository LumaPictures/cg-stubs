from typing import Never

class FileReader:
    # str when opened with binary=False (the default), bytes otherwise.
    def read(self, size: int = ...) -> str | bytes: ...
    # None at the end of the file.
    def readline(self) -> str | bytes | None: ...
    def seek(self, offset: int, whence: int = ...) -> None: ...
    # The binding only has seekable(self); this stub overload cannot be called.
    def seekable(self, randomaccess: Never) -> bool: ...
    def tell(self) -> int: ...
    def __iter__(self) -> FileReader: ...
    def __next__(self) -> str | bytes: ...

class FileWriter:
    def seek(self, offset: int, whence: int = ...) -> None: ...
    def seekable(self, randomaccess: Never) -> bool: ...
    def tell(self) -> int: ...
    # str for a text writer, bytes for a binary one; returns the file position after writing.
    def write(self, data: str | bytes) -> int: ...

class Path:
    # A FileReader for "r" modes, a FileWriter for "w" modes.
    def open(self, mode: str) -> FileReader | FileWriter: ...

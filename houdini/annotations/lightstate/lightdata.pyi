from collections.abc import Sequence
from typing import Literal, TypeAlias

import hou

_Vec3Arg: TypeAlias = hou.Vector3 | Sequence[float]
_TransformOrder: TypeAlias = Literal['srt', 'str', 'rst', 'rts', 'tsr', 'trs']

class LightStateData:
    DISTANCE_THRESHOLD: float
    _node: hou.LopNode
    def __init__(self, node: hou.LopNode) -> None: ...
    def isEditing(self) -> bool: ...
    def primstr(self) -> str: ...
    def lighttype(self) -> str: ...
    def t(self, t: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def r(self, r: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def s(self, s: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def scale(self) -> float: ...
    def p(self, p: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def keepposition(self) -> int: ...
    def lookatenable(self, lookatenable: int | None = ...) -> int: ...
    def lookatprim(self) -> str: ...
    def lookatpos(self, lookatpos: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def lookatprimrot(self, lookatprimrot: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def lookatprimpos(self, lookatprimpos: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def twist(self, twist: float | None = ...) -> float: ...
    def intensity(self, intensity: float | None = ...) -> float: ...
    def exposure(self, exposure: float | None = ...) -> float: ...
    def interested(self, interested: int | None = ...) -> int: ...
    def interestpos(self, interestpos: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def interestnormal(self, interestnormal: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def distance(self, dist: float | None = ...) -> float: ...
    def barndoor(self, name: str, deltaLen: float | None = ...) -> float: ...
    def shadowtarget(self, shadow_target: int | None = ...) -> int: ...
    def shadowpivot(self, shadow_pivot: int | None = ...) -> int: ...
    def shadowtargetpos(self, shadow_target_pos: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def shadowpivotpos(self, shadow_pivot_pos: _Vec3Arg | None = ...) -> hou.Vector3: ...
    def spotlightenable(self, enable: int | None = ...) -> int: ...
    def coneangle(self, angle: float | None = ...) -> float: ...
    def spotlightdist(self, dist: float | None = ...) -> float: ...
    def length(self, length: float | None = ...) -> float: ...
    def width(self, width: float | None = ...) -> float: ...
    def height(self, height: float | None = ...) -> float: ...
    def radius(self, radius: float | None = ...) -> float: ...
    def oporder(self) -> str: ...
    def xord(self) -> _TransformOrder: ...
    def computeLookAtPoint(self) -> hou.Vector3: ...
    def distanceFromLightPos(self, lightPos: hou.Vector3, shadow: bool = ...) -> float | None: ...
    def getLightXform(self, pre: bool = ..., local: bool = ...) -> hou.Matrix4: ...
    def setLightXform(self, worldPos: hou.Vector3, worldDir: hou.Vector3 | None = ...) -> None: ...
    def setLightXformFromTarget(self, target_xform: hou.Matrix4, set_rotate: bool = ...) -> None: ...
    def setXform(self, xform: hou.Matrix4, set_rotate: bool = ...) -> None: ...

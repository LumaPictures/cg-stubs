from collections.abc import Iterable, MutableSequence, Sequence

import hou
from canvaseventtypes import KeyboardEvent, MouseEvent

class SnapResult:
    snapdelta: hou.Vector2
    snapvertical: hou.Vector2 | None
    snaphorizontal: hou.Vector2 | None
    snapverticalsrc: hou.Vector2
    snaphorizontalsrc: hou.Vector2
    def __init__(self) -> None: ...
    def isValid(self) -> bool: ...
    def delta(self) -> hou.Vector2: ...
    def shapes(self, editor: hou.NetworkEditor) -> list[hou.NetworkShapeConnection]: ...
    def setVerticalSnap(self, srcpos: hou.Vector2, snappos: hou.Vector2, snapdistance: float) -> None: ...
    def setHorizontalSnap(self, srcpos: hou.Vector2, snappos: hou.Vector2, snapdistance: float) -> None: ...

def testGridSnaps(pos: hou.Vector2, steps: hou.Vector2, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def testGridHEdgeSnaps(rect: hou.BoundingRect, steps: hou.Vector2, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def testGridEdgeSnaps(rect: hou.BoundingRect, steps: hou.Vector2, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def testSnaps(pos: hou.Vector2, snappos: hou.Vector2, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def testHEdgeSnaps(rect: hou.BoundingRect, snaprect: hou.BoundingRect, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def testEdgeSnaps(rect: hou.BoundingRect, snaprect: hou.BoundingRect, currentsnaps: MutableSequence[float], radius: float, result: SnapResult) -> None: ...
def isCenterSnapper(item: hou.NetworkMovableItem | None) -> bool: ...
def snap(
    editor: hou.NetworkEditor,
    item: hou.NetworkMovableItem | None,
    rect: hou.BoundingRect,
    snaprects: Iterable[tuple[hou.NetworkMovableItem, hou.BoundingRect]],
) -> SnapResult: ...
def snapGrid(
    editor: hou.NetworkEditor,
    item: hou.NetworkMovableItem | None,
    rect: hou.BoundingRect,
    currentsnaps: MutableSequence[float],
    result: SnapResult,
) -> None: ...
def snapNodes(
    editor: hou.NetworkEditor,
    item: hou.NetworkMovableItem | None,
    rect: hou.BoundingRect,
    snaprects: Iterable[tuple[hou.NetworkMovableItem, hou.BoundingRect]],
    currentsnaps: MutableSequence[float],
    result: SnapResult,
) -> None: ...
def snapResizeRect(
    uievent: MouseEvent | KeyboardEvent,
    item: hou.NetworkMovableItem | None,
    initialrect: hou.BoundingRect,
    direction: Sequence[int],
    titleheight: float,
    startpos: hou.Vector2,
    alignrects: Iterable[tuple[hou.NetworkMovableItem, hou.BoundingRect]] | None = ...,
    preserve_aspect_ratio: bool = ...,
) -> tuple[hou.BoundingRect, SnapResult]: ...

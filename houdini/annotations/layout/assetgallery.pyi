from collections.abc import Sequence
from typing import TypedDict

import hou
from PySide6 import QtWidgets

# The kwargs a Python Panel interface script gets.
class _PythonPanelKwargs(TypedDict):
    paneTab: hou.PaneTab

theSourceMenuXmlFilename: str

class Window(QtWidgets.QWidget):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def onActivate(self, kwargs: _PythonPanelKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def onDestroy(self) -> None: ...
    def handleDialogButton(self, button: QtWidgets.QAbstractButton) -> None: ...
    def handleUISelectionCallback(self, selection: Sequence[hou.NetworkMovableItem]) -> None: ...
    def handleSelectionChanged(self, selected: Sequence[str], deselected: Sequence[str]) -> None: ...

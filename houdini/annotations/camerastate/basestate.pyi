class _HUDRow(TypedDict, total=False):
    id: str
    type: str
    visible: bool
    label: str
    value: str | float | int
    key: str
    wide: bool
    count: int
    rows: list["_HUDRow"]
    current: int | str | None

class _HUDTemplate(TypedDict, total=False):
    title: str
    icon: str
    desc: str
    rows: list["_HUDRow"]

PHYSICAL_LENS_NO_DISTORTION: dict[str, str | int]
RENDER_STYLE_DISABLED: int

import re
from collections.abc import Sequence
from datetime import datetime

alnum_expr: re.Pattern[str]
NEGATIVE_CHAR: str
LIGHT_WEIGHT: int
NORMAL_WEIGHT: int
BOLD_WEIGHT: int
ABBR_WEIGHT: int
WHOLE_WEIGHT: int
FRACTION_WEIGHT: int

class FormattedValue:
    def __str__(self) -> str: ...
    def plainText(self) -> str: ...
    def html(self) -> str: ...

class FormattedNumber(FormattedValue):
    whole_weight: int | str
    fraction_weight: int | str
    @property
    def is_negative(self) -> bool: ...
    def plainText(self) -> str: ...
    def html(self) -> str: ...
    def main(self) -> str: ...

class FormattedDuration(FormattedNumber):
    whole_weight: int | str
    fraction_weight: int | str
    def __str__(self) -> str: ...
    def plainText(self) -> str: ...
    def html(self) -> str: ...


class NumberFormatter:
    def __init__(
        self,
        digits: int = ...,
        decimal_places: int = ...,
        min_diff: float = ...,
        auto_decimal: int = ...,
        brief_mode: BriefMode = ...,
        tiers: Sequence[tuple[int, str]] = ...,
        round_to_fit: bool = ...,
    ) -> None: ...
    def availableDigits(self) -> int: ...
    def setAvailableDigits(self, digits: int) -> None: ...
    def decimalPlaces(self) -> int: ...
    def setDecimalPlaces(self, places: int) -> None: ...
    def autoDecimalPlaces(self) -> int: ...
    def setAutoDecimalPlaces(self, places: int) -> None: ...
    def roundToFit(self) -> bool: ...
    def setRoundToFit(self, round_to_fit: bool) -> None: ...
    def briefMode(self) -> BriefMode: ...
    def setBriefMode(self, brief: BriefMode) -> None: ...
    def tiers(self) -> Sequence[tuple[int, str]]: ...
    def setTiers(self, tiers: Sequence[tuple[int, str]]) -> None: ...
    def wholeWeight(self) -> int | str: ...
    def setWholeWeight(self, weight: int | str) -> None: ...
    def fractionWeight(self) -> int | str: ...
    def setFractionWeight(self, weight: int | str) -> None: ...
    def formatInt(self, value: int, is_brief: bool = ...) -> FormattedNumber: ...
    def formatFloat(self, value: float, avail_digits: int, places: int, is_brief: bool = ...) -> FormattedNumber: ...
    def formatScientific(self, value: float | str, places: int = ...) -> FormattedNumber: ...
    def formatNumber(
        self, value: float, avail_digits: int | None = ..., places: int | None = ..., is_brief: bool = ...
    ) -> FormattedNumber: ...
    def format(self, value: str | float) -> FormattedNumber: ...
    def toPlainText(self, value: str | float) -> str: ...
    def toString(self, value: str | float, markup: bool = ...) -> str: ...
    def __call__(self, value: str | float, markup: bool = ...) -> str: ...

class PercentFormatter(NumberFormatter):
    def __init__(self, digits: int = ..., decimal_places: int = ...) -> None: ...
    def formatNumber(
        self, value: float, avail_digits: int | None = ..., places: int | None = ..., is_brief: bool = ...
    ) -> FormattedNumber: ...

class DurationFormatter(NumberFormatter):
    def __init__(
        self, decimal_places: int = ..., auto_decimal: int = ..., long: bool = ..., hms: bool = ...
    ) -> None: ...
    def usingHmsStyle(self) -> bool: ...
    def setUseHmsStyle(self, hms: bool) -> None: ...
    def usingLongFormat(self) -> bool: ...
    def setUseLongFormat(self, long: bool) -> None: ...
    def formatNumber(
        self, value: float, avail_digits: int | None = ..., places: int | None = ..., is_brief: bool = ...
    ) -> FormattedDuration: ...

def formatted_number(
    value: float,
    brief: bool = ...,
    digits: int = ...,
    decimal_places: int = ...,
    tiers: Sequence[tuple[int, str]] = ...,
) -> FormattedNumber: ...
def format_number(value: float, brief: bool = ..., markup: bool = ...) -> str: ...
def format_hms(
    secs: float,
    markup: bool = ...,
    decimal_places: int = ...,
    auto_decimal: int = ...,
    less_than_1_ms: bool = ...,
    whole_weight: int | str = ...,
    fraction_weight: int | str = ...,
) -> str: ...
def format_duration(
    secs: float,
    markup: bool = ...,
    decimal_places: int = ...,
    long: bool = ...,
    auto_decimal: int = ...,
    whole_weight: int | str = ...,
    fraction_weight: int | str = ...,
    zero: str = ...,
) -> str: ...
def split_vector(string: str) -> list[float]: ...
def whole_digit_count(n: float) -> int: ...
def markup_sci(string: str) -> str: ...
def span(string: str, weight: int | str = ...) -> str: ...
def abbr(string: str, size: str = ..., weight: int | str = ...) -> str: ...
def markup_float(
    string: float | str, show_fraction: bool = ..., whole_weight: int | str = ..., fraction_weight: int | str = ...
) -> str: ...
def markup_path(text: str, filename_weight: int | str = ...) -> str: ...
def format_percent(pct: float, markup: bool = ...) -> str: ...
def format_dimensions(*dims: float, markup: bool = ...) -> str: ...
def divide_seconds(secs: float) -> tuple[int, int, float]: ...
def format_date(dt: datetime, relative_to: datetime | None = ..., markup: bool = ...) -> str: ...
def format_time(
    dt: datetime, relative_to: datetime | None = ..., markup: bool = ..., include_ms: bool = ...
) -> str: ...
def format_date_and_time(dt: datetime, relative_to: datetime | None = ..., markup: bool = ...) -> tuple[str, str]: ...
def format_datetime(dt: datetime, relative_to: datetime | None = ..., markup: bool = ..., sep: str = ...) -> str: ...
def format_relative_datetime(dt: datetime, now: datetime, max_relative_seconds: int = ...) -> tuple[str, str]: ...
def format_brief(number: float, markup: bool = ..., decimal_places: int = ...) -> str: ...
def format_memory(bytecount: float, markup: bool = ..., decimal_places: int = ...) -> str: ...
def format_bytes(bytecount: float, markup: bool = ..., decimal_places: int = ...) -> str: ...

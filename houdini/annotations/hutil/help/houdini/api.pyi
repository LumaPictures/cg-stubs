from typing import Self
from urllib.parse import ParseResult
from collections.abc import Mapping

import hou

from hutil.help import zones
from hutil.help.paths import WikiPath
from hutil.help.search.searching import Document, Searcher

APP_VERSION: tuple[int, int]
table_to_dir: dict[str, str]
dir_to_table: set[tuple[str, str]]
dir_to_category: dict[str, hou.NodeTypeCategory]

class NodePathComponents:
    table: str
    namespace: str | None
    name: str
    version: str | None
    section: str | None
    scopeop: str | None
    ext: str | None
    @classmethod
    def fromPath(cls, path: str | WikiPath) -> Self | None: ...
    @classmethod
    def fromFilename(cls, table: str | hou.NodeTypeCategory, filename: str, section: str | None = ...) -> Self: ...
    @classmethod
    def fromType(cls, nodetype: hou.NodeType) -> Self: ...
    @classmethod
    def fromTypeName(cls, nodetype_name: str, table: str | None = ...) -> Self: ...
    @property
    def dirName(self) -> str: ...
    @property
    def category(self) -> hou.NodeTypeCategory: ...
    def nodeType(self) -> hou.NodeType | None: ...
    def filename(self, no_version: bool = ...) -> str: ...
    def typeName(self) -> str: ...
    def toPath(
        self,
        no_version: bool = ...,
        snap_version: bool = ...,
        maybe_manager: bool = ...,
        zone: zones.Zone | None = ...,
    ) -> WikiPath: ...

def pathToNodeType(path: str | WikiPath) -> hou.NodeType | None: ...
def nodeTypeToPath(
    nodetype: hou.NodeType, snap_version: bool = ..., maybe_manager: bool = ..., zone: zones.Zone | None = ...
) -> WikiPath: ...
def getZone() -> zones.Zone: ...
def operatorUrlToComponents(
    value: str | ParseResult, qs: Mapping[str, str] | None = ...
) -> NodePathComponents | None: ...
def urlToPath(url: str) -> WikiPath | None: ...
def shelfToolHelpPath(tool: hou.Tool) -> WikiPath | None: ...
def shelfToolDoc(
    tool: hou.Tool, zone: zones.Zone | None = ..., searcher: Searcher | None = ...
) -> Document | None: ...
def shelfToolTableAndTypeName(tool: hou.Tool) -> tuple[str, str] | None: ...

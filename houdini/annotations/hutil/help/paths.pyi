from typing import overload

class WikiPath:
    def __init__(self, *pathsegments: str | WikiPath) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: str | WikiPath) -> bool: ...  # type: ignore[override]
    def equals(self, other: str | WikiPath, compare_fragment: bool = ...) -> bool: ...
    @overload
    def __getitem__(self, item: int) -> str: ...
    @overload
    def __getitem__(self, item: slice) -> list[str]: ...
    @property
    def part_names(self) -> list[str]: ...
    @property
    def name(self) -> str: ...
    @property
    def suffixes(self) -> list[str]: ...
    def path_to(self, other: str | WikiPath) -> WikiPath: ...
    def path_from(self, other: str | WikiPath) -> WikiPath: ...
    def is_relative_to(self, other: str | WikiPath) -> bool: ...

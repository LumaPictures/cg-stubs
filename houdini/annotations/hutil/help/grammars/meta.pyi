from types import ModuleType
from typing import Literal, TypeAlias

from hutil.help.parsing import rules
from hutil.help.parsing.rules import empty, miss

_Miss: TypeAlias = "type[miss]"
# What the grammar's rules bind (`ctx['n'] = out`) for its actions to use.
_Binding: TypeAlias = (
    str
    | int
    | rules.Rule
    | tuple[int, int | None]
    | tuple[()]
    | list[str]
    | list[rules.Rule | None]
    | list[tuple[str, str]]
    | list[tuple[str, rules.Rule]]
    | type[miss]
    | None
)
_Ctx: TypeAlias = dict[str, _Binding]


def hspace(src: str, i: int, ctx: _Ctx) -> tuple[str | type[miss], int]: ...
def hspaces(src: str, i: int, ctx: _Ctx) -> tuple[list[str] | type[miss], int]: ...
def vspace(src: str, i: int, ctx: _Ctx) -> tuple[str | type[miss], int]: ...

import argparse
import pathlib
import sqlite3
from collections.abc import Collection, Iterable, Iterator, Sequence
from datetime import datetime
from types import TracebackType
from typing import Literal, Self

from hutil.help.paths import WikiPath
from hutil.help.zones import Zone

class Document:
    path: str
    title: str | None
    content: str
    summary: str | None
    bestbet: str | None
    modified: datetime
    type: str | None
    icon: str | None
    sortkey: str | None
    category: str | None
    grouping: str | None
    tags: set[str]
    rels: dict[str, str] | dict[str, str | Sequence[str]] | dict[str, str | Sequence[str] | None]
    highlight: str | None
    def __init__(self, path: str, title: str | None = ..., content: str | None = ..., *, summary: str | None = ..., bestbet: str | None = ..., modified: float | datetime | None = ..., type: str | None = ..., icon: str | None = ..., sortkey: str | None = ..., category: str | None = ..., grouping: str | None = ..., tags: Collection[str] = ..., rels: dict[str, str] | dict[str, str | Sequence[str]] | dict[str, str | Sequence[str] | None] | None = ..., highlight: str | None = ...) -> None: ...
    def __repr__(self) -> str: ...
    def row_dict(self) -> dict[str, str | float | None]: ...

class Db:
    tag_table: str
    prop_table: str
    key_field: str
    content_field: str
    fts_fields: dict[str, str]
    trigram_fields: dict[str, str]
    lang: str
    def __init__(self, conn: sqlite3.Connection, lang: str = ...) -> None: ...
    @classmethod
    def in_memory(cls, lang: str = ...) -> Db: ...
    @classmethod
    def open_file(cls, filepath: str | pathlib.Path, create: bool = ..., clear: bool = ..., lang: str = ...) -> Db: ...
    def drop_tables(self) -> None: ...
    def create_tables(self) -> None: ...
    def optimize(self) -> None: ...
    def doc_count(self, cursor: sqlite3.Cursor | None = ...) -> int: ...
    def doc_id_for(self, fieldname: str, value: str, cursor: sqlite3.Cursor | None = ...) -> int | None: ...
    def doc_id_for_path(self, path: str, cursor: sqlite3.Cursor | None = ...) -> int: ...
    def field_values(self, path: str) -> dict[str, str | float | None] | None: ...
    def path_exists(self, path: str, cursor: sqlite3.Cursor | None = ...) -> bool: ...
    def all_paths(self, cursor: sqlite3.Cursor | None = ...) -> Iterator[str]: ...
    def to_doc_id(self, doc_id: str | int, cursor: sqlite3.Cursor | None = ...) -> int: ...
    def all_tags(self, cursor: sqlite3.Cursor | None = ...) -> set[str]: ...
    def tag_exists(self, tag: str, cursor: sqlite3.Cursor | None = ...) -> bool: ...
    def clear(self) -> None: ...
    def close(self) -> None: ...

class Writer:
    db: Db
    insert_statement: str
    def __init__(self, db: Db) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...
    def add_tags(self, doc_id: str | int, tags: Iterable[str]) -> None: ...
    def add_properties(self, doc_id: str | int, items: Iterable[tuple[str, str]]) -> None: ...
    def remove_tags_from_path(self, doc_id: str | int, tags: Collection[str] | None = ...) -> None: ...
    def delete_tag(self, tag: str) -> None: ...
    def delete_paths(self, paths: Sequence[str], *, fragments: bool = ..., docs: bool = ..., tags: bool = ..., props: bool = ...) -> None: ...
    def delete_path(self, path: str, *, fragments: bool = ..., docs: bool = ..., tags: bool = ..., props: bool = ...) -> None: ...
    def index_document(self, doc: Document, *, with_deletion: bool = ...) -> int: ...
    def commit(self, optimize: bool = ..., vacuum: bool = ...) -> None: ...
    def cancel(self) -> None: ...
    def close(self) -> None: ...

def rebuild_search_index(zone: Zone, clean: bool = ..., start: str | WikiPath = ...) -> None: ...
def try_searching() -> None: ...

parser: argparse.ArgumentParser

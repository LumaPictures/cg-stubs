from collections.abc import Iterator, Sequence
from types import TracebackType
from typing import Literal, Self, TypeAlias, TypeVar, overload

from hutil.help.paths import WikiPath
from hutil.help.search.indexing import Db, Document

T = TypeVar("T")

_SqlArgs: TypeAlias = dict[str, str | int | float]

class Searcher:
    db: Db
    def __init__(self, db: Db, caching: bool = ...) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...
    def refresh(self) -> None: ...
    def paths_matching(self, fieldname: str, value: str | int | float, comparison: str = ..., order_by: str = ..., limit: int = ...) -> Iterator[str]: ...
    def path_matching(self, fieldname: str, value: str | int | float) -> str | None: ...
    def document_dict(self, path: str | WikiPath) -> dict[str, str | float | None] | None: ...
    def find_relationships(self, path: str | None = ..., rel: str | None = ..., value: str | None = ..., limit: int | None = ...) -> list[tuple[int, str, str]]: ...
    def follow_forward(self, path: str, rel: str, seen: set[str] | None = ...) -> list[str]: ...
    def follow_backward(self, path: str, rel: str, seen: set[str] | None = ...) -> list[str]: ...
    def search(self, text: str, *, highlight: bool = ..., order_by: str | None = ..., limit: int = ..., trigrams: bool = ...) -> Hits: ...
    def close(self) -> None: ...

class Hits:
    docs: Sequence[Document]
    error: str | None
    def __init__(self, docs: Sequence[Document], error: str | None = ...) -> None: ...
    def __bool__(self) -> bool: ...
    @overload
    def __getitem__(self, item: int) -> Document: ...
    @overload
    def __getitem__(self, item: slice) -> Sequence[Document]: ...

class Fts5Predicate(Predicate):
    def __str__(self) -> str: ...

class Fts5Word(SimpleFts5Predicate):
    word: str
    def __init__(self, word: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class Fts5Phrase(Fts5Predicate):
    words: tuple[SimpleFts5Predicate, ...]
    def __init__(self, words: Sequence[SimpleFts5Predicate]) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class Fts5Fielded(Fts5Predicate):
    field: str
    q: SimpleFts5Predicate | Fts5Phrase | Fts5Near
    def __init__(self, field: str, q: SimpleFts5Predicate | Fts5Phrase | Fts5Near) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class Fts5Binary(Fts5Predicate):
    template: str
    left: Fts5Predicate
    right: Fts5Predicate
    # More values for template.format().
    extras: dict[str, object]
    def __init__(self, left: Fts5Predicate, right: Fts5Predicate) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class Fts5Near(Fts5Binary):
    def __init__(self, left: Fts5Phrase | Fts5Word, right: Fts5Phrase | Fts5Word, max_dist: int = ...) -> None: ...

class Fts5Not(Fts5Binary):
    def __eq__(self, other: object) -> bool: ...

class SqlPredicate(Predicate):
    necessity: Need
    comparison: str
    def __init__(self, necessity: Need = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class FieldPredicate(SqlPredicate):
    field: str
    comparison: str
    value: str | int | float
    def __init__(self, field: str, value: str | int | float, op: str = ..., necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class FieldPrefixPredicate(FieldPredicate):
    def __init__(self, field: str, value: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class TagPredicate(SqlPredicate):
    tag: str
    def __init__(self, tag: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class PropertyPredicate(SqlPredicate):
    rel: str
    value: str
    def __init__(self, rel: str, value: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class Query:
    db: Db
    fts5: Fts5Predicate | None
    predicates: Sequence[SqlPredicate]
    snippets: bool
    snippet_column: int
    snippet_window: int
    snippet_start: str
    snippet_end: str
    snippet_joiner: str
    def __init__(self, db: Db, fts5: Fts5Predicate | None = ..., predicates: Sequence[SqlPredicate] = ..., snippets: bool = ...) -> None: ...
    def with_snippets(self, snippets: bool = ..., *, column: int | None = ..., window: int | None = ..., start: str | None = ..., end: str | None = ..., joiner: str | None = ...) -> Query: ...
    def find_predicates(self, cls: type[T], necessity: Need | None = ...) -> list[T]: ...
    def tag_predicates(self, necesssity: Need | None = ...) -> list[TagPredicate]: ...
    def property_predicates(self, necesssity: Need | None = ...) -> list[PropertyPredicate]: ...
    def field_predicates(self, necesssity: Need | None = ...) -> list[FieldPredicate]: ...
    def sql(self) -> tuple[str, _SqlArgs]: ...

from collections import defaultdict

from . import rules

fixed_imports: list[str]
prelude: str

class Frame:
    name: str
    output: list[str]
    counters: defaultdict[str, int]
    indent: int
    def __init__(self, name: str, indent: int = ...) -> None: ...
    def __repr__(self) -> str: ...
    def inc(self, name: str) -> int: ...

class Indentation:
    builder: Builder
    amount: int
    def __init__(self, builder: Builder, amount: int) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(self, *args: object) -> None: ...

class Builder:
    fixed_imports: list[str]
    namespace: rules.NsDict
    main_rule: rules.Rule
    assigns: list[str]
    made: set[str]
    def __init__(self, imports: dict[str, str], namespace: rules.NsDict, main_rule: rules.Rule) -> None: ...
    def indented(self, amount: int) -> Indentation: ...
    @property
    def indentation(self) -> int: ...
    def add_indent(self, n: int) -> None: ...
    def sub_indent(self, n: int) -> None: ...
    def generate_id(self, prefix: str, top_level: bool = ...) -> str: ...
    def add_regex(self, pattern: str) -> str: ...
    def add_constant(self, prefix: str, value: str | int | float) -> str: ...
    def assign(self, name: str, value: str | int | float) -> None: ...
    def make_function(self, rule: rules.Rule) -> str: ...
    def line(self, line: str, indent: int = ...) -> None: ...
    def call(self, rule: rules.Rule, indent: int = ..., i_var: str = ..., context_name: str = ...) -> None: ...
    def call_by_name(
        self, rule: rules.Rule, call_name: str, indent: int = ..., i_var: str = ..., context_name: str = ...
    ) -> None: ...
    def run(self) -> str: ...

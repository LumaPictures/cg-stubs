import re
from collections.abc import Collection, Mapping, Sequence
from types import CodeType, EllipsisType
from typing import Any, Generic, Self, TypeAlias, TypeVar, overload

_Miss: TypeAlias = "type[miss]"
_Empty: TypeAlias = "type[empty]"
_Failure: TypeAlias = "type[failure]"
# What a rule outputs when it matches (it outputs `miss` when it doesn't).
_O = TypeVar("_O", covariant=True, default=Any)
_T = TypeVar("_T", default=Any)
# The output of a parent rule's sub-rule.
_C = TypeVar("_C", default=Any)
_D = TypeVar("_D", default=None)
# A Mixed rule's content rule: its text is str, like a Mixed rule without one.
_S = TypeVar("_S", default=str)
# What ast.literal_eval() gives.
_Literal: TypeAlias = (
    str
    | bytes
    | int
    | float
    | complex
    | bool
    | EllipsisType
    | None
    | tuple["_Literal", ...]
    | list["_Literal"]
    | dict["_Literal", "_Literal"]
    | set["_Literal"]
)

blockbreak_expr: re.Pattern[str]
emptylines_expr: re.Pattern[str]
ws_expr: re.Pattern[str]
hspaces_expr: re.Pattern[str]
brackets: dict[str, str]
endbrackets: frozenset[str]

def take_app_args(source: str, i: int) -> tuple[list[str], int] | tuple[None, int]: ...

class Rule(Generic[_O]):
    name: str
    def __init__(self, name: str = ...) -> None: ...
    def __repr__(self) -> str: ...
    def __add__(self, other: Rule | str) -> Seq: ...
    def __radd__(self, other: Rule | str) -> Seq: ...
    @overload
    def __or__(self, other: Rule[_T]) -> Or[_O | _T]: ...
    @overload
    def __or__(self, other: str) -> Or[_O | str]: ...
    def __or__(self, other: Rule[_T] | str) -> Or[_O | _T] | Or[_O | str]: ...
    @overload
    def __ror__(self, other: Rule[_T]) -> Or[_T | _O]: ...
    @overload
    def __ror__(self, other: str) -> Or[str | _O]: ...
    def __ror__(self, other: Rule[_T] | str) -> Or[_T | _O] | Or[str | _O]: ...
    def __pow__(self, name: str) -> Self: ...
    def dump(self, seen: set[Rule], tab: int = ...) -> None: ...
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_O | _Miss, int]: ...

class SingletonRule(Rule[_O]):
    def __hash__(self) -> int: ...

class AnyChar(SingletonRule[str]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[str | _Miss, int]: ...

class AlphaNum(SingletonRule[str]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[str | _Miss, int]: ...

class StreamStart(SingletonRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class LineStart(SingletonRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class WikiLineStart(SingletonRule[int]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[int | _Miss, int]: ...

class WordStart(SingletonRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class WordEnd(SingletonRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class LineEnd(SingletonRule[_Empty | str]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | str | _Miss, int]: ...

class StreamEnd(SingletonRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class BlockBreak(SingletonRule[_Empty | str]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | str | _Miss, int]: ...


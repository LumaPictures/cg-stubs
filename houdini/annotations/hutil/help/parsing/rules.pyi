class MultiRule(Rule[_T]):
    rules: list[Rule[_T]]
    def __init__(self, rules: Sequence[Rule[_T] | str]) -> None: ...
    def __hash__(self) -> int: ...
    def dump(self, seen: set[Rule], tab: int = ...) -> None: ...

class Or(MultiRule[_T]):
    @overload
    def __init__(self: Or[_T], rules: Sequence[Rule[_T]]) -> None: ...
    @overload
    def __init__(self: Or[_T | str], rules: Sequence[Rule[_T] | str]) -> None: ...
    def __init__(self, rules: Sequence[Rule[_T] | str]) -> None: ...
    def fixed_length(self, ctx: Ctx) -> int: ...
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_T | _Miss, int]: ...

# Outputs what its last rule (other than a Wall) outputs: Any, as its rules' outputs differ.
class Seq(MultiRule[Any]): ...

class ParentRule(Rule[_O]):
    rule: Rule
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...
    def dump(self, seen: set[Rule], tab: int = ...) -> None: ...

class Not(ParentRule[_Empty]):
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[_Empty | _Miss, int]: ...

class Repeat(ParentRule[list[_C]]):
    rule: Rule[_C]
    mintimes: int
    maxtimes: int | None
    def __init__(self, rule: Rule[_C], mintimes: int = ..., maxtimes: int | None = ...) -> None: ...
    def __hash__(self) -> int: ...
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[list[_C] | _Miss, int]: ...

class Star(Repeat[_C]):
    def __init__(self, rule: Rule[_C]) -> None: ...

class Plus(Repeat[_C]):
    def __init__(self, rule: Rule[_C]) -> None: ...

class Opt(ParentRule[list[_C]]):
    rule: Rule[_C]
    def is_optional(self) -> bool: ...
    def __call__(self, src: str, i: int, ctx: Ctx) -> tuple[list[_C], int]: ...


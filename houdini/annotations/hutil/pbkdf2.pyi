class _Crypt(Protocol):
    def __call__(self, word: str | builtins.bytes, salt: str | builtins.bytes | None = ..., iterations: int | None = ...) -> str: ...

class PBKDF2:
    closed: bool
    crypt: _Crypt
    def __init__(self, passphrase: str | builtins.bytes, salt: str | builtins.bytes, iterations: int = ..., digestmodule: str | ModuleType | Callable[[], HASH] = ..., macmodule: ModuleType = ...) -> None: ...
    def read(self, bytes: int) -> builtins.bytes: ...
    def hexread(self, octets: int) -> str: ...
    def close(self) -> None: ...

def crypt(word: str | builtins.bytes, salt: str | builtins.bytes | None = ..., iterations: int | None = ...) -> str: ...

from collections.abc import Container, Iterable, MutableSequence, Sequence
from typing import Literal, Protocol

import numpy as np
import numpy.typing as npt
import torch
from houtypes import JSONLike, JSONValue
from torch.utils.data import DataLoader, Dataset
from torch.utils.data.distributed import DistributedSampler

from hutil.ml.oidn import tza
from hutil.ml.oidn.options import TrainingOptions

class _DataDirConfig(Protocol):
    @property
    def data_dir(self) -> str: ...

def get_channels(features: Container[str], target: Literal["dataset", "model"]) -> list[str]: ...
def get_dataset_channels(features: Container[str]) -> list[str]: ...
def get_model_channels(features: Container[str]) -> list[str]: ...
def get_channel_indices(channels: Iterable[str], all_channels: Sequence[str]) -> list[int]: ...
def shuffle_channels(
    channels: MutableSequence[str],
    first_channel: str,
    order: Iterable[int],
    num_channels: int | None = ...,
) -> None: ...
def image_exists(name: str, ext: str, features: list[str]) -> bool: ...
def get_image_feature(filename: str) -> str: ...
def load_image_features(
    name: str, features: Container[str], ext: str
) -> tuple[npt.NDArray[np.float32], dict[str, int]]: ...
def load_image_metadata(name: str) -> JSONValue: ...
def save_image_metadata(name: str, metadata: JSONLike) -> None: ...
def get_data_dir(cfg: _DataDirConfig, name: str) -> str: ...
def get_image_sample_groups(
    dir: str, input_features: list[str], ext: str, target_features: list[str] | None = ...
) -> list[tuple[str, list[str], str | None]]: ...
def transform_feature(
    image: torch.Tensor, input_feature: str, output_feature: str, exposure: float = ...
) -> torch.Tensor: ...
def get_data_loader(
    rank: int,
    cfg: TrainingOptions,
    dataset: Dataset[tuple[torch.Tensor, torch.Tensor]],
    shuffle: bool = ...,
) -> tuple[
    DataLoader[tuple[torch.Tensor, torch.Tensor]],
    DistributedSampler[tuple[torch.Tensor, torch.Tensor]] | None,
]: ...
def get_preproc_data_dir(cfg: TrainingOptions, name: str) -> str: ...

class PreprocessedDataset(Dataset[tuple[torch.Tensor, torch.Tensor]]):
    samples: list[list[str]]
    num_images: int
    tile_size: int
    features: list[str]
    main_feature: str
    aux_features: list[str]
    clean_aux: bool | list[str]
    channels: list[str]
    all_channels: list[str]
    num_main_channels: int
    images: tza.Reader
    def __init__(self, cfg: TrainingOptions, name: str) -> None: ...

class TrainingDataset(PreprocessedDataset):
    max_padding: int
    def __init__(self, cfg: TrainingOptions, name: str) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> tuple[torch.Tensor, torch.Tensor]: ...

class ValidationDataset(PreprocessedDataset):
    tiles: list[tuple[int, int, int, list[int]]]
    def __init__(self, cfg: TrainingOptions, name: str) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> tuple[torch.Tensor, torch.Tensor]: ...

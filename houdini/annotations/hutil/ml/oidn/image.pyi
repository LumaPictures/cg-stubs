from typing import Literal, overload

import numpy as np
import numpy.typing as npt
import torch

def image_to_tensor(image: npt.NDArray[np.generic], batch: bool = ...) -> torch.Tensor: ...
def tensor_to_image(image: torch.Tensor) -> npt.NDArray[np.generic]: ...
def tensor_gradient(input: torch.Tensor) -> torch.Tensor: ...
@overload
def compare_images(a: torch.Tensor, b: torch.Tensor, metric: Literal["psnr"] = ...) -> float: ...
@overload
def compare_images(
    a: torch.Tensor, b: torch.Tensor, metric: Literal["mse", "ssim", "msssim"]
) -> torch.Tensor: ...
@overload
def compare_images(a: torch.Tensor, b: torch.Tensor, metric: str = ...) -> torch.Tensor | float: ...
def compare_images(a: torch.Tensor, b: torch.Tensor, metric: str = ...) -> torch.Tensor | float: ...
def load_image(
    filename: str, num_channels: int | None = ...
) -> tuple[npt.NDArray[np.float32], int]: ...
def save_image(
    filename: str, image: npt.NDArray[np.generic], num_channels: int | None = ...
) -> None: ...
def save_pfm(filename: str, image: npt.NDArray[np.generic]) -> None: ...
def save_phm(filename: str, image: npt.NDArray[np.generic]) -> None: ...

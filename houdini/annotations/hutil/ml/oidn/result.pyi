from typing import Any, Literal, Protocol, TypedDict

import torch

class _ResultConfig(Protocol):
    @property
    def result(self) -> str: ...
    @property
    def results_dir(self) -> str: ...

class _Checkpoint(TypedDict):
    epoch: int
    step: int
    model_state: dict[str, torch.Tensor]
    optimizer_state: dict[str, Any]

def get_result_dir(cfg: _ResultConfig, result: str | None = ...) -> str: ...
def get_checkpoint_dir(result_dir: str) -> str: ...
def get_checkpoint_filename(result_dir: str, epoch: int) -> str: ...
def get_checkpoint_state_filename(result_dir: str) -> str: ...
def validate_latest_checkpoint_epoch(result_dir: str) -> bool: ...
def get_latest_checkpoint_epoch(result_dir: str) -> int: ...
def get_result_log_dir(result_dir: str) -> str: ...
def save_checkpoint(
    result_dir: str,
    epoch: int,
    step: int,
    model: torch.nn.Module,
    optimizer: torch.optim.Optimizer,
) -> None: ...
def validate_checkpoint(
    result_dir: str, device: torch.device, epoch: int | None = ...
) -> tuple[Literal[False], None] | tuple[Literal[True], _Checkpoint]: ...
def load_checkpoint(
    result_dir: str,
    device: torch.device,
    epoch: int | None = ...,
    model: torch.nn.Module | None = ...,
    optimizer: torch.optim.Optimizer | None = ...,
) -> _Checkpoint: ...

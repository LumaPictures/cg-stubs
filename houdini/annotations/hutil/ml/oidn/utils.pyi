import os
from collections.abc import Callable, Iterable, Sequence
from typing import NoReturn, Protocol, TypeAlias, TypeVar, overload

import torch
from houtypes import JSONLike, JSONValue

_StrPath: TypeAlias = str | os.PathLike[str]

class _HasNumDevices(Protocol):
    @property
    def num_devices(self) -> int: ...

class _DistributedConfig(Protocol):
    @property
    def num_devices(self) -> int: ...
    @property
    def device(self) -> str: ...

class _DeviceConfig(Protocol):
    @property
    def device(self) -> str: ...
    @property
    def deterministic(self) -> bool: ...

_Cfg = TypeVar("_Cfg", bound=_HasNumDevices)
_W = TypeVar("_W")

WORKER_RANK: int
WORKER_UID: str

@overload
def round_down(a: int, b: int) -> int: ...
@overload
def round_down(a: float, b: float) -> float: ...
@overload
def round_up(a: int, b: int) -> int: ...
@overload
def round_up(a: float, b: float) -> float: ...
@overload
def round_nearest(a: int, b: int) -> int: ...
@overload
def round_nearest(a: float, b: float) -> float: ...
def error(*args: object) -> NoReturn: ...
def warning(*args: object) -> None: ...
def get_path_ext(path: _StrPath) -> str: ...
def load_json(filename: _StrPath) -> JSONValue: ...
def save_json(filename: _StrPath, obj: JSONLike) -> None: ...
def load_csv(filename: _StrPath) -> list[str | float | list[str | float]]: ...
def save_csv(
    filename: _StrPath, rows: Iterable[Sequence[str | float] | str | float]
) -> None: ...
def save_zip(
    output_filename: _StrPath,
    input_filenames: Iterable[_StrPath],
    root_dir: _StrPath | None = ...,
) -> None: ...
def start_workers(
    cfg: _Cfg, work_item: _W, worker_fn: Callable[[int, _Cfg, _W], object]
) -> None: ...
def init_worker(rank: int, cfg: _DistributedConfig) -> bool: ...
def cleanup_worker(cfg: _HasNumDevices) -> None: ...
def init_device(cfg: _DeviceConfig, id: int = ...) -> torch.device: ...
def unwrap_module(module: torch.nn.Module) -> torch.nn.Module: ...
def rand() -> float: ...
def randint(low: int, high: int | None = ...) -> int: ...
def randperm(n: int) -> list[int]: ...

class ProgressBar:
    total: int
    prefix: str
    width: int
    verbose: bool
    value: int
    def __init__(
        self, total: int, prefix: str = ..., width: int = ..., verbose: bool = ...
    ) -> None: ...
    def update(self, value: int) -> None: ...
    def next(self) -> None: ...
    def finish(self, suffix: str = ...) -> None: ...

def format_time(seconds: float, precision: int | None = ...) -> str: ...

from typing import Protocol

class _LogFile(Protocol):
    def write(self, s: str, /) -> object: ...
    def flush(self) -> object: ...

class Log:
    log_to_standard_output: bool
    log_file: _LogFile | None
    def __init__(self, /, *, log_to_standard_output: bool = ..., log_file: _LogFile | None = ...) -> None: ...
    def write(self, s: str) -> None: ...
    def flush(self) -> None: ...

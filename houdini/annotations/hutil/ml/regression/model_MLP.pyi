    def __call__(self) -> ModelMLP: ...
    def description(self) -> str: ...

def modelMLPFactory(mlp_config: ModelMLPConfig, input_layout: ComponentLayout, target_layout: ComponentLayout) -> ModelMLPFactory: ...

import torch
import torch.nn as nn
from _typeshed import StrPath, SupportsWrite
from collections.abc import Mapping, Sequence
from hutil.ml.regression.data_layout import ComponentLayout
from hutil.ml.regression.training_config import ONNXExporterConfig, ONNXParameterStorage

class TrainingRecord:
    epoch: int
    unimproved_count: int
    best_model_epoch: int
    best_model_training_loss: float | None
    best_model_validation_loss: float | None
    def __init__(self, /, *, epoch: int, unimproved_count: int, best_model_epoch: int) -> None: ...

def initialTrainingRecord() -> TrainingRecord: ...
def saveTrainingState(checkpoint_path: StrPath, objective_state: nn.Module, optimizer: torch.optim.Optimizer, scheduler: torch.optim.lr_scheduler.LRScheduler, best_objective_state: nn.Module, training_record: TrainingRecord, /, *, log_file: SupportsWrite[str] | None = ...) -> None: ...
def loadTrainingState(objective_state: nn.Module, optimizer: torch.optim.Optimizer, scheduler: torch.optim.lr_scheduler.LRScheduler, best_objective_state: nn.Module, training_record: TrainingRecord, checkpoint_path: StrPath, /, *, log_file: SupportsWrite[str] | None = ...) -> None: ...
def saveModuleAsTorch(model: nn.Module, path: StrPath, /, *, log_file: SupportsWrite[str] | None = ...) -> None: ...
def resaveONNXModelWithExternalData(path: StrPath, log_file: SupportsWrite[str] | None) -> None: ...
def implONNXRegularExportDynamo(model: nn.Module, shaped_inputs: tuple[torch.Tensor, ...], path: StrPath, log_file: SupportsWrite[str] | None, /, *, input_names: Sequence[str], output_names: Sequence[str], opset_version: int | None, onnx_parameter_storage: ONNXParameterStorage) -> None: ...
def implONNXRegularExportTorchscript(model: nn.Module, shaped_inputs: tuple[torch.Tensor, ...], path: StrPath, /, *, log_file: SupportsWrite[str] | None, input_names: Sequence[str], output_names: Sequence[str], opset_version: int | None, dynamic_axes: Mapping[str, Mapping[int, str]], onnx_parameter_storage: ONNXParameterStorage) -> None: ...
def modelOutputLayout(model: nn.Module, shaped_inputs: Sequence[torch.Tensor]) -> ComponentLayout: ...
def exportToONNX(model: nn.Module, input_layout: ComponentLayout, path: StrPath, /, *, log_file: SupportsWrite[str] | None = ..., device: str | torch.device = ..., onnx_exporter_config: ONNXExporterConfig | None = ...) -> None: ...

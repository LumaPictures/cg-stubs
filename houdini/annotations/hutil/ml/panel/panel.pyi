# What a ParmTupleChanged node event callback gets besides event_type.
class _ParmTupleChangedKwargs(TypedDict):
    node: hou.OpNode
    parm_tuple: hou.ParmTuple | None

class _PlotDescription(TypedDict, total=False):
    title: str
    x_axis: str
    y_axis: str
    x_range: Sequence[float] | None
    y_range: Sequence[float] | None
    path_format: str

class _TestDescription(TypedDict, total=False):
    path_format: str
    count: int
    rate: int
    components: list[str]

class _ModelDescription(TypedDict, total=False):
    name: str
    max_epochs: int
    first_epoch: int
    plots: list[_PlotDescription]
    test: _TestDescription

class _LogScaleAnalysis(TypedDict):
    has_data: bool
    y_min: float | None
    y_max: float | None
    safe_linthresh: float
    safe_bottom: float

class _LogSpacedLines(TypedDict):
    thick_positions: list[float]
    thin_positions: list[float]

class PlotContext:
    title: str

from collections import OrderedDict, defaultdict
from collections.abc import Iterable
from typing import Literal, overload

import numpy as np
import numpy.typing as npt

from hutil.ml.gsplat.pycolmap.camera import Camera
from hutil.ml.gsplat.pycolmap.image import Image

class SceneManager:
    INVALID_POINT3D: int
    folder: str
    image_path: str | None
    cameras: OrderedDict[int, Camera]
    images: OrderedDict[int, Image]
    name_to_image_id: dict[str, int]
    last_camera_id: int
    last_image_id: int
    points3D: npt.NDArray[np.float64]
    point3D_ids: npt.NDArray[np.uint64]
    point3D_id_to_point3D_idx: dict[np.uint64, int]
    point3D_id_to_images: dict[np.uint64, npt.NDArray[np.uint32]]
    point3D_colors: npt.NDArray[np.uint8]
    point3D_errors: npt.NDArray[np.float64]
    scene_graph: defaultdict[np.uint32, defaultdict[np.uint32, int]]
    def __init__(self, colmap_results_folder: str, image_path: str | None = ...) -> None: ...
    def load_colmap_project_file(self, project_file: str | None = ..., image_path: str | None = ...) -> None: ...
    def load(self) -> None: ...
    def load_cameras(self, input_file: str | None = ...) -> None: ...
    def load_images(self, input_file: str | None = ...) -> None: ...
    def load_points3D(self, input_file: str | None = ...) -> None: ...
    def save(self, output_folder: str, binary: bool = ...) -> None: ...
    def save_cameras(self, output_folder: str, output_file: str | None = ..., binary: bool = ...) -> None: ...
    def save_images(self, output_folder: str, output_file: str | None = ..., binary: bool = ...) -> None: ...
    def save_points3D(self, output_folder: str, output_file: str | None = ..., binary: bool = ...) -> None: ...
    def get_image_from_name(self, image_name: str) -> tuple[int, Image]: ...
    def get_camera(self, camera_id: int) -> Camera: ...
    @overload
    def get_points3D(
        self, image_id: int, return_points2D: Literal[False], return_colors: Literal[False] = ...
    ) -> npt.NDArray[np.float64]: ...
    @overload
    def get_points3D(
        self, image_id: int, return_points2D: Literal[True] = ..., return_colors: Literal[False] = ...
    ) -> list[npt.NDArray[np.float64]]: ...
    @overload
    def get_points3D(
        self, image_id: int, return_points2D: bool, return_colors: Literal[True]
    ) -> list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]: ...
    @overload
    def get_points3D(
        self, image_id: int, return_points2D: bool = ..., return_colors: bool = ...
    ) -> (
        npt.NDArray[np.float64]
        | list[npt.NDArray[np.float64]]
        | list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]
    ): ...
    def get_points3D(
        self, image_id: int, return_points2D: bool = ..., return_colors: bool = ...
    ) -> (
        npt.NDArray[np.float64]
        | list[npt.NDArray[np.float64]]
        | list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]
    ): ...
    def point3D_valid(self, point3D_id: np.uint64) -> bool: ...
    @overload
    def get_filtered_points3D(self, return_colors: Literal[False] = ...) -> npt.NDArray[np.float64]: ...
    @overload
    def get_filtered_points3D(
        self, return_colors: Literal[True]
    ) -> list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]: ...
    @overload
    def get_filtered_points3D(
        self, return_colors: bool = ...
    ) -> npt.NDArray[np.float64] | list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]: ...
    def get_filtered_points3D(
        self, return_colors: bool = ...
    ) -> npt.NDArray[np.float64] | list[npt.NDArray[np.float64] | npt.NDArray[np.uint8]]: ...
    def get_shared_points3D(self, image_id1: int, image_id2: int) -> npt.NDArray[np.float64]: ...
    def get_viewed_points(self, image_id: int) -> tuple[npt.NDArray[np.float64], npt.NDArray[np.float64]]: ...
    def add_camera(self, camera: Camera) -> int: ...
    def add_image(self, image: Image) -> int: ...
    def delete_images(self, image_list: Iterable[int]) -> None: ...
    def filter_points3D(
        self,
        min_track_len: int = ...,
        max_error: float = ...,
        min_tri_angle: float = ...,
        max_tri_angle: float = ...,
        image_set: Iterable[int] = ...,
    ) -> None: ...
    def build_scene_graph(self) -> None: ...

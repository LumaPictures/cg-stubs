import pathlib
from collections.abc import Callable, Sequence
from typing import ClassVar

import hou
from PySide6 import QtCore, QtGui, QtQml

from hutil.qt.common import config, qmlviews

from .palettes import Palette

PREFS_DIR: pathlib.Path
SCREEN_MODE: QtGui.QPainter.CompositionMode
MULTIPLY_MODE: QtGui.QPainter.CompositionMode
PALETTE_LIBRARY_PATH: str

class _ParmTupleUndo:
    def __init__(self, parm: hou.ParmTuple, before: tuple[float, ...], after: tuple[float, ...]) -> None: ...

class _DataSource:
    def write(self, values: Sequence[float], phase: hou.EnumValue[hou.uiEventReason] = ...) -> None: ...
    def subscribe(self, on_change: Callable[[], object]) -> None: ...

class ColorEditorConfig(config.BaseConfig):
    def __init__(self, **kwargs: object) -> None: ...

class ColorState(qmlviews.SharedState[ColorEditorConfig]):
    markers: list[dict[str, float | QtGui.QColor]]
    okMatrix: list[float]
    planeNamesChanged: ClassVar[QtCore.Signal]
    imageAutoSpaceChanged: ClassVar[QtCore.Signal]
    screenPickRequested: ClassVar[QtCore.Signal]
    def __init__(self, **kwargs: object) -> None: ...
    def setupEngine(self, engine: QtQml.QQmlEngine, **kwargs: object) -> None: ...
    def linear(self, r: float, g: float, b: float, a: float = ..., name: str = ...) -> LinearRgb: ...
    def setParmTuplePath(self, path: str | None) -> None: ...
    def setFromCallback(self, values: Sequence[float], set_original: bool = ...) -> None: ...
    def paletteByName(self, name: str, fallback: str | None = ...) -> Palette | None: ...
    def selectPaletteNamed(self, name: str, fallback: str | None = ...) -> None: ...
    def setSaved(self, r: float, g: float, b: float, a: float = ...) -> None: ...
    def removeImage(self, index: int | None = ...) -> None: ...
    def addImageURL(self, url: str = ...) -> None: ...
    def convertToOkhsv(self, r: float, g: float, b: float) -> list[float]: ...
    def convertFromOkhsv(self, h: float, s: float, v: float) -> list[float]: ...
    def convertToOkhsl(self, r: float, g: float, b: float) -> list[float]: ...
    def convertToOklch(self, r: float, g: float, b: float) -> list[float]: ...
    def convertFromOklch(self, l: float, c: float, h: float) -> list[float]: ...
    def computeMarkers(self, hue_angles: Sequence[float], sat: float, light: float, display: int, view: int, correct: bool) -> list[dict[str, float | QtGui.QColor]]: ...

class ColorPicker(QtCore.QObject):
    finished: ClassVar[QtCore.Signal]

class ColorEditorViewWindow(qmlviews.BaseQmlView[ColorState]):
    SOURCE_URL: str
    DEFAULT_SIZE: QtCore.QSize
    MINIMUM_SIZE: QtCore.QSize
    def __init__(self, *, parm_tuple: hou.ParmTuple | None = ..., initial_color: hou.Color | None = ..., initial_alpha: float = ..., title: str = ..., parent_window: QtGui.QWindow | None = ..., callback: Callable[[hou.Color], None] | None = ...) -> None: ...

class GrayscaleColorEditorWindow(ColorEditorViewWindow):
    SOURCE_URL: str
    DEFAULT_SIZE: QtCore.QSize
    MINIMUM_SIZE: QtCore.QSize

def showColorEditorWindow(parm_tuple: hou.ParmTuple | None = ..., token: int | None = ...) -> ColorEditorViewWindow: ...
def pickColor(parm_tuple: hou.ParmTuple | None = ..., token: int | None = ...) -> None: ...

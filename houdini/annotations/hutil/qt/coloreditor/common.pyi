from collections.abc import Iterator, MutableSequence, Sequence
from typing import Generic, TypeVar

import PyOpenColorIO as OCIO
from PySide6 import QtCore, QtGui

from hutil.qt.common import core
from hutil.qt.coloreditor.window import ColorState

# PaletteModel is an ItemModel of LinearRgb, which is not an Info.
T = TypeVar("T", bound="core.Info | LinearRgb")

IMAGE_FORMAT: QtGui.QImage.Format

def gradient(colors: Sequence[QtGui.QColor], vertical: bool = ...) -> QtGui.QLinearGradient: ...

class LinearRgb(QtCore.QObject):
    def __init__(self, r: float = ..., g: float = ..., b: float = ..., a: float = ..., name: str = ..., *, hue: float | None = ..., saturation: float | None = ..., value: float | None = ..., ok_hue: float | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def data(self) -> dict[str, list[float] | str]: ...

def cachedProcessor(colorspace: str, display: str, view: str, inverse: bool = ...) -> OCIO.CPUProcessor: ...

class ItemModel(QtCore.QAbstractListModel, Generic[T]):
    def __init__(self, state: ColorState, storage: MutableSequence[T] | None = ...) -> None: ...
    def __iter__(self) -> Iterator[T]: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def save(self) -> None: ...

from PySide6 import QtCore, QtGui, QtQuick

from hutil.qt.coloreditor.images import ImageModel

SCREEN_MODE: QtGui.QPainter.CompositionMode
MULTIPLY_MODE: QtGui.QPainter.CompositionMode

class ColorMappingImageProvider(QtQuick.QQuickImageProvider):
    def __init__(self) -> None: ...
    def generate(self, name: str, size: QtCore.QSize, req_size: QtCore.QSize, params: dict[str, str]) -> QtGui.QImage: ...

class ImageFileProvider(ColorMappingImageProvider):
    def __init__(self, model: ImageModel) -> None: ...
    def sampleImage(self, image_index: int, x: int, y: int) -> QtGui.QColor: ...

class GradientProvider(ColorMappingImageProvider):
    def hslHueStrip(self, sat: float, light: float, size: QtCore.QSize, steps: int = ...) -> QtGui.QImage: ...
    def hsvSquare(self, val: float, size: QtCore.QSize, steps: int = ...) -> QtGui.QImage: ...

import enum
import re

from hutil.pratt import LexerFn, Parser, StdKind, Token
from hutil.qt.nodesearch import matchers

class Kind(enum.Enum): ...

token_exprs: dict[Kind | StdKind, str | re.Pattern[str] | LexerFn[Kind]]

class NodeSearchParser(Parser[Kind, matchers.Matcher]):
    text: str
    tokens: list[Token[Kind]]
    def __init__(self) -> None: ...
    def parse(self, text: str) -> matchers.Matcher: ...
    def group(self, token: Token[Kind]) -> matchers.Matcher: ...
    def comment(self, token: Token[Kind]) -> matchers.Matcher: ...
    def binary(self, lhs: matchers.Matcher, token: Token[Kind]) -> matchers.Matcher: ...
    def modifier(self, expr: matchers.Matcher, token: Token[Kind]) -> matchers.Matcher: ...
    def mode(self, token: Token[Kind]) -> matchers.Matcher: ...
    def recent(self, token: Token[Kind]) -> matchers.Matcher: ...
    def keyed(self, token: Token[Kind]) -> matchers.Matcher: ...
    def field(self, token: Token[Kind]) -> matchers.Matcher: ...
    def script(self, token: Token[Kind]) -> matchers.Matcher: ...
    def word(self, token: Token[Kind]) -> matchers.Matcher: ...
    def string(self, token: Token[Kind]) -> matchers.Matcher: ...
    def timeDelta(self, token: Token[Kind]) -> matchers.Matcher: ...

def fielded(field: str, token: Token[Kind], key: str = ...) -> matchers.Matcher: ...

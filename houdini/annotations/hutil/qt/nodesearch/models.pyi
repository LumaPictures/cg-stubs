import dataclasses
from collections.abc import Iterable, Iterator, Mapping
from typing import ClassVar

import hou
import PySide6.QtCore
from typing_extensions import TypedDict

from hutil.qt.nodesearch import matchers
from hutil.qt.nodesearch.matchers import _MatcherData
from hutil.qt.nodesearch.findwindow import SearchState

def itemColorCode(item: hou.NetworkBox | hou.StickyNote) -> str: ...

class QueryListModel(PySide6.QtCore.QAbstractListModel):
    ItemRole: int
    EnabledRole: int
    ModeRole: int
    RequiredRole: int
    ExcludedRole: int
    queryUpdated: ClassVar[PySide6.QtCore.Signal]
    queryEdited: ClassVar[PySide6.QtCore.Signal]
    def __init__(self, state: SearchState, items: list[matchers.Matcher]) -> None: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def __iter__(self) -> Iterator[matchers.Matcher]: ...
    def state(self) -> SearchState: ...
    def setItems(self, items: Iterable[matchers.Matcher]) -> None: ...
    def matchingItems(self, network: hou.Node, ctx: matchers.Context) -> dict[str, matchers.Hit]: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def itemAt(self, i: int) -> matchers.Matcher | None: ...
    def indexOf(self, item: matchers.Matcher) -> int: ...
    def asText(self) -> str: ...
    def insertItem(self, row: int, item: matchers.Matcher) -> None: ...
    def appendItem(self, item: matchers.Matcher) -> None: ...
    @property
    def hasNonExcluded(self) -> bool: ...
    @property
    def hasBypassFilter(self) -> bool: ...
    @property
    def hasUnderscoreFilter(self) -> bool: ...
    def changeType(self, row: int, type_name: str) -> None: ...
    def removeCondition(self, row: int) -> None: ...
    def move(self, source_row: int, dest_row: int) -> bool: ...
    def needsItems(self) -> bool: ...
    def addCondition(self, index: int, type_name: str, kwargs: Mapping[str, object] | None = ...) -> None: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> matchers.Matcher | bool | int | None: ...

class ResultsModel(PySide6.QtCore.QAbstractTableModel):
    HitRole: int
    ItemRole: int
    NameRole: int
    PathRole: int
    KindRole: int
    IconRole: int
    NodeTypeRole: int
    NodeDescRole: int
    TypeDescRole: int
    SnippetRole: int
    CreatedTimestampRole: int
    CreatedStringRole: int
    CreatedDateTimeRole: int
    ModifiedTimestampRole: int
    ModifiedStringRole: int
    ModifiedDateTimeRole: int
    ColorRole: int
    DisplayFlagRole: int
    RenderFlagRole: int
    BypassFlagRole: int
    column_names: list[str]
    _role_to_flag: dict[int, hou.EnumValue[hou.nodeFlag]]
    isUniEditor: bool
    def __init__(self, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def setPath(self, path: str) -> None: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def items(self) -> list[matchers.Hit]: ...
    def setItems(self, items: Iterable[matchers.Hit]) -> None: ...
    def clear(self) -> None: ...
    def headerData(self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int = ...) -> str | None: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag: ...
    def itemAt(self, row: int) -> hou.NetworkMovableItem | None: ...
    def pathAt(self, row: int) -> str: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> matchers.Hit | hou.NetworkMovableItem | str | float | bool | PySide6.QtCore.QDateTime | None: ...

class SortedResultsModel(PySide6.QtCore.QSortFilterProxyModel):
    def __init__(self, model: ResultsModel) -> None: ...
    def lessThan(self, left: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, right: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...
    def orderedItems(self) -> list[hou.NetworkMovableItem]: ...

@dataclasses.dataclass
# A SavedQuery as SavedQueryModel saves it in the find window's settings.
class _SavedQueryData(TypedDict, closed=True):  # type: ignore[call-arg]
    name: str
    queryData: _MatcherData
    excludesData: _MatcherData

class SavedQuery:
    name: str
    queryData: _MatcherData
    excludesData: _MatcherData

class SavedQueryModel(PySide6.QtCore.QAbstractListModel):
    countChanged: ClassVar[PySide6.QtCore.Signal]
    itemRenamed: ClassVar[PySide6.QtCore.Signal]
    def __init__(self, parent: SearchState) -> None: ...
    def state(self) -> SearchState: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    @property
    def count(self) -> int: ...
    def save(self) -> None: ...
    def load(self) -> None: ...
    def asData(self) -> list[_SavedQueryData]: ...
    def items(self) -> list[SavedQuery]: ...
    def itemAt(self, row: int) -> SavedQuery: ...
    def queryAt(self, row: int) -> matchers.Matcher: ...
    def excludesAt(self, row: int) -> matchers.Matcher: ...
    def append(self, name: str, query: matchers.Matcher, excludes: matchers.Matcher) -> None: ...
    def deleteRow(self, row: int) -> None: ...
    def move(self, source_row: int, dest_row: int) -> bool: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> str | None: ...
    def setData(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, value: str, role: int = ...) -> bool: ...

_M = TypeVar("_M", bound="Matcher")
_K = TypeVar("_K")
_V = TypeVar("_V")

# A Matcher as Matcher.asData() saves it: its class name, and its fields' values (a group's
# children as their own data).
_MatcherData = TypedDict(  # type: ignore[call-arg]
    "_MatcherData", {"class": str, "children": "list[_MatcherData]"}, total=False, extra_items=JSONValue
)

# The keywords Matcher takes; any others are set as Info fields.
class _MatcherKwargs(TypedDict, total=False, extra_items=ReadOnly[object]):  # type: ignore[call-arg]
    required: bool
    excluded: bool

default_field: str
default_op: str
matcher_types: dict[str, type[Matcher]]
version_expr: re.Pattern[str]
ResultSet: TypeAlias = dict[str, "Hit"]

def matcherByName(name: str, kwargs: Mapping[str, Any]) -> Matcher: ...
def matcherType(cls: type[_M]) -> type[_M]: ...

class Mode(enum.IntEnum): ...

class Context:
    base_path: str
    recursive: bool
    into_locked: bool
    sync_delayed: bool
    ignore_case: bool
    match_items: bool

def mergeSpans(iter1: Sequence[Span], iter2: Sequence[Span]) -> Iterator[Span]: ...
def itemName(item: hou.NetworkMovableItem) -> str: ...
def makeExpr(method: StringMethod, ctx: Context, text: str) -> re.Pattern[str]: ...

class Hit:
    item: hou.NetworkMovableItem
    name_snip: str
    type_snip: str
    desc_snip: str
    snippet: str
    snippetPrefix: str
    name_spans: Sequence[Span]
    type_spans: Sequence[Span]
    desc_spans: Sequence[Span]
    snip_spans: Sequence[Span]
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> str: ...
    @property
    def desc(self) -> str: ...
    @property
    def created(self) -> datetime.datetime | None: ...
    @property
    def modified(self) -> datetime.datetime | None: ...
    @property
    def created_ts(self) -> float: ...
    @property
    def modified_ts(self) -> float: ...
    def nameHtml(self) -> str: ...
    def typeHtml(self) -> str: ...
    def snippetHtml(self) -> str: ...
    def merge(self, other: Hit) -> Hit: ...

glob_expr: re.Pattern[str]

def globToRegex(pattern: str, path_match: bool = ...) -> str: ...
def html(text: str, spans: Sequence[Span]) -> str: ...
def namePatternHits(ctx: Context, pattern: str, items: Iterable[hou.NetworkMovableItem]) -> dict[str, Hit]: ...
def hitWithRegex(item: hou.NetworkMovableItem, text: str, expr: re.Pattern[str], field: str, prefix: str = ...) -> Hit: ...
def inverted_dict(d: Mapping[_K, _V]) -> dict[_V, _K]: ...
def quote(text: str) -> str: ...

class Matcher(core.Info):
    pos: int
    mode: int
    enabled: bool
    wasValid: bool
    matched: bool
    modeChanged: ClassVar[PySide6.QtCore.Signal]
    needsItemsChanged: ClassVar[PySide6.QtCore.Signal]
    focusRequested: ClassVar[PySide6.QtCore.Signal]
    edited: ClassVar[PySide6.QtCore.Signal]
    posChanged: ClassVar[PySide6.QtCore.Signal]
    enabledChanged: ClassVar[PySide6.QtCore.Signal]
    wasValidChanged: ClassVar[PySide6.QtCore.Signal]
    matchedChanged: ClassVar[PySide6.QtCore.Signal]
    def __init__(self, required: bool = ..., excluded: bool = ..., **kwargs: object) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    @classmethod
    def fromData(cls, data: _MatcherData) -> Matcher: ...
    @classmethod
    def fromDataImpl(cls, data: _MatcherData) -> Self: ...
    def normalized(self) -> Matcher: ...
    def acceptsBinOp(self, op: str, matcher: Matcher) -> bool: ...
    def withBinOp(self, op: str, rhs: TextMatcher) -> Matcher: ...
    def acceptsModifier(self, mod: str) -> bool: ...
    def withModifier(self, mod: str) -> Matcher: ...
    def asData(self) -> _MatcherData: ...
    def url(self) -> str: ...
    @property
    def isOptional(self) -> bool: ...
    @property
    def isRequired(self) -> bool: ...
    @property
    def isExcluded(self) -> bool: ...
    def withMode(self, mode: Mode) -> Self: ...
    def isValid(self) -> bool: ...
    def isFast(self, ctx: Context) -> bool: ...
    @property
    def needsItems(self) -> bool: ...
    def asText(self) -> str: ...
    def iterAll(self) -> Iterator[Matcher]: ...
    def filtersOnFlag(self, flag: str) -> bool: ...
    def study(self, ctx: Context) -> None: ...
    def matchingPaths(self, network: hou.Node, ctx: Context, excluded: Collection[str] = ...) -> Iterable[str]: ...
    def matchingItems(self, network: hou.Node, ctx: Context, excluded: Collection[str] = ...) -> dict[str, Hit]: ...
    def matches(self, item: hou.NetworkMovableItem, ctx: Context) -> bool | str | None: ...
    def getHit(self, item: hou.NetworkMovableItem, ctx: Context) -> Hit | None: ...


from collections.abc import Callable

from PySide6 import QtCore, QtGui, QtWidgets

MAX_SYNTAX_COLORING_CHARS: int

class TextView(QtWidgets.QPlainTextEdit):
    gettext: Callable[[], str]
    showingall: bool
    def __init__(self, gettext_fn: Callable[[], str], parent: QtWidgets.QWidget | None = ...) -> None: ...
    def highlighter(self) -> QtGui.QSyntaxHighlighter | None: ...
    def setHighlighter(self, hilite: QtGui.QSyntaxHighlighter) -> None: ...
    def refreshText(self) -> None: ...
    def clearText(self) -> None: ...
    def search(self, regex: QtCore.QRegularExpression | None, backward: bool, allow_current_pos: bool, showall: bool) -> None: ...
    def showAllMatches(self, regex: QtCore.QRegularExpression | None, enabled: bool) -> None: ...

import pathlib
from collections.abc import Iterable, Iterator
from typing import ClassVar

import hou
from PySide6 import QtCore, QtGui

from hutil.qt.common import config, qmlviews

USER_ASSETS_PATH: pathlib.Path

class PairModel(QtCore.QAbstractListModel):
    def __init__(self, items: Iterable[tuple[str, str | None]]) -> None: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def items(self) -> Iterator[tuple[str, str | None]]: ...
    def setItems(self, items: Iterable[tuple[str, str | None]]) -> None: ...
    def itemAt(self, row: int) -> tuple[str, str | None]: ...
    def valueAt(self, row: int) -> str | None: ...
    def indexOfValue(self, value: str | None) -> int: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = ...) -> str | None: ...

class AssetConfig(config.BaseConfig):
    def __init__(self, **kwargs: object) -> None: ...

class AssetState(qmlviews.SharedState[AssetConfig]):
    namespaceChanged: ClassVar[QtCore.Signal]
    fullNameUpdated: ClassVar[QtCore.Signal]
    filePathEdited: ClassVar[QtCore.Signal]
    pathBuilderEdited: ClassVar[QtCore.Signal]
    effectiveAuthorsChanged: ClassVar[QtCore.Signal]
    effectiveBranchesChanged: ClassVar[QtCore.Signal]
    locationChanged: ClassVar[QtCore.Signal]
    contentHeightChanged: ClassVar[QtCore.Signal]
    accepted: ClassVar[QtCore.Signal]
    rejected: ClassVar[QtCore.Signal]
    finished: ClassVar[QtCore.Signal]
    def __init__(self, **kwargs: object) -> None: ...
    def setNode(self, node: hou.OpNode) -> None: ...
    def generatedFilename(self, check_embedded: bool = ...) -> str: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...

class CreateAssetWindow(qmlviews.BaseQmlView[AssetState]):
    SOURCE_URL: str
    DEFAULT_SIZE: QtCore.QSize
    MINIMUM_SIZE: QtCore.QSize
    def __init__(self, method: str, node: hou.OpNode, *, parent_window: QtGui.QWindow | None = ..., editor: hou.NetworkEditor | None = ...) -> None: ...

def createAssetFromSubnet(subnet: hou.OpNode, editor: hou.NetworkEditor | None = ...) -> CreateAssetWindow: ...

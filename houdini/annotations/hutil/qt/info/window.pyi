    def liveUpdates(self) -> str: ...
    @liveUpdates.setter
    def liveUpdates(self, live: bool) -> None: ...
    def reload(self, recook: bool = ..., force_update: bool = ...) -> None: ...
    def removeGlobalCallbacks(self) -> None: ...
    def removeAllCallbacks(self) -> None: ...

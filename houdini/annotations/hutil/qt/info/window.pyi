    keepOpenRequested: ClassVar[PySide6.QtCore.Signal]
    visibleChanged: ClassVar[PySide6.QtCore.Signal]
    reloadableChanged: ClassVar[PySide6.QtCore.Signal]
    scrollableChanged: ClassVar[PySide6.QtCore.Signal]
    contentHeightChanged: ClassVar[PySide6.QtCore.Signal]
    pinnableChanged: ClassVar[PySide6.QtCore.Signal]
    pinnedChanged: ClassVar[PySide6.QtCore.Signal]
    wasPinnedChanged: ClassVar[PySide6.QtCore.Signal]
    stayingInPlaceChanged: ClassVar[PySide6.QtCore.Signal]
    infoChanged: ClassVar[PySide6.QtCore.Signal]
    def __init__(self, *, editor: hou.NetworkEditor | None = ..., **kwargs: object) -> None: ...
    def setupEngine(self, engine: PySide6.QtQml.QQmlEngine, **kwargs: object) -> None: ...
    def outOfDate(self) -> bool: ...
    def networkEditor(self) -> hou.NetworkEditor | None: ...
    def setNetworkEditor(self, editor: hou.NetworkEditor | None) -> None: ...
    def linkActivated(self, link: str) -> None: ...
    def deferredReload(self, recook: bool = ...) -> None: ...
    def startUpdateTimer(self) -> None: ...
    def stopUpdateTimer(self) -> None: ...
    def refresh(self) -> None: ...
    def recookAndReload(self) -> None: ...
    def reload(self, recook: bool = ..., force_update: bool = ...) -> None: ...


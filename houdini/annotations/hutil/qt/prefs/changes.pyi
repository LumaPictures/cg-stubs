from collections.abc import Callable
from typing import Any, Generic, TypeVar

from hutil.qt.common.qmlviews import SharedState

SS = TypeVar("SS", bound=SharedState[Any])

class Change(Generic[SS]):
    def undo(self, state: SS) -> None: ...
    def redo(self, state: SS) -> None: ...
    def canUpdateFrom(self, other: Change[SS], continuous: bool = ...) -> bool: ...
    def updateFrom(self, other: Change[SS]) -> None: ...

class FuncChange(Change[SS]):
    undo_fn: Callable[[SS], None]
    redo_fn: Callable[[SS], None]
    def __init__(self, undo_fn: Callable[[SS], None], redo_fn: Callable[[SS], None]) -> None: ...
    def undo(self, state: SS) -> None: ...
    def redo(self, state: SS) -> None: ...

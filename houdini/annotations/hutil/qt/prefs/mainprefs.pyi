prefsMirror: PrefsMirror

class PrefBaseChange(changes.Change[PrefsState]): ...

class PrefChange(PrefBaseChange):
    name: str
    value: str
    old_value: str
    registry: str
    def __init__(self, name: str, value: str, old_value: str, registry: str) -> None: ...
    def __repr__(self) -> str: ...
    def undo(self, state: PrefsState) -> None: ...
    def redo(self, state: PrefsState) -> None: ...
    def canUpdateFrom(self, other: changes.Change[PrefsState], continous: bool = ...) -> bool: ...
    def updateFrom(self, other: PrefChange) -> None: ...

class BlockChange(PrefBaseChange):
    registry: str
    old_values: Mapping[str, str]
    new_values: Mapping[str, str]
    def __init__(self, registry: str, old_values: Mapping[str, str], new_values: Mapping[str, str]) -> None: ...
    def undo(self, state: PrefsState) -> None: ...
    def redo(self, state: PrefsState) -> None: ...

class PageChange(PrefBaseChange):
    old_page: QtCore.QUrl
    new_page: QtCore.QUrl
    def __init__(self, old_page: QtCore.QUrl, new_page: QtCore.QUrl) -> None: ...
    def undo(self, state: PrefsState) -> None: ...
    def redo(self, state: PrefsState) -> None: ...

class PrefsConfig(config.BaseConfig):
    mainPrefsTab: str
    networkDisplayTab: str

class PrefsState(qmlviews.SharedState[PrefsConfig]):
    currentUrl: QtCore.QUrl
    autoApply: bool
    searching: bool
    rowHeight: float
    canUndo: bool
    canRedo: bool
    changeCount: int
    tipItemType: str
    continuous: bool
    searchRegex: QtCore.QRegularExpression | None
    pageRequested: ClassVar[QtCore.Signal]
    pageLoaded: ClassVar[QtCore.Signal]
    popoverShowing: ClassVar[QtCore.Signal]
    prefsUpdated: ClassVar[QtCore.Signal]
    prefsFlashed: ClassVar[QtCore.Signal]
    prefRevealed: ClassVar[QtCore.Signal]
    applied: ClassVar[QtCore.Signal]
    accepted: ClassVar[QtCore.Signal]
    rejected: ClassVar[QtCore.Signal]
    finished: ClassVar[QtCore.Signal]
    TAB_CONFIG_KEY: str
    def __init__(self, **kwargs: object) -> None: ...
    def linkActivated(self, link: str) -> None: ...
    def reveal(self, page_name: str, pref_name: str = ..., registry: str = ...) -> None: ...
    def reset(self) -> None: ...
    def buildPattern(self, text: str) -> str: ...
    def viewColor(self, r: float, g: float, b: float, a: float) -> QtGui.QColor: ...
    def isAlterted(self, name: str, registry: str = ...) -> bool: ...
    def revertPref(self, pref: str, registry: str = ...) -> None: ...
    def getPref(self, name: str, registry: str = ...) -> str: ...
    def getNumber(self, name: str, registry: str = ...) -> float: ...
    def formatNumber(self, num: float) -> str: ...
    def pushUndo(self, change: changes.Change[PrefsState]) -> None: ...
    def setPage(self, url: QtCore.QUrl, record: bool = ...) -> None: ...
    def setPageName(self, name: str) -> None: ...
    def setPref(self, name: str, value: str, registry: str = ..., auto_apply: bool = ..., record: bool = ...) -> None: ...
    def setAll(self, d: Mapping[str, str], registry: str = ..., auto_apply: bool = ..., record: bool = ...) -> None: ...
    def setNumber(self, name: str, value: float, registry: str = ..., auto_apply: bool = ...) -> None: ...
    def getBool(self, name: str, registry: str = ...) -> bool: ...
    def setBool(self, name: str, value: bool, registry: str = ...) -> None: ...
    def setColor(
        self,
        name: str,
        registry: str,
        transparent: bool,
        separated: bool,
        r: float,
        g: float,
        b: float,
        a: float = ...,
    ) -> None: ...
    def openColorEditor(
        self,
        name: str,
        registry: str,
        transparent: bool,
        separated: bool,
        red: float,
        green: float,
        blue: float,
        alpha: float = ...,
    ) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def undoAll(self) -> None: ...
    def apply(self) -> None: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...

class OclDevice(core.Info):
    number: int
    label: str
    driverVersion: str
    @classmethod
    def fromHom(cls, device: hou.OpenCLDevice) -> OclDevice: ...


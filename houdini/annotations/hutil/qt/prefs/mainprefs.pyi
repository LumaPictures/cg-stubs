    syntax: ColoringState
    metadatas: themes.MetadataModel
    helpPath: str
    noTelemetry: bool
    TAB_CONFIG_KEY: str
    def __init__(self, **kwargs: object) -> None: ...
    def setupEngine(self, engine: QtQml.QQmlEngine, **kwargs: object) -> None: ...
    def setPref(self, name: str, value: str, registry: str = ..., auto_apply: bool = ..., record: bool = ...) -> None: ...
    def getRamp(self, pref: str, registry: str = ...) -> hou.Ramp: ...
    def needsRepaint(self) -> bool: ...
    def rampPoints(self, pref: str, registry: str = ...) -> list[utils.PointDict]: ...
    def deleteRampPoint(self, pref: str, index: int, registry: str = ...) -> None: ...
    def setRampPosition(self, pref: str, index: int, pos: float, registry: str = ...) -> None: ...
    def setRampBasis(self, pref: str, index: int, basis: str, registry: str = ...) -> None: ...
    def setRampColor(self, pref: str, index: int, color: QtGui.QColor, registry: str = ...) -> None: ...
    def setRampPoints(self, pref: str, points: list[utils.PointDict], registry: str = ...) -> None: ...
    def insertRampPoint(self, pref: str, pos: float, registry: str) -> None: ...
    def colorRampLookup(self, pref: str, pos: float, registry: str = ...) -> QtGui.QColor: ...
    def openRampColorEditor(
        self,
        name: str,
        registry: str,
        index: int,
        transparent: bool,
        red: float,
        green: float,
        blue: float,
        alpha: float = ...,
    ) -> None: ...
    def reset(self) -> None: ...


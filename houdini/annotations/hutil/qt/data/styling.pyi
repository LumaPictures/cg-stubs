class ColorPolicy:
    def __repr__(self) -> str: ...
    def brushForIndex(
        self, index: int, length: int, value: float
    ) -> PySide6.QtGui.QBrush | PySide6.QtGui.QPalette.ColorRole: ...
    def mono(self) -> PySide6.QtGui.QBrush | PySide6.QtGui.QColor | PySide6.QtGui.QPalette.ColorRole: ...

class ColorLookupPolicy(ColorPolicy):
    brushes: list[PySide6.QtGui.QBrush]
    def __init__(self, brushes: Iterable[PySide6.QtGui.QBrush | PySide6.QtGui.QColor]) -> None: ...
    def __repr__(self) -> str: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QBrush: ...
    def mono(self) -> PySide6.QtGui.QColor: ...

class SingleOutPolicy(ColorPolicy):
    policy: ColorPolicy
    index: int
    fallback: PySide6.QtGui.QBrush | PySide6.QtGui.QColor | PySide6.QtCore.Qt.GlobalColor
    def __init__(
        self,
        subpolicy: ColorPolicy,
        index: int,
        fallback: PySide6.QtGui.QBrush | PySide6.QtGui.QColor | PySide6.QtCore.Qt.GlobalColor = ...,
    ) -> None: ...
    def brushForIndex(
        self, index: int, length: int, value: float
    ) -> PySide6.QtGui.QBrush | PySide6.QtGui.QPalette.ColorRole: ...

class RoleListPolicy(ColorPolicy):
    roles: Sequence[PySide6.QtGui.QPalette.ColorRole]
    def __init__(self, roles: Sequence[PySide6.QtGui.QPalette.ColorRole]) -> None: ...
    def __repr__(self) -> str: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QPalette.ColorRole: ...
    def mono(self) -> PySide6.QtGui.QPalette.ColorRole: ...

class RotatingColorPolicy(ColorPolicy):
    base_hue: float
    saturation: float
    lightness: float
    def __init__(self, base_hue: float = ..., saturation: float = ..., lightness: float = ...) -> None: ...
    def __repr__(self) -> str: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QBrush: ...
    def mono(self) -> PySide6.QtGui.QColor: ...

class GradientColorPolicy(ColorPolicy):
    def __init__(self, color1: PySide6.QtGui.QColor, color2: PySide6.QtGui.QColor) -> None: ...
    def __repr__(self) -> str: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QBrush: ...
    def mono(self) -> PySide6.QtGui.QColor: ...

class ValueGradientColorPolicy(GradientColorPolicy):
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QBrush: ...

class MonochromeColorPolicy(ColorPolicy):
    color: PySide6.QtGui.QColor
    def __init__(self, color: PySide6.QtGui.QColor) -> None: ...
    def __repr__(self) -> str: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QBrush: ...
    def mono(self) -> PySide6.QtGui.QColor: ...

class MonochromeRolePolicy(ColorPolicy):
    role: PySide6.QtGui.QPalette.ColorRole
    def __init__(self, role: PySide6.QtGui.QPalette.ColorRole) -> None: ...
    def brushForIndex(self, index: int, length: int, value: float) -> PySide6.QtGui.QPalette.ColorRole: ...
    def mono(self) -> PySide6.QtGui.QPalette.ColorRole: ...

class OverrideColorPolicy(ColorPolicy):
    def __init__(self, policy: ColorPolicy) -> None: ...
    def addOverride(self, index: int, brush: PySide6.QtGui.QBrush) -> None: ...
    def brushForIndex(
        self, index: int, length: int, value: float
    ) -> PySide6.QtGui.QBrush | PySide6.QtGui.QPalette.ColorRole: ...
    def mono(self) -> PySide6.QtGui.QBrush | PySide6.QtGui.QColor | PySide6.QtGui.QPalette.ColorRole: ...

DEFAULT_CHART_COLORS: tuple[str, ...]
DEFAULT_COLOR_POLICY: ColorLookupPolicy

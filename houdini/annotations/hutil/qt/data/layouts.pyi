from collections.abc import Callable, Iterable, Iterator, MutableSequence, Sequence
from typing import TypeAlias, TypeVar

from PySide6 import QtCore, QtWidgets
from PySide6.QtCore import Qt

from .config import _ClassRegistrar

_T = TypeVar("_T")

ItemRectPair: TypeAlias = tuple[QtWidgets.QGraphicsLayoutItem, QtCore.QRectF]

DEFAULT_GRID_SPACING: float
DEFAULT_GRID_COL_WIDTH: float
DEFAULT_GRID_ROW_HEIGHT: float
GOLDEN_RATIO: float
PACKING_TOLERANCE: float
layouttype: _ClassRegistrar

def chunks(items: Sequence[_T], n: int) -> Iterator[Sequence[_T]]: ...
def offsetAndSpacing(justificaiton: Justify, available: float, count: int) -> tuple[float, float] | None: ...
def justify(lengths: Sequence[float], avail_length: float, spacing: float, justification: Justify, stretches: Sequence[int] | None = ...) -> tuple[float, float, Sequence[float]]: ...
def positionItemRects(avail: float, line: Sequence[ItemRectPair], orientation: Qt.Orientation, spacing: float, justification: Justify = ..., alignment: Align = ..., line_scale: float = ..., line_offset: float = ..., start_offset: float = ...) -> None: ...
def stretchRects(avail_rect: QtCore.QRectF, item_rects: Sequence[QtCore.QRectF], halign: Justify, valign: Justify, h_offset: float = ..., v_offset: float = ...) -> None: ...
def cellRects(avail: float, count: int, orientation: Qt.Orientation, minwidth: float, height: float, start_x: float = ..., start_y: float = ..., h_space: float = ..., v_space: float = ..., max_width: float = ...) -> Iterator[QtCore.QRectF]: ...

class Packer:
    def __init__(self, width: float, height: float, key_fn: Callable[[QtCore.QRectF], tuple[float, float]] = ...) -> None: ...
    def placeInSpace(self, rect: QtCore.QRectF, space: QtCore.QRectF) -> None: ...
    def placed(self, rect: QtCore.QRectF) -> None: ...
    def mergeAndSortSpaces(self) -> None: ...
    def addSpace(self, space: QtCore.QRectF) -> None: ...
    @staticmethod
    def maximalFreeRects(this: QtCore.QRectF, rect: QtCore.QRectF) -> list[QtCore.QRectF]: ...
    @staticmethod
    def mergeRects(rects: MutableSequence[QtCore.QRectF]) -> None: ...

class TileGraphicsLayout(QtWidgets.QGraphicsLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None) -> None: ...
    def __del__(self) -> None: ...
    def addItem(self, item: QtWidgets.QGraphicsLayoutItem) -> None: ...
    def iterItems(self) -> Iterator[QtWidgets.QGraphicsLayoutItem]: ...
    def removeItem(self, to_remove: QtWidgets.QGraphicsLayoutItem) -> bool: ...
    def layoutItems(self, geom: QtCore.QRectF) -> Iterable[ItemRectPair]: ...
    def layoutRects(self, geom: QtCore.QRectF) -> Iterable[QtCore.QRectF]: ...
    def sizeHint(self, which: Qt.SizeHint, constraint: QtCore.QSizeF | None = ...) -> QtCore.QSizeF: ...

class OrientedLayout(TileGraphicsLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setOrientation(self, orientation: Qt.Orientation) -> None: ...

class PackedGraphicsLayout(OrientedLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setDensity(self, dense: bool) -> None: ...
    def setHorizontalSpacing(self, hspace: float) -> None: ...
    def setVerticalSpacing(self, vspace: float) -> None: ...
    def setSpacing(self, spacing: float | QtCore.QSizeF) -> None: ...
    def layoutItems(self, geom: QtCore.QRectF) -> Iterator[ItemRectPair]: ...

class PackedGridGraphicsLayout(PackedGraphicsLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setCellSize(self, size: QtCore.QSizeF) -> None: ...
    def setColumnWidth(self, width: float) -> None: ...
    def setRowHeight(self, height: float) -> None: ...
    def setItemPos(self, item: QtWidgets.QGraphicsLayoutItem, pos: QtCore.QPoint) -> None: ...
    def setItemSpans(self, item: QtWidgets.QGraphicsLayoutItem, spans: QtCore.QSize) -> None: ...
    def setItemColumnSpan(self, item: QtWidgets.QGraphicsLayoutItem, span: int) -> None: ...
    def setItemRowSpan(self, item: QtWidgets.QGraphicsLayoutItem, span: int) -> None: ...
    def setStretch(self, stretch: bool) -> None: ...
    def cellPos(self, pos: QtCore.QPoint, cellsize: QtCore.QSizeF | None = ..., maxcols: int = ..., maxrows: int = ...) -> QtCore.QPointF: ...
    def spanSize(self, span: QtCore.QSize, cellsize: QtCore.QSizeF | None = ...) -> QtCore.QSizeF: ...
    def layoutItems(self, geom: QtCore.QRectF) -> Iterator[ItemRectPair]: ...

class FlowGraphicsLayout(OrientedLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setStretchFactor(self, item: QtWidgets.QGraphicsLayoutItem, factor: int) -> None: ...
    def setLineSpacing(self, spacing: float) -> None: ...
    def setItemSpacing(self, spacing: float) -> None: ...
    def setSpacing(self, spacing: float) -> None: ...
    def setItemAlignment(self, align: Align) -> None: ...
    def setJustification(self, justify: Justify) -> None: ...
    def setContentJustification(self, justify: Justify) -> None: ...
    def layoutItems(self, geom: QtCore.QRectF) -> list[ItemRectPair]: ...

class SwitchGraphicsLayout(TileGraphicsLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setStretchFactor(self, item: QtWidgets.QGraphicsLayoutItem, factor: int) -> None: ...
    def setHorizontalSpacing(self, hspace: float) -> None: ...
    def setVerticalSpacing(self, vspace: float) -> None: ...
    def layoutRects(self, geom: QtCore.QRectF) -> list[QtCore.QRectF]: ...

class MatrixGraphicsLayout(TileGraphicsLayout):
    def __init__(self, parent: QtWidgets.QGraphicsLayoutItem | None = ...) -> None: ...
    def setOrientation(self, orient: Qt.Orientation) -> None: ...
    def setHorizontalSpacing(self, hspace: float) -> None: ...

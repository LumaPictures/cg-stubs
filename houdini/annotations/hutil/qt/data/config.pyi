from collections.abc import Callable, Mapping, MutableMapping
from typing import Any, Never, Protocol, TypeVar

_C = TypeVar("_C", bound=type)
_F = TypeVar("_F", bound=Callable[..., object])

class _ClassDecorator(Protocol):
    def __call__(self, cls: _C, /) -> _C: ...

class _ClassRegistrar(Protocol):
    def __call__(self, *names: str) -> _ClassDecorator: ...

# The @settable setters of each class, by property name.
method_lookup_registry: dict[int, dict[str, Callable[..., None]]]

def registrar(registry_dict: MutableMapping[str, type[Any]]) -> _ClassRegistrar: ...
def camelToSnake(camel: str, drop_set: bool = ...) -> str: ...
def snakeToCamel(snake: str, initial: bool = ...) -> str: ...
def settable(*names: str, argtype: type | None = ..., converter: Callable[[Never], object] | None = ..., sequence: bool = ...) -> Callable[[_F], _F]: ...
def getLookup(obj: object) -> dict[str, Callable[..., None]]: ...
def hasSetter(obj: object, key: str) -> bool: ...
def getSetter(obj: object, key: str) -> Callable[..., None]: ...
def setSettable(obj: object, key: str, v: Any, *rest: Any) -> None: ...
def updateSettables(obj: object, update: Mapping[str, object]) -> None: ...

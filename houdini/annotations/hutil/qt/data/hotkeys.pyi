import re
from collections.abc import Collection, Mapping, Sequence
from typing import Self, TypeAlias

import hou
from PySide6 import QtCore, QtGui, QtWidgets

KEY_SPACING: int
KEY_HMARGIN: int
KEY_VMARGIN: int
SMALL_ICON: int
SMALL_ICON_SIZE: QtCore.QSize
MODIFIER_FONT_SCALE: float
BORDER_WIDTH: int
KEY_RADIUS: int
KEY_HEIGHT: int
KEY_WIDTH_LIMIT: int

_SortKey: TypeAlias = int | str | tuple["_SortKey", ...]

hotkey_symbol_expr: re.Pattern[str]
part_sep_expr: re.Pattern[str]
combo_sep_expr: re.Pattern[str]
seq_sep_expr: re.Pattern[str]
hyphen_sep_expr: re.Pattern[str]
drag_expr: re.Pattern[str]

modifier_names: dict[str, Modifier]
modifier_labels: dict[Modifier, str]
modifier_widths: dict[Modifier, int]
action_names: dict[str, DeviceAction]
action_labels: dict[DeviceAction, str]
action_icons: dict[DeviceAction, hou.qt.Icon]
key_forms: dict[str, str]

def ensure(item: str | KeyLike | None) -> KeyLike | None: ...
def parseSplit(string: str, expr: re.Pattern[str], viewer: Mapping[str, Sequence[str]] | None = ...) -> Sequence[KeyLike]: ...
def parse(value: str | Sequence[str] | KeyLike, lookup: Mapping[str, Sequence[str]] | None = ...) -> KeyLike: ...
def removeCommonModifiers(combos: Sequence[KeyLike]) -> tuple[Collection[Modifier], Sequence[KeyLike]]: ...
def clearLayout(layout: QtWidgets.QLayout, start: int = ...) -> None: ...

key_color: QtGui.QColor
border_gradient: QtGui.QLinearGradient
fill_gradient: QtGui.QLinearGradient

def drawKeyBackground(painter: QtGui.QPainter, style: KeyStyle, rect: QtCore.QRect, modifier: bool = ...) -> None: ...

class KeyLike(QtWidgets.QFrame):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def sortKey(self) -> _SortKey: ...
    def isModifier(self, mod: Modifier | None = ...) -> bool: ...

class SingleKey(KeyLike):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setTextSize(self, size: int) -> None: ...
    def isModifier(self, mod: Modifier | None = ...) -> bool: ...

class LabeledKey(SingleKey):
    def __init__(self, text: str | None = ..., parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def sortKey(self) -> tuple[Modifier, str]: ...

class ModifierKey(SingleKey):
    def __init__(self, modifier: Modifier | str, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def sortKey(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def isModifier(self, mod: Modifier | None = ...) -> bool: ...

class InputDeviceAction(SingleKey):
    def __init__(self, action: str | DeviceAction, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class WeirdKey(SingleKey):
    def __init__(self, text: str | None = ..., parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...

class CompoundKey(KeyLike):
    def __init__(self, subkeys: Sequence[KeyLike], parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def sortKey(self) -> tuple[_SortKey, ...]: ...
    def setTextSize(self, size: int) -> None: ...
    def setKeys(self, subkeys: Sequence[KeyLike]) -> None: ...
    def isModifier(self, mod: Modifier | None = ...) -> bool: ...

class KeyCombo(CompoundKey):
    def __init__(self, subkeys: Sequence[KeyLike], parent: QtWidgets.QWidget | None = ...) -> None: ...
    def sortKey(self) -> tuple[int, str]: ...
    @classmethod
    def modifying(cls, key: KeyLike, modifiers: Collection[Modifier], parent: QtWidgets.QWidget | None = ...) -> Self: ...
    def copy(self) -> Self: ...
    def withoutModifiers(self, mods: Collection[Modifier]) -> KeyLike: ...

class Motion(QtWidgets.QLabel):
    def __init__(self, text: str | None = ..., parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def setTextSize(self, size: int) -> None: ...

class KeyMotion(CompoundKey):
    def __init__(self, instr: str, key: str | KeyLike, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def motion(self) -> Motion: ...
    def setTextSize(self, size: int) -> None: ...
    def setKeys(self, subkeys: Sequence[KeyLike]) -> None: ...

class KeyRange(CompoundKey):
    def __init__(self, startkey: KeyLike, endkey: KeyLike, parent: QtWidgets.QWidget | None = ...) -> None: ...

class Alternates(CompoundKey):
    def __init__(self, subkeys: Sequence[KeyLike], parent: QtWidgets.QWidget | None = ...) -> None: ...
    @classmethod
    def make(cls, subkeys: Sequence[KeyLike]) -> KeyLike: ...
    def setKeys(self, subkeys: Sequence[KeyLike]) -> None: ...

class TestWindow(QtWidgets.QDialog):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...

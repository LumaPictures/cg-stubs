from collections.abc import Callable, Sequence
from datetime import datetime
from typing import Any, Generic, TypeAlias, TypeVar

from PySide6 import QtCore, QtGui, QtWidgets
from PySide6.QtCore import Qt

from houtypes import JSONValue

from . import charts, formatting, styling

_F = TypeVar("_F", bound=Callable[..., Any])
_In = TypeVar("_In")
_Out = TypeVar("_Out")

_ColorData: TypeAlias = str | list[float] | tuple[float, ...]

converter_registry: dict[int, Callable[[Any], Any]]
color_roles: dict[str, QtGui.QPalette.ColorRole]
alignment_names: dict[str, Qt.AlignmentFlag]

def converter(to_type: type) -> Callable[[_F], _F]: ...

class SequenceConverter(Generic[_In, _Out]):
    converter: Callable[[_In], _Out]
    def __init__(self, converter: Callable[[_In], _Out]) -> None: ...
    def __call__(self, seq: Sequence[_In]) -> list[_Out]: ...

def brushConverter(brush: _ColorData) -> QtGui.QBrush | QtGui.QLinearGradient: ...
def colorConverter(color: _ColorData | None) -> QtGui.QColor | Qt.GlobalColor | None: ...
def pointConverter(point: QtCore.QPoint | tuple[int, int] | list[int]) -> QtCore.QPoint: ...
def elideModeConverter(mode: str | bool | Qt.TextElideMode) -> Qt.TextElideMode | str: ...
def colorPolicyConverter(policy: styling.ColorPolicy | _ColorData | Sequence[_ColorData]) -> styling.ColorPolicy: ...
def colorRoleConverter(role: QtGui.QPalette.ColorRole | str) -> QtGui.QPalette.ColorRole | None: ...
def numberTierConverter(tiers: str | Sequence[tuple[int, str]] | None) -> Sequence[tuple[int, str]] | str: ...
def chartConverter(chart: str | dict[str, JSONValue] | charts.Chart) -> charts.Chart: ...
def edgeConverter(edge: Qt.Edge | str) -> Qt.Edge | str: ...
def alignmentConverter(align: Qt.AlignmentFlag | str) -> Qt.AlignmentFlag: ...
def marginsConverter(m: int | list[int] | tuple[int, ...] | QtCore.QMargins) -> QtCore.QMargins: ...
def marginsFConverter(m: int | list[float] | tuple[float, ...] | QtCore.QMarginsF) -> QtCore.QMarginsF: ...
def formatConverter(fmt: str | dict[str, JSONValue] | formatting.NumberFormatter) -> formatting.NumberFormatter: ...
def fontWeightConverter(weight: str | int | QtGui.QFont.Weight) -> QtGui.QFont.Weight | int: ...
def graphicsLayoutConverter(layout: str | dict[str, JSONValue] | QtWidgets.QGraphicsLayout) -> QtWidgets.QGraphicsLayout | None: ...

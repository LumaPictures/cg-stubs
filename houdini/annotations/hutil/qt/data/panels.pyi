# The template and update dictionaries of hou.SceneViewer.hudInfo, as documented in
# $HFS/houdini/help/hom/hud_info.txt, with the keys the rows also read.
_HudRowType: TypeAlias = Literal["plain", "divider", "group", "bargraph", "choicegraph"]
# A row's value: shown as text in a plain row, a 0-1 fraction in a bargraph, an index in a
# choicegraph, the shown sub-row's index or id in a group.
_HudValue: TypeAlias = str | int | float | None
# Any value a row's set() takes, depending on the key.
_HudFieldValue: TypeAlias = _HudValue | bool | PySide6.QtGui.QColor

class _HudRow(TypedDict, total=False):
    id: str
    type: _HudRowType
    visible: bool
    label: str
    value: _HudValue
    key: str | Sequence[str]
    wide: bool
    elided: bool
    needs_key: bool
    count: int
    current: int | str | None
    fill_color: PySide6.QtGui.QColor
    track_color: PySide6.QtGui.QColor
    rows: Sequence[_HudRow]

class _HudTemplate(TypedDict, total=False):
    title: str
    desc: str
    icon: str
    rows: Sequence[_HudRow]

class _HudRowUpdate(TypedDict, total=False):
    value: _HudValue
    visible: bool
    current: int | str | None
    label: str
    fill_color: PySide6.QtGui.QColor
    track_color: PySide6.QtGui.QColor

# Row ids to a new value or to the keys to update; `"<id>__<key>"` sets one key.
_HudUpdates: TypeAlias = Mapping[str, _HudFieldValue | _HudRowUpdate]

MIN_HINT: str
UNMIN_HINT: str
TITLE_PARM_NAME: str
ICON_PARM_NAME: str
KEY_SIZES: list[int]
LABEL_SIZES: list[int]
DIVIDER_SIZES: list[int]
VALUE_SIZES: list[int]
TITLE_SIZES: list[int]
ICON_SIZES: list[int]
PANEL_WIDTH: list[int]
VALUES_WIDTH: list[int]
GRID_SPACING: list[int]

def clear_layout(layout: PySide6.QtWidgets.QLayout) -> None: ...


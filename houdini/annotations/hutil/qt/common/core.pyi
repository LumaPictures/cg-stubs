from collections.abc import Iterator, Mapping, MutableMapping, Sequence
from typing import Any, TypeAlias, TypeVar

import hou
from PySide6 import QtCore

_MC = TypeVar("_MC", bound=type)
# hou.NodeInfoTree as nested dicts: a branch's data by its key, a property's value, or a
# table's rows as dicts keyed by column heading.
_InfoTreeDict: TypeAlias = dict[str, "_InfoTreeDict | list[dict[str, str]] | str"]

type_lookup: dict[str, type]

def keyify(s: str, lower: bool = ...) -> str: ...
def all_same_info_type(*seqs: Sequence[object]) -> bool: ...
def infoTreeToData(tree: hou.NodeInfoTree, keyify_properties: bool = ..., allow_branches: bool = ..., force_dict: bool = ...) -> _InfoTreeDict | list[dict[str, str]]: ...
def findInfoRow(tree: hou.NodeInfoTree, key: str) -> str | None: ...
def findAttr(base: object, dotted_path: str) -> Any: ...
def annoToType(ftype: str) -> str | type: ...

class CoreProperty(QtCore.Property): ...

class ConstantsMetaclass(type):
    def __new__(mcls: type[_MC], name: str, bases: tuple[type, ...], ns: dict[str, Any], **kw: object) -> _MC: ...

class Constants(QtCore.QObject): ...

class InfoMetaclass(type):
    def __new__(mcls: type[_MC], name: str, bases: tuple[type, ...], ns: dict[str, Any], **kw: object) -> _MC: ...

class Info(QtCore.QObject):
    def __init__(self, **kwargs: object) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def __setattr__(self, key: str, value: object) -> None: ...

def propertyType(info: Info | type[Info], name: str) -> type | str: ...
def fieldNames(info: Info | type[Info]) -> Iterator[str]: ...
def ownFieldNames(info: Info | type[Info]) -> Iterator[str]: ...
def fieldNamesForEq(info: Info | type[Info]) -> Iterator[str]: ...
def dumpDiff(base: IT, other: IT) -> None: ...
def update(base: IT, other: IT) -> None: ...
def setOrUpdate(obj: object, name: str, other: IT | None) -> None: ...
def makeProperty(ns: MutableMapping[str, object], name: str, ftype: str | type, readonly: bool = ...) -> None: ...
def infoToDict(info: Info) -> dict[str, Any]: ...
def invertedDict(d: Mapping[K, V]) -> dict[V, K]: ...

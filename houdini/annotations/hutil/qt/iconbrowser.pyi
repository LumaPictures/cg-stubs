from typing import ClassVar

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

SMALL_ICON_SIZE: int
MEDIUM_ICON_SIZE: int
TINY_MARGIN: int
SMALL_MARGIN: int
BIG_MARGIN: int
GRID_SPACING: int
INITIAL_ICON_SIZE: int
MIN_ICON_SIZE: int
MAX_ICON_SIZE: int
TOOLBAR_BUTTON_SIZE: PySide6.QtCore.QSize

class ClickSliderStyle(PySide6.QtWidgets.QProxyStyle):
    def styleHint(
        self,
        hint: PySide6.QtWidgets.QStyle.StyleHint,
        option: PySide6.QtWidgets.QStyleOption | None,
        widget: PySide6.QtWidgets.QWidget | None,
        returndata: PySide6.QtWidgets.QStyleHintReturn | None,
    ) -> int | PySide6.QtCore.Qt.MouseButton: ...

class IconModel(PySide6.QtCore.QAbstractListModel):
    ItemRole: ClassVar[int]
    def __init__(self, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def setIconExtent(self, extent: int) -> None: ...
    def rowCount(
        self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...
    ) -> int: ...
    def flags(
        self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex
    ) -> PySide6.QtCore.Qt.ItemFlag: ...
    def data(
        self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...
    ) -> IconItem | str | PySide6.QtGui.QPixmap | None: ...

class IconItem:
    def __init__(self, name: str) -> None: ...
    def name(self) -> str: ...
    def pixmap(self, extent: int) -> PySide6.QtGui.QPixmap: ...

class SizeSlider(PySide6.QtWidgets.QFrame):
    sizeSteps: ClassVar[tuple[int, ...]]
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def value(self) -> int: ...
    def setValue(self, value: int) -> None: ...
    def slider(self) -> PySide6.QtWidgets.QSlider: ...
    def smallerButton(self) -> PySide6.QtWidgets.QPushButton: ...
    def biggerButton(self) -> PySide6.QtWidgets.QPushButton: ...
    def stepSmaller(self) -> None: ...
    def stepBigger(self) -> None: ...

class IconChooserDialog(PySide6.QtWidgets.QDialog):
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def name(self) -> str: ...
    def setName(self, name: str) -> None: ...
    def setFilter(self, text: str) -> None: ...
    def setIconSize(self, extent: int) -> None: ...

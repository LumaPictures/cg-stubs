from collections.abc import Iterable

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

TINY_MARGIN: int
SMALL_MARGIN: int
BIG_MARGIN: int
DEFAULT_DECO_WIDTH: int
ICON_SIZE: int
WARNING_PIXMAP: PySide6.QtGui.QPixmap
ERROR_PIXMAP: PySide6.QtGui.QPixmap

class Gutter(PySide6.QtWidgets.QFrame):
    def __init__(self, editor: CodeEditor) -> None: ...
    def updateContents(self, rect: PySide6.QtCore.QRect, y: int) -> None: ...
    def paintEvent(self, event: PySide6.QtGui.QPaintEvent) -> None: ...

class Decoration:
    def width(self) -> int: ...
    def pixmapForLine(self, num: int) -> PySide6.QtGui.QPixmap | None: ...

class ErrorDecoration(Decoration):
    def __init__(self) -> None: ...
    def clear(self) -> None: ...
    def setWarningLines(self, nums: Iterable[int]) -> None: ...
    def setErrorLines(self, nums: Iterable[int]) -> None: ...
    def addWarning(self, num: int) -> None: ...
    def addError(self, num: int) -> None: ...
    def removeWarning(self, num: int) -> None: ...
    def removeError(self, num: int) -> None: ...
    def pixmapForLine(self, num: int) -> PySide6.QtGui.QPixmap | None: ...

class CodeEditor(PySide6.QtWidgets.QPlainTextEdit):
    indent_after_chars: str
    dedent_after_chars: str
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def decorations(self) -> list[Decoration]: ...
    def addDecoration(self, deco: Decoration) -> None: ...
    def resizeEvent(self, event: PySide6.QtGui.QResizeEvent) -> None: ...
    def updateGutterWidth(self) -> None: ...
    def gutterWidth(self) -> int: ...
    def lineNumberWidth(self) -> int: ...
    def isGutterVisible(self) -> bool: ...
    def setGutterVisible(self, show: bool) -> None: ...
    def showGutter(self) -> None: ...
    def hideGutter(self) -> None: ...
    def insertTabSpaces(self, cursor: PySide6.QtGui.QTextCursor | None = ...) -> None: ...
    def smartBackspace(self, cursor: PySide6.QtGui.QTextCursor | None = ...) -> None: ...
    def dedent(self, cursor: PySide6.QtGui.QTextCursor | None = ...) -> bool: ...
    def dedentIfOnly(self, text: str, cursor: PySide6.QtGui.QTextCursor | None = ...) -> None: ...
    def autoIndentNewLine(self, cursor: PySide6.QtGui.QTextCursor | None = ...) -> None: ...
    def duplicateLine(self) -> None: ...
    def deleteLine(self) -> None: ...
    def keyPressEvent(self, event: PySide6.QtGui.QKeyEvent) -> None: ...
    def event(self, event: PySide6.QtCore.QEvent) -> bool: ...
    def helpForCursor(self, cursor: PySide6.QtGui.QTextCursor) -> str | None: ...
    def helpForWord(self, word: str) -> str | None: ...

class SimpleTextEditorDialog(PySide6.QtWidgets.QDialog):
    def __init__(
        self,
        text: str = ...,
        parent: PySide6.QtWidgets.QWidget | None = ...,
        margins: PySide6.QtCore.QMargins | None = ...,
    ) -> None: ...
    @classmethod
    def editText(cls, text: str) -> str | None: ...
    def __del__(self) -> None: ...
    def setTopMessage(self, text: str) -> None: ...
    def setBottomMessage(self, text: str) -> None: ...
    def editor(self) -> PySide6.QtWidgets.QPlainTextEdit: ...
    def text(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def setFontFamily(self, family_name: str) -> None: ...
    def setSyntaxHighlighter(
        self, hiliter: PySide6.QtGui.QSyntaxHighlighter | type[PySide6.QtGui.QSyntaxHighlighter]
    ) -> None: ...
    def openAndWait(self) -> str | None: ...

    def tree(self) -> hou.NodeInfoTree: ...
    def name(self) -> str: ...
    def isRoot(self) -> bool: ...
    def infoType(self) -> str: ...
    def childCount(self) -> int: ...
    def branchPath(self) -> tuple[str, ...]: ...
    def parentFolder(self) -> Folder | None: ...
    def childAt(self, i: int) -> Folder | None: ...
    def childForName(self, name: str) -> Folder: ...
    def childNameIndex(self, name: str) -> int: ...
    def row(self) -> int | None: ...

class ImplicitRoot(Folder):
    def __init__(self, children: Sequence[hou.NodeInfoTree]) -> None: ...
    def name(self) -> str: ...
    def icon(self) -> PySide6.QtGui.QIcon: ...
    def infoType(self) -> str: ...
    def __repr__(self) -> str: ...


from pxr import Sdf, Usd
from PySide6 import QtCore

class PrimNode:
    stage: Usd.Stage
    path: str
    def __init__(self, stage: Usd.Stage, parent: PrimNode | VRoot, path: str | Sdf.Path, prim: Usd.Prim | None = ..., row: int = ...) -> None: ...
    def __repr__(self) -> str: ...
    def parent(self) -> PrimNode | VRoot | None: ...
    @property
    def prim(self) -> Usd.Prim: ...
    @property
    def name(self) -> str: ...
    def rowCount(self) -> int: ...
    @property
    def childNames(self) -> list[str]: ...
    @property
    def children(self) -> list[PrimNode]: ...
    def childAt(self, row: int) -> PrimNode | None: ...
    @property
    def row(self) -> int: ...

class VRoot:
    prim: None
    name: None
    children: tuple[PrimNode]
    row: int
    def __init__(self, stage: Usd.Stage, path: str, prim: Usd.Prim | None = ...) -> None: ...
    def __repr__(self) -> str: ...
    def parent(self) -> None: ...
    def rowCount(self) -> int: ...
    def childAt(self, row: int) -> PrimNode | None: ...

class PrimTreeModel:
    PrimRole: int
    PathRole: int
    TypeNameRole: int
    KindNameRole: int
    ChildCountRole: int
    SchemasRole: int
    IsActiveRole: int
    HasAuthoredActiveRole: int
    LoadedRole: int
    section_labels: tuple[str, str, str, str]
    def __init__(self, stage: Usd.Stage | None = ..., parent: QtCore.QObject | None = ...) -> None: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def setStage(self, stage: Usd.Stage) -> None: ...
    def columnCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def index(self, row: int, column: int, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> QtCore.QModelIndex: ...
    def parent(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> QtCore.QModelIndex: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> QtCore.Qt.ItemFlag: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int = ...) -> str | None: ...
    def data(
        self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = ...
    ) -> str | int | bool | Usd.Prim | list[str] | None: ...
    def usda(self) -> str: ...

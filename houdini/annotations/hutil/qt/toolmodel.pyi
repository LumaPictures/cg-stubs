APP_VERSION: tuple[int, int]
# config/since.json.gz: the Houdini version each node type appeared in, by node type table
# and name.
class _SinceData(TypedDict, total=False, extra_items=JSONValue):  # type: ignore[call-arg]
    nodes: dict[str, dict[str, str]]

SINCE_DATA: _SinceData
DEFAULT_GROUP_ICON: str
split_slashes: re.Pattern[str]
category_icons: dict[str, str]

def naturalSortKey(s: str) -> tuple[str | int, ...]: ...
def sinceData() -> _SinceData: ...
def toolToNodeType(tool: hou.Tool) -> hou.NodeType | None: ...
def toolIsNew(tool: hou.Tool, baseline: tuple[int, ...] = ...) -> bool: ...
def groupPaths(tool: hou.Tool) -> list[list[str]]: ...

class ToolListModel(QtCore.QAbstractListModel):
    NameRole: int
    IconNameRole: int
    KeywordsRole: int
    GroupsRole: int
    IsNewRole: int
    IsFavoriteRole: int
    IsUncategorizedRole: int
    SortKeyRole: int
    HelpURLRole: int
    SummaryRole: int
    def __init__(self, *, parent: QtCore.QObject | None = ...) -> None: ...
    def roleNames(self, /) -> dict[int, bytes]: ...
    def setTools(self, tools: Sequence[hou.Tool]) -> None: ...
    def rowCount(self, /, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> Qt.ItemFlag: ...
    def data(
        self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, /, role: int = ...
    ) -> str | QtGui.QIcon | tuple[str, ...] | bool | tuple[str | int, ...] | WikiPath | None: ...

class Group(core.Info):
    index: int
    label: str
    pathString: str
    subGroups: list[Group]
    groupDict: dict[str, Group]
    iconName: str
    toolCount: int
    childCount: int
    def __init__(self, label: str, **kwargs: object) -> None: ...
    def append(self, tool: hou.Tool) -> None: ...
    def finish(self, parent: Group | None, index: int) -> None: ...
    def childAt(self, index: int) -> Group: ...
    def childIndex(self, group: Group) -> int: ...

class GroupTreeModel(QtCore.QAbstractItemModel):
    ItemRole: int
    IconNameRole: int
    PathRole: int
    ToolCountRole: int
    ChildCountRole: int
    def __init__(self, *, parent: QtCore.QObject | None = ...) -> None: ...
    def roleNames(self, /) -> dict[int, bytes]: ...
    def setTools(self, tools: Sequence[hou.Tool]) -> None: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def columnCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def rootGroups(self) -> list[Group]: ...
    def rootGroupAt(self, index: int) -> Group | None: ...
    def index(
        self, row: int, column: int, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...
    ) -> QtCore.QModelIndex: ...
    def parent(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> QtCore.QModelIndex: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> Qt.ItemFlag: ...
    def data(
        self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, /, role: int = ...
    ) -> Group | str | QtGui.QIcon | int | None: ...

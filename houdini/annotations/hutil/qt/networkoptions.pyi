from collections.abc import Collection

import hou
import PySide6.QtCore
import PySide6.QtGui
from hutil.qt.common import qmlviews
from hutil.qt.prefs.mainprefs import PrefsState

current_page: str | None
known_badges: Collection[str]
known_texts: Collection[str]

class NetworkOptionsState(PrefsState):
    ringZoom: float
    maxRingZoom: float
    hdkBadges: list[dict[str, str]]
    hdkTexts: list[dict[str, str]]
    wirestyles: list[str]
    wirestylesCurrent: str
    nodecolors: list[str]
    nodecolorsCurrent: str
    nodeshapes: list[str]
    nodeshapesCurrent: str
    dismissKeys: tuple[str, ...]
    helpPath: str
    TAB_CONFIG_KEY: str
    def __init__(self, editor: hou.NetworkEditor | None = ..., autoApply: bool = ..., **kwargs: object) -> None: ...
    def networkEditor(self) -> hou.NetworkEditor | None: ...
    def setNetworkEditor(self, editor: hou.NetworkEditor) -> None: ...
    def updateFromPrefs(self) -> None: ...
    def useCurrentRingZoom(self) -> None: ...
    def setRingZoom(self, scale: float) -> None: ...
    def setCurrentTheme(self, ext: str, name: str) -> None: ...
    def duplicateCurrentTheme(self, ext: str) -> None: ...
    def deleteCurrentTheme(self, ext: str) -> None: ...

class NetworkDisplayOptsView(qmlviews.BaseQmlView[NetworkOptionsState]):
    SOURCE_URL: str
    MIN_SIZE: PySide6.QtCore.QSize
    DEFAULT_SIZE: PySide6.QtCore.QSize
    def __init__(self, editor: hou.NetworkEditor, *, top_opts: bool = ..., parent_window: PySide6.QtGui.QWindow | None = ...) -> None: ...
    def hideEvent(self, event: PySide6.QtGui.QHideEvent) -> None: ...
    def closeEvent(self, event: PySide6.QtGui.QCloseEvent) -> None: ...
    def setNetworkEditor(self, editor: hou.NetworkEditor) -> None: ...
    def updateFromPrefs(self) -> None: ...
    def display(self) -> None: ...
    def showPdgOptions(self) -> None: ...

display_options: NetworkDisplayOptsView | None

def windowVisible() -> bool: ...
def closeWindow() -> None: ...
def showDisplayOptionsWindow(editor: hou.NetworkEditor) -> None: ...
def toggleDisplayOptionsWindow(editor: hou.NetworkEditor) -> None: ...
def showTaskGraphDisplayOptions(editor: hou.NetworkEditor) -> None: ...

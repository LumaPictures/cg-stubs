import pathlib
from collections.abc import Iterable, Iterator
from typing import ClassVar

import hou
from PySide6 import QtCore, QtGui

from hutil.qt.common import config, core, qmlviews

NEW_UI: bool
FORCE_WELCOME: bool
FORCE_START: bool
FORCE_NONE: bool
NO_TELEMETRY: bool

def has_ending(string: str, endings: Iterable[str]) -> bool: ...
def parent_dirname(path: pathlib.Path) -> str: ...
def shouldShowStartWindow() -> bool: ...
def showWelcome() -> bool: ...
def recentFilePaths() -> list[tuple[pathlib.Path, bool]]: ...
def loadTemplate(path_str: str, desktop_name: str = ..., node_path: str = ...) -> None: ...

class Link(core.Info):
    text: str
    value: str
    iconName: str
    thumbnail: str
    description: str
    external: bool
    heading: bool
    desktop: str
    currentNode: str
    iconAccent: str

def readLinksFile(path: str) -> list[Link]: ...

class StartupState(qmlviews.SharedState[config.BaseConfig]):
    running: bool
    welcomeMode: bool
    finishedWelcome: bool
    startWindowAllowed: bool
    themeName: str
    majorVersion: str
    minorVersion: str
    buildVersion: str
    shortVersion: str
    billboardUrl: QtCore.QUrl
    recentFiles: list[Link]
    templates: list[Link]
    tutorials: list[Link]
    noTelemetry: bool
    globalScale: float
    selectionMade: ClassVar[QtCore.Signal]
    def __init__(self, **kwargs: object) -> None: ...
    def finish(self) -> None: ...
    def setGlobalScale(self, scale: float) -> None: ...
    def setThemeByID(self, unique_id: str) -> None: ...
    def themePrimary(self, theme_name: str) -> QtGui.QColor: ...
    def themeHighlight(self, theme_name: str) -> QtGui.QColor: ...
    def setStartWindowAllowed(self, allowed: bool) -> None: ...
    def getPref(self, name: str, registry: str = ...) -> str: ...
    def setPref(self, name: str, value: str, registry: str = ...) -> None: ...
    def newFile(self) -> None: ...
    def openFile(self) -> None: ...
    def loadPath(self, path: str) -> None: ...
    def loadTemplate(self, obj: Link) -> None: ...

def setCurrentNode(node_path: str) -> None: ...

class StartupWindow(qmlviews.BaseQmlView[StartupState]):
    SOURCE_URL: str
    DEFAULT_SIZE: QtCore.QSize
    MINIMUM_SIZE: QtCore.QSize
    def __init__(self, *, parent_window: QtGui.QWindow | None = ...) -> None: ...
    def closeEvent(self, event: QtGui.QCloseEvent) -> None: ...

start_window: StartupWindow | None

def maybeShowStartWindow() -> None: ...
def openStartWindow() -> None: ...

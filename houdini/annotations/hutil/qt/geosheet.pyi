from collections.abc import Generator, Iterator, Sequence
from typing import Any, ClassVar, NamedTuple, Self, TypeAlias

import PySide6.QtCore
import PySide6.QtGui

import hou
from hutil.qt.common import config, core, qmlviews

_SortValue: TypeAlias = float | str | tuple[str, ...]
# What AttribTableModel gives for its attribute-describing roles (name, type, size, stats, ...).
_AttribRoleValue: TypeAlias = "AttribProxy | str | int | bool | _SortValue | set[str] | None"

DEBUG_QML: bool
IDENTITY4: list[list[int]]
IDENTITY3: list[list[int]]
NULL4: list[list[int]]
NULL3: list[list[int]]
NODE_EVENTS: tuple[hou.EnumValue[hou.nodeEventType], hou.EnumValue[hou.nodeEventType], hou.EnumValue[hou.nodeEventType], hou.EnumValue[hou.nodeEventType], hou.EnumValue[hou.nodeEventType]]
suffixes: dict[str, str]
attrib_types: list[hou.EnumValue[hou.attribType]]
data_types: list[hou.EnumValue[hou.attribData]]
numeric_types: list[hou.EnumValue[hou.numericData]]

class AttribProxy:
    name: str
    type: hou.EnumValue[hou.attribType]
    dataID: hou.AttribDataId | tuple[hou.AttribDataId, ...] | tuple[int, ...]
    dataType: hou.EnumValue[hou.attribData] | None
    dataTypeDesc: str
    num: int
    size: int
    isArray: bool
    numericDataType: hou.EnumValue[hou.numericData] | None
    qualifier: str
    qualifierBrief: str
    component: int
    suffix: str
    split: bool
    intrinsic: bool
    groups: bool
    @classmethod
    def forAttrib(cls, num: int, attr: hou.Attrib, component: int = ..., split: bool = ...) -> Self: ...
    @property
    def fullName(self) -> str: ...
    @property
    def dataTypeInt(self) -> int: ...
    @property
    def numericTypeInt(self) -> int: ...
    @property
    def isNumeric(self) -> bool: ...
    @property
    def isMatrix(self) -> bool: ...

class Matrix(core.Info):
    values: list[float]
    size: int
    rows: list[list[float]]
    translate: tuple[float, float, float]
    rotate: tuple[float, float, float]
    scale: tuple[float, float, float]
    isIdentity: bool
    isNull: bool
    decomposed: bool
    @classmethod
    def fromFloats(
        cls,
        values: Sequence[float],
        decompose: bool = ...,
        xord: str = ...,
        rord: str = ...,
        pivot: Sequence[float] | hou.Vector3 = ...,
        pivot_rot: Sequence[float] | hou.Vector3 = ...,
    ) -> Self: ...

ObjectRole: PySide6.QtCore.Qt.ItemDataRole
NumberRole: int
VectorRole: int
MatrixRole: int
NameRole: int
FullNameRole: int
TypeRole: int
DataTypeRole: int
DataTypeDescRole: int
AttribNumRole: int
NumericDataTypeRole: int
IsArrayRole: int
SizeRole: int
QualifierRole: int
BriefQualifierRole: int
ComponentRole: int
ElementNumRole: int
SortableRole: int
SuffixRole: int
IsIntrinsicRole: int
PrimIntrinsicsRole: int
GeoSelectionRole: int
MinimumRole: int
MaximumRole: int
StringSetRole: int
role_names: dict[int, bytes]
name_roles: dict[str, int]

class ColStats(NamedTuple):
    minimum: _SortValue
    maximum: _SortValue
    strings: set[str] | None
    @classmethod
    def fromSortedValues(cls, values: Sequence[_SortValue], reverse: bool) -> Self: ...

class AttribTableModel(PySide6.QtCore.QAbstractTableModel):
    typeChanged: ClassVar[PySide6.QtCore.Signal]
    countChanged: ClassVar[PySide6.QtCore.Signal]
    outputChanged: ClassVar[PySide6.QtCore.Signal]
    sortingChanged: ClassVar[PySide6.QtCore.Signal]
    sorting: PySide6.QtCore.Property
    def __init__(self, config: GeoSheetConfig, *, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def config(self) -> GeoSheetConfig: ...
    def setSorting(self, sorting: bool) -> None: ...
    def isSorting(self) -> bool: ...
    def reloadAttrs(self) -> None: ...
    def count(self) -> int: ...
    def rowCount(
        self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...
    ) -> int: ...
    def columnCount(
        self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...
    ) -> int: ...
    def setGeometry(self, geometry: hou.Geometry | None = ...) -> None: ...
    def attribTypeInt(self) -> int: ...
    def setAttribType(self, t: int | hou.EnumValue[hou.attribType]) -> None: ...
    def maybeReload(self) -> None: ...
    def updateAttrs(self) -> None: ...
    def node(self) -> hou.SopNode | None: ...
    def setNode(self, node: hou.SopNode, output: int = ...) -> None: ...
    def outputIndex(self) -> int: ...
    def setOutputIndex(self, output: int) -> None: ...
    def qualifierAt(self, col: int) -> str: ...
    def selectionType(self) -> hou.EnumValue[hou.geometryType] | None: ...
    def selectedCount(self) -> int: ...
    def inGeoSelection(self, index: int) -> bool: ...
    def stats(self, column: int) -> ColStats | None: ...
    def headerData(
        self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int = ...
    ) -> _AttribRoleValue: ...
    def allNumbers(self, name: str) -> tuple[float, ...]: ...
    def allStrings(self, name: str) -> tuple[str, ...]: ...
    def columnChanged(self, column: int) -> None: ...
    def allChanged(self) -> None: ...
    def flags(
        self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex
    ) -> PySide6.QtCore.Qt.ItemFlag: ...
    def proxies(self) -> Iterator[AttribProxy]: ...
    def nameRoles(self) -> dict[str, int]: ...
    def dataString(self, column: int, role: str) -> str: ...
    def data(
        self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...
    ) -> (
        _AttribRoleValue
        | hou.AttribReturnType
        | list[float]
        | Matrix
        | PySide6.QtGui.QColor
        | dict[str, hou.AttribReturnType | hou._OptionDict]
        | AttribTableModel
    ): ...
    def setData(
        self,
        index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex,
        value: object,
        role: int = ...,
    ) -> bool: ...
    def glob(self, pattern: str) -> Generator[int, None, None] | tuple[()]: ...
    def sortBy(self, column: int, reverse: bool) -> None: ...
    def groupMemberships(self) -> list[tuple[str, ...]]: ...
    def sortedValues(self, proxy: AttribProxy, reverse: bool) -> list[tuple[_SortValue, int]]: ...
    def sort(self, column: int, order: PySide6.QtCore.Qt.SortOrder = ...) -> None: ...


import pathlib
import re
from collections.abc import Callable
from typing import ClassVar, TypeAlias

from PySide6 import QtCore, QtGui

from hutil.qt.common import config, qmlviews
from hutil.qt.pluto import colors, themes
from hutil.qt.prefs import changes

HFS_DIR: pathlib.Path
CONTRAST_PREF: str
DUMMY_THEME: colors.Theme
copy_expr: re.Pattern[str]

CallbackType: TypeAlias = Callable[[colors.Theme, str, bool], None]

class ThemeConfig(config.BaseConfig):
    showPreview: bool
    startTab: str

class ThemeChange(changes.Change[ThemeEditorState]): ...

class NameChange(ThemeChange):
    old_name: str
    new_name: str
    def __init__(self, old_name: str, new_name: str) -> None: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class MetadataChange(ThemeChange):
    unique_id: str
    old_md: themes.Metadata
    new_md: themes.Metadata
    def __init__(self, unique_id: str, old_md: themes.Metadata, new_md: themes.Metadata) -> None: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class ThemeEdit(ThemeChange):
    unique_id: str
    old_theme: colors.Theme
    new_theme: colors.Theme
    def __init__(self, unique_id: str, old_theme: colors.Theme, new_theme: colors.Theme) -> None: ...
    def __repr__(self) -> str: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...
    def canUpdateFrom(self, other: changes.Change[ThemeEditorState], continuous: bool = ...) -> bool: ...
    def updateFrom(self, other: ThemeEdit) -> None: ...

class ThemeSwitch(ThemeChange):
    old_id: str
    old_theme: colors.Theme
    new_id: str
    new_theme: colors.Theme
    def __init__(self, old_id: str, old_theme: colors.Theme, new_id: str, new_theme: colors.Theme) -> None: ...
    def __repr__(self) -> str: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class ThemeAddition(ThemeChange):
    selected_id: str
    metadata: themes.Metadata
    def __init__(self, selected_id: str, metadata: themes.Metadata) -> None: ...
    def __repr__(self) -> str: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class ThemeDeletion(ThemeChange):
    metadata: themes.Metadata
    next_id: str
    def __init__(self, metadata: themes.Metadata, next_id: str = ...) -> None: ...
    def __repr__(self) -> str: ...
    def canUpdateFrom(self, other: changes.Change[ThemeEditorState], continuous: bool = ...) -> bool: ...
    def updateFrom(self, other: ThemeSwitch) -> None: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class GlobalContrastChange(ThemeChange):
    old_value: float
    new_value: float
    def __init__(self, old_value: float, new_value: float) -> None: ...
    def __repr__(self) -> str: ...
    def canUpdateFrom(self, other: changes.Change[ThemeEditorState], continuous: bool = ...) -> bool: ...
    def updateFrom(self, other: GlobalContrastChange) -> None: ...
    def undo(self, state: ThemeEditorState) -> None: ...
    def redo(self, state: ThemeEditorState) -> None: ...

class ThemeEditorState(qmlviews.SharedState[ThemeConfig]):
    currentTab: str
    globalContrast: float
    manager: themes.ThemeManager
    metadatas: themes.MetadataModel
    currentMetadata: themes.Metadata
    continuous: bool
    helpPath: str
    editingChanged: ClassVar[QtCore.Signal]
    canUndoChanged: ClassVar[QtCore.Signal]
    canRedoChanged: ClassVar[QtCore.Signal]
    currentAboutToChange: ClassVar[QtCore.Signal]
    currentChanged: ClassVar[QtCore.Signal]
    themeLoaded: ClassVar[QtCore.Signal]
    themeSaved: ClassVar[QtCore.Signal]
    themeEdited: ClassVar[QtCore.Signal]
    accepted: ClassVar[QtCore.Signal]
    rejected: ClassVar[QtCore.Signal]
    finished: ClassVar[QtCore.Signal]
    editedChanged: ClassVar[QtCore.Signal]
    reselectRequested: ClassVar[QtCore.Signal]
    def __init__(self, **kwargs: object) -> None: ...
    def setCallback(self, callback: CallbackType | None) -> None: ...
    def setTheme(self, theme: colors.Theme, unique_id: str) -> None: ...
    def pushUndo(self, change: ThemeChange) -> None: ...
    def setGlobalContrast(self, contrast: float, record: bool = ...) -> None: ...
    def metadataForID(self, unique_id: str) -> themes.Metadata: ...
    @property
    def editing(self) -> bool: ...
    def selectID(self, unique_id: str) -> None: ...
    def setCurrent(
        self, metadata: str | themes.Metadata | None, theme: colors.Theme | None = ..., record: bool = ...
    ) -> None: ...
    def updateTheme(self, unique_id: str, theme: colors.Theme) -> None: ...
    def metadataInfo(self, unique_id: str) -> tuple[str, str, str]: ...
    def editMetadata(self, unique_id: str, name: str, category: str, description: str, record: bool = ...) -> None: ...
    def addMetadata(self, metadata: themes.Metadata, record: bool = ...) -> None: ...
    def isReadOnly(self, unique_id: str) -> bool: ...
    def isTemporary(self, unique_id: str) -> bool: ...
    def deleteMetadata(self, unique_id: str, record: bool = ..., select_id: str = ...) -> None: ...
    def isFinished(self) -> bool: ...
    def randomize(self) -> None: ...
    def revealFile(self, unique_id: str) -> None: ...
    def applyTheme(self, preview: bool = ...) -> None: ...
    def preview(self) -> None: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...
    def store(self, unique_id: str) -> None: ...
    def createMetadata(self, name: str, category: str = ..., description: str = ..., temporary: bool = ...) -> None: ...
    def revertCurrent(self) -> None: ...
    def revert(self, unique_id: str) -> None: ...
    def revertToOriginal(self) -> None: ...
    def record(self) -> None: ...
    @property
    def edited(self) -> bool: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    @property
    def canUndo(self) -> bool: ...
    @property
    def canRedo(self) -> bool: ...
    def setHex(self, name: str, hex_string: str) -> None: ...
    def editSwatch(self, name: str, color: QtGui.QColor | None = ...) -> None: ...

class ThemeEditorViewWindow(qmlviews.BaseQmlView[ThemeEditorState]):
    accepted: ClassVar[QtCore.Signal]
    rejected: ClassVar[QtCore.Signal]
    finished: ClassVar[QtCore.Signal]
    SOURCE_URL: str
    DEFAULT_SIZE: QtCore.QSize
    MINIMUM_SIZE: QtCore.QSize
    def __init__(
        self,
        theme: colors.Theme,
        *,
        unique_id: str = ...,
        callback: CallbackType | None = ...,
        parent_window: QtGui.QWindow | None = ...,
    ) -> None: ...
    def unscaledDefaultSize(self) -> QtCore.QSize: ...
    def closeEvent(self, event: QtGui.QCloseEvent) -> None: ...
    def currentMetadata(self) -> themes.Metadata: ...
    def currentTheme(self) -> colors.Theme: ...

theme_editor_window: ThemeEditorViewWindow | None

def showThemeEditorWindow() -> None: ...

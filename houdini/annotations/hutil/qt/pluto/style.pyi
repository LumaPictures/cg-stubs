import enum
from typing import TypeVar

from PySide6 import QtCore, QtGui, QtWidgets

from hutil.qt.pluto.parts import ScaledFloat

T = TypeVar("T")

CC_Base: QtWidgets.QStyle.ComplexControl
SC_Base: int
CE_Base: QtWidgets.QStyle.ControlElement
PE_Base: QtWidgets.QStyle.PrimitiveElement
CT_Base: QtWidgets.QStyle.ContentsType
PM_Base: QtWidgets.QStyle.PixelMetric

class ComplexControl(enum.IntEnum):
    ...

class SubControl(enum.IntEnum):
    ...

class ControlElement(enum.IntEnum):
    ...

class PrimitiveElement(enum.IntEnum):
    ...

class ContentsType(enum.IntEnum):
    ...

class PixelMetric(enum.IntEnum):
    ...

def qstyleoption_cast(option: QtWidgets.QStyleOption, cls: type[T]) -> T: ...
def defaultPalette() -> QtGui.QPalette: ...
def defaultHoloPalette() -> QtGui.QPalette: ...

class PlutoStyle(QtWidgets.QCommonStyle):
    def __init__(self, scale: float = ..., holo: bool = ...) -> None: ...
    def localScale(self) -> float: ...
    def setLocalScale(self, scale: float) -> None: ...
    def scaled(self, val: float | None, default: float = ...) -> ScaledFloat: ...
    def scaledInt(self, val: float | None, default: float = ...) -> int: ...
    def isHolo(self) -> bool: ...
    def standardPalette(self) -> QtGui.QPalette: ...
    def polish(self, obj: QtWidgets.QApplication | QtWidgets.QWidget | QtGui.QPalette) -> None: ...
    def unpolish(self, widget: QtWidgets.QWidget | QtWidgets.QApplication) -> None: ...
    def drawComplexControl(self, control: QtWidgets.QStyle.ComplexControl | ComplexControl, option: QtWidgets.QStyleOptionComplex, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = ...) -> None: ...
    def drawPrimitive(self, element: QtWidgets.QStyle.PrimitiveElement | PrimitiveElement, option: QtWidgets.QStyleOption, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = ...) -> None: ...
    @staticmethod
    def iconTint(palette: QtGui.QPalette) -> QtGui.QColor: ...
    @staticmethod
    def iconAccent(palette: QtGui.QPalette) -> QtGui.QColor: ...
    def drawControl(self, element: QtWidgets.QStyle.ControlElement | ControlElement, option: QtWidgets.QStyleOption, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = ...) -> None: ...
    def sizeFromContents(self, ctype: QtWidgets.QStyle.ContentsType | ContentsType, option: QtWidgets.QStyleOption, size: QtCore.QSize, widget: QtWidgets.QWidget | None = ...) -> QtCore.QSize: ...
    def pixelMetric(self, metric: QtWidgets.QStyle.PixelMetric | PixelMetric, option: QtWidgets.QStyleOption | None = ..., widget: QtWidgets.QWidget | None = ...) -> int: ...
    def styleHint(self, hint: QtWidgets.QStyle.StyleHint, opt: QtWidgets.QStyleOption | None = ..., widget: QtWidgets.QWidget | None = ..., shret: QtWidgets.QStyleHintReturn | None = ...) -> int: ...
    def subControlRect(self, cc: QtWidgets.QStyle.ComplexControl | ComplexControl, option: QtWidgets.QStyleOptionComplex, sc: QtWidgets.QStyle.SubControl | SubControl, widget: QtWidgets.QWidget | None = ...) -> QtCore.QRect: ...
    def subElementRect(self, elem: QtWidgets.QStyle.SubElement, opt: QtWidgets.QStyleOption, widget: QtWidgets.QWidget | None = ...) -> QtCore.QRect: ...

def normalizedTabShape(shape: QtWidgets.QTabBar.Shape) -> QtWidgets.QTabBar.Shape: ...

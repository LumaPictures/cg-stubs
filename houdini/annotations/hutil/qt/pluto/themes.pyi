# A theme's saved values (colors.Theme.asDict()): its base, primary and highlight colors as
# HCT triples, and colors.theme_settings.  makeTheme() raises KeyError for any other key.
class _ThemeValues(TypedDict, total=False):
    base: Sequence[float]
    primary: Sequence[float]
    highlight: Sequence[float]
    globalContrast: float
    secondaryChromaScale: float
    neutralChromaScale: float
    iconTintChromaScale: float
    iconAccentChromaScale: float
    contrast: float
    textAdjust: float
    buttonAdjust: float
    fieldAdjust: float
    paneDividerAdjust: float
    uncheckedUseField: bool
    checkedUsePrimary: bool
    checkedInverted: bool
    tabsUsePrimary: bool
    iconsUsePrimary: bool
    customIconAccent: str
    useCustomIconAccent: bool
bad_char_expr: re.Pattern[str]


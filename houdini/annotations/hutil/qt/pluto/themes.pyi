def makeTheme(kwargs: _ThemeValues, set_preview_colors: bool = ...) -> colors.Theme: ...

class Metadata(core.Info):
    sourcePath: str
    name: str
    description: str
    category: str
    priority: int
    temporary: bool
    oldName: str
    uniqueIDChanged: ClassVar[QtCore.Signal]
    baseChanged: ClassVar[QtCore.Signal]
    primaryChanged: ClassVar[QtCore.Signal]
    highlightChanged: ClassVar[QtCore.Signal]
    themeChanged: ClassVar[QtCore.Signal]
    grayBGChanged: ClassVar[QtCore.Signal]
    def __init__(
        self,
        source_path: str | pathlib.Path = ...,
        name: str = ...,
        theme: colors.Theme | None = ...,
        description: str = ...,
        category: str = ...,
        priority: int = ...,
        temporary: bool = ...,
        from_archive: bool = ...,
        **kwargs: Unpack[_ThemeValues],
    ) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def path(self) -> pathlib.Path: ...
    @property
    def grayBG(self) -> bool: ...
    @property
    def readOnly(self) -> bool: ...
    @property
    def uniqueID(self) -> str: ...
    def dumpDiff(self, other: Metadata) -> None: ...
    def copy(self, *, rename: str = ..., make_writable: bool = ...) -> Metadata: ...
    def duplicate(self, name: str, temporary: bool = ..., category: str = ...) -> None: ...
    def updatePath(self) -> None: ...
    def asDict(self) -> dict[str, list[float] | str | float | bool]: ...
    def updateFrom(self, metadata: Metadata) -> None: ...
    def setTheme(self, theme: colors.Theme) -> None: ...
    @property
    def theme(self) -> colors.Theme: ...
    def rawTheme(self) -> colors.Theme: ...
    def baseHCT(self) -> tuple[float, float, float]: ...
    def primaryHCT(self) -> tuple[float, float, float]: ...
    def highlightHCT(self) -> tuple[float, float, float]: ...
    @property
    def base(self) -> QtGui.QColor: ...
    @property
    def primary(self) -> QtGui.QColor: ...
    @property
    def highlight(self) -> QtGui.QColor: ...
    def renamed(self) -> bool: ...
    def existsOnDisk(self) -> bool: ...
    def renameOnDisk(self) -> bool: ...
    def saveToDisk(self) -> bool: ...
    def deleteFromDisk(self) -> bool: ...

def metadataSortKey(md: Metadata) -> str: ...


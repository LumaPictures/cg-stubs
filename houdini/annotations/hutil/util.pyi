from collections.abc import Iterable, Iterator, Sequence
from types import ModuleType
from typing import Any, Generic, TypeVar

H = TypeVar("H")

def find_object(name: str) -> Any: ...

class CircularDependencyError(Exception): ...

class DependencyGraph(Generic[H]):
    def __init__(self, values: Iterable[H] | None = ...) -> None: ...
    def add(self, value: H) -> None: ...
    def depends_on(self, value: H, prereq: H) -> None: ...
    def resolve(self, values: Sequence[H] | None = ...) -> Iterator[H]: ...

def reload(module: ModuleType) -> None: ...
def reloadpkg(package: ModuleType, order: Iterable[ModuleType] | None = ...) -> ModuleType: ...

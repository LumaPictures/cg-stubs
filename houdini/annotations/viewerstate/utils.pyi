class Logger:
    enabled: bool
    count: int
    def __init__(self, flag: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def _log(self, arg: object, fmt: str = ..., label: str | None = ...) -> None: ...
    def msg(self, arg: object, fmt: str = ..., label: str | None = ..., force: bool = ...) -> None: ...
    def obj(self, obj: object, force: bool = ...) -> None: ...
    def attrb(self, obj: object, attrib_name: str, fmt: str = ..., force: bool = ...) -> None: ...
    def enable(self, flag: object) -> None: ...
    def marker(self) -> None: ...


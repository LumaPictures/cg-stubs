class Selector:
    def __init__(
        self,
        name: str,
        geometry_types: Sequence[hou.EnumValue[hou.geometryType]],
        prompt: str = ...,
        primitive_types: Sequence[hou.EnumValue[hou.primType]] = ...,
        group_parm_name: str | None = ...,
        group_type_parm_name: str | None = ...,
        input_index: int = ...,
        input_required: bool = ...,
        allow_dragging: bool = ...,
        empty_string_selects_all: bool = ...,
        ordered: bool = ...,
        extra_info: str = ...,
    ) -> None: ...
    def name(self) -> str: ...
    def geometryTypes(self) -> Sequence[hou.EnumValue[hou.geometryType]]: ...
    def prompt(self) -> str: ...
    def primitiveTypes(self) -> Sequence[hou.EnumValue[hou.primType]]: ...
    def groupParmName(self) -> str | None: ...
    def groupTypeParmName(self) -> str | None: ...
    def inputIndex(self) -> int: ...
    def inputRequired(self) -> bool: ...
    def allowDragging(self) -> bool: ...
    def emptyStringSelectsAll(self) -> bool: ...
    def ordered(self) -> bool: ...
    def extraInfo(self) -> str: ...


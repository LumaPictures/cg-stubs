from collections.abc import Callable
from typing import IO, Any, Unpack

import hou
from viewerstate.interface import _ResourceEventKwargs
from typing_extensions import TypedDict
from PySide6 import QtCore, QtWidgets


# A command for the browser, as resourceutils.DebugAidBase makes it (a flag naming the command,
# and its arguments), or the kwargs of the custom resource event that delivers one; the browser
# ignores any other key.
class _BrowserCommand(TypedDict, total=False, extra_items=object):  # type: ignore[call-arg]
    args: dict[str, str]
    clear_console: int
    add_marker: int
    console_logging: int
    trace_resource: int
    inspect_resource: int
    reload_resource: int
    edit_resource: int
    enable_trace_resource: int
    get_debug_states: int
    refresh_browser: int

class ViewerStateBrowser(QtWidgets.QFrame):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def resourceType(self) -> hou.EnumValue[hou.resourceType]: ...
    def printMessage(self, msg: str | list[str], msg_type: hou.EnumValue[hou.severityType] = ..., immediate: bool = ...) -> None: ...
    def editCurrentState(self) -> None: ...
    def reloadCurrentState(self) -> None: ...
    def onActivate(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def onDestroy(self) -> None: ...
    def onContextMenu(self, pos: QtCore.QPoint) -> None: ...
    def onExpandNode(self) -> None: ...
    def onReloadAllStates(self) -> None: ...
    def onLoadStateExamples(self) -> None: ...
    def onDeferPrintMessage(self, msg: str, msg_type: hou.EnumValue[hou.severityType], reset_want_timestamp: bool) -> None: ...
    def onLoadFileState(self) -> None: ...
    def onReloadState(self) -> None: ...
    def onUnloadState(self) -> None: ...
    def onDeleteState(self) -> None: ...
    def onEditEmbedded(self) -> None: ...
    def onEditFileState(self) -> None: ...
    def onEditSelectedState(self) -> None: ...
    def onNewState(self) -> None: ...
    def onOpenFile(self) -> None: ...
    def onSceneLoaded(self, event_type: hou.EnumValue[hou.hipFileEventType]) -> None: ...
    def onSelectionChanged(self, signal: QtCore.QItemSelection) -> None: ...
    def onShowHelp(self) -> None: ...
    def onCategoryChange(self, index: int) -> None: ...
    def onAddMarker(self) -> None: ...
    def onClearMessages(self) -> None: ...
    def onDebugLogState(self) -> None: ...
    def onTraceState(self) -> None: ...
    def onInspectState(self) -> None: ...
    def onEventHandlerTraceOptions(self) -> None: ...
    def onEnterState(self) -> None: ...
    def onExitState(self) -> None: ...
    def onResourceEvent(self, **kwargs: Unpack[_ResourceEventKwargs]) -> None: ...
    def runCommand(self, kwargs: _BrowserCommand) -> dict[str, bool]: ...

def onApplyAction(**kwargs: str) -> None: ...

class TempFileAuto:
    prefix: str
    suffix: str
    file: IO[str] | None
    def __init__(self, prefix: str = ..., suffix: str = ...) -> None: ...
    def __del__(self) -> None: ...
    def clear(self) -> None: ...

def iterate_model(index: QtCore.QModelIndex, model_to_iterate: QtCore.QAbstractItemModel, depth: int, func: Callable[[QtCore.QModelIndex, int], object]) -> None: ...
def dump_model(view: QtWidgets.QAbstractItemView) -> None: ...

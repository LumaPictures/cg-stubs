def getIconForPrim(prim: Usd.Prim, default: QtGui.QIcon = ...) -> QtGui.QIcon: ...

class Branch:
    theDefaultData: list[str]
    parent: "weakref.ref[Branch] | None"
    name: str
    children: "dict[str, Branch]"
    childnames: list[str]
    data: list[str]
    icon: QtGui.QIcon
    icon2: QtGui.QIcon
    color: _Color | None
    def __init__(
        self, parent: "Branch | None", name: str, icon: QtGui.QIcon = ..., icon2: QtGui.QIcon = ...
    ) -> None: ...
    def copy(self, branch: "Branch") -> None: ...
    def getParent(self) -> "Branch | None": ...
    def getName(self) -> str: ...
    def setName(self, newname: str) -> None: ...
    def getIcon(self) -> QtGui.QIcon: ...
    def setIcon(self, icon: QtGui.QIcon) -> None: ...
    def getIcon2(self) -> QtGui.QIcon: ...
    def setIcon2(self, icon: QtGui.QIcon) -> None: ...
    def getColor(self) -> _Color | None: ...
    def setColor(self, color: _Color | None = ...) -> None: ...
    def isModelRoot(self) -> bool: ...
    def isRoot(self) -> bool: ...
    def isLeaf(self) -> bool: ...
    def hasData(self) -> bool: ...
    def createChild(
        self, name: str, index: int, force_unique_name: bool, icon: QtGui.QIcon = ...
    ) -> "Branch": ...
    def removeChild(self, name: str) -> None: ...
    def getChildByName(self, name: str) -> "Branch | None": ...
    def getChildByIndex(self, index: int) -> "Branch | None": ...
    def getIndexForName(self, name: str) -> int: ...
    def getNumChildren(self) -> int: ...
    def getData(self) -> list[str]: ...
    def setData(self, data: list[str]) -> None: ...
    def addMember(self, member: str) -> None: ...
    def removeMember(self, member: str) -> None: ...
    def __repr__(self) -> str: ...

class Model(QtCore.QAbstractItemModel):
    modelroot: Branch
    root: Branch | None
    panel: LPETagPanel | None
    sourcenode: hou.LopNode | None
    getselectedindexes: Callable[[], Iterable[QtCore.QModelIndex]] | None
    queuedupdatefromnode: bool
    isSource: bool
    def __init__(self, parent: LPETagPanel | None = ...) -> None: ...
    def columnCount(self, parent: _AnyIndex) -> int: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int) -> None: ...
    def rowCount(self, parent: _AnyIndex) -> int: ...
    def data(
        self, index: _AnyIndex, role: int = ...
    ) -> QtCore.QSize | _Color | QtGui.QIcon | str | list[str] | None: ...
    def setData(self, index: _AnyIndex, value: Any, role: int) -> bool: ...
    def flags(self, index: _AnyIndex) -> QtCore.Qt.ItemFlag: ...
    def supportedDropActions(self) -> QtCore.Qt.DropAction: ...
    def index(self, row: int, column: int, parent: _AnyIndex) -> QtCore.QModelIndex: ...
    def parent(self, index: _AnyIndex) -> QtCore.QModelIndex: ...
    def mimeTypes(self) -> list[str]: ...
    def getMimeData(
        self, indexes: Iterable[QtCore.QModelIndex]
    ) -> tuple[list[str | None], QtCore.QByteArray]: ...
    def setCurrentNode(self, node: hou.LopNode | None) -> None: ...
    def getMinimalSortedIndexes(
        self, indexes: Iterable[QtCore.QModelIndex]
    ) -> list[QtCore.QModelIndex]: ...
    def getPathsFromMimeData(self, data: QtCore.QMimeData) -> list[str]: ...
    def getMinimalSortedIndexesFromMimeData(
        self, data: QtCore.QMimeData, destparent: _AnyIndex
    ) -> list[QtCore.QModelIndex] | None: ...
    def getPath(self, index: _AnyIndex) -> str | None: ...
    def getIndexForBranch(self, branch: Branch | None) -> QtCore.QModelIndex: ...
    def getIndexForPath(self, path: str) -> QtCore.QModelIndex | None: ...
    def handleDeleteRow(self, branch: Branch) -> None: ...
    def setGetSelectedIndexes(
        self, handler: Callable[[], Iterable[QtCore.QModelIndex]]
    ) -> None: ...
    def getFilterColumns(self) -> list[int]: ...

class LightModel(Model):

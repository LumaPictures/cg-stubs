from collections.abc import Callable, Iterable, Sequence
from typing import Self, TypeAlias, TypeGuard

import hou
import nodegraphbase as base
import nodegraphgestures as gestures
import nodegraphutils as utils
from canvaseventtypes import (
    GestureEvent,
    KeyboardEvent,
    ModalUIEvent,
    MouseEvent,
    TimerEvent,
    ValueEvent,
)

_UIEvent: TypeAlias = MouseEvent | KeyboardEvent | GestureEvent | ValueEvent | TimerEvent | ModalUIEvent
_BoxHit: TypeAlias = tuple[hou.NetworkItem, str, int]
_StitchItem: TypeAlias = hou.Node | hou.NetworkDot | hou.SubnetIndirectInput
_StitchHit: TypeAlias = tuple[_StitchItem, str, int]
_StitchPair: TypeAlias = tuple[_StitchItem, int, _StitchItem, int]

class BoxPickHandler(base.EventHandler):
    start_uievent: MouseEvent
    start_pos: hou.Vector2
    set_cursor: bool
    oldcursormap: dict[tuple[str, int], str]
    olddefaultcursor: str
    def __init__(self, start_uievent: MouseEvent, set_cursor: bool = ...) -> None: ...
    def getItemsInBox(self, items: Iterable[_BoxHit]) -> list[hou.NetworkItem]: ...
    def setSelectCursor(self, uievent: _UIEvent) -> None: ...
    def handleBoxPickComplete(self, items: Sequence[hou.NetworkItem], uievent: MouseEvent) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class VolatileStateHandler(base.EventHandler):
    start_uievent: KeyboardEvent
    editor_updates: utils.EditorUpdates
    startkey: str
    subhandler: base.EventHandler | None
    wrappedhandler: base.EventHandler | None
    oldcursormap: dict[tuple[str, int], str]
    olddefaultcursor: str
    def __init__(self, start_uievent: KeyboardEvent, wrapped_handler: base.EventHandler | None = ...) -> None: ...
    def combineHandlerUpdates(self) -> None: ...
    def sendEventToSubHandler(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> Self: ...
    def handleStateCompleted(self) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class VolatileNodeBoxPickHandler(BoxPickHandler):
    owner: "NodeSelectStateHandler"
    def __init__(self, start_uievent: MouseEvent, owner: "NodeSelectStateHandler") -> None: ...
    def getItemsInBox(self, items: Iterable[_BoxHit]) -> list[hou.Node]: ...
    def handleBoxPickComplete(self, items: list[hou.Node], uievent: MouseEvent) -> None: ...

class NodeSelectStateHandler(VolatileStateHandler):
    subhandler: base.EventHandler | None
    lmbdown: bool
    mouseclicked: bool
    def __init__(self, start_uievent: KeyboardEvent) -> None: ...
    def handlePick(self, nodes: list[hou.Node], editor: hou.NetworkEditor) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

def isScrollStateEvent(uievent: _UIEvent) -> TypeGuard[KeyboardEvent]: ...

class ScrollStateHandler(VolatileStateHandler):
    wrappedhandler: base.EventHandler | None
    bounds: hou.BoundingRect
    def __init__(self, start_uievent: KeyboardEvent, wrapped_handler: base.EventHandler) -> None: ...
    def sendEventToSubHandler(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> Self: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class ViewStateHandler(VolatileStateHandler):
    subhandler: base.EventHandler | None
    def __init__(self, start_uievent: KeyboardEvent) -> None: ...
    def getPrompt(self, uievent: MouseEvent | KeyboardEvent) -> str: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class BoxSelectStateHandler(VolatileStateHandler):
    subhandler: base.EventHandler | None
    lmbdown: bool
    def __init__(self, start_uievent: KeyboardEvent) -> None: ...
    def getPrompt(self, uievent: MouseEvent | KeyboardEvent) -> str: ...
    def setSelectCursor(self, uievent: _UIEvent) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class CutWiresStateHandler(VolatileStateHandler):
    lastpos: hou.Vector2 | None
    conns: set[hou.NodeConnection]
    cutwireshapes: list[hou.NetworkShapeConnection]
    mousepathshapes: list[hou.NetworkShapeLine]
    def __init__(self, start_uievent: KeyboardEvent) -> None: ...
    def getPrompt(self, uievent: MouseEvent | KeyboardEvent) -> str: ...
    def doCut(self) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class StitchStateHandler(VolatileStateHandler):
    UP: int
    DOWN: int
    NONE: int
    lastpos: hou.Vector2 | None
    mousepathshapes: list[hou.NetworkShapeLine]
    color: hou.Color
    color_start: hou.Color
    color_end: hou.Color
    direction: int
    previous: _StitchHit | None
    pairs: list[_StitchPair]
    set1: set[_StitchItem]
    set2: set[_StitchItem]
    def __init__(self, uievent: KeyboardEvent) -> None: ...
    def getPrompt(self, uievent: MouseEvent | KeyboardEvent) -> str: ...
    @staticmethod
    def lerp(x0: float, x1: float, alpha: float) -> float: ...
    @staticmethod
    def isBulk(node: hou.Node) -> bool: ...
    @staticmethod
    def isSubnetInput(part_type: str) -> bool: ...
    @staticmethod
    def nextConnector(connector_func: Callable[[], Sequence[Sequence[hou.NodeConnection]]]) -> int: ...
    def stitch(self) -> None: ...
    def update(self, hits: list[_StitchHit]) -> None: ...
    @staticmethod
    def createCircle(p: hou.Vector2, radius: float, color: hou.Color) -> hou.NetworkShapeNodeShape: ...
    def createHighlights(self, editor: hou.NetworkEditor, hits: Iterable[_StitchHit]) -> list[hou.NetworkShapeNodeShape]: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class AlignStateHandler(VolatileStateHandler):
    gman: gestures.GestureManager
    def __init__(self, start_uievent: KeyboardEvent) -> None: ...
    def handleEvent(self, uievent: _UIEvent, pending_actions: list[base.PendingAction]) -> base.EventHandler | None: ...

class VisualizeStateHandler(NodeSelectStateHandler):

from collections.abc import Callable, Sequence
from typing import Any, ParamSpec, TypeAlias, TypedDict

import hou
from houtypes import ParmCallbackKwargs
from kinefx.stateutils import _ParmTupleValue

_P = ParamSpec("_P")

# A parm tuple's value: its only component's, or the tuple for multi-component ones.
_VopParmValue: TypeAlias = int | float | str | hou.Ramp | dict[str, str] | hou.Geometry | None | _ParmTupleValue

class _VopSelectionKwargs(TypedDict):
    """What a point VOP's `consumeSelection(kwargs)` (its ViewerStateConfig section) gets."""

    node: hou.VopNode
    point: hou.Point
    input_index: int

def pauseUpdate(func: Callable[_P, object]) -> Callable[_P, None]: ...
# A module-like object made from the VOP type's ViewerStateConfig section (output_funcs,
# consumeSelection, xformHandleParms, ...).
def getVopViewerStateConfig(v: hou.OpNode) -> Any: ...
def vopParmDict(vop: hou.OpNode) -> dict[str, _VopParmValue]: ...
# ViewerStateConfig's output_funcs: output name -> what it evaluates to for the VOP (a point
# number, a hou.Matrix4, ...).
def getVopOutputFuncs(v: hou.OpNode) -> dict[str, Callable[[hou.VopNode], Any]]: ...
def updateVopPointParmFromState(kwargs: _VopSelectionKwargs) -> None: ...
def getVopPoint(vop: hou.VopNode) -> hou.Point | None: ...
def updatePointParms(v: hou.VopNode, pt: hou.Point) -> None: ...
def createGetPointTransform(vopnet: hou.OpNode, pt: hou.Point, byname: bool = ...) -> hou.VopNode | None: ...
def createSetPointTransform(
    vopnet: hou.OpNode, pt: hou.Point, getvop: hou.OpNode | None = ..., byname: bool = ...
) -> hou.VopNode | None: ...
def createBlendInput(vop: hou.VopNode) -> None: ...
def createRestTransform(vopnet: hou.OpNode, pt: hou.Point, byname: bool = ..., frame: float | None = ...) -> hou.VopNode: ...
def createParentConstraint(
    vopnet: hou.OpNode, driver: hou.Point, driven: hou.Point, offset: hou.Matrix4 | None = ...
) -> None: ...
def createMatchTransform(vopnet: hou.OpNode, driver: hou.Point, driven: hou.Point) -> None: ...
def createLookatConstraint(
    vopnet: hou.OpNode, lookat: hou.Point, driven: hou.Point, lookup: hou.Point | hou.Vector3 | None = ...
) -> None: ...
def createTwoBoneIK(
    vopnet: hou.OpNode, goal: hou.Point, twist: hou.Point, driven: Sequence[hou.Point], local: bool = ...
) -> None: ...
def matchTransformCallback(kwargs: ParmCallbackKwargs) -> None: ...
def parentConstraintCallback(kwargs: ParmCallbackKwargs) -> None: ...
def lookatConstraintCallback(kwargs: ParmCallbackKwargs) -> None: ...
def twoBoneIKCallback(kwargs: ParmCallbackKwargs) -> None: ...
def promoteVopParms(vopnode: hou.OpNode, destnode: hou.OpNode) -> None: ...
def stashTransform(
    node: hou.VopNode,
    xforminput: int,
    t_parm_name: str = ...,
    r_parm_name: str = ...,
    s_parm_name: str = ...,
    shear_parm_name: str = ...,
) -> None: ...

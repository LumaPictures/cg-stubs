from collections.abc import Iterable, Mapping
from typing import Protocol, overload

import hou

# addNodeCallbacks() adds the same callback for the playbar's events (called with the event type
# and frame) and for the node's input and parm changes (called with keywords).
class _PlaybarAndNodeEventCallback(Protocol):
    @overload
    def __call__(self, event_type: hou.EnumValue[hou.playbarEvent], frame: float, /) -> object: ...
    @overload
    def __call__(
        self, *, event_type: hou.EnumValue[hou.nodeEventType], node: hou.OpNode, input_index: int
    ) -> object: ...
    @overload
    def __call__(
        self,
        *,
        event_type: hou.EnumValue[hou.nodeEventType],
        node: hou.OpNode,
        parm_tuple: hou.ParmTuple | None,
    ) -> object: ...

def matrix4ToMatrix3(xform: hou.Matrix4) -> hou.Matrix3: ...
def getPointTransform(pt: hou.Point) -> hou.Matrix4: ...
def getRigidTransform(xform: hou.Matrix4) -> hou.Matrix4: ...
def setPointTransform(pt: hou.Point, xform: hou.Matrix4) -> None: ...
def getPointParent(pt: hou.Point) -> hou.Point | None: ...
def getPointChildren(pt: hou.Point) -> tuple[hou.Point, ...]: ...
def findPointName(geo: hou.Geometry, name: str) -> hou.Point | None: ...
def addNodeCallbacks(node: hou.OpNode, f: _PlaybarAndNodeEventCallback) -> None: ...
def removeNodeCallbacks(node: hou.OpNode, f: _PlaybarAndNodeEventCallback) -> None: ...
def findValueInMultiparm(multiparm: hou.Parm, childparm_name: str, val: str) -> int: ...
def computeWorld(
    child_local: hou.Matrix4, parent_local: hou.Matrix4, parent_world: hou.Matrix4, compensate_mode: int = ...
) -> hou.Matrix4: ...
def pointToLineDistance(origin: hou.Vector3, dir: hou.Vector3, point: hou.Vector3) -> float: ...
def closestPointToLine(
    geos: Iterable[hou.Geometry], o: hou.Vector3, d: hou.Vector3
) -> tuple[hou.Point | None, float]: ...
def setParmMatrix(node: hou.OpNode, prefix: str, m: hou.Matrix4) -> None: ...
def mirrorTransform(
    m: hou.Matrix4, planeorigin: hou.Vector3, planenormal: hou.Vector3, flipaxes: int = ...
) -> hou.Matrix4: ...
def attachControlGeo(pt: hou.Point, ctrlgeo: hou.Geometry, role: str = ...) -> hou.PackedGeometry: ...
def getJointGeos(pt: hou.Point, role: str = ...) -> list[hou.PackedGeometry]: ...
def initPointAttributes(geo: hou.Geometry, name_pattern: str = ...) -> hou.Geometry: ...
# d is a mapping point attribute's value ({"reference": attrib name or "ptnum", "value": ...}).
def resolveMapping(geo: hou.Geometry, d: Mapping[str, hou._OptionValue]) -> int | None: ...
def mirrorJointGeo(
    pt: hou.Point,
    mirror_pt: hou.Point,
    planeorigin: hou.Vector3,
    planenormal: hou.Vector3,
    role: str = ...,
) -> None: ...

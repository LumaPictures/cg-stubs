from collections.abc import Sequence

import hou

# Stands in for a hou.Handle in regression tests, where Houdini creates no handles.
class MockHandle:
    def __init__(self, scene_viewer: hou.SceneViewer, name: str, type: str = ...) -> None: ...
    def name(self) -> str: ...
    def type(self) -> str: ...
    def show(self, on: bool) -> None: ...
    def update(self, immediate: bool = ...) -> None: ...
    def visible(self) -> bool: ...
    def enableParms(self, parm_list: Sequence[str]) -> None: ...
    def disableParms(self, parm_list: Sequence[str]) -> None: ...
    def applySettings(self, settings: str) -> None: ...

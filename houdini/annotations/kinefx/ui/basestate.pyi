from collections.abc import Callable

import hou
from houtypes import (
    NodeEventKwargs,
    ViewerStateDragDropKwargs,
    ViewerStateDrawKwargs,
    ViewerStateEnterKwargs,
    ViewerStateEventKwargs,
    ViewerStateKwargs,
    ViewerStateMenuActionKwargs,
    ViewerStateMenuPreOpenKwargs,
    ViewerStateParmChangeKwargs,
    ViewerStateSelectionKwargs,
)
from kinefx.stateutils import ViewerStateDisplayOptions, _MouseSelectionArgs, _PreSelection
from kinefx.ui.rigvisualisers import KinefxRigVisualiserCollection
from typing_extensions import Unpack

def dbg_print(s: object) -> None: ...
def addInvalidBounds(geo: hou.Geometry) -> None: ...
def _geoFromDisk(path: str, packed: bool = ...) -> hou.Geometry: ...
def getGeoHiddenPts(geo: hou.Geometry) -> set[hou.Point]: ...

class KinefxStateInterrupt:
    scene_viewer: hou.SceneViewer
    node: hou.SopNode | None
    display_sop_after_selection: hou.SopNode | None
    interrupt_state: str | None
    def __init__(self, scene_viewer: hou.SceneViewer, node: hou.SopNode | None) -> None: ...
    def pushInteruptSelection(self, selection: hou.Selection, show_scene_geo: bool) -> None: ...
    def onInterrupt(self, interrupt_state: str, selection: hou.Selection, show_scene_geo: bool) -> None: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def shouldDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> bool: ...

# Sets the state's node_attr attribute to n, unless it already is n.
def updateStateNode(state: object, n: hou.OpNode | None, node_attr: str = ...) -> bool: ...

class KinefxViewerState:
    state_name: str
    scene_viewer: hou.SceneViewer
    node: hou.SopNode | None
    parm_change_names: list[str]
    rig_visualisers: KinefxRigVisualiserCollection
    display_options: ViewerStateDisplayOptions
    pre_selection: _PreSelection | None
    selection_node: hou.SopNode | None
    drag_selection: hou.Selection | None
    selection_callbacks: list[Callable[[_MouseSelectionArgs], object]]
    display_sop_after_selection: hou.SopNode | None
    interrupt_state: str | None
    # The visualiser's event position, which is None until one of its drawables is hit.
    event_pos: hou.Vector3 | None
    event_point_pos: hou.Vector3
    def __init__(self, state_name: str, scene_viewer: hou.SceneViewer) -> None: ...
    @property
    def selection(self) -> hou.Selection: ...
    @selection.setter
    def selection(self, sel: hou.Selection) -> None: ...
    def selectionType(self) -> hou.EnumValue[hou.geometryType] | None: ...
    @property
    def show_links(self) -> bool: ...
    @show_links.setter
    def show_links(self, on: bool) -> None: ...
    @property
    def show_joints(self) -> bool: ...
    @show_joints.setter
    def show_joints(self, on: bool) -> None: ...
    @property
    def show_axes(self) -> bool: ...
    @show_axes.setter
    def show_axes(self, on: bool) -> None: ...
    @property
    def show_scene_geo(self) -> bool: ...
    @show_scene_geo.setter
    def show_scene_geo(self, on: bool) -> None: ...
    def onChildSwitched(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def onNodeParmChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    # A node event callback; _onInputRewired passes its keyword arguments as one dictionary.
    def onInputRewired(self, *args: NodeEventKwargs, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def setNode(self, n: hou.SopNode | None) -> None: ...
    # No-op hooks that nothing calls.
    def getPointSelection(self, **kwargs: object) -> None: ...
    def getPointSelectionFromEdges(self, **kwargs: object) -> None: ...
    def getEdgeSelection(self, **kwargs: object) -> None: ...
    def onEnter(self, kwargs: ViewerStateEnterKwargs) -> None: ...
    def onGenerate(self, kwargs: ViewerStateKwargs) -> None: ...
    def pushInteruptSelection(self) -> None: ...
    def onInterrupt(self, kwargs: ViewerStateKwargs) -> None: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def sendSelection(self, kwargs: _MouseSelectionArgs) -> None: ...
    def addSelectionCallback(self, f: Callable[[_MouseSelectionArgs], object]) -> None: ...
    @staticmethod
    def intersectPlaneThroughPoint(
        origin: hou.Vector3, direction: hou.Vector3, pt: hou.Point | None = ...
    ) -> hou.Vector3: ...
    def onDragStart(self, ui_event: hou.ViewerEvent, plane_origin: hou.Vector3 | None = ...) -> None: ...
    def onDrag(self, ui_event: hou.ViewerEvent) -> None: ...
    def onDragEnd(self, ui_event: hou.ViewerEvent) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onStartSelection(self, kwargs: ViewerStateSelectionKwargs) -> None: ...
    def onSelection(self, kwargs: ViewerStateSelectionKwargs) -> None: ...
    def onStopSelection(self, kwargs: ViewerStateSelectionKwargs) -> None: ...
    def onDragDropTest(self, kwargs: ViewerStateDragDropKwargs) -> None: ...
    def onDragDropMenu(self, kwargs: ViewerStateDragDropKwargs) -> None: ...
    def onDragDropAccept(self, kwargs: ViewerStateDragDropKwargs) -> None: ...

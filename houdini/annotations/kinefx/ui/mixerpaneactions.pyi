from kinefx.ui.mixermatchjoints import MatchJointDialog, _MatchJointsKwargs, _SelectJointsKwargs
from PySide6 import QtCore, QtWidgets

# A getSelectedItems() item: (mixer node, item type, ids), the last id the mixer index.
_SelectedItem: TypeAlias = tuple[hou.OpNode | None, _MixerItemType, tuple[int, ...]]

# What hou.Parm.eval() returns.
_ParmValue: TypeAlias = int | float | str | dict[str, str] | hou.Ramp | hou.Geometry | None

# A clip's or track's transform parameters (getTransformParms()), with the options extracting a
# nested clip adds to have doPasteAction() apply them.
class _TransformParms(TypedDict, total=False):
    xOrd: Required[hou.Parm]
    rOrd: Required[hou.Parm]
    t: Required[hou.ParmTuple]
    r: Required[hou.ParmTuple]
    s: Required[hou.ParmTuple]
    p: Required[hou.ParmTuple]
    pr: Required[hou.ParmTuple]
    parent_xfo_parms: "_TransformParms"
    cut_new_clips: bool
    cut_new_clips_start: _ParmValue
    cut_new_clips_end: _ParmValue
    extract_clips: bool

# The transform parameters' values that evalTransformParms() writes to its eval_dict.
class _TransformValues(TypedDict, total=False):
    xOrd: str
    rOrd: str
    t: hou.Vector3
    r: hou.Vector3
    s: hou.Vector3
    p: hou.Vector3
    pr: hou.Vector3


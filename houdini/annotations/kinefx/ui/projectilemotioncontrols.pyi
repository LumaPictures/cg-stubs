from collections.abc import Collection, Container, Iterable, Sequence
from typing import Protocol, TypeAlias

import hou
from houtypes import (
    ViewerStateDrawKwargs,
    ViewerStateEnterKwargs,
    ViewerStateEventKwargs,
    ViewerStateHandleToStateKwargs,
    ViewerStateKwargs,
    ViewerStateMenuActionKwargs,
    ViewerStateMenuPreOpenKwargs,
    ViewerStateParmChangeKwargs,
    ViewerStateSelectionKwargs,
    ViewerStateStateToHandleKwargs,
)
from kinefx.ui.pendulummotioncontrols import _Handle, _StateParms, _VerbParms
from kinefx.ui.selectabledrawable import (
    KinefxSelectableDrawable,
    KinefxSelectableDrawableCollection,
)

# The xform handle: a hou.Handle, or the state's MockHandle stand-in.
class _XformHandle(_Handle, Protocol):
    def enableParms(self, parm_names: Sequence[str], /) -> object: ...
    def disableParms(self, parm_names: Sequence[str], /) -> object: ...

# The projectile node parameters a control change sets (methods and sources are ints, targets
# floats or positions).
_NodeParms: TypeAlias = dict[str, float | hou.Vector3]

def_launch_menu_items: list[tuple[str, str]]
launch_enum_lookup: dict[str, int]
def_targeting_menu_items: list[tuple[str, str]]
targeting_enum_lookup: dict[str, int]
def_end_condition_menu_items: list[tuple[str, str]]
end_condition_enum_lookup: dict[str, int]

def addRadioStripMenu(menu: hou.ViewerStateMenu, name: str, label: str, menu_items: Sequence[tuple[str, str]]) -> None: ...
def findMenuIndex(menu: Iterable[tuple[str, str]], key: str) -> int: ...
# Returns items itself when keys is None.
def reduceMenuItemList(keys: Container[str] | None, items: list[tuple[str, str]]) -> list[tuple[str, str]]: ...
def getReducedItemMenuIndices(keys: Container[str] | None, items: Collection[tuple[str, str]]) -> list[int]: ...

class KinefxProjectileMotionControls:
    scene_viewer: hou.SceneViewer
    xform_handle: _XformHandle
    motionpath_handle: _Handle | None
    use_projectile_num: bool
    delay_traj_computation: bool
    input_geos: Sequence[hou.Geometry] | None
    eval_proj: bool
    show_traj_guide: bool
    launch_menu_indices: list[int]
    targeting_menu_indices: list[int]
    end_condition_menu_indices: list[int]
    has_launch_method: bool
    has_targeting_method: bool
    has_end_condition: bool
    pack_verb: hou.SopVerb
    proj_verb: hou.SopVerb
    traj_verb: hou.SopVerb
    proj_geo: hou.Geometry
    proj_guide: hou.SimpleDrawable
    traj_geo: hou.Geometry
    traj_guide: hou.SimpleDrawable
    grid_verb: hou.SopVerb
    cube_verb: hou.SopVerb
    height_plane_geo: hou.Geometry
    height_plane_guide: KinefxSelectableDrawable
    height_plane_quat: hou.Quaternion
    start_pos_geo: hou.Geometry
    start_pos_guide: KinefxSelectableDrawable
    end_pos_geo: hou.Geometry
    end_pos_guide: KinefxSelectableDrawable
    selectable_collection: KinefxSelectableDrawableCollection
    selected_handle: int
    # Indices into the def_*_menu_items lists.
    launch_method: int
    targeting_method: int
    end_condition: int
    peak_pos: hou.Vector3
    peak_norm: hou.Vector3
    pos_init: hou.Vector3
    vel_init: hou.Vector3
    pos_final: hou.Vector3
    vel_final: hou.Vector3
    vel_inf: hou.Vector3
    def __init__(
        self,
        scene_viewer: hou.SceneViewer,
        xform_handle: _XformHandle,
        motionpath_handle: _Handle | None = ...,
        eval_proj: bool = ...,
        use_projectile_num: bool = ...,
        input_geos: Sequence[hou.Geometry] | None = ...,
        delay_traj_computation: bool = ...,
        show_traj: bool = ...,
        limit_menus_to_handles: bool = ...,
    ) -> None: ...
    def updateStateMenusFromProjMenus(self, state_parms: _StateParms | None = ...) -> None: ...
    def updateStateLaunchMethod(self, state_parms: _StateParms | None = ...) -> None: ...
    def updateStateTargetingMethod(self, state_parms: _StateParms | None = ...) -> None: ...
    def updateStateEndCondition(self, state_parms: _StateParms | None = ...) -> None: ...
    def onEnter(self, kwargs: ViewerStateEnterKwargs) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def bakeParmsForLifeTarget(self, do_set: bool = ...) -> dict[str, float]: ...
    def bakeParmsForHeight(self, do_set: bool = ...) -> dict[str, float]: ...
    def bakeParmsForHeightPlane(self, do_set: bool = ...) -> dict[str, hou.Vector3]: ...
    def bakeParmsForCurrentMethod(self) -> dict[str, float] | dict[str, hou.Vector3]: ...
    def bakeParmsForAllMethods(self, do_set: bool = ...) -> _NodeParms: ...
    def setSelectedHandle(self, kwargs: ViewerStateKwargs | None, handle: int) -> _NodeParms: ...
    def onLocatedSelection(self, kwargs: ViewerStateSelectionKwargs) -> None: ...
    def onSelection(self, kwargs: ViewerStateSelectionKwargs) -> _NodeParms: ...
    # KinefxSelectableDrawableCollection.drawableMask() builds the mask but doesn't return it.
    def drawableMask(self) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs, drawable_selector: str) -> tuple[bool, _NodeParms]: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onStateToMotionPathHandle(
        self,
        kwargs: ViewerStateStateToHandleKwargs,
        path_geo: hou.Geometry | None = ...,
        key_source_times: Sequence[float] | None = ...,
        source_time_attr: hou.Attrib | None = ...,
    ) -> None: ...
    def onStateToXformHandle(self, kwargs: ViewerStateStateToHandleKwargs) -> None: ...
    def onXformHandleToState(self, kwargs: ViewerStateHandleToStateKwargs) -> _NodeParms: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> _NodeParms: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> _NodeParms: ...
    def nodeParms(self) -> dict[str, hou._VerbParmValue]: ...
    def setNodeParmsFromNode(self, node: hou.OpNode, state_parms: _StateParms | None = ..., select_handle: bool = ...) -> None: ...
    def setNodeParms(self, parms: _VerbParms, state_parms: _StateParms | None = ..., select_handle: bool = ...) -> None: ...
    def setLaunchMethod(self, launch_method: int, state_parms: _StateParms | None) -> None: ...
    def setTargetingMethod(self, targeting_method: int, state_parms: _StateParms | None) -> None: ...
    def setEndCondition(self, end_condition: int, state_parms: _StateParms | None) -> None: ...
    def inMinimalEnergyMode(self) -> bool: ...
    def trajectoryGeometry(self) -> hou.Geometry: ...
    def trajectoryParm(self, parm: str) -> hou._VerbParmValue: ...
    def setInputGeometry(self, input_geos: Sequence[hou.Geometry] | None) -> None: ...
    def computeHeightPlanePos(self) -> hou.Vector3: ...
    def setLife(self, input_geos: Sequence[hou.Geometry], life: float, state_parms: _StateParms | None = ...) -> _NodeParms: ...
    def setDisplayGeometry(self, input_geos: Sequence[hou.Geometry] | None = ..., life: float | None = ...) -> None: ...
    def life(self) -> float: ...
    def startPosition(self) -> hou.Vector3: ...
    def targetPosition(self) -> hou.Vector3: ...
    @staticmethod
    def addDisplayOptionsToMenu(menu: hou.ViewerStateMenu, limit_menus_to_handles: bool = ...) -> None: ...
    @staticmethod
    def addDisplayParmsToState(template: hou.ViewerStateTemplate, use_projectile_num: bool = ..., use_motionpath: bool = ..., limit_menus_to_handles: bool = ...) -> None: ...

import hou

ALPHA_START: float
ALPHA_END: float

def buildLine() -> hou.Geometry: ...
def addBand(geo: hou.Geometry | None, ptnum: int, do_invert: bool, alpha_attrib: hou.Attrib | None = ...) -> None: ...

class RubberBand:
    geo: hou.Geometry
    target_pt_geo: hou.Geometry
    scene_viewer: hou.SceneViewer
    drawable: hou.GeometryDrawable
    target_point_params: hou._DrawableParams
    target_point_gd: hou.GeometryDrawable
    def __init__(self, scene_viewer: hou.SceneViewer) -> None: ...
    @property
    def start(self) -> hou.Vector3: ...
    @start.setter
    def start(self, pos: hou.Vector3) -> None: ...
    @property
    def end(self) -> hou.Vector3: ...
    @end.setter
    def end(self, pos: hou.Vector3) -> None: ...
    def snap(self, on: bool) -> None: ...
    def show(self, on: bool) -> None: ...
    def draw(self, handle: int) -> None: ...

class RubberBandSet:
    geo: hou.Geometry
    target_pt_geo: hou.Geometry
    scene_viewer: hou.SceneViewer
    drawable: hou.GeometryDrawable
    target_point_params: hou._DrawableParams
    target_point_gd: hou.GeometryDrawable
    def __init__(self, scene_viewer: hou.SceneViewer) -> None: ...
    def getStartPoint(self, index: int) -> hou.Vector3: ...
    def setStartPoint(self, index: int, pos: hou._FloatSequence) -> None: ...
    def setNumStartPoints(self, num: int) -> None: ...
    def clearStartPoints(self) -> None: ...
    @property
    def end(self) -> hou.Vector3: ...
    @end.setter
    def end(self, pos: hou.Vector3) -> None: ...
    @property
    def doInvert(self) -> bool: ...
    @doInvert.setter
    def doInvert(self, do_invert: bool) -> None: ...
    def snap(self, on: bool) -> None: ...
    def show(self, on: bool) -> None: ...
    def draw(self, handle: int) -> None: ...

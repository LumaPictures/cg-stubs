from collections.abc import Callable, Collection, Iterable, Sequence
from typing import Literal, ReadOnly, Required, TypeAlias, TypedDict, TypeIs, TypeVar, type_check_only

import hou
from houtypes import NodeEventKwargs, ParmActionButtonKwargs, ParmMenuScriptKwargs
from kinefx.ui.rigtreeconfig import GroupRigTreeConfig
from kinefx.ui.rigtreewidget import RigTreeWidget, selection_item
from typing_extensions import Unpack

_T = TypeVar("_T")

# A rig tree item's ITEM_ID_ROLE data: a point number (joints), or a node path (OBJ level) or
# packed folder path (packed folders).
_ItemId: TypeAlias = int | str
# A selection as a state's "getselection" command gives it (rigtreeselect's hou.Selection, other
# states' point numbers) or a packed folders parm gives it (folder paths).
_TreeSelection: TypeAlias = hou.Selection | list[int] | list[str]

# What a rig tree config's select callback (the views' selection handler) gets, as far as
# rigtreeutils.select() reads it: configs add the input/output/node path to select from, and
# callers outside the tree (charpicker) pass a pick modifier.
class _SelectArgs(TypedDict, total=False):
    selection: Required[Sequence[_ItemId]]
    inputindex: int
    outputindex: int
    nodepath: str
    pick_mod: hou.EnumValue[hou.pickModifier]

# What the rig tree views pass their selection handler.
class _SelectKwargs(_SelectArgs, total=False):
    selected: Required[Sequence[_ItemId]]
    deselected: Required[Sequence[_ItemId]]

# What get_selection_and_geo() and get_selection_parm_string() read: a get_selection callback's
# dictionary, or ScriptSelectionHandler's node event dictionary.
class _SelectionSourceArgs(TypedDict, total=False):
    node: Required[ReadOnly[hou.OpNode | None]]
    event_type: Required[ReadOnly[hou.EnumValue[hou.nodeEventType] | None]]
    input_node: ReadOnly[hou.OpNode | None]
    nodepath: ReadOnly[str | None]
    parm_name: ReadOnly[str]
    folders_mode: ReadOnly[bool]

# What RigTreeWidget.updateSelectionFromNode() passes a config's get_selection callback, which
# marks the items to select; configs add the other keys before handing it to the helpers here.
class _GetSelectionKwargs(TypedDict, total=False):
    node: Required[hou.OpNode | None]
    items: Required[list[selection_item]]
    event_type: Required[hou.EnumValue[hou.nodeEventType] | None]
    input_node: Required[hou.OpNode | None]
    parm_name: str
    folders_mode: bool
    nodepath: str
    outputindex: int
    default_output: int
    states: list[str]

class _GetSelectionsArgs(TypedDict, total=False):
    node: ReadOnly[hou.OpNode | None]

# StateRigTreeConfig.runStateCommand() marks the commands it runs (but getselection and
# available_actions) to clear the state's UI event.
class _StateCommandKwargs(TypedDict, total=False):
    clear_ui_event: bool

# What a config's drag_drop callback gets (the dragged items, their parents and the drop target).
class _DragDropKwargs(_StateCommandKwargs, total=False):
    items: Required[list[_ItemId]]
    old_parent_items: Required[list[_ItemId | None]]
    new_parent_item: Required[_ItemId | None]

class _RenameKwargs(_StateCommandKwargs, total=False):
    item: Required[_ItemId]
    selection: Required[list[_ItemId]]
    old_name: Required[str]
    new_name: Required[str]

class _DeleteKwargs(_StateCommandKwargs, total=False):
    selection: Required[list[_ItemId]]

# An entry of the context menu actions an available_actions callback returns (None for a
# "separator..." entry).
class _RigAction(TypedDict, total=False):
    action: Callable[[], object]
    enable: bool

class _ActionsKwargs(_StateCommandKwargs, total=False):
    selection: Required[list[_ItemId]]
    current_item: Required[_ItemId | None]
    actions: dict[str, _RigAction | None]

# A config's default_output callback sets the output to show, whether to show the outputs
# dropdown and whether to list a subnet's outputs.
class _DefaultOutputKwargs(TypedDict):
    node: hou.OpNode | None
    default_output: int
    show_dropdown: bool
    subnet_outputs: bool

class _ControlVisibilityKwargs(TypedDict):
    show_accept_button: bool
    show_cancel_button: bool

# A python panel showing the rig_tree interface (its root widget is None until the interface is
# created).
@type_check_only
class _RigTreePanel(hou.PythonPanel):
    def activeInterfaceRootWidget(self) -> RigTreeWidget | None: ...


from collections.abc import Callable, Mapping
from typing import Any, Literal, Protocol, Required, TypeAlias

import hou
from kinefx.ui.rigtreeutils import (
    SelectionMode,
    _ActionsKwargs,
    _ControlVisibilityKwargs,
    _DefaultOutputKwargs,
    _DeleteKwargs,
    _DragDropKwargs,
    _GetSelectionKwargs,
    _RenameKwargs,
    _RigAction,
    _SelectKwargs,
    _StateCommandKwargs,
)
from kinefx.ui.rigtreewidget import RigTreeWidget

# What the rigtreeconfig(widget) function of an HDA's rigtreeconfig section returns, when it isn't
# one of the classes here: load_user_module sets the FUNCTION_NAMES callbacks it lacks to None.
# The widget also looks up nodePath, state_name, selection_mode, accept_selection,
# cancel_selection and get_control_visibility, but only with getattr() or in a try block.
class _UserRigTreeConfig(Protocol):
    @property
    def available_actions(self) -> Callable[[_ActionsKwargs], Mapping[str, _RigAction | None] | None] | None: ...
    @property
    def select(self) -> Callable[[_SelectKwargs], object] | None: ...
    @property
    def drag_drop(self) -> Callable[[_DragDropKwargs], object] | None: ...
    @property
    def default_output(self) -> Callable[[_DefaultOutputKwargs], object] | None: ...
    @property
    def rename(self) -> Callable[[_RenameKwargs], object] | None: ...
    @property
    def get_selection(self) -> Callable[[_GetSelectionKwargs], object] | None: ...
    @property
    def delete(self) -> Callable[[_DeleteKwargs], object] | None: ...

# What get_selection() passes the state's "getselection" command, which fills in the selected
# point numbers (and sets ret to False when it has no geometry).
class _GetSelectionCommandArgs(_StateCommandKwargs, total=False):
    selection: Required[list[int]]
    ret: bool

# A rig tree config: one of these classes, or an HDA's own.
_RigTreeConfig: TypeAlias = "InitConfig | GroupRigTreeConfig | StateRigTreeConfig | _UserRigTreeConfig"

FUNCTION_NAMES: list[str]

class ConfigException(Exception):
    def text(self) -> str: ...

def load_user_module(widget: RigTreeWidget, node: hou.OpNode) -> _RigTreeConfig | None: ...
def getargc(f: Callable[..., object]) -> int: ...

class InitConfig:
    # Bound by __init__ from the section's global functions of these names, None when missing.
    available_actions: Callable[[_ActionsKwargs], Mapping[str, _RigAction | None] | None] | None
    select: Callable[[_SelectKwargs], object] | None
    drag_drop: Callable[[_DragDropKwargs], object] | None
    default_output: Callable[[_DefaultOutputKwargs], object] | None
    rename: Callable[[_RenameKwargs], object] | None
    get_selection: Callable[[_GetSelectionKwargs], object] | None
    delete: Callable[[_DeleteKwargs], object] | None
    # Any: the globals of the executed section, whatever it defines (the callbacks among them are
    # called).
    def __init__(self, exec_res: Mapping[str, Any] | None = ...) -> None: ...
    @property
    def state_name(self) -> None: ...
    @property
    def selection_mode(self) -> Literal[SelectionMode.MULTI_SELECTION]: ...
    @property
    def nodePath(self) -> None: ...

class GroupRigTreeConfig:
    def __init__(
        self,
        show_dropdown: bool = ...,
        parm_name: str = ...,
        input_index: int = ...,
        node_path: str | None = ...,
        accept_selection_cb: Callable[[], object] | None = ...,
        cancel_selection_cb: Callable[[], object] | None = ...,
        single_selection: bool = ...,
        folders_mode: bool = ...,
        select_cb: Callable[[_SelectKwargs], None] | None = ...,
        subnet_outputs: bool = ...,
    ) -> None: ...
    @property
    def single_selection(self) -> bool: ...
    @single_selection.setter
    def single_selection(self, single_selection: bool) -> None: ...
    @property
    def nodePath(self) -> str | None: ...
    @nodePath.setter
    def nodePath(self, selection_node_path: str | None) -> None: ...
    def inputIndex(self) -> int: ...
    def parmName(self) -> str: ...
    def parmString(self) -> str: ...
    def default_output(self, kwargs: _DefaultOutputKwargs) -> None: ...
    def get_control_visibility(self, kwargs: _ControlVisibilityKwargs) -> None: ...
    def get_selection(self, kwargs: _GetSelectionKwargs) -> Literal[True]: ...
    def select(self, kwargs: _SelectKwargs) -> None: ...

class StateRigTreeConfig:
    def __init__(self, widget: RigTreeWidget | None = ..., default_output: int = ..., show_dropdown: bool = ..., subnet_outputs: bool = ...) -> None: ...
    @property
    def state_name(self) -> str | None: ...
    @state_name.setter
    def state_name(self, state_name: str | None) -> None: ...
    @property
    def selection_mode(self) -> SelectionMode: ...
    @selection_mode.setter
    def selection_mode(self, selection_mode: SelectionMode) -> None: ...
    @property
    def nodePath(self) -> str | None: ...
    @nodePath.setter
    def nodePath(self, selection_node_path: str | None) -> None: ...
    # The state command's arguments: a callback's dictionary, or a getselection one.
    def runStateCommand(self, command: str, kwargs: _StateCommandKwargs | _GetSelectionCommandArgs) -> bool: ...
    def default_output(self, kwargs: _DefaultOutputKwargs) -> None: ...
    def get_selection(self, kwargs: _GetSelectionKwargs) -> bool: ...
    def select(self, kwargs: _SelectKwargs) -> None: ...
    def drag_drop(self, kwargs: _DragDropKwargs) -> bool: ...
    def rename(self, kwargs: _RenameKwargs) -> bool: ...
    def delete(self, kwargs: _DeleteKwargs) -> bool: ...
    def available_actions(self, kwargs: _ActionsKwargs) -> dict[str, _RigAction | None]: ...

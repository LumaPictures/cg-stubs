from typing import Never

import hou

def getBlendShapeChannels(geo: hou.Geometry | None, force_variablename: bool = ...) -> list[str]: ...
def getBlendShapeNames(geo: hou.Geometry | None) -> list[str]: ...
def getBlendShapeInBetweenNames(geo: hou.Geometry | None) -> list[str]: ...
# A tuple of the float detail attributes, without clipchannels.
def getBlendShapeChannelsFromSkeleton(
    geo: hou.Geometry | None, read_clipchannels_only: bool = ...
) -> list[str] | tuple[str, ...]: ...
def generateBlendShapeMenu(
    node: hou.SopNode,
    inputindex: int = ...,
    force_variablename: bool = ...,
    use_channels: bool = ...,
    duplicate_names: bool = ...,
) -> list[str]: ...
def generateBlendShapeInBetweenMenu(node: hou.SopNode, inputindex: int = ...) -> list[str]: ...
# Returns an empty dict when the input lacks the blend shape attributes.
def selectBlendShape(
    node: hou.SopNode, parmtuple: hou.ParmTuple, inputindex: int = ..., exclusive: bool = ...
) -> dict[str, Never] | None: ...
def selectBlendShapeInBetween(
    node: hou.SopNode, parmtuple: hou.ParmTuple, inputindex: int = ..., exclusive: bool = ...
) -> dict[str, Never] | None: ...

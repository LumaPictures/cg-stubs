from collections.abc import Callable, MutableSequence, Sequence
from typing import TypeVar, Unpack, type_check_only

import _houqt
import hou
from houtypes import NodeEventKwargs
from kinefx.mixer import Mixer, _MixerItemDict, _MixerNode
from kinefx.ui.mixerpane import _DelayedChange

_NodeT = TypeVar("_NodeT", bound=hou.Node | None)

class MixerPaneRebuild:
    myNodes: list[_MixerNode | None]
    myMixers: list[Mixer | None] | None
    myDelayedSelection: list[str]
    myDelayedRebuildNodes: list[_MixerNode | None] | None
    myDelayedRebuildCaller: Callable[[], object] | None
    myCurrentMixerIndex: int
    myPathGadget: _houqt.NLE_QtMotionMixerPathGadget
    myTimeline: _houqt.NLE_Timeline
    @type_check_only
    def addEventCallback(
        self,
        node: hou.OpNode,
        event_types: Sequence[hou.EnumValue[hou.nodeEventType]],
        cb: hou._NodeEventCallback,
    ) -> None: ...
    @type_check_only
    def createMenus(self) -> None: ...
    @type_check_only
    def getMixerNode(self, node_: hou.Node | None, from_userdata: bool = ...) -> _MixerNode | None: ...
    @type_check_only
    def getNleSelectedItems(self) -> list[_MixerItemDict]: ...
    @type_check_only
    def initEffects(self) -> bool: ...
    @type_check_only
    def onInputDataChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    @type_check_only
    def onNodePathChanged(self, node: hou.Node | None = ...) -> None: ...
    @type_check_only
    def onParmTupleAnimated(self, **kwargs: Unpack[NodeEventKwargs]) -> bool | None: ...
    @type_check_only
    def onParmTupleChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> bool | None: ...
    @type_check_only
    def onParmTupleChannelChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> bool | None: ...
    @type_check_only
    def onSpareParmChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    @type_check_only
    def postDelayChange(self, change: _DelayedChange) -> None: ...
    @type_check_only
    def removeEventCallback(
        self,
        node: hou.OpNode,
        event_types: Sequence[hou.EnumValue[hou.nodeEventType]],
        cb: hou._NodeEventCallback,
    ) -> None: ...
    @type_check_only
    def setCurrentTrack(self, i: int, mi: int) -> None: ...
    @type_check_only
    def updateSelection(
        self,
        items: Sequence[_MixerItemDict],
        expanditems: None = ...,
        updating_nle: bool = ...,
        updating_node_sel: bool = ...,
        fx_tool: bool = ...,
        emit_signals: bool = ...,
    ) -> None: ...
    # nodes: filterMixerNodes()'s result, which it keeps as myNodes.
    def rebuildScene(self, nodes: list[_MixerNode] | None) -> None: ...
    def fixupClipNames(self, node: hou.OpNode) -> None: ...
    # Returns the nodes' mixer nodes, without duplicates; it also writes them (and None for the
    # others) to mixer_nodes.
    def filterMixerNodes(self, mixer_nodes: MutableSequence[_NodeT] | None) -> list[_MixerNode]: ...
    def onRebuildScene(self) -> None: ...
    def delayedRefreshScene(self) -> None: ...
    def refreshScene(self) -> None: ...
    def clearScene(self) -> None: ...
    def delayedClearScene(self) -> None: ...
    def delayedRebuildScene(
        self, nodes: MutableSequence[_NodeT] | None, caller: Callable[[], object] | None = ...
    ) -> None: ...

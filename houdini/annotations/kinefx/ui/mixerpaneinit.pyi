from collections.abc import Callable, Iterable
from typing import type_check_only

import _houqt
import hou
from kinefx.mixer import _MixerNode
from kinefx.mixerfx import _FXDict
from kinefx.ui.mixerpaneactions import _SelectedItem
from PySide6 import QtGui, QtWidgets

# A mixin of MixerPane (as are MixerPaneActions, MixerPaneRebuild, MixerPaneEvents and
# MixerPaneSelection): each declares the members of MixerPane and of the other parts that its
# methods use (the methods @type_check_only, with their owners' signatures).
class MixerPaneInit:
    myRegisterEffects: list[dict[str, _FXDict]]
    myLastRegisterEffectsIndex: int
    myMenuWidget: QtWidgets.QWidget | None
    myMenuBar: hou.qt.MenuBar
    myMenuMaxHeight: int
    myIconSize: int
    mySmallFont: QtGui.QFont
    myMuteIcon: hou.qt.Icon
    mySoloIcon: hou.qt.Icon
    myLockIcon: hou.qt.Icon
    myPinnedIcon: hou.qt.Icon
    myUnPinnedIcon: hou.qt.Icon
    # The toolbar buttons, which createMenus() sets by name.
    myAddTrackButton: QtWidgets.QToolButton
    myAddMarkerButton: QtWidgets.QToolButton
    myBakeButtons: QtWidgets.QToolButton
    mySplitButton: QtWidgets.QToolButton
    myMatchJointsButtons: QtWidgets.QToolButton
    myRefreshButton: QtWidgets.QToolButton
    myPinButton: QtWidgets.QPushButton
    # Only with mixerutils.theEnableDebugging.
    myDebugButton: QtWidgets.QToolButton
    myCurrentMixerIndex: int
    myEffectIcons: dict[str, hou.qt.Icon]
    myNodes: list[_MixerNode | None]
    myPaneTab: hou.PythonPanel
    myTimelineView: _houqt.NLE_QtMotionMixer
    @type_check_only
    def onAddEffectLambda(self, fxtype: str) -> Callable[[], None]: ...
    @type_check_only
    def onAddMarkerAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onAddTrackAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onAddTransitionAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onBakeAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onBakeToOverrideAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onCopyAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onCreateNestedAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onCutAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onDeleteMenuAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onExtractNestedAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onFrameAllAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onFrameSelectionAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onGoInto(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onGoUp(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onMatchJointsAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onMinimizeTrackHeightsAction(self) -> None: ...
    @type_check_only
    def onPasteAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onPasteValuesAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onPinAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onRefreshAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onResetClipRangeAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onResetTrackHeightsAction(self) -> None: ...
    @type_check_only
    def onSetCycleRangeAction(
        self, checked: bool = ..., sel_items: Iterable[_SelectedItem] | None = ...
    ) -> None: ...
    @type_check_only
    def onShowDetailsAction(self) -> None: ...
    @type_check_only
    def onShowHideMenuAction(self) -> None: ...
    @type_check_only
    def onShowHidePaneTabBarAction(self) -> None: ...
    @type_check_only
    def onSplitAction(self, checked: bool = ...) -> None: ...
    @type_check_only
    def onToggleDebug(self) -> None: ...
    def registerEffects(self, mi: int) -> bool: ...
    def initEffects(self) -> bool: ...
    def createMenus(self) -> None: ...
    def refreshMenus(self) -> None: ...
    def onGoToMenuAboutToShow(self) -> None: ...
    def onSnapMenuAboutToShow(self) -> None: ...
    def onViewMenuAboutToShow(self) -> None: ...
    def getFxIcon(self, etype: str, mi: int) -> hou.qt.Icon | None: ...
    def getMixerNode(self, node_: hou.Node | None, from_userdata: bool = ...) -> _MixerNode | None: ...

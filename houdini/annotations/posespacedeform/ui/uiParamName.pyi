from typing import Unpack

import hou
from houtypes import NodeEventKwargs

from posespacedeform.ui.uiParamString import UiParamString

class UiParamName(UiParamString):
    linkednode: hou.OpNode | None
    parmname: None
    currenttext: str
    recook_node: hou.SopNode | None
    def __init__(
        self, label: str | None, node: hou.OpNode | None = ..., default_text: str = ..., recook: hou.SopNode | None = ...
    ) -> None: ...
    def linkParm(self, node: hou.OpNode) -> None: ...
    def onNameChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def onTextChanged(self) -> None: ...
    def unlinkParm(self) -> None: ...
    def getText(self) -> str: ...
    def setText(self, text: str) -> None: ...

import argparse
from collections import OrderedDict
from collections.abc import Callable, Generator, Iterable, Mapping, Sequence
from datetime import date, datetime, timedelta, tzinfo
from decimal import Decimal
from typing import IO, Any, Literal, Protocol, Self, TypeAlias, TypeVar, TypeVarTuple, Unpack

import _parsepeakusagelog
from xlsxwriter.format import Format
from xlsxwriter.worksheet import Worksheet

_Ts = TypeVarTuple("_Ts")

# A log is read by the C++ _parsepeakusagelog parser when it is available, and
# by the Python classes below otherwise.
_AnyUsageLog: TypeAlias = "UsageLog | _parsepeakusagelog.UsageLog"
_AnyLogSection: TypeAlias = "LogSection | _parsepeakusagelog.LogSection"
_AnyUsageInterval: TypeAlias = "UsageInterval | _parsepeakusagelog.UsageInterval"
_AnyPeakLicenseUsage: TypeAlias = "PeakLicenseUsage | _parsepeakusagelog.PeakLicenseUsage"
_AnyUser: TypeAlias = "User | _parsepeakusagelog.User"
_SectionT = TypeVar("_SectionT", bound="LogSection | _parsepeakusagelog.LogSection")
# (product,) or (product, version)
_ProductKey: TypeAlias = tuple[str] | tuple[str, Decimal]

class _LocalizingTimeZone(Protocol):
    def localize(self, dt: datetime, /) -> datetime: ...

class _TableWriter(Protocol):
    def writeheader(self) -> object: ...
    def writerow(self, rowdict: Mapping[str, object], /) -> object: ...

class _ClosableTableWriter(_TableWriter, Protocol):
    def close(self) -> object: ...

class _TableWriterFactory(Protocol):
    def __call__(self, name: str, fieldnames: Sequence[str]) -> _ClosableTableWriter: ...

HAS_USAGEPARSER: bool
HAS_TZLOCAL: bool
HAS_PYTZ: bool
HAS_XLSX: bool
TZNAME_AND_OFFSET_TO_ZONE_NAME: dict[str, str]
CURRENT_YEAR: int
PRODUCT_NAME_MAP: OrderedDict[str, str]
HAS_DISPLAYED_TZLOCAL_WARNING: bool

def tzname_and_offset_str(time_zone: tzinfo, dt: datetime) -> str: ...
def compute_tzname_and_offset_to_zone_name() -> None: ...

class SimpleLocalTimeZone(tzinfo):
    def __init__(self) -> None: ...
    def utcoffset(self, dt: datetime | None) -> timedelta: ...
    def tzname(self, dt: datetime | None) -> str: ...
    def dst(self, dt: datetime | None) -> timedelta: ...
    def localize(self, dt: datetime) -> datetime: ...

class License:
    license_id: str
    product: str
    version: Decimal
    quantity: int
    expires: datetime
    ip_mask: str
    platform: str
    server_name: str
    def __init__(
        self,
        license_id: str,
        product: str,
        version: Decimal,
        quantity: int,
        expires: datetime,
        ip_mask: str,
        platform: str,
        server_name: str,
    ) -> None: ...
    @staticmethod
    def convert_expires_to_str(expires: datetime | str) -> str: ...
    @classmethod
    def parse(cls, value: str) -> Self: ...
    def simple_product_name(self) -> str: ...
    def as_string(self) -> str: ...

class CombinedLicense:
    product: str
    version: Decimal
    def __init__(self, product: str, version: Decimal | None = ...) -> None: ...
    def simple_product_name(self) -> str: ...

class User:
    username_and_machine: str
    def __init__(self, username_and_machine: str) -> None: ...
    def __lt__(self, user: "User") -> bool: ...

class UsageLog:
    sections: "list[LogSection]"
    license_id_to_license: dict[str, License]
    user_string_to_user: dict[str, User]
    def __init__(self) -> None: ...
    def remove_section(self, index: int) -> None: ...
    def debug_info(self) -> str: ...
    def contents(
        self,
    ) -> "Generator[tuple[LogSection, UsageInterval, PeakLicenseUsage], None, None]": ...
    def user_contents(
        self,
    ) -> "Generator[tuple[LogSection, UsageInterval, PeakLicenseUsage, User], None, None]": ...
    def parse_license(self, license_string: str) -> License: ...
    def find_or_create_user(self, user_string: str) -> User: ...
    def first_timestamp(self) -> float | None: ...
    def last_timestamp(self) -> float | None: ...
    def merge_to_one_section(self) -> None: ...
    def merge_overlapping_sections(self) -> None: ...
    def combine_usages_by_product(self, separate_versions: bool = ...) -> None: ...

def is_sesinetd_version_ok(section: _AnyLogSection) -> bool: ...
def should_delete_data_because_of_version(section: _AnyLogSection) -> bool: ...

class LogSection:
    # parse_public_key() returns False when the key can't be read.
    public_key: str | Literal[False]
    prev_signature: bytes
    time_interval_in_s: int
    intervals: "list[UsageInterval]"
    messages: list[str]
    variables: dict[str, str]
    vmaj: int
    vmin: int
    vbuild: int
    def __init__(self, major: int = ..., minor: int = ..., build: int = ...) -> None: ...
    def debug_info(self) -> str: ...
    def version_tuple(self) -> tuple[int, int, int]: ...
    def version_str(self) -> str: ...
    def set_version(self, version_seq: Sequence[int]) -> None: ...
    def calc_timestamp(self, value: int) -> int: ...
    def record_license_peak(self, license: License, peak: int) -> None: ...
    def add_license_user(self, user: User) -> None: ...

def log_last_timestamp(log: _AnyUsageLog) -> float | None: ...
def group_section_intervals(
    section: _SectionT, group_by: str, time_zone: tzinfo | None, take_max: bool
) -> _SectionT: ...

class UsageInterval:
    # Grouping and aligning can store float timestamps.
    timestamp: float
    usages: "list[PeakLicenseUsage]"
    def __init__(self, timestamp: float) -> None: ...
    def debug_info(self) -> str: ...
    def combine_usages_by_product(
        self,
        key_to_combined_license: Mapping[_ProductKey, CombinedLicense],
        separate_versions: bool,
    ) -> None: ...
    def merge(self, merge_in_interval: "UsageInterval", take_max: bool) -> None: ...

class PeakLicenseUsage:
    license: License | CombinedLicense
    peak: int
    users: list[User]
    def __init__(self, license: License | CombinedLicense, peak: int) -> None: ...
    def __repr__(self) -> str: ...

# Every exporter's export() returns None.
def parse_transform_and_export_data(parser: "UsageParser") -> Literal[False] | None: ...
def transform_data(parser: "UsageParser") -> None: ...
def export_data(
    parser: "UsageParser", exporter_class: "type[CSVExporter] | type[MySQLExporter]"
) -> None: ...
def write_progress_line(args: argparse.Namespace, value: str) -> None: ...
def align_interval_starts(
    logs: Iterable[_AnyUsageLog], group_by: str, time_zone: tzinfo | None
) -> None: ...
def merge_logs(logs: Iterable[_AnyUsageLog]) -> None: ...
def hour_for_timestamp(timestamp: float, time_zone: tzinfo | None) -> float: ...
def day_for_timestamp(timestamp: float, time_zone: tzinfo | None) -> float: ...
def month_for_timestamp(timestamp: float, time_zone: tzinfo | None) -> float: ...
def local_time_zone() -> tzinfo: ...
def best_guess_timezone_from_name(tz_name: str) -> tzinfo | None: ...
def timestamp_to_datetime_in_time_zone(timestamp: float, time_zone: tzinfo | None) -> datetime: ...
def date_and_time_zone_to_timestamp(dt: date, time_zone: _LocalizingTimeZone) -> float: ...
def date_and_time_zone_to_datetime(dt: date, time_zone: _LocalizingTimeZone) -> datetime: ...
def datetime_to_timestamp(value: datetime) -> float: ...

class UsageParser:
    args: argparse.Namespace | None
    log: _AnyUsageLog | None
    num_bytes_to_read: int
    num_bytes_read: int
    progress_percentage: int
    start_date: date | None
    end_date: date | None
    start_time_timestamp: float | None
    end_time_timestamp: float | None
    skip_this_time_interval: bool
    time_zone: tzinfo | None
    time_zone_in_log: tzinfo | None
    signed_data: bytearray
    index_to_user: dict[int, User]
    index_to_license: dict[int, License]
    only_license_id_set: set[str] | None
    def __init__(self) -> None: ...
    def configure(self, args: Sequence[str] | None = ...) -> None: ...
    def add_parser_options(self, parser: argparse.ArgumentParser) -> None: ...
    def parse(self) -> bool: ...
    def remove_sections_with_invalid_versions(self) -> None: ...
    def parse_open_file(self, open_file: IO[bytes]) -> bool: ...
    def timestamp_is_to_be_skipped(self, timestamp: float) -> bool: ...
    def verify_signature(self, cur_bytes: bytearray, open_file: IO[bytes]) -> bool: ...
    def parse_four_cc(self, open_file: IO[bytes]) -> bool: ...
    def parse_signature(self, cur_bytes: bytearray, open_file: IO[bytes]) -> str | None: ...
    def parse_public_key(
        self, cur_bytes: bytearray, open_file: IO[bytes]
    ) -> str | Literal[False]: ...
    def read_str(self, open_file: IO[bytes], length: int, is_signed_data: bool = ...) -> str: ...
    def read_bytes(
        self,
        open_file: IO[bytes],
        cur_bytes: bytearray,
        count: int = ...,
        is_signed_data: bool = ...,
    ) -> bool: ...
    def parse_time_period_length(self, cur_bytes: bytearray, open_file: IO[bytes]) -> int: ...
    def parse_log_message(self, cur_bytes: bytearray, open_file: IO[bytes]) -> str: ...
    def parse_index_to_string_mapping(
        self, cur_bytes: bytearray, open_file: IO[bytes]
    ) -> tuple[int, int, str]: ...
    def parse_variable(self, cur_bytes: bytearray, open_file: IO[bytes]) -> list[str]: ...
    def parse_time_period_end_marker(self, cur_bytes: bytearray, open_file: IO[bytes]) -> int: ...
    def parse_variable_length_int(self, cur_bytes: Iterable[int]) -> int: ...

class Exporter:
    log: _AnyUsageLog
    args: argparse.Namespace
    time_zone: tzinfo
    def __init__(self, log: _AnyUsageLog, args: argparse.Namespace, time_zone: tzinfo) -> None: ...
    def create_export_dir(self) -> None: ...
    def output_file_path(self, file_name: str) -> str: ...

class MySQLExporter(Exporter):
    user_to_id: dict[_AnyUser, int]
    def export(self) -> None: ...
    def output_usage_table_values(self, sql_lines: list[str]) -> None: ...
    def output_user_table_values(self, sql_lines: list[str]) -> None: ...
    def format_user_row(self, user_index: int, user: _AnyUser) -> tuple[int, str, str]: ...
    def format_license_row(self, license: License) -> tuple[str, str, str, int, str, str]: ...
    def format_usage_row(
        self, section: _AnyLogSection, interval: _AnyUsageInterval, usage: _AnyPeakLicenseUsage
    ) -> tuple[str, float, int]: ...
    def format_user_usage_row(
        self,
        section: _AnyLogSection,
        interval: _AnyUsageInterval,
        usage: _AnyPeakLicenseUsage,
        user: _AnyUser,
    ) -> tuple[int, str, float]: ...
    def create_sql_lines(
        self,
        table_name: str,
        rows: Iterable[tuple[Unpack[_Ts]]],
        format_row: Callable[[Unpack[_Ts]], Iterable[object]],
    ) -> list[str]: ...

class CSVWriter:
    def __init__(self, name: str, fieldnames: Sequence[str], dialect: str | None) -> None: ...
    def writeheader(self) -> None: ...
    def writerow(self, row_info: Mapping[str, object]) -> None: ...
    def close(self) -> None: ...

def calc_cell_width(value: object, chars_to_widths: Mapping[str, float]) -> float: ...

class XLSXTableWriter:
    worksheet: Worksheet
    def __init__(
        self,
        worksheet: Worksheet,
        fieldnames: Sequence[str],
        chars_to_widths: Mapping[str, float],
        header_fmt: Format | None = ...,
        row: int = ...,
        col: int = ...,
    ) -> None: ...
    def writeheader(self) -> None: ...
    def writerow(self, row_info: Mapping[str, object]) -> None: ...
    def dimensions(self) -> tuple[int, int, int, int]: ...
    def data_dimensions(self) -> tuple[int, int, int, int]: ...
    def header_dimensions(self) -> tuple[int, int, int, int]: ...
    def find_index(self, field_name: str) -> int: ...
    def close(self) -> None: ...

class CSVExporter(Exporter):
    def create_string_timestamp(self, timestamp: float) -> str: ...
    def export_license_table(self, writer: _TableWriter) -> None: ...
    def export_user_table(self, writer: _TableWriter) -> None: ...
    def export_usage_tables(self, create_writer: _TableWriterFactory) -> None: ...
    def export(self) -> None: ...

class XLSXExporter(CSVExporter):
    def __init__(self, log: _AnyUsageLog, args: argparse.Namespace, timezone: tzinfo) -> None: ...
    def export(self) -> None: ...

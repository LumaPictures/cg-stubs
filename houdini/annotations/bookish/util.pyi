# A chain of maps: the wiki context the pipeline passes down (whose well-known keys are typed),
# a parser's context or a template's definitions.
class Context(object):
    map: MutableMapping[str, Any] | None
    parent: Self | None
    def __init__(self, m: MutableMapping[str, Any] | None = ..., parent: Self | None = ...) -> None: ...
    def __iter__(self, seen: set[str] | None = ...) -> Generator[str, None, None]: ...
    def __repr__(self) -> str: ...
    def top(self) -> MutableMapping[str, Any] | None: ...
    def has_keys(self) -> bool: ...
    def keys(self) -> Iterator[str]: ...
    def values(self) -> Generator[Any, None, None]: ...
    def items(self, seen: set[str] | None = ...) -> Generator[tuple[str, Any], None, None]: ...
    @overload
    def __getitem__(self, key: Literal["path", "lang"]) -> str: ...
    @overload
    def __getitem__(self, key: Literal["pages"]) -> WikiPages: ...
    @overload
    def __getitem__(self, key: Literal["searcher"]) -> WhooshSearcher | None: ...
    @overload
    def __getitem__(self, key: Literal["conditional", "save_to_cache", "profiling", "including"]) -> bool: ...
    @overload
    def __getitem__(self, key: Literal["include_history"]) -> frozenset[str]: ...
    @overload
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: object) -> None: ...
    def __contains__(self, key: object) -> bool: ...
    @overload
    def get(self, key: Literal["path", "lang"], default: None = ...) -> str | None: ...
    @overload
    def get(self, key: Literal["path", "lang"], default: _D) -> str | _D: ...
    @overload
    def get(self, key: Literal["pages"], default: None = ...) -> WikiPages | None: ...
    @overload
    def get(self, key: Literal["pages"], default: _D) -> WikiPages | _D: ...
    @overload
    def get(self, key: Literal["searcher"], default: None = ...) -> WhooshSearcher | None: ...
    @overload
    def get(self, key: Literal["searcher"], default: _D) -> WhooshSearcher | None | _D: ...
    @overload
    def get(self, key: Literal["conditional", "save_to_cache", "profiling", "including"], default: None = ...) -> bool | None: ...
    @overload
    def get(self, key: Literal["conditional", "save_to_cache", "profiling", "including"], default: _D) -> bool | _D: ...
    @overload
    def get(self, key: Literal["include_history"], default: None = ...) -> frozenset[str] | None: ...
    @overload
    def get(self, key: Literal["include_history"], default: _D) -> frozenset[str] | _D: ...
    @overload
    def get(self, key: str, default: object = ...) -> Any: ...
    def update(self, m: Mapping[str, object]) -> None: ...
    def push(self, m: MutableMapping[str, Any] | None = ...) -> Self: ...
    def first(self) -> MutableMapping[str, Any]: ...


import types
from collections.abc import Callable, Iterator
from collections.abc import Sequence as _Sequence
from typing import Any, ClassVar, Literal, TypeVar, overload

from bookish.avenue.avenue import AvenueContext

_RootT = TypeVar("_RootT")

class Pattern(object):
    def matches(self, ctx: AvenueContext, obj: object) -> Any: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Root(Pattern):
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...
    def pull(self, ctx: AvenueContext[_RootT], obj: object) -> Iterator[_RootT]: ...

class Lookup(Pattern):
    key: str
    def __init__(self, key: str) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool | None: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Slice(Pattern):
    start: int
    stop: int | None
    def __init__(self, start: int, stop: int | None = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool | None: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Star(Pattern):
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class TestPattern(Pattern):
    def matches(self, ctx: AvenueContext, obj: object) -> Any: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Comparison(TestPattern):
    ops: ClassVar[dict[str, Callable[[Any, Any], bool]]]
    name: str
    opname: str
    value: str | int
    fn: Callable[[Any], bool]
    @overload
    def __init__(self, name: str, opname: Literal["=~"], value: str) -> None: ...
    @overload
    def __init__(self, name: str, opname: str, value: str | int) -> None: ...
    def __repr__(self) -> str: ...

def run_code(ctx: AvenueContext, obj: object, code: types.CodeType) -> Any: ...

class Predicate(TestPattern):
    source: str
    code: types.CodeType
    def __init__(self, source: str) -> None: ...
    def __repr__(self) -> str: ...

class Union(Pattern):
    patterns: _Sequence[Pattern]
    def __init__(self, patterns: _Sequence[Pattern]) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Filter(Pattern):
    pattern: Pattern
    test: Pattern
    def __init__(self, pattern: Pattern, test: Pattern) -> None: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool | None: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Action(Pattern):
    source: str
    code: types.CodeType
    def __init__(self, source: str) -> None: ...
    def __repr__(self) -> str: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...

class Child(Pattern):
    left: Pattern
    right: Pattern
    def __init__(self, left: Pattern, right: Pattern) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, ctx: AvenueContext, obj: object) -> Any: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class Sequence(Pattern):
    patterns: _Sequence[Pattern]
    def __init__(self, patterns: _Sequence[Pattern]) -> None: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any] | None: ...

class Ancestor(Pattern):
    left: Pattern
    right: Pattern
    def __init__(self, left: Pattern, right: Pattern) -> None: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool | None: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

class App(Pattern):
    name: str
    patterns: _Sequence[Pattern]
    def __init__(self, name: str, patterns: _Sequence[Pattern]) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, ctx: AvenueContext, obj: object) -> bool: ...
    def pull(self, ctx: AvenueContext, obj: object) -> Iterator[Any]: ...

pattern_dict: dict[str, type[Pattern]]

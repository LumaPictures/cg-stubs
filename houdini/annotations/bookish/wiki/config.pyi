from collections.abc import Iterable, Mapping
from typing import Any

class Config(dict[str, Any]):
    root_path: str
    def __init__(self, root_path: str, defaults: Mapping[str, object] | None = ...) -> None: ...
    def from_envvar(self, variable_name: str, silent: bool = ...) -> bool: ...
    def from_pyfile(self, filename: str, silent: bool = ...) -> bool: ...
    def from_object(self, obj: object) -> None: ...
    def from_json(self, filename: str, silent: bool = ...) -> bool: ...
    def from_mapping(self, *mapping: Mapping[str, object] | Iterable[tuple[str, object]], **kwargs: object) -> bool: ...
    def __repr__(self) -> str: ...

import weakref
from collections.abc import Callable, Container, Generator, Mapping

import jinja2
from jinja2.runtime import Context as JinjaContext

from bookish.stores import Store
from bookish.wiki.wikipages import _WikiContent

class JinjaStoreLoader(jinja2.BaseLoader):
    store: weakref.ReferenceType[Store]
    prefix: str
    def __init__(self, store: Store, prefix: str = ...) -> None: ...
    def get_source(self, environment: jinja2.Environment, template_path: str) -> tuple[str, str | None, Callable[[], bool]]: ...
    def list_templates(
        self, extensions: Container[str] | None = ..., filter_func: Callable[[str], object] | None = ...
    ) -> Generator[str, None, None]: ...

class Stylesheet(object):
    env: jinja2.Environment
    templatename: str
    index_page_name: str
    def __init__(self, env: jinja2.Environment, templatename: str, index_page_name: str) -> None: ...
    def __repr__(self) -> str: ...
    @staticmethod
    def default_rule(jinctx: JinjaContext, obj: object, render: Callable[[JinjaContext, object], str]) -> str: ...
    def context_and_function(
        self, basepath: str, jsondata: _WikiContent, extras: Mapping[str, object] | None = ...
    ) -> tuple[JinjaContext, Callable[[JinjaContext, object], str]]: ...
    def render(self, basepath: str, jsondata: _WikiContent) -> str: ...

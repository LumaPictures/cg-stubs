# What a block's top-level key can hold (see _WikiBlock), or one of its attrs.
_BlockValue: TypeAlias = (
    JSONValue
    | _WikiText
    | _WikiSpan
    | list[_WikiBlock]
    | list[_WikiSpan]
    | list[str]
    | list[list[str]]
    | tuple[str, ...]
    | dict[str, str]
    | dict[str, str | None]
    | list[dict[str, str]]
    | Container[str]
    | list[_ParentInfo]
    | _SearchDoc
    | list[_SearchDoc]
    | dict[str, list[_SearchDoc]]
    | list[dict[str, str | None]]
)


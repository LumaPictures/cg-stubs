import re
from collections import defaultdict
from collections.abc import Mapping

from bookish.parser import ParserContext
from bookish.parser.rules import Rule

fixed_imports: list[str]
message: str

class Frame:
    name: str
    output: list[str]
    counters: defaultdict[str, int]
    indent: int
    def __init__(self, name: str, counter: int = ..., indent: int = ...) -> None: ...
    def inc(self, name: str) -> int: ...

class Indentation:
    builder: "Builder"
    amount: int
    def __init__(self, builder: "Builder", amount: int) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(self, *args: object) -> None: ...

class Builder:
    fixed_imports: list[str]
    imports: Mapping[str, str]
    rules: Mapping[str, Rule]
    main_rule: Rule
    context: ParserContext
    assigns: list[str]
    stack: list[Frame]
    output: list[str]
    made: set[str]
    def __init__(
        self,
        imports: Mapping[str, str],
        rules: Mapping[str, Rule],
        main_rule: Rule,
        context: ParserContext,
    ) -> None: ...
    def indented(self, amount: int) -> Indentation: ...
    def add_indent(self, n: int) -> None: ...
    def sub_indent(self, n: int) -> None: ...
    def generate_id(self, prefix: str, save: bool = ..., top_level: bool = ...) -> str: ...
    def effective_name(self, rule: Rule) -> str: ...
    def add_regex(self, pattern: str, expr: re.Pattern[str]) -> str: ...
    def add_constant(self, prefix: str, value: str) -> str: ...
    def assign(self, name: str, value: str) -> None: ...
    def make_function(self, rule: Rule) -> str: ...
    def line(self, line: str, indent: int = ...) -> None: ...
    def call(self, rule: Rule, indent: int = ..., external: bool = ...) -> None: ...
    def call_by_name(self, name: str, indent: int = ..., context_name: str = ...) -> None: ...
    def run(self) -> str: ...

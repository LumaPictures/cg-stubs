def firstmap_string(builder: Builder, firstmap: "Mapping[str | None, Sequence[Rule[object]]]") -> str: ...
def charset_string(chars: Iterable[str]) -> str: ...
def take_python_expr(stream: str, i: int, ends: Container[str]) -> tuple[str, int] | tuple[None, int]: ...
def take_app_args(stream: str, i: int) -> tuple[list[str], int] | tuple[None, int]: ...
def row_and_col(stream: str, i: int) -> tuple[int, int]: ...
def name_rules(d: Mapping[str, object]) -> None: ...

class Rule(Generic[_OutT_co]):
    def __init__(self) -> None: ...
    def __repr__(self) -> str: ...
    @overload
    def __add__(self, other: "Rule[_U]") -> "Seq[_U]": ...
    @overload
    def __add__(self, other: str) -> "Seq[str]": ...
    def __radd__(self, other: "Rule[object] | str") -> "Seq[_OutT_co]": ...
    @overload
    def __or__(self, other: "Rule[_U]") -> "Or[_OutT_co | _U]": ...
    @overload
    def __or__(self, other: str) -> "Or[_OutT_co | str]": ...
    def __ror__(self, other: "Rule[object] | str") -> "Seq[_OutT_co]": ...
    def __pow__(self, name: str) -> Self: ...
    def dump(self, pctx: ParserContext | None, level: int = ...) -> None: ...
    def children(self) -> "tuple[Rule[typing.Any], ...] | list[Rule[typing.Any]]": ...
    def set_name(self, name: str) -> Self: ...
    def _repr(self) -> str | None: ...
    def rulename(self) -> str | None: ...
    def fixed_length(self, pctx: ParserContext | None = ...) -> int | None: ...
    def is_optional(self) -> bool: ...
    def first_chars(self, pctx: ParserContext | None) -> _FirstChars: ...
    def __call__(self, stream: str, i: int, context: ParserContext) -> _Result[_OutT_co]: ...
    def accept(self, stream: str, i: int, context: ParserContext) -> _Result[_OutT_co]: ...
    def has_binding(self, bld: Builder) -> bool: ...
    def snap(self, pctx: ParserContext, seen: "MutableSet[Rule[object]]") -> "Rule[_OutT_co]": ...
    def build(self, bld: Builder) -> None: ...


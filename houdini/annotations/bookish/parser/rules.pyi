_T = TypeVar("_T")
# What a rule outputs when it matches. Rules built from parsed grammars output whatever their
# actions evaluate to, so it defaults to Any.
_OutT_co = TypeVar("_OutT_co", covariant=True, default=typing.Any)
_OutT = TypeVar("_OutT", default=typing.Any)
_U = TypeVar("_U")
_V = TypeVar("_V", default=typing.Any)
_RuleT = TypeVar("_RuleT", bound="Rule[typing.Any]")
_Result: TypeAlias = "tuple[_T, int] | tuple[type[Miss], None]"
_FirstChars: TypeAlias = str | set[str] | None

class Miss:
    def __init__(self) -> NoReturn: ...

class Empty:
    def __init__(self) -> NoReturn: ...

class Failure:
    def __init__(self) -> NoReturn: ...

emptylines_expr: re.Pattern[str]
ws_expr: re.Pattern[str]
brackets: dict[str, str]
endbrackets: frozenset[str]


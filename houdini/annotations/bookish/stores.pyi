import configparser
import os
from collections.abc import Generator, Iterable, Mapping, MutableMapping
from datetime import datetime, timedelta
from io import BytesIO
from types import TracebackType
from typing import IO, Any, Literal, Self, TypeAlias, overload
from zipfile import ZipFile, ZipInfo

from typing_extensions import NotRequired, TypedDict

from bookish.search import _SearchDoc

_BinaryMode: TypeAlias = Literal[
    "rb", "wb", "ab", "xb", "r+b", "w+b", "a+b", "x+b", "rb+", "wb+", "ab+", "xb+"
]

# The storage specs of a config's DOCUMENTS, SUPPORT_DOCUMENTS, ...: a directory path, a store,
# a dict describing one, or a list of them, which are overlaid.
_StoreSpec: TypeAlias = (
    "str | Store | _FilesSpec | _MountSpec | _WrapperSpec | _ObjectSpec | list[_StoreSpec] | tuple[_StoreSpec, ...]"
)

class _FilesSpec(TypedDict):
    type: Literal["files"]
    dir: str

class _MountSpec(TypedDict):
    type: Literal["mount"]
    source: _StoreSpec
    target: str
    static: NotRequired[bool]

# The store class is given by "class", or by its dotted name in "classname"; "args" are the
# keyword arguments it is made with (after the wrapped store, for a wrapper).
_WrapperSpec = TypedDict(
    "_WrapperSpec",
    {
        "type": Literal["wrapper"],
        "class": NotRequired["type[WrappingStore]"],
        "classname": NotRequired[str],
        "child": _StoreSpec,
        "args": NotRequired[Mapping[str, Any]],
    },
)
_ObjectSpec = TypedDict(
    "_ObjectSpec",
    {
        "type": Literal["object"],
        "class": NotRequired["type[Store]"],
        "classname": NotRequired[str],
        "args": NotRequired[Mapping[str, Any]],
    },
)

def file_etag(fpath: str | os.PathLike[str]) -> str: ...
def expandpath(path: str, root_path: str | None = ...) -> str: ...
def utc_offset() -> timedelta: ...
def store_from_spec(spec: _StoreSpec) -> "Store": ...

class Store:
    config: Mapping[str, object]
    def __init__(self, config: Mapping[str, object] | None = ...) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: TracebackType | None,
    ) -> None: ...
    def emit(self, tab: int, *strings: object) -> None: ...
    def dump(self, tab: int = ...) -> None: ...
    def explain(self, path: str, tab: int = ...) -> None: ...
    def tags(self) -> tuple[str, ...]: ...
    def set_config(self, config: Mapping[str, object]) -> None: ...
    def redirect(self, path: str) -> str | None: ...
    def settings(self, path: str, name: str = ...) -> configparser.ConfigParser: ...
    def store_for(self, path: str) -> "Store | None": ...
    def file_path(self, path: str) -> str | None: ...
    def etag(self, path: str) -> str | None: ...
    def exists(self, path: str) -> bool: ...
    def is_dir(self, path: str) -> bool: ...
    def extra_fields(self, path: str) -> _SearchDoc | None: ...
    def list_all(self, path: str = ..., no_lang: bool = ...) -> Iterable[str]: ...
    def list_dir(self, path: str) -> Iterable[str]: ...
    def last_modified(self, path: str) -> datetime: ...
    def size(self, path: str) -> int: ...
    @overload
    def open(self, path: str, mode: _BinaryMode = ...) -> IO[bytes]: ...
    @overload
    def open(self, path: str, mode: str) -> IO[Any]: ...
    def open(self, path: str, mode: str = ...) -> IO[Any]: ...
    def writable(self, path: str) -> bool: ...
    def make_dir(self, path: str, create_intermediate: bool = ...) -> None: ...
    def write_file(self, path: str, bytestring: bytes) -> None: ...
    def move(self, path: str, newpath: str) -> None: ...
    def delete(self, path: str) -> None: ...
    @overload
    def content(self, path: str, encoding: None) -> bytes: ...
    @overload
    def content(self, path: str, encoding: str = ...) -> str: ...
    def content(self, path: str, encoding: str | None = ...) -> str | bytes: ...
    def close(self) -> None: ...


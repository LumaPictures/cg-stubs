import threading
from collections.abc import Iterator

import flask

from bookish.stores import Store

class BackgroundIndexUnavailable(Exception): ...

indexlock: threading.Lock

def setup(app: flask.Flask) -> None: ...
def setup_config(app: flask.Flask, config_file: str | None = ..., use_houdini_path: bool = ...) -> None: ...
def setup_logging(app: flask.Flask) -> None: ...
def setup_store(app: flask.Flask) -> None: ...
def setup_jinja(app: flask.Flask) -> None: ...

class BgIndex(object):
    enabled: bool | None
    autostart: bool | None
    interval: float
    timer: threading.Timer | None
    app: flask.Flask
    def __init__(self, app: flask.Flask) -> None: ...
    def start_bg_indexing(self) -> None: ...
    def reschedule(self) -> None: ...
    def trigger(self) -> None: ...

class Scss(object):
    app: flask.Flask
    asset_dir: str | None
    store: Store
    def __init__(self, app: flask.Flask) -> None: ...
    def set_hooks(self) -> None: ...
    def find_scss(self, partials: bool = ...) -> Iterator[tuple[str, bool]]: ...
    def output_path(self, path: str) -> str: ...
    def out_of_date(self, path: str) -> bool | None: ...
    def partials_have_changed(self) -> bool | None: ...
    def recompile_all(self) -> None: ...
    def update_scss(self) -> None: ...
    def import_hook(self, path: str) -> list[tuple[str, str]] | None: ...
    def compile_scss(self, path: str) -> None: ...

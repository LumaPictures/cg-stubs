from collections.abc import Iterable, Iterator, Sequence

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

from hutil.qt.data import hotkeys

TINY_MARGIN: int
SMALL_MARGIN: int
MEDIUM_MARGIN: int
BIG_MARGIN: int
KEY_TEXT_SIZE: int
TOP_TEXT_SIZE: int
BOTTOM_TEXT_SIZE: int
ACTION_TEXT_SIZE: int
COMPLETED_ACTION_TEXT_SIZE: int
BORDER_WIDTH: int
BG_COLOR: PySide6.QtGui.QColor
COMPLETED_BORDER_COLOR: PySide6.QtGui.QColor
COMPLETED_TEXT_COLOR: PySide6.QtGui.QColor
COMPLETED_BG_COLOR: PySide6.QtGui.QColor
EXPAND_DELAY_MS: int
EXPAND_DURATION_MS: int
COMPLETED_DELAY_MS: int
border_colors: tuple[PySide6.QtGui.QColor, ...]

def makeLabel(
    parent: PySide6.QtWidgets.QWidget | None,
    text: str,
    size: int = ...,
    color: PySide6.QtGui.QColor | None = ...,
    role: PySide6.QtGui.QPalette.ColorRole = ...,
    bold: bool = ...,
) -> PySide6.QtWidgets.QLabel: ...
def fitToScreen(screen: PySide6.QtGui.QScreen, rect: PySide6.QtCore.QRect) -> PySide6.QtCore.QRect: ...
def drawOutlinedText(
    painter: PySide6.QtGui.QPainter,
    font: PySide6.QtGui.QFont,
    pos: PySide6.QtCore.QPoint,
    text: str,
    outline_color: PySide6.QtGui.QColor,
    brush: PySide6.QtGui.QColor | PySide6.QtGui.QBrush,
    outline_width: float = ...,
) -> None: ...

class CandidateWidget(PySide6.QtWidgets.QFrame):
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def keys(self) -> Sequence[hotkeys.KeyLike]: ...
    def actualSequenceWidth(self) -> int: ...
    def sequenceWidth(self) -> int: ...
    def setSequenceWidth(self, width: int) -> None: ...
    def setKeysAndText(self, keys: Sequence[hotkeys.KeyLike], text: str) -> None: ...
    def sizeHint(self) -> PySide6.QtCore.QSize: ...

class PopupWindow(PySide6.QtWidgets.QWidget):
    def __init__(self) -> None: ...
    def activeCandidateWidgets(self) -> Iterator[CandidateWidget]: ...
    def sizeHint(self) -> PySide6.QtCore.QSize: ...
    def isExpanded(self) -> bool: ...
    def setExpanded(self, expanded: bool) -> None: ...
    def mousePressEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def setParent(self, parent: PySide6.QtWidgets.QWidget | None) -> None: ...
    def showEvent(self, event: PySide6.QtGui.QShowEvent) -> None: ...
    def hideEvent(self, event: PySide6.QtGui.QHideEvent) -> None: ...
    def resizeEvent(self, event: PySide6.QtGui.QResizeEvent) -> None: ...
    def setPrefixKeys(self, keys: Sequence[hotkeys.KeyLike]) -> None: ...
    def updateContents(self, keys_so_far: Sequence[str], candidates: Sequence[tuple[Sequence[str], str]]) -> None: ...
    def prefixKeys(self) -> Sequence[hotkeys.KeyLike]: ...
    def completionLabel(self) -> str: ...
    def completionPosition(self, keys: Iterable[hotkeys.KeyLike]) -> PySide6.QtCore.QPoint: ...
    def paintEvent(self, event: PySide6.QtGui.QPaintEvent) -> None: ...

class CompletedWindow(CandidateWidget):
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def hideEvent(self, event: PySide6.QtGui.QHideEvent) -> None: ...
    def display(self, keys: Sequence[hotkeys.KeyLike], symbol: str, pos: PySide6.QtCore.QPoint) -> None: ...
    def paintEvent(self, event: PySide6.QtGui.QPaintEvent) -> None: ...

def showKeySequenceWindow(
    name: str, parent: PySide6.QtWidgets.QWidget, pos: PySide6.QtCore.QPoint
) -> PopupWindow: ...
def hideKeySequenceWindow() -> None: ...
def updateKeySequenceWindow(keys_so_far: Sequence[str], candidates: Sequence[tuple[Sequence[str], str]]) -> None: ...

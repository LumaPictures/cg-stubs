import re
from collections.abc import Collection, Iterable
from typing import Literal, TypeAlias, type_check_only

import hou
from _shotbuilder import HprUri, ProjectConfig
from pxr import Sdf
from PySide6 import QtCore, QtGui, QtWidgets

_Index: TypeAlias = QtCore.QModelIndex | QtCore.QPersistentModelIndex
# Layer unique keys -> pinned versions: ints in the "versions" JSON maps; the unit's own
# version (from its "unitversionargs" parm) a string.
_VersionMap: TypeAlias = dict[str, int | str]

SIZE4: int
SIZE14: int
SIZE16: int
SIZE10: int
SIZE100: int
SIZE200: int
SUBLAYER_ICON: hou.qt.Icon
UNIT_ICON: hou.qt.Icon
PINNED_ICON: hou.qt.Icon

class HprUriItem:
    arWidget: "ArVersioner | PinVersionDialog | None"
    # None for the root item.
    hpruri: HprUri | None
    resolvedpath: None
    pinned: bool
    parentItem: "HprUriItem | None"
    parenturi: HprUri | None
    childItems: list["HprUriItem"]
    icon: QtGui.QIcon
    isUnresolved: bool
    isMuted: bool
    unique_key: str
    toolTip: str
    def __init__(
        self,
        aruri: HprUri | None,
        parent: "HprUriItem | None",
        icon: QtGui.QIcon = ...,
        node: hou.OpNode | None = ...,
        topLevelItem: "HprUriItem | None" = ...,
        arWidget: "ArVersioner | PinVersionDialog | None" = ...,
    ) -> None: ...
    @staticmethod
    def root() -> "HprUriItem": ...
    def appendChild(self, item: "HprUriItem") -> None: ...
    def child(self, row: int) -> "HprUriItem | None": ...
    def childCount(self) -> int: ...
    def columnCount(self) -> int: ...
    def data(self, column: int) -> str | None: ...
    def parent(self) -> "HprUriItem | None": ...
    def row(self) -> int: ...
    # HprUri has no shot_context, so this raises AttributeError unless the item is the root.
    @property
    def shot_context(self) -> None: ...
    @property
    def version(self) -> str: ...
    # HprUri.setVersion() takes an int or a string of one.
    @version.setter
    def version(self, new_version: int | str) -> None: ...
    def node(self) -> hou.OpNode | None: ...

class HprUriModel(QtCore.QAbstractItemModel):
    LayerColumn: Literal[0]
    VersionColumn: Literal[1]
    pattern: re.Pattern[str]
    rootItem: HprUriItem
    panel: "ArVersioner | PinVersionDialog"
    topLevel: HprUriItem
    diskVersionMap: dict[str, int]
    # rootLayer (the panel's Shot Load node) is unused.
    def __init__(self, parent: "ArVersioner | PinVersionDialog", rootLayer: hou.OpNode | None) -> None: ...
    def clear(self) -> None: ...
    def data(self, index: _Index, role: int = ...) -> str | QtGui.QIcon | QtGui.QBrush | QtGui.QFont | None: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int) -> str | None: ...
    def columnCount(self, parent: _Index) -> int: ...
    def rowCount(self, parent: _Index) -> int: ...
    def index(self, row: int, column: int, parent: _Index) -> QtCore.QModelIndex: ...
    def parent(self, index: _Index) -> QtCore.QModelIndex: ...
    # version: the hpr: uri of the unit version to load in place of the root layer's.
    def populateData(self, sublayer: Sdf.Layer | None, version: str | None = ..., parent: HprUriItem | None = ...) -> None: ...
    # None when the panel has no node.
    def parseContextStringParm(self, include_unit_version: bool = ...) -> _VersionMap | None: ...
    def setDiskVersionMap(self, sublayerPath: str) -> None: ...

class HprUriVersionsView(QtWidgets.QTreeView):
    pattern: re.Pattern[str]
    panel: "PinVersionDialog"
    config: ProjectConfig
    comboBoxes: list[QtWidgets.QComboBox]
    parentSourceModel: HprUriModel
    # Layer unique keys -> the chosen version ("latest" or a version number).
    changedCombos: dict[str, str]
    versionmap: _VersionMap
    def __init__(self, parent: "PinVersionDialog" = ...) -> None: ...
    # The pin dialog always shows its HprUriPinFilter.
    @type_check_only
    def model(self) -> "HprUriPinFilter": ...
    def populateCombos(self) -> None: ...
    def getNewVersions(self) -> dict[str, str]: ...

class HprUriTreeView(hou.qt.TreeView):
    panel: "ArVersioner"
    config: ProjectConfig
    def __init__(self, parent: "ArVersioner" = ...) -> None: ...
    def contextMenuEvent(self, event: QtGui.QContextMenuEvent) -> None: ...
    def setMute(self, layers: Iterable[_Index], state: bool) -> None: ...
    def layerAction(self, layers: Iterable[_Index]) -> None: ...
    def setPinned(self, layers: Iterable[_Index]) -> None: ...
    def clearPinned(self, layers: Iterable[_Index]) -> None: ...

class HprUriTreeFilter(QtCore.QSortFilterProxyModel):
    showMuted: bool
    showEmpty: bool
    def __init__(self, parent: QtCore.QObject | None = ...) -> None: ...
    def setShowMuted(self, show: bool) -> None: ...
    def setShowEmpty(self, show: bool) -> None: ...
    def filterAcceptsRow(self, rowIdx: int, parent: _Index) -> bool: ...
    @type_check_only
    def sourceModel(self) -> HprUriModel: ...

class HprUriPinFilter(QtCore.QSortFilterProxyModel):
    showMuted: bool
    # Unique keys of the layers to show; all when empty or None.
    acceptedRows: Collection[str] | None
    def __init__(self, acceptedRows: Collection[str] | None = ..., parent: QtCore.QObject | None = ...) -> None: ...
    def filterAcceptsRow(self, rowIdx: int, parent: _Index) -> bool: ...
    @type_check_only
    def sourceModel(self) -> HprUriModel: ...

class ArVersioner(QtWidgets.QWidget):
    myProjectChangedCallbackId: int
    config: ProjectConfig
    layout: QtWidgets.QVBoxLayout
    menuBar: hou.qt.MenuBar
    sublayersMenu: QtWidgets.QMenu
    viewMenu: QtWidgets.QMenu
    toggleVersioned: QtGui.QAction
    sublayersPinMenu: QtGui.QAction
    sublayersClearPinMenu: QtGui.QAction
    refreshButton: QtWidgets.QToolButton
    layersTreeModel: HprUriModel
    layersTreeView: HprUriTreeView
    layersViewProxy: HprUriTreeFilter
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setupUI(self, buildTree: bool = ...) -> None: ...
    def setupErrorStageUI(self) -> None: ...
    def setupNoSelectionUI(self) -> None: ...
    def setupErrorUI(self) -> None: ...
    def node(self) -> hou.OpNode | None: ...
    def handleContextOptionChanged(self, option: str) -> None: ...
    def onNodePathChanged(self, node: hou.OpNode | None) -> None: ...
    def onActivateInterface(self) -> None: ...
    def onDeactivateInterface(self) -> None: ...
    def refresh_ui(self) -> None: ...
    # version: the hpr: uri of the unit version to load.
    def buildTree(self, version: str | None = ...) -> None: ...
    def clearTree(self) -> None: ...

class PinVersionDialog(QtWidgets.QDialog):
    arversioner: ArVersioner
    config: ProjectConfig
    # The panel's Shot Load node.
    rootLayer: hou.OpNode | None
    layersRequested: Collection[str] | None
    isDirty: bool
    layersTreeModel: HprUriModel
    layersViewProxy: HprUriPinFilter
    layersTreeView: HprUriVersionsView
    warningLabel: QtWidgets.QLabel
    applyButton: QtWidgets.QPushButton
    okButton: QtWidgets.QPushButton
    cancelButton: QtWidgets.QPushButton
    editedLayers: dict[str, str]
    def __init__(self, arversioner: ArVersioner, layersRequested: Collection[str] | None = ...) -> None: ...
    def setWarningText(self, name: str | None = ..., warning: bool = ...) -> None: ...
    def node(self) -> hou.OpNode | None: ...
    def updatePinning(self, source_index: _Index) -> None: ...

import os
import types
from collections.abc import Callable, Iterable
from typing import Any, ParamSpec, Protocol, TypeVar, overload

_P = ParamSpec("_P")
_R = TypeVar("_R")

class _Decorator(Protocol):
    def __call__(self, func: Callable[_P, _R], /) -> Callable[_P, _R]: ...

class _FilePrinter(Protocol):
    def __call__(self, *args: object, sep: str = ..., end: str = ...) -> None: ...

SHOW_CALLER: bool
SHOW_CLASS: bool
PDB_ASSERTS: int
INIT_PDBPP_PATH: int
PDBPP_PATH: str
DBG_ZONE_SCOPES: int

def formatFrame(current_frame: types.FrameType) -> str: ...
def msg(*args: object, frame: types.FrameType | None = ...) -> None: ...
def trace(*args: object, frame: types.FrameType | None = ...) -> None: ...
def trace_exc(*args: object, frame: types.FrameType | None = ...) -> None: ...
def initpdbpp() -> None: ...
def hassert(cond: object, msg: str = ...) -> None: ...

class DbgPrinter:
    enabled: bool
    def __init__(self, enable_env: str = ...) -> None: ...
    def msg(self, *args: object) -> None: ...
    def trace(self, *args: object) -> None: ...
    def trace_exc(self, *args: object) -> None: ...

@overload
def log(e: Callable[_P, _R], c: str | list[str] | None = ..., *, pr: Callable[[str], object] = ..., p: bool | int = ..., s: int = ..., o: str | Iterable[object] | None = ...) -> Callable[_P, _R]: ...
@overload
def log(e: bool | int = ..., c: str | list[str] | None = ..., *, pr: Callable[[str], object] = ..., p: bool | int = ..., s: int = ..., o: str | Iterable[object] | None = ...) -> _Decorator: ...
def log(e: bool | int | Callable[_P, _R] = ..., c: str | list[str] | None = ..., *, pr: Callable[[str], object] = ..., p: bool | int = ..., s: int = ..., o: str | Iterable[object] | None = ...) -> Callable[_P, _R] | _Decorator: ...
def makeFilePrinter(path: str | os.PathLike[str], mode: str = ..., flush: bool = ..., encoding: str = ...) -> _FilePrinter: ...

class ZoneScopedImpl:
    name: str
    text: str
    # The handle from _kinefx.zoneStart, which Houdini 22 does not define.
    ctx: Any
    def __init__(self, n: str, text: str | None = ...) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(self, type: type[BaseException] | None, value: BaseException | None, tb: types.TracebackType | None) -> None: ...

def ZoneScopedDecoratorImpl(func: Callable[_P, _R]) -> Callable[_P, _R]: ...

class ZoneScopedNoop:
    def __init__(self, n: str) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(self, type: type[BaseException] | None, value: BaseException | None, tb: types.TracebackType | None) -> None: ...

def ZoneScopedDecoratorNoop(func: Callable[_P, _R]) -> Callable[_P, _R]: ...

ZoneScoped: type[ZoneScopedImpl] | type[ZoneScopedNoop]
ZoneScopedDecorator: _Decorator

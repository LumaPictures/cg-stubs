    def reset_after_undo_or_redo(self, *, optype: str = ...) -> None: ...

def menu_token_to_index(node_type: hou.NodeType | None, parm_name: str, token: str, default: int = ...) -> int: ...
def menu_index_to_token(node_type: hou.NodeType | None, parm_name: str, index: int, default: str = ...) -> str: ...
def menu_value_to_index(node_type: hou.NodeType | None, parm_name: str, value: _T) -> _T | int: ...
def ensure_curve3core_internal_group_parms(parms: dict[str, object]) -> None: ...

import hou
import curveutils as cu
from curvestate.curve3.drawables import Curve3DrawableManager

class InteractiveDragGuide:
    def __init__(self, scene_viewer: hou.SceneViewer, name: str) -> None: ...
    def enable(self, val: bool) -> None: ...
    def begin(self, start_pos: hou.Vector3, dragger: cu.Dragger) -> None: ...
    def begin_rotate_sphere(self, center_pos: hou.Vector3, start_vec: hou.Vector3) -> None: ...
    def update(self, pos: hou.Vector3) -> None: ...
    def end(self) -> None: ...
    def draw(self, draw_handle: int) -> None: ...

class Curve3Dragger(cu.Dragger):
    end_pos: hou.Vector3
    center_pos: hou.Vector3
    lock_length: float | None
    prev_pos: hou.Vector3
    pos: hou.Vector3 | None
    plane_orig: hou.Vector3
    last_flag: int | None
    def __init__(self, scene_viewer: hou.SceneViewer, name: str | None = ...) -> None: ...
    def set_drawable_manager(self, drawable_manager: Curve3DrawableManager | None) -> None: ...
    def drawGuide(self, draw_handle: int) -> None: ...
    def startDragLockLength(
        self,
        ui_event: hou.ViewerEvent,
        epos: hou.Vector3,
        cpos: hou.Vector3,
        plane_orig: hou.Vector3 | None = ...,
    ) -> None: ...
    def drag(self, scene_viewer: hou.SceneViewer, ui_event: hou.ViewerEvent, flag: int | None = ...) -> hou.Vector3: ...
    def endDrag(self) -> None: ...

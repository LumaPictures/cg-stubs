_T = TypeVar("_T")

_CurvePick: TypeAlias = cu.PickCurveResultType | tuple[hou.Prim, float, hou.Vector3 | None, int]

# A geometry summary for the debug.get.* commands; a missing geometry has only "exists".
class _GeoSummary(TypedDict, total=False):
    exists: Required[bool]
    pointcount: int
    primitivecount: int
    point_attribs: list[str]
    prim_attribs: list[str]
    point_groups: list[str]
    prim_groups: list[str]
    prim_types: dict[str, int]

_DebugCommandResult: TypeAlias = _GeoSummary | dict[str, _GeoSummary] | list[_DrawableInfo]

def geo_summary(geo: hou.Geometry | None) -> _GeoSummary: ...
# A command's payload value: a dict's "value", a non-empty sequence's first item, else the payload.
@overload
def extract_command_value(args: dict[str, _T]) -> _T | None: ...
@overload
def extract_command_value(args: list[_T]) -> _T | list[_T]: ...
@overload
def extract_command_value(args: tuple[_T, ...]) -> _T | tuple[()]: ...
@overload
def extract_command_value(args: _T) -> _T: ...
def extract_command_value(args: object) -> object: ...


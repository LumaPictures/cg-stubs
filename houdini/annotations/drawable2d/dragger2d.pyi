import hou
from collections.abc import Callable, MutableMapping
from typing import Any, TypeAlias, TypeVar

from drawable2d import constants
from drawable2d.drawable2dgroup import Drawable2DGroup
from drawable2d.spaceadaptor import SpaceAdaptor, SpaceAdaptorImage
from houtypes import ViewerHandleEventKwargs, ViewerStateEventKwargs

_BoundParm: TypeAlias = MutableMapping[str, Any] | hou.Parm
_EventT = TypeVar("_EventT", bound=hou.UIEvent)

class Dragger2D:
    def __init__(
        self,
        viewer: hou.SceneViewer | hou.CompositorViewer | None = ...,
        space_adaptor: SpaceAdaptor | None = ...,
        dragger_owner: hou.Handle | None = ...,
        pivot_world_fn: Callable[[], hou.Matrix4] | None = ...,
        sync_to_mouse: bool = ...,
    ) -> None: ...
    def space(self) -> SpaceAdaptor | SpaceAdaptorImage: ...
    def dragMode(self) -> constants.DraggerMode: ...
    def delta(self, local: bool = ...) -> hou.Vector3: ...
    def pos(self, local: bool = ..., unscale: bool = ...) -> hou.Vector3: ...
    def radius(self) -> float: ...
    def mouse(self) -> tuple[float, float]: ...
    def lastMouse(self) -> tuple[float, float]: ...
    def buildDeltaTranslate(self) -> hou.Matrix4: ...
    def activeTransform(self) -> hou.Matrix4: ...
    def activeTranslates(self) -> hou.Vector3: ...
    def activeScales(self) -> hou.Vector3: ...
    def drawable(self) -> hou.Drawable2D | Drawable2DGroup | None: ...
    def buildTranslate(self) -> hou.Matrix4: ...
    def update(
        self,
        kwargs: ViewerStateEventKwargs[_EventT] | ViewerHandleEventKwargs[_EventT],
        src_drawable: hou.Drawable2D | Drawable2DGroup | None,
        mapping_drawable: hou.Drawable2D | None = ...,
        offset_x: float | None = ...,
        offset_y: float | None = ...,
    ) -> bool: ...
    def transform(self) -> hou.Matrix4: ...
    def drawTransform(self) -> hou.Matrix4: ...
    def postTransform(self) -> hou.Matrix4: ...
    def layerTransform(self) -> hou.Matrix4: ...
    def postScale(self) -> hou.Vector3: ...
    def startDrag(
        self,
        p1: _BoundParm | None,
        p2: _BoundParm | None = ...,
        p3: _BoundParm | None = ...,
        transform_mode: constants.DraggerTransformMode | None = ...,
        drag_mode: constants.DraggerMode | None = ...,
        start_angle: float | None = ...,
        step_size: float | None = ...,
        drag_speed: float | None = ...,
        radius: float | None = ...,
    ) -> None: ...
    def endDrag(self) -> None: ...
    def dragXY(self, local: bool = ...) -> hou.Vector3 | tuple[float, float] | None: ...
    def dragAlongAxis(self, axis: str, local: bool = ...) -> hou.Vector3: ...
    def dragAlongX(self, local: bool = ...) -> hou.Vector3: ...
    def dragAlongY(self, local: bool = ...) -> hou.Vector3: ...
    def dragRotation(self) -> tuple[float, float, float]: ...

import hou
from collections.abc import Callable, Mapping
from enum import Enum, auto
from typing import Literal, TypeAlias, TypeVar, overload

import cop.spaceutils as cop
from drawable2d.dragger2d import Dragger2D
from houtypes import ViewerParmProperties

_T = TypeVar("_T")

_SpaceToken: TypeAlias = str | int | cop.Space | None
_BoundParm: TypeAlias = ViewerParmProperties | hou.Parm
_PosValue: TypeAlias = float | tuple[float, ...] | list[float] | hou.Vector2 | hou.Vector3
_RoleBinding: TypeAlias = "Mapping[SpaceAdaptor.Role, str | tuple[str | None, ...] | list[str | None]]"
_SpaceBindingSpec: TypeAlias = "dict[str | int | cop.Space, _RoleBinding]"
_BindingSpec: TypeAlias = "dict[str, _SpaceBindingSpec]"

class SpaceAdaptor:
    class Role(Enum):
        POS = auto()
        ROT = auto()
        SCALE = auto()
        USCALE = auto()
        PIVOT_POS = auto()

    def __init__(
        self,
        node: hou.CopNode,
        parm_dict: Mapping[str, ViewerParmProperties],
        binding_spec: _BindingSpec | list[_BindingSpec] | tuple[_BindingSpec, ...],
        *,
        space_token: _SpaceToken = ...,
        validator_fn: Callable[[str], bool] | None = ...,
        layer_xform_fn: Callable[[], hou.Matrix4] | None = ...,
    ) -> None: ...
    def name(self) -> cop.Space | None: ...
    def node(self) -> hou.CopNode | None: ...
    def bindingSpec(self, space_name: str | None = ...) -> dict[cop.Space, _RoleBinding] | None: ...
    def setActiveBindingSpec(self, name: str) -> None: ...
    def activeBindingSpec(self) -> dict[cop.Space, _RoleBinding]: ...
    def layer(self) -> hou.ImageLayer | None: ...
    def updateLayerFromPort(self, layer_output: bool = ..., layer_port_index: int = ...) -> hou.ImageLayer | None: ...
    def canSupportSpace(self, space_token: _SpaceToken) -> bool: ...
    def switchSpace(self, space_token: _SpaceToken) -> cop.Space | None: ...
    def pushSpace(self, space: _SpaceToken) -> None: ...
    def popSpace(self) -> None: ...
    def _updateLayerTransformFunc(self, layer_xform_fn: Callable[[], hou.Matrix4] | None = ...) -> Callable[[], hou.Matrix4]: ...
    def parms(self, role: Role, space: _SpaceToken = ...) -> tuple[_BoundParm | None, ...] | None: ...
    @overload
    def parmValue(
        self,
        role: Literal[Role.POS, Role.PIVOT_POS, Role.SCALE],
        *,
        target_space: _SpaceToken = ...,
        def_val: float = ...,
    ) -> tuple[float, ...]: ...
    @overload
    def parmValue(
        self,
        role: Literal[Role.ROT, Role.USCALE],
        *,
        target_space: _SpaceToken = ...,
        def_val: float = ...,
    ) -> float: ...
    @overload
    def parmValue(self, role: Role, *, target_space: _SpaceToken = ..., def_val: float = ...) -> float | tuple[float, ...]: ...
    def parmValue(self, role: Role, *, target_space: _SpaceToken = ..., def_val: float = ...) -> float | tuple[float, ...]: ...
    def updateParm(self, role: Role, tuple_value: _PosValue | None, space: _SpaceToken = ..., increment: bool = ...) -> bool: ...
    def updateTransform(
        self,
        value: hou.Matrix4 | tuple[float, ...] | list[float],
        role: Role | None = ...,
        increment: bool = ...,
    ) -> None: ...
    @overload
    def transform(self, role: None = ..., def_val: float = ...) -> hou.Matrix4: ...
    @overload
    def transform(self, role: Role, def_val: float = ...) -> tuple[float, float, float] | float: ...
    def transform(self, role: Role | None = ..., def_val: float = ...) -> hou.Matrix4 | tuple[float, float, float] | float: ...
    def orientTransform(self) -> hou.Matrix4: ...
    def boundPivotDelta(self) -> tuple[float, float]: ...

POS: Literal[SpaceAdaptor.Role.POS]
PIVOT_POS: Literal[SpaceAdaptor.Role.PIVOT_POS]
ROT: Literal[SpaceAdaptor.Role.ROT]
SCALE: Literal[SpaceAdaptor.Role.SCALE]
USCALE: Literal[SpaceAdaptor.Role.USCALE]

class SpaceAdaptorImage:
    def __init__(self, dragger: Dragger2D) -> None: ...
    def updateTransform(self, xform: hou.Matrix4 | tuple[float, ...] | list[float]) -> None: ...
    def transform(self) -> hou.Matrix4: ...
    def updateParm(
        self,
        role: SpaceAdaptor.Role | None,
        tuple_value: _PosValue | None,
        space: _SpaceToken = ...,
        increment: bool = ...,
    ) -> bool: ...
    def spaceName(self) -> cop.Space: ...
    def switchSpace(self, space_token: _SpaceToken) -> cop.Space: ...
    @overload
    def parms(
        self, role: Literal[SpaceAdaptor.Role.POS], space: _SpaceToken = ...
    ) -> tuple[_BoundParm | None, _BoundParm | None, None]: ...
    @overload
    def parms(
        self, role: Literal[SpaceAdaptor.Role.SCALE], space: _SpaceToken = ...
    ) -> tuple[_BoundParm | None, _BoundParm | None]: ...
    @overload
    def parms(
        self, role: Literal[SpaceAdaptor.Role.ROT, SpaceAdaptor.Role.USCALE], space: _SpaceToken = ...
    ) -> _BoundParm | None: ...
    @overload
    def parms(self, role: Literal[SpaceAdaptor.Role.PIVOT_POS], space: _SpaceToken = ...) -> tuple[None, None]: ...
    @overload
    def parms(
        self, role: SpaceAdaptor.Role | None, space: _SpaceToken = ...
    ) -> tuple[_BoundParm | None, ...] | _BoundParm | None: ...
    def parms(
        self, role: SpaceAdaptor.Role | None, space: _SpaceToken = ...
    ) -> tuple[_BoundParm | None, ...] | _BoundParm | None: ...
    @overload
    def parmValue(
        self,
        role: Literal[SpaceAdaptor.Role.POS, SpaceAdaptor.Role.PIVOT_POS, SpaceAdaptor.Role.SCALE],
        *,
        target_space: _SpaceToken = ...,
        def_val: float = ...,
    ) -> tuple[float, ...]: ...
    @overload
    def parmValue(
        self,
        role: Literal[SpaceAdaptor.Role.ROT, SpaceAdaptor.Role.USCALE],
        *,
        target_space: _SpaceToken = ...,
        def_val: float = ...,
    ) -> float: ...
    @overload
    def parmValue(
        self, role: SpaceAdaptor.Role | None, *, target_space: _SpaceToken = ..., def_val: float = ...
    ) -> float | tuple[float, ...] | None: ...
    def parmValue(
        self, role: SpaceAdaptor.Role | None, *, target_space: _SpaceToken = ..., def_val: float = ...
    ) -> float | tuple[float, ...] | None: ...
    def posToImage(self, pos_value: _T, def_val: float) -> _T: ...
    def updateLayerFromPort(self, layer_output: bool = ..., layer_port_index: int = ...) -> bool: ...
    def setActiveBindingSpec(self, name: str) -> None: ...
    def pushSpace(self, space: _SpaceToken) -> None: ...
    def popSpace(self) -> None: ...

import hou
from collections.abc import Callable

from drawable2d.dragger2d import Dragger2D

class DraggerDelegate2D:
    def __init__(self, dragger2d: Dragger2D, pivot_world_fn: Callable[[], hou.Matrix4] | None) -> None: ...
    def setActiveTransform(self) -> None: ...
    def updateDrawable(self, xform: hou.Matrix4, increment: bool = ..., to_local: bool = ...) -> None: ...
    def updateRotation(
        self,
        new_x: float,
        new_y: float,
        new_z: float,
        delta_angle: float,
        new_angle: float,
        total_angle: float,
        sweep_angle: float,
        add_delta: bool = ...,
    ) -> None: ...
    def toLocalSpace(self, value: hou.Vector3, absolute: bool = ...) -> hou.Vector3: ...
    def toLocalPosition(self, value: hou.Vector3) -> hou.Vector3: ...
    def toWorldPos(self, v3: hou.Vector3, apply_scale: bool = ...) -> hou.Vector3: ...
    def update(self, ui_event: hou.UIEvent) -> None: ...
    def startAngle(self) -> float | None: ...
    def startDrag(self, **kwargs: float | None) -> None: ...
    def endDrag(self) -> None: ...
    def dragXY(self) -> hou.Vector3: ...
    def dragAlongAxis(self, dx: float, dy: float, axis: str) -> hou.Vector3: ...
    def dragRotate(
        self, angle: float, center_x: float, center_y: float, object_x: float | None, object_y: float | None
    ) -> tuple[float, float, float | None, float | None]: ...
    def radius(self) -> float: ...

class DraggerDelegate3D:
    def __init__(
        self,
        dragger2d: Dragger2D,
        scene_viewer: hou.SceneViewer,
        dragger_owner: hou.Handle | None,
        pivot_world_fn: Callable[[], hou.Matrix4] | None,
    ) -> None: ...
    def setActiveTransform(self) -> None: ...
    def update(self, ui_event: hou.UIEvent) -> bool: ...
    def endDrag(self) -> None: ...
    def dragXY(self) -> hou.Vector3: ...
    def dragAlongAxis(self, dx: float, dy: float, axis: str) -> hou.Vector3: ...
    def dragRotate(self, angle: float, _cx: float, _cy: float, _ox: float | None, _oy: float | None) -> tuple[float, float, float, float]: ...
    def startAngle(self) -> float | None: ...
    def startDrag(self, **kwargs: float | None) -> None: ...
    def updateRotation(
        self,
        new_x: float,
        new_y: float,
        new_z: float,
        delta_angle: float,
        new_angle: float,
        total_angle: float,
        sweep_angle: float,
        add_delta: bool = ...,
    ) -> None: ...
    def updateDrawable(self, wxform: hou.Matrix4, increment: bool = ..., to_local: bool = ...) -> None: ...
    def toLocalSpace(self, v3: hou.Vector3, absolute: bool = ...) -> hou.Vector3: ...
    def toLocalPosition(self, v3: hou.Vector3) -> hou.Vector3: ...
    def toWorldPos(self, v3: hou.Vector3, apply_scale: bool = ...) -> hou.Vector3: ...
    def radius(self) -> float: ...

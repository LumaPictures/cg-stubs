from collections.abc import Mapping, Sequence
from typing import TypeAlias, TypeVar

import hou

_ParmValues: TypeAlias = str | int | float | list[str] | list[int] | list[float]
# The parameter overrides of the Material SOP's `material_override` attribute.
_OverridesT = TypeVar("_OverridesT", bound=Mapping[str, int | float | str])

def getParmTupleValues(parm_tuple: hou.ParmTuple | None) -> _ParmValues | None: ...
def rangeString(start: int, end: int, prefix_with_space: bool) -> str: ...
def compactPrims(geo: hou.Geometry, groups: Mapping[str, Sequence[hou.Prim]], prims: Sequence[hou.Prim], group_using_attribute: str) -> str: ...
def compactOldStyleOverrides(material: str, overrides: _OverridesT) -> _OverridesT | dict[str, _ParmValues]: ...
def buildStyleSheetForSop(sop: hou.SopNode | None, from_old_info: bool = ..., group_using_groups: bool = ..., group_using_attribute: str = ...) -> hou.StyleSheet: ...
def buildStyleSheetForObject(obj: hou.ObjNode | None, from_old_info: bool = ..., group_using_groups: bool = ..., group_using_attribute: str = ...) -> hou.StyleSheet: ...
def buildStyleSheetForScene(root: hou.Node | None = ..., from_old_info: bool = ..., group_using_groups: bool = ..., group_using_attribute: str = ...) -> hou.StyleSheet: ...

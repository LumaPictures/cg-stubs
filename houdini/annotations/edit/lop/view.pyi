from collections.abc import Collection, Iterable, Sequence

from PySide6 import QtCore, QtGui, QtWidgets

ICON_SIZE: int
PATHCOLMINWIDTH: int
ICONCELL_WIDTH: int
POSVALUECELL_WIDTH: int
OTHERVALUECELL_WIDTH: int
CELL_HEIGHT: int
Forward: int
Backward: int

class EditTreeView:
    xformColWidthChanged: QtCore.Signal
    mousepressedonclickable: bool
    mousepressedoneditable: bool
    deferredselectionupdate: bool
    mousepressindex: QtCore.QModelIndex | None
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def resizeEvent(self, e: QtGui.QResizeEvent) -> None: ...
    def removeSelected(self) -> None: ...
    def removeAll(self) -> None: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def selectionCommand(
        self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, event: QtCore.QEvent | None
    ) -> QtCore.QItemSelectionModel.SelectionFlag: ...
    def selectDescendants(self, indexes: Iterable[QtCore.QModelIndex]) -> None: ...
    def predExpandIndexToKind(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, kind: str) -> bool: ...
    def createContextActions(self, indexes: Sequence[QtCore.QModelIndex], menu: QtWidgets.QMenu) -> None: ...
    def selectedRows(self) -> list[int]: ...
    def setDisplayXforms(self, checked: bool) -> None: ...
    def setDisplayPhysics(self, checked: bool) -> None: ...
    def resetScroll(self) -> None: ...
    def filter(self, pattern: str) -> None: ...
    def searchForward(self) -> None: ...
    def searchBackward(self) -> None: ...
    def selectItemsByFullPath(
        self,
        items: Collection[str],
        top_level_only: bool = ...,
        parent: QtCore.QModelIndex = ...,
        auto_expand: bool = ...,
    ) -> None: ...

class CustomDoubleSpinBox(QtWidgets.QDoubleSpinBox):
    def __init__(self, parent: QtWidgets.QWidget | None) -> None: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...

class SpinBoxDelegate(QtWidgets.QStyledItemDelegate):
    def __init__(self) -> None: ...
    def createEditor(
        self,
        parent: QtWidgets.QWidget,
        option: QtWidgets.QStyleOptionViewItem,
        index: QtCore.QModelIndex | QtCore.QPersistentModelIndex,
    ) -> CustomDoubleSpinBox: ...
    def setEditorData(
        self, spinbox: CustomDoubleSpinBox, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex
    ) -> None: ...
    def setModelData(
        self,
        spinbox: CustomDoubleSpinBox,
        mymodel: QtCore.QAbstractItemModel,
        index: QtCore.QModelIndex | QtCore.QPersistentModelIndex,
    ) -> None: ...
    def updateEditorGeometry(
        self,
        editor: QtWidgets.QWidget,
        option: QtWidgets.QStyleOptionViewItem,
        index: QtCore.QModelIndex | QtCore.QPersistentModelIndex,
    ) -> None: ...
    def setView(self, view: EditTreeView) -> None: ...

class Model:
    opnode: HOU.OpNode | None
    is_pushing_update: bool
    listeners: list[ModelListener]
    def __init__(self, opnode: HOU.OpNode | None = ...) -> None: ...
    def set_opnode(self, opnode: HOU.OpNode | None) -> None: ...
    def on_deleting_opnode(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def destroy(self) -> None: ...
    def __enter__(self) -> TY.Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
    def init_empty(self) -> None: ...
    def nid_to_saved_data(self, nid: int) -> _SavedData: ...
    def root_saved_data(self) -> _SavedData: ...
    def is_empty(self) -> bool: ...
    def delete_all(self) -> None: ...
    def push_blend_tree(self) -> None: ...
    def saved_to_eph(self, saved_data: _SavedData) -> EphData: ...
    def debug_print(self) -> None: ...
    def add_listener(self, listener: ModelListener) -> None: ...
    def remove_listener(self, listener: ModelListener) -> None: ...
    def add_layer(self, lname: str, value: PaintLayer | None) -> None: ...
    def pull_blend_tree(self) -> bool: ...
    def writing_nid(self) -> int | None: ...
    def set_mask_write(self, is_mask_write: bool) -> None: ...
    def select_canvas(self) -> None: ...
    def write_to_nid(self, nid: int, is_mask_write: bool | None, signal: bool) -> None: ...
    def node_colour(self, nid: int) -> HOU.ImageLayer: ...
    def node_name(self, nid: int) -> str: ...
    def set_node_name(self, nid: int, new_name: str) -> None: ...
    def node_vis(self, nid: int) -> bool: ...
    def set_node_vis(self, nid: int, is_vis: bool) -> None: ...
    def node_chan_c(self, nid: int) -> int: ...
    def set_node_chan_c(self, nid: int, value: int) -> None: ...
    def node_res(self, nid: int) -> tuple[int, int]: ...
    def on_update_res(self) -> None: ...
    def set_node_res(self, nid: int, res: tuple[int, int]) -> None: ...
    def set_all_nodes_res(self, res: tuple[int, int]) -> None: ...
    def node_blend_mode(self, nid: int) -> str: ...
    def set_node_blend_mode(self, nid: int, blend_mode: str) -> None: ...
    def node_opacity(self, nid: int) -> float: ...
    def set_node_opacity(self, nid: int, value: float) -> None: ...
    def has_mask(self, nid: int) -> bool: ...
    def add_mask(self, nid: int, is_white: bool) -> bool: ...
    def toggle_mask(self, nid: int) -> None: ...
    def delete_mask(self, nid: int) -> None: ...
    def merge(self, pr: PrefixedRange) -> None: ...
    def duplicate(self, pr: PrefixedRange) -> None: ...
    def notify_before_reset(self) -> None: ...
    def notify_after_reset(self) -> None: ...
    def notify_writing_layer_changed(self) -> None: ...
    def on_parm_changed(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def find_unused_layer_name(self, lname: str) -> str: ...
    def make_new_nodes(self, srcs: Iterable[PendingNewNodeSrc]) -> NewNodesSrc: ...
    def add_new_created(self, dst: InternalDst, src: MoveSrc) -> bool: ...
    def add_new(self, dst: InternalDst, src: Collection[PendingNewNodeSrc]) -> bool: ...
    def delete(self, pr: PrefixedRange) -> bool: ...
    def move_nodes(self, src: MoveSrc, dst: MoveDst) -> bool: ...
    def move_nodes_impl(self, src: MoveSrc, dst: MoveDst) -> bool: ...

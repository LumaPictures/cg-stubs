from collections.abc import Callable, Container, Mapping, Sequence
from typing import Concatenate, NotRequired, ParamSpec, Protocol, Required, TypeAlias, TypedDict, TypeVar

import hou
from houtypes import (
    ViewerStateCommandKwargs,
    ViewerStateEventKwargs,
    ViewerStateKwargs,
    ViewerStatePlaybackChangeKwargs,
)
from statehud.window import _ParmEventDict

_P = ParamSpec("_P")
_R = TypeVar("_R")
_S = TypeVar("_S", bound="RecordableViewerState")

_RecordedCommand: TypeAlias = tuple[str, str]
_UIEventValue: TypeAlias = int | float | str | tuple[int, ...] | tuple[float, ...] | tuple[str, ...] | None

class _RecordingClass(Protocol):
    FUNCTION_DICT: Mapping[str, str]
    def __init__(self, data: dict[str, object] | hou.UIEventDevice | None = ...) -> None: ...
    def initFromDict(self, d: Mapping[str, object]) -> None: ...
    def initFromObj(self, obj: hou.UIEventDevice) -> None: ...

class _RecordedUIEventDevice(_RecordingClass, Protocol):
    def isAltKey(self) -> bool: ...
    def isAutoRepeat(self) -> bool: ...
    def isCapsLock(self) -> bool: ...
    def isCtrlKey(self) -> bool: ...
    def isKeyPad(self) -> bool: ...
    def isShiftKey(self) -> bool: ...
    def isArrowDown(self) -> bool: ...
    def isArrowLeft(self) -> bool: ...
    def isArrowRight(self) -> bool: ...
    def isArrowUp(self) -> bool: ...
    def isFunctionKey(self) -> bool: ...
    def isKeyPressed(self) -> bool: ...
    def isKeyDown(self) -> bool: ...
    def isKeyUp(self) -> bool: ...
    def keyValue(self) -> int: ...
    def keyString(self) -> str: ...
    def modifierString(self) -> str: ...
    def isLeftButton(self) -> bool: ...
    def isMiddleButton(self) -> bool: ...
    def isRightButton(self) -> bool: ...
    def isLeftButtonReleased(self) -> bool: ...
    def isMiddleButtonReleased(self) -> bool: ...
    def isRightButtonReleased(self) -> bool: ...
    def mouseX(self) -> float: ...
    def mouseY(self) -> float: ...
    def mouseWheel(self) -> float: ...
    def isTablet(self) -> bool: ...
    def tabletAngle(self) -> float: ...
    def tabletPressure(self) -> float: ...
    def tabletRoll(self) -> float: ...
    def tabletTilt(self) -> float: ...
    def time(self) -> float: ...

START_PLAYBACK_COMMAND: str
DRAW_PLAYBACK_COMMAND: str
STOP_PLAYBACK_COMMAND: str
START_RECORDING_COMMAND: str
DEVICE_FUNCTIONS: dict[str, str]

def createRecordingClass(class_name: str, function_dict: Mapping[str, str]) -> type[_RecordingClass]: ...

RecordedUIEventDevice: type[_RecordedUIEventDevice]

# A recorded event, as a recording's playback script builds it from RecordedUIEvent.lines()
# (the device as its values by DEVICE_FUNCTIONS key, or recorded), and a viewer event's ray.
class _RecordedEventData(TypedDict, total=False):
    value: Required[_UIEventValue]
    value_type: Required[hou.EnumValue[hou.uiEventValueType] | _UIEventValue]
    reason: Required[hou.EnumValue[hou.uiEventReason]]
    device: Required[dict[str, bool | int | float | str] | hou.UIEventDevice | _RecordedUIEventDevice]
    origin_point: hou.Vector3 | None
    direction: hou.Vector3 | None
    snapping_ray: hou._SnappingRay | None

# The `command_args` of the recording commands a RecordableViewerState handles.
class _StartRecordingArgs(TypedDict):
    recording_node: hou.OpNode
    result: NotRequired[bool]

class _StopPlaybackArgs(TypedDict, total=False):
    geometry: hou.Geometry
    result: bool

class RecordedUIEvent:
    def __init__(self, data: _RecordedEventData | hou.UIEvent) -> None: ...
    def initFromDict(self, d: _RecordedEventData) -> None: ...
    def initFromObj(self, event: hou.UIEvent) -> None: ...
    def value(self) -> int | float | str | tuple[int, ...] | tuple[float, ...] | tuple[str, ...] | None: ...
    def valueType(
        self,
    ) -> hou.EnumValue[hou.uiEventValueType] | int | float | str | tuple[int, ...] | tuple[float, ...] | tuple[str, ...] | None: ...
    def reason(self) -> hou.EnumValue[hou.uiEventReason]: ...
    def device(self) -> _RecordedUIEventDevice: ...
    def lines(self) -> list[str]: ...
    def __repr__(self) -> str: ...

class RecordedViewerEvent(RecordedUIEvent):
    event: hou.ViewerEvent | None
    origin_point: hou.Vector3 | None
    direction: hou.Vector3 | None
    snapping_ray: hou._SnappingRay | None
    def __init__(self, data: _RecordedEventData | hou.ViewerEvent, scene_viewer: hou.SceneViewer | None = ...) -> None: ...
    def initFromDict(self, d: _RecordedEventData) -> None: ...
    def initFromObj(self, event: hou.ViewerEvent) -> None: ...
    def ray(self) -> tuple[hou.Vector3 | None, hou.Vector3 | None]: ...
    def snappingRay(self) -> hou._SnappingRay | None: ...
    def screenToRay(self, scrx: float, scry: float) -> tuple[hou.Vector3, hou.Vector3]: ...
    def curViewport(self) -> hou.GeometryViewport | None: ...
    def lines(self) -> list[str]: ...
    def __repr__(self) -> str: ...

def filterValue(v: object, type_filter: Container[type[object]] = ...) -> bool: ...
def recordValue(val: object, type_filter: Container[type[object]] = ...) -> str: ...
def getIndentedValue(val: object, d: int, type_filter: Container[type[object]] = ...) -> str: ...
def createCommand(function_name: str, *args: object, **kw: object) -> str: ...

class Recorder:
    scene_viewer: hou.SceneViewer
    buffer_size: int
    recorded_commands: list[_RecordedCommand]
    active: bool
    buffer_locked: bool
    buffer: list[_RecordedCommand]
    scrub_active: bool
    scrub_frequency: int | None
    scrub_counter: int | None
    scrub_buffer: list[_RecordedCommand]
    record_geo_key: str | None
    record_geo_and_buffer_key: str | None
    prev_camera_translation: tuple[float, ...] | None
    prev_camera_rotation: hou.Matrix3 | None
    prev_camera_pivot: tuple[float, ...] | None
    def __init__(self, scene_viewer: hou.SceneViewer, buffer_size: int = ...) -> None: ...
    def activate(self, node: hou.OpNode) -> None: ...
    def deactivate(self, record_buffer: bool = ...) -> None: ...
    def setBufferSize(self, buffer_size: int) -> None: ...
    def setScrubbingFrequency(self, scrub_frequency: int) -> None: ...
    def setRecordGeometryKey(self, record_key_str: str | None, record_with_buffer_key_str: str | None) -> None: ...
    def onInterrupt(self) -> None: ...
    def onResume(self) -> None: ...
    def recordCameraDataCommand(self, force: bool = ...) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def recordUndoEvent(self) -> None: ...
    def recordRedoEvent(self) -> None: ...
    def recordAddGeoEvent(self) -> None: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def recordFrameChangedCommand(self) -> None: ...
    def onHUDParmEvent(self, hud_name: str, kwargs: _ParmEventDict) -> None: ...
    def onCommand(self, kwargs: ViewerStateCommandKwargs, _type_filter: Container[type[object]] = ...) -> bool: ...
    def bufferStateCommand(self, name: str, _type_filter: Container[type[object]] = ..., **kwargs: object) -> None: ...
    def recordedCommands(self) -> list[_RecordedCommand]: ...
    def lockBuffer(self) -> bool: ...
    def unlockBuffer(self) -> None: ...
    def bufferCommand(self, function_name: str, *args: object, **kw: object) -> None: ...
    def appendToBuffer(self, name: str, command: str) -> None: ...
    def clearBuffer(self) -> None: ...
    def popBuffer(self) -> _RecordedCommand | None: ...
    def recordBuffer(self, trigger_name: str | None = ...) -> None: ...

class RecordableViewerState:
    scene_viewer: hou.SceneViewer
    command_arg_type_filter: Container[type[object]]
    def recordableEvent(f: Callable[Concatenate[_S, _P], _R]) -> Callable[Concatenate[_S, _P], _R | bool]: ...
    def requiresRecordingLock(f: Callable[Concatenate[_S, _P], _R]) -> Callable[Concatenate[_S, _P], _R | None]: ...
    def __init__(
        self,
        scene_viewer: hou.SceneViewer,
        record_geo_key: str | None = ...,
        record_geo_and_buffer_key: str | None = ...,
        command_arg_type_filter: Container[type[object]] = ...,
    ) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def isOnFloatingPanel(self) -> bool: ...
    def startRecording(self, kwargs: _StartRecordingArgs) -> None: ...
    def stopRecording(self) -> None: ...
    def recordHUDParmEvent(self, name: str, kwargs: _ParmEventDict) -> None: ...
    def recordBuffer(self, name: str | None) -> None: ...
    def startPlayback(self) -> None: ...
    def drawPlayback(self) -> None: ...
    def stopPlayback(self, kwargs: _StopPlaybackArgs) -> None: ...
    def savePlaybackOutputGeometry(self, geo: hou.Geometry) -> None: ...
    def addPlaybackOutputGeometry(self) -> None: ...
    def onCommand(self, kwargs: ViewerStateCommandKwargs) -> bool: ...

def recordStateBuffer(state: RecordableViewerState, name: str | None = ...) -> None: ...

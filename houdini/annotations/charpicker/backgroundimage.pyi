from typing import TypedDict

from PySide6 import QtGui

from .resizewidget import ResizeMode

class _ImageMap(TypedDict):
    x: int
    y: int
    catalog_ref: str
    width: float | None
    height: float | None
    rotation: float
    flip_h: bool
    flip_v: bool

class BackgroundImage:
    def __init__(self, tab_view: "tabview.TabView", image_id: str, catalog_ref: str, flip_h: bool = ..., flip_v: bool = ...) -> None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...
    def toMap(self) -> _ImageMap: ...
    def setFromMap(self, m: _ImageMap) -> None: ...
    def select(self) -> None: ...
    def deselect(self) -> None: ...
    def updateSize(self) -> None: ...
    def setFlipH(self, flip: bool) -> None: ...
    def setFlipV(self, flip: bool) -> None: ...
    def resizeMode(self) -> ResizeMode: ...
    def minimumResizeSize(self) -> tuple[int, int]: ...
    def setInteractive(self, interactive: bool) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def delete(self) -> None: ...

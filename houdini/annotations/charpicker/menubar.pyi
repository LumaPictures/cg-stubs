from collections.abc import Sequence
from typing import TypeAlias

from PySide6 import QtCore, QtGui, QtWidgets
from husdui.widgets import ColorSwatch

from charpicker import cpglobals
from charpicker.mainwidget import CharacterPicker
from charpicker.tabview import TabView

Layer: TypeAlias = cpglobals.Layer
SelectionState: TypeAlias = cpglobals.SelectionState
Mode: TypeAlias = cpglobals.Mode


TOOLBAR_ICON_SIZE: int
TOOLBAR_BUTTON_SIZE: int
TOOLBAR_SPACING: int


class TargetSelectorWidget(QtWidgets.QWidget):
    setFromViewportSignal: QtCore.Signal
    editTargetSignal: QtCore.Signal

    def __init__(self, edit_paths_label: str, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def setTargetPaths(self, path_lists: Sequence[Sequence[str]]) -> None: ...


class ButtonNameWidget(QtWidgets.QWidget):
    nameEditedSignal: QtCore.Signal

    def __init__(self, parent: QtWidgets.QWidget | None = ..., label: str = ..., empty_placeholder: str = ...) -> None: ...
    def setNames(self, labels: Sequence[str]) -> None: ...


class CanvasSizeWidget(QtWidgets.QWidget):
    sizeEditedSignal: QtCore.Signal

    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def isEditing(self) -> bool: ...
    def setSize(self, width: int, height: int) -> None: ...
    def setEditable(self, editable: bool) -> None: ...


class LabelFontSizeWidget(QtWidgets.QWidget):
    fontSizeEditedSignal: QtCore.Signal

    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def fontSize(self) -> int: ...
    def setFontSize(self, size: int) -> None: ...
    def clearFontSize(self) -> None: ...
    def setEditable(self, editable: bool) -> None: ...


class LayerSelectorWidget(QtWidgets.QWidget):
    layerChangedSignal: QtCore.Signal

    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def currentLayer(self) -> cpglobals.Layer: ...
    def setLayer(self, layer: cpglobals.Layer) -> None: ...
    def setEditable(self, editable: bool) -> None: ...


class CharacterPickerMenuBarBase:
    def __init__(self, picker: CharacterPicker) -> None: ...
    def handleLayoutLoaded(self) -> None: ...
    def createEditModeButton(self, button_size: int | None = ..., icon_size: int | None = ...) -> QtWidgets.QToolButton: ...
    def getEditModeButton(self) -> QtWidgets.QToolButton | None: ...
    def createCanvasSizeWidget(self) -> CanvasSizeWidget: ...
    def getCanvasSizeWidget(self) -> CanvasSizeWidget | None: ...
    def createCanvasResizeButton(self) -> QtWidgets.QToolButton: ...
    def getCanvasResizeButton(self) -> QtWidgets.QToolButton | None: ...
    def setCanvasResizeChecked(self, checked: bool) -> None: ...
    def createBgColorSwatch(self) -> ColorSwatch: ...
    def getBgColorSwatch(self) -> ColorSwatch | None: ...
    def createLayerSelector(self) -> LayerSelectorWidget: ...
    def getLayerSelector(self) -> LayerSelectorWidget | None: ...
    def createTargetSelector(self, edit_paths_label: str) -> TargetSelectorWidget: ...
    def createButtonNameWidget(self) -> ButtonNameWidget: ...
    def createShowLabelToggle(self) -> QtWidgets.QToolButton: ...
    def createButtonColorSwatch(self) -> ColorSwatch: ...
    def createLabelTextWidget(self) -> ButtonNameWidget: ...
    def createLabelColorSwatch(self) -> ColorSwatch: ...
    def createLabelFontSizeWidget(self) -> LabelFontSizeWidget: ...
    def createAlignDistributeToolbar(self) -> QtWidgets.QWidget: ...
    def setActiveView(self, view: TabView | None) -> None: ...
    def setMenuBarWidget(self, menu_bar: QtWidgets.QMenuBar) -> None: ...
    def getMenuBarWidget(self) -> QtWidgets.QMenuBar | None: ...
    def handleEditModeToggled(self, is_active: bool) -> None: ...
    def toggleEditMode(self) -> None: ...
    def isEditModeButtonEnabled(self) -> bool: ...
    def isBoxPickActionEnabled(self) -> bool: ...
    def isLassoPickActionEnabled(self) -> bool: ...
    def reset(self) -> None: ...


class CharacterPickerMenuBar(CharacterPickerMenuBarBase):
    boxPickAction: QtGui.QAction
    lassoPickAction: QtGui.QAction
    selectAction: QtGui.QAction

    def __init__(self, picker: CharacterPicker, full_menu: bool = ...) -> None: ...
    def isBoxPickActionEnabled(self) -> bool: ...
    def isLassoPickActionEnabled(self) -> bool: ...

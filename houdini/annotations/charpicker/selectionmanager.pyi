from collections.abc import Mapping, Sequence
from typing import NotRequired, Protocol, TypeAlias, TypedDict, Unpack

import hou
from houtypes import NodeEventKwargs

from charpicker import cpglobals
from charpicker.controlbutton import ControlButton
from charpicker.mainwidget import CharacterPicker

SelectionState: TypeAlias = cpglobals.SelectionState


class _NodeEventCallback(Protocol):
    def __call__(self, **kwargs: Unpack[NodeEventKwargs]) -> object: ...


class _InitialButtonData(TypedDict):
    name: str | None
    ctrl_paths: list[str]
    color: hou.Color | None
    behavior: NotRequired[str | None]


class ButtonSelectionManager:
    def __init__(self, char_picker: CharacterPicker) -> None: ...
    def getEditPathsMenuOptionText(self) -> str: ...
    def getToolTipTitleAndText(self, ctrl_paths: Sequence[str]) -> tuple[str, str]: ...
    def getFullControlPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def filterValidPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def addCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def removeCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def getSelectedControlPaths(self, char_path: str, ctrl_paths: Sequence[str], parent_selection: Mapping[str, ControlButton]) -> list[str]: ...
    def getViewportSelection(self, char_path: str) -> list[str]: ...
    def getActiveSelectionGroups(self) -> list[_InitialButtonData]: ...
    def getControlScreenPositions(self, ctrl_paths: Sequence[str]) -> dict[str, tuple[float, float]]: ...
    def getInitialButtonData(self, char_path: str, group_index: int = ...) -> _InitialButtonData: ...
    def getControlColor(self, ctrl_path: str) -> hou.Color | None: ...
    def getBehaviorForPaths(self, ctrl_paths: Sequence[str]) -> str | None: ...
    def getSelectionState(self, char_path: str, ctrl_paths: Sequence[str]) -> cpglobals.SelectionState: ...
    def getUpdatedControlPaths(self, char_path: str, ctrl_paths: Sequence[str], changed_path: str) -> tuple[bool, list[str]]: ...
    def ignoreSelections(self) -> bool: ...
    def updatePathsOnToolTip(self) -> bool: ...
    def enableFromSelectionActions(self) -> bool: ...


class KineFXButtonSelectionManager(ButtonSelectionManager):
    def getEditPathsMenuOptionText(self) -> str: ...
    def getToolTipTitleAndText(self, ctrl_paths: Sequence[str]) -> tuple[str, str]: ...
    def getFullControlPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def filterValidPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def addCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def removeCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def getSelectionState(self, char_path: str, ctrl_paths: Sequence[str]) -> cpglobals.SelectionState: ...
    def getSelectedControlPaths(self, char_path: str, ctrl_paths: Sequence[str], parent_selection: Mapping[str, ControlButton]) -> list[str]: ...
    def getViewportSelection(self, char_path: str) -> list[str]: ...


class ObjectButtonSelectionManager(ButtonSelectionManager):
    ACCEPTED_TARGETS: list[hou.NodeTypeCategory]

    def getEditPathsMenuOptionText(self) -> str: ...
    def getToolTipTitleAndText(self, ctrl_paths: Sequence[str]) -> tuple[str, str]: ...
    def getFullControlPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def filterValidPaths(self, char_path: str, ctrl_paths: Sequence[str]) -> list[str]: ...
    def addCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def removeCallbacks(self, char_path: str, ctrl_paths: Sequence[str], selection_changed_callback: _NodeEventCallback, ctrl_paths_changed_callback: _NodeEventCallback) -> None: ...
    def getUpdatedControlPaths(self, char_path: str, ctrl_paths: Sequence[str], changed_path: str) -> tuple[bool, list[str]]: ...
    def getSelectedControlPaths(self, char_path: str, ctrl_paths: Sequence[str], parent_selection: Mapping[str, ControlButton]) -> list[str]: ...
    def getViewportSelection(self, char_path: str) -> list[str]: ...
    def updatePathsOnToolTip(self) -> bool: ...
    def enableFromSelectionActions(self) -> bool: ...

_GridSettings = TypedDict("_GridSettings", {
    "enabled": bool,
    "snap_enabled": bool,
    "item_snap_enabled": bool,
    "cell_size": int,
})

# A view in the picker file, as TabView.toDict() makes it; the keys are the cpglobals._JSON_*
# constants. Files from older versions can lack the optional keys, and only they have
# "Background Image".
_ViewDict = TypedDict("_ViewDict", {
    "id": Required[int],
    "bg_size": list[int],
    "View Scale": Required[float],
    "Buttons": Required[list[_ButtonMap]],
    "Images": list[_ImageMap],
    "Labels": list[_LabelMap],
    "Sliders": Required[list[_SliderMap]],
    "grid_settings": _GridSettings,
    "bg_color": str,
    "Background Image": str,
}, total=False)

Orientation: type[cpglobals.Orientation]
Anchor: type[cpglobals.Anchor]



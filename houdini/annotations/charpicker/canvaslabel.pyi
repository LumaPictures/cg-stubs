from typing import TypedDict

from PySide6 import QtGui

from .resizewidget import ResizeMode

class _LabelMap(TypedDict):
    x: int
    y: int
    text: str
    color: str
    font_size: int
    width: float | None
    height: float | None
    rotation: float

class CanvasLabel:
    def __init__(self, tab_view: "tabview.TabView", label_id: str, text: str = ...) -> None: ...
    def setText(self, text: str) -> None: ...
    def setColor(self, color: QtGui.QColor) -> None: ...
    def setFontSize(self, size: int) -> None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...
    def toMap(self) -> _LabelMap: ...
    def setFromMap(self, m: _LabelMap) -> None: ...
    def select(self) -> None: ...
    def deselect(self) -> None: ...
    def setInteractive(self, interactive: bool) -> None: ...
    def resizeMode(self) -> ResizeMode: ...
    def minimumResizeSize(self) -> tuple[int, int]: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseDoubleClickEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def startTextEdit(self) -> None: ...
    def cancelInPlaceTextEdit(self) -> None: ...
    def finishInPlaceTextEdit(self) -> None: ...
    def delete(self) -> None: ...

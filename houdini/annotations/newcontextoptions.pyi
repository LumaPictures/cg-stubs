class _OptionConfig(TypedDict, total=False):
    label: str
    typeName: str
    hidden: bool
    minimum: float
    maximum: float
    min_locked: bool
    max_locked: bool
    menu_source: str
    menu_items: list[list[str | int | float]]
    file_pattern: str
    safe_name: bool

class _ChangeConfig(TypedDict, total=False):
    type_name: str
    label: str
    order: int
    hidden: bool
    minimum: float
    maximum: float
    min_locked: bool
    max_locked: bool
    menu_items: Sequence[tuple[str, str | int | float]]
    menu_source: str
    file_pattern: str
    safe_name: bool

class _OptionData(TypedDict):
    name: str
    label: str
    typeName: str
    value: int | float | str
    comment: str
    order: int
    hidden: bool
    isAutomatic: bool
    minimum: float
    maximum: float
    minLocked: bool
    maxLocked: bool
    menuItems: list[tuple[str, str | int | float]]
    menuSource: str
    usesAutovalues: bool
    displayLabel: str
    effectiveMenuItems: list[list[Any]]
    safeName: bool
    sliderPos: float | None
    _option: Option

class _SuppressUndoContext:
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...

suppress_undo: _SuppressUndoContext

def sanitize_option_name(name: str) -> str: ...


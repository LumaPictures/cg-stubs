# What Option.json() returns: the option's settings, named as Option.__init__()'s arguments.
class _OptionJson(TypedDict):
    name: str
    value: float | str
    label: str
    type: str
    order: int
    comment: str
    menu_items: list[tuple[str, str | int | float]]
    autovalues: bool
    menu_source: str
    minimum: float
    maximum: float
    min_locked: bool
    max_locked: bool
    hidden: bool
    file_pattern: str
    safe_name: bool
    slider_pos: NotRequired[float]

class Option:
    def json(self) -> _OptionJson: ...
    def __init__(self, name: str = ..., value: int | float | str | None = ..., label: str = ..., type: OptionType | str = ..., order: int = ..., menu_items: _MenuPairs = ..., menu_source: str = ..., minimum: float = ..., maximum: float = ..., min_locked: bool = ..., max_locked: bool = ..., comment: str = ..., autovalues: bool = ..., live: bool = ..., read_config: bool = ..., hidden: bool = ..., file_pattern: str = ..., safe_name: bool = ..., slider_pos: float | None = ...) -> None: ...
    def __repr__(self) -> str: ...
    def value(self) -> float | str: ...
    def setValue(self, value: int | float | str | None) -> bool: ...
    def menuItemJson(self) -> list[tuple[str, str | int | float]]: ...
    def menuItems(self) -> list[MenuItem]: ...
    def setMenuItems(self, menu_items: _MenuPairs) -> None: ...
    def minimum(self) -> float: ...
    def setMinimum(self, value: float) -> None: ...
    def maximum(self) -> float: ...
    def setMaximum(self, value: float) -> None: ...

class MenuItem(NamedTuple):
    name: str
    value: str | int | float


class DraggableModel(PySide6.QtCore.QAbstractTableModel, Generic[T, _J]):
    MimeType: ClassVar[str]
    column_labels: ClassVar[list[str]]
    def __init__(self, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def jsonForRow(self, row: int) -> _J: ...
    def itemFromJson(self, obj: _J) -> T: ...
    def json(self) -> list[_J]: ...
    def headerData(self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int = ...) -> str | PySide6.QtCore.QSize | None: ...
    def mimeTypes(self) -> list[str]: ...
    def dropMimeData(self, data: PySide6.QtCore.QMimeData, action: PySide6.QtCore.Qt.DropAction, row: int, column: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool | None: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def updateAllItems(self, items: Sequence[T]) -> None: ...
    def allItems(self) -> list[T]: ...
    def insertRows(self, row: int, count: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> bool: ...
    def setIgnoreRemoveRows(self) -> None: ...
    def removeRows(self, row: int, count: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> bool: ...

class MenuItemModel(DraggableModel[MenuItem, _MenuItemJson]):
    NameCol: ClassVar[int]
    ValueCol: ClassVar[int]

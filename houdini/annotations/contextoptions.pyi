    column_labels: ClassVar[list[str]]
    def __init__(self, parent: PySide6.QtCore.QObject | None = ...) -> None: ...
    def jsonForRow(self, row: int) -> _MenuItemJson: ...
    def itemFromJson(self, obj: _MenuItemJson) -> MenuItem: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> str | int | float | None: ...
    def setData(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, value: str | int | float, role: int = ...) -> bool: ...

class OptionsModel(DraggableModel[Option, _OptionJson]):

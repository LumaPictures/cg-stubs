_MenuPairs: TypeAlias = Sequence[tuple[str, str | int | float]]
_J = TypeVar("_J")

class _MenuItemJson(TypedDict):
    name: str
    value: str | int | float

class _OptionKwargs(TypedDict, total=False):
    value: int | float | str | None
    label: str
    type: OptionType | str
    order: int
    menu_items: _MenuPairs
    menu_source: str
    minimum: float
    maximum: float
    min_locked: bool
    max_locked: bool
    comment: str
    autovalues: bool
    live: bool
    hidden: bool
    file_pattern: str
    safe_name: bool
    slider_pos: float | None

class _OptionDefaults(TypedDict):
    label: str
    value: int | float | str
    menu_items: NotRequired[_MenuPairs]
    menu_source: NotRequired[str]

class UpdateState:
    level: int
    def __init__(self) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...
    def __bool__(self) -> bool: ...

ignore_updates: UpdateState


import threading
from typing import Any, Literal, overload

from rpyc.core.protocol import Connection

def start_server(port: int = ..., use_thread: bool = ..., quiet: bool = ...) -> threading.Thread | None: ...
# The default "hou" is wrapped to keep the remote time in sync; any other module is rpyc's
# proxy of it.
@overload
def import_remote_module(
    server: str = ..., port: int = ..., name: Literal["hou"] = ...
) -> tuple[Connection, _RemoteHouAttrWrapper]: ...
@overload
def import_remote_module(server: str = ..., port: int = ..., name: str = ...) -> tuple[Connection, Any]: ...

class _RemoteHouAttrWrapper:
    # Wraps an attribute of a remote hou module, which rpyc proxies.
    def __init__(self, remote_hou: Any, attr: Any) -> None: ...
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    def __getattribute__(self, name: str) -> Any: ...

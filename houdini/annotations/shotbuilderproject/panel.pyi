    def reactivate(self, units: Iterable[_Index]) -> None: ...
    def deprecate(self, units: Iterable[_Index]) -> None: ...
    def editIcon(self, indexes: Sequence[_Index]) -> None: ...
    # The view's (proxy) index of the unit's row.
    def editUnit(self, source_index: _Index) -> None: ...


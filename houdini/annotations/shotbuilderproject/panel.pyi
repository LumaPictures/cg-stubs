class ShotBuilderTreeItem:
    parentItem: "ShotBuilderTreeItem | None"
    icon: QtGui.QIcon | None
    name: str
    linkedUnits: str | None
    isDeprecated: bool
    # Floats from the unit layer's time codes, or the Edit Shot dialog's line edit text.
    startFrame: float | str
    endFrame: float | str
    version: int | str
    childItems: list["ShotBuilderTreeItem"]
    def __init__(
        self,
        parent: "ShotBuilderTreeItem | None",
        icon: QtGui.QIcon | None,
        name: str,
        linkedunits: str | None = ...,
        isdeprecated: bool = ...,
        startframe: float | str = ...,
        endframe: float | str = ...,
        version: int | str = ...,
    ) -> None: ...
    @staticmethod
    def root() -> "ShotBuilderTreeItem": ...
    def appendChild(self, item: "ShotBuilderTreeItem") -> None: ...
    def child(self, row: int) -> "ShotBuilderTreeItem": ...
    def childCount(self) -> int: ...
    def columnCount(self) -> int: ...
    @overload
    def data(self, column: Literal[0]) -> str: ...
    @overload
    def data(self, column: Literal[1]) -> str | None: ...
    @overload
    def data(self, column: Literal[2, 3]) -> float | str: ...
    @overload
    def data(self, column: Literal[4]) -> int | str: ...
    @overload
    def data(self, column: int) -> str | float | None: ...
    def iconData(self, column: int) -> QtGui.QIcon | None: ...
    def getForegroundBrush(self) -> QtGui.QBrush | None: ...
    def getFont(self) -> QtGui.QFont: ...
    def parent(self) -> "ShotBuilderTreeItem | None": ...
    def row(self) -> int: ...

class ShotBuilderModel(QtCore.QAbstractItemModel):
    NameColumn: Literal[0]
    LinkedUnitsColumn: Literal[1]
    StartFrameColumn: Literal[2]
    EndFrameColumn: Literal[3]
    VersionColumn: Literal[4]
    pattern: re.Pattern[str]
    sublayerpattern: re.Pattern[str]
    rootItem: "ShotBuilderTreeItem"
    project: ProjectConfig
    def __init__(self, parent: QtCore.QObject | None = ...) -> None: ...
    def clear(self) -> None: ...
    def data(
        self, index: _Index, role: int = ...
    ) -> str | float | QtGui.QIcon | QtGui.QBrush | QtGui.QFont | None: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int) -> str | None: ...
    def columnCount(self, parent: _Index) -> int: ...
    def rowCount(self, parent: _Index) -> int: ...
    def index(self, row: int, column: int, parent: _Index) -> QtCore.QModelIndex: ...
    def parent(self, index: _Index) -> QtCore.QModelIndex: ...
    # The "versions" map of the layer's hpr resolver context: layer keys to pinned versions.
    def getVersionMap(self, identifier: str) -> dict[str, int] | None: ...
    # Rebuilds the tree from the project config; the panel is unused.
    def setData(self, panel: QtCore.QObject | None) -> None: ...
    def addRows(self, row: int, count: int, parent: _Index, unit: str) -> Literal[True] | None: ...
    def addSublayerRows(self, row: int, count: int, parent: _Index, sublayer: str) -> Literal[True]: ...
    def removeRows(self, row: int, count: int, parent: _Index) -> bool: ...

class ShotBuilderFilterProxy(QtCore.QSortFilterProxyModel):
    enabledUnitTypes: list[str]
    showDeprecated: bool
    showLinkedUnits: bool
    showVersions: bool
    def __init__(self) -> None: ...
    # Kept and changed in place by setUnitTypeEnabled().
    def initializeUnitTypes(self, unitTypes: list[str]) -> None: ...
    def setUnitTypeEnabled(self, unitType: str, enabled: bool) -> None: ...
    def setShowDeprecated(self, show: bool) -> None: ...
    def setShowLinkedUnits(self, show: bool) -> None: ...
    def setShowVersions(self, show: bool) -> None: ...
    def filterAcceptsColumn(self, colIdx: int, parent: _Index) -> bool: ...
    def filterAcceptsRow(self, rowIdx: int, parent: _Index) -> bool: ...
    def lessThan(self, left: _Index, right: _Index) -> bool: ...
    # The panel always filters its ShotBuilderModel, whose items the filter reads.
    @type_check_only
    def sourceModel(self) -> "ShotBuilderModel": ...


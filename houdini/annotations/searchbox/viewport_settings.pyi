from collections.abc import Callable

import hou

from .common import Category, ResultItem

class ViewportSettings(Category):
    NAME: str
    ALIASES: list[str]

    class Item(ResultItem):
        def __init__(self, method: tuple[str, str], settings: hou.GeometryViewportSettings) -> None: ...
        def label(self) -> str: ...
        def secondaryLabel(self) -> str: ...
        def hasNext(self) -> bool: ...
        def next(self) -> list[Category]: ...
        def action(self) -> None: ...

    def __init__(self) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list["ViewportSettings.Item"]]: ...

class Setting(Category):
    class Item(ResultItem):
        def __init__(self, label: str, action: Callable[[], object]) -> None: ...
        def label(self) -> str: ...
        def action(self) -> None: ...

    def __init__(self, parent: hou.GeometryViewportSettings, setting: tuple[str, str]) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list["Setting.Item"]]: ...

class Item(ResultItem):
    def __init__(self, sv: hou.SceneViewer | None, pref: tuple[str, str]) -> None: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str: ...
    def action(self) -> None: ...

class DisplayOptions(Category):
    NAME: str
    ALIASES: list[str]
    def __init__(self) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list[Item]]: ...

from collections.abc import Callable, Sequence
from concurrent.futures import Executor

from PySide6 import QtCore, QtGui, QtWidgets

from .common import Category, ResultItem

ICON_SIZE: int
BLANK_ICON: QtGui.QPixmap
ARROW_SIZE: int
ARROW_THICK: int

class ListModel(QtCore.QAbstractListModel):
    ITEM_ROLE: int
    def __init__(self, parent: QtCore.QObject | None, categories: Sequence[Category]) -> None: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> QtCore.Qt.ItemFlag: ...
    def columnCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def data(
        self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = ...
    ) -> (
        Category
        | ResultItem
        | QtGui.QFont
        | QtGui.QBrush
        | QtCore.QSize
        | QtGui.QIcon
        | QtGui.QPixmap
        | QtCore.Qt.AlignmentFlag
        | str
        | None
    ): ...
    def setCategories(self, categories: Sequence[Category]) -> None: ...
    def setText(self, text: str, executor: Executor) -> None: ...
    def runAfterTask(self, run_action: Callable[[ResultItem], object]) -> None: ...

class ItemDelegate(QtWidgets.QStyledItemDelegate):
    def paint(
        self,
        painter: QtGui.QPainter,
        option: QtWidgets.QStyleOptionViewItem,
        index: QtCore.QModelIndex | QtCore.QPersistentModelIndex,
    ) -> None: ...

class SearchBox(QtWidgets.QLineEdit):
    def __init__(self, parent: "SearchDialog") -> None: ...
    def setCompletion(self, completion: str | None) -> None: ...
    def completion(self) -> str | None: ...
    def eventFilter(self, obj: QtCore.QObject, event: QtCore.QEvent) -> bool: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...

class Header(QtWidgets.QWidget):
    def __init__(self, parent: QtWidgets.QWidget) -> None: ...
    def setText(self, text: str) -> None: ...

class SearchDialog(QtWidgets.QWidget):
    def __init__(self, parent: QtWidgets.QWidget, categories: Sequence[Category]) -> None: ...
    def enter(self) -> None: ...
    def next(self) -> None: ...
    def prev(self) -> None: ...
    def currentResultItem(self) -> ResultItem | None: ...
    def currentDisplayCompletion(self) -> str | None: ...
    def currentCompletion(self) -> str | None: ...
    def selectRow(self, increment: int, feedback: bool = ...) -> None: ...
    def textEdited(self, text: str) -> None: ...
    def modelReset(self) -> None: ...
    def listClicked(self, index: QtCore.QModelIndex) -> None: ...
    def listEntered(self, index: QtCore.QModelIndex) -> None: ...
    def closeEvent(self, event: QtGui.QCloseEvent) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...

def show(categories: Sequence[Category] | None = ...) -> None: ...

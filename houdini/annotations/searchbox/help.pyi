class HelpItem(ResultItem):
    def __init__(
        self,
        title: str,
        path: str,
        summary: str | None = ...,
        pagetype: str | None = ...,
        category: str | None = ...,
        iconname: str | None = ...,
        score: float = ...,
    ) -> None: ...
    def icon(self) -> hou.qt.Icon | None: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str | None: ...
    def feedback(self) -> str: ...
    def action(self) -> None: ...

class MoreHelpItem(ResultItem):
    def __init__(self, pagetype: str, shown: int, total: int, query: str, iconname: str | None = ...) -> None: ...
    def typeName(self) -> str: ...
    def typePlural(self) -> str | None: ...
    def icon(self) -> hou.qt.Icon | None: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str: ...
    def hasNext(self) -> bool: ...
    def next(self) -> list[Category]: ...
    def nextPrompt(self) -> str: ...
    def nextPlaceholder(self) -> str: ...
    def nextSearch(self) -> str: ...
    def action(self) -> None: ...

class MultiHelpItem(ResultItem):
    def __init__(self, hitgroups: Mapping[str, int], query: str, total: int) -> None: ...
    def icon(self) -> hou.qt.Icon: ...
    def label(self) -> str: ...
    def hasNext(self) -> bool: ...
    def next(self) -> list[Category]: ...
    def nextPrompt(self) -> str: ...
    def nextSearch(self) -> str: ...

class Help(Category):
    NAME: str
    ALIASES: list[str]
    @classmethod
    def isDefault(cls) -> bool: ...
    def __init__(self, focus: str | None = ..., limit: int | None = ...) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list[HelpItem | MoreHelpItem]]: ...

import hou

from .common import Category, ResultItem

class Item(ResultItem):
    def __init__(self, path: str, path_match: bool, pane_tab: hou.PathBasedPaneTab | None) -> None: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str | None: ...
    def icon(self) -> hou.qt.Icon | None: ...
    def hasNext(self) -> bool: ...
    def next(self) -> list[Category]: ...
    def nextPrompt(self) -> str: ...
    def nextPlaceholder(self) -> str: ...
    def action(self) -> None: ...

class Nodes(Category):
    NAME: str
    def __init__(self) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list[Item]]: ...

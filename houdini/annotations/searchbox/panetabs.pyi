import hou

from .common import Category, ResultItem

class Item(ResultItem):
    def __init__(self, tab: hou.PaneTab) -> None: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str: ...
    def action(self) -> None: ...

class PaneTabs(Category):
    NAME: str
    ALIASES: list[str]
    def __init__(self) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list[Item]]: ...

import re
from collections.abc import Callable, Iterable, Sequence

import hou

from .common import Category, ResultItem

class Item(ResultItem):
    def __init__(
        self,
        parm: tuple[str, str, hou.EnumValue[hou.parmTemplateType]],
        nodes: Sequence[hou.OpNode],
        parm_dialog: hou.ParameterEditor | hou.NetworkEditor | None,
    ) -> None: ...
    def label(self) -> str: ...
    def hasNext(self) -> bool: ...
    def next(self) -> list[Category]: ...
    def nextPrompt(self) -> str: ...
    def nextPlaceholder(self) -> str: ...
    def action(self) -> None: ...

class Parms(Category):
    NAME: str
    ALIASES: list[str]
    def __init__(self, nodes: Sequence[hou.OpNode] = ...) -> None: ...
    def label(self) -> str: ...
    PATTERN: re.Pattern[str]
    def filter(self, text: str) -> tuple[float, list[Item]]: ...

class MenuChoices(Category):
    class Item(ResultItem):
        def __init__(self, i: str, label: str, parms: Iterable[hou.Parm]) -> None: ...
        def label(self) -> str: ...
        def action(self) -> None: ...

    def __init__(self, pts: Iterable[hou.ParmTuple]) -> None: ...
    def label(self) -> str: ...
    def filter(self, text: str) -> tuple[float, list["MenuChoices.Item"]]: ...

class Operations(Category):
    class Item(ResultItem):
        def __init__(
            self,
            label: str,
            pts: Sequence[hou.ParmTuple],
            action: Callable[[Sequence[hou.ParmTuple]], object],
        ) -> None: ...
        def label(self) -> str: ...
        def feedback(self) -> None: ...
        def action(self) -> None: ...

    def __init__(self, pts: Sequence[hou.ParmTuple]) -> None: ...
    def label(self) -> str: ...
    NUM: str
    NUM_ALL: re.Pattern[str]
    NUM_TUP2: re.Pattern[str]
    NUM_TUP3: re.Pattern[str]
    NUM_COMP: re.Pattern[str]
    def filter(self, text: str) -> tuple[float, list["Operations.Item"]]: ...

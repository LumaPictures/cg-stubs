class LayerBuilder:
    @staticmethod
    def buildHighlightLayer(scene_viewer: hou.SceneViewer | hou.CompositorViewer, layer: hou.ImageLayer | None = ...) -> hou.ImageLayer: ...
    @staticmethod
    def buildPreHighlightLayer(
        scene_viewer: hou.SceneViewer | hou.CompositorViewer,
        dev: hou.UIEventDevice | None = ...,
        layer: hou.ImageLayer | None = ...,
    ) -> hou.ImageLayer: ...
    @staticmethod
    def buildColorLayer(layer: hou.ImageLayer | None = ..., color: Sequence[float] = ...) -> hou.ImageLayer: ...
    # A scene viewer's colors carry its alpha; the compositor's are RGB.
    @overload
    @staticmethod
    def getPrimHighlightColor(scene_viewer: hou.SceneViewer) -> tuple[float, float, float, float]: ...
    @overload
    @staticmethod
    def getPrimHighlightColor(scene_viewer: hou.CompositorViewer) -> tuple[float, float, float]: ...
    @staticmethod
    def getPrimHighlightColor(
        scene_viewer: hou.SceneViewer | hou.CompositorViewer,
    ) -> tuple[float, float, float, float] | tuple[float, float, float]: ...
    @overload
    @staticmethod
    def getPrimPreHighlightColor(
        scene_viewer: hou.SceneViewer, pick_mod: hou.EnumValue[hou.pickModifier]
    ) -> tuple[float, float, float, float]: ...
    @overload
    @staticmethod
    def getPrimPreHighlightColor(
        scene_viewer: hou.CompositorViewer, pick_mod: hou.EnumValue[hou.pickModifier]
    ) -> tuple[float, float, float]: ...
    @staticmethod
    def getPrimPreHighlightColor(
        scene_viewer: hou.SceneViewer | hou.CompositorViewer, pick_mod: hou.EnumValue[hou.pickModifier]
    ) -> tuple[float, float, float, float] | tuple[float, float, float]: ...


def removeParmTuple(self: hou.HDADefinition, name: str) -> None: ...
def addParmFolder(
    self: hou.HDADefinition,
    folder_name: str,
    in_folder: Sequence[str] = ...,
    parm_name: str | None = ...,
    create_missing_folders: bool = ...,

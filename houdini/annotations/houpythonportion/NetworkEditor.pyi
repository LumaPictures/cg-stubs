from typing import TypeAlias

import hou

# _scrollTo only recognises a list, not other sequences.
_Parms: TypeAlias = (
    str
    | hou.Parm
    | hou.ParmTuple
    | list[str]
    | list[hou.Parm]
    | list[hou.ParmTuple]
    | list[str | hou.Parm | hou.ParmTuple]
)

def autoPlaceNodes(self: hou.NetworkEditor) -> bool: ...
def autoScrollNodes(self: hou.NetworkEditor) -> bool: ...
def listMode(self: hou.NetworkEditor) -> bool: ...
def setListMode(self: hou.NetworkEditor, list_mode: bool) -> None: ...
def selectPosition(
    self: hou.NetworkEditor,
    input_node: hou.NetworkMovableItem | None = ...,
    output_index: int = ...,
    output_node: hou.NetworkMovableItem | None = ...,
    input_index: int = ...,
) -> hou.Vector2 | None: ...
def selectItems(
    self: hou.NetworkEditor, prompt_message: str, clear_selected: bool = ...
) -> tuple[hou.NetworkMovableItem, ...]: ...
def homeToSelection(self: hou.NetworkEditor) -> None: ...
def frameSelection(self: hou.NetworkEditor) -> None: ...
def insertIntoUnderlyingConnections(
    self: hou.NetworkEditor, node: hou.Node, x: float, y: float
) -> None: ...
def autoAddToNetbox(self: hou.NetworkEditor, node: hou.Node) -> None: ...
def modifyPositionForNode(
    self: hou.NetworkEditor, pos: hou.Vector2, node: hou.Node
) -> hou.Vector2: ...
def parmScrollTo(
    self: hou.NetworkEditor,
    parms: _Parms,
    scroll_pos: hou.EnumValue[hou.scrollPosition] = ...,
) -> None: ...
def parmMoveFocusTo(self: hou.NetworkEditor, parm: str | hou.Parm | hou.ParmTuple) -> None: ...

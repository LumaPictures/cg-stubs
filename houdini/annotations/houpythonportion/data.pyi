from collections.abc import Sequence
from typing import Any

import hou
from hrecipes import rtypes
from hrecipes.api import Ref

def dataFromParms(parms: Sequence[hou.ParmTuple], **parms_opts: Any) -> rtypes.ParmDataDict: ...
def selectedItemsAsData(**items_opts: Any) -> rtypes.NetworkItemDataDict | None: ...
def itemsAsData(items: list[hou.NetworkMovableItem], **items_opts: Any) -> rtypes.NetworkItemDataDict | None: ...
def createItemsFromData(
    parent: hou.OpNode, data: rtypes.NetworkItemDataDict, **items_set_opts: Any
) -> dict[str, hou.NetworkMovableItem]: ...
def clusterItemsAsData(items: Sequence[hou.NetworkMovableItem], **cluster_opts: Any) -> rtypes.ClusterData: ...
def createClusterItemsFromData(
    parent: hou.OpNode, data: rtypes.ClusterData, **cluster_set_opts: Any
) -> rtypes.ClusterOutputData: ...
def dataFromRecipe(name: str) -> rtypes._RecipeDataPayload: ...
def saveParmPresetRecipe(
    name: str, label: str, location: str, parm: hou.ParmTuple, **parmpresetrecipe_opts: Any
) -> Ref | None: ...
def applyParmPresetRecipe(
    name: str, parm: hou.Parm | hou.ParmTuple | None = ..., **parmpresetrecipe_set_opts: Any
) -> rtypes.ParmPresetOutputData | None: ...
def saveNodePresetRecipe(
    name: str, label: str, location: str, node: hou.OpNode, **nodepresetrecipe_opts: Any
) -> Ref | None: ...
def applyNodePresetRecipe(
    name: str, node: hou.OpNode, **nodepresetrecipe_set_opts: Any
) -> rtypes.NodePresetOutputData | tuple[str, str] | None: ...
def saveDecorationRecipe(
    name: str,
    label: str,
    location: str,
    central_node: hou.OpNode,
    decorator_items: Sequence[hou.NetworkMovableItem],
    **decoratorrecipe_opts: Any,
) -> Ref | None: ...
def applyDecorationRecipe(
    name: str, central_node: hou.OpNode | None = ..., **decoratorrecipe_set_opts: Any
) -> rtypes.DecorationOutputData | None: ...
def saveToolRecipe(name: str, label: str, location: str, anchor_node: hou.OpNode, **toolrecipe_opts: Any) -> Ref | None: ...
def applyToolRecipe(name: str, **toolrecipe_set_opts: Any) -> rtypes.ToolOutputData | None: ...
def saveTabToolRecipe(name: str, label: str, location: str, anchor_node: hou.OpNode, **toolrecipe_opts: Any) -> Ref | None: ...
def applyTabToolRecipe(name: str, **toolrecipe_set_opts: Any) -> rtypes.ToolOutputData | None: ...

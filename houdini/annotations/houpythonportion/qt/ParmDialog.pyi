from typing import SupportsInt

from PySide6 import QtWidgets

import hou

class _ParmDialogWidget(QtWidgets.QWidget):
    """The QWidget that ParmDialog() returns, with ParmDialog's methods bound onto it."""
    # The SWIG void* of the C++ dialog.
    ptr: SupportsInt
    def setNode(self, node: hou.OpNode | None) -> None: ...
    def node(self) -> hou.OpNode | None: ...
    def _getValueNames(self) -> tuple[str, ...]: ...
    def _getValue(self, name: str) -> str: ...
    def _setValue(self, name: str, value: str) -> bool: ...
    def _pressButton(self, name: str) -> bool: ...
    def setScrollPosition(self, pos: hou.Vector2) -> None: ...
    def scrollPosition(self) -> hou.Vector2: ...
    def _scrollToParms(self, parms: str) -> None: ...
    def _filterParms(self, parms: str) -> None: ...
    def _filterParmFolders(self, parms: str) -> None: ...
    def setMultiParmTab(self, parm: str, index: int) -> None: ...
    def multiParmTab(self, parm: str) -> int: ...
    def visibleParms(self) -> tuple[hou.ParmTuple, ...]: ...

class ParmDialog:
    @staticmethod
    def __new__(
        cls,
        the_node: hou.OpNode | None,
        showTitleBar: bool = ...,
        compact: bool = ...,
        labelsize: float = ...,
    ) -> _ParmDialogWidget: ...
    @staticmethod
    def setNode(self: _ParmDialogWidget, node: hou.OpNode | None) -> None: ...
    @staticmethod
    def node(self: _ParmDialogWidget) -> hou.OpNode | None: ...
    @staticmethod
    def setScrollPosition(self: _ParmDialogWidget, pos: hou.Vector2) -> None: ...
    @staticmethod
    def scrollPosition(self: _ParmDialogWidget) -> hou.Vector2: ...
    @staticmethod
    def setMultiParmTab(self: _ParmDialogWidget, parm: str, index: int) -> None: ...
    @staticmethod
    def multiParmTab(self: _ParmDialogWidget, parm: str) -> int: ...
    @staticmethod
    def visibleParms(self: _ParmDialogWidget) -> tuple[hou.ParmTuple, ...]: ...

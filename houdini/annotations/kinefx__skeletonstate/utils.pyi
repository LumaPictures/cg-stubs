) -> None: ...
def mirrorAndDuplicateSelection(self: SkeletonState) -> None: ...
def getPointName(pt: hou.Point | None) -> str: ...
def setPointName(pt: hou.Point | None, name: str) -> None: ...
def updatePointColor(geo: hou.Geometry, pts: Iterable[hou.Point], cd: Iterable[float]) -> None: ...

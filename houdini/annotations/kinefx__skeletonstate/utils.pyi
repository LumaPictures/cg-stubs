from collections.abc import Iterable, Sequence

import hou
from kinefx import rigapi
from kinefx__skeletonstate.state import SkeletonState

compute_local: hou.SopVerb
compute_world: hou.SopVerb

def addPoint(
    geo: hou.Geometry,
    parent: hou.Point | None = ...,
    position: hou._FloatSequence | None = ...,
    Cd: Sequence[float] = ...,
    scale_inheritance: int = ...,
) -> hou.Point: ...

# The functions taking self are SkeletonState's methods of the same names, from an older version
# of the state (the module is unused): some of what they use is gone from it.
def splitLinks(self: SkeletonState) -> list[hou.Point]: ...
def splitLink(self: SkeletonState, edge: hou.Edge | None = ...) -> hou.Point: ...
def duplicatePoints(geo: hou.Geometry, pts: Sequence[hou.Point]) -> tuple[hou.Point, ...]: ...
def edgePointsHierarchical(edge: hou.Edge) -> tuple[hou.Point, hou.Point]: ...
def createUniqueParent(self: SkeletonState, geo: hou.Geometry, edge: hou.Edge) -> hou.Point | None: ...
def unparentSelection(self: SkeletonState) -> None: ...
def removeSelectedJoints(self: SkeletonState, reparent: bool = ...) -> None: ...
def copyGeo(geo: hou.Geometry, selection: hou.Selection, dst_geo: hou.Geometry) -> None: ...
def pasteGeo(self: SkeletonState) -> None: ...
def orientPoint(
    pt: hou.Point,
    primaryaxis: hou.Vector3 = ...,
    secondaryaxis: hou.Vector3 = ...,
    child: hou.Point | None = ...,
    refsecondary: hou.Vector3 | None = ...,
    up: hou.Vector3 | None = ...,
) -> None: ...
def orientJoints(self: SkeletonState) -> None: ...
def orientPoints(self: SkeletonState, pts: Sequence[hou.Point] = ...) -> None: ...

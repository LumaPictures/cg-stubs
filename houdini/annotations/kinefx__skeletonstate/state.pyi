# What consumeSelection() is passed: by the mouse event (the visualisers' selection, the event and
# the snapping result), the drawable selector (a located selection), the rig tree's "select"
# command and setCurPoints().
class _ConsumeSelectionArgs(TypedDict, total=False):
    selection: Required[ReadOnly[hou.Selection | None]]
    node: ReadOnly[hou.SopNode | None]
    visualiser: ReadOnly[KinefxRigVisualiser | None]
    ui_event: ReadOnly[hou.ViewerEvent]
    # (is_snapped, snapped_pos) of doInteriorSnapping().
    snapping: ReadOnly[tuple[bool, hou.Vector3]]
    cmd: ReadOnly[str]
    pick_mod: ReadOnly[hou.EnumValue[hou.pickModifier]]
    joint_selection: ReadOnly[hou.Selection]
    link_selection: ReadOnly[hou.Selection]

# onCommand() is also called by the state itself: from onMenuAction(), with the menu action's
# kwargs as the command args, and from the rig tree's actions, with neither state_parms nor the
# other keys Houdini passes.
class _CommandKwargs(TypedDict, total=False):
    command: Required[str]
    command_args: Required[Any]
    state_parms: ReadOnly[dict[str, ViewerParmProperties]]

# The rig tree's "rename" command args: point numbers to rename, and the names.
class _RenameJointsArgs(TypedDict, total=False):
    selection: Sequence[int]
    new_name: Required[str]
    old_name: Required[str]

def dbg_print(s: object) -> None: ...

MODE_CREATE_PROMPT: str
MODE_MODIFY_PROMPT: str

class StateCommand:
    # The callback is a function, or a method of a class (bound or not): an unbound one's self
    # comes from setSelf().  execute() passes it the args named as its parameters.
    def __init__(self, name: str, label: str, callback: Callable[..., object]) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def label(self) -> str: ...
    def setSelf(self, obj: object) -> None: ...
    def execute(self, args: Mapping[str, object]) -> None: ...

class CommandList:
    def append(self, cmd: StateCommand) -> None: ...
    def find(self, command_name: str) -> StateCommand | None: ...
    def setSelf(self, obj: object) -> None: ...

# SkeletonState.DragData, a namedtuple class attribute.
class _DragData(NamedTuple):
    start_dirtoparent: hou.Vector3 | None
    start_dirtochild: hou.Vector3 | None
    start_xform: hou.Matrix4
    start_parentxform: hou.Matrix4
    start_pos: hou.Vector3
    start_intersectpos: hou.Vector3


import subprocess
import threading
from collections.abc import Iterator, Mapping, MutableMapping, Sequence
from collections.abc import Set as AbstractSet
from typing import TextIO, TypedDict

import _pdg
from pdg.job.callbackserver import CallbackServerAPI
from pdg.job.eventdispatch import _Event
from pdg.utils.mq import MQInfo
from pdgutils import PDGNetMQRelay

# The extra process options that onSchedule() passes to start_async().
class _ProcessOptions(TypedDict, total=False):
    requireswindow: bool
    shell: bool
    cwd: str

class RunItem:
    eExitCodeError: int
    eExitCodeWarn: int
    eExitCodeRetry: int
    eExitCodeIgnore: int
    eTimeoutFail: int
    eTimeoutSuccess: int
    @staticmethod
    def spawn(
        work_item: _pdg.WorkItem | None,
        item_command: str,
        item_log_path: str,
        single: bool,
        cpu_slots: float,
        job_env: Mapping[str, str],
        extra: _ProcessOptions,
    ) -> "RunItem | None": ...
    work_item: _pdg.WorkItem | None
    id: int | None
    process: subprocess.Popen[bytes] | None
    output_file: TextIO
    single: bool
    # A float when onSchedule() caps it at LocalScheduler.max_cpu_slots.
    cpu_slots: float
    released_cpu_slots: float
    exit_code_handling: int
    exit_code_custom: int
    retries_remaining: int
    retry_attr: str
    item_command: str
    job_env: Mapping[str, str]
    extra: _ProcessOptions
    start_time: float
    max_time: float
    on_timeout: int
    max_memory: float
    max_memory_mb: float
    on_memory_exceeded: int
    def __init__(
        self,
        work_item: _pdg.WorkItem | None,
        process: subprocess.Popen[bytes] | None,
        output_file: TextIO,
        single: bool,
        cpu_slots: float,
    ) -> None: ...
    def checkExitCode(self, ec: int) -> int | None: ...
    def writeToLog(self, msg: str, flush: bool = ...) -> None: ...
    def restart(self, ec: int) -> subprocess.Popen[bytes] | None: ...

class RunList:
    def __iter__(self) -> Iterator[RunItem]: ...
    def add(self, runitem: RunItem) -> None: ...
    def remove(self, runitem: RunItem) -> None: ...
    def find(self, workitem_id: int) -> RunItem | None: ...
    def acquireSlots(self, workitem_id: int) -> None: ...
    def releaseSlots(self, workitem_id: int) -> None: ...
    def slotsUsed(self) -> float: ...

class LocalScheduler:
    schedule_lock: threading.RLock
    run_list: RunList
    # onStartCook() sets maxThreads() / 4 in the default slots mode, a float.
    max_cpu_slots: float
    file_env: dict[str, str]
    # Service name -> client pid -> the client's process.
    running_services: dict[str, dict[int, RunItem]]
    mqinfo: MQInfo
    mqrelay: PDGNetMQRelay[CallbackServerAPI] | None
    def __init__(self, scheduler: _pdg.Scheduler, name: str) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onStart(self) -> bool: ...
    def onStop(self) -> bool: ...
    def startService(self, service: _pdg.Service) -> bool: ...
    def stopService(self, service: _pdg.Service, cancel: bool) -> bool: ...
    def startServiceClient(
        self, service: _pdg.Service, client: _pdg.ServiceClientInfo
    ) -> bool: ...
    def stopServiceClient(
        self, service: _pdg.Service, client: _pdg.ServiceClientInfo
    ) -> bool: ...
    def execEvent(self, event: _Event) -> str | None: ...
    def onStartCook(self, static: bool, cook_set: AbstractSet[_pdg.Node]) -> bool: ...
    def onStopCook(self, cancel: bool) -> bool: ...
    def submitAsJob(self, graph_file: str, node_path: str) -> tuple[None, None]: ...
    def onTick(self) -> _pdg.tickResult: ...
    def workItemSucceeded(
        self, workitem_id: int, index: int, cook_duration: float, jobid: str = ...
    ) -> None: ...
    def onSharedServerStarted(self, args: _pdg._SharedServerInfo) -> None: ...
    def endSharedServer(self, sharedserver_name: str, kill: bool = ...) -> bool: ...
    def applicationBin(self, name: str, work_item: _pdg.WorkItem | None) -> str: ...
    # static_isWorkItemReady() answers with a bool, the C++ scheduler with the enum.
    def isWorkItemReady(
        self, workitem_id: int, index: int
    ) -> bool | _pdg.workItemReadyResult: ...
    def releaseJobSlots(self, workitem_id: int, jobid: str = ...) -> None: ...
    def acquireJobSlots(self, workitem_id: int, jobid: str = ...) -> None: ...
    def onScheduleStatic(
        self,
        dependencies: Mapping[_pdg.WorkItem, Sequence[_pdg.WorkItem]],
        dependents: Mapping[_pdg.WorkItem, Sequence[_pdg.WorkItem]],
        ready_items: Sequence[_pdg.WorkItem],
    ) -> None: ...
    def onPreSubmitItem(
        self, work_item: _pdg.WorkItem, job_env: MutableMapping[str, str], item_command: str
    ) -> str: ...
    def onSchedule(self, work_item: _pdg.WorkItem) -> _pdg.scheduleResult: ...
    def onCancelWorkItems(
        self, work_items: Sequence[_pdg.WorkItem], node: _pdg.Node | None
    ) -> None: ...
    def getStatusURI(self, work_item: _pdg.WorkItem) -> str: ...
    def getLogURI(self, work_item: _pdg.WorkItem) -> str: ...

def start_async(
    item_command: str, output_file: TextIO, job_env: Mapping[str, str], extra: _ProcessOptions = ...
) -> subprocess.Popen[bytes] | None: ...

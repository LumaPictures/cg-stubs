import threading
import xmlrpc.client
from collections import deque
from collections.abc import Mapping, Sequence
from collections.abc import Set as AbstractSet
from typing import Any, NotRequired, TypedDict

import _pdg
import tractor.api.author as author
from pdg.job.eventdispatch import _Event
from pdg.job.mqrelay import MQRelay

# A Tractor query row of a task that the last cook of the job expanded, stashed for retrying.
class _TaskRow(TypedDict):
    title: str
    state: str
    tid: int
    # The name of the work item that the task was for.
    item_name: str
    # The task's service key, before neutralize_task() replaced it.
    service_key: NotRequired[str]

user_input_special_chars: dict[str, list[str]]

def displayError(msg: str, exception: BaseException | None = ...) -> None: ...

class RunItem:
    work_item: _pdg.WorkItem | None
    scheduled_stamp: float
    keepalive_stamp: float
    def __init__(self, work_item: _pdg.WorkItem | None, scheduled_stamp: float) -> None: ...
    def name(self) -> str | None: ...
    def hasStarted(self) -> bool: ...
    def setFailed(self, failed: bool) -> None: ...
    def elapsedTime(self, now: float) -> float: ...
    def isExpired(self, now: float) -> bool: ...

class TaskSpooler:
    def __init__(self, in_job: bool, scheduler: "TractorScheduler") -> None: ...
    # What the spooler returns: '1' from the MQ server, or whatever the in-job spooler (which
    # $PDG_TR_SPOOLER_DELEGATE can replace) does.
    def spool_task(
        self, task: author.Task, rpcserverproxy: xmlrpc.client.ServerProxy | None = ...
    ) -> Any: ...

class TractorScheduler:
    callbackLock: threading.Lock
    # None before the cook has a job, -1 when starting the MQ failed.
    rootjob_jid: int | None
    # This scheduler relays with the XML-RPC MQRelay, not MQSchedulerMixin's PDGNetMQRelay.
    mqrelay: MQRelay | None
    activeTaskTitles: set[str]
    # Task title -> retries remaining.
    retries: dict[str, int]
    runningItems: dict[str, RunItem]
    taskTitleByItemId: dict[int, str]
    # Work item hash -> the job's task for it to retry instead of spooling a new one.
    tasksToRetry: dict[int, _TaskRow]
    useKeepalive: int
    # (task title, work item id, task state).  tickKeepalive() queues the work item's name
    # instead of its id.
    stateChanges: deque[tuple[str, int | str | None, str]]
    mq_hostname: str | None
    mq_xmlport: int | None
    mq_relayport: int | None
    running_services: list[_pdg.Service]
    file_env: dict[str, str]
    def __init__(self, scheduler: _pdg.Scheduler, name: str) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onStop(self) -> bool: ...
    def execEvent(self, event: _Event) -> str | None: ...
    # None for an application other than python and hython.
    def applicationBin(self, name: str, work_item: _pdg.WorkItem | None) -> str | None: ...
    def createTaskSpooler(self, in_job: bool) -> TaskSpooler: ...
    def onStartCook(self, static: bool, cook_set: AbstractSet[_pdg.Node]) -> bool: ...
    # None when the service is already running, or is internal.
    def startService(self, service: _pdg.Service) -> bool | None: ...
    def stopService(self, service: _pdg.Service, cancel: bool) -> bool: ...
    def stopServiceClient(
        self, service: _pdg.Service, client: _pdg.ServiceClientInfo
    ) -> bool: ...
    def shouldRetryTask(self, task: _TaskRow) -> bool: ...
    def neutralize_task(self, task: _TaskRow) -> str: ...
    def workItemStartCook(self, workitem_id: int, index: int, jobid: str = ...) -> None: ...
    def workItemSucceeded(
        self, workitem_id: int, index: int, cook_duration: float, jobid: str = ...
    ) -> None: ...
    def workItemFailed(self, workitem_id: int, index: int, jobid: str = ...) -> None: ...
    def workItemKeepalive(self, workitem_id: int, jobid: str = ...) -> None: ...
    def onTick(self) -> _pdg.tickResult: ...
    def onStopCook(self, cancel: bool) -> bool: ...
    # (None, None) on failure, else (the job's status URI, its jid).
    def submitAsJob(
        self, graph_file: str, node_name: str
    ) -> tuple[None, None] | tuple[str, int]: ...
    def endSharedServer(self, sharedserver_name: str) -> bool: ...
    # The work item's environment variables are in `job_env` as ASCII bytes.
    def onPreSubmitItem(
        self,
        work_item: _pdg.WorkItem | None,
        job_env: Mapping[str | bytes, str | bytes],
        item_command: str,
    ) -> str: ...
    def onSchedule(self, work_item: _pdg.WorkItem) -> _pdg.scheduleResult: ...
    def onScheduleStatic(
        self,
        dependencies: Mapping[_pdg.WorkItem, Sequence[_pdg.WorkItem]],
        dependents: Mapping[_pdg.WorkItem, Sequence[_pdg.WorkItem]],
        ready_items: Sequence[_pdg.WorkItem],
    ) -> None: ...
    def onCancelWorkItems(
        self, work_items: Sequence[_pdg.WorkItem], node: _pdg.Node | None
    ) -> None: ...
    def expandCommandTokens(self, item_command: str, work_item: _pdg.WorkItem | None) -> str: ...
    def getLogURI(self, work_item: _pdg.WorkItem) -> str: ...
    def getStatusURI(self, work_item: _pdg.WorkItem) -> str: ...

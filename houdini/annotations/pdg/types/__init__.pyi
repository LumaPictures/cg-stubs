from collections.abc import Callable, Sequence
from importlib.machinery import ModuleSpec
from types import ModuleType, TracebackType
from typing import Any

import _pdg

# registerPythonModules() loads the modules on the PDG type search path ($HOUDINI_PATH/pdg/types,
# so `pdg.types.utils`, `pdg.types.houdini`, ... and a studio's own) and sets them on this package.
__getattr__: Callable[[str], Any]

class SearchPathManager:
    search_paths: list[str]
    def __init__(self, module: ModuleType | None = ...) -> None: ...
    def __enter__(self) -> list[str]: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        exc_traceback: TracebackType | None,
    ) -> None: ...

def reloadModulePy3(
    module: ModuleType, module_name: str, search_paths: Sequence[str]
) -> ModuleType: ...
def reloadPythonModule(module_name: str, reregister: bool) -> None: ...
def loadPythonModule(
    module_name: str, search_paths: Sequence[str]
) -> tuple[ModuleSpec, str | None, ModuleType]: ...
def registerPythonModules() -> None: ...
def registerPythonPath(path: str) -> None: ...
def savePyObjectAttr(mod_name: str, attr: object) -> str: ...
# Whatever the serialization module unpickles.
def loadPyObjectAttr(mod_name: str, attr_data: str | bytes) -> Any: ...
def cookWorkItem(mod_name: str, work_item: _pdg.WorkItem) -> None: ...

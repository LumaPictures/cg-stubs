import _pdg
from pdg import PyProcessor

class OpenImageIO(PyProcessor):
    def __init__(self, node: _pdg.Node) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def buildCommand(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildBinaryPath(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildCustomArgs(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildInputs(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildColorConvertOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildColorMapOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildResizeOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildTextOptions(self, item: _pdg.WorkItem, build_text_shapes_i: int) -> list[str]: ...
    def buildBoxOptions(self, item: _pdg.WorkItem, build_text_shapes_i: int) -> list[str]: ...
    def buildLineOptions(self, item: _pdg.WorkItem, build_text_shapes_i: int) -> list[str]: ...
    def buildMosaicOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildPointOptions(self, item: _pdg.WorkItem, build_text_shapes_i: int) -> list[str]: ...
    def buildTextAndShapesOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildColorTransformOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildCustomOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildSubimages(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildExtraArgs(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildOutput(self, item: _pdg.WorkItem) -> list[str]: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(
        self,
        item_holder: _pdg.WorkItemHolder,
        upstream_items: _pdg.WorkItemList,
        generation_type: _pdg.generationType,
    ) -> _pdg.result: ...
    def onPrepareTask(self, work_item: _pdg.WorkItem) -> None: ...

def registerTypes(type_registry: _pdg.TypeRegistry) -> None: ...

import _pdg
from pdg.processor import PyProcessor

class ImageMagick(PyProcessor):
    def __init__(self, node: _pdg.Node) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def buildArguments(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildMontageCommand(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildConvertCommand(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildCompositeCommand(self, item: _pdg.WorkItem) -> list[str]: ...
    def buildOptions(self, item: _pdg.WorkItem) -> list[str]: ...
    # position is one of the ARG_POSITION_* constants.
    def buildExtraArgs(self, item: _pdg.WorkItem, position: int) -> list[str]: ...
    def buildInputs(self, item: _pdg.WorkItem) -> list[str]: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(
        self,
        item_holder: _pdg.WorkItemHolder,
        upstream_items: _pdg.WorkItemList,
        generation_type: _pdg.generationType,
    ) -> _pdg.result: ...
    def onPrepareTask(self, work_item: _pdg.WorkItem) -> None: ...

def registerTypes(type_registry: _pdg.TypeRegistry) -> None: ...

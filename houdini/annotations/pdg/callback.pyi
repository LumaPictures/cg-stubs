from typing import Any, NoReturn, TypeVar

import _pdg

_T = TypeVar("_T")

class PythonCallback:
    def __init__(self, cpp_object: object) -> None: ...
    # The wrapped object decides what indexing returns: a Port for nodes and
    # schedulers, an attribute for work items (whose overlays narrow it).
    def __getitem__(self, key: str) -> _pdg.Port | _pdg._Attribute: ...
    def __setitem__(self, key: str, value: object) -> None: ...
    # Wrapped C++ objects are not iterable: their __iter__ raises.
    def __iter__(self) -> NoReturn: ...
    def __rshift__(self, value: _T) -> _T: ...
    def __dir__(self) -> list[str]: ...
    def __getattr__(self, attr_name: str) -> Any: ...
    def __setattr__(self, attr_name: str, attr_val: object) -> None: ...

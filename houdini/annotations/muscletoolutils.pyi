@type_check_only
class _StrokeDataKwargs(TypedDict, total=False):
    pos: hou.Vector3
    dir: hou.Vector3
    proj_pos: hou.Vector3
    proj_uv: hou.Vector3
    proj_prim: int
    proj_success: bool
    pressure: float
    time: float
    tilt: float
    angle: float
    roll: float

class StrokeData:
    VERSION: int
    pos: hou.Vector3
    dir: hou.Vector3
    proj_pos: hou.Vector3
    proj_uv: hou.Vector3
    proj_prim: int
    proj_success: bool
    pressure: float
    time: float
    tilt: float
    angle: float
    roll: float
    def __init__(self, **kwargs: Unpack[_StrokeDataKwargs]) -> None: ...
    @staticmethod
    def create() -> "StrokeData": ...
    def encode(self) -> su.ByteStream: ...
    def decode(self, stream: object) -> None: ...

class StrokeMetaData:
    name: str | None

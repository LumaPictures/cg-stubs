from collections.abc import Collection, Mapping

from PySide6 import QtWidgets

from .nodevisualizer import NodeVisualizer
from .taskgraphtable import TaskGraphTable

ICON_SIZE: int
SHOW_SELECTED_NODES: int
SHOW_CUSTOM_NODES: int

class NodeDialog(QtWidgets.QDialog):
    task_graph_table: TaskGraphTable
    check_boxes: dict[str, QtWidgets.QCheckBox]
    labels: dict[str, QtWidgets.QLabel]
    item_widgets: dict[str, QtWidgets.QWidget]
    selected_nodes: set[str]
    disable_update: bool
    is_local: bool
    def __init__(self, task_graph_table: TaskGraphTable) -> None: ...
    def setShowSelectedNodes(self, state: bool) -> None: ...
    def setShowCustomNodes(self, state: bool) -> None: ...
    def updateNodes(self, node_visualizers: Mapping[str, NodeVisualizer]) -> None: ...
    def nodeUpdated(self, node_path: str, visualizer: NodeVisualizer) -> None: ...
    def nodeSelectionChanged(self, state: bool) -> None: ...
    def selectAll(self) -> None: ...
    def selectNone(self) -> None: ...
    def applyFilter(self, filter: str) -> None: ...
    def isNodeSelected(self, node_path: str) -> bool: ...
    def selectedNodes(self) -> list[str] | None: ...
    def setSelectedNodes(
        self, selected_nodes: Collection[str], force_update: bool = ...
    ) -> None: ...

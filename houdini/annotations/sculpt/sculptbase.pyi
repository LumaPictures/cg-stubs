from collections.abc import Callable
from typing import Protocol

import hou
from houtypes import ViewerStateDrawKwargs, ViewerStateEnterKwargs, ViewerStateEventKwargs, ViewerStateKwargs

class _BrushOp(Protocol):
    def start(self, edits: hou.Geometry, /) -> hou.Geometry: ...
    def update(
        self,
        update_geo: hou.Geometry,
        start_geo: hou.Geometry,
        stroke_geo: hou.Geometry,
        ignore_mask_attrib: bool,
        use_surface_distance: bool,
        active_mask: str,
        alpha_geo: hou.Geometry,
        /,
    ) -> tuple[hou.Geometry, hou.Geometry]: ...
    def applyMask(
        self,
        edits: hou.Geometry,
        prev_masked: hou.Geometry | None,
        use_mask_attrib: bool | int,
        connectivity_class: list[int],
        active_mask: str,
        /,
    ) -> hou.Geometry: ...
    def end(self, geo: hou.Geometry, /) -> hou.Geometry: ...

CURSOR_DRAG_FACTOR: float

class SculptBaseState:
    state_name: str
    scene_viewer: hou.SceneViewer
    node: hou.SopNode | None
    def __init__(self, state_name: str, scene_viewer: hou.SceneViewer) -> None: ...
    def isShotsculpt(self, node: hou.OpNode) -> bool: ...
    def isSculptNode(self, node: hou.OpNode) -> bool: ...
    def isSculptCore(self, node: hou.OpNode) -> bool: ...
    def getSculptCore(self) -> hou.SopNode | None: ...
    def registerBrushOp(self, name: str, label: str, op: Callable[[hou.SopNode | None, hou.SopNode], _BrushOp], home: str) -> None: ...
    def registerBrushOps(self) -> None: ...
    def doesBrushAffectMask(self, brushop: str | None) -> bool: ...
    def getOpLabel(self, name: str) -> str: ...
    def getClusteredInputGeo(self) -> hou.Geometry: ...
    def getClusteredOutputGeo(self) -> hou.Geometry: ...
    def setSymmetryData(self) -> None: ...
    def onEnter(self, kwargs: ViewerStateEnterKwargs) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def setStartGeo(self, geo: hou.Geometry) -> None: ...
    def getStartGeo(self) -> hou.Geometry: ...
    def resetStartGeo(self) -> None: ...
    def setEdits(self, geo: hou.Geometry) -> None: ...
    def getEdits(self) -> hou.Geometry | None: ...
    def startEdits(self) -> hou.Geometry: ...
    def getStamps(self) -> hou.Geometry | None: ...
    def storeCloneGeometry(self) -> None: ...
    def resizeCursor(self, dist: float) -> None: ...
    def adjustSF(self, dist_x: float, dist_y: float) -> None: ...
    def handleResize(self, ui_event: hou.ViewerEvent, started_resizing: bool) -> None: ...
    def handleAdjustSF(self, ui_event: hou.ViewerEvent, started_adjusting_sf: bool) -> None: ...
    def displayPaintMaskError(self, errmsg: str) -> None: ...
    def isActiveMaskValid(self) -> bool: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None: ...
    def handleMaskCommit(self) -> None: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onMouseDoubleClickEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...

def recipeStorage() -> PresetStore: ...
def initStorage() -> None: ...

class PresetStore:
    theStorage: PresetStore | None
    theLock: threading.Lock | None
    @staticmethod
    def instance() -> PresetStore: ...
    def __new__(cls, *args: object, **kwargs: object) -> PresetStore: ...
    def __del__(self) -> None: ...
    def __contains__(self, name: str) -> bool: ...
    def items(self) -> ItemsView[str, api.Ref]: ...
    def count(self) -> int: ...
    def configs(self) -> ConfigDict: ...
    def reloadConfig(self) -> None: ...
    def addRef(self, ref: api.Ref | None) -> bool | None: ...
    def addRefsForNodeTypes(self, nodetypes: Iterable[hou.OpNodeType]) -> None: ...
    def addRefsForInstalledNodeTypes(self, skip_existing: bool = ...) -> None: ...
    def addRefsFromLibraryPath(self, library_path: str, skip_defns: Sequence[hou.HDADefinition] | None = ...) -> None: ...
    def recipeNameExists(self, path: str, recipe_name: str) -> tuple[bool, bool, str | None]: ...
    def remove(self, ref: api.Ref | None) -> bool | None: ...
    def removeRef(self, ref: api.Ref | None) -> bool | None: ...
    def refs(self, recipe_categories: Sequence[rtypes.RecipeCategory] = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def refsWithPrefix(self, prefix: str, recipe_categories: Sequence[rtypes.RecipeCategory] = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[Literal[rtypes.RecipeCategory.parmPreset]]) -> api.ParmPresetRef | None: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[Literal[rtypes.RecipeCategory.nodePreset]]) -> api.NodePresetRef | None: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[Literal[rtypes.RecipeCategory.decoration]]) -> api.DecorationRef | None: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[Literal[rtypes.RecipeCategory.tool]]) -> api.ToolRef | None: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[Literal[rtypes.RecipeCategory.data]]) -> api.DataRef | None: ...
    @overload
    def refForName(self, name: str, recipe_categories: Sequence[rtypes.RecipeCategory | None] = ...) -> api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef | None: ...
    def refForName(self, name: str, recipe_categories: Sequence[rtypes.RecipeCategory | None] = ...) -> api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef | None: ...
    def refsForName(self, pattern: str | None = ..., recipe_categories: Sequence[rtypes.RecipeCategory] = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def refsForNode(self, node: hou.Node, recipe_categories: Sequence[rtypes.RecipeCategory] = ..., visible: bool = ..., valid: bool = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def refsForParm(self, parm: hou.ParmTuple, recipe_categories: Sequence[rtypes.RecipeCategory] = ..., visible: bool = ..., valid: bool = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def refsForDataCategory(self, data_category: str = ..., visible: bool = ..., valid: bool = ..., under_hfs: bool | None = ...) -> Iterator[api.DataRef]: ...
    def refsForProperties(self, recipe_categories: Sequence[rtypes.RecipeCategory] = ..., nodetype_category: str | None = ..., nodetype_name: str | None = ..., parmname: str | None = ..., parmtype_name: str | None = ..., nodetype_patterns: str | None = ..., parmtype_patterns: str | None = ..., parmname_patterns: str | None = ..., visible: bool = ..., valid: bool = ..., under_hfs: bool | None = ...) -> Iterator[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def orderedRefs(self) -> list[api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef]: ...
    def lastInvokedRecipe(self, node: hou.Node, submenu: str = ..., recipe_category: rtypes.RecipeCategory | None = ...) -> api.ParmPresetRef | api.NodePresetRef | api.DecorationRef | api.ToolRef | api.DataRef | None: ...
    @staticmethod
    def reloadLibraries() -> None: ...
    def names(self) -> KeysView[str]: ...
    def clear(self) -> None: ...
    def addChangeCallback(self, fn: Callable[[], object]) -> None: ...
    def fireChangedCallbacks(self) -> None: ...
    def rescan(self, reload_hdas: bool = ..., clean: bool = ...) -> None: ...
    def setPermanentDefaultsFromConfig(self) -> None: ...
    def setPermanentDefault(self, recipe_name: str, node_type: hou.OpNodeType) -> None: ...
    def removePermanentDefault(self, node_type: hou.OpNodeType) -> None: ...
    def saveToHDA(self, name: str, label: str, location: str, recipe_data: Mapping[str, object], prescript: str | None = ..., postscript: str | None = ..., oncreatedscript: str | None = ..., needs_dop_license: bool = ..., expand_to_dir: bool = ..., node: hou.Node | None = ..., parm: hou.ParmTuple | None = ...) -> api.Ref | None: ...
    @staticmethod
    def locationExists(location: str) -> bool: ...
    @staticmethod
    def hdaDefinitionExists(library_path: str, asset_name: str) -> bool: ...
    @staticmethod
    def hdaSectionExists(library_path: str, asset_name: str, section_name: str) -> bool: ...
    def setClipboardIndex(self, index: int | None) -> None: ...
    def getClipboardIndex(self) -> int | None: ...
    def asdict(self) -> dict[str, _RecipeMetadata]: ...

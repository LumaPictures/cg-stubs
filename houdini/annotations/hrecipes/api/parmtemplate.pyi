from collections.abc import Callable
from typing import Any

import hou

from .. import rtypes
from . import datahandler

menu_types: dict[hou.EnumValue[hou.menuType], str]
script_language_name: dict[hou.EnumValue[hou.scriptLanguage], str]

# A key's callbacks take the parm template subclass that has the key (pt.minValue() is a
# FloatParmTemplate's or IntParmTemplate's), so they are typed for any parm template.
class ParmTemplateBase(datahandler.DataHandler[hou.ParmTemplate, rtypes.ParmTemplateData]):
    is_at_default_chooser: dict[str, Callable[[Any, Any, dict[str, Any]], object]]
    getter_method_chooser: dict[str, Callable[[Any, dict[str, Any]], Any]]
    setter_method_chooser: dict[str, Callable[[Any, Any, dict[str, Any]], object]]
    enable_chooser: dict[str, Callable[[dict[str, Any]], object]]
    def __init__(self) -> None: ...
    def initCommonKeys(self, use_num_components: bool = ...) -> None: ...
    def initDefaultKeys(self) -> None: ...
    def initRangeKeys(self) -> None: ...
    def initMenuKeys(self, use_tokens: bool = ...) -> None: ...
    def initRampKeys(self) -> None: ...
    def initFolderKeys(self) -> None: ...
    def initMultiParmKeys(self) -> None: ...
    def initFolderSetKeys(self) -> None: ...
    def initLabelKeys(self) -> None: ...
    def dataForTemplate(self, parmtemplate: hou.ParmTemplate, **opts: Any) -> rtypes.ParmTemplateData: ...

class RampParmTemplate(ParmTemplateBase):
    def dataForTemplate(self, parmtemplate: hou.ParmTemplate, **opts: Any) -> rtypes.ParmTemplateData: ...

def parmTemplateAsData(parmtemplate: hou.ParmTemplate, ordering_index: int = ..., **opts: Any) -> rtypes.ParmTemplateData: ...
def dataForInstanceParmTemplates(parmtemplate: hou.ParmTemplate, **opts: Any) -> rtypes.ParmTemplateDataDict | None: ...
def parmAsData(parm: hou.Parm | hou.ParmTuple, **opts: Any) -> rtypes.ParmTemplateData: ...
def setParmTemplateFromData(parmtemplate: hou.ParmTemplate, data: rtypes.ParmTemplateData) -> None: ...
def parmTemplateFromData(data: rtypes.ParmTemplateData, name: str = ...) -> hou.ParmTemplate: ...

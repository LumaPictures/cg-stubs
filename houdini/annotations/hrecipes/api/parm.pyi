_MappingT = TypeVar("_MappingT", bound=MutableMapping[str, Any])

def replaceRelativeReferences(data: _MappingT, old: str, new: str) -> _MappingT: ...
@overload
def parmsInOrder(node: hou.OpNode, startname: str = ..., inclusive: bool = ..., exclude_multiparm_instances: bool = ..., parmtype_filters: Collection[str] | None = ..., as_tuples: Literal[True] = ...) -> list[hou.ParmTuple]: ...
@overload
def parmsInOrder(node: hou.OpNode, startname: str = ..., inclusive: bool = ..., exclude_multiparm_instances: bool = ..., parmtype_filters: Collection[str] | None = ..., *, as_tuples: Literal[False]) -> list[hou.Parm]: ...
@overload
def parmsInOrder(node: hou.OpNode, startname: str = ..., inclusive: bool = ..., exclude_multiparm_instances: bool = ..., parmtype_filters: Collection[str] | None = ..., as_tuples: bool = ...) -> list[hou.Parm] | list[hou.ParmTuple]: ...
def parmsInOrder(node: hou.OpNode, startname: str = ..., inclusive: bool = ..., exclude_multiparm_instances: bool = ..., parmtype_filters: Collection[str] | None = ..., as_tuples: bool = ...) -> list[hou.Parm] | list[hou.ParmTuple]: ...

class ParmBase(datahandler.DataHandler[hou.ParmTuple, rtypes.ParmData]):
    is_at_default_chooser: dict[str, Callable[[hou.ParmTuple, Any, dict[str, Any]], object]]
    getter_method_chooser: dict[str, Callable[[hou.ParmTuple, dict[str, Any]], Any]]
    setter_method_chooser: dict[str, Callable[[hou.ParmTuple, Any, dict[str, Any]], object]]
    def __init__(self) -> None: ...

class ParmGeneric(ParmBase):
    def __init__(self) -> None: ...
    def parmAsData(self, parmtuple: hou.ParmTuple, **opts: Any) -> rtypes.ParmUnionData: ...
    def setFromData(self, parmtuple: hou.ParmTuple, data: rtypes.ParmData, **opts: Any) -> None: ...

class ParmMultiParm(ParmBase):
    def __init__(self) -> None: ...
    def parmAsData(self, parmtuple: hou.ParmTuple, **opts: Any) -> rtypes.ParmUnionData: ...
    def setFromData(self, parmtuple: hou.ParmTuple, data: rtypes.ParmData, **opts: Any) -> None: ...

class ParmRamp(ParmBase):
    def __init__(self) -> None: ...
    def parmAsData(self, parmtuple: hou.ParmTuple, **opts: Any) -> rtypes.ParmUnionData: ...
    def setFromData(self, parmtuple: hou.ParmTuple, data: rtypes.ParmData, **opts: Any) -> None: ...

class ParmNoneValue(ParmBase):
    def parmAsData(self, parmtuple: hou.ParmTuple, **opts: Any) -> rtypes.ParmData: ...
    def setFromData(self, parmtuple: hou.ParmTuple, data: rtypes.ParmData, **opts: Any) -> None: ...

class ParmTypeEnum(Enum):
    Generic = 'generic'
    MultiParm = 'multiparm'
    Ramp = 'ramp'
    NoneValue = 'none-value'


from collections.abc import Collection, Generator

import hou

def iterWithParent(
    group_or_folder: hou.ParmTemplateGroup | hou.FolderParmTemplate,
    iterate_folders: bool = ...,
    iterate_multiparms: bool = ...,
    parent_template: hou.ParmTemplate | None = ...,
) -> Generator[tuple[hou.ParmTemplate, hou.ParmTemplate | None], None, None]: ...

class ParmLeaf:
    tree_parms: dict[str, ParmLeaf]
    name: str
    parmtype: str | None
    parmtemplate: hou.ParmTemplate | None
    parent_name: str | None
    template_children: list[str]
    expanded_instances: list[str]
    multiparm_index: int
    path_indices: list[int]
    checked: bool
    tree: ParmTree | None
    def __init__(
        self,
        tree_parms: dict[str, ParmLeaf],
        parmtemplate: hou.ParmTemplate | None = ...,
        name: str = ...,
        parmtype: str | None = ...,
        tree: ParmTree | None = ...,
    ) -> None: ...
    def templateChildIndex(self, name: str) -> int: ...
    def appendTemplateChild(self, name: str) -> None: ...
    def clearTemplateChildren(self) -> None: ...
    def appendExpandedInstance(self, instance: str) -> None: ...
    def disconnect(self) -> None: ...
    def childCount(self) -> int: ...
    def childAt(self, index: int = ...) -> ParmLeaf: ...
    def hasChildren(self) -> bool: ...
    def parent(self) -> ParmLeaf | None: ...
    def indexOfChild(self, name: str) -> int: ...
    def row(self) -> int: ...
    def setChecked(self, checked: bool) -> None: ...
    def hasCheckedChild(self) -> bool: ...
    def hasCheckedChildren(self) -> bool: ...
    def filterName(self) -> str: ...
    def label(self) -> str: ...
    def interfaceType(self) -> str | None: ...
    def initPathIndiciesFromParent(self) -> None: ...
    @property
    def depth(self) -> int: ...
    def __str__(self) -> str: ...

class ParmTree:
    node: hou.OpNode | None
    parms: dict[str, ParmLeaf]
    def __init__(self) -> None: ...
    def buildTreeFromNode(
        self,
        node: hou.OpNode,
        expand_multiparms: bool = ...,
        parmtype_filters: Collection[str] | None = ...,
    ) -> None: ...
    def buildTreeFromMultiParm(self, parm: hou.Parm, expand_multiparms: bool = ...) -> None: ...
    def buildTreeFromMultiParmTemplate(self, parmtemplate: hou.FolderParmTemplate) -> None: ...
    def iterTemplateChildren(
        self,
        startname: str = ...,
        inclusive: bool = ...,
        exclude_multiparm_instances: bool = ...,
        parmtype_filters: Collection[str] | None = ...,
    ) -> Generator[ParmLeaf, None, None]: ...
    def iterParents(
        self, startname: str, parmtype_filters: Collection[str] | None = ...
    ) -> Generator[ParmLeaf, None, None]: ...
    def iterExpandedInstances(
        self,
        startname: str = ...,
        inclusive: bool = ...,
        parmtype_filters: Collection[str] | None = ...,
        exclude_multiparm_instances: bool = ...,
    ) -> Generator[ParmLeaf, None, None]: ...
    def iterAll(
        self,
        startname: str = ...,
        parmtype_filters: Collection[str] | None = ...,
        inclusive: bool = ...,
    ) -> Generator[ParmLeaf, None, None]: ...
    def printTree(self, startname: str = ..., brief: bool = ...) -> None: ...
    def __getitem__(self, key: str) -> ParmLeaf: ...
    def __setitem__(self, key: str, item: ParmLeaf) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> list[bool]: ...
    def __str__(self) -> str: ...

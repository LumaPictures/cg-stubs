from collections.abc import Mapping, Sequence
from typing import Any, TypeVar

import hou
from hrecipes import rtypes

_D = TypeVar("_D", bound=Mapping[str, Any])

def nested_set(dic: dict[str, Any], keys: Sequence[str], value: object) -> None: ...
def nameToLabel(name: str) -> str: ...
def reorderKeys(data: _D, ordered_names: list[str] = ..., names_to_end: Sequence[str] = ...) -> _D: ...
def updateParmTemplateOrder(
    data: Mapping[str, rtypes.ParmTemplateData], recursive: bool = ...
) -> rtypes.ParmTemplateDataDict: ...
def findParmTemplateInData(
    data: rtypes.ParmTemplateDataDict, name: str, type_filters: Sequence[str] | None = ...
) -> tuple[rtypes.ParmTemplateData | None, str]: ...
def popParmTemplateData(
    data: rtypes.ParmTemplateData | rtypes.ParmTemplateBundleData,
    name: str,
    type_filters: Sequence[str] | None = ...,
    update_ordering: bool = ...,
) -> rtypes.ParmTemplateData | None: ...
def insertParmTemplateData(
    data: Mapping[str, rtypes.ParmTemplateData],
    name: str,
    parm_template: rtypes.ParmTemplateData,
    at_index: int = ...,
    at_key: str = ...,
    before_key: bool = ...,
    update_ordering: bool = ...,
) -> rtypes.ParmTemplateDataDict: ...
def removeParmTemplateFromData(
    data: rtypes.ParmTemplateDataDict, name: str, type_filters: Sequence[str] | None = ...
) -> rtypes.ParmTemplateDataDict: ...
def parmTemplateNames(
    data: rtypes.ParmTemplateDataDict,
    ignore_folders: bool = ...,
    ignore_multiparm_instances: bool = ...,
    type_filters: Sequence[str] | None = ...,
) -> list[str]: ...
def reorderTemplateData(data: rtypes.ParmTemplateData) -> rtypes.ParmTemplateData: ...
def splitName(name: str) -> tuple[str, str]: ...
def addHashToName(name: str, count: int = ...) -> str: ...
def removeHashFromName(name: str, count: int = ...) -> str: ...
def isMultiparmInstance(name: str) -> bool: ...
def updateName(
    name: str, parent_name: str, parent_template: rtypes.ParmTemplateData | rtypes.ParmTemplateBundleData
) -> str: ...
def findParentTemplate(
    data: rtypes.ParmTemplateDataDict, folder_path: str = ...
) -> tuple[rtypes.ParmTemplateDataDict | rtypes.ParmTemplateData | None, str]: ...

class DataManager:
    def __init__(
        self, node: hou.OpNode | None = ..., container_folder_name: str = ..., default_folder_type: str = ...
    ) -> None: ...
    def data(self) -> ParmTemplateSnippetData: ...
    def setData(self, data: ParmTemplateSnippetData) -> None: ...
    def parms(self) -> rtypes.ParmDataDict: ...
    def setParms(self, data: rtypes.ParmDataDict) -> None: ...
    def clearData(self) -> None: ...
    def setDefaultFolderType(self, folder_type: str) -> None: ...
    def node(self) -> hou.OpNode | None: ...
    def parmTemplateBlock(self) -> rtypes.ParmTemplateBundleData: ...
    def parmTemplates(self) -> rtypes.ParmTemplateDataDict: ...
    def setParmTemplates(self, data: rtypes.ParmTemplateDataDict) -> None: ...
    def sourceScript(self) -> str | None: ...
    def setSourceScript(self, script: str = ...) -> None: ...
    def setContainerFolder(self, folder_name: str) -> None: ...
    def folderTemplateData(self, label: str, folder_type: str | None = ...) -> rtypes.ParmTemplateData: ...
    def ensureBaseKeys(self) -> None: ...
    def ensureContainer(self) -> None: ...
    def ensureFolderPath(
        self, data: rtypes.ParmTemplateDataDict, folder_path: str = ...
    ) -> rtypes.ParmTemplateDataDict | None: ...
    def parmTemplateNames(
        self,
        ignore_folders: bool = ...,
        ignore_multiparm_instances: bool = ...,
        type_filters: Sequence[str] | None = ...,
    ) -> list[str]: ...
    def reorderParmValues(self) -> None: ...
    def setParmValue(
        self,
        name: str,
        data: rtypes.ParmUnionData | rtypes.MultiParmInstanceDataList,
        update_ordering: bool = ...,
        multiparm_parent: str = ...,
    ) -> None: ...
    def removeParmValue(self, name: str, update_ordering: bool = ...) -> None: ...
    def removeParameters(self, parm_names: Sequence[str] = ...) -> None: ...
    def addParameter(
        self,
        name: str,
        parmtemplate_data: rtypes.ParmTemplateData | None,
        folder_path: str = ...,
        value: rtypes.ParmData | None = ...,
        at_index: int = ...,
        at_key: str = ...,
        before_key: bool = ...,
    ) -> None: ...
    def addFolder(
        self,
        name: str,
        label: str,
        folder_type: str | None = ...,
        folder_path: str = ...,
        value: rtypes.MultiParmInstanceDataList = ...,
        at_index: int = ...,
        at_key: str = ...,
        before_key: bool = ...,
        parm_names: Sequence[str] = ...,
        new_parm_templates: rtypes.ParmTemplateDataDict = ...,
        template_kwargs: rtypes.ParmTemplateData | None = ...,
    ) -> None: ...
    def updateFromInterface(self) -> bool | None: ...
    def __bool__(self) -> bool: ...

from collections.abc import Mapping, Sequence
from typing import ClassVar, Generic, Literal, NotRequired, TypedDict, Unpack, overload, type_check_only

import hou
from houtypes import JSONValue
from hrecipes import messages, rtypes
from hrecipes.api import recipeassetio, recipebinding, sessiontool
from hrecipes.api.recipeassetio import _RecipeMetadata
from typing_extensions import TypeVar

# The type of the recipe's 'data' (loadData()), by the recipe category of the Ref subclass.
_DataT_co = TypeVar("_DataT_co", covariant=True, default=rtypes._RecipeDataPayload)

_MetadataStrKey = Literal[
    "author", "comment", "data_category", "multiparm_operation", "submenu", "parmname", "icon",
    "shelf_tab", "help_url", "prompt_type", "name", "basename", "name_with_category", "title",
    "data_section_name", "pre-script_section_name", "post-script_section_name",
]
_MetadataOptionalStrKey = Literal[
    "created", "data_version", "houdini_version", "nodetype_category", "nodetype_name",
    "vop_containertype", "parmtype_name",
]
_MetadataStrListKey = Literal[
    "parmname_patterns", "parmtype_patterns", "nodetype_patterns", "tool_labels", "tab_submenus",
    "network_categories", "prompt_messages", "prompt_posparms",
]
_MetadataBoolKey = Literal["visible", "example", "dop_license_needed"]
_MetadataValue = (
    str | int | float | bool | rtypes.RecipeCategory | list[str] | list[rtypes.ToolType] | list[list[float]] | tuple[str, str, str, str]
)

_RecipeOutputData = (
    rtypes.ParmPresetOutputData | rtypes.NodePresetOutputData | rtypes.DecorationOutputData | rtypes.ToolOutputData
)

@type_check_only
class _OutputInfoData(rtypes.RecipeInfoData):
    file: str
    name: str
    label: str

@type_check_only
class _OutputOptionsData(rtypes._RecipeOptionsData):
    record_data: bool
    prescript: bool
    postscript: bool

# What outputDict() builds from the recipe's data section: 'info' and 'options' are always filled in.
@type_check_only
class _OutputDict(TypedDict):
    info: _OutputInfoData
    properties: NotRequired[rtypes.RecipePropertiesData]
    tool: NotRequired[rtypes.RecipeToolData]
    options: _OutputOptionsData

class Ref(Generic[_DataT_co]):
    recipetype: ClassVar[rtypes.RecipeCategory | None]
    @classmethod
    def createRef(
        cls,
        nodetype: hou.OpNodeType,
        definition: hou.HDADefinition | None = ...,
        recipe_data: Mapping[str, object] | None = ...,
        prescript: str | None = ...,
        postscript: str | None = ...,
    ) -> ParmPresetRef | NodePresetRef | DecorationRef | ToolRef | DataRef | None: ...
    def __init__(self, io: recipeassetio.AssetIO, metadata: _RecipeMetadata) -> None: ...
    def loadRecipeData(self) -> rtypes._RecipeFileData | None: ...
    def loadData(self) -> _DataT_co: ...
    def hasRecordedData(self) -> bool: ...
    def loadPreScript(self) -> str: ...
    def hasPreScript(self) -> bool: ...
    def loadPostScript(self) -> str: ...
    def hasPostScript(self) -> bool: ...
    def runScript(self, script: str | None = ..., node: hou.Node | None = ..., parm: hou.ParmTuple | None = ...) -> None: ...
    def loadOptions(self) -> rtypes._RecipeOptionsData: ...
    def nameComponents(self) -> tuple[str, str, str, str]: ...
    def setTitle(self, title: str, save_to_section: bool = ...) -> None: ...
    def toolTypes(self) -> Sequence[rtypes.ToolType]: ...
    def setVisible(self, visible: bool = ..., save_to_section: bool = ...) -> None: ...
    def setIcon(self, icon: str, save_to_section: bool = ...) -> None: ...
    @overload
    def tabSubmenus(self, join: Literal[False] = ...) -> list[str]: ...
    @overload
    def tabSubmenus(self, join: Literal[True]) -> str: ...
    @overload
    def tabSubmenus(self, join: bool) -> list[str] | str: ...
    def tabSubmenus(self, join: bool = ...) -> list[str] | str: ...
    @overload
    def pattern(self, pattern_type: rtypes.Patterns = ..., join: Literal[True] = ...) -> str: ...
    @overload
    def pattern(self, pattern_type: rtypes.Patterns, join: Literal[False]) -> list[str]: ...
    @overload
    def pattern(self, pattern_type: rtypes.Patterns = ..., *, join: Literal[False]) -> list[str]: ...
    @overload
    def pattern(self, pattern_type: rtypes.Patterns = ..., join: bool = ...) -> str | list[str]: ...
    def pattern(self, pattern_type: rtypes.Patterns = ..., join: bool = ...) -> str | list[str]: ...
    def setPattern(
        self, pattern: str, pattern_type: rtypes.Patterns = ..., save_to_section: bool = ...
    ) -> None: ...
    def setComment(self, comment: str, save_to_section: bool = ...) -> None: ...
    @overload
    def tagFromData(self, tag_name: str, join: Literal[True]) -> str: ...
    @overload
    def tagFromData(self, tag_name: str, join: bool = ...) -> str | list[str]: ...
    def tagFromData(self, tag_name: str, join: bool = ...) -> str | list[str]: ...
    def parmTypeName(self) -> str | None: ...
    def nodeTypeCategoryName(self) -> str | None: ...
    def vopContainerType(self) -> str | None: ...
    def nodeTypeName(self) -> str | None: ...
    def creationDate(self) -> str | None: ...
    def houdiniVersion(self) -> str | None: ...
    def submenu(self) -> str: ...
    def helpURL(self) -> str: ...
    def metadata(self) -> _RecipeMetadata: ...
    @overload
    def metadataValue(self, key: _MetadataStrKey) -> str: ...
    @overload
    def metadataValue(self, key: _MetadataOptionalStrKey) -> str | None: ...
    @overload
    def metadataValue(self, key: _MetadataStrListKey) -> list[str]: ...
    @overload
    def metadataValue(self, key: _MetadataBoolKey) -> bool: ...
    @overload
    def metadataValue(self, key: Literal["recipe_category"]) -> rtypes.RecipeCategory: ...
    @overload
    def metadataValue(self, key: Literal["data_process_order"]) -> float: ...
    @overload
    def metadataValue(self, key: Literal["shelf_ordering_index"]) -> int: ...
    @overload
    def metadataValue(self, key: Literal["tool_types"]) -> list[rtypes.ToolType]: ...
    @overload
    def metadataValue(self, key: Literal["prompt_bboxes"]) -> list[list[float]]: ...
    @overload
    def metadataValue(self, key: Literal["name_components"]) -> tuple[str, str, str, str]: ...
    @overload
    def metadataValue(self, key: str) -> _MetadataValue | None: ...
    def metadataValue(self, key: str) -> _MetadataValue | None: ...
    def outputDict(self) -> _OutputDict: ...
    def usedDefinition(self) -> hou.HDADefinition: ...
    def matchNode(self, node: hou.Node) -> bool | None: ...
    def matchNodeType(self, node_type: hou.NodeType) -> bool | None: ...
    def matchParm(self, parm: hou.ParmTuple) -> bool: ...
    def createTools(self, tool_type: rtypes.ToolType | None = ...) -> None: ...
    def removeTools(self, tool_type: rtypes.ToolType | None = ...) -> None: ...
    def toolTitle(self, tool_type: rtypes.ToolType | None = ...) -> str | None: ...
    def hasExample(self) -> bool: ...
    def deleteDefinition(self) -> None: ...
    def asdict(self) -> _RecipeMetadata: ...
    def isDOPLicenseNeeded(self) -> bool: ...
    def missingNodeTypes(self) -> dict[str, dict[str, list[str]]] | None: ...
    def updateRuntimeMessages(self, missing_nodetype_validation: bool = ...) -> None: ...
    def messageStore(self) -> messages.MessageStore: ...
    def applyRecipe(self) -> _RecipeOutputData | None: ...
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def editRecipe(
        self,
    ) -> rtypes.ParmPresetEditData | rtypes.NodePresetEditData | rtypes.DecorationEditData | rtypes.ToolEditData | None: ...
    def instanceInsideNode(self, parent: hou.OpNode) -> hou.ParmTuple | hou.OpNode | rtypes.ClusterOutputData | None: ...
    def parmDataDictForUI(
        self, preset_node: hou.Node | None = ..., preset_parm: hou.ParmTuple | None = ...
    ) -> rtypes.ParmDataDict: ...
    def saveAsLastInvoked(self, node: hou.Node | None) -> None: ...
    def __bool__(self) -> bool: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

class PresetBaseRef(Ref[_DataT_co]):
    def __init__(self, io: recipeassetio.AssetIO, metadata: _RecipeMetadata) -> None: ...
    def removeTools(self, tool_type: rtypes.ToolType | None = ...) -> None: ...
    def removeTool(self, node_type: hou.NodeType) -> None: ...
    def hasPermanentDefault(self, node_type: hou.NodeType) -> bool: ...
    def setPermanentDefault(self, node_type: hou.OpNodeType) -> None: ...
    def removePermanentDefault(self, node_type: hou.OpNodeType) -> None: ...
    def setVisible(self, visible: bool = ..., save_to_section: bool = ...) -> None: ...
    def hasTool(self) -> bool: ...

class ParmPresetRef(PresetBaseRef[rtypes.ParmUnionData]):
    recipetype: ClassVar[rtypes.RecipeCategory]
    def applyRecipe(self, parm: hou.ParmTuple | hou.Parm, **set_opts: Unpack[hou._ParmPresetRecipeSetOpts]) -> rtypes.ParmPresetOutputData | None: ...
    def instanceInsideNode(self, parent: hou.OpNode) -> hou.ParmTuple: ...
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def editRecipe(self) -> rtypes.ParmPresetEditData | None: ...

class NodePresetRef(PresetBaseRef[rtypes.NetworkItemData]):
    recipetype: ClassVar[rtypes.RecipeCategory]
    def __init__(self, io: recipeassetio.AssetIO, metadata: _RecipeMetadata) -> None: ...
    def applyRecipe(self, node: hou.OpNode | None = ..., **set_opts: Unpack[hou._NodePresetRecipeSetOpts]) -> rtypes.NodePresetOutputData | None: ...
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def instanceInsideNode(self, parent: hou.OpNode) -> hou.OpNode: ...
    def editRecipe(self) -> rtypes.NodePresetEditData | None: ...

class DecorationRef(Ref[rtypes.ClusterData]):
    recipetype: ClassVar[rtypes.RecipeCategory]
    def applyRecipe(self, central_node: hou.OpNode | None = ..., **set_opts: Unpack[recipebinding._ApplyDecorationRecipeKwargs]) -> rtypes.DecorationOutputData | None: ...
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def instanceInsideNode(self, parent: hou.OpNode) -> rtypes.ClusterOutputData: ...
    def editRecipe(self) -> rtypes.DecorationEditData | None: ...

class ToolRef(Ref[rtypes.ClusterData]):
    recipetype: ClassVar[rtypes.RecipeCategory]
    def __init__(self, io: recipeassetio.AssetIO, metadata: _RecipeMetadata) -> None: ...
    def applyRecipe(self, **set_opts: Unpack[recipebinding._ApplyToolRecipeKwargs]) -> rtypes.ToolOutputData | None: ...
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def instanceInsideNode(self, parent: hou.OpNode) -> rtypes.ClusterOutputData: ...
    def editRecipe(self) -> rtypes.ToolEditData | None: ...
    def setVisible(self, visible: bool = ..., save_to_section: bool = ...) -> None: ...
    def toolTitle(self, tool_type: rtypes.ToolType | None = ...) -> str: ...
    def setToolTitle(self, title: str, tool_type: rtypes.ToolType, save_to_section: bool = ...) -> None: ...
    def hasTool(self, tool_type: rtypes.ToolType) -> bool: ...
    def createTools(self, tool_type: rtypes.ToolType | None = ...) -> None: ...
    def removeTools(self, tool_type: rtypes.ToolType | None = ...) -> None: ...
    def hasExample(self) -> bool: ...
    def setToolVisible(self, tool_type: rtypes.ToolType, visible: bool = ...) -> None: ...
    def setExampleVisible(self, visible: bool = ..., save_to_section: bool = ...) -> None: ...

class DataRef(PresetBaseRef[JSONValue]):
    recipetype: ClassVar[rtypes.RecipeCategory]
    def applyToSubnet(self, subnet: hou.OpNode, update_interface: bool = ..., update_content: bool = ...) -> None: ...
    def nodeTypeCategoryName(self) -> str: ...

REF_TYPES: tuple[type[ParmPresetRef], type[NodePresetRef], type[DecorationRef], type[ToolRef], type[DataRef]]

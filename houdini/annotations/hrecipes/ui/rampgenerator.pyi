import hou
from collections.abc import Sequence
from typing import Self
import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

NUM_SAMPLES: int
VW_AREA_FLOOR: float
DEFAULT_NUM_POINTS: int
UNIFORM_MAX_SAMPLES: int
RAMP_STRIP_W: int
RAMP_STRIP_H: int

class _ScreenSampler:
    def __init__(self) -> None: ...
    def captureAllScreens(self) -> None: ...
    def sample(self, gx: int, gy: int) -> tuple[float, float, float] | None: ...

class RampGeneratorOverlay:
    def __init__(self, session: RampGeneratorSession, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def showOnScreen(self) -> None: ...
    def mousePressEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def keyPressEvent(self, event: PySide6.QtGui.QKeyEvent) -> None: ...
    def keyReleaseEvent(self, event: PySide6.QtGui.QKeyEvent) -> None: ...
    def paintEvent(self, event: PySide6.QtGui.QPaintEvent) -> None: ...
    def closeEvent(self, event: PySide6.QtGui.QCloseEvent) -> None: ...

class _RampStripWidget:
    def __init__(self, session: RampGeneratorSession, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def sizeHint(self) -> PySide6.QtCore.QSize: ...
    def paintEvent(self, event: PySide6.QtGui.QPaintEvent) -> None: ...

class RampGeneratorPanel:
    def __init__(self, session: RampGeneratorSession, parent: PySide6.QtWidgets.QWidget | None) -> None: ...
    def enableInteraction(self) -> None: ...
    def refresh(self) -> None: ...
    def keyPressEvent(self, event: PySide6.QtGui.QKeyEvent) -> None: ...
    def closeEvent(self, event: PySide6.QtGui.QCloseEvent) -> None: ...

class _Path:
    stroke: Sequence[PySide6.QtCore.QPoint]
    s_keys: list[float]
    s_values: list[tuple[float, float, float]]
    s_bases: list[hou.EnumValue[hou.rampBasis]]
    def __init__(self) -> None: ...
    @classmethod
    def fromStroke(cls, stroke: Sequence[PySide6.QtCore.QPoint], sampler: _ScreenSampler) -> Self: ...
    @classmethod
    def fromRamp(cls, ramp: hou.Ramp) -> Self: ...
    @property
    def is_valid(self) -> bool: ...
    @property
    def max_smart_points(self) -> int: ...
    def pointAtT(self, t: float) -> PySide6.QtCore.QPointF: ...
    def simplify(self, num_points: int) -> None: ...
    def resample(self, smart: bool, n: int) -> None: ...

class RampGeneratorSession:
    path: _Path | None
    def __init__(self, parm: hou.Parm) -> None: ...
    @property
    def s_keys(self) -> list[float]: ...
    @property
    def s_values(self) -> list[tuple[float, float, float]]: ...
    @property
    def s_bases(self) -> list[hou.EnumValue[hou.rampBasis]]: ...
    @property
    def max_smart_points(self) -> int: ...
    @property
    def smart_mode(self) -> bool: ...
    @property
    def slider_max(self) -> int: ...
    def start(self) -> None: ...
    def onPathFinalized(self, points: Sequence[PySide6.QtCore.QPoint]) -> None: ...
    def onPointCountChanged(self, n: int) -> None: ...
    def onModeChanged(self, smart: bool) -> None: ...
    def confirm(self) -> None: ...
    def cancel(self) -> None: ...
    def onOverlayClosed(self) -> None: ...
    def onPanelClosed(self) -> None: ...
    def close(self) -> None: ...

def showRampGenerator(parm: hou.Parm) -> None: ...

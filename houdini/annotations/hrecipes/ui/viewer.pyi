from collections.abc import Container
from typing import ClassVar, Generic, TypedDict, TypeVar, final

import PySide6.QtCore
import PySide6.QtWidgets

import hou
from hrecipes import api

_V = TypeVar("_V")

@final
class _MessageViewText(TypedDict):
    msg: str
    severity: hou.EnumValue[hou.severityType]

@final
class _MessageViewVisibility(TypedDict):
    visible: bool

WIDTH_NETFRAME: int
WIDTH_PARMFRAME: int
MAX_WIDTH: int
MAX_HEIGHT: int
CAPTURED_PARM: str

class RecipeDataViewer(JsonEditor):
    def __init__(self, title: str | None = ..., ref: api.Ref | None = ..., highlight_color: str | None = ..., highlight_text_color: str | None = ..., parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def deactivate(self, clear: bool = ...) -> None: ...
    def activate(self, ref: api.Ref | None) -> None: ...
    def title(self) -> str | None: ...
    def ref(self) -> api.Ref | None: ...
    def layoutWidget(self) -> PySide6.QtWidgets.QWidget: ...
    def updateContent(self, ref: api.Ref | None) -> None: ...
    def text(self, refresh: bool = ..., sort_keys: bool = ...) -> str: ...
    def refresh(self) -> None: ...
    def insertLine(self, line_number: int, text: str | None = ...) -> None: ...
    def moveToLine(self, line_number: int) -> None: ...
    def highlightLines(self, line_indices: Container[int]) -> None: ...

class RecipeContentViewer(PySide6.QtWidgets.QWidget):
    def __init__(self, title: str | None = ..., show_parm_view: bool = ..., parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def title(self) -> str | None: ...
    def onSplitterMoved(self, pos: int, index: int) -> None: ...
    def deactivate(self, clear: bool = ...) -> None: ...
    def activate(self, ref: api.Ref | None) -> None: ...

class RecipeInfoViewer(PySide6.QtWidgets.QFrame):
    TITLE: str
    PATTERN: str
    ICON: str
    VISIBLE: str
    COMMENTS: str
    CREATION: str
    AUTHOR: str
    HVERSION: str
    NAME: str
    LIBFILE: str
    MESSAGES: str
    TEXT_SIZE: int
    dataChanged: ClassVar[PySide6.QtCore.Signal]

    # _V is what the wrapped widget shows.
    class WrapBase(Generic[_V]):
        def __init__(self) -> None: ...
        def widget(self) -> PySide6.QtWidgets.QWidget | None: ...
        def setValue(self, value: _V) -> None: ...
        def clear(self) -> None: ...

    class WrapLabel(WrapBase[str | None]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: str | None) -> None: ...

    class WrapCheckBox(WrapBase[bool]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: bool) -> None: ...
        def clear(self) -> None: ...

    class WrapEdit(WrapBase[str]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: str) -> None: ...

    class WrapTextEdit(WrapBase[str]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: str) -> None: ...

    class WrapIcon(WrapBase[str]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: str) -> None: ...

    class WrapMessageView(WrapBase[_MessageViewText | _MessageViewVisibility]):
        def __init__(self, **kwargs: object) -> None: ...
        def setValue(self, value: _MessageViewText | _MessageViewVisibility) -> None: ...

    def __init__(self, title: str | None = ...) -> None: ...
    def title(self) -> str | None: ...
    def item(self, key: str) -> PySide6.QtWidgets.QWidget | None: ...
    def updateContent(self, ref: api.Ref | None, clear: bool = ...) -> None: ...
    def clearContent(self) -> None: ...
    def updateItem(self, key: str, value: str | bool | _MessageViewText | _MessageViewVisibility | None) -> None: ...
    def clearItem(self, key: str) -> None: ...
    def activate(self, ref: api.Ref | None) -> None: ...
    def deactivate(self, clear: bool = ...) -> None: ...
    def onNewComments(self, comments: str) -> None: ...
    def onNewIcon(self, icon_name: str) -> None: ...
    def onNewTitle(self) -> None: ...
    def onNewPattern(self) -> None: ...
    def onVisibleChecked(self) -> None: ...
    def setRowVisible(self, item_label: str, visible: bool) -> None: ...

import pathlib
import hou
from collections.abc import Collection
from typing import Self
import PySide6.QtWidgets

from hrecipes import api, rtypes, storage
from hrecipes.ui import utils as uiutils

class NodePresetDialog:
    def __init__(self, node: hou.OpNode | None = ..., editor: hou.NetworkEditor | hou.ParameterEditor | None = ..., internal_name: str | None = ..., title: str | None = ..., file_path: str | pathlib.Path | None = ..., store: storage.PresetStore | None = ..., mode: uiutils.DialogMode = ..., parent: PySide6.QtWidgets.QWidget | None = ..., edit_container: hou.Node | None = ...) -> None: ...
    @classmethod
    def forRef(cls, ref: api.NodePresetRef, node: hou.OpNode | None = ..., editor: hou.NetworkEditor | hou.ParameterEditor | None = ..., edit_container: hou.Node | None = ...) -> Self: ...
    def setIncludedNames(self, names: Collection[str]) -> None: ...
    def node(self) -> hou.OpNode | None: ...
    def setNode(self, node: hou.OpNode | None, check_names: Collection[str] = ...) -> None: ...
    def sourceNodeType(self) -> hou.NodeType | None: ...
    def setData(self, data: rtypes.NodeData, check_names: Collection[str] | None = ..., resync: bool = ...) -> None: ...
    def editor(self) -> hou.NetworkEditor | hou.ParameterEditor | None: ...
    def refType(self) -> type[api.NodePresetRef]: ...
    def isEmpty(self) -> bool: ...
    def setNodeFromEditor(self) -> None: ...
    def setNodeFromParentNetwork(self, network: hou.OpNode) -> None: ...
    def accept(self) -> bool | None: ...

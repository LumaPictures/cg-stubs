import hou
from collections.abc import Callable, Collection, Sequence
from typing import Any, ClassVar, TypeVar
import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

from hrecipes import models, rtypes, utils
from hrecipes.ui import utils as uiutils

_T = TypeVar("_T")

class ParmPresetPanel:
    parmCountChanged: ClassVar[PySide6.QtCore.Signal]
    def __init__(self, user_data: utils.UserData, node: hou.Node | None = ..., check_names: Collection[str] = ..., option_margin: int = ..., parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def setEnabled(self, enabled: bool) -> None: ...
    def parmCount(self) -> int: ...
    def emptyMessageLevel(self) -> uiutils.MessageLevel: ...
    def node(self) -> hou.Node | None: ...
    def setNode(self, node: hou.Node | None, check_names: Collection[str] | None = ..., data: rtypes.NetworkItemData | None = ...) -> None: ...
    def setEmptyMessageLevel(self, level: uiutils.MessageLevel) -> None: ...
    def data(self) -> rtypes.NodeData | None: ...
    def setData(self, data: rtypes.NodeData, check_names: Collection[str] | None = ..., resync: bool = ...) -> None: ...
    def hasTemplateTree(self) -> bool: ...
    def includedNames(self) -> set[str] | tuple[()]: ...
    def setIncludedNames(self, names: Collection[str]) -> None: ...
    def messageBoard(self) -> uiutils.MessageBoard | None: ...
    def setMessageBoard(self, board: uiutils.MessageBoard) -> None: ...
    def setTree(self, tree: models.ParameterTree) -> None: ...
    def setModel(self, model: models.ParameterTreeModel) -> None: ...
    def captureKeyframeExpr(self) -> bool: ...
    def onParmChanged(self, top_left: PySide6.QtCore.QModelIndex, bottom_right: PySide6.QtCore.QModelIndex, roles: Sequence[int]) -> None: ...
    def onDeferColumnResizing(self) -> None: ...
    def resizeEvent(self, event: PySide6.QtGui.QResizeEvent) -> None: ...
    def includedCount(self) -> int | None: ...
    def isEmpty(self) -> bool: ...

class ParmTreeView:
    parmChanged: ClassVar[PySide6.QtCore.Signal]
    def iterateItems(parent_index: PySide6.QtCore.QModelIndex, proxy_model: PySide6.QtCore.QSortFilterProxyModel, tree_view: ParmTreeView, iterfunc: Callable[[models.ParameterItem, PySide6.QtCore.QModelIndex, PySide6.QtCore.QModelIndex, ParmTreeView, _T | None], object], kwargs: _T | None = ...) -> None: ...
    def __init__(self, proxy_model: models.ParameterFilterProxyModel) -> None: ...
    def __del__(self) -> None: ...
    def setSourceModel(self, new_model: models.ParameterTreeModel) -> None: ...
    def showIncluded(self, parent_index: PySide6.QtCore.QModelIndex | None = ...) -> None: ...

    class Cache:
        def __init__(self, tree_view: ParmTreeView) -> None: ...
        def __del__(self) -> None: ...
        def restoreScrollBar(self) -> None: ...
        def restore(self) -> None: ...
        def build(self) -> None: ...
        def log(self) -> None: ...
        def clear(self) -> None: ...

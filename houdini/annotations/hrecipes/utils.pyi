_NetworkItemsData = rtypes.ClusterData | rtypes.NetworkItemData | rtypes.NetworkItemDataDict | Sequence[rtypes.NetworkItemData]

# A parm tuple's entry in UserData's "parm_tuple": ParmTupleMetaData.asdict(), to which
# models.ParameterTree adds the parm tuple's recorded value.
class _ParmTupleUserData(TypedDict, total=False):
    is_spare: bool
    use: bool
    off_default: bool
    is_enabled: bool
    value: rtypes.ParmUnionData | list[dict[str, rtypes.RampPointDataList | rtypes.MultiParmInstanceDataList]] | None

# UserData's "meta_data": what saveMetadata() records about a node, and the Options.extra_opts
# merged into it.
class _UserMetaData(TypedDict, total=False, extra_items=JSONLike):  # type: ignore[call-arg]
    input_names: Sequence[str]
    output_names: Sequence[str]
    item_size: Sequence[float]
    color: Sequence[float]
    type: str
    name: str
    node_type_category: str
    position: Sequence[float]
    is_network: bool
    network_category: str

# What a UserData holds, and attaches under the "sidefx" key of node and cluster data (so it is
# saved in the recipe's JSON). Other keys come from the data it was created from.
class _UserDataContents(TypedDict, total=False, extra_items=JSONLike):  # type: ignore[call-arg]
    # ui.utils.DataCollector.data(), keyed by parm tuple name.
    parm_tuple: dict[str, _ParmTupleUserData]
    meta_data: _UserMetaData
    version: str

# Node or cluster data, which can hold user data.
class _WithUserData(TypedDict, total=False):
    sidefx: _UserDataContents

# Parm template data can also have the keys of the obsolete asdata module.
class _LegacyParmTemplateData(rtypes.ParmTemplateData, total=False):
    default: Sequence[int | float | str]
    interface: str
    template_type: str

# UserData.Options.asdict()
class _UserDataOptionsDict(TypedDict):
    extra_opts: dict[str, JSONLike]
    save_pos_and_size: bool
    save_vop_connector_names: bool
    save_children: bool

class _UserDataOptionsChanges(TypedDict, total=False):
    extra_opts: dict[str, JSONLike]
    save_pos_and_size: bool
    save_vop_connector_names: bool
    save_children: bool


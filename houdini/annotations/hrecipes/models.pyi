class NetworkItem:
    def isItemNode(self) -> int: ...
    def row(self) -> int | None: ...

class ClusterItem(NetworkItem):
    def centralInputCount(self) -> int | None: ...
    def centralOutputCount(self) -> int | None: ...
    def setCentralName(self, name: str) -> None: ...
    def setInput(self, num: int, name: str | None) -> None: ...
    def setOutput(self, num: int, name: str | None) -> None: ...
    def setInputNames(self, nodenames: Sequence[str | None]) -> None: ...
    def setOutputNames(self, nodenames: Sequence[str | None]) -> None: ...
    def inputName(self, num: int = ...) -> str | None: ...
    def outputName(self, num: int = ...) -> str | None: ...
    def hasInputs(self, name: str, input_num: int = ...) -> bool: ...
    def hasOutputs(self, name: str, output_num: int = ...) -> bool: ...
    def possibleCentralNames(self, horizontal: bool = ...) -> list[str]: ...
    def possibleInputNames(self, horizontal: bool = ...) -> list[str]: ...
    def possibleOutputNames(self, horizontal: bool = ...) -> list[str]: ...
    def inputsOf(self, name: str, input_num: int | None = ...) -> set[str]: ...
    def outputsOf(self, name: str, output_num: int | None = ...) -> set[str]: ...
    def upstreamLeafNames(self, name: str, input_num: int | None = ..., inclusive: bool = ...) -> list[str]: ...
    def downstreamLeafNames(self, name: str, output_num: int | None = ..., inclusive: bool = ...) -> list[str]: ...
    def likelyInputNames(self, count: int | None = ...) -> Sequence[str | None]: ...
    def likelyOutputNames(self, count: int | None = ...) -> Sequence[str | None]: ...

class MovableItem(NetworkItem):

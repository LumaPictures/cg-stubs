    def setChildren(self, children: Sequence[ParmTupleItem]) -> None: ...
    def row(self) -> int | None: ...
    def menuItems(self) -> Sequence[dict[str, str]]: ...
    def values(self) -> Sequence[rtypes.ParmValueType] | None: ...

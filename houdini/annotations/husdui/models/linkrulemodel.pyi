from collections.abc import Collection, Mapping, Sequence
from typing import Any, TypeAlias

import hou
from PySide6 import QtCore, QtGui
from pxr import Usd

_UsdType: TypeAlias = type[Usd.SchemaBase]

class RuleModel(QtGui.QStandardItemModel):
    BaseColumn: int
    NameColumn: int
    IncludesColumn: int
    ExcludesColumn: int
    LinkNumColumn: int
    IdColumn: int
    TypeColumn: int
    ReversedColumn: int
    PrimColumn: int
    EditableColumn: int
    DeleteColumn: int
    EnableColumn: int
    PathExprColumn: int
    icon_size: int
    thePathExprOffIcon: hou.qt.Icon
    thePathExprOnIcon: hou.qt.Icon
    thePathExprIcon: QtGui.QIcon
    def __init__(self, node: hou.LopNode | None = ..., parent: QtCore.QObject | None = ...) -> None: ...
    def setSourceNode(self, node: hou.LopNode | None) -> None: ...
    def setRuleTypes(self, rule_type_or_types: int | Mapping[QtCore.Qt.KeyboardModifier, int]) -> None: ...
    def setForwardRuleTypes(self, forward_rule_types: Collection[_UsdType]) -> None: ...
    def setRuleMemberTypeDefs(self, rule_target_type_defs: Mapping[str | _UsdType, Collection[_UsdType]]) -> None: ...
    def reset(self) -> None: ...
    def stage(self) -> Usd.Stage | None: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int) -> str | None: ...
    def mimeTypes(self) -> list[str]: ...
    def canDropMimeData(
        self,
        mimedata: QtCore.QMimeData,
        action: QtCore.Qt.DropAction,
        row: int,
        column: int,
        parent_index: QtCore.QModelIndex,
    ) -> bool: ...
    def dropMimeData(
        self,
        mimedata: QtCore.QMimeData,
        action: QtCore.Qt.DropAction,
        row: int,
        column: int,
        parent_index: QtCore.QModelIndex,
    ) -> bool: ...
    def getFlatIndexes(self, target_index: QtCore.QModelIndex) -> tuple[QtCore.QModelIndex, QtCore.QModelIndex]: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> QtCore.Qt.ItemFlag: ...
    def setData(self, index: QtCore.QModelIndex, value: Any, role: int) -> bool: ...
    def removeRows(
        self, startrow: int, count: int, parent_index: QtCore.QModelIndex | QtCore.QPersistentModelIndex
    ) -> bool: ...
    def columnCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def updateFromSource(self) -> None: ...
    @staticmethod
    def modifierDropAction(action: int, modifier: int) -> QtCore.Qt.DropAction: ...

class RuleModelProxy(QtCore.QSortFilterProxyModel):
    BaseColumn: int
    NameColumn: int
    PrimColumn: int
    IncludesColumn: int
    ExcludesColumn: int
    LinkNumColumn: int
    IdColumn: int
    TypeColumn: int
    EditableColumn: int
    DeleteColumn: int
    PathExprColumn: int
    def __init__(self, parent: QtCore.QObject | None = ...) -> None: ...
    def setFilterList(self, prims: Sequence[str]) -> None: ...
    def setSearchList(self, search_list: Sequence[str]) -> None: ...
    def filterList(self) -> Sequence[str]: ...
    def searchList(self) -> Sequence[str]: ...
    def setFilterOn(self, on: bool) -> None: ...
    def filterAcceptsRow(self, row: int, parent_index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> bool: ...
    def removeRows(
        self, startrow: int, count: int, parent_index: QtCore.QModelIndex | QtCore.QPersistentModelIndex
    ) -> bool: ...

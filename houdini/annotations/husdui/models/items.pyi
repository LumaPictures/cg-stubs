from collections.abc import Callable, Container, Iterable
from typing import Any, NotRequired, TypeAlias, TypedDict, TypeVar

import hou
from PySide6 import QtCore, QtGui
from pxr import Sdf, Usd

_T = TypeVar("_T")
_RGB: TypeAlias = list[float] | tuple[float, ...]

class _ItemJsonDict(TypedDict):
    type: str
    path: str
    prim_path: str
    rgb: _RGB
    controls: tuple[str, ...]
    read_only: bool
    contents: "list[_ItemJson]"
    collection_name: NotRequired[str]

_ItemJson: TypeAlias = "_ItemJsonDict | list[_ItemJson]"

# An Item's toJson() after a JSON round trip (drag mime data, the layout detail).
class _ItemJsonData(TypedDict):
    type: str
    path: str
    prim_path: str
    rgb: list[float]
    controls: list[str]
    read_only: bool
    contents: "list[_ItemJsonData]"
    collection_name: NotRequired[str]

ROOT_ICON: hou.qt.Icon
BRANCH_ICON: hou.qt.Icon
R_COL_ICON: hou.qt.Icon
RW_COL_ICON: hou.qt.Icon
GENERIC_LIGHT_ICON: hou.qt.Icon
ITEM_MIME_TYPE: str
BASE_LIGHT_CONTROLS: tuple[str]
BASE_COLLECTION_CONTROLS: tuple[str, str]
EDITABLE_ITEM_COLOR: QtGui.QBrush

def invalidateDataCache(cache_id: int) -> None: ...
def getDataCacheIdx(cache_id: int) -> int: ...
def getIconForPrimPath(stage: Usd.Stage | None, prim_path: str | Sdf.Path, default: _T) -> hou.qt.Icon | _T: ...
def getIconForPrim(prim: Usd.Prim, default: _T) -> hou.qt.Icon | _T: ...
def items_to_mimedata(itemlist: Iterable["Item"]) -> QtCore.QMimeData: ...
def mimedata_to_json(mimedata: QtCore.QMimeData) -> list[_ItemJsonData]: ...
def mimedata_to_items(mimedata: QtCore.QMimeData) -> list["Item"]: ...
def mimedata_to_paths(mimedata: QtCore.QMimeData) -> list[str]: ...
def mimedata_to_paths_of_types(mimedata: QtCore.QMimeData, types: Container[str]) -> list[str]: ...

class Item(QtGui.QStandardItem):
    UnknownType: int
    LightType: int
    CollectionType: int
    BranchType: int
    GeometryType: int
    RootType: int
    def __init__(
        self,
        path: str | Sdf.Path,
        path_label: bool = ...,
        read_only: bool = ...,
        rgb: _RGB = ...,
        controls: Iterable[str] | None = ...,
        icon: QtGui.QIcon | None = ...,
        type: int = ...,
    ) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __nonzero__(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def __len__(self) -> int: ...
    def dump(self, prefix: str = ..., output_func: Callable[[str], object] | None = ...) -> None: ...
    @classmethod
    def fromJson(cls, obj: _ItemJsonData | str, db: object = ...) -> "Item": ...
    def toJson(self, trail: tuple[str, ...] = ...) -> _ItemJson: ...
    def clone(self, other: "Item") -> None: ...
    def data(self, role: int = ...) -> Any: ...
    def setData(self, value: Any, role: int = ...) -> None: ...
    def label(self) -> str: ...
    def name(self) -> str: ...
    def path(self) -> str: ...
    def sdfPath(self) -> Sdf.Path: ...
    def primPath(self) -> str | Sdf.Path: ...
    def itemTypeName(self) -> str: ...
    def itemType(self) -> int: ...
    def isRoot(self) -> bool: ...
    def isBranch(self) -> bool: ...
    def isCollection(self) -> bool: ...
    def isLight(self) -> bool: ...
    def isGeometry(self) -> bool: ...
    def rgb(self) -> _RGB: ...
    def homColor(self) -> hou.Color: ...
    def qtColor(self) -> QtGui.QColor: ...
    def setRGB(self, rgb: _RGB) -> None: ...
    def readOnly(self) -> bool: ...
    def update(self) -> None: ...
    def setExpanded(self, expanded: bool) -> None: ...
    def isExpanded(self) -> bool: ...
    def parent(self) -> QtGui.QStandardItem | None: ...
    def setParent(self, parent: QtGui.QStandardItem | None) -> None: ...
    def controls(self) -> tuple[str, ...]: ...
    def setControls(self, controls: Iterable[str]) -> None: ...
    def hasControl(self, name: str) -> bool: ...
    def children(self) -> list["Item"]: ...
    def hasChildren(self) -> bool: ...
    def rowOfChildPath(self, path: str) -> int: ...

def RootItem(
    path: str | Sdf.Path = ...,
    path_label: bool = ...,
    rgb: _RGB = ...,
    controls: Iterable[str] = ...,
    icon: QtGui.QIcon | None = ...,
) -> Item: ...
def BranchItem(
    path: str | Sdf.Path,
    path_label: bool = ...,
    rgb: _RGB = ...,
    controls: Iterable[str] = ...,
    icon: QtGui.QIcon | None = ...,
) -> Item: ...
def LightItem(
    path: str | Sdf.Path,
    path_label: bool = ...,
    rgb: _RGB = ...,
    controls: Iterable[str] = ...,
    icon: QtGui.QIcon | None = ...,
) -> Item: ...
def GeomItem(
    path: str | Sdf.Path,
    node: hou.LopNode,
    dbid: int,
    path_label: bool = ...,
    rgb: _RGB = ...,
    controls: Iterable[str] = ...,
    auto_recursive: bool = ...,
) -> Item: ...

class CollectionItem(Item):
    def __init__(
        self,
        prim_path: str | Sdf.Path,
        collection_name: str,
        cpath: str | None = ...,
        read_only: bool = ...,
        rgb: _RGB = ...,
        controls: Iterable[str] = ...,
        recursive: bool = ...,
    ) -> None: ...
    def __repr__(self) -> str: ...
    def toJson(self, trail: tuple[str, ...] = ...) -> _ItemJsonDict: ...
    @classmethod
    def fromJson(cls, obj: _ItemJsonData, db: object = ...) -> "CollectionItem": ...
    def name(self) -> str: ...
    def primPath(self) -> Sdf.Path: ...
    def setExpanded(self, expanded: bool) -> None: ...
    def isExpanded(self) -> bool: ...

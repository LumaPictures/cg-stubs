from collections.abc import Callable, Iterable, Mapping, MutableMapping, Sequence
from typing import Required, TypedDict

import hou
from houtypes import ShelfToolKwargs

class _MotionEffectsMenuKwargs(TypedDict, total=False):
    parms: Required[Sequence[hou.Parm]]
    toolname: str
    altclick: bool
    ctrlclick: bool
    shiftclick: bool
    cmdclick: bool

def genericTool(scriptargs: ShelfToolKwargs, nodetypename: str, nodename: str | None = ..., exact_node_type: bool = ...) -> hou.OpNode: ...
def findParentChopnetWithRate(n: hou.OpNode | None) -> hou.Parm | None: ...
def findChopnetWithRate(n: hou.OpNode | None) -> hou.Parm | None: ...
def adjustRate(n: hou.OpNode | None) -> None: ...
def modifyObjectTool(
    label: str,
    source: hou.ObjNode | None,
    target: hou.ObjNode | None,
    modify_func: Callable[[hou.ChopNode, str], hou.ChopNode | None],
    clipnet: hou.OpNode | None = ...,
) -> tuple[hou.ChopNode, hou.ChopNode, hou.ChopNode]: ...
def groupIntoParmTuples(parms: Iterable[hou.Parm]) -> list[hou.Parm | hou.ParmTuple]: ...
def createPose(
    parms: Sequence[hou.Parm],
    lock_clip: bool = ...,
    name_prefix: str | None = ...,
    parent: hou.OpNode | None = ...,
) -> hou.ChopNode: ...
def updatePose(node: hou.ChopNode | None) -> None: ...
def clearPose(node: hou.ChopNode | None) -> None: ...
def scopeTracks(chop: hou.ChopNode, chop_tracks: Iterable[hou.Track], keep: bool, name_prefix: str) -> hou.ChopNode: ...
def groupTracksByChop(tracks: Iterable[hou.Track], chop_nodes: MutableMapping[hou.ChopNode, list[hou.Track]]) -> None: ...
def createClipForParmObjects(
    parms: Sequence[hou.Parm],
    name_prefix: str,
    parent: hou.OpNode | None = ...,
    current_value_only: bool = ...,
) -> hou.ChopNode: ...
def transformChopNodes(input1: hou.ChopNode, input2: hou.ChopNode, name_prefix: str, reverse: bool = ...) -> hou.ChopNode: ...
def sumChopNodes(source_node: hou.ChopNode, add_node: hou.ChopNode, name_prefix: str) -> hou.ChopNode: ...
def parmAddEffect(kwargs: _MotionEffectsMenuKwargs, chop_type: str, name_prefix: str | None = ...) -> tuple[hou.ChopNode, hou.ChopNode]: ...
def parmFilterEffect(kwargs: _MotionEffectsMenuKwargs, chop_type: str, name_prefix: str | None = ...) -> hou.ChopNode: ...
def getTrackParmNames(tracks: Iterable[hou.Track], parm_from_track: Mapping[hou.Track, hou.Parm]) -> str: ...
def disableEffect(parms: Iterable[hou.Parm]) -> None: ...
def enableEffect(parms: Iterable[hou.Parm]) -> None: ...
def visualizeParmEffect(chop_node: hou.ChopNode, display_chop_node: hou.ChopNode | None = ...) -> None: ...
def chooseAndOpenClipFile(scriptargs: ShelfToolKwargs) -> None: ...
def buildFBXPath(
    filename: str,
    take_name: str = ...,
    convert_units: bool = ...,
    minimal_nodes: bool = ...,
    keep_deforming_shape_xforms: bool = ...,
    sample_rate: float | None = ...,
    remove_namespaces: bool = ...,
) -> str: ...

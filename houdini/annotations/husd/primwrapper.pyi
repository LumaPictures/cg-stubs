from collections.abc import Iterable

from pxr import Usd

import hou

class Prim:
    node: hou.LopNode
    primpath: str
    def __init__(self, node: hou.LopNode, primpath: str) -> None: ...
    def UsdPrim(self) -> Usd.Prim: ...
    def canPayloadBeLoaded(self) -> bool: ...
    def canPayloadBeUnloaded(self) -> bool: ...
    def canPopulate(self) -> bool: ...
    def canDepopulate(self) -> bool: ...

class PrimSet:
    node: hou.LopNode
    primpaths: list[str]
    def __init__(self, node: hou.LopNode, primpaths: Iterable[str]) -> None: ...
    def UsdPrims(self) -> list[Usd.Prim]: ...
    def loadPayloads(self) -> None: ...
    def unloadPayloads(self) -> None: ...
    def setPopulatePaths(self) -> None: ...
    def addPopulatePaths(self) -> None: ...
    def removePopulatePaths(self) -> None: ...
    def clearBranchLoadMasks(self, load_from_lops: bool) -> None: ...

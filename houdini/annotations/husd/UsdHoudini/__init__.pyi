# What a color3f / float2 attribute's default value converts from.
_Color3f: TypeAlias = pxr.Gf.Vec3f | pxr.Gf.Vec3d | tuple[float, float, float]
_Float2: TypeAlias = pxr.Gf.Vec2f | pxr.Gf.Vec2d | tuple[float, float]
# What a GfVec3d / GfVec3f argument converts from; a GfVec3f argument rejects a Gf.Vec3d.
_Vec3d: TypeAlias = pxr.Gf.Vec3d | list[float] | tuple[float, float, float]
_Vec3f: TypeAlias = pxr.Gf.Vec3f | list[float] | tuple[float, float, float]
# std::string arguments also take an Ar.ResolvedPath.
_Path: TypeAlias = pxr.Sdf.Path | pxr.Ar.ResolvedPath | str
_TimeCode: TypeAlias = pxr.Usd.TimeCode | float | pxr.Sdf.TimeCode

class _TimeKwargs(TypedDict, total=False):
    time: _TimeCode

class _RotationKwargs(TypedDict, total=False):
    orient: pxr.Gf.Quatf
    eulerAngles: _Vec3f
    order: HoudiniXformCommonAPI.RotationOrder

class _CreateXformOpsKwargs(TypedDict, total=False):
    rotationOrder: HoudiniXformCommonAPI.RotationOrder
    op1: HoudiniXformCommonAPI.OpFlags
    op2: HoudiniXformCommonAPI.OpFlags
    op3: HoudiniXformCommonAPI.OpFlags
    op4: HoudiniXformCommonAPI.OpFlags
    op5: HoudiniXformCommonAPI.OpFlags
    op6: HoudiniXformCommonAPI.OpFlags



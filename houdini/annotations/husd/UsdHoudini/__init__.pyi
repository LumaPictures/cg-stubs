        def GetValueFromName(
            *args: Unpack[tuple[str]], **kwargs: Never
        ) -> HoudiniXformCommonAPI.OpFlags | None: ...

    class Rotation:
        def __reduce__(cls) -> NoReturn: ...
        # Rotation(), Rotation(orient), or Rotation(eulerAngles, order).
        def __init__(
            cls,
            *args: pxr.Gf.Quatf | _Vec3f | HoudiniXformCommonAPI.RotationOrder,
            **kwargs: Unpack[_RotationKwargs],
        ) -> None: ...

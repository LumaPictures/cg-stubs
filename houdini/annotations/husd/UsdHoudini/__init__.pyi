            cls, *args: Unpack[tuple[HoudiniXformCommonAPI.RotationOrder]], **kwargs: Never
        ) -> pxr.Gf.Vec3f: ...
        def GetRotationOrder(
            cls, *args: Never, **kwargs: Never
        ) -> HoudiniXformCommonAPI.RotationOrder: ...
        def GetQuaternion(cls, *args: Never, **kwargs: Never) -> pxr.Gf.Quatf: ...

    def __reduce__(cls) -> NoReturn: ...
    def SetXformVectors(
        cls,
        *args: Unpack[
            tuple[
                _Vec3d,
                HoudiniXformCommonAPI.Rotation,
                _Vec3f,
                _Vec3f,
                _Vec3f,
                _Vec3f,
                _TimeCode,
            ]
        ],
        **kwargs: Never,
    ) -> bool: ...
    # (translation, rotation, scale, shear, pivot, pivotRotate)
    def GetXformVectors(
        cls, *args: Unpack[tuple[_TimeCode]], **kwargs: Never
    ) -> tuple[
        pxr.Gf.Vec3d,
        HoudiniXformCommonAPI.Rotation,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
    ]: ...
    def GetXformVectorsByAccumulation(
        cls, *args: Unpack[tuple[_TimeCode]], **kwargs: Never
    ) -> tuple[
        pxr.Gf.Vec3d,
        HoudiniXformCommonAPI.Rotation,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
        pxr.Gf.Vec3f,
    ]: ...
    @overload
    def SetTranslate(cls, *args: Unpack[tuple[_Vec3d]], **kwargs: Unpack[_TimeKwargs]) -> bool: ...
    @overload
    def SetTranslate(cls, *args: Unpack[tuple[_Vec3d, _TimeCode]], **kwargs: Never) -> bool: ...
    @overload
    def SetPivot(cls, *args: Unpack[tuple[_Vec3f]], **kwargs: Unpack[_TimeKwargs]) -> bool: ...
    @overload
    def SetPivot(cls, *args: Unpack[tuple[_Vec3f, _TimeCode]], **kwargs: Never) -> bool: ...
    @overload
    def SetPivotRotate(cls, *args: Unpack[tuple[_Vec3f]], **kwargs: Unpack[_TimeKwargs]) -> bool: ...
    @overload
    def SetPivotRotate(cls, *args: Unpack[tuple[_Vec3f, _TimeCode]], **kwargs: Never) -> bool: ...
    @overload
    def SetRotate(cls, *args: Unpack[tuple[HoudiniXformCommonAPI.Rotation]], **kwargs: Unpack[_TimeKwargs]) -> bool: ...
    @overload
    def SetRotate(cls, *args: Unpack[tuple[HoudiniXformCommonAPI.Rotation, _TimeCode]], **kwargs: Never) -> bool: ...
    @overload

from collections.abc import Mapping
from typing import TypedDict

from houtypes import JSONLike, JSONValue

class _ViewportOptions(TypedDict):
    rendersettings_path: str
    camera_path: str
    res_x: int
    res_y: int

# What Houdini hands startBackgroundRender: the options getConfigOptions gave, and the viewport's.
class _RenderOptions(TypedDict):
    plugin: dict[str, JSONValue]
    viewport: _ViewportOptions

class BackgroundRenderer:
    def __init__(self, lopnet_path: str, item_id: str) -> None: ...
    def updateImagePath(self, image_path: str) -> None: ...
    def updateMetadata(self, metadata: Mapping[str, JSONLike]) -> None: ...
    def pollFrequency(self) -> float: ...
    def getConfigOptions(self, old_options: Mapping[str, JSONValue] | None) -> dict[str, JSONValue] | None: ...
    def startBackgroundRender(self, usd_filepath: str, options: _RenderOptions) -> None: ...
    def isRenderFinished(self) -> bool: ...
    def mouseClick(self, x: int, y: int) -> None: ...
    def stopBackgroundRender(self) -> None: ...

class Manager:
    def __init__(self) -> None: ...
    def registerBackgroundRenderer(self, label: str, renderer_cls: type[BackgroundRenderer]) -> None: ...
    def getAllBackgroundRendererNames(self) -> list[str]: ...
    def getBackgroundRenderer(self, label: str, lopnet_path: str, item_id: str) -> BackgroundRenderer: ...

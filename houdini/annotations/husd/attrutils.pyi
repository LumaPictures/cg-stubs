from typing import TypeVar, overload

import hou
from husd.typeutils import _SdfArrayValue, _SdfScalarValue
from pxr import Sdf, Usd

_T = TypeVar("_T")

class _SubLayerInfo:
    layer: Sdf.Layer
    offset: Sdf.LayerOffset
    parentLayer: Sdf.Layer | None
    def __init__(
        self,
        sublayer: Sdf.Layer,
        offset: Sdf.LayerOffset,
        containingLayer: Sdf.Layer | None,
        prefix: str,
    ) -> None: ...
    def GetOffsetString(self) -> str: ...
    def GetHierarchicalDisplayString(self) -> str: ...

def GetLabelForLayer(layer: Sdf.Layer) -> str: ...
def GetToolTipForLayer(layer: Sdf.Layer) -> str: ...
def GetNodePathForDisplayFromId(nodeid: int) -> str: ...
def GetEditorNodesForLayer(layer: Sdf.Layer) -> list[hou.Node]: ...
def GetRootLayerStackInfo(layer: Sdf.Layer) -> list[_SubLayerInfo]: ...
def GetScalarTypeFromAttr(attr: Usd.Object) -> tuple[Sdf.ValueTypeName | None, bool]: ...
def ToString(v: object, typeName: Sdf.ValueTypeName | str | None = ..., short: bool = ...) -> str: ...
@overload
def ConvertAssetPathToString(val: Sdf.AssetPath) -> str: ...
@overload
def ConvertAssetPathToString(val: Sdf.AssetPathArray) -> list[str]: ...
@overload
def ConvertAssetPathToString(val: _T) -> _T: ...
# An attribute's value with its asset paths as strings, a relationship's target paths.
@overload
def GetValue(prop: Usd.Relationship, frame: float | Usd.TimeCode) -> list[str]: ...
@overload
def GetValue(prop: Usd.Attribute, frame: float | Usd.TimeCode) -> _SdfScalarValue | _SdfArrayValue | list[str] | None: ...
@overload
def GetValue(prop: Usd.Object, frame: float | Usd.TimeCode) -> _SdfScalarValue | _SdfArrayValue | list[str] | None: ...
def GetShortString(prop: Usd.Object, frame: float | Usd.TimeCode) -> str: ...
def GetSpecValue(prop: Sdf.Spec | None) -> str: ...

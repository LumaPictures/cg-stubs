import hou
from houtypes import JSONValue

DISK: str
HDA_DEFINITION: str
DATA_PREFIX: str
ROOT: str

class LazyLoader:
    data_source_type: str | None
    data_source: str | hou.HDADefinition | None
    hda_section_name_prefix: str | None
    @classmethod
    def setDataSourceInfo(
        cls,
        data_source_type: str,
        data_source: str | hou.HDADefinition | None,
        hda_section_name_prefix: str | None = ...,
    ) -> None: ...
    @classmethod
    def assertDataSourceIsSet(cls) -> None: ...
    @classmethod
    def loadData(cls, data_path: str | None, item_id: "UniqueId | int | None", data_type: str) -> JSONValue | bytes: ...
    @classmethod
    def hdaSectionNameForItemData(
        cls, item_id: "UniqueId | int", section_name_prefix: str | None = ...
    ) -> str: ...
    @classmethod
    def saveState(cls) -> None: ...
    @classmethod
    def restoreState(cls) -> None: ...
    @classmethod
    def reset(cls) -> None: ...

class UniqueIdError(Exception): ...

class UniqueId:
    __used_ids: set[int]
    __free_ids: set[int]
    __largest_id: int
    @classmethod
    def reset(cls) -> None: ...
    def __init__(self, from_id: int | None = ...) -> None: ...
    def force_id(self, id_to_use: int) -> None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def getId(self) -> int: ...
    def release(self) -> None: ...

def cleanup() -> None: ...

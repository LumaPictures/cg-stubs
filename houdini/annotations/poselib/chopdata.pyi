from collections.abc import Iterable, Mapping

import hou

class ChopData:
    parms: list[list[str]]
    chops: list[hou.ChopNode]
    chopData: list[bytes]
    def __init__(self) -> None: ...
    def hasData(self) -> bool: ...
    def add(self, parm_name: str, chop: hou.ChopNode) -> None: ...
    def capture(self, start: float, end: float) -> None: ...
    def apply(self, start: float, root: str, name: str | None) -> list[hou.OpNode]: ...
    def jsonDict(self) -> dict[str, list[bytes]]: ...
    def setJSONDict(self, json_dict: Mapping[str, Iterable[bytes]], binary: bool = ...) -> None: ...

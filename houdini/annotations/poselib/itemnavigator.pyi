from collections.abc import Sequence

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

from poselib import itemlibrary

class TreeView(PySide6.QtWidgets.QTreeView):
    focusRequested: PySide6.QtCore.Signal
    folderSelected: PySide6.QtCore.Signal
    itemLeft: PySide6.QtCore.Signal
    itemShowInfoRequested: PySide6.QtCore.Signal
    itemHideInfoRequested: PySide6.QtCore.Signal
    itemToolTipRequested: PySide6.QtCore.Signal
    hideItemsAction: PySide6.QtGui.QAction
    showItemsAction: PySide6.QtGui.QAction
    viewMenu: PySide6.QtWidgets.QMenu
    def __init__(self, parent: PySide6.QtWidgets.QWidget, model: itemlibrary.TreeModel) -> None: ...
    def cleanup(self) -> None: ...
    def handleModelReset(self) -> None: ...
    def modelDataChanged(
        self, topLeft: PySide6.QtCore.QModelIndex, bottomRight: PySide6.QtCore.QModelIndex, roles: Sequence[int]
    ) -> None: ...
    def workingFolder(self) -> PySide6.QtCore.QModelIndex: ...
    def showItems(self) -> bool: ...
    def sourceIndexAt(self, pos: PySide6.QtCore.QPoint) -> PySide6.QtCore.QModelIndex: ...
    def selectedSourceIndexes(self) -> list[PySide6.QtCore.QModelIndex]: ...
    def selectedSourceIndex(self) -> PySide6.QtCore.QModelIndex: ...
    def selectIndexes(self, *indexes: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> None: ...
    def deselectIndexes(self, *indexes: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> None: ...
    def updateActions(
        self, sender: PySide6.QtCore.QObject | None, selected_indexes: Sequence[PySide6.QtCore.QModelIndex]
    ) -> None: ...
    def event(self, event: PySide6.QtCore.QEvent) -> bool: ...
    def eventFilter(self, obj: PySide6.QtCore.QObject, event: PySide6.QtCore.QEvent) -> bool: ...
    def mousePressEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def leaveEvent(self, event: PySide6.QtCore.QEvent) -> None: ...
    def rowsInserted(
        self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, first: int, last: int
    ) -> None: ...
    def enableDrag(self) -> None: ...
    def disableDrag(self) -> None: ...
    def forceEdit(self, source_index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> None: ...

class RowDelegate(PySide6.QtWidgets.QStyledItemDelegate):
    ICON_WIDTH: int
    ICON_HEIGHT: int
    TEXT_MARGIN: int
    editingFinished: PySide6.QtCore.Signal
    indexRenamed: PySide6.QtCore.Signal
    def createEditor(
        self,
        parent: PySide6.QtWidgets.QWidget | None,
        option: PySide6.QtWidgets.QStyleOptionViewItem,
        index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex,
    ) -> PySide6.QtWidgets.QWidget: ...
    def setEditorData(
        self, editor: PySide6.QtWidgets.QWidget, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex
    ) -> None: ...
    def setModelData(
        self,
        editor: PySide6.QtWidgets.QWidget,
        model: PySide6.QtCore.QAbstractItemModel,
        index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex,
    ) -> None: ...
    def commitAndCloseEditor(self) -> None: ...
    def paint(
        self,
        painter: PySide6.QtGui.QPainter,
        option: PySide6.QtWidgets.QStyleOptionViewItem,
        index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex,
    ) -> None: ...

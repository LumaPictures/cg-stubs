import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets
from PySide6 import QtCore

import hou
from poselib.pose import PoseData

class PoseCapture:
    def capturePose(self, node: hou.OpNode, frame: float, all_parms: bool = ...) -> PoseData: ...
    def captureClip(
        self,
        node: hou.OpNode,
        start: float,
        end: float,
        sample_rate: float,
        bake_clip: bool,
        use_bclip: bool = ...,
        use_blosc_compression: bool = ...,
    ) -> PoseData | None: ...

    def _capture(
        self,
        node: hou.OpNode,
        start: float,
        end: float,
        bake_clip: bool = ...,
        sample_rate: float = ...,
        all_parms: bool = ...,
    ) -> PoseData: ...

class PoseApply:
    blendDict: dict[str, int | float | str]
    def __init__(self) -> None: ...
    def applyPose(self, node: hou.OpNode, pose: PoseData) -> None: ...
    def applyClip(
        self, node: hou.OpNode, clip: PoseData, chop: bool = ..., root: str | None = ...
    ) -> None: ...
    def captureBlend(self, node: hou.OpNode) -> None: ...
    def blendPose(self, node: hou.OpNode, clip: PoseData, amount: float) -> None: ...

class _NodeTextField(PySide6.QtWidgets.QLineEdit):
    def dropEvent(self, event: PySide6.QtGui.QDropEvent) -> None: ...

class NodeChooserWidget(PySide6.QtWidgets.QWidget):
    nodeChanged: QtCore.Signal
    MAX_RECENTS: int
    clearHistoryAction: PySide6.QtGui.QAction
    def __init__(self, parent: PySide6.QtWidgets.QWidget) -> None: ...
    def cleanup(self) -> None: ...
    def reset(self) -> None: ...
    def ensureNodeSelected(self) -> hou.OpNode | None: ...
    def selectedNode(self) -> hou.OpNode | None: ...
    def setNode(self, path: str) -> bool: ...
    def eventFilter(self, widget: PySide6.QtCore.QObject, event: PySide6.QtCore.QEvent) -> bool: ...

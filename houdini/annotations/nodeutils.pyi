import re
from collections import defaultdict
from collections.abc import Generator, Iterable, Mapping, Sequence

import hou

part_pattern: str
neg_pattern: str
part_exp: re.Pattern[str]
valid_name: re.Pattern[str]

class NodeMissingError(Exception): ...

class Part:
    is_glob: bool
    pos: int | None
    def __init__(self) -> None: ...
    def as_regex(self) -> str: ...
    def replacement(self, context: RenameContext) -> str: ...
    def is_star(self) -> bool: ...
    def is_negation(self) -> bool: ...

class Literal(Part):
    text: str
    def __init__(self, text: str) -> None: ...
    def __repr__(self) -> str: ...
    def as_regex(self) -> str: ...
    def replacement(self, context: RenameContext) -> str: ...

class Glob(Part):
    is_glob: bool
    pattern: str
    pos: int
    capturing: bool
    unique: bool
    following_negation: Negation | None
    def __init__(self, pattern: str, pos: int, capturing: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def is_star(self) -> bool: ...
    def as_regex(self) -> str: ...
    def replacement(self, context: RenameContext) -> str: ...

class Negation(Part):
    glob: Glob
    def __init__(self, pattern: str) -> None: ...
    def __repr__(self) -> str: ...
    def is_negation(self) -> bool: ...
    def as_regex(self) -> str: ...
    def replacement(self, context: RenameContext) -> str: ...

class GroupRef(Part):
    text: str
    num: int
    def __init__(self, text: str, num: int) -> None: ...
    def __repr__(self) -> str: ...
    def as_regex(self) -> str: ...
    def replacement(self, context: RenameContext) -> str: ...

class RenameContext:
    pattern_map: dict[str, int]
    counters: defaultdict[str, int]
    groups: tuple[str, ...]
    def __init__(self, find_parts: Iterable[Part]) -> None: ...
    def __repr__(self) -> str: ...


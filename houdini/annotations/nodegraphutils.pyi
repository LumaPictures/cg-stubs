class EditorUpdates:
    adj_items: list[hou.NetworkItem]
    adj_values: list[hou.NetworkAnimValue]
    shapes: list[hou.NetworkShape]
    ovr_shapes: list[hou.NetworkShape]
    def __init__(self) -> None: ...
    def setAdjustments(self, items: Iterable[hou.NetworkItem], values: Iterable[hou.NetworkAnimValue]) -> None: ...
    def setShapes(self, shapes: Iterable[hou.NetworkShape]) -> None: ...
    def addShapes(self, shapes: Iterable[hou.NetworkShape]) -> None: ...
    def setOverlayShapes(self, shapes: Iterable[hou.NetworkShape]) -> None: ...
    def addOverlayShapes(self, shapes: Iterable[hou.NetworkShape]) -> None: ...
    def combine(self, other: "EditorUpdates") -> None: ...
    def applyToEditor(self, editor: hou.NetworkEditor) -> None: ...
    def clear(self) -> None: ...


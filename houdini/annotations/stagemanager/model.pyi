from collections.abc import Callable, Collection, Iterable, Sequence
from typing import Any, NamedTuple, TypeAlias

import hou
from pxr import Sdf, Usd
from PySide6 import QtCore, QtGui, QtWidgets

from stagemanager.common import Column

class ReferenceDescriptor(NamedTuple):
    primpath: str
    activation: int
    visibility: int
    selectability: int
    kind: str
    reffilepath: str
    refprimpath: str
    refaspayload: int
    variantsets: dict[str, str]
    instanceable: bool | None

# One SceneGraphBranch column value: the fields of a ReferenceDescriptor, in order.
_BranchValue: TypeAlias = str | int | bool | dict[str, str] | None

# StageManagerModel.data by role: SizeHint, Decoration, Display/Edit (the name), User (the column's value), Foreground.
_ModelData: TypeAlias = QtCore.QSize | hou.qt.Icon | _BranchValue | QtCore.Qt.GlobalColor

PARMS: tuple[str, ...]

class StageHolder:
    node: hou.LopNode | None
    allow_viewport_overrides: bool
    allow_post_layers: bool
    stage: Usd.Stage | None
    def __init__(self, node: hou.LopNode | None, allow_viewport_overrides: bool, allow_post_layers: bool) -> None: ...
    def getObjectAtPath(self, path: Sdf.Path) -> Usd.Prim | Usd.Property | None: ...

class SceneGraphBranch:
    default_data: list[_BranchValue]
    parent: "SceneGraphBranch | None"
    children: dict[str, "SceneGraphBranch"]
    child_names: list[str]
    data: list[_BranchValue]
    is_cut: bool
    def __init__(self, parent: "SceneGraphBranch | None", name: str) -> None: ...
    def getParent(self) -> "SceneGraphBranch | None": ...
    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, new_name: str) -> None: ...
    def getChildByName(self, name: str) -> "SceneGraphBranch | None": ...
    def getChildByIndex(self, index: int) -> "SceneGraphBranch | None": ...
    def index(self, name: str) -> int: ...
    def getNumChildren(self) -> int: ...
    def getData(self, column: int) -> _BranchValue: ...
    def setData(self, column: int, data: _BranchValue) -> None: ...
    def isModelRoot(self) -> bool: ...
    def isRoot(self) -> bool: ...
    def createChild(self, name: str, index: int, force_unique_name: bool) -> "SceneGraphBranch": ...
    def copy(self, branch: "SceneGraphBranch") -> None: ...
    def removeChild(self, name: str) -> None: ...
    def __repr__(self) -> str: ...

class SceneGraphClipboard:
    paths: list[str]
    cut: bool
    branch: SceneGraphBranch
    def __init__(self) -> None: ...

class SceneGraphSelectionModel(QtCore.QItemSelectionModel):

import asyncio
import concurrent.futures
import contextvars
import os
import socket
from collections.abc import Awaitable, Callable, Collection, Coroutine, Iterable, Mapping, MutableMapping, Sequence
from ssl import SSLContext
from typing import IO, Any, Never, NoReturn, Protocol, TypeAlias, TypedDict, TypeVar, TypeVarTuple, Unpack, overload

from _haio import ErrorCode, PyAsyncioHandle, PyAsyncioLoop, PyAsyncioTimer, PyReadPipe, PyTCPSocket, PyUDPSocket, PyWritePipe

_T = TypeVar("_T")
_Ts = TypeVarTuple("_Ts")
_ProtocolT = TypeVar("_ProtocolT", bound=asyncio.BaseProtocol)
_SubprocessProtocolT = TypeVar("_SubprocessProtocolT", bound=asyncio.SubprocessProtocol)
_DatagramProtocolT = TypeVar("_DatagramProtocolT", bound=asyncio.DatagramProtocol)

_IPAddress: TypeAlias = tuple[str, int] | tuple[str, int, int, int]
_StrOrBytesPath: TypeAlias = str | bytes | os.PathLike[str] | os.PathLike[bytes]
_Buffer: TypeAlias = bytes | bytearray | memoryview
_ExceptionContext: TypeAlias = dict[str, Any]
_ExceptionHandler: TypeAlias = Callable[[asyncio.AbstractEventLoop, dict[str, Any]], object]
_AddrInfo: TypeAlias = tuple[
    socket.AddressFamily,
    socket.SocketKind,
    int,
    str,
    tuple[str, int] | tuple[str, int, int, int] | tuple[int, bytes],
]

class _HasFileno(Protocol):
    def fileno(self) -> int: ...

class _PipeFile(Protocol):
    def fileno(self) -> int: ...
    def close(self) -> object: ...

class _WarnFunc(Protocol):
    def __call__(self, message: str, category: type[Warning], /, *, source: object) -> object: ...

class _SocketLike(Protocol):
    @property
    def family(self) -> int: ...
    @property
    def type(self) -> int: ...
    @property
    def proto(self) -> int: ...
    def fileno(self) -> int: ...

class _TaskOptions(TypedDict, total=False):
    name: str | None
    context: contextvars.Context | None
    eager_start: bool

# The subprocess.Popen keywords a subprocess transport passes on (it gives the others itself).
class _PopenKwargs(TypedDict, total=False):
    executable: _StrOrBytesPath | None
    preexec_fn: Callable[[], object] | None
    close_fds: bool
    cwd: _StrOrBytesPath | None
    env: Mapping[str, _StrOrBytesPath] | Mapping[bytes, _StrOrBytesPath] | None
    creationflags: int
    restore_signals: bool
    start_new_session: bool
    pass_fds: Collection[int]
    user: str | int | None
    group: str | int | None
    extra_groups: Iterable[str | int] | None
    umask: int
    pipesize: int
    process_group: int | None

class _SubprocessTransportKwargs(_PopenKwargs, total=False):
    waiter: asyncio.Future[None] | None
    extra: MutableMapping[str, object] | None

def check_thread() -> None: ...
def convert_boost_error(err: ErrorCode) -> asyncio.CancelledError | OSError: ...


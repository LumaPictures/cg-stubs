from collections.abc import Iterable
from typing import Any, TypeAlias

from pxr import Sdf, Usd
from PySide6 import QtCore, QtGui, QtWidgets

from scenegraphdetails.model import DetailsItem

_AnyIndex: TypeAlias = QtCore.QModelIndex | QtCore.QPersistentModelIndex

class _ArrayValueModel(QtCore.QAbstractListModel):
    val: Any
    def __init__(self, val: object) -> None: ...
    def rowCount(self, *args: object) -> int: ...
    def data(self, index: _AnyIndex, role: int = ...) -> str | None: ...
    def fetchMore(self, index: _AnyIndex) -> None: ...
    def canFetchMore(self, index: _AnyIndex) -> bool: ...

class _ArrayAttributeModel(QtCore.QAbstractListModel):
    val: Any
    def __init__(self, attr: Usd.Object | Sdf.Spec | None, frame: float) -> None: ...
    def rowCount(self, *args: object) -> int: ...
    def data(self, index: _AnyIndex, role: int = ...) -> str | None: ...
    def fetchMore(self, index: _AnyIndex) -> None: ...
    def canFetchMore(self, index: _AnyIndex) -> bool: ...

class ArrayAttributeView(QtWidgets.QListView):
    def __init__(self, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def populateFromItem(self, item: DetailsItem | None, frame: float | None = ...) -> None: ...
    def populateFromValue(self, value: object) -> None: ...
    def copyValues(self, indexes: Iterable[QtCore.QModelIndex]) -> None: ...
    def keyPressEvent(self, e: QtGui.QKeyEvent) -> None: ...
    def contextMenuEvent(self, event: QtGui.QContextMenuEvent) -> None: ...

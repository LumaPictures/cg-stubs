import collections
from collections.abc import Mapping, MutableMapping, Sequence
from typing import Any, Protocol, TypeAlias, TypedDict

import hou
from houtypes import JSONLike
from PySide6 import QtCore, QtWidgets

from autorigs.ui.uiParamColor import UiParamColor
from autorigs.ui.uiParamFloat import UiParamFloat
from autorigs.ui.uiParamInt import UiParamInt

class _EditableGuideObj(TypedDict):
    label: str
    nodes: list[hou.OpNode] | None
    params: Sequence[int]

# A BaseParamWidget's guide params, as toJSON writes them from its widgets: {guide key: {param
# label ("translate", "angle", ...): the widget's values, or a nested group}}, plus sub-modules'
# params under their own keys. The shipped defaults hold numbers as strings ("0.0", ["1.0", ...]).
_ParamsJson: TypeAlias = dict[str, JSONLike]

class _Unlinkable(Protocol):
    def unlinkParms(self) -> None: ...

class _ValueWidget(Protocol):
    def getValues(self) -> JSONLike: ...
    def setValues(self, values: Any, /) -> None: ...

class _UnsavedTracker(Protocol):
    def hasUnsavedChanges(self) -> bool: ...

class _SaveMarkable(Protocol):
    def markSaved(self) -> None: ...

def getEditableGuideObj(label: str, nodes: list[hou.OpNode] | None, params: Sequence[int]) -> _EditableGuideObj: ...
def createParamWidget(paramobj: _EditableGuideObj, paramwidget_dst: MutableMapping[int, UiParamFloat | UiParamColor | UiParamInt] | None = ..., label: bool = ...) -> QtWidgets.QVBoxLayout: ...
def createScrollLayout(widget: QtWidgets.QWidget, scroll_policy: QtCore.Qt.ScrollBarPolicy = ...) -> QtWidgets.QVBoxLayout: ...
def unlinkParmWidgetList(paramwidgets: Mapping[int, _Unlinkable]) -> None: ...
def unlinkParmWidgetDict(paramdict: Mapping[Any, _Unlinkable | dict[Any, Any]]) -> None: ...
def toJSON(widgets: Mapping[Any, _ValueWidget | dict[Any, Any]]) -> collections.OrderedDict[str | int, JSONLike]: ...
def fromJSON(json: Mapping[str, JSONLike], widgets: Mapping[Any, _ValueWidget | dict[Any, Any]]) -> None: ...
def setParamWidget(widget: _ValueWidget, value: JSONLike) -> None: ...
def hasUnsavedChanges(widgets: Mapping[Any, _UnsavedTracker | dict[Any, Any]]) -> bool: ...
def markSaved(widgets: Mapping[Any, _SaveMarkable | dict[Any, Any]]) -> None: ...
def beautifyLabel(name: str) -> str | None: ...

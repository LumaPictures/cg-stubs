import types
from collections.abc import Sequence
from typing import NotRequired, Protocol

import hou
from PySide6 import QtCore
from typing_extensions import TypedDict

from autorigs.asset.autoRigsModules import AutoRigsModules
from autorigs.asset.autoRigsSettings import AutoRigsSettings, _SettingsJson
from autorigs.asset.geometry.buildGeometryGuide import GeometryGuide
from autorigs.modules.base.rootModule import Module, _ModuleJson
from autorigs.modules.master.masterModule import MasterModule

# Closed (PEP 728), so the asset JSON is JSONLike for hutil.json's dumpers.
class _BuiltJson(TypedDict, closed=True):  # type: ignore[call-arg]
    built: bool

class _AssetJson(TypedDict, closed=True):  # type: ignore[call-arg]
    settings: _SettingsJson
    geometryguides: dict[str, dict[str, str]]
    modules: list[_ModuleJson]
    autorig: _BuiltJson

class _CreateValues(TypedDict):
    assetname: str
    assettype: str
    geosource: int
    geodata: dict[str, str] | str | None
    presettype: NotRequired[int]
    assetfilesource: NotRequired[int]
    assetfiledata: NotRequired[str | None]
    capturenetwork: NotRequired[bool]
    capturetype: NotRequired[int]
    displaydeform: NotRequired[bool]
    asseticonpath: NotRequired[str]

class _BuildGuide(Protocol):
    def getBuildErrorMsg(self) -> str: ...

class AutoRigsAssetFactory:
    defaults: types.ModuleType

    @classmethod
    def createFromDefault(cls, settings: AutoRigsSettings) -> "AutoRigsAsset": ...
    @classmethod
    def createFromJsonExisting(cls, assetnode: hou.ObjNode, json: _AssetJson, settings: AutoRigsSettings) -> "AutoRigsAsset": ...


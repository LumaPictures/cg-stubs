import builtins
import collections
from collections.abc import Callable
from typing import Literal, TypedDict

import hou
from PySide6 import QtCore, QtWidgets

from autorigs.ui.uiParamInt import UiParamInt
from autorigs.ui.uiParamLocatorWidget import UiParamLocatorWidget, _LocatorValues

class _MultiParmValues(TypedDict):
    count: builtins.list[float]
    list: builtins.list[_LocatorValues]

class UiParamMultiParm(QtWidgets.QWidget):
    valueChanged: QtCore.Signal
    itemWidgetCreated: QtCore.Signal
    itemWidgetDeleted: QtCore.Signal

    COUNT: Literal["count"]
    LIST: Literal["list"]

    createParmWidget: Callable[[], UiParamLocatorWidget]
    item_widgets: "list[ListItem]"
    widgetToIndex: "dict[ListItem, int]"
    linkednode: hou.OpNode | None
    parm_num: UiParamInt
    list_widget: QtWidgets.QWidget
    parmname: str

    def __init__(self, parm_widget_fcn: Callable[[], UiParamLocatorWidget]) -> None: ...
    def getCount(self) -> int: ...
    def setCount(self, count: int) -> None: ...
    def setLabel(self, label: str) -> None: ...
    def linkParm(self, node: hou.OpNode, parmname: str) -> None: ...
    def updateList(self, value: int) -> None: ...
    def insertWidget(self, index: int) -> None: ...
    def removeWidget(self, index: int) -> None: ...
    def remapWidgetToIndex(self, index: int) -> None: ...
    def findIndex(self, item_widget: "ListItem") -> int: ...
    def insertClicked(self, item_widget: "ListItem") -> None: ...
    def removeClicked(self, item_widget: "ListItem") -> None: ...
    def getItemWidget(self, index: int) -> "ListItem": ...
    def getWidget(self, index: int) -> UiParamLocatorWidget: ...
    def getValues(
        self,
    ) -> collections.OrderedDict[str, list[float] | list[collections.OrderedDict[str, str | list[float] | int]]]: ...
    def setValues(self, values: _MultiParmValues) -> None: ...
    def updateCountParm(self) -> None: ...
    def unlinkParms(self) -> None: ...

class ListItem(QtWidgets.QWidget):
    insert: QtCore.Signal
    remove: QtCore.Signal

    widget: UiParamLocatorWidget

    def __init__(self, widget: UiParamLocatorWidget) -> None: ...
    def getWidget(self) -> UiParamLocatorWidget: ...

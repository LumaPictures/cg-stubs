import hou
from PySide6 import QtCore, QtGui, QtWidgets

from autorigs.asset.autoRigsAsset import AutoRigsAsset
from autorigs.modules.base.rootModule import Module
from autorigs.ui.moduleListItemWidget import ModuleListItemWidget, TopAllItem
from autorigs.ui.uiCharacterTabs import UiCharacterTab

class UiModuleList(QtWidgets.QWidget):
    moduleChanged: QtCore.Signal

    autorigs_asset: AutoRigsAsset
    charactertab: UiCharacterTab
    all_widget: TopAllItem
    modulenames: set[str]
    modulelist: QtWidgets.QListWidget
    rightclickmenu: QtWidgets.QMenu
    moduledetails: hou.qt.ParmDialog
    modulenode: hou.ObjNode | None

    def __init__(self, autorigs_asset: AutoRigsAsset, charactertab: UiCharacterTab) -> None: ...
    def initializeList(self, autorigs_asset: AutoRigsAsset) -> None: ...
    def appendModuleWidget(self, listitem: QtWidgets.QListWidgetItem, widget: QtWidgets.QWidget) -> None: ...
    def appendNewModule(self, module: Module) -> None: ...
    def rename(self, itemwidget: ModuleListItemWidget, newname: str, creating: bool = ...) -> str: ...
    def resizeEvent(self, event: QtGui.QResizeEvent) -> None: ...
    def createRightClickMenu(self) -> QtWidgets.QMenu: ...
    def onDisplayParameters(self) -> None: ...
    def onDisplaySettings(self, node: hou.OpNode | None) -> None: ...
    def onClicked(self) -> None: ...
    def onDisplayDetail(self, i: int) -> None: ...
    def onDisplayContextMenu(self, point: QtCore.QPoint) -> None: ...
    def onRightClickDelete(self) -> None: ...
    def onRightClickRename(self) -> None: ...
    def onRightClickExport(self) -> None: ...
    def getToggleWidgets(self) -> list[ModuleListItemWidget]: ...
    def lockAll(self, lock: bool) -> None: ...
    def displayAll(self, display: bool) -> None: ...
    def bypassAll(self, bypass: bool) -> None: ...
    def onClickBypass(self, toggle: bool) -> None: ...
    def onClickLock(self, toggle: bool) -> None: ...
    def onClickDisplay(self, toggle: bool) -> None: ...
    def updateAllDisplay(self) -> None: ...
    def updateAllLock(self) -> None: ...
    def updateAllBypass(self) -> None: ...
    def shouldToggleAllBypass(self) -> bool: ...
    def shouldToggleAllLock(self) -> bool: ...
    def shouldToggleAllDisplay(self) -> bool: ...
    def deleteAllModules(self) -> None: ...
    def reset(self) -> None: ...

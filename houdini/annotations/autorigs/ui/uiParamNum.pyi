from collections.abc import Callable, Iterable, Sequence
from typing import Unpack

import hou
from houtypes import NodeEventKwargs
from PySide6 import QtGui, QtWidgets

from autorigs.ui.uiParamLabelButton import UiParamLabelButton

class UiParamNum(QtWidgets.QWidget):
    SLIDER_RANGE_DEFAULT_MIN: int
    SLIDER_RANGE_DEFAULT_MAX: int
    SLIDER_DIV: int

    min: float
    max: float
    strictmin: bool
    strictmax: bool
    num_components: int
    slidermin: float
    slidermax: float
    params: list[QtWidgets.QLineEdit]
    label: str | None
    linkednodes: list[hou.OpNode]
    parmnames: Sequence[str]
    currentvalues: list[float]
    lockslider: bool
    ontextchangedfunctions: list[Callable[[list[float]], object]]
    onnodechangedfunctions: list[Callable[[list[float]], object]]
    labelbutton: UiParamLabelButton | None
    slider: "MySlider | None"
    defaults: Sequence[float]
    undo: hou.UndosGroup

    def __init__(
        self,
        label: str | None,
        num_components: int,
        defaults: Sequence[float] = ...,
        soft_range: tuple[float, float] = ...,
        parmnames: Sequence[str] | None = ...,
    ) -> None: ...
    def setupUI(self) -> None: ...
    def setToDefaults(self) -> None: ...
    def addOnTextChangedFunction(self, fcn: Callable[[list[float]], object]) -> None: ...
    def addOnNodeChangedFunction(self, fcn: Callable[[list[float]], object]) -> None: ...
    def setValues(self, values: float | Sequence[float]) -> None: ...
    def hasUnsavedChanges(self) -> bool: ...
    def markSaved(self) -> None: ...
    def setRange(self, min: float, max: float, bypass_strict: bool = ...) -> None: ...
    def getRange(self) -> tuple[float, float]: ...
    def setLabel(self, label: str) -> None: ...
    def setText(self, i: int, param: QtWidgets.QLineEdit, str_value: str, from_node: bool = ...) -> None: ...
    def linkParms(self, nodes: list[hou.OpNode], parmnames: Sequence[str]) -> None: ...
    def unlinkParms(self) -> None: ...
    def addNodes(self, nodes: Iterable[hou.OpNode]) -> None: ...
    def removeNodes(self, nodes: Iterable[hou.OpNode]) -> None: ...
    def insertNodes(self, nodes: Iterable[hou.OpNode], index: int = ...) -> None: ...
    def popNode(self, index: int | None = ...) -> hou.OpNode | None: ...
    def copyValues(self, item: str) -> None: ...
    def getValues(self) -> list[float]: ...
    def eval(self) -> list[float] | list[int] | None: ...
    def _createNewParam(self, component: int) -> QtWidgets.QLineEdit: ...
    def _onEditingFinished(self, parmindex: int) -> None: ...
    def _updateNodeParms(self, parmindex: int) -> None: ...
    def _updateSliderPosition(self, nodevalue: float) -> None: ...
    def _execOnTextChangedFunctions(self, newvalues: list[float]) -> None: ...
    def _onNodeChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def _execOnNodeChangedFunctions(self, newvalues: list[float]) -> None: ...
    def _onSliderPressed(self) -> None: ...
    def _onSliderReleased(self) -> None: ...
    def _onSliderChanged(self, value: int) -> None: ...
    def _convertSliderValueToTextValue(self, slidervalue: float) -> str | None: ...
    def _convertTextValueToSliderValue(self, textvalue: str) -> float | str | None: ...
    def _convertNodeValueToSliderValue(self, nodevalue: float) -> float | None: ...
    def _convertNodeValueToTextValue(self, nodevalue: float) -> str | None: ...
    def _convertTextValueToNodeValue(self, textvalue: str) -> float | None: ...
    def _convertSliderValueToNodeValue(self, slidervalue: float) -> float | None: ...
    def hideSlider(self) -> None: ...
    def abs(self, value: float) -> float: ...
    def createToolTip(
        self, parmnames: Sequence[str], label: str, labelbutton: QtWidgets.QWidget, description: str = ...
    ) -> None: ...

class MySlider(QtWidgets.QSlider):
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...

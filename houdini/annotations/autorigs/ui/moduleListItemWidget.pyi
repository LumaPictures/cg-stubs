def createToolButton(parent: QtWidgets.QWidget, tooltip: str, qticonpath: str) -> QtWidgets.QPushButton: ...

class TopAllItem(QtWidgets.QWidget):
    moduleChanged: QtCore.Signal
    modulelist: UiModuleList
    autorigs_asset: AutoRigsAsset
    charactertab: UiCharacterTab
    assetsettings: QtWidgets.QPushButton
    geo_display: QtWidgets.QPushButton
    bypass_all: QtWidgets.QPushButton
    lock_all: QtWidgets.QPushButton
    display_all: QtWidgets.QPushButton
    settingsdialog: UiCharacterSettings

    def __init__(self, modulelist: UiModuleList, autorigs_asset: AutoRigsAsset, charactertab: UiCharacterTab) -> None: ...
    def geoDisplay(self, toggle: bool) -> None: ...
    def bypassAll(self, toggle: bool) -> None: ...
    def lockAll(self, toggle: bool) -> None: ...
    def displayAll(self, toggle: bool) -> None: ...
    def setBypassAllWithoutTrigger(self, toggle: bool) -> None: ...
    def setLockAllWithoutTrigger(self, toggle: bool) -> None: ...
    def setDisplayAllWithoutTrigger(self, toggle: bool) -> None: ...

class ModuleListItemWidget(QtWidgets.QWidget):
    autorig_module: Module
    has_bypass: bool
    mutebutton: QtWidgets.QPushButton | None
    lockbutton: QtWidgets.QPushButton
    displaybutton: QtWidgets.QPushButton
    listname: "ItemWidgetLabel"

    def __init__(self) -> None: ...
    def createListItem(self, autorig_module: Module, has_bypass: bool = ...) -> None: ...
    def getModuleName(self) -> str: ...
    def getModuleType(self) -> str: ...
    def getModuleNode(self) -> hou.ObjNode | None: ...
    def rename(self, name: str) -> None: ...
    def setCallbacks(self, bypass: Callable[[bool], object], lock: Callable[[bool], object], display: Callable[[bool], object]) -> None: ...
    def setBypass(self, toggle: bool) -> None: ...
    def setLock(self, toggle: bool) -> None: ...
    def setDisplay(self, toggle: bool) -> None: ...
    def getBypass(self) -> bool | None: ...
    def getLock(self) -> bool: ...
    def getDisplay(self) -> bool: ...
    def toJSON(self) -> _ModuleJsonWithNode: ...
    def fromJSON(self, json: _ModuleJson) -> NoReturn: ...

class ItemWidgetLabel(QtWidgets.QLabel):
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...

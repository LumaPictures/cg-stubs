from collections.abc import Iterable, Sequence

import hou
from PySide6 import QtWidgets

from autorigs.ui.uiParamFloat import UiParamFloat

class UiParamColor(QtWidgets.QWidget):
    NUM_FLOAT_COMPONENTS: int
    R: str
    G: str
    B: str

    currentvalues: list[float]
    defaultvalues: list[float]
    colordialog: QtWidgets.QColorDialog
    colorbutton: QtWidgets.QPushButton
    colorfloats: UiParamFloat
    label: str
    linkednodes: list[hou.OpNode] | None
    parmprefix: str | None

    def __init__(self, label: str, parmnames: Sequence[str] | None = ...) -> None: ...
    def createColorButton(self) -> QtWidgets.QPushButton: ...
    def showColorDialog(self) -> None: ...
    def setColorButton(self, color: Sequence[float]) -> None: ...
    def linkParmTuple(self, nodes: list[hou.OpNode], colorprefix: Sequence[str]) -> None: ...
    def addNodes(self, nodes: Iterable[hou.OpNode]) -> None: ...
    def removeNodes(self, nodes: Iterable[hou.OpNode]) -> None: ...
    def getValues(self) -> list[float]: ...
    def setValues(self, values: Sequence[float]) -> None: ...
    def insertNodes(self, nodes: Iterable[hou.OpNode], index: int = ...) -> None: ...
    def popNode(self, index: int | None = ...) -> hou.OpNode | None: ...
    def unlinkParms(self) -> None: ...
    def onNodeChange(self, channels: Sequence[float]) -> None: ...
    def createToolTip(
        self, parmnames: Sequence[str], label: str, labelbutton: QtWidgets.QWidget, description: str = ...
    ) -> None: ...

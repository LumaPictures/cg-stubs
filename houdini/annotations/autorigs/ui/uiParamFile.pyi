from collections.abc import Callable, Sequence

import hou
from PySide6 import QtCore, QtGui, QtWidgets

from autorigs.ui.uiParamLabelButton import UiParamLabelButton

class UiParamFile(QtWidgets.QWidget):
    defaulttext: str
    currenttext: str
    filepatternlist: list[str]
    file_extension: str
    stringwidget: QtWidgets.QLineEdit
    filechooserwidget: hou.qt.FileChooserButton

    def __init__(
        self,
        label: str | None,
        default_text: str = ...,
        file_dialog: str = ...,
        file_pattern: str = ...,
        file_type: hou.EnumValue[hou.fileType] | None = ...,
        file_extension: str = ...,
    ) -> None: ...
    def fileHasCorrectPattern(self, filepath: str) -> bool: ...
    def getText(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def setOnTextChanged(self, fcn: Callable[[str], object]) -> None: ...

class UiParamFileIcon(UiParamFile):
    icon_preview: QtWidgets.QLabel
    icon_default: QtGui.QIcon | None
    linkednode: hou.OpNode | None

    def __init__(
        self,
        label: str | None,
        default_text: str = ...,
        file_dialog: str = ...,
        file_pattern: str = ...,
        file_type: hou.EnumValue[hou.fileType] | None = ...,
        icon_default: QtGui.QIcon | None = ...,
    ) -> None: ...
    def setText(self, path: str) -> None: ...
    def linkNode(self, node: hou.OpNode) -> None: ...

class UiParamGeoOperator(QtWidgets.QWidget):
    FORM_LAYOUT: int
    BOX_LAYOUT: int

    operator_selector: "UiParamOperator"
    group_dropdown: "GroupDropdown"
    object_label: QtWidgets.QLabel
    group_label: QtWidgets.QLabel
    group_layout: QtWidgets.QHBoxLayout
    onSelectionChangedCallbacks: list[Callable[[], object]]

    def __init__(self, object_label: str = ..., group_label: str = ..., filter_type: hou.EnumValue[hou.nodeTypeFilter] = ...) -> None: ...
    def addOnSelectionChanged(self, fcn: Callable[[], object]) -> None: ...
    def hideOperator(self) -> None: ...
    def showOperator(self) -> None: ...
    def getOperator(self) -> str: ...
    def setOperator(self, operator: str) -> None: ...
    def getGroup(self) -> str: ...
    def setGroup(self, group: str) -> None: ...
    def repopulate(self) -> None: ...

class UiParamOperator(QtWidgets.QWidget):
    Q_LABEL_TYPE: int
    LABEL_BUTTON_TYPE: int

    nodeChanged: QtCore.Signal

    linkednode: hou.OpNode | None
    relativenode: hou.OpNode | None
    labelwidget: QtWidgets.QLabel | UiParamLabelButton
    stringwidget: QtWidgets.QLineEdit
    operatorchooser: hou.qt.NodeChooserButton
    chosennode: hou.OpNode | None
    parmname: str

    def __init__(
        self,
        label: str | None,
        default_operator: str = ...,
        filter_type: hou.EnumValue[hou.nodeTypeFilter] = ...,
        label_type: int = ...,
        relative_node: hou.OpNode | None = ...,
    ) -> None: ...
    def getPath(self, operator: hou.Node) -> str: ...
    def getOperatorNode(self) -> hou.OpNode | None: ...
    def getText(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def getLabel(self) -> str: ...
    def setLabel(self, label: str) -> None: ...
    def getRelativeNode(self) -> hou.OpNode | None: ...
    def setRelativeNode(self, node: hou.OpNode | None) -> None: ...
    def setOnTextChanged(self, fcn: Callable[[str], object]) -> None: ...
    def setOnEditingFinished(self, fcn: Callable[[str], object] | None) -> None: ...
    def linkParm(self, node: hou.OpNode, parmname: str) -> None: ...
    def addOperatorCallbacks(self, node: hou.OpNode) -> None: ...
    def removeOperatorCallbacks(self, node: hou.OpNode) -> None: ...
    def getValues(self) -> str: ...
    def eval(self) -> str: ...
    def setValues(self, values: str | Sequence[str]) -> None: ...
    def unlinkParms(self) -> None: ...

class GroupDropdown(QtWidgets.QComboBox):
    popup: QtCore.Signal

    def showPopup(self) -> None: ...

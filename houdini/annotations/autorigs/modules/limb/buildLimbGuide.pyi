import collections
from collections.abc import MutableMapping
from typing import Any

import hou

from autorigs.modules.base import buildBaseGuide
from autorigs.modules.limb.limbModule import _LimbModuleJson

class LimbFactory(buildBaseGuide.BaseFactory):
    @classmethod
    def createFromDefault(cls, json: _LimbModuleJson, assetnode: hou.ObjNode) -> "LimbGuide": ...

class LimbGuide(buildBaseGuide.BaseGuide[collections.OrderedDict[str, collections.OrderedDict[str, str]]]):
    SIDE_LEFT: int
    SIDE_RIGHT: int
    JSON_LABELS: dict[str, str]
    has_rotation_end: bool
    mirror: bool
    side: int
    assetnode: hou.ObjNode
    assetnodecontents: hou.ObjNode | None
    mainguides: list[str]
    mirrorguides: list[str]
    visiblemirrorguides: list[str]
    modulenode: hou.ObjNode | None
    masternode: hou.ObjNode | None
    guidenodesdata: dict[str, Any]
    deleteguides: list[hou.OpNode | None]

    def __init__(self, assetnode: hou.ObjNode) -> None: ...
    def existingFromJson(self, json: _LimbModuleJson) -> None: ...
    def createFromJson(self, json: _LimbModuleJson) -> None: ...
    def deleteGuides(self) -> None: ...
    def toJSON(self) -> collections.OrderedDict[str, collections.OrderedDict[str, str]]: ...
    def toJsonGuideTypeNames(self, jsonobj: MutableMapping[str, str], ismain: bool) -> None: ...
    def toJsonGuidenames(self, jsonobj: MutableMapping[str, str], ismain: bool) -> None: ...
    def updateMirror(self, toggle: bool) -> None: ...
    def updateSide(self, side: int) -> None: ...
    def setMirrorGuidesDisplay(self, canchangedisplay: bool) -> None: ...
    def toggleMirrorGuidesDisplay(self, toggle: bool) -> None: ...
    def toggleMainGuidesDisplay(self, toggle: bool) -> None: ...
    def toggleGuideDisplay(self, toggle: bool) -> None: ...
    def getGuideObject(self, guidename: str) -> hou.OpNode | None: ...
    def getGuideObjectSide(self, mainbool: bool, guidepart: str) -> hou.OpNode | None: ...
    def updateToMasterParent(self, masternode: hou.OpNode) -> None: ...
    def updateToSpineHookParent(self, spinenode: hou.OpNode) -> None: ...

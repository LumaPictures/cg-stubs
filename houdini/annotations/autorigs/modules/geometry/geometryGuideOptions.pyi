from typing import ClassVar, TypedDict

import hou
from PySide6 import QtCore, QtWidgets
from autorigs.modules.base.autoRigsBaseWidget import BaseOptionsWidget
from autorigs.modules.geometry.buildGeometryGuide import GeometryGuide
from autorigs.modules.geometry.geometryGuideModel import GeometryGuideModel
from autorigs.ui.uiParamFile import UiParamGeoOperator

class _GeometryOptionsJson(TypedDict):
    geometry: bool
    operator: str
    group: str

class ModuleOptionsWidget(BaseOptionsWidget[_GeometryOptionsJson, GeometryGuideModel]):
    operatorToggled: ClassVar[QtCore.Signal]
    buildguide: GeometryGuide
    default_operator_node: hou.OpNode | None
    geo_widget: UiParamGeoOperator
    geo_toggle: QtWidgets.QCheckBox
    previous_operator: str
    def __init__(
        self,
        buildguide: GeometryGuide,
        model: GeometryGuideModel,
        object_label: str,
        group_label: str,
        default_operator_node: hou.OpNode | None = ...,
    ) -> None: ...
    def updateGeoOptions(self, value: bool) -> None: ...
    def getGroup(self) -> str: ...
    def setGroup(self, group: str) -> None: ...
    def getOperator(self) -> str: ...
    def setOperator(self, operator: str) -> None: ...
    def hideOperator(self) -> None: ...
    def showOperator(self) -> None: ...
    def hideToggle(self) -> None: ...
    def showToggle(self) -> None: ...
    def setToggle(self, toggle: bool) -> None: ...
    def fromJSON(self, json: _GeometryOptionsJson) -> None: ...
    def toJSON(self) -> _GeometryOptionsJson: ...
    def changeFormLayout(self, formlayout: QtWidgets.QFormLayout) -> None: ...

from collections.abc import Callable
from typing import Any

from autorigs.modules.base.baseGuideModel import BaseGuideModel
from autorigs.modules.basicFace.eye.eyeGuideModel import EyeGuideModel
from autorigs.modules.jaw.jawGuideModel import JawGuideModel

class BasicFaceGuideModel(BaseGuideModel):
    eye_model: EyeGuideModel
    jaw_model: JawGuideModel
    def __init__(self) -> None: ...
    def setParent(self, parent: object) -> None: ...
    def getParent(self) -> Any: ...
    def getEyeModel(self) -> EyeGuideModel: ...
    def getJawModel(self) -> JawGuideModel: ...
    def setEyeToggled(self, value: bool) -> None: ...
    def setJawToggled(self, value: bool) -> None: ...
    def isEyeToggled(self) -> bool: ...
    def isJawToggled(self) -> bool: ...
    def addOnJawToggledCallbacks(self, fxn: Callable[[bool], object]) -> None: ...
    def addOnEyeToggledCallbacks(self, fxn: Callable[[bool], object]) -> None: ...

from collections.abc import Iterable, Mapping, MutableMapping
from typing import Any, Generic, Literal, NotRequired, TypeAlias, TypedDict

from typing_extensions import TypeVar

import hou
from autorigs.asset.autoRigsAsset import AutoRigsAsset
from autorigs.asset.geometry.buildGeometryGuide import GeometryGuide
from autorigs.modules.base import buildBaseGuide

_GuideData: TypeAlias = list[Any] | tuple[hou.OpNode, bool, bool]

class _LipPartJson(TypedDict):
    guidenames: Mapping[str, str]
    ctrl_keys: list[str]
    points: list[int]

_PartJson = TypeVar("_PartJson", bound=_LipPartJson, default=_LipPartJson)

# A lip guide's JSON, with its lower and upper parts' (an eye side's parts add the mirror side's).
class _LipGuideJson(TypedDict, Generic[_PartJson]):
    guidenames: Mapping[str, str]
    lower: NotRequired[_PartJson]
    upper: NotRequired[_PartJson]

# The eye's sides and lids are lip guides and parts with more JSON (EyeGuideSide, EyeGuidePart).
_SideJson = TypeVar("_SideJson", bound=_LipGuideJson[Any], default=_LipGuideJson)
_Part = TypeVar("_Part", bound="LipGuidePart[Any]", default="LipGuidePart")

class LipGuide(buildBaseGuide.BaseGuide[_SideJson], Generic[_SideJson, _Part]):
    BUILD_ERROR_MSG: str
    ROOT: str
    LIP_PREFIX: list[str]
    autorigs_asset: AutoRigsAsset
    assetnode: hou.ObjNode
    geometryguides: GeometryGuide
    prefix: str | None
    lower_lid: _Part
    upper_lid: _Part

    def __init__(self, autorigs_asset: AutoRigsAsset, geometryguides: GeometryGuide, prefix: str | None = ...) -> None: ...
    # Creates LipGuideParts; EyeGuideSide overrides it with its EyeGuideParts.
    def createSubguides(self: "LipGuide[_LipGuideJson, LipGuidePart]") -> None: ...
    def buildLowerLid(self, numctrls: int) -> bool: ...
    def buildUpperLid(self, numctrls: int) -> bool: ...
    def updateCtrls(self, value: int) -> None: ...
    def buildFromJsonNew(self, json: _SideJson, parent: hou.OpNode | None = ...) -> hou.OpNode: ...
    def buildFromJsonExisting(self, json: _SideJson) -> None: ...
    def toJSON(self) -> _SideJson: ...
    def resnapGuides(self) -> None: ...
    def getGeometryGuide(self) -> GeometryGuide: ...
    def getLowerLid(self) -> _Part: ...
    def getUpperLid(self) -> _Part: ...
    def getMaxLocNum(self) -> int: ...
    def toggleModule(self, toggle: bool) -> None: ...
    def updateSticky(self, toggle: bool | int) -> None: ...
    def updateError(self) -> None: ...
    def deleteGuides(self) -> None: ...

class LipGuidePart(buildBaseGuide.BaseGuide[_PartJson], Generic[_PartJson]):
    GUIDE_CURVE: str
    CONTROL_ROOT: str
    SHORTEST_PATH: str
    CTRL_SWITCH: str
    CTRL_CURVE_OUT: str
    NCTRL_CURVE_OUT: str
    POINTS_GROUP: str
    OBJECT_MERGE: str
    CONTROL: str
    GUIDENAMES: dict[str, str]
    POINTS_GROUP_NAME: str
    autorigs_asset: AutoRigsAsset
    assetnode: hou.ObjNode
    geometryguides: GeometryGuide
    prefix: str
    point_nums: list[int]
    ctrl_guides_keys: list[str]
    parent: hou.OpNode
    guidenodesdata: dict[str, _GuideData]

    def __init__(self, autorigs_asset: AutoRigsAsset, prefix: str, geometryguides: GeometryGuide) -> None: ...
    def buildFromJsonNew(self, json: _PartJson, parent: hou.OpNode | None = ...) -> None: ...
    def buildFromJsonExisting(self, json: _PartJson) -> None: ...
    def updateCtrls(self, value: int) -> None: ...
    def renameGuides(self, json: _PartJson) -> None: ...
    def generateLid(self, numctrls: int) -> bool: ...
    def buildCurveNetwork(
        self,
        numctrls: int,
        nodesdata: MutableMapping[str, _GuideData],
        guidenames: Mapping[str, str],
        points: Iterable[int],
    ) -> None: ...
    def selectPoints(self) -> list[int]: ...
    def resetLid(self, numctrls: int) -> Literal[False] | None: ...
    def destroyControlGuides(self) -> None: ...
    def generateControlGuides(self, numctrls: int) -> None: ...
    def setControlRootExpressions(self, node: hou.OpNode) -> None: ...
    def resnapControlGuides(self) -> None: ...
    def setGuidePosition(self, guide: hou.ObjNode, point: hou.Point, bounding_z: float) -> None: ...
    def isBuilt(self) -> bool: ...
    def getControlKeys(self) -> list[str]: ...
    def getControlGuides(self) -> list[hou.ObjNode]: ...
    def getPoints(self) -> list[int]: ...
    def getLocNum(self) -> int: ...
    def getParent(self) -> hou.OpNode: ...
    def setParent(self, parent: hou.OpNode) -> None: ...
    def toJSON(self) -> _PartJson: ...

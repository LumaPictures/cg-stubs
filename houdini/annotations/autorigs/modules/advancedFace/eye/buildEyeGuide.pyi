from collections.abc import Mapping
from typing import Any, NotRequired, TypeAlias, TypedDict, Unpack

import hou
from autorigs.asset.autoRigsAsset import AutoRigsAsset
from autorigs.asset.geometry.buildGeometryGuide import GeometryGuide
from autorigs.modules.advancedFace.lip import buildLipGuide
from autorigs.modules.base import buildBaseGuide
from autorigs.modules.advancedFace.lip.buildLipGuide import _LipGuideJson, _LipPartJson

_GuideData: TypeAlias = list[Any] | tuple[hou.OpNode, bool, bool]

class _EyePartJson(_LipPartJson):
    mirror_guidenames: Mapping[str, str]
    mirror_ctrl_keys: list[str]

class _EyeSideJson(_LipGuideJson[_EyePartJson]):
    mirror_guidenames: Mapping[str, str]

class _EyeGuideJson(TypedDict):
    guidenames: Mapping[str, str]
    main: _EyeSideJson
    secondary: _EyeSideJson

class _LipGuideKwargs(TypedDict, total=False):
    prefix: str | None

class EyeGuide(buildBaseGuide.BaseGuide[_EyeGuideJson]):
    MAIN_PREFIX: str
    SECONDARY_PREFIX: str
    EYE_ROOT: str
    autorigs_asset: AutoRigsAsset
    assetnode: hou.ObjNode
    geometryguides: GeometryGuide
    main_side: "EyeGuideSide"
    secondary_side: "EyeGuideSide"
    toggle: bool

    def __init__(self, autorigs_asset: AutoRigsAsset, geometryguides: GeometryGuide) -> None: ...
    def getMainSide(self) -> "EyeGuideSide": ...
    def getSecondarySide(self) -> "EyeGuideSide": ...
    def getSideGuide(self, key: str, ismain: bool = ...) -> hou.ObjNode | None: ...
    def buildFromJsonNew(self, json: _EyeGuideJson, parent: hou.OpNode | None = ...) -> None: ...
    def buildFromJsonExisting(self, json: _EyeGuideJson) -> None: ...
    def updateSticky(self, value: bool | int) -> None: ...
    def updateMirror(self, value: bool) -> None: ...
    def updateCtrls(self, value: int) -> None: ...
    def updateSide(self, value: int) -> None: ...
    def getMaxLocNum(self) -> int: ...
    def getPoints(self, ismain: bool, part: int) -> list[int] | tuple[int, ...]: ...
    def getControlGuides(self, ismain: bool, part: int) -> list[hou.ObjNode]: ...
    def toJSON(self) -> _EyeGuideJson: ...
    def toggleModule(self, toggle: bool) -> None: ...
    def getGeometryGuide(self) -> GeometryGuide: ...
    def snapEyeToGeometry(self, side: int, node: hou.ObjNode, geo: hou.Geometry, primgrp: str | None = ...) -> None: ...

class EyeGuideSide(buildLipGuide.LipGuide[_EyeSideJson, "EyeGuidePart"]):
    BUILD_ERROR_MSG: str
    ROOT: str
    CENTER_GUIDE: str
    LOOKAT_GUIDECURVE: str
    LOOKAT: str
    LID_PREFIX: list[str]
    mguidenodesdata: dict[str, list[Any]]

    def __init__(
        self, *args: Unpack[tuple[AutoRigsAsset, GeometryGuide]], **kwargs: Unpack[_LipGuideKwargs]
    ) -> None: ...
    def createSubguides(self) -> None: ...
    def buildFromJsonNew(self, json: _EyeSideJson, parent: hou.OpNode | None = ...) -> None: ...
    def buildFromJsonExisting(self, json: _EyeSideJson) -> None: ...
    def toJSON(self) -> _EyeSideJson: ...
    def showGuides(self, display: bool) -> None: ...
    def getGuideObject(self, guidename: str, ismain: bool = ...) -> hou.ObjNode | None: ...
    def deleteGuides(self) -> None: ...
    def updateMirror(self, value: bool) -> None: ...
    def updateSide(self, value: int) -> None: ...
    def getPoints(self, ismain: bool, part: int) -> list[int] | tuple[int, ...]: ...
    def getControlGuides(self, ismain: bool, part: int) -> list[hou.ObjNode]: ...
    def snapEyeToGeometry(self, node: hou.ObjNode, geo: hou.Geometry, primgrp: str | None = ...) -> None: ...

class EyeGuidePart(buildLipGuide.LipGuidePart[_EyePartJson]):
    GUIDE_CURVE: str
    CONTROL_ROOT: str
    SHORTEST_PATH: str
    CTRL_SWITCH: str
    CTRL_CURVE_OUT: str
    NCTRL_CURVE_OUT: str
    POINTS_GROUP: str
    OBJECT_MERGE: str
    MIRROR_POINTS: str
    CONTROL: str
    GUIDENAMES: dict[str, str]
    MGUIDENAMES: dict[str, str]
    point_nums: list[int]
    ctrl_guides_keys: list[str]
    display: bool
    mirror_point_nums: list[int]
    mirror_ctrl_guides_keys: list[str]
    mguidenodesdata: dict[str, _GuideData]

    def __init__(self, autorigs_asset: AutoRigsAsset, prefix: str, geometryguides: GeometryGuide) -> None: ...
    def buildFromJsonNew(self, json: _EyePartJson) -> None: ...
    def buildFromJsonExisting(self, json: _EyePartJson) -> None: ...
    def renameGuides(self, json: _EyePartJson) -> None: ...
    def updateMirror(self, value: bool) -> None: ...
    def updateSide(self, value: int) -> None: ...
    def updateCtrls(self, value: int) -> None: ...
    def getGuideObject(self, guidename: str, ismain: bool = ...) -> hou.OpNode | None: ...
    def removeGuideObject(self, guidename: str, ismain: bool = ...) -> hou.OpNode | None: ...
    def deleteGuides(self) -> None: ...
    def displayGuides(self, display: bool) -> None: ...
    def lockGuides(self, lock: bool) -> None: ...
    def generateLid(self, numctrls: int) -> bool: ...
    def generateNodes(self, numctrls: int) -> None: ...
    def createMirrorPointsNetwork(self) -> None: ...
    def setMirrorExpressions(self) -> None: ...
    def getMirrorPoints(self) -> tuple[int, ...]: ...
    def destroyControlGuides(self, ismain: bool = ...) -> None: ...
    def generateControlGuides(self, numctrls: int) -> None: ...
    def generateMirrorControlGuides(self, numctrls: int) -> None: ...
    def getLocNum(self) -> int: ...
    def getMirrorControlGuides(self) -> list[hou.ObjNode]: ...
    def resnapControlGuides(self) -> None: ...
    def resnapControlGuidesSide(self, ismain: bool = ...) -> None: ...
    def toJSON(self) -> _EyePartJson: ...

from collections.abc import Mapping, Sequence
from typing import Literal

import hou
from autorigs.modules.advancedFace.eye.buildEyeGuide import EyeGuide
from autorigs.modules.advancedFace.eye.eyeGuideModel import EyeGuideModel
from autorigs.modules.advancedFace.lip.autoRigsLipBuilder import AutoRigsLipBuilder
from autorigs.modules.base.autoRigsBaseBuilder import BuilderGroup

class AutoRigsEyeBuilder(AutoRigsLipBuilder[EyeGuide, EyeGuideModel]):
    NODES: dict[str, tuple[str]]
    INTERFACE: dict[str, tuple[str, str] | tuple[str, str, list[str]]]
    LEFT_PREFIX: str
    RIGHT_PREFIX: str
    STICK_KEY: str
    STICK_SUFFIX: str
    stick_keys: list[str]
    left_group: "SideGroup"
    right_group: "SideGroup"
    master_lookat: hou.ObjNode
    main_group: BuilderGroup
    parent: hou.ObjNode | None

    def updateDicts(self) -> None: ...
    def createGroups(self) -> None: ...
    def createFolderTemplate(self) -> hou.FolderParmTemplate: ...
    def createSideFolderTemplate(self, side_group: "SideGroup", ismain: bool) -> hou.FolderParmTemplate: ...
    def createUpperFolder(self, side_group: "SideGroup") -> hou.FolderParmTemplate: ...
    def createLowerFolder(self, side_group: "SideGroup") -> hou.FolderParmTemplate: ...
    def buildRigControls(self) -> None: ...
    def buildRigControlsSide(self, side_group: "SideGroup", ismain: bool) -> None: ...
    def createEyeGeo(self, side_group: "SideGroup", geo_path: str, grp_path: str, mirror: bool = ...) -> hou.ObjNode: ...
    def buildUpperLid(self, side_group: "SideGroup", ismain: bool) -> None: ...
    def buildLowerLid(self, side_group: "SideGroup", ismain: bool) -> None: ...
    def buildLid(
        self,
        point_nums: Sequence[int],
        ctrl_guides: Sequence[hou.ObjNode],
        side_group: "SideGroup",
        group: BuilderGroup,
        lpc_group_name: str,
    ) -> None: ...
    def makeSticky(self, prefix: str, side_group: "SideGroup", group: BuilderGroup, network: hou.OpNode) -> None: ...
    def makeAverageLine(self, side_group: "SideGroup", group: BuilderGroup, network: hou.OpNode) -> None: ...
    def makeStickyNetwork(self, prefix: str, side_group: "SideGroup", group: BuilderGroup, network: hou.OpNode) -> None: ...
    def onCaptureCompleted(self) -> None: ...
    def onCaptureCompletedSide(self, ismain: bool, side_group: "SideGroup") -> None: ...
    def getParent(self) -> hou.ObjNode | None: ...
    def setParent(self, parent: hou.ObjNode | None) -> None: ...
    def getSideGroup(self, ismain: bool) -> "SideGroup": ...
    def getSide(self, ismain: bool) -> int: ...
    def hasValidEyeGeo(self, operator: str, group: str) -> bool | int | str: ...
    def isUpper(self, prefix: str) -> tuple[Literal[False], Literal["Lower"]] | tuple[Literal[True], Literal["Upper"]]: ...

class SideGroup:
    UPPER_PREFIX: str
    LOWER_PREFIX: str
    main_group: BuilderGroup
    upper_group: BuilderGroup
    lower_group: BuilderGroup
    upper_lpc: str
    lower_lpc: str

    def __init__(
        self,
        assetnode: hou.ObjNode,
        prefix: str,
        group_prefix: str,
        nodes: Mapping[str, tuple[str]],
        interface: Mapping[str, tuple[str, str] | tuple[str, str, list[str]]],
        upper_lpc_name: str,
        lower_lpc_name: str,
    ) -> None: ...
    def getMainGroup(self) -> BuilderGroup: ...
    def getLowerGroup(self) -> BuilderGroup: ...
    def getUpperGroup(self) -> BuilderGroup: ...
    def getUpperLPCName(self) -> str: ...
    def getLowerLPCName(self) -> str: ...
    def getGroups(self) -> list[BuilderGroup]: ...

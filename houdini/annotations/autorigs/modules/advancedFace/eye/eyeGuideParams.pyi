    def toJSON(self) -> _ParamsJson: ...
    def fromJSON(self, json: _ParamsJson) -> None: ...
    def unlinkAllNodes(self) -> None: ...

class ModuleParamsWidgetSide(lipGuideParams.ModuleParamsWidget[EyeGuideSide, EyeGuideModel]):

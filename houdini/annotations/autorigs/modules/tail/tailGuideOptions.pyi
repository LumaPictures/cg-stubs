from collections import OrderedDict
from collections.abc import Iterable, Sequence
from typing import TypedDict

import hou
from PySide6 import QtWidgets

from autorigs.modules.base.rootModule import Module
from autorigs.modules.master.masterModule import MasterModule
from autorigs.modules.spine.spineModule import SpineModule
from autorigs.modules.tail.buildTailGuide import TailGuide
from autorigs.ui.uiParentComboMenu import UiParentComboMenu

class _TailOptionsJson(TypedDict):
    parent: Sequence[str]
    custom_tailbones: bool
    num_tailbones: str

class ModuleOptions(QtWidgets.QWidget):
    button_size: int
    HOOK_BUTTON_WIDTH: int
    HOOK_BUTTON_HEIGHT: int
    PARENT_LABEL: str
    tailguide: TailGuide
    mainlayout: QtWidgets.QVBoxLayout
    widgets: list[QtWidgets.QWidget]
    mastermodule: MasterModule
    parentwidget: UiParentComboMenu
    nbones_toggle: QtWidgets.QCheckBox
    nbones_lineedit: QtWidgets.QLineEdit
    nbones_hbox: QtWidgets.QHBoxLayout
    def __init__(self, tailguide: TailGuide, spinemodules: Iterable[SpineModule], mastermodule: MasterModule) -> None: ...
    def getBuiltParentInfo(self) -> tuple[MasterModule | SpineModule, hou.ObjNode]: ...
    def getExistingParents(self, spinemodules: Iterable[SpineModule]) -> list[tuple[MasterModule | SpineModule, list[hou.OpNode | None]]]: ...
    def updateParentModules(self, spinemodules: Iterable[SpineModule]) -> None: ...
    def updateParent(self, parentmodule: Module, node: hou.ObjNode) -> None: ...
    def getMasterParentGuides(self, mastermodule: MasterModule) -> list[hou.ObjNode | None]: ...
    def getSpineParentGuides(self, spinemodule: SpineModule) -> list[hou.OpNode | None]: ...
    def unlinkAllNodes(self) -> None: ...
    def getDefaultParentPath(self) -> str: ...
    def getAllWidgets(self) -> list[QtWidgets.QWidget]: ...
    def toJSON(self) -> OrderedDict[str, tuple[str, str, str] | bool | str]: ...
    def fromJSON(self, json: _TailOptionsJson) -> bool: ...
    def createParentWidget(self, spinemodules: Iterable[SpineModule]) -> UiParentComboMenu: ...
    def setOptions(self) -> None: ...
    def getMainLayout(self) -> QtWidgets.QVBoxLayout: ...
    def setBoneNumber(self, toggle: bool) -> None: ...
    def onTextFieldFinishedEditing(self) -> None: ...
    def isStretched(self) -> bool: ...
    def getUseBones(self) -> bool: ...
    def getNumBones(self) -> int: ...

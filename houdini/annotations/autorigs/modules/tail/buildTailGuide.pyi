from collections import OrderedDict

import hou

from autorigs.modules.base import buildBaseGuide
from autorigs.modules.base.buildBaseGuide import _GuideNamesJson
from autorigs.modules.tail.tailGuideParams import _TailParamsJson
from autorigs.modules.tail.tailModule import _TailModuleJson

class TailGuide(buildBaseGuide.BaseGuide[OrderedDict[str, OrderedDict[str, str]]]):
    JSON_LABEL: dict[str, str]
    parent: hou.OpNode | None
    assetnode: hou.ObjNode
    tailroot: hou.ObjNode
    guidenodesdata: dict[str, tuple[hou.OpNode, bool, bool]]
    def __init__(self, assetnode: hou.ObjNode, parent: hou.OpNode | None = ...) -> None: ...
    def updateToMasterParent(self, masternode: hou.ObjNode) -> None: ...
    def updateToSpineHookParent(self, spinenode: hou.ObjNode) -> None: ...
    def existingFromJson(self, json: _GuideNamesJson) -> None: ...
    def createFromJson(self, json: _GuideNamesJson, paramjson: _TailParamsJson) -> None: ...
    def toJSON(self) -> OrderedDict[str, OrderedDict[str, str]]: ...
    def deleteGuides(self) -> None: ...
    def updateParent(self, parenttext: str) -> None: ...
    def getChosenParentNode(self) -> str | None: ...
    def getGuideObject(self, guidename: str) -> hou.OpNode | None: ...

class TailFactory(buildBaseGuide.BaseFactory):
    @classmethod
    def createFromDefault(cls, json: _TailModuleJson, assetnode: hou.ObjNode, parent: hou.OpNode | None = ...) -> TailGuide: ...
    @classmethod
    def createFromJsonNew(cls, json: _TailModuleJson, assetnode: hou.ObjNode, parent: hou.OpNode | None = ...) -> TailGuide: ...
    @classmethod
    def createFromJsonExisting(cls, json: _TailModuleJson, assetnode: hou.ObjNode, parent: hou.OpNode | None = ...) -> TailGuide: ...

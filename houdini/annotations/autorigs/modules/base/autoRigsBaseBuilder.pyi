    def createNode(self, node_type: str, key: str, name: str = ..., network: hou.OpNode | None = ..., node: hou.OpNode | None = ...) -> hou.OpNode: ...
    def createBone(self, key: str, name: str = ..., deform: bool = ..., node: hou.ObjNode | None = ...) -> hou.ObjNode: ...
    def getNodeName(self, name: str) -> str: ...
    def getNode(self, key: str) -> hou.OpNode: ...

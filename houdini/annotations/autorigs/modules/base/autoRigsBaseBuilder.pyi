from collections.abc import Mapping, Sequence, Iterable
from typing import Any, Generic, TypeAlias, TypedDict

from typing_extensions import TypeVar

import hou

from autorigs.asset.autoRigsAsset import AutoRigsAsset
from autorigs.modules.base.baseGuideModel import BaseGuideModel
from autorigs.modules.base.buildBaseGuide import BaseGuide
from autorigs.modules.base.rootModule import Module
from autorigs.modules.geometry.autoRigsGeoBuilder import AutoRigsGeoBuilder

_PT = TypeVar("_PT", bound=hou.ParmTemplate)
_InterfaceEntry: TypeAlias = tuple[str, str] | tuple[str, str, list[str]]
# The keyword arguments of AutoRigsBaseBuilder.__init__, for the subclasses that forward them.
class _BuilderKwargs(TypedDict, total=False):
    prefix: str
    parent: hou.ObjNode | None
    geo_builder: AutoRigsGeoBuilder | None

# Each builder builds from its own module's guide and model; a bare builder is any module's.
_Guide = TypeVar("_Guide", bound=BaseGuide, default=Any)
_Model = TypeVar("_Model", bound=BaseGuideModel | None, default=Any)

class AutoRigsBaseBuilder(Generic[_Guide, _Model]):
    NODEGROUP: str
    BONEGROUP: str
    CONTROLGROUP: str
    VISIBLENODEGROUP: str
    NODES: dict[str, tuple[str]]
    INTERFACE: dict[str, _InterfaceEntry]
    index: int
    modulename: str
    moduletype: str
    autorigs_asset: AutoRigsAsset
    assetnode: hou.ObjNode
    buildguide: _Guide
    model: _Model
    parentinfo: tuple[Module, hou.OpNode]
    prefix: str
    parent: hou.ObjNode | None
    geo_builder: AutoRigsGeoBuilder | None
    nodesdatagroups: list["BuilderGroup"]
    interface_dict: dict[str, tuple[str, str]]
    main_group: "BuilderGroup"
    def __init__(self, index: int, modulename: str, moduletype: str, autorigs_asset: AutoRigsAsset, buildguide: _Guide, model: _Model, parentinfo: tuple[Module, hou.OpNode], prefix: str = ..., parent: hou.ObjNode | None = ..., geo_builder: AutoRigsGeoBuilder | None = ...) -> None: ...
    def buildRig(self) -> None: ...
    def addToNodesDict(self, key: str, name: str) -> None: ...
    def addToInterfaceDict(self, key: str, name: str, label: str) -> None: ...
    def createGroups(self) -> None: ...
    def buildRigControls(self) -> None: ...
    def createFolderTemplate(self) -> hou.FolderParmTemplate | None: ...
    def linkRigInterfaceParms(self) -> None: ...
    def createAllNodeGroups(self) -> None: ...
    def createNodeGroups(self, grp_idx: int = ...) -> None: ...
    def linkParm(self, node: hou.OpNode, parm_info: tuple[str, str, Iterable[str]]) -> None: ...
    def createParm(self, template_type: type[_PT], key: str, *args: Any, **kwargs: Any) -> _PT: ...
    def captureGeometry(self) -> None: ...
    def addBoneGroupToGeoSkin(self, group: hou.NodeGroup) -> None: ...
    def onCaptureCompleted(self) -> None: ...
    def createGroup(self, group_prefix: str, nodes_dict: Mapping[str, tuple[str]] | None = ..., interface_dict: Mapping[str, _InterfaceEntry] | None = ...) -> "BuilderGroup": ...
    def createRoot(self, key: str, name: str = ..., grp_idx: int = ..., node: hou.ObjNode | None = ...) -> hou.ObjNode: ...
    def createControl(self, key: str, name: str = ..., grp_idx: int = ..., node: hou.ObjNode | None = ...) -> hou.ObjNode: ...
    def createNode(self, node_type: str, key: str, name: str = ..., grp_idx: int = ..., network: hou.OpNode | None = ..., node: hou.OpNode | None = ...) -> hou.OpNode: ...
    def createBone(self, key: str, name: str = ..., deform: bool = ..., grp_idx: int = ..., node: hou.ObjNode | None = ...) -> hou.ObjNode: ...
    def createGeometry(self, key: str, name: str = ..., grp_idx: int = ..., node: hou.ObjNode | None = ...) -> hou.ObjNode: ...
    def setParent(self, node: hou.ObjNode | None) -> None: ...
    def getParent(self) -> hou.ObjNode | None: ...
    def getPrefix(self, index: int) -> str: ...
    def getNodeName(self, name: str) -> str: ...
    def getNode(self, key: str, grp_idx: int = ...) -> hou.OpNode: ...
    def getNodes(self, grp_idx: int = ...) -> dict[str, hou.OpNode]: ...
    def getControls(self, grp_idx: int = ...) -> list[hou.ObjNode]: ...
    def getBones(self, grp_idx: int = ...) -> list[hou.ObjNode]: ...
    def getDeformBones(self, grp_idx: int = ...) -> list[hou.ObjNode]: ...
    def getNodeGroups(self, grp_idx: int = ...) -> dict[str, hou.NodeGroup]: ...
    def getGroups(self) -> list["BuilderGroup"]: ...
    def getMainGroup(self) -> "BuilderGroup": ...
    def getGroup(self, grp_idx: int) -> "BuilderGroup": ...

class BuilderGroup:

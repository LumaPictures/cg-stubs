import re
from collections.abc import Callable, Iterable, Iterator
from typing import Any, NamedTuple, Protocol, TypeAlias

from houtypes import JSONLike

JsonValue: TypeAlias = (
    int | float | str | list["JsonValue"] | tuple["JsonValue", ...] | dict[str, "JsonValue"] | None
)
LexerFn: TypeAlias = Callable[[str, int], "tuple[Token, int] | None"]
_Operator: TypeAlias = Callable[[Any, Any], JsonValue]
_MatchKey: TypeAlias = str | int | float | None

class _PathMaker(Protocol):
    def __call__(self, *args: JsonPath) -> JsonPath: ...

class Token(NamedTuple):
    kind: Kind
    payload: str
    pos: int

ws_expr: re.Pattern[str]

def hashable(value: JsonValue) -> int | float | str | tuple[JsonValue, ...] | None: ...
def to_index(string: str) -> int: ...
def get_keys(value: JsonValue) -> list[JsonValue]: ...
def get_items(value: JsonValue) -> list[JsonValue]: ...
def regex_compare(expr: JsonValue, target: JsonValue) -> bool: ...
def lex_string_literal(text: str, pos: int) -> tuple[Token, int] | None: ...

token_exprs: dict[Kind, str | re.Pattern[str] | LexerFn]

def lex_token(text: str, pos: int) -> tuple[Token, int] | None: ...
def lex(text: str) -> list[Token]: ...

class Match(NamedTuple):
    value: JsonValue
    key: _MatchKey
    parents: tuple[Match, ...]
    name: str | None = ...
    env: dict[str, JsonValue] | None = ...
    debug: bool = ...
    debug_indent: int = ...
    @property
    def root(self) -> Match: ...
    def replace_value(self, value: JsonValue) -> Match: ...
    def push_parent(self, key: _MatchKey, value: JsonValue, name: str | None = ...) -> Match: ...
    def path(self) -> tuple[_MatchKey, ...]: ...
    def bindings(self) -> dict[str, JsonValue]: ...
    def add_debug_level(self) -> Match: ...

def every_child(obj: JsonPath, match: Match) -> Iterator[Match]: ...
def debug_msg(obj: JsonPath, match: Match, msg: str) -> None: ...

class JsonPath:
    def __init__(self) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def find(
        self, match: JSONLike | Match, env: dict[str, JsonValue] | None = ..., debug: bool = ...
    ) -> Iterable[Match]: ...
    def values(self, data: JSONLike, debug: bool = ...) -> list[JsonValue]: ...
    def itervalues(self, data: JSONLike, debug: bool = ...) -> Iterator[JsonValue]: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...
    def literal_value(self) -> JsonValue: ...

class BinaryJsonPath(JsonPath):
    left: JsonPath
    right: JsonPath
    def __init__(self, left: JsonPath, right: JsonPath) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...

class UnaryJsonPath(JsonPath):
    child: JsonPath
    def __init__(self, child: JsonPath) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...

class StartsWith(JsonPath):
    prefix: JsonValue
    def __init__(self, prefix: JsonPath) -> None: ...

class EndsWith(JsonPath):
    suffix: JsonValue
    def __init__(self, suffix: JsonPath) -> None: ...

class RemovePrefix(JsonPath):
    prefix: JsonValue
    def __init__(self, prefix: JsonPath) -> None: ...

class RemoveSuffix(JsonPath):
    suffix: JsonValue
    def __init__(self, suffix: JsonPath) -> None: ...

class Literal(JsonPath):
    literal: int | float | str
    def __init__(self, literal: int | float | str) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def literal_value(self) -> JsonValue: ...

class Child(BinaryJsonPath):
    @classmethod
    def make(cls, left: JsonPath, right: JsonPath) -> JsonPath: ...

class Var(JsonPath):
    name: str
    def __init__(self, name: str) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Key(JsonPath):
    key: str
    def __init__(self, key: str) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def literal_value(self) -> JsonValue: ...

class Wildcard(JsonPath):
    pattern: str
    def __init__(self, pattern: str) -> None: ...
    def __repr__(self) -> str: ...

class Index(JsonPath):
    index: int | slice
    def __init__(self, ix: int | slice) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Bind(UnaryJsonPath):
    name: str
    def __init__(self, child: JsonPath, name: str) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class TransformFunction(JsonPath):
    fn: Callable[[JsonValue], JsonValue]
    args: tuple[JsonPath, ...]
    unwrap: bool
    def __init__(self, fn: Callable[[JsonValue], JsonValue], *args: JsonPath, unwrap: bool = ...) -> None: ...
    @classmethod
    def for_function(cls, fn: Callable[[JsonValue], JsonValue], unwrap: bool = ...) -> _PathMaker: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Comparison(BinaryJsonPath):
    string_to_op: dict[str, _Operator]
    op: _Operator
    def __init__(self, left: JsonPath, op: str | _Operator, right: JsonPath) -> None: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...

class Math(BinaryJsonPath):
    string_to_op: dict[str, _Operator]
    op: _Operator
    def __init__(self, left: JsonPath, op: str | _Operator, right: JsonPath) -> None: ...

transform_functions: dict[str, Callable[..., JsonPath]]

class Parselet:
    def precedence(self) -> int: ...

class SingletonParselet(Parselet):
    path: JsonPath
    def __init__(self, path: JsonPath) -> None: ...
    def __repr__(self) -> str: ...

class ImplictChildBaseParselet(Parselet):
    def precedence(self) -> int: ...

class BindParselet(Parselet):
    def precedence(self) -> int: ...

class UnaryParslet(Parselet):
    path_type: type[UnaryJsonPath]
    def __init__(self, path_type: type[UnaryJsonPath]) -> None: ...

class CombiningParselet(Parselet):
    path_maker: Callable[[JsonPath, JsonPath], JsonPath]
    right_assoc: bool
    def __init__(
        self, path_maker: Callable[[JsonPath, JsonPath], JsonPath], prcendence: int = ..., right_assoc: bool = ...
    ) -> None: ...
    def __repr__(self) -> str: ...
    def precedence(self) -> int: ...

class AbstractOperatorParselet(Parselet):
    op: str | _Operator
    right_assoc: bool
    def __init__(self, op: str | _Operator, precedence: int = ..., right_assoc: bool = ...) -> None: ...
    def precedence(self) -> int: ...

class ComparisonParselet(AbstractOperatorParselet):
    def precedence(self) -> int: ...

class CallParselet(Parselet):
    def precedence(self) -> int: ...

prefixes: dict[Kind, Parselet]
infixes: dict[Kind, Parselet]

class Parser:
    text: str
    tokens: list[Token]
    def __init__(self, text: str) -> None: ...
    def take(self, kind: Kind) -> Token | None: ...
    def consume(self, kind: Kind | None = ...) -> Token: ...
    def current(self) -> Token: ...
    def lookahead(self, distance: int) -> Token: ...
    def current_infix(self) -> Parselet | None: ...
    def infix_precedence(self) -> int: ...
    def expression(self, precedence: int = ...) -> JsonPath: ...
    def parse(self) -> JsonPath: ...

simple_key_expr: re.Pattern[str]
simple_path_expr: re.Pattern[str]

def parse(text: str) -> JsonPath: ...

from collections.abc import Callable, Collection, Iterable

import hou
from pxr import Sdf, Usd

def getLop(lop: hou.OpNode) -> hou.LopNode: ...
def getLopnet(lop: hou.OpNode) -> hou.LopNetwork: ...
def getExpandedPaths(panetab: str | None) -> set[Sdf.Path]: ...
def setExpandedPaths(panetab: str | None, expanded: Iterable[str | Sdf.Path]) -> None: ...
def isExpansionEffectEnabled(lop: hou.OpNode) -> bool: ...
def isPrimAboveOrBelowLockedPrim(lop: hou.OpNode, path: str | Sdf.Path) -> bool: ...
def getExpandedToLockedExpandedPaths(
    lop: hou.OpNode,
    expanded: Collection[Sdf.Path],
    branches_of_interest: Iterable[str | Sdf.Path],
) -> set[Sdf.Path]: ...
def runOnAllModelPrimitives(lop: hou.OpNode, primpaths: Iterable[str | Sdf.Path], fn: Callable[[Usd.Prim], object]) -> None: ...
def lockCurrentExpansionEffect(lop: hou.OpNode, primpaths: Iterable[str | Sdf.Path]) -> None: ...
def exposeAllExpansionEffect(lop: hou.LopNode, primpaths: Iterable[str | Sdf.Path]) -> None: ...
def hideAllExpansionEffect(lop: hou.OpNode, primpaths: Iterable[str | Sdf.Path]) -> None: ...
def clearExpansionEffect(lop: hou.OpNode, primpaths: Iterable[str | Sdf.Path]) -> None: ...

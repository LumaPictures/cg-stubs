import hou
from PySide6 import QtCore, QtGui

class LogViewerModel(QtCore.QAbstractTableModel):
    COL_TIME: int
    COL_EXTERNALID: int
    COL_SEVERITY: int
    COL_SOURCE: int
    COL_SOURCECONTEXT: int
    COL_MESSAGE: int
    COL_COUNT: int
    def __init__(self, parent: QtCore.QObject | None = ...) -> None: ...
    def hasLogSink(self) -> bool: ...
    def setLogSink(self, logsink: hou._logging_MemorySink | None) -> None: ...
    def refreshLog(self) -> None: ...
    def filterExistingMessages(self) -> None: ...
    def acceptSources(self) -> dict[str, bool]: ...
    def acceptExternalIds(self) -> dict[str, bool]: ...
    def acceptSeverities(self) -> dict[hou.EnumValue[hou.severityType] | None, bool]: ...
    def setMessageFilter(self, text: str, ignorecase: bool, text_is_regex: bool) -> None: ...
    def applyFilter(self) -> None: ...
    def filterAccept(self, entry: hou._logging_LogEntry) -> bool: ...
    def setHighlightRegex(self, searchregex: QtCore.QRegularExpression | None) -> None: ...
    def findNextMatch(self, searchregex: QtCore.QRegularExpression | None, start: int, allow_current_pos: bool) -> int | None: ...
    def findPreviousMatch(self, searchregex: QtCore.QRegularExpression | None, start: int, allow_current_pos: bool) -> int | None: ...
    def jumpToSourceContext(self, row: int) -> None: ...
    def saveToDisk(self, filepath: str) -> None: ...
    def rowCount(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> int: ...
    def columnCount(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> int: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int) -> str | QtCore.QSize | None: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int) -> str | QtGui.QIcon | QtGui.QBrush | None: ...

from PySide6 import QtCore, QtGui, QtWidgets
from hutil.qt.TextView import TextView

from .model import LogViewerModel

class LogTableView(QtWidgets.QTableView):
    def __init__(self, logmodel: LogViewerModel, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def search(self, regex: QtCore.QRegularExpression | None, backward: bool, allow_current_pos: bool, showall: bool) -> None: ...
    def showAllMatches(self, regex: QtCore.QRegularExpression | None, enabled: bool) -> None: ...

class LogFlatView(TextView):
    def __init__(self, logmodel: LogViewerModel, view: LogTableView | None, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def showEvent(self, showEvent: QtGui.QShowEvent) -> None: ...
    def updateTextWhenShown(self) -> None: ...

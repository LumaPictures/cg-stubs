from collections.abc import Iterable, Sequence
from typing import TypeAlias

import pdg
from pdgjob import pdgjson

_WorkItem: TypeAlias = pdg.WorkItem | pdgjson.WorkItem | pdgjson.NativeWorkItem

def getP4BinStr(work_item: _WorkItem) -> str: ...
def getInputFilesStr(
    work_item: _WorkItem, input_files: Iterable[str], sep: str = ..., omit_quotes: bool = ...
) -> str: ...
def getPendingChangelists(p4configfile: str | None = ...) -> list[str]: ...
def status(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def update(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def sync(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def edit(work_item: _WorkItem, input_files: Sequence[str] | None) -> None: ...
def submit(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def add(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def change(work_item: _WorkItem, input_files: Iterable[str] | None) -> None: ...
def version(work_item: _WorkItem) -> None: ...
def cook(work_item: _WorkItem) -> bool: ...

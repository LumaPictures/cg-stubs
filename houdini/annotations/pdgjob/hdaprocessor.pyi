from typing import Literal, TypeAlias, TypedDict, overload

import hou
import pdg
from pdgjob import pdgjson

_WorkItem: TypeAlias = pdg.WorkItem | pdgjson.WorkItem | pdgjson.NativeWorkItem

class _SceneObj(TypedDict):
    category: str | None
    hda_node: str | None
    parent_node: str | None
    file_inputs: list[str]

class _JobSuccess(TypedDict):
    status: Literal["success"]
    outputs: list[dict[str, str]] | None

class _JobFailed(TypedDict):
    status: Literal["failed"]

BATCH_MODE_OFF: int
BATCH_MODE_ALL: int
ALL_FRAMES: int
FIRST_FRAME: int
ON_MISSING_ERROR: int
ON_MISSING_WARN: int
ON_MISSING_IGNORE: int

def getInputFilePath(inputfile: str, temp_dir: str) -> str: ...
def getSupportedHdaTypes() -> list[str]: ...
def installHda(hda_path: str) -> None: ...
def getHdaDefinition(hda_path: str, optype: str | None) -> hou.HDADefinition | None: ...
def getAssetDefinitionCategoryName(definition: hou.HDADefinition) -> str: ...
def getNumOfInputs(definition: hou.HDADefinition) -> int: ...
def getNumOfOutputs(definition: hou.HDADefinition) -> int: ...
@overload
def createNode(work_item: _WorkItem, container_node: hou.OpNode, node_name: str) -> hou.OpNode: ...
@overload
def createNode(work_item: _WorkItem, container_node: hou.Node | None, node_name: str) -> hou.Node | None: ...
def setHdaParameters(work_item: _WorkItem, hda_node: hou.OpNode) -> None: ...
def getCookErrors(node: hou.Node, get_nested_errors: int | None) -> str: ...
def composeNestedErrorMessages(node: hou.Node) -> list[str]: ...

class HdaProcessor:
    HDACache: dict[str, _SceneObj]
    installed_hdas: dict[str, _SceneObj]
    global_cache: bool
    def __init__(self, use_global: bool = ...) -> None: ...
    @staticmethod
    def saveScene(work_item: _WorkItem) -> None: ...
    @staticmethod
    def _job_success(
        outputs: list[dict[str, str]] | None = ..., dumpdebug: int | None = ..., work_item: _WorkItem | None = ...
    ) -> _JobSuccess: ...
    @staticmethod
    def _job_failed(dumpdebug: int | None = ..., work_item: _WorkItem | None = ...) -> _JobFailed: ...
    def cleanup_scene(self, work_item: _WorkItem | None = ...) -> None: ...
    def run_job(self, work_item: _WorkItem, temp_dir: str, dumpdebug: int | None) -> _JobSuccess | _JobFailed: ...

def cook(work_item: _WorkItem, service: bool = ...) -> bool: ...
def main() -> None: ...

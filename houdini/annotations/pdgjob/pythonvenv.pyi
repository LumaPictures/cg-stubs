from typing import TypeAlias

from pdgjob import pdgjson

_WorkItem: TypeAlias = pdgjson.WorkItem

def create_venv(work_item: _WorkItem, local_path: str) -> bool: ...
def update_permissions(root_dir: str) -> None: ...
def pip_install(
    pip_path: str, packages: str, extra_args: str | None, install_args: str | None, cache_dir: str
) -> str: ...
def pip_install_file(
    pip_path: str, req_file: str, extra_args: str | None, install_args: str | None, cache_dir: str
) -> str: ...
def pip_install_wheel(
    pip_path: str,
    wheel_root: str,
    wheel_name: str,
    extra_args: str | None,
    install_args: str,
    cache_dir: str,
) -> str: ...
def package_dir(local_path: str, is_windows: bool) -> str: ...
def install_requirements(work_item: _WorkItem, local_path: str, pip_path: str, is_windows: bool) -> None: ...
def install_hfs(work_item: _WorkItem, local_path: str, pip_path: str, is_windows: bool) -> None: ...
def cook(work_item: _WorkItem) -> bool: ...

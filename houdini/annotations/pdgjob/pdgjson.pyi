# Dictionary attribute values come from the work item JSON; values set from python are reported
# to PDG as their repr, which it parses back.
_AttribValue: TypeAlias = "int | float | str | File | dict[str, JSONValue]"
_E = TypeVar("_E", bound=_AttribValue)
_J = TypeVar("_J", bound=JSONLike)

# The job a service client is sent (PDG_Service), as JSON; PDG_SERVICE_DATA holds the same.
class _ServiceJobInfo(TypedDict, total=False, extra_items=JSONValue):  # type: ignore[call-arg]
    version: int
    as_native: int
    apply_wedges: int
    work_item: Required[str]
    job_script: str
    custom_script: str
    script_dir: str
    working_dir: Required[str]
    temp_dir: Required[str]

_Attribute: TypeAlias = (
    "AttributeInt | AttributeFloat | AttributeString | AttributeFile | AttributeDictionary | AttributePyObject"
)
class _AttribJSON(TypedDict):
    type: int
    flag: int
    own: bool
    concat: bool
    value: list[_AttribValue] | str | bytes

class _ServiceStatus(TypedDict):
    status: str

class _ServiceResponse(TypedDict):
    status: str
    msg: str
    version: int
    memory: int
    # Copied from the work item's JSON patch (_pdg.WorkItem.createJSONPatch).
    outputs: NotRequired[Any]
    attributes: NotRequired[Any]
    graph: NotRequired[Any]

_AnyWorkItem: TypeAlias = "WorkItem | NativeWorkItem | pdg.WorkItem"
_PdgAttribute: TypeAlias = (
    pdg.AttributeDictionary
    | pdg.AttributeFile
    | pdg.AttributeFloat
    | pdg.AttributeGeometry
    | pdg.AttributeInt
    | pdg.AttributePyObject
    | pdg.AttributeString
)


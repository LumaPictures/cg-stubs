class MixerSurface(QtWidgets.QFrame):
    def __init__(self, view: "MixerView", index: _AnyIndex, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def insertRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def removeRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def backgroundColor(self) -> QtGui.QColor | None: ...
    def setBackgroundColor(self, color: QtGui.QColor | None) -> None: ...
    def view(self) -> "MixerView | None": ...
    def index(self) -> QtCore.QPersistentModelIndex: ...
    def model(self) -> husdui.models.ItemModelProxyBase | None: ...
    def widgets(self) -> list["Strip | Group"]: ...
    def findIndex(self, index: _AnyIndex) -> "Strip | Group | None": ...
    def reset(self) -> None: ...
    def clear(self) -> None: ...
    def resetDisplay(self) -> None: ...
    def item(self) -> None: ...

class RootSurface(MixerSurface):
    def __init__(self, view: "MixerView", parent: QtWidgets.QWidget | None = ...) -> None: ...
    def resetDisplay(self) -> None: ...

class Mixable(QtWidgets.QFrame):
    hotkeyInvoked: ClassVar[QtCore.Signal]
    solo_column: int
    mute_column: int
    active_column: int
    color_column: int
    def __init__(self, view: "MixerView", index: _AnyIndex, parent: QtWidgets.QWidget | None = ...) -> None: ...
    def backgroundColor(self) -> QtGui.QColor: ...
    def setControls(self, shown: Container[str]) -> None: ...
    def actions(self) -> list[QtGui.QAction]: ...
    def setBackgroundColor(self, color: QtGui.QColor) -> None: ...
    def view(self) -> "MixerView | None": ...
    def model(self) -> husdui.models.ItemModelProxyBase | None: ...
    def index(self) -> QtCore.QPersistentModelIndex: ...
    def item(self) -> husdui.models.Item | None: ...
    def orientation(self) -> QtCore.Qt.Orientation: ...
    def name(self) -> str | Literal[False] | None: ...
    def icon(self) -> QtGui.QIcon | Literal[False] | None: ...
    def attr(self, column: int) -> Any: ...
    def setBreadth(self, breadth: int) -> None: ...
    def reset(self) -> None: ...
    def resetDisplay(self) -> None: ...
    def showControl(self, attr_name: str) -> None: ...
    def hideControl(self, attr_name: str) -> None: ...
    def setShown(self, attr_names: Container[str]) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...

class Strip(Mixable):
    def __init__(
        self, view: "MixerView", index: _AnyIndex, column_list: Iterable[str], panel: "Group | None" = ...
    ) -> None: ...
    def panel(self) -> "Group | None": ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...

class Group(Mixable):
    def __init__(
        self, view: "MixerView", index: _AnyIndex, column_list: Iterable[str], parent: QtWidgets.QWidget | None = ...
    ) -> None: ...
    def setControls(self, controls: Container[str]) -> None: ...
    def isExpanded(self) -> bool: ...
    def setExpanded(self, expanded: bool) -> None: ...
    def insertRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def removeRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def resetDisplay(self) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...


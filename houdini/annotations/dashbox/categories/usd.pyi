import PySide6.QtGui
from pxr import Sdf, Usd

import hou

from ..common import Category, Hit, Sug, Tag
from ..ui import DashWindow

USD_ICON: hou.qt.Icon

class UsdStageCategory(Category):
    TAG_NAME: str
    TAG: Tag
    def __init__(self) -> None: ...
    def knownTags(self) -> list[Tag]: ...
    def label(self) -> str: ...
    def icon(self) -> hou.qt.Icon: ...
    def suggestedInputs(self) -> list[str]: ...
    def initialSuggestions(self) -> Sug: ...

class UsdPathHit(Hit):
    def __init__(self, lop: hou.LopNode, path: Sdf.Path) -> None: ...
    def __repr__(self) -> str: ...
    def label(self) -> str: ...
    def prim(self) -> Usd.Prim: ...
    def icon(self) -> PySide6.QtGui.QIcon: ...
    def action(self, dashbox: DashWindow) -> None: ...

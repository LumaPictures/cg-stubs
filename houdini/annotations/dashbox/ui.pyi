from collections.abc import Sequence

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets

import hou

from .common import Category, Hit, SearchSpec, TagSource
from .textedit import DashEdit

DASH_ICON: hou.qt.Icon
TOP_HITS_ICON: hou.qt.Icon
TOP_HIT_MAX_COUNT: int
THREADED: bool
saved_window_pos: PySide6.QtCore.QPoint
saved_window_size: PySide6.QtCore.QSize
saved_use_fuzzy: bool

class HitModel(PySide6.QtCore.QAbstractListModel):
    ITEM_ROLE: int
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def isAllHeadings(self) -> bool: ...
    def setHits(self, hits: list[Hit]) -> None: ...
    def hitAt(self, i: int) -> Hit: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag | None: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = ...) -> int: ...
    def data(
        self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...
    ) -> Hit | str | PySide6.QtGui.QFont | PySide6.QtCore.QSize | PySide6.QtGui.QIcon | PySide6.QtCore.Qt.AlignmentFlag | None: ...

class DashWindow(PySide6.QtWidgets.QDialog):
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ..., all_categories: Sequence[Category] = ...) -> None: ...
    def showEvent(self, event: PySide6.QtGui.QShowEvent) -> None: ...
    def hideEvent(self, event: PySide6.QtGui.QHideEvent) -> None: ...
    def moveEvent(self, event: PySide6.QtGui.QMoveEvent) -> None: ...
    def resizeEvent(self, event: PySide6.QtGui.QResizeEvent) -> None: ...
    def closeEvent(self, event: PySide6.QtGui.QCloseEvent) -> None: ...
    def isFuzzy(self) -> bool: ...
    def setFuzzy(self, fuzzy: bool) -> None: ...
    def setTagSource(self, tagsource: TagSource) -> None: ...
    def insertText(self, text: str, space: bool = ...) -> None: ...
    def eventFilter(self, watched: PySide6.QtCore.QObject, event: PySide6.QtCore.QEvent) -> bool: ...
    def changeEvent(self, event: PySide6.QtCore.QEvent) -> None: ...
    def moveSelection(self, delta: int) -> None: ...
    def model(self) -> HitModel: ...
    def editor(self) -> DashEdit: ...
    def setText(self, text: str) -> None: ...
    def setCategories(self, categories: Sequence[Category]) -> None: ...
    def setGoodbyeMessage(self, text: str) -> None: ...
    def acceptResultFor(self, text: str) -> None: ...
    def runSearch(self, no_thread: bool = ...) -> None: ...
    def hits(self, search: SearchSpec, completions: list[Hit] | None = ...) -> tuple[list[Hit], str]: ...
    def populate(self, hits: list[Hit], plaintext: str) -> None: ...
    def accept(self) -> None: ...

class ItemDelegate(PySide6.QtWidgets.QStyledItemDelegate):
    def paint(
        self,
        painter: PySide6.QtGui.QPainter,
        option: PySide6.QtWidgets.QStyleOptionViewItem,
        index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex,
    ) -> None: ...

def show(categories: Sequence[Category] = ...) -> None: ...

class VexPart:
    ws_exp: re.Pattern[str]
    def __repr__(self) -> str: ...
    def typecode(self) -> str: ...
    def is_meta(self) -> bool: ...
    def matches(self, other: "VexPart") -> bool | None: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiText: ...
    # Each subclass parses to its own result types.  mypy only accepts a `cls` annotation that
    # is a supertype of the class, hence the ignores; other type checkers pick the overload.
    @overload
    @classmethod
    def parse(
        cls: type["TypeChoice"], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]
    ) -> "TypeChoice | ArrayType | AnyType | TypeAtom": ...  # type: ignore[misc]
    @overload
    @classmethod
    def parse(
        cls: type["VexType"], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]
    ) -> "ArrayType | TypeAtom": ...  # type: ignore[misc]
    @overload
    @classmethod
    def parse(
        cls: type["Argument"], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]
    ) -> "Argument | VariadicArgs": ...  # type: ignore[misc]
    @overload
    @classmethod
    def parse(cls: type[_P], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> _P: ...
    @classmethod
    def parse(cls: type["VexPart"], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> "VexPart": ...
    @overload
    @classmethod
    def take(
        cls: type["TypeChoice"], ctx: Context, string: str, pos: int
    ) -> tuple["TypeChoice | ArrayType | AnyType | TypeAtom", int]: ...  # type: ignore[misc]
    @overload
    @classmethod
    def take(cls: type["VexType"], ctx: Context, string: str, pos: int) -> tuple["ArrayType | TypeAtom", int]: ...  # type: ignore[misc]
    @overload
    @classmethod
    def take(cls: type["Argument"], ctx: Context, string: str, pos: int) -> tuple["Argument | VariadicArgs", int]: ...  # type: ignore[misc]
    @overload
    @classmethod
    def take(cls: type[_P], ctx: Context, string: str, pos: int) -> tuple[_P, int]: ...
    @classmethod
    def take(cls: type["VexPart"], ctx: Context, string: str, pos: int) -> tuple["VexPart", int]: ...
    @classmethod
    def expected(cls) -> str: ...
    @classmethod
    def expect(cls, string: str, pos: int, text: str) -> int: ...
    @classmethod
    def expect_regex(cls, string: str, pos: int, expr: re.Pattern[str]) -> int: ...
    @classmethod
    def choice(cls, ctx: Context, string: str, pos: int, choices: Sequence[type[_P]]) -> tuple[_P, int]: ...
    @classmethod
    def optional_text(cls, string: str, pos: int, optstring: str) -> tuple[bool, int]: ...
    @classmethod
    def optional(cls, ctx: Context, string: str, pos: int, optcls: type[_P]) -> tuple[_P | None, int]: ...
    @classmethod
    def ws(cls, string: str, pos: int, required: bool = ...) -> int: ...
    @overload
    @classmethod
    def take_type(
        cls, ctx: Context, string: str, pos: int, allow_array: bool = ..., *, allow_choice: Literal[False]
    ) -> tuple["ArrayType | AnyType | TypeAtom", int]: ...
    @overload
    @classmethod
    def take_type(
        cls, ctx: Context, string: str, pos: int, allow_array: bool = ..., allow_choice: bool = ...
    ) -> tuple["TypeChoice | ArrayType | AnyType | TypeAtom", int]: ...
    @classmethod
    def take_type(
        cls, ctx: Context, string: str, pos: int, allow_array: bool = ..., allow_choice: bool = ...
    ) -> tuple["TypeChoice | ArrayType | AnyType | TypeAtom", int]: ...


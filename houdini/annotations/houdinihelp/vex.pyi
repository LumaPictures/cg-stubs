class _ContextKwargs(TypedDict, total=False):
    doc_mode: bool
    level: int

ARGLIST_OPEN_BRACKET: str
ARGLIST_CLOSE_BRACKET: str
ARGLIST_SEPARATOR: str
VEXTYPES: list[str]

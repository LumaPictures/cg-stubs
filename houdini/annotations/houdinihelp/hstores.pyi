import re
from collections.abc import Generator, Mapping
from datetime import datetime
from io import BytesIO
from typing import Any, NoReturn, overload

from bookish import stores
from bookish.stores import Store

class HoudiniPathStore(stores.OverlayStore):
    stores: list[Store]
    def __init__(self, path: str = ...) -> None: ...
    def tags(self) -> tuple[str]: ...

class FixedFileStore(stores.FileStore):
    fixed_time: datetime
    def __init__(self, dirpath: str, config: Mapping[str, Any] | None = ..., exemplar: str | None = ...) -> None: ...
    def last_modified(self, path: str) -> datetime: ...

class HiddenNodeStore(stores.HideStore):
    def explain(self, path: str, tab: int = ...) -> None: ...
    def redirect(self, path: str) -> str | None: ...

class ManagerRedirectStore(stores.WrappingStore):
    def redirect(self, path: str) -> str | None: ...

class AssetStore(stores.StringStore):
    def tags(self) -> tuple[str]: ...
    def exists(self, path: str) -> bool | str | None: ...
    def list_all(self, path: str = ..., no_lang: bool = ...) -> Generator[str, None, None]: ...
    def last_modified(self, path: str) -> datetime: ...
    def writable(self, path: str) -> bool: ...
    def write_file(self, path: str, bytestring: bytes) -> None: ...
    def delete(self, path: str) -> None: ...
    @overload
    def content(self, path: str, encoding: None) -> bytes: ...
    @overload
    def content(self, path: str, encoding: str = ...) -> str: ...
    def content(self, path: str, encoding: str | None = ...) -> str | bytes: ...
    def open(self, path: str, mode: str = ...) -> BytesIO: ...
    def is_dir(self, path: str) -> bool: ...
    def etag(self, path: str) -> str | None: ...
    def move(self, path: str, newpath: str) -> NoReturn: ...

class ShelfStore(stores.StringStore):
    prefix: str
    nodeexp: re.Pattern[str]
    def __init__(self) -> None: ...
    def tags(self) -> tuple[str]: ...
    def list_dir(self, path: str) -> list[str] | tuple[()]: ...
    def exists(self, path: str) -> bool | None: ...
    def content(self, path: str, encoding: str | None = ...) -> str: ...
    def write_file(self, path: str, bytestring: bytes) -> None: ...
    def delete(self, path: str) -> None: ...
    def is_dir(self, path: str) -> bool: ...
    def move(self, path: str, newpath: str) -> NoReturn: ...

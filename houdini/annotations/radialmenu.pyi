from collections.abc import Mapping
from typing import Literal, NotRequired, Protocol, ReadOnly, TypeAlias, TypedDict, Unpack

import hou
from houtypes import RadialMenuKwargs

class _RadialActionScript(Protocol):
    def __call__(self, **kwargs: Unpack[RadialMenuKwargs]) -> object: ...

class _RadialCheckScript(Protocol):
    def __call__(self, **kwargs: Unpack[RadialMenuKwargs]) -> bool: ...

# ReadOnly so that callers' narrower item TypedDicts (e.g. curvestate.radialmenu's) are accepted.
class _RadialEntry(TypedDict):
    type: ReadOnly[Literal["script_action", "action", "script_submenu", "submenu", "link"]]
    label: NotRequired[ReadOnly[str]]
    script: NotRequired[ReadOnly[str | _RadialActionScript]]
    check: NotRequired[ReadOnly[str | _RadialCheckScript]]
    shortcut: NotRequired[ReadOnly[str]]
    icon: NotRequired[ReadOnly[str]]
    name: NotRequired[ReadOnly[str]]
_RadialMenu: TypeAlias = (
    Mapping[str, _RadialEntry] | Mapping[int, _RadialEntry] | Mapping[str | int, _RadialEntry]
)

aliases: dict[str, int]

def runShelfTool(scriptargs: RadialMenuKwargs, tool: str) -> None: ...
def snappingMode(scriptargs: RadialMenuKwargs) -> hou.EnumValue[hou.snappingMode]: ...
def setSnappingMode(scriptargs: RadialMenuKwargs, mode: hou.EnumValue[hou.snappingMode]) -> None: ...
def isPickingVisibleGeometry(scriptargs: RadialMenuKwargs) -> bool: ...
def setPickingVisibleGeometry(scriptargs: RadialMenuKwargs, on: bool) -> None: ...
def isPickingContainedGeometry(scriptargs: RadialMenuKwargs) -> bool: ...
def setPickingContainedGeometry(scriptargs: RadialMenuKwargs, on: bool) -> None: ...
def isWholeGeometryPicking(scriptargs: RadialMenuKwargs) -> bool: ...
def setWholeGeometryPicking(scriptargs: RadialMenuKwargs, on: bool) -> None: ...
def viewportLayout(scriptargs: RadialMenuKwargs) -> hou.EnumValue[hou.geometryViewportLayout]: ...
def setViewportLayout(scriptargs: RadialMenuKwargs, layout: hou.EnumValue[hou.geometryViewportLayout], single: int = ...) -> None: ...
def shadingMode(scriptargs: RadialMenuKwargs) -> hou.EnumValue[hou.glShadingType]: ...
def setShadingMode(scriptargs: RadialMenuKwargs, mode: hou.EnumValue[hou.glShadingType]) -> None: ...
def pickStyle(scriptargs: RadialMenuKwargs) -> hou.EnumValue[hou.pickStyle]: ...
def setPickStyle(scriptargs: RadialMenuKwargs, style: hou.EnumValue[hou.pickStyle]) -> None: ...
def networkEditor(scriptargs: RadialMenuKwargs) -> hou.NetworkEditor: ...
def setRadialMenu(menu: str | _RadialMenu) -> None: ...

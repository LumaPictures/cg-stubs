from collections.abc import Callable, Sequence
from typing import TypeAlias

import hou

# Parm compares a parameter's value (or its menu token) with its value, as a number or a string.
_ParmOp: TypeAlias = Callable[[int | float | str | dict[str, str] | hou.Ramp | hou.Geometry | None, float | str], bool]

class Matcher:
    fast: bool
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def matches_items(self) -> bool: ...
    def normalized(self) -> "Matcher": ...
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> Sequence[hou.NetworkMovableItem]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...
    def matches_container(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class All(Matcher):
    fast: bool
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> tuple[hou.NetworkMovableItem, ...]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Null(Matcher):
    fast: bool
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> tuple[()]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Name(Matcher):
    fast: bool
    name: str
    exact: bool
    def __init__(self, name: str, exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def normalized(self) -> "All | Name": ...
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> Sequence[hou.NetworkMovableItem]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Tag(Matcher):
    fast: bool
    tag: str
    exact: bool
    def __init__(self, tag: str, exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Parm(Matcher):
    ops: dict[str, _ParmOp]
    name: str
    op: str | _ParmOp
    value: str | float
    def __init__(self, name: str, op: str | _ParmOp, value: str | float) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class RawParm(Matcher):
    name: str
    value: str
    is_pattern: bool
    exact: bool
    def __init__(self, name: str, value: str, is_pattern: bool = ..., exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool | None: ...

class State(Matcher):
    states: dict[str, Callable[[hou.OpNode], bool]]
    name: str
    value: bool
    fn: Callable[[hou.OpNode], bool] | None
    def __init__(self, name: str, value: bool) -> None: ...
    def __repr__(self) -> str: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class NodeType(Matcher):
    typecat: hou.NodeTypeCategory | str | None
    typename: str
    exact: bool
    def __init__(self, typename: str, typecat: hou.NodeTypeCategory | str | None = ..., exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def normalized(self) -> "All | NodeType": ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class ParameterState(Matcher):
    condition: Callable[[hou.Parm], bool]
    def __init__(self, condition: str | Callable[[hou.Parm], bool]) -> None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Netbox(Matcher):
    comment: str
    exact: bool
    def __init__(self, comment: str, exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches_items(self) -> bool: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...
    def matches_container(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class StickyNote(Matcher):
    text: str
    exact: bool
    def __init__(self, text: str, exact: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches_items(self) -> bool: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Wrapper(Matcher):
    child: Matcher
    fast: bool
    def __init__(self, child: Matcher) -> None: ...
    def __repr__(self) -> str: ...
    def matches_items(self) -> bool: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Not(Wrapper):
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> Sequence[hou.NetworkMovableItem]: ...

class Input(Wrapper):
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Output(Wrapper):
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Contents(Wrapper):
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> list[hou.NetworkMovableItem]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

class Group(Matcher):
    children: Sequence[Matcher]
    intersect: bool
    def __init__(self, children: Sequence[Matcher], intersect: bool = ...) -> None: ...
    def __repr__(self) -> str: ...
    def matches_items(self) -> bool: ...
    def normalized(self) -> "Matcher": ...
    def nodes(
        self, network: hou.Node, ignore_case: bool = ..., recursive: bool = ..., recurse_in_locked_nodes: bool = ...
    ) -> Sequence[hou.NetworkMovableItem]: ...
    def matches(self, node: hou.NetworkMovableItem, ignore_case: bool = ...) -> bool: ...

    grouptypevalue: int,
) -> None: ...
def initSopParmTransform(node: hou.OpNode, src_frame: CoordFrame, dst_frame: CoordFrame) -> None: ...
def buildSrcSpaceCoordFrames(
    src_node: hou.SopNode,
    src_sel: hou.Selection,
    src_comp_index: int,
    dst_node: hou.SopNode,
    dst_sel: hou.Selection,
    dst_comp_index: int,
    to_normal: hou.EnumValue[hou.handleOrientToNormalAxis],

from collections.abc import Mapping, Sequence
from typing import Protocol

import hou

class _GroupParmInfo(Protocol):
    @property
    def groupparmname(self) -> str: ...
    @property
    def grouptypeparmname(self) -> str: ...
    @property
    def grouptypevalues(self) -> Mapping[hou.EnumValue[hou.geometryType], int]: ...

def interactiveAlign(pane: hou.SceneViewer | None = ..., quick_mode: bool = ...) -> None: ...
def interactiveObjectAlign(pane: hou.SceneViewer | None = ..., quick_mode: bool = ...) -> None: ...
def interactiveSopAlign(pane: hou.SceneViewer | None = ..., quick_mode: bool = ...) -> None: ...
def showError(msg: str) -> None: ...
def getObject(node: hou.Node) -> hou.ObjNode: ...

class CoordFrame:
    origin: hou.Vector3
    x: hou.Vector3
    y: hou.Vector3
    z: hou.Vector3
    def __init__(
        self,
        origin: hou.Vector3 = ...,
        x: hou.Vector3 = ...,
        y: hou.Vector3 = ...,
        z: hou.Vector3 = ...,
        normalize: bool = ...,
    ) -> None: ...
    def transform(self, xform: hou.Matrix4) -> None: ...
    def transformed(self, xform: hou.Matrix4) -> "CoordFrame": ...
    def flippedAboutUp(self, to_normal: hou.EnumValue[hou.handleOrientToNormalAxis], target_up_vector: hou.Vector3) -> "CoordFrame | None": ...
    def flippedAboutX(self) -> "CoordFrame": ...
    def flippedAboutY(self) -> "CoordFrame": ...
    def flippedAboutZ(self) -> "CoordFrame": ...
    def spaceChangeTransform(self, dst_frame: "CoordFrame") -> hou.Matrix4: ...

def alignObject(src_obj: hou.ObjNode, src_frame: CoordFrame, dst_obj: hou.ObjNode, dst_frame: CoordFrame) -> None: ...
def setObjParmPivotTransform(obj: hou.ObjNode, new_pivot_xform: hou.Matrix4) -> None: ...
def initNewSopFromGeometrySelection(
    newnode: hou.SopNode,
    container: hou.Node,
    geoselection: hou.GeometrySelection,
    groupparminfo: _GroupParmInfo,
) -> None: ...
def initNewSopFromSelection(
    newnode: hou.SopNode,
    container: hou.Node,
    inputnode: hou.SopNode,
    selection: hou.Selection | None,
    geometry: hou.Geometry | None,
    groupparminfo: _GroupParmInfo,
    inheritselectabletemplateflags: bool,
) -> None: ...
def setGroupParmsOnSop(
    node: hou.OpNode,
    groupparmname: str,

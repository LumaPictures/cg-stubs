import hou
import PySide6.QtWidgets

from pdgstateserver.serverlist import ServerList

class PDGStateServerWindow(PySide6.QtWidgets.QWidget):
    server_types: dict[str, str]
    selected_server_type: str | None
    server_list: ServerList
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = ...) -> None: ...
    def serverTypeChanged(self, server_type: str) -> None: ...
    def startServer(self) -> None: ...
    def onActivateInterface(self) -> None: ...
    def onDeactivateInterface(self) -> None: ...
    def onNodePathChanged(self, node: hou.Node | None) -> None: ...
    def onDestroyInterface(self) -> None: ...

import hou
from collections.abc import Sequence

class MockHandle:
    """A simple skeleton to allow us to mock a handle when running
    regression tests."""
    def __init__(self, scene_viewer: hou.SceneViewer, name: str, type: str = 'mock') -> None: ...
    def name(self) -> str: ...
    def type(self) -> str: ...
    def show(self, on: bool) -> None: ...
    def update(self, immediate: bool = True) -> None: ...
    def visible(self) -> bool: ...
    def enableParms(self, parm_list: Sequence[str]) -> None: ...
    def disableParms(self, parm_list: Sequence[str]) -> None: ...
    def applySettings(self, settings: str) -> None: ...

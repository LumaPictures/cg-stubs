import hou
import typing
from kinefx import rigapi as rigapi
from typing import Literal, TypedDict

class _MirrorPlane(TypedDict):
    origin: hou.Vector3
    direction: hou.Vector3

class RigPoser:
    geo: hou.Geometry
    cur_pt: hou.Point | None
    cur_pt_parent: hou.Point | None
    parent_xform: hou.Matrix4
    parent_local: hou.Matrix4
    parent_efflocal: hou.Matrix4
    compute_local: hou.SopVerb
    compute_world: hou.SopVerb
    mirror_plane: _MirrorPlane
    def __init__(self, geo: hou.Geometry) -> None: ...
    @property
    def start_world_xform(self) -> hou.Matrix4: ...
    def onBeginPose(self, pt: hou.Point, child_compensate: bool = False, orient_parent: bool = False) -> None: ...
    def setPoseFromMatrix(self, xform: hou.Matrix4, child_compensate: bool = False, mirror: bool = False) -> None: ...
    def setPoseFromLocalMatrix(self, xform: hou.Matrix4, child_compensate: bool = False) -> None: ...
    def setPoseFromParms(self, parms: object) -> None: ...
    def onEndPose(self) -> None: ...
    def localTransformDeltaParms(self) -> dict[str, hou.Vector3]: ...
    @typing.overload
    def worldTransformDelta(self, as_trs: Literal[False] = ...) -> hou.Matrix4: ...
    @typing.overload
    def worldTransformDelta(self, as_trs: Literal[True]) -> dict[str, hou.Vector3]: ...
    @typing.overload
    def worldTransformDelta(self, as_trs: bool) -> hou.Matrix4 | dict[str, hou.Vector3]: ...
    @typing.overload
    def localTransformDelta(self, as_trs: Literal[False] = ...) -> hou.Matrix4: ...
    @typing.overload
    def localTransformDelta(self, as_trs: Literal[True]) -> dict[str, hou.Vector3]: ...
    @typing.overload
    def localTransformDelta(self, as_trs: bool) -> hou.Matrix4 | dict[str, hou.Vector3]: ...

import hou
import typing
from collections.abc import Callable as Callable, Mapping, MutableMapping, Sequence
from kinefx import rigapi as rigapi
from kinefx.baking import _ParmEvalValue
from kinefx.stateutils import _RotateOrder, _TransformOrder
from typing import Literal, Protocol, TypedDict

from typing import TypeAlias
from typing import TypeAlias
_IntParmKey: TypeAlias = Literal['mode', 'bake', 'xOrd', 'rOrd']
_FloatParmKey: TypeAlias = Literal['tx', 'ty', 'tz', 'rx', 'ry', 'rz', 'sx', 'sy', 'sz', 'px', 'py', 'pz', 'pivot_rx', 'pivot_ry', 'pivot_rz']
class _PoseParmsParent(Protocol):
    @property
    def filter_selected_parms(self) -> int: ...
    @property
    def focus_selected_parms(self) -> int: ...

class _AxisLimit(TypedDict, total=False):
    lower: float
    upper: float

class _FullTransformDict(TypedDict):
    group: str | None
    mode: int | None
    bake: int | None
    xOrd: int | None
    rOrd: int | None
    tx: float | None
    ty: float | None
    tz: float | None
    rx: float | None
    ry: float | None
    rz: float | None
    sx: float | None
    sy: float | None
    sz: float | None
    px: float | None
    py: float | None
    pz: float | None
    pivot_rx: float | None
    pivot_ry: float | None
    pivot_rz: float | None

MODE_PRE: int
MODE_POST: int
MODE_OVERRIDE: int
MODE_REST: int
transform_order: list[_TransformOrder]
rotate_order: list[_RotateOrder]

class PoseParms:
    multiparm: hou.Parm | None
    is_time_override: bool
    time_override_time: float
    parm_prefix: str
    cur_parms: dict[str, hou.Parm | None]
    parm_formats: dict[str, Callable[[], str]]
    def __init__(self, parent: _PoseParmsParent | None) -> None: ...
    @typing.overload
    def __getitem__(self, item: Literal['group']) -> str | None: ...
    @typing.overload
    def __getitem__(self, item: _IntParmKey) -> int | None: ...
    @typing.overload
    def __getitem__(self, item: _FloatParmKey) -> float | None: ...
    @typing.overload
    def __getitem__(self, item: str) -> _ParmEvalValue: ...
    def __setitem__(self, key: str, value: float | str) -> None: ...
    @property
    def node(self) -> hou.OpNode | None: ...
    @property
    def numInstances(self) -> int: ...
    def getParmDict(self, idx: int) -> dict[str, hou.Parm | None]: ...
    def isLocked(self) -> None: ...
    def isTRSLocked(self, idx: int) -> bool: ...
    def isTRSEditable(self, idx: int) -> bool: ...
    def clear(self, update_channel_list: bool = True, clear_multiparm: bool = False) -> None: ...
    def setMultiParm(self, p: hou.Parm) -> None: ...
    def setTimeOverride(self, is_time_override: bool, time: float) -> None: ...
    def getVector(self, p: Literal['t', 'r', 's', 'p', 'pivot_r']) -> hou.Vector3: ...
    def getFullTransformDict(self) -> _FullTransformDict: ...
    class XformLimitsData:
        is_first_iter: bool
        rot: hou.Vector3
        limited_rest_rot: hou.Vector3
        rest_rot: hou.Vector3
        in_local: hou.Matrix4
        in_local_inv: hou.Matrix4
        rest_local: hou.Matrix4
        rest_local_inv: hou.Matrix4
        parm_limits: Mapping[str, _AxisLimit]
        def __init__(self, parm_limits: Mapping[str, _AxisLimit], in_local: hou.Matrix4, rest_local: hou.Matrix4) -> None: ...
    limits_data: list[PoseParms.XformLimitsData | None]
    def resetLimitsData(self) -> None: ...
    def setLimitsData(self, parm_limits: Mapping[str, _AxisLimit], in_local: hou.Matrix4, rest_local: hou.Matrix4, idx: int | None = None) -> None: ...
    def setTRSFromDict(self, trsdict: MutableMapping[str, float], apply_as_delta: bool = False, compute_limits: bool = False, apply_limits: bool = False) -> hou.Vector3 | None: ...
    def getLimitedRestRot(self, parm_limits: Mapping[str, _AxisLimit], in_local: hou.Matrix4, rest_local: hou.Matrix4) -> hou.Vector3: ...
    def loadFromPath(self, path: str) -> None: ...
    def loadFromComputePoseNode(self, node: hou.OpNode | None) -> None: ...
    def setCurrentIndex(self, idx: int, update_channel_list: bool = True) -> None: ...
    def findPointInGroups(self, pt: hou.Point, geo: hou.Geometry) -> int: ...
    def getPointName(self, pt: hou.Point | None) -> str: ...
    @staticmethod
    def getPointNameGroup(pt: hou.Point | None) -> str: ...
    def appendInstance(self, groupname: str, rOrd: int = 0, update_channel_list: bool = True) -> int: ...
    def setInstanceAliases(self, idx: int, groupname: str) -> None: ...
    def scrollToParmsInEditors(self, ci: int, do_focus: bool) -> None: ...
    def getROrd(self, pt: hou.Point, config_attrib_name: str) -> int: ...
    def clearChannelList(self) -> None: ...
    def updateChannelListFromSelection(self, selected: Sequence[hou.Point] | Sequence[int], geo: hou.Geometry, config_attrib_name: str = 'fbik_jointconfig') -> None: ...
    def updateChannelList(self) -> None: ...

def buildParmTemplate(parmname: str = 'transformations') -> hou.FolderParmTemplate: ...
def appendPoseParms(node: hou.OpNode, save_to_definition: bool = False, parmname: str = 'transformations') -> None: ...
def promoteComputeRigPoseParms(node: hou.OpNode, save_to_definition: bool = False) -> bool: ...
def createRigPoseParms() -> None: ...

from kinefx.ui.mixerutils import *
from kinefx.ui.mixerpaneactions import *
import _houqt
import hou
from collections.abc import Sequence
from houtypes import NodeEventKwargs
from hutil.PySide import QAction as QAction
from hutil.Qt import QtGui as QtGui, QtWidgets
from kinefx.ui.mixerutils import houdiniMotionMixerSourcesMimeType as houdiniMotionMixerSourcesMimeType
from typing import Literal, Never, TypedDict, Unpack

class _HipFileEventKwargs(TypedDict):
    type: Literal['clear', 'load', 'merge', 'save']
    after: bool

class _SelectionData(TypedDict):
    clips: list[int]
    clipTrackIds: list[int]
    keys: list[str]
    keyframes: list[str]
    node: str

class NleShotsculptPane(QtWidgets.QWidget):
    """ The main QWidget for the Houdini Python Panel. The file is split into
        multiple files because the class was getting too large."""
    myPaneTab: hou.PythonPanel
    myClipIcon: hou.qt.Icon
    myNodes: list[hou.SopNode]
    myDelayedRebuildNodes: Sequence[hou.Node]
    myDelayedChanges: list[tuple[str, None]]
    myMenuWidget: QtWidgets.QWidget | None
    copiedData: _SelectionData | dict[str, Never]
    myTimeline: _houqt.NLE_Timeline
    myTimelineView: _houqt.NLE_QtShotsculpt
    myModelItems: list[QtGui.QStandardItem]
    myModel: QtGui.QStandardItemModel | None
    myMenuBar: hou.qt.MenuBar
    myNodeNameLabel: QtWidgets.QLabel
    @classmethod
    def onCreateInterface(cls, pt: hou.PythonPanel) -> NleShotsculptPane:
        """ Entry point to create the widget and link it to a panel."""
    def __del__(self) -> None:
        """ NleShotsculptPane.__del__ removes the registered callbacks"""
    myLastDelayedTime: float
    myFirstResize: bool
    def __init__(self, pt: hou.PythonPanel) -> None:
        """ NleShotsculptPane.doinit"""
    def createMenus(self) -> None: ...
    def createMenuButtons(self, box: QtWidgets.QBoxLayout) -> None: ...
    def frameHome(self) -> None: ...
    def frameAll(self) -> None: ...
    def frameSelection(self) -> None: ...
    def onEditMenuAboutToShow(self) -> None: ...
    def onViewMenuAboutToShow(self) -> None: ...
    def onMinimizeTrackHeightsAction(self) -> None: ...
    def onResetTrackHeightsAction(self) -> None: ...
    def getColor_CurTrack(self) -> int: ...
    def getColor_OtherTracks(self) -> int: ...
    def getColorMode(self) -> str: ...
    def isShotNode(self) -> bool: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def onNleEvent(self, e: _houqt.NLE_Event) -> None:
        """ All NLE events callback."""
    def refreshScene(self) -> None: ...
    def rebuildScene(self, nodes: Sequence[hou.Node] | None) -> None: ...
    def addEventCallback(self, node: hou.OpNode, event_types: Sequence[hou.EnumValue[hou.nodeEventType]], cb: hou._NodeEventCallback) -> None: ...
    def removeEventCallback(self, node: hou.OpNode, event_types: Sequence[hou.EnumValue[hou.nodeEventType]], cb: hou._NodeEventCallback) -> None: ...
    def onNodeDeleted(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def onInputDataChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None:
        """ called when the input geometry changes. """
    def onParmTupleChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None:
        """ called when the node parameters changes. """
    def onParmTupleAnimated(self, **kwargs: Unpack[NodeEventKwargs]) -> None:
        """ called when the node parameters changes. """
    def onSpareParmChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None:
        """ called when the node spare parameters changes. """
    def onNodePathChanged(self, node: hou.Node | None = None) -> None:
        """ called when current node path changes."""
    def onParmTupleChannelChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None:
        """ called when the node parameters changes. """
    def onPlaybarEvent(self, event_type: hou.EnumValue[hou.playbarEvent], frame: float) -> None:
        """ Refresh when the global frame range changes, which is what an
            fps change raises, so the timeline picks up the new rate."""
    def delayedRefreshScene(self) -> None: ...
    def postDelayChange(self, change: tuple[str, None]) -> None:
        """ Post a DelayChange event if needed
            @change is a 2 elements tuple, with the first
            element as a type and the second as the data."""
    def onDelayedChanged(self) -> None:
        """ handle the delayed changed events in batch"""
    def onDestroyInterface(self) -> None: ...
    def onActivateInterface(self) -> None: ...
    def onDeactivateInterface(self) -> None: ...
    def onHipFileEvent(self, **kwargs: Unpack[_HipFileEventKwargs]) -> None:
        """ Single event callback for the load,clear,merge,save events"""
    def resizeEventInit(self) -> None: ...
    def resizeEvent(self, e: QtGui.QResizeEvent) -> None:
        """ resize event for the whole panel."""
    def getSelectedData(self) -> _SelectionData: ...
    def onCopyAction(self) -> None: ...
    def onCutAction(self) -> None: ...
    def onPasteAction(self) -> None: ...
    def onDeleteAction(self) -> None: ...
    def addTrack(self, mode: str) -> None: ...
    def onAddSculptTrack(self) -> None: ...
    def onAddBlendshapeTrack(self) -> None: ...
    def onAddAttributeTrack(self) -> None: ...
    def onAddClip(self) -> None: ...
    def onJumpToPrevPose(self) -> None: ...
    def onJumpToNextPose(self) -> None: ...
    def onJumpToPrevTrack(self) -> None: ...
    def onJumpToNextTrack(self) -> None: ...
    def onAddPose(self) -> None: ...
    def onSplitClip(self) -> None: ...
    def onMergeClips(self) -> None: ...
    def onSetTrackColor(self) -> None: ...
    def onSetClipColor(self) -> None: ...
    def onSetPoseColor(self) -> None: ...
    def onSetColorMode(self, mode: int) -> None: ...
    def onToggleColorCurTrack(self) -> None: ...
    def onToggleColorOtherTracks(self) -> None: ...
    def onImportPose(self) -> None: ...
    def onMuteTrack(self) -> None: ...
    def onLockTrack(self) -> None: ...
    def onSoloTrack(self) -> None: ...
    def isTrackSolo(self) -> bool | None: ...

class InitConfig:
    """ A wrapper config class with global functions."""
    available_actions: Callable[[_ActionsKwargs], Mapping[str, _RigAction | None] | None] | None
    select: Callable[[_SelectKwargs], object] | None
    drag_drop: Callable[[_DragDropKwargs], object] | None
    default_output: Callable[[_DefaultOutputKwargs], object] | None
    rename: Callable[[_RenameKwargs], object] | None
    get_selection: Callable[[_GetSelectionKwargs], object] | None
    delete: Callable[[_DeleteKwargs], object] | None
    def __init__(self, exec_res: Mapping[str, Any] | None = None) -> None: ...
    @property
    def state_name(self) -> None: ...
    @property
    def selection_mode(self) -> Literal[SelectionMode.MULTI_SELECTION]: ...
    @property
    def nodePath(self) -> None: ...

class GroupRigTreeConfig:
    """
    A config for nodes that have group parameters. The Rig Tree view will 
    react to selection when picking the group and will show the selection from
    the group parameter.
    
    Each parm selector handles its own config so this is not something that we need to
    set up per node or expose.
    """
    def __init__(self, show_dropdown: bool = False, parm_name: str = 'group', input_index: int = 0, node_path: str | None = None, accept_selection_cb: Callable[[], object] | None = None, cancel_selection_cb: Callable[[], object] | None = None, single_selection: bool = False, folders_mode: bool = False, select_cb: Callable[[_SelectKwargs], None] | None = None, subnet_outputs: bool = False) -> None: ...
    @property
    def single_selection(self) -> bool: ...
    @single_selection.setter
    def single_selection(self, single_selection: bool) -> None: ...
    @property
    def nodePath(self) -> str | None: ...
    @nodePath.setter
    def nodePath(self, selection_node_path: str | None) -> None: ...
    def inputIndex(self) -> int: ...
    def parmName(self) -> str: ...
    def parmString(self) -> str: ...
    def default_output(self, kwargs: _DefaultOutputKwargs) -> None: ...
    def get_control_visibility(self, kwargs: _ControlVisibilityKwargs) -> None: ...
    def get_selection(self, kwargs: _GetSelectionKwargs) -> Literal[True]: ...
    def accept_selection(self) -> None: ...
    def cancel_selection(self) -> None: ...
    def select(self, kwargs: _SelectKwargs) -> None: ...

class StateRigTreeConfig:
    """
    A config for nodes that have viewport state. Most of the callbacks
    are redirecting to state commands.
    """
    def __init__(self, widget: RigTreeWidget | None = None, default_output: int = 1, show_dropdown: bool = False, subnet_outputs: bool = False) -> None: ...
    @property
    def state_name(self) -> str | None: ...
    @state_name.setter
    def state_name(self, state_name: str | None) -> None: ...
    @property
    def selection_mode(self) -> SelectionMode: ...
    @selection_mode.setter
    def selection_mode(self, selection_mode: SelectionMode) -> None: ...
    @property
    def nodePath(self) -> str | None: ...
    @nodePath.setter
    def nodePath(self, selection_node_path: str | None) -> None: ...
    def runStateCommand(self, command: str, kwargs: _StateCommandKwargs | _GetSelectionCommandArgs) -> bool:
        """ Run a state command by name. Return False if an exception occured."""
    def default_output(self, kwargs: _DefaultOutputKwargs) -> None: ...
    def get_selection(self, kwargs: _GetSelectionKwargs) -> bool:
        """ Return the current selection from the state, by running a command. """
    def select(self, kwargs: _SelectKwargs) -> None: ...
    def drag_drop(self, kwargs: _DragDropKwargs) -> bool: ...
    def rename(self, kwargs: _RenameKwargs) -> bool: ...
    def delete(self, kwargs: _DeleteKwargs) -> bool: ...
    def available_actions(self, kwargs: _ActionsKwargs) -> dict[str, _RigAction | None]: ...

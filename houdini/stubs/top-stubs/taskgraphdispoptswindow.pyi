    cancelledWorkItems: QtWidgets.QCheckBox
    failedWorkItems: QtWidgets.QCheckBox
    workItemStateLayout: QtWidgets.QVBoxLayout
    sortComboBox: QtWidgets.QComboBox
    sortDirection: QtWidgets.QCheckBox
    collapseMode: QtWidgets.QComboBox
    workItemAttrToCollapseBy: QtWidgets.QLineEdit
    soloHighlightedWorkItems: QtWidgets.QCheckBox
    maxDepthInput: QtWidgets.QLineEdit
    maxRowsInput: QtWidgets.QLineEdit
    maxWorkItemsInput: QtWidgets.QLineEdit
    useWorkItemColorAttribute: QtWidgets.QCheckBox
    workItemColorAttribute: QtWidgets.QLineEdit
    def __init__(self, editor: hou.NetworkEditor) -> None: ...
    def changeWorkItemAttrToCollapseBy(self) -> None: ...
    def toggleUseWorkItemColorAttribute(self) -> None: ...
    def changeWorkItemColorAttribute(self) -> None: ...
    def toggleCookedWorkItems(self) -> None: ...
    def toggleCookingWorkItems(self) -> None: ...
    def toggleDirtyWorkItems(self) -> None: ...
    def toggleCancelledWorkItems(self) -> None: ...
    def toggleFailedWorkItems(self) -> None: ...
    def toggleSoloHighlightedWorkItems(self) -> None: ...
    def changeSortCriteria(self, criteria: str) -> None: ...
    def toggleSortDirection(self) -> None: ...
    def changeCollapseMode(self, collapse_mode: str) -> None: ...
    def changeMaxDepth(self) -> None: ...
    def changeMaxRows(self) -> None: ...
    def changeWorkItemsPerRow(self) -> None: ...
    def setEditor(self, editor: hou.NetworkEditor) -> None: ...

class TaskGraphDispOptsWindow(QtWidgets.QDialog):
    task_graph_disp_opts: TaskGraphDispOpts
    editor: hou.NetworkEditor
    def __init__(self, editor: hou.NetworkEditor) -> None: ...
    def setEditor(self, editor: hou.NetworkEditor) -> None: ...
    def placeNearMouse(self) -> None: ...

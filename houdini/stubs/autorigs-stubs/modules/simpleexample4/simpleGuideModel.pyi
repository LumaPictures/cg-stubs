from collections.abc import Callable as Callable

class SimpleModel:
    current_numbones: int
    numBonesChangedFcns: list[Callable[[int], object]]
    current_stretch: bool
    isStretchChangedFcns: list[Callable[[bool], object]]
    def __init__(self) -> None: ...
    def onNumBonesChanged(self, numbones: int) -> None: ...
    def registerNumBonesChangedFcn(self, fcn: Callable[[int], object]) -> None: ...
    def onStretchChanged(self, stretch: bool) -> None: ...
    def registerStretchChangedFcn(self, fcn: Callable[[bool], object]) -> None: ...

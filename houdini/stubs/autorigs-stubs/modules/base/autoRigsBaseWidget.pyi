import collections
import hou
from autorigs.modules.base.baseGuideModel import BaseGuideModel as BaseGuideModel
from autorigs.modules.base.buildBaseGuide import BaseGuide as BaseGuide
from collections.abc import Sequence
from hutil.Qt import QtWidgets
from typing import Any, Generic

from typing import TypeVar
from typing_extensions import TypeVar
_WidgetJson = TypeVar('_WidgetJson', default=Any)
_Model = TypeVar('_Model', bound=BaseGuideModel, default=Any)
_Guide = TypeVar('_Guide', bound=BaseGuide, default=Any)
class AutoRigsBaseWidget(QtWidgets.QWidget, Generic[_WidgetJson]):
    submodules: dict[str, Any]
    def __init__(self) -> None: ...
    def hasUnsavedChanges(self) -> bool | None: ...
    def markSaved(self) -> None: ...
    def setLayout(self, layout: QtWidgets.QLayout, has_scroll: bool = True) -> None: ...
    def unlinkAllNodes(self) -> None: ...
    def toJSON(self) -> _WidgetJson: ...
    def fromJSON(self, json: _WidgetJson) -> None: ...

class BaseOptionsWidget(AutoRigsBaseWidget[_WidgetJson], Generic[_WidgetJson, _Model]):
    model: _Model
    def __init__(self, model: _Model) -> None: ...
    def hasUnsavedChanges(self) -> bool: ...
    def markSaved(self) -> None: ...

class BaseParamWidget(AutoRigsBaseWidget[_WidgetJson], Generic[_WidgetJson, _Guide]):
    widgetsDict: collections.OrderedDict[str | int, Any]
    buildguide: _Guide
    def __init__(self, buildguide: _Guide) -> None: ...
    def hasUnsavedChanges(self) -> None: ...
    def markSaved(self) -> None: ...
    def createParamLayout(self, name: str, label: str | None, params: Sequence[int], node: hou.OpNode | None = None) -> QtWidgets.QVBoxLayout: ...
    def unlinkAllNodes(self) -> None: ...
    def toJSON(self) -> _WidgetJson: ...
    def fromJSON(self, json: _WidgetJson) -> None: ...
    def getWidgetsDict(self) -> collections.OrderedDict[str | int, Any]: ...

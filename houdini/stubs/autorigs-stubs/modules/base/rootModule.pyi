import hou
from autorigs.asset.autoRigsAsset import AutoRigsAsset as AutoRigsAsset
from autorigs.modules.base import moduleTabsWidget as _baseTabs
from autorigs.modules.base.buildBaseGuide import BaseGuide as BaseGuide
from autorigs.ui import moduleListItemWidget as moduleListItemWidget, moduleTabsWidget as _uiTabs
from collections.abc import Mapping, Sequence
from typing import Any, Generic, NotRequired, Protocol, ReadOnly, TypedDict

from typing import TypeVar
from typing_extensions import TypeVar
_OptionsJson = TypeVar('_OptionsJson', default=Any)
_ParamsJson = TypeVar('_ParamsJson', default=Any)
_GuidesJson = TypeVar('_GuidesJson', default=Any)
_OptionsWidget = TypeVar('_OptionsWidget', bound=_GuideTabWidget, default=Any)
_ParamsWidget = TypeVar('_ParamsWidget', bound=_GuideTabWidget, default=Any)
_Guide = TypeVar('_Guide', bound=BaseGuide, default=Any)
_Rig = TypeVar('_Rig', default=Any)
_Model = TypeVar('_Model', default=Any)
_Controller = TypeVar('_Controller', default=Any)
class _GuideTabWidget(Protocol):
    def toJSON(self) -> Mapping[str, object]: ...
    def fromJSON(self, json: Any, /) -> bool | None: ...

class _GuideTabJson(TypedDict, Generic[_OptionsJson, _ParamsJson, _GuidesJson]):
    options: _OptionsJson
    guideparams: _ParamsJson
    buildguides: _GuidesJson

class _ModuleJson(_GuideTabJson[_OptionsJson, _ParamsJson, _GuidesJson], closed=True):  # type: ignore[call-arg]
    moduletype: str
    modulename: str
    modulenode: NotRequired[ReadOnly[str]]
    bypass: NotRequired[bool]
    lock: bool
    display: bool

class _ModuleJsonWithNode(_ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]):
    modulenode: ReadOnly[str]  # type: ignore[misc]  # PEP 705 allows making a ReadOnly key required; mypy does not yet

class Module(Generic[_OptionsJson, _ParamsJson, _GuidesJson, _OptionsWidget, _ParamsWidget, _Guide, _Rig, _Model, _Controller]):
    MODULE_DEFAULT_NAME: str
    guidetab: ModuleGuideTab[_OptionsJson, _ParamsJson, _GuidesJson, _OptionsWidget, _ParamsWidget, _Guide] | None
    bypass: bool
    display: bool
    lock: bool
    modulename: str
    listwidget: moduleListItemWidget.ModuleListItemWidget | None
    builtrig: _Rig
    modulenode: hou.ObjNode | None
    autorigs_asset: AutoRigsAsset | None
    model: _Model
    controller: _Controller
    index: int | None
    buildguides: _Guide
    hookrigmapping: dict[str, hou.ObjNode | None]
    MODULE_TYPE: str
    MODULE_STYLE: int
    def __init__(self) -> None: ...
    def updateParent(self, modulesdict: Mapping[str, Sequence['Module']]) -> None: ...
    def setLock(self, toggle: bool) -> None: ...
    def setDisplay(self, toggle: bool) -> None: ...
    def setModuleName(self, name: str) -> None: ...
    def setModuleNode(self, node: hou.ObjNode) -> None: ...
    def setBypass(self, toggle: bool) -> None: ...
    def rename(self, name: str) -> None: ...
    def destroy(self) -> None: ...
    def unlink(self) -> None: ...
    def getModuleType(self) -> str: ...
    def getModuleStyle(self) -> int: ...
    def setModuleStyle(self, style: int) -> int: ...
    def setAutoRigsAsset(self, asset: AutoRigsAsset) -> None: ...
    def getModuleName(self) -> str: ...
    def getModuleNode(self) -> hou.ObjNode | None: ...
    def getOptions(self) -> _OptionsWidget: ...
    def getGuideObject(self, guidekey: str) -> Any: ...
    def getBuiltObject(self, builtkey: str) -> Any: ...
    def getParams(self) -> _ParamsWidget: ...
    def getBypass(self) -> bool: ...
    def getAutoRigsAsset(self) -> AutoRigsAsset | None: ...
    def getModel(self) -> _Model: ...
    def getController(self) -> _Controller: ...
    def getIndex(self) -> int | None: ...
    def deleteGuides(self) -> None: ...
    def getGuideTabs(self) -> ModuleGuideTab[_OptionsJson, _ParamsJson, _GuidesJson, _OptionsWidget, _ParamsWidget, _Guide] | None: ...
    def getBuiltParentHook(self, guidename: str) -> hou.ObjNode | None: ...
    def createListWidget(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson], hasbypass: bool = True) -> None: ...
    def buildAfterImport(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]) -> None: ...
    def getListWidget(self) -> moduleListItemWidget.ModuleListItemWidget | None: ...
    def getTabsWidget(self) -> _baseTabs.ModuleTabsWidget | _uiTabs.ModuleTabsWidget: ...
    def toJSON(self) -> _ModuleJsonWithNode[_OptionsJson, _ParamsJson, _GuidesJson]: ...
    def hasUnsavedChanges(self) -> bool | None: ...
    def buildFromDefault(self) -> None: ...
    def buildRig(self, index: int) -> None: ...
    def buildFromJsonNew(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]) -> None: ...
    def buildFromJsonExisting(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]) -> None: ...
    def getMainHook(self) -> hou.ObjNode | None: ...
    def postRigBuild(self) -> None:
        """This is called after all the modules have bene built and hooked up"""
    def canBeMirrored(self) -> bool: ...

class ModuleGuideTab(Generic[_OptionsJson, _ParamsJson, _GuidesJson, _OptionsWidget, _ParamsWidget, _Guide]):
    moduleType: str
    tabswidget: _baseTabs.ModuleTabsWidget | _uiTabs.ModuleTabsWidget
    optionswidget: _OptionsWidget
    paramswidget: _ParamsWidget
    buildguides: _Guide
    def __init__(self) -> None: ...
    def unlinkAllNodes(self) -> None: ...
    def rename(self, name: str) -> None: ...
    def setLock(self, lock: bool) -> None: ...
    def getTabsWidget(self) -> _baseTabs.ModuleTabsWidget | _uiTabs.ModuleTabsWidget: ...
    def getOptions(self) -> _OptionsWidget: ...
    def getParams(self) -> _ParamsWidget: ...
    def toJSON(self) -> _GuideTabJson[_OptionsJson, _ParamsJson, _GuidesJson]: ...
    def fromJSON(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]) -> bool | None: ...
    def buildFromJson(self, json: _ModuleJson[_OptionsJson, _ParamsJson, _GuidesJson]) -> None: ...
    def hasUnsavedChanges(self) -> bool | None: ...

import collections
import hou
from autorigs.modules.base.rootModule import _ModuleJson
from collections.abc import Sequence
from typing import Any, Generic, TypedDict

from typing import TypeAlias
from typing import TypeVar
from autorigs.utils.buildGuideHelper import _GuideNames
from collections.abc import Mapping
from typing import TypeAlias
from typing_extensions import TypeVar
_BaseGuideJson: TypeAlias = collections.OrderedDict[str, _GuideNames]
_GuideJson_co = TypeVar('_GuideJson_co', bound=Mapping[str, object], covariant=True, default=Mapping[str, object])
_GuideNamesJson: TypeAlias = Mapping[str, Mapping[str, str]]
class _GuideXformJson(TypedDict, total=False):
    translate: Sequence[float]
    rotate: Sequence[float]
    scale: Sequence[float]
    size: float
    color: Sequence[float]
    radius: Sequence[float]

class BaseFactory:
    @classmethod
    def createFromDefault(cls) -> BaseGuide | None: ...
    @classmethod
    def createFromJsonNew(cls, json: _ModuleJson) -> BaseGuide | None: ...
    @classmethod
    def createFromJsonExisting(cls, json: _ModuleJson) -> BaseGuide | None: ...

class BaseGuide(Generic[_GuideJson_co]):
    display: bool
    toggled: bool
    subguides: list['BaseGuide']
    guidenodesdata: dict[str, Any]
    BUILD_ERROR_MSG: str
    def __init__(self) -> None: ...
    def deleteGuides(self) -> None: ...
    def displayGuides(self, display: bool) -> None: ...
    def updateDisplay(self) -> None: ...
    def showGuides(self, value: bool) -> None: ...
    def displayGuideData(self, guidedata: Sequence[Any], display: bool) -> None: ...
    def lockGuides(self, lock: bool) -> None: ...
    def lockGuideData(self, guidedata: hou.OpNode, lock: bool) -> None: ...
    def lockGuide(self, guide: hou.OpNode, lock: bool) -> None: ...
    def getGuideNodesData(self) -> dict[str, Any]: ...
    def getGuideData(self, guidename: str) -> Any: ...
    def getGuideObject(self, guidename: str) -> Any: ...
    def getBuildErrorMsg(self) -> str: ...
    def removeGuideObject(self, guidename: str) -> Any: ...
    def setGuideDisplay(self, guidename: str, display: bool) -> None: ...
    def isToggled(self) -> bool: ...
    def toggleModule(self, toggle: bool) -> None: ...
    def toJSON(self) -> _GuideJson_co: ...

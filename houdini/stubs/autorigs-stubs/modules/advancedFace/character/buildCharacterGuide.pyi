import hou
from . import characterGuideParams as characterGuideParams
from autorigs.modules.advancedFace.cage.buildCageGuide import CageGuide as CageGuide
from autorigs.modules.advancedFace.template.buildTemplateGuide import TemplateGuide as TemplateGuide
from autorigs.modules.base import buildBaseGuide as buildBaseGuide
from autorigs.modules.geometry.buildGeometryGuide import GeometryGuide as GeometryGuide
from autorigs.utils import faceutils as faceutils
from collections import OrderedDict
from collections.abc import Container, Mapping, Sequence
from typing import TypedDict

class _CharacterGuideJson(TypedDict):
    locator_index: int
    locator_keys: Sequence[str]
    parent_keys: Sequence[str]
    guidenames: Mapping[str, str]

class CharacterGuide(buildBaseGuide.BaseGuide[_CharacterGuideJson]):
    assetnode: hou.ObjNode
    geometryguides: GeometryGuide
    templateguides: TemplateGuide
    cageguides: CageGuide
    locator_index: int
    locator_nodes: OrderedDict[hou.ObjNode, str]
    parent_nodes: OrderedDict[str, hou.ObjNode]
    json: _CharacterGuideJson | None
    LPC_GEO: str
    LPC_GEO_FILE: str
    JSON_KEY: str
    LPC_CHARACTER: str
    CONSTRAINTS: str
    GEO_FILE: str
    BLENDSHAPES: str
    BS_OUT: str
    DEFORM_OUT: str
    LOCATOR_KEY: str
    PARENT_KEY: str
    def __init__(self, assetnode: hou.ObjNode, geometryguides: GeometryGuide, templateguides: TemplateGuide, cageguides: CageGuide) -> None: ...
    def buildFromJsonNew(self) -> None: ...
    def renameGuides(self) -> None: ...
    def buildFromJsonExisting(self, json: _CharacterGuideJson) -> None: ...
    def isBuilt(self) -> bool: ...
    def deleteGuides(self) -> None: ...
    def toJSON(self) -> _CharacterGuideJson: ...
    def generateCharacter(self) -> None: ...
    def sopCreateEdit(self, name: str, sop1: hou.SopNode, sop2: hou.SopNode) -> hou.SopNode | None: ...
    def findNodeByType(self, parent: hou.OpNode, type_name: str) -> hou.OpNode | None: ...
    def bakeCage(self) -> None:
        """Bake the low poly cage from template to character specific poly cage"""
    def createCPCNetwork(self) -> hou.ObjNode: ...
    def saveGeometry(self, sop: hou.SopNode, node: hou.OpNode, name: str) -> None: ...
    def createSurfacePatchingNetwork(self, sop_input: hou.SopNode) -> None: ...
    def createSurfacePatchingInterface(self) -> None: ...
    def createLocator(self, name: str, key: str | None = None) -> hou.ObjNode: ...
    def removeNode(self, key: str) -> None: ...
    def removeLocator(self, locator: hou.ObjNode) -> None: ...
    def createCustomParentLocator(self, name: str, key: str, uv: hou.Vector3) -> hou.ObjNode:
        """Creates an offset guide hovering over the given uv"""
    def updateParentLocator(self, locator: hou.ObjNode, uv: hou.Vector3) -> hou.ObjNode: ...
    def getPrimNameFromPrimId(self, prim_id: int) -> str: ...
    def getNurbsParentName(self, prim_id: int) -> str: ...
    def createNurbsParentLocator(self, name: str, key: str, prim: int) -> hou.ObjNode: ...
    def createParentLocator(self, name: str, key: str) -> hou.ObjNode: ...
    def setParmsFromUV(self, node: hou.ObjNode, uv: hou.Vector3) -> None:
        """Sets the translates and rotates of the node so that it is hovering above the provided uv
            coordinates and rotated tangentially with the z-axis pointing away from the surface"""
    def clearBlendShapes(self, blendshapes: hou.OpNode, tmp_inputs: Container[str]) -> dict[str, int]: ...
    def getLocatorNodes(self) -> OrderedDict[hou.ObjNode, str]: ...
    def getLocatorKeyAtIndex(self, index: int) -> str: ...
    def getParentKeyAtIndex(self, index: int) -> str: ...
    def sortLocatorKeys(self, tup: tuple[hou.ObjNode, str]) -> int: ...
    def sortParentKeys(self, tup: tuple[str, hou.ObjNode]) -> int: ...
    def getGeometryGuide(self) -> GeometryGuide: ...
    def getParentNodes(self) -> OrderedDict[str, hou.ObjNode]: ...
    def getRootKey(self) -> str: ...
    def getRootNode(self) -> hou.ObjNode | None: ...
    def getConstraintsNode(self) -> hou.SopNode | None: ...
    def setJSON(self, json: _CharacterGuideJson) -> None: ...

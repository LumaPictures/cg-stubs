class LimbGuideTab(Mod.ModuleGuideTab[_LimbOptionsJson, _LimbParamsJson, _GuideNamesJson, _LimbOptions, _LimbParams, _LimbGuide, moduleTabsWidget.ModuleTabsWidget], Generic[_LimbOptions, _LimbParams, _LimbGuide]):

class UiModuleList(QtWidgets.QWidget):
    autorigs_asset: AutoRigsAsset
    charactertab: UiCharacterTab
    all_widget: TopAllItem
    modulenames: set[str]
    modulelist: QtWidgets.QListWidget
    rightclickmenu: QtWidgets.QMenu
    moduledetails: hou.qt.ParmDialog
    modulenode: hou.ObjNode | None
    moduleChanged: QtCore.Signal
    def __init__(self, autorigs_asset: AutoRigsAsset, charactertab: UiCharacterTab) -> None: ...
    def initializeList(self, autorigs_asset: AutoRigsAsset) -> None: ...
    def appendModuleWidget(self, listitem: QtWidgets.QListWidgetItem, widget: QtWidgets.QWidget) -> None: ...
    def appendNewModule(self, module: Module) -> None: ...
    def rename(self, itemwidget: ModuleListItemWidget, newname: str, creating: bool = True) -> str: ...

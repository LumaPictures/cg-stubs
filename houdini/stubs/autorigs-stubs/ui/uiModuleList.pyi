    def onDisplayDetail(self, i: int) -> None: ...
    def onDisplayContextMenu(self, point: QtCore.QPoint) -> None: ...
    def onRightClickDelete(self) -> None: ...
    def onRightClickRename(self) -> None: ...
    def onRightClickExport(self) -> None: ...
    def getToggleWidgets(self) -> list[ModuleListItemWidget]:
        """ If the item is not a selected item, we toggle the item only
            Otherwise, we toggle all the items that are selected """
    def lockAll(self, lock: bool) -> None: ...
    def displayAll(self, display: bool) -> None: ...
    def bypassAll(self, bypass: bool) -> None: ...
    def onClickBypass(self, toggle: bool) -> None: ...
    def onClickLock(self, toggle: bool) -> None: ...
    def onClickDisplay(self, toggle: bool) -> None: ...
    def updateAllDisplay(self) -> None: ...
    def updateAllLock(self) -> None: ...
    def updateAllBypass(self) -> None: ...
    def shouldToggleAllBypass(self) -> bool: ...
    def shouldToggleAllLock(self) -> bool: ...
    def shouldToggleAllDisplay(self) -> bool: ...
    def deleteAllModules(self) -> None: ...
    def reset(self) -> None: ...

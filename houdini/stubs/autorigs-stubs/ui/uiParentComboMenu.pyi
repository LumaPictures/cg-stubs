import collections
import hou
from autorigs.modules.base.rootModule import Module as Module
from collections.abc import Callable as Callable, Iterable, Sequence
from hutil.PySide import QtWidgets
from typing import Any

class UiParentComboMenu(QtWidgets.QWidget):
    """ default_parent = (op, i, gi) where op is the module type, i is
        the index of the module, and gi is the index of the guide obj.
        The default parent should always exist (aka master)
        Existing parents is a list of parents and guides that already
        exist in the autorigs system. potential_parents are what
        the module could attach to if they existed. potential_parents
        is a list of module types """
    label: QtWidgets.QLabel
    combomenu: QtWidgets.QPushButton
    warningimport: QtWidgets.QToolButton
    current_selection: tuple[str, Module, hou.ObjNode] | None
    default_parent: tuple[str, int, int]
    updateparent_callback: Callable[[Any, hou.ObjNode], object] | None
    error_json_import: Sequence[str] | None
    ordered_potentials: collections.OrderedDict[str, list[tuple[Module, Sequence[hou.ObjNode]]]]
    def __init__(self, label: str, default_parent: tuple[str, int, int], existing_parents: Iterable[tuple[Module, Sequence[hou.ObjNode]]], ordered_potential_parents: Iterable[str], updateparent_callback: Callable[[Any, hou.ObjNode], object] | None = None) -> None: ...
    def updateParents(self, item_infos: Iterable[tuple[Module, Sequence[hou.ObjNode]]]) -> None: ...
    def createImportWarning(self) -> QtWidgets.QToolButton: ...
    def currentStillExist(self) -> bool: ...
    def parentTypeInPotential(self, parenttype: str) -> bool: ...
    def clearPotentials(self) -> None: ...
    def updateParentCombo(self) -> None:
        """ We create a new qmenu everytime because there's a weird bug
            in QT or the code that doesn't seem to allow QMenu
            to dynamically add more menu items without the menu appearing
            in the wrong place. For example, if you add a head then
            add a spine, then click on the button, then the menu
            shows up at the wrong place if a new menu is not added.
            This is just a hack to go around that problem for now """
    def updateParent(self, op: str, i: int, gi: int) -> None: ...
    def getCurrentSelection(self) -> tuple[str, Module, hou.ObjNode] | None: ...
    def validParentIds(self, moduletype: str, modulename: str, guidename: str) -> tuple[str, int, int] | None: ...
    def parentChanged(self) -> None: ...
    def updateItemInfos(self, existing_parents: Iterable[tuple[Module, Sequence[hou.ObjNode]]]) -> None: ...
    def getModuleGuideText(self, modulename: str, guidename: str) -> str: ...
    def setCurrentSelection(self, parentmodule: Module, node: hou.ObjNode) -> None: ...
    def displayWarningJson(self, json: Sequence[str]) -> None: ...
    def unDisplayWarningJson(self) -> None: ...
    def toJSON(self) -> tuple[str, str, str]: ...
    def fromJSON(self, json: Sequence[str]) -> None: ...

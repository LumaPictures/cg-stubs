from collections.abc import Mapping, Sequence
from typing import Protocol

class _HasInterfaceNameLabel(Protocol):
    @property
    def INTERFACE_NAME_LABEL(self) -> Mapping[str, Sequence[str]]: ...

class _HasMatchFKIKPostfix(Protocol):
    @property
    def MATCH_FK_IK_POSTFIX(self) -> str: ...

class _HasMatchIKFKPostfix(Protocol):
    @property
    def MATCH_IK_FK_POSTFIX(self) -> str: ...

def getInterfaceName(cls: _HasInterfaceNameLabel, prefix: str, key: str) -> str: ...
def getMatchFKIKFcnName(cls: _HasMatchFKIKPostfix, prefix: str) -> str: ...
def getMatchIKFKFcnName(cls: _HasMatchIKFKPostfix, prefix: str) -> str: ...

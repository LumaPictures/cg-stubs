class MixerSurface(QtWidgets.QFrame):
    def __init__(self, view: MixerView, index: _AnyIndex, parent: QtWidgets.QWidget | None = None) -> None: ...
    def insertRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def removeRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def backgroundColor(self) -> QtGui.QColor | None: ...
    def setBackgroundColor(self, color: QtGui.QColor | None) -> None: ...
    def view(self) -> MixerView | None: ...
    def index(self) -> QtCore.QPersistentModelIndex: ...
    def model(self) -> husdui.models.ItemModelProxyBase | None: ...
    def widgets(self) -> list[Strip | Group]: ...
    def findIndex(self, index: _AnyIndex) -> Strip | Group | None: ...
    def reset(self) -> None: ...
    def clear(self) -> None: ...
    def resetDisplay(self) -> None: ...
    def item(self) -> None: ...

class RootSurface(MixerSurface):
    def __init__(self, view: MixerView, parent: QtWidgets.QWidget | None = None) -> None: ...
    def resetDisplay(self) -> None: ...

class Mixable(QtWidgets.QFrame):
    """
    Base class for an individual item that can have sliders for specified
    attributes.
    """
    solo_column: int
    mute_column: int
    active_column: int
    color_column: int
    hotkeyInvoked: ClassVar[QtCore.Signal]
    def __init__(self, view: MixerView, index: _AnyIndex, parent: QtWidgets.QWidget | None = None) -> None: ...
    def backgroundColor(self) -> QtGui.QColor: ...
    def setControls(self, shown: Container[str]) -> None: ...
    def actions(self) -> list[QtGui.QAction]: ...
    def setBackgroundColor(self, color: QtGui.QColor) -> None: ...
    def view(self) -> MixerView | None: ...
    def model(self) -> husdui.models.ItemModelProxyBase | None: ...
    def index(self) -> QtCore.QPersistentModelIndex: ...
    def item(self) -> husdui.models.Item | None: ...
    def orientation(self) -> QtCore.Qt.Orientation: ...
    def name(self) -> str | Literal[False] | None: ...
    def icon(self) -> QtGui.QIcon | Literal[False] | None: ...
    def attr(self, column: int) -> Any: ...
    def setBreadth(self, breadth: int) -> None: ...
    def reset(self) -> None: ...
    def resetDisplay(self) -> None: ...
    def showControl(self, attr_name: str) -> None: ...
    def hideControl(self, attr_name: str) -> None: ...
    def setShown(self, attr_names: Container[str]) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...

class Strip(Mixable):
    """
    A group of controls and sliders for an item (light or collection).
    """
    def __init__(self, view: MixerView, index: _AnyIndex, column_list: Iterable[str], panel: Group | None = None) -> None: ...
    def panel(self) -> Group | None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...

class Group(Mixable):
    """
    A pane for a collection that will contain a master slider 'Strip' as well
    as a subpane of all items in the collection.
    """
    def __init__(self, view: MixerView, index: _AnyIndex, column_list: Iterable[str], parent: QtWidgets.QWidget | None = None) -> None: ...
    def setControls(self, controls: Container[str]) -> None: ...
    def isExpanded(self) -> bool: ...
    def setExpanded(self, expanded: bool) -> None: ...
    def insertRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def removeRows(self, parent_index: _AnyIndex, start: int, end: int) -> bool: ...
    def resetDisplay(self) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...

class MixerView(QtWidgets.QScrollArea):
    """
    A mixing panel style view for adjusting attributes with sliders
    """
    hotkeyInvoked: ClassVar[QtCore.Signal]
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    def model(self) -> husdui.models.ItemModelProxyBase | None: ...
    def setModel(self, model: husdui.models.ItemModelProxyBase | None) -> None: ...
    def selectedIndexes(self) -> list[QtCore.QModelIndex]: ...
    def selectedRows(self) -> list[QtCore.QModelIndex]: ...
    def selectionModel(self) -> QtCore.QItemSelectionModel | None: ...
    def setSelectionModel(self, selectmodel: QtCore.QItemSelectionModel) -> None: ...
    def orientation(self) -> QtCore.Qt.Orientation: ...
    def setOrientation(self, orientation: QtCore.Qt.Orientation) -> None: ...
    def minimumDragLength(self) -> int: ...
    def setMinimumDragLength(self, mindraglength: int) -> None: ...
    def setExpanded(self, index: _AnyIndex, expanded: bool) -> None: ...
    def indexAt(self, pos: QtCore.QPoint) -> QtCore.QModelIndex | QtCore.QPersistentModelIndex: ...
    def widgetAtIndex(self, index: _AnyIndex) -> Strip | Group | None: ...
    def valueBox(self) -> husdui.widgets.PointingLabel: ...
    def scrollTo(self, index: _AnyIndex, hint: QtWidgets.QAbstractItemView.ScrollHint) -> None: ...
    def moveCursor(self, cursoraction: QtWidgets.QAbstractItemView.CursorAction, modifiers: QtCore.Qt.KeyboardModifier) -> None: ...
    def reset(self) -> None: ...
    def resetDisplay(self) -> None: ...
    def createWidgetForIndex(self, index: _AnyIndex, strip: bool = False) -> Strip | Group: ...
    sliderDragFinished: ClassVar[QtCore.Signal]
    def isSliderDragging(self) -> bool: ...
    def sliderDragStarted(self) -> None: ...
    def sliderDragEnded(self) -> None: ...
    def clearExpansionState(self) -> None: ...
    def restoreExpansionState(self) -> None: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def dragEnterEvent(self, event: QtGui.QDragEnterEvent) -> None: ...
    def dragMoveEvent(self, event: QtGui.QDragMoveEvent) -> None: ...
    def dragLeaveEvent(self, event: QtGui.QDragLeaveEvent) -> None: ...
    def dropEvent(self, event: QtGui.QDropEvent) -> None: ...

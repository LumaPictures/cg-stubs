import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets
import hou
import resourceui as rui
from collections.abc import Callable as Callable
from hutil.PySide import QtWidgets
from hutil.qt.pluto.parts import ParmState
from typing import Unpack
from viewerhandle import hudapi as hudapi
from viewerhandle.hudapi import _HUDHandle, _HUDParmAnimatedKwargs, _HUDParmChangeKwargs, _HUDParmTemplateChangeKwargs, _HUDSettings
from viewerhandle.hudwidgets import _HUDWidgetOptions, _KeyFrameEventKwargs

class ToggleImpl(QtWidgets.QWidget):
    """ The hud toggle widget implementation:
        [fixed spacing][checkbox][parm label]
    """
    def __init__(self, label: str, tooltip: str | None = None, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def toggle(self) -> rui.ToggleWidget: ...
    def label(self) -> rui.LabelEdit: ...
    def leftMargin(self) -> PySide6.QtWidgets.QLabel: ...
    def factoryStyleSheet(self) -> str: ...
    def lockUI(self, value: int) -> None: ...
    def setVisualSize(self, visual_size: int) -> None: ...
    def visualSize(self) -> int: ...
    def sizeHint(self) -> PySide6.QtCore.QSize: ...
    def updateValue(self, value: object) -> None: ...
    def connectToValueChange(self, callback: Callable[[int], object]) -> None: ...
    def eventFilter(self, source: PySide6.QtCore.QObject, event: PySide6.QtCore.QEvent) -> bool:
        """ Show the tooltip when entering
        """
    def onUpdateShadowEffectState(self, value: bool) -> None: ...
    def hasShadowEffect(self) -> bool: ...

class HUDToggle(hudapi.HUDWidgetBase):
    """ HUD handle widget to manipulate a toggle parm.
    """
    def __init__(self, handle: _HUDHandle, target_parm: hou.Parm | None, hud_widget_key: str, window_key: str, **kwargs: Unpack[_HUDWidgetOptions]) -> None: ...
    def onParmChangeEvent(self, kwargs: _HUDParmChangeKwargs) -> None: ...
    def onUpdateVisualSize(self) -> None: ...
    def settingValues(self) -> _HUDSettings: ...
    def onUpdateShadowEffectState(self, value: bool) -> None: ...
    def hasShadowEffect(self) -> bool: ...
    def onUpdateLabelColor(self, color: PySide6.QtGui.QColor) -> None: ...
    def onLockHandle(self, value: bool) -> None: ...
    def onUpdateHandleLock(self, parms_update: list[int] | None = None) -> None: ...
    def supportKeyFrames(self) -> bool:
        """ Return True if the HUD widgets can set or remove key
            frames on the target parm.
        """
    def setKeyFrame(self) -> None:
        """ Set a key frame on the target parm. Must be implemented by
            the derived class.
        """
    def removeKeyFrame(self) -> None: ...
    def hasKeyFrame(self, frame: float | None) -> bool: ...
    def hasPendingChange(self) -> bool: ...
    def onParmAnimatedEvent(self, kwargs: _HUDParmAnimatedKwargs) -> None: ...
    def isLocked(self) -> bool: ...
    def onTerminate(self) -> None: ...
    def onParmTemplateChangeEvent(self, kwargs: _HUDParmTemplateChangeKwargs) -> None:
        """ Update the HUD when the parm template has changed.
        """
    def onToggleValueChange(self, value: int) -> None:
        """ Update the node with the new toggle value
        """
    def onDeferSetDefault(self, parm_value: object) -> None: ...
    def onKeyFrameEvent(self, event: int, kwargs: _KeyFrameEventKwargs) -> None: ...
    def onParmStateChanged(self, state: ParmState) -> None: ...

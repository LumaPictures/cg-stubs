import enum
from charpicker.tabview import TabView as TabView
from enum import Enum, Flag
from hutil.PySide import QtCore, QtGui, QtWidgets
from typing import Protocol

class _ResizeTarget(Protocol):
    @property
    def myId(self) -> str: ...
    def geometry(self, /) -> QtCore.QRect: ...
    def installEventFilter(self, filterObj: QtCore.QObject, /) -> None: ...
    def removeEventFilter(self, obj: QtCore.QObject, /) -> None: ...
    def supportsRotation(self) -> bool: ...
    def contentsSize(self) -> tuple[float, float]: ...
    def resizeMode(self) -> ResizeMode: ...

class ResizeMode(Enum):
    FREE = enum.auto()
    SYMMETRIC = enum.auto()
    KEEP_ASPECT = enum.auto()

class ResizeEdge(Flag):
    N = enum.auto()
    S = enum.auto()
    E = enum.auto()
    W = enum.auto()
    NE = ...
    NW = ...
    SE = ...
    SW = ...

def oppositeEdge(edge: ResizeEdge) -> ResizeEdge:
    """Return the edge opposite to the given one."""

class _PreserveSizesToggle(QtWidgets.QWidget):
    activeChanged: QtCore.Signal
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    def setActive(self, active: bool) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...

class ResizeWidget(QtWidgets.QWidget):
    """Overlay widget that draws resize handles around a target widget.

    Sits as a sibling of the target (child of the same parent) and extends
    beyond the target rect so handles appear *outside* the shape boundary.

    """
    def __init__(self, target: _ResizeTarget, canvas: TabView, parent: QtWidgets.QWidget, show_preserve_sizes_toggle: bool = False) -> None: ...
    def target(self) -> _ResizeTarget: ...
    def isDragActive(self) -> bool:
        """True if a resize or rotation drag is currently in progress."""
    @staticmethod
    def handleSize() -> int: ...
    @staticmethod
    def margin() -> int: ...
    def reposition(self) -> None: ...
    def eventFilter(self, obj: QtCore.QObject, event: QtCore.QEvent) -> bool: ...
    def cleanup(self) -> None:
        """Remove event filter and schedule deletion."""
    def paintEvent(self, event: QtGui.QPaintEvent) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def keyReleaseEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...

from . import cpglobals as cpglobals
from PySide6 import QtCore as QtCore, QtGui
from charpicker.backgroundimage import BackgroundImage as BackgroundImage
from charpicker.canvasitem import CanvasItem as CanvasItem
from charpicker.canvaslabel import CanvasLabel as CanvasLabel
from charpicker.controlbutton import ControlButton as ControlButton
from charpicker.resizewidget import ResizeEdge as ResizeEdge
from charpicker.tabwindow import TabWindow as TabWindow, _TabDict

from typing import TypeAlias
from typing import TypeAlias
_ButtonPropertyValue: TypeAlias = list[str] | str | bool | QtGui.QAction
class ViewUndoBase:
    """Base class for undos that operate on a TabView."""
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int) -> None: ...

class UndoAlignSpace(ViewUndoBase):
    x: int
    y: int
    newX: int
    newY: int
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, item: CanvasItem, newX: int, newY: int) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def swap(self) -> None: ...

class UndoAddButton(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, button: ControlButton) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoDeleteButton(UndoAddButton):
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoMoveCanvasItem(ViewUndoBase):
    pos: QtCore.QPoint
    old_pos: QtCore.QPoint
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, item_id: str, old_pos: QtCore.QPoint) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def swap(self) -> None: ...

class UndoAddTab:
    tabwindow: TabWindow
    index: int
    json_string: str
    json_data: _TabDict
    def __init__(self, tabwindow: TabWindow, index: int) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoDelTab(UndoAddTab):
    def __init__(self, tabwindow: TabWindow, index: int) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoProperty(ViewUndoBase):
    prop: str
    old: _ButtonPropertyValue
    new: _ButtonPropertyValue
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, button_id: str, prop: str, old: _ButtonPropertyValue, new: _ButtonPropertyValue) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def swap(self) -> None: ...

class UndoResizeCanvasItem(ViewUndoBase):
    """Undo for canvas item (button or image) resize operations.

    old_width/new_width can be None (auto-sized from text), handling both
    resize and fit-to-text transitions for buttons.
    """
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, item_id: str, old_width: float | None, old_height: float | None, new_width: float | None, new_height: float | None, anchor: ResizeEdge | None = None) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoResizeBg(ViewUndoBase):
    """Undo for resizing the background image."""
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, old_bg_w: int, old_bg_h: int, new_bg_w: int, new_bg_h: int, origin_dx: int = 0, origin_dy: int = 0) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoAddImage(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, image: BackgroundImage) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoDeleteImage(UndoAddImage):
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoAddLabel(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, label: CanvasLabel) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoDeleteLabel(UndoAddLabel):
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoEditLabelText(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, label_id: str, old_text: str, new_text: str) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoEditLabelColor(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, label_id: str, old_color: QtGui.QColor, new_color: QtGui.QColor) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoEditLabelFontSize(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, label_id: str, old_size: int, new_size: int) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoRotateCanvasItem(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, item_id: str, old_angle: float, new_angle: float) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class UndoFlipImage(ViewUndoBase):
    def __init__(self, tabwindow: TabWindow, tab_index: int, view_id: int, item_id: str, horizontal: bool = True) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

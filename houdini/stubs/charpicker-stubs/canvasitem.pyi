from . import cpglobals as cpglobals, cpundos as cpundos
from .resizewidget import ResizeEdge as ResizeEdge
from .tabview import TabView as TabView
from hutil.PySide import QtCore, QtGui, QtWidgets

class CanvasItem(QtWidgets.QWidget):
    """Base class for resizable, draggable canvas items."""
    parent: TabView
    myId: str
    unsavedChangesSignal: QtCore.Signal
    propertiesChangedSignal: QtCore.Signal
    dragMoveSignal: QtCore.Signal
    resizedSignal: QtCore.Signal
    deleteSignal: QtCore.Signal
    newSelectionStartedSignal: QtCore.Signal
    myEditMode: bool
    def __init__(self, parent: TabView, item_id: str, edit_mode: bool = False) -> None: ...
    def setPreview(self, preview: bool) -> None: ...
    def notifyUnsavedChanges(self) -> None: ...
    def getSize(self) -> tuple[float | None, float | None]: ...
    def anchorPoint(self, anchor: ResizeEdge | None = None) -> QtCore.QPoint: ...
    def contentsContains(self, pos: QtCore.QPoint | QtCore.QPointF) -> bool:
        """Return True if pos (in widget coordinates) is inside the
        rotated content rect."""
    def setSize(self, width: float | None, height: float | None, anchor: ResizeEdge | None = None) -> None: ...
    def updateSize(self) -> None: ...
    def beginResize(self) -> None: ...
    def handleMoveFinished(self, old_pos: QtCore.QPoint) -> None: ...
    def handleResizeFinished(self, anchor: ResizeEdge | None) -> None: ...
    def contentsSize(self) -> tuple[int, int]: ...
    def setContentsSize(self, w: float, h: float) -> None: ...
    def supportsRotation(self) -> bool: ...
    def supportsResizeSnap(self) -> bool: ...
    def rotation(self) -> float: ...
    def setRotation(self, angle: float) -> None: ...
    def handleRotationFinished(self, old_angle: float, new_angle: float) -> None: ...
    def setEditMode(self, edit_mode: bool) -> None: ...
    def clearHover(self) -> None: ...
    def enterEvent(self, event: QtGui.QEnterEvent) -> None: ...
    def leaveEvent(self, event: QtCore.QEvent) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> None: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def keyReleaseEvent(self, event: QtGui.QKeyEvent) -> None: ...

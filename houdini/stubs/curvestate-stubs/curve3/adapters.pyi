import hou
import typing
from houtypes import ViewerStateDrawKwargs
from typing import Generic, Literal

from typing import TypeAlias
from typing import TypeVar
from typing import TypeAlias
from typing import TypeVar
_V = TypeVar('_V', bound=hou.SceneViewer | hou.CompositorViewer)
_Adapter: TypeAlias = 'SceneViewerAdapter | CopViewerAdapter'
class ViewerAdapter(Generic[_V]):
    viewer: _V
    def __init__(self, viewer: _V) -> None: ...
    def viewer_kind(self) -> Literal['unknown', 'scene', 'cop']: ...
    def hud_show(self, val: bool) -> None: ...
    def set_prompt(self, msg: str) -> None: ...
    def clear_prompt(self) -> None: ...
    def begin_state_undo(self, label: str) -> None: ...
    def end_state_undo(self) -> None: ...
    def set_picker_cursor(self, enabled: bool) -> None: ...
    def create_drawable(self, *args: object, **kwargs: object) -> None: ...
    def create_handle(self, *args: object, **kwargs: object) -> None: ...
    def get_viewport(self) -> hou.GeometryViewport | hou.Viewport2D | None: ...
    def on_draw(self, kwargs: ViewerStateDrawKwargs) -> None: ...

class SceneViewerAdapter(ViewerAdapter[hou.SceneViewer]):
    def viewer_kind(self) -> Literal['scene']: ...
    def get_viewport(self) -> hou.GeometryViewport: ...

class CopViewerAdapter(ViewerAdapter[hou.CompositorViewer]):
    def viewer_kind(self) -> Literal['cop']: ...
    def set_picker_cursor(self, enabled: bool) -> None: ...
    def get_viewport(self) -> hou.Viewport2D | None: ...

@typing.overload
def get_viewer_adapter(viewer: hou.CompositorViewer) -> CopViewerAdapter: ...
@typing.overload
def get_viewer_adapter(viewer: hou.SceneViewer) -> SceneViewerAdapter: ...
@typing.overload
def get_viewer_adapter(viewer: hou.SceneViewer | hou.CompositorViewer) -> _Adapter: ...

import hou
from collections.abc import Callable as Callable
from curvestate.curve3.state import CurveState as CurveState
from statehud.parmutils import HUDParm
from typing import Literal, Self, Unpack

from typing import TypeAlias
from typing import TypeVar
from types import TracebackType
from typing import TypeAlias
from typing import TypeVar
_T = TypeVar('_T')
_ExcInfo: TypeAlias = tuple[type[BaseException] | None, BaseException | None, TracebackType | None]
class UndoStateUpdater:
    """
    Added at the start of each undo block.
    Runs last on undo, after Houdini has restored parm/geometry state.
    """
    def __init__(self, main_state: CurveState) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class RedoStateUpdater(UndoStateUpdater):
    """
    Added at the end of each undo block.
    Runs last on redo, after Houdini has restored parm/geometry state.
    """
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class RefreshUndoCallback:
    """Compatibility wrapper when only a callback is available."""
    def __init__(self, refresh_fn: Callable[[], object], run_on_undo: bool, run_on_redo: bool) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class LiveGeometryUndo:
    """Restore one Live Update interaction from immutable stash snapshots."""
    def __init__(self, node_path: str, parm_name: str, undo_geo: hou.Geometry, redo_geo: hou.Geometry) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class SelectionStateUndo:
    """Undo/redo object for manual selection changes."""
    def __init__(self, main_state: CurveState, pre_group: str | None, post_group: str | None) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class NothingBlock:
    """Placeholder block when no grouped undo is needed."""
    def __init__(self, *args: object, **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: Unpack[_ExcInfo]) -> Literal[False]: ...

class HUDParmValueUndo:
    """Custom undo object for HUD slider edits applied through disabled parm sets."""
    def __init__(self, node_path: str, parm_name: str, undo_value: hou.ParmArgType, redo_value: hou.ParmArgType) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class HUDParmUndoCache:
    """State-owned storage for HUD slider drag start values."""
    def __init__(self) -> None: ...
    def store_start_value(self, key: tuple[str, str], value: hou.ParmArgType) -> None: ...
    def pop_start_value(self, key: tuple[str, str]) -> hou.ParmArgType | None: ...

class HUDParmUndoBlock:
    """Use Houdini undo only for the final event of a HUD parm interaction."""
    def __init__(self, parm: HUDParm | None, *, cache: HUDParmUndoCache | None = None, node_parm: hou.Parm | None = None, final_value: hou.ParmArgType | None = None) -> None: ...
    def __enter__(self) -> hou.UndosDisabler: ...
    def __exit__(self, *args: Unpack[_ExcInfo]) -> bool: ...

class UndoBlockWrapper:
    """Wrap a Houdini undo block with Curve3 undo/redo refresh objects."""
    def __init__(self, source_block: hou.UndosGroup, *, main_state: CurveState | None = None, refresh_fn: Callable[[], object] | None = None) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: Unpack[_ExcInfo]) -> None: ...

def get_undo_block(make_undo_block: bool, *args: Unpack[tuple[str, Unpack[tuple[hou.NetworkEditor | None, ...]]]], main_state: CurveState | None = None, refresh_fn: Callable[[], object] | None = None, **kwargs: hou.NetworkEditor | None) -> NothingBlock | UndoBlockWrapper:
    """Return a state-aware undo wrapper or a placeholder block."""

import hou
from .tool_helpers import point_group_string as point_group_string
from collections.abc import Mapping

from typing import TypeAlias
from typing import TypeVar
from collections.abc import Sequence
from typing import TypeAlias
from typing import TypeVar
_T = TypeVar('_T')
_VerbParmArg: TypeAlias = bool | int | float | str | hou.Vector3 | Sequence[float]
class Curve3ControllerBackend:
    """Shared base utilities for the Curve3 HDA backend."""
    SCENE_GEO_SOURCE: str
    node: hou.OpNode | None
    def __init__(self) -> None: ...
    def set_node(self, node: hou.OpNode | None) -> None: ...
    def scene_geometry(self) -> hou.Geometry | None:
        """Shared scene-node geometry accessor for backend-specific routing."""
    def scene_geo_data_id(self) -> tuple[int, ...] | None: ...
    def set_parm(self, name: str, value: _VerbParmArg) -> None: ...
    def set_parms(self, values: Mapping[str, _VerbParmArg]) -> None: ...
    def eval_parm_string(self, name: str, default: str = ...) -> str: ...
    def eval_parm_int(self, name: str, default: int = ...) -> int: ...
    def eval_parm_float(self, name: str, default: float = 0.0) -> float: ...
    def press_button(self, name: str) -> None: ...
    def commit(self) -> None: ...
    def commit_with_override_parms(self, override_parms: Mapping[str, _VerbParmArg]) -> None: ...
    def commit_with_explicit_parms(self, parms: Mapping[str, _VerbParmArg]) -> None: ...
    def geometry(self) -> hou.Geometry | None: ...
    def preview_geometry(self) -> hou.Geometry | None:
        """Geometry for the ghost preview-curve drawable."""
    def live_geometry_active(self) -> bool: ...
    def current_verb_parms(self) -> dict[str, _VerbParmArg]: ...
    def menu_token_to_index(self, parm_name: str, token: str, default: int) -> int: ...
    def menu_index_to_token(self, parm_name: str, index: int, default: str) -> str: ...
    def preview_input_geometry(self) -> hou.Geometry | None:
        """
        Geometry source for transient draw-preview verb cooks.
        Default matches `geometry()`.
        """
    def set_external_preview_geometry(self, geo: hou.Geometry | None) -> None:
        """Optional hook: inject explicit preview geometry for backend reads."""
    def sync_from_node_if_changed(self) -> bool:
        """Optional hook: pull latest node geometry into backend state."""
    def reset_after_undo_or_redo(self, *, optype: str = ...) -> None:
        """Optional hook: clear transient backend state after undo/redo."""
    def apply_animation_data(self, data_geo: hou.Geometry) -> None:
        """Apply updated /animation geometry payload for channel edits."""
    def apply_geometry(self, geo: hou.Geometry) -> None:
        """Replace the committed working geometry with an already-edited geometry."""
    def begin_live_geometry(self, *, enabled: bool) -> None:
        """Freeze the pre-interaction geometry when Live Mode is enabled."""
    def publish_live_geometry(self, parms: Mapping[str, _VerbParmArg]) -> None:
        """Evaluate explicit operation parms and publish that result to node data."""
    def end_live_geometry(self) -> None:
        """Finalize the live data parameter from the committed working geometry."""
    def live_geometry_undo_snapshot(self) -> tuple[str, str, hou.Geometry, hou.Geometry] | None:
        """Return an active Live Update pre/post snapshot, if this backend has one."""

class VerbBackend(Curve3ControllerBackend):
    """Verb backend for non-curve3core nodes.

    The backend keeps controller parms in-memory, executes the curve3core verb
    against a cached working geometry, and persists the result to a stash parm
    when one is available on the active node.
    """
    SCENE_GEO_SOURCE: str
    def __init__(self) -> None: ...
    def set_node(self, node: hou.OpNode | None) -> None: ...
    def scene_geometry(self) -> hou.Geometry | None: ...
    def set_parm(self, name: str, value: _VerbParmArg) -> None: ...
    def set_parms(self, values: Mapping[str, _VerbParmArg]) -> None: ...
    def eval_parm_string(self, name: str, default: str = ...) -> str: ...
    def eval_parm_int(self, name: str, default: int = ...) -> int: ...
    def eval_parm_float(self, name: str, default: float = 0.0) -> float: ...
    def press_button(self, name: str) -> None: ...
    def commit(self) -> None: ...
    def commit_with_override_parms(self, override_parms: Mapping[str, _VerbParmArg]) -> None: ...
    def commit_with_explicit_parms(self, parms: Mapping[str, _VerbParmArg]) -> None: ...
    def geometry(self) -> hou.Geometry | None: ...
    def preview_geometry(self) -> hou.Geometry | None: ...
    def live_geometry_active(self) -> bool: ...
    def preview_input_geometry(self) -> hou.Geometry | None:
        """
        Critical invariant for draw mode:
        preview cooks must run from committed working geometry only.
        """
    def current_verb_parms(self) -> dict[str, _VerbParmArg]: ...
    def menu_token_to_index(self, parm_name: str, token: str, default: int) -> int: ...
    def menu_index_to_token(self, parm_name: str, index: int, default: str) -> str: ...
    def set_external_preview_geometry(self, geo: hou.Geometry | None) -> None: ...
    def apply_animation_data(self, data_geo: hou.Geometry) -> None: ...
    def apply_geometry(self, geo: hou.Geometry) -> None: ...
    def begin_live_geometry(self, *, enabled: bool) -> None: ...
    def live_geometry_undo_snapshot(self) -> tuple[str, str, hou.Geometry, hou.Geometry] | None:
        """Return immutable pre/post stash geometry for the active live gesture."""
    def publish_live_geometry(self, parms: Mapping[str, _VerbParmArg]) -> None: ...
    def end_live_geometry(self) -> None: ...
    def sync_from_node_if_changed(self) -> bool: ...
    def reset_after_undo_or_redo(self, *, optype: str = ...) -> None: ...


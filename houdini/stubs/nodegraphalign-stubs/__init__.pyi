from canvaseventtypes import *
import hou
from collections.abc import MutableMapping, Sequence, Set as AbstractSet

from typing import TypeAlias
from typing import TypeAlias
_AlignItem: TypeAlias = hou.Node | hou.IndirectInput
def getItemRect(editor: hou.NetworkEditor, item: hou.NetworkMovableItem) -> hou.BoundingRect: ...

class LayoutTree:
    editor: hou.NetworkEditor
    itempositions: dict[hou.NetworkMovableItem, tuple[int, int, float] | hou.Vector2]
    branchwidths: dict[int, float]
    branchdepths: dict[int, int]
    branchdistances: dict[int, float]
    parentbranch: list[int]
    nextitembranch: list[int]
    newbranchdepth: list[int]
    newbranchdistance: list[float]
    branchdir: hou.Vector2
    spacingdir: hou.Vector2
    branchwidthtotal: float
    root: hou.NetworkMovableItem | None
    branchmax: dict[int, hou.NetworkMovableItem]
    branchtips: dict[int, hou.NetworkMovableItem]
    treeoffset: hou.Vector2
    def __init__(self, editor: hou.NetworkEditor, branchdir: hou.Vector2, spacingdir: hou.Vector2) -> None: ...
    def pushBranch(self) -> None: ...
    def popBranch(self) -> None: ...
    def updateBranchDepths(self) -> None: ...
    def advanceToNextBranch(self) -> None: ...
    def addExistingItemToBranch(self, item: hou.NetworkMovableItem) -> None: ...
    def addItemToBranch(self, item: hou.NetworkMovableItem) -> None: ...
    def getNextItemOffset(self, item: hou.NetworkMovableItem) -> hou.Vector2: ...
    def completeLayout(self) -> None: ...
    def getItemOffset(self, item: hou.NetworkMovableItem) -> hou.Vector2: ...

class LayoutInfo:
    editor: hou.NetworkEditor
    branchdir: hou.Vector2
    spacingdir: hou.Vector2
    itemtreemap: dict[hou.NetworkMovableItem, int]
    trees: list[LayoutTree]
    def __init__(self, editor: hou.NetworkEditor, branchdir: hou.Vector2, spacingdir: hou.Vector2) -> None: ...
    def addTree(self, item: hou.NetworkMovableItem) -> bool: ...
    def addItemToTree(self, item: hou.NetworkMovableItem) -> bool: ...
    def completeLayout(self) -> None: ...
    def pushBranch(self) -> None: ...
    def popBranch(self) -> None: ...
    def updateBranchDepths(self) -> None: ...
    def advanceToNextBranch(self) -> None: ...
    def getItemOffset(self, item: hou.NetworkMovableItem) -> hou.Vector2: ...

def compareByOutputs(item1: hou.NetworkMovableItem, item2: hou.NetworkMovableItem) -> int: ...
def assignPositionsToConnected(item: _AlignItem, itemset: AbstractSet[hou.NetworkMovableItem], layoutinfo: LayoutInfo, followinputs: bool) -> None: ...
def assignPositions(items: Sequence[_AlignItem], layoutinfo: LayoutInfo, followinputs: bool) -> None: ...
def alignSelected(editor: hou.NetworkEditor, direction: str) -> None: ...
def alignConnected(editor: hou.NetworkEditor, alignitem: object, alignpos: hou.Vector2 | None, direction: str) -> None: ...
def alignItems(editor: hou.NetworkEditor, items: list[_AlignItem], alignitem: _AlignItem | None, alignpos: hou.Vector2 | None, direction: str) -> None: ...
def lineUpSelected(editor: hou.NetworkEditor, start_pos: hou.Vector2, vertical: bool, start_item: object = None, posstartmap: MutableMapping[hou.NetworkMovableItem, hou.Vector2] | None = None) -> None: ...
def lineUpItems(editor: hou.NetworkEditor, items: Sequence[hou.NetworkMovableItem], start_pos: hou.Vector2, vertical: bool, start_item: object = None, posstartmap: MutableMapping[hou.NetworkMovableItem, hou.Vector2] | None = None) -> None: ...
def distributeSelected(editor: hou.NetworkEditor, vertical: bool, posstartmap: MutableMapping[hou.NetworkMovableItem, hou.Vector2] | None = None) -> None: ...
def distributeItems(editor: hou.NetworkEditor, items: Sequence[hou.NetworkMovableItem], vertical: bool, posstartmap: MutableMapping[hou.NetworkMovableItem, hou.Vector2] | None = None) -> None: ...

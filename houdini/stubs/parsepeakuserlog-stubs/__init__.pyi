class License:
    """Information about a license, but nothing about its usage."""
    license_id: str
    product: str
    version: Decimal
    quantity: int
    expires: datetime
    ip_mask: str
    platform: str
    server_name: str
    def __init__(self, license_id: str, product: str, version: Decimal, quantity: int, expires: datetime, ip_mask: str, platform: str, server_name: str) -> None: ...
    @staticmethod
    def convert_expires_to_str(expires: datetime | str) -> str:
        """The python License uses a datetime object for its expires whereas the
        c++ License wrapper uses a utc int timestamp."""
    @classmethod
    def parse(cls, value: str) -> Self:
        """Parse a license string and return a new License object."""
    def simple_product_name(self) -> str: ...
    def as_string(self) -> str: ...

class CombinedLicense:
    product: str
    version: Decimal
    def __init__(self, product: str, version: Decimal | None = None) -> None: ...
    def simple_product_name(self) -> str: ...

class User:
    """Information about the user of a license, but nothing about how they
    used it.
    """
    username_and_machine: str
    def __init__(self, username_and_machine: str) -> None: ...
    def __lt__(self, user: User) -> bool: ...

class UsageLog:
    """The information contained in a single log file."""
    sections: list[LogSection]
    license_id_to_license: dict[str, License]
    user_string_to_user: dict[str, User]
    def __init__(self) -> None: ...
    def remove_section(self, index: int) -> None: ...
    def debug_info(self) -> str: ...
    def contents(self) -> Generator[tuple[LogSection, UsageInterval, PeakLicenseUsage], None, None]:
        """This generator contains one entry per recorded peak usage of a
        license/product during a time interval.
        """
    def user_contents(self) -> Generator[tuple[LogSection, UsageInterval, PeakLicenseUsage, User], None, None]:
        """This generator contains one entry per user using a license/product
        during the peak usage of a license/product during a time interval.
        """
    def parse_license(self, license_string: str) -> License: ...
    def find_or_create_user(self, user_string: str) -> User: ...
    def first_timestamp(self) -> float | None: ...
    def last_timestamp(self) -> float | None: ...
    def merge_to_one_section(self) -> None: ...
    def merge_overlapping_sections(self) -> None:
        """Handle the case where the server was restarted and the last entry
        before the restart overlaps with the first entry after the restart.
        """
    def combine_usages_by_product(self, separate_versions: bool = False) -> None:
        """Combine information about the peak usage to be on a per-product
        basis instead of a per-license basis.
        """

def is_sesinetd_version_ok(section: _AnyLogSection) -> bool: ...
def should_delete_data_because_of_version(section: _AnyLogSection) -> bool: ...

class LogSection:
    """A section represents a portion of the log file where sesinetd was
    running, before it was restarted.  Log files can contain multiple sections.
    Each section can have a different sesinetd version and even a different
    time interval length.
    """
    public_key: str | Literal[False]
    prev_signature: bytes
    time_interval_in_s: int
    intervals: list[UsageInterval]
    messages: list[str]
    variables: dict[str, str]
    vmaj: int
    vmin: int
    vbuild: int
    def __init__(self, major: int = 0, minor: int = 0, build: int = 0) -> None: ...
    def debug_info(self) -> str: ...
    def version_tuple(self) -> tuple[int, int, int]: ...
    def version_str(self) -> str: ...
    def set_version(self, version_seq: Sequence[int]) -> None: ...
    def calc_timestamp(self, value: int) -> int:
        """Calculate the correct timestamp based on the sections version.
        Earlier versions incorrectly calculated the timestamp and the exporter
        cannot calculate the timezones from it.
        """
    def record_license_peak(self, license: License, peak: int) -> None:
        """Record the peak usage count for this license id."""
    def add_license_user(self, user: User) -> None:
        """Add the license user to the usage information of the last recorded
        license.
        """

def log_last_timestamp(log: _AnyUsageLog) -> float | None: ...
def group_section_intervals(section: _SectionT, group_by: str, time_zone: tzinfo | None, take_max: bool) -> _SectionT:
    """Merge the data from the time intervals according to the group_by
        criteria.
        """

class UsageInterval:
    """A log is composed of different time intervals, determined by the
    time granularity of the logging.  Within each interval the peak
    concurrent usage is determined for each license, optionally with a list
    of users of that license in that period.
    """
    timestamp: float
    usages: list[PeakLicenseUsage]
    def __init__(self, timestamp: float) -> None: ...
    def debug_info(self) -> str: ...
    def combine_usages_by_product(self, key_to_combined_license: Mapping[_ProductKey, CombinedLicense], separate_versions: bool) -> None: ...
    def merge(self, merge_in_interval: UsageInterval, take_max: bool) -> None: ...

class PeakLicenseUsage:
    """This class stores the peak (maximum) number of concurrent uses during
    a time interval for a given license.  It also stores which users used that
    license during that time interval, if the server is configured to log
    this information.
    """
    license: License | CombinedLicense
    peak: int
    users: list[User]
    def __init__(self, license: License | CombinedLicense, peak: int) -> None: ...


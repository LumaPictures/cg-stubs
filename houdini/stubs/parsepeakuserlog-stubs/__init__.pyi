class UsageParser:
    args: argparse.Namespace | None
    log: _AnyUsageLog | None
    num_bytes_to_read: int
    num_bytes_read: int
    progress_percentage: int
    start_date: date | None
    end_date: date | None
    start_time_timestamp: float | None
    end_time_timestamp: float | None
    skip_this_time_interval: bool
    time_zone: tzinfo | None
    time_zone_in_log: tzinfo | None
    signed_data: bytearray
    index_to_user: dict[int, User]
    index_to_license: dict[int, License]
    only_license_id_set: set[str] | None
    def __init__(self) -> None: ...
    def configure(self, args: Sequence[str] | None = None) -> None: ...
    def add_parser_options(self, parser: argparse.ArgumentParser) -> None: ...
    def parse(self) -> bool: ...
    def remove_sections_with_invalid_versions(self) -> None: ...
    def parse_open_file(self, open_file: IO[bytes]) -> bool: ...
    def timestamp_is_to_be_skipped(self, timestamp: float) -> bool: ...
    def verify_signature(self, cur_bytes: bytearray, open_file: IO[bytes]) -> bool: ...
    def parse_four_cc(self, open_file: IO[bytes]) -> bool:
        """Check if the first 4 bytes of the file have the correct FourCC code.
        """
    def parse_signature(self, cur_bytes: bytearray, open_file: IO[bytes]) -> str | None: ...
    def parse_public_key(self, cur_bytes: bytearray, open_file: IO[bytes]) -> str | Literal[False]: ...
    def read_str(self, open_file: IO[bytes], length: int, is_signed_data: bool = True) -> str: ...
    def read_bytes(self, open_file: IO[bytes], cur_bytes: bytearray, count: int = 1, is_signed_data: bool = True) -> bool: ...
    def parse_time_period_length(self, cur_bytes: bytearray, open_file: IO[bytes]) -> int: ...
    def parse_log_message(self, cur_bytes: bytearray, open_file: IO[bytes]) -> str: ...
    def parse_index_to_string_mapping(self, cur_bytes: bytearray, open_file: IO[bytes]) -> tuple[int, int, str]: ...
    def parse_variable(self, cur_bytes: bytearray, open_file: IO[bytes]) -> list[str]: ...
    def parse_time_period_end_marker(self, cur_bytes: bytearray, open_file: IO[bytes]) -> int: ...
    def parse_variable_length_int(self, cur_bytes: Iterable[int]) -> int: ...


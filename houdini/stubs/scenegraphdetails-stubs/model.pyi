    def getName(self) -> str: ...
    def getLabel(self) -> str: ...
    def getValueText(self) -> _ValueText: ...
    def getValueShortText(self) -> _ValueText: ...
    def getLabelToolTip(self) -> str: ...
    def getValueToolTip(self) -> _ValueText: ...
    def getColor(self) -> QtGui.QBrush | None: ...
    def hasValue(self) -> bool: ...


import pathlib
from collections.abc import Iterator
from dataclasses import dataclass
from hutil.PySide import QAction as QAction, QtGui as QtGui, QtWidgets as QtWidgets
from hutil.qt.info import core as core
from lxml import etree
from typing import Any, Callable as Callable, IO, Self

def getParser() -> etree.XMLParser: ...
def makeSymbol(hk_context: str, item_id: str) -> str: ...
def makeFn(text: str | None, file_path: str = '<menuexpr>') -> Callable[[dict[str, Any]], Any] | None: ...
def makeIcon(name: str, size: int) -> QtGui.QIcon: ...

class MenuPart(core.Info):
    symbol: str
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, **kwargs: object) -> None: ...
    def addToWidget(self, menu: QtWidgets.QMenu) -> None: ...
    def updateArgs(self, menu: Menu | None, kwargs: dict[str, Any]) -> None: ...

class Menu(MenuPart):
    title: str
    items: list[MenuPart]
    collapseSeparators: bool
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, **kwargs: object) -> None: ...
    def get(self, symbol: str) -> MenuPart | None: ...
    def find(self, symbol: str) -> MenuPart | None: ...
    def recursivelyRemove(self, symbol: str) -> None: ...
    def addToWidget(self, menu: QtWidgets.QMenu) -> None: ...
    def updateArgs(self, parent: Menu | None, kwargs: dict[str, Any]) -> None: ...
    def menuWidget(self) -> QtWidgets.QMenu: ...

class ItemBase(MenuPart):
    ownerMask: str
    parentNetworkTypes: list[str] | None
    enabled: bool
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, visible_fn: Callable[[dict[str, Any]], bool] | None = None, enabled_fn: Callable[[dict[str, Any]], bool] | None = None, **kwargs: object) -> None: ...
    def addToWidget(self, menu: QtWidgets.QMenu) -> None: ...
    def action(self) -> QtGui.QAction: ...
    def updateArgs(self, menu: Menu | None, kwargs: dict[str, Any]) -> None: ...

@dataclass
class SeparatorItem(ItemBase):
    label: str = ...
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...

class MenuItem(ItemBase):
    label: str
    iconName: str | None
    scriptPath: str | None
    scriptArgs: list[str] | None
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, action_fn: Callable[[dict[str, Any]], object] | None = None, label_fn: Callable[[dict[str, Any]], str] | None = None, icon_name_fn: Callable[[dict[str, Any]], str] | None = None, script_args_fn: Callable[[dict[str, Any]], list[str]] | None = None, **kwargs: Any) -> None: ...
    def updateArgs(self, menu: Menu | None, kwargs: dict[str, Any]) -> None: ...

class ToggleItem(MenuItem):
    checked: bool
    checkedFn: Callable[[dict[str, Any]], bool] | None
    isToggle: bool
    isRadio: bool
    variableName: str
    variableValue: str
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, **kwargs: Any) -> None: ...
    def updateArgs(self, menu: Menu | None, kwargs: dict[str, Any]) -> None: ...

class StripItem(ItemBase):
    contentsFn: Callable[[dict[str, Any]], list[str]] | None
    isRadioStrip: bool
    hideEmpty: bool
    @classmethod
    def fromXml(cls, xmlmenu: XmlMenu, elem: etree._Element) -> Self: ...
    def __init__(self, **kwargs: Any) -> None: ...
    def addToWidget(self, menu: QtWidgets.QMenu) -> None: ...
    def updateArgs(self, menu: Menu | None, kwargs: dict[str, Any]) -> None: ...
    def items(self, kwargs: dict[str, Any]) -> Iterator[MenuItem]: ...

class XmlMenu:
    kwargs: dict[str, Any]
    kwargs_callback: Callable[[], dict[str, Any]] | None
    file_path: str
    menu: Menu
    hotkey_context: str
    lookup: dict[str, Menu | ItemBase]
    def __init__(self, hotkey_context: str = '', kwargs_callback: Callable[[], dict[str, Any]] | None = None, **kwargs: Any) -> None: ...
    @classmethod
    def parseFilesOnPath(cls, name: str) -> XmlMenu: ...
    def parseFile(self, file: str | pathlib.Path) -> None: ...
    def parseFileObj(self, f: IO[str] | IO[bytes], file_path: str = '') -> None: ...
    def parseString(self, xml_text: str) -> None: ...
    def parseTree(self, tree: etree._ElementTree, file_path: str = '') -> None: ...
    def applyMods(self, parent: Menu, elem: etree._Element) -> None: ...
    def insertScriptItem(self, parent: Menu, elem: etree._Element) -> None: ...
    def removeItem(self, parent: Menu, elem: etree._Element) -> None: ...
    def makeItem(self, elem: etree._Element) -> MenuPart: ...
    def addMenu(self, parent: Menu | None, elem: etree._Element) -> Menu: ...
    def menuWidget(self) -> QtWidgets.QMenu: ...

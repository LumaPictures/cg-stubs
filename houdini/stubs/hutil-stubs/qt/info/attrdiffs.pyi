import dataclasses
import enum
import hou
from typing import Collection

attr_types: tuple[hou.EnumValue[hou.attribType], hou.EnumValue[hou.attribType], hou.EnumValue[hou.attribType], hou.EnumValue[hou.attribType]]
attr_type_to_name: dict[hou.EnumValue[hou.attribType], str]
attr_data_type_to_name: dict[hou.EnumValue[hou.attribData], str]
attr_type_to_intrinsic_name: dict[hou.EnumValue[hou.attribType], str]

class Change(enum.Enum):
    added = enum.auto()
    deleted = enum.auto()
    metadata = enum.auto()
    values = enum.auto()
    unchanged = enum.auto()

@dataclasses.dataclass
class AttrDiff:
    type: hou.EnumValue[hou.attribType]
    name: str
    change: Change = ...
    data_types: tuple[hou.EnumValue[hou.attribData], hou.EnumValue[hou.attribData]] | None = ...
    sizes: tuple[int, int] | None = ...
    is_arrays: tuple[bool, bool] | None = ...
    defaults: tuple[hou.AttribReturnType, hou.AttribReturnType] | None = ...
    qualifiers: tuple[str, str] | None = ...
    @property
    def type_name(self) -> str: ...
    def dataTypeText(self) -> str: ...
    def sizesText(self) -> str: ...
    def isArrayText(self) -> str: ...
    def defaultsText(self) -> str: ...
    def qualifiersText(self) -> str: ...
    def diffText(self) -> str: ...
    def isNew(self) -> bool: ...
    def isDeleted(self) -> bool: ...
    def isModified(self) -> bool: ...
    def isEdited(self) -> bool: ...

@dataclasses.dataclass
class Differences:
    added_names: dict[hou.EnumValue[hou.attribType], Collection[str]]
    removed_names: dict[hou.EnumValue[hou.attribType], Collection[str]]
    changed_names: dict[hou.EnumValue[hou.attribType], Collection[str]]
    diffs: dict[tuple[hou.EnumValue[hou.attribType], str], AttrDiff] | None
    def addedCount(self) -> int: ...
    def removedCount(self) -> int: ...
    def changedCount(self) -> int: ...

def attrIDs(geo: hou.Geometry | None) -> dict[hou.EnumValue[hou.attribType], frozenset[str]]: ...
def attrDicts(geo: hou.Geometry | None) -> dict[hou.EnumValue[hou.attribType], dict[str, hou.Attrib]]: ...
def computeDiffs(geo1: hou.Geometry | None, geo2: hou.Geometry | None, *, check_metadata: bool = False, compare_values: bool = False) -> Differences: ...

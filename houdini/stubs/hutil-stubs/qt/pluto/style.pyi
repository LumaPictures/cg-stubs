class PlutoStyle(QtWidgets.QCommonStyle):
    def __init__(self, scale: float = 1.0, holo: bool = False) -> None: ...
    def localScale(self) -> float: ...
    def setLocalScale(self, scale: float) -> None: ...
    def scaled(self, val: float | None, default: float = 0.0) -> ScaledFloat: ...
    def scaledInt(self, val: float | None, default: float = 0.0) -> int: ...
    def isHolo(self) -> bool: ...
    def standardPalette(self) -> QtGui.QPalette: ...
    def polish(self, obj: QtWidgets.QApplication | QtWidgets.QWidget | QtGui.QPalette) -> None: ...
    def unpolish(self, widget: QtWidgets.QWidget | QtWidgets.QApplication) -> None: ...
    def drawComplexControl(self, control: QtWidgets.QStyle.ComplexControl | ComplexControl, option: QtWidgets.QStyleOptionComplex, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = None) -> None: ...
    def drawPrimitive(self, element: QtWidgets.QStyle.PrimitiveElement | PrimitiveElement, option: QtWidgets.QStyleOption, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = None) -> None: ...
    @staticmethod
    def iconTint(palette: QtGui.QPalette) -> QtGui.QColor: ...
    @staticmethod
    def iconAccent(palette: QtGui.QPalette) -> QtGui.QColor: ...
    def drawControl(self, element: QtWidgets.QStyle.ControlElement | ControlElement, option: QtWidgets.QStyleOption, painter: QtGui.QPainter, widget: QtWidgets.QWidget | None = None) -> None: ...
    def sizeFromContents(self, ctype: QtWidgets.QStyle.ContentsType | ContentsType, option: QtWidgets.QStyleOption, size: QtCore.QSize, widget: QtWidgets.QWidget | None = None) -> QtCore.QSize: ...
    def pixelMetric(self, metric: QtWidgets.QStyle.PixelMetric | PixelMetric, option: QtWidgets.QStyleOption | None = None, widget: QtWidgets.QWidget | None = None) -> int: ...
    def styleHint(self, hint: QtWidgets.QStyle.StyleHint, opt: QtWidgets.QStyleOption | None = None, widget: QtWidgets.QWidget | None = None, shret: QtWidgets.QStyleHintReturn | None = None) -> int: ...
    def subControlRect(self, cc: QtWidgets.QStyle.ComplexControl | ComplexControl, option: QtWidgets.QStyleOptionComplex, sc: QtWidgets.QStyle.SubControl | SubControl, widget: QtWidgets.QWidget | None = None) -> QtCore.QRect: ...
    def subElementRect(self, elem: QtWidgets.QStyle.SubElement, opt: QtWidgets.QStyleOption, widget: QtWidgets.QWidget | None = None) -> QtCore.QRect: ...


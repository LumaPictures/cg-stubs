import PySide6.QtCore
import PySide6.QtGui
import hou
from ..pluto import colors as colors
from .overlay import Overlay as Overlay, PanelState as PanelState
from collections.abc import Mapping
from hutil.PySide.QtCore import Qt as Qt
from hutil.qt.common import config as config, qmlviews as qmlviews
from typing import ClassVar

layout_count: dict[hou.EnumValue[hou.geometryViewportLayout], int]

class ViewHudState(qmlviews.SharedState[config.BaseConfig]):
    path: str
    toolInfoMinimized: bool
    toolTitle: str
    toolIconName: str
    toolDescription: str
    labelColor: PySide6.QtGui.QColor
    valueColor: PySide6.QtGui.QColor
    backgroundColor: PySide6.QtGui.QColor
    backgroundVisible: bool
    shadow: bool
    panelSize: int
    viewerWidth: int
    viewerHeight: int
    viewerClosing: ClassVar[PySide6.QtCore.Signal]
    hotkeysUpdated: ClassVar[PySide6.QtCore.Signal]
    toolInfoToggled: ClassVar[PySide6.QtCore.Signal]

class ViewerHud:
    def __init__(self, viewer_path: str) -> None: ...
    def viewer(self) -> hou.SceneViewer: ...
    def viewportCount(self) -> int: ...
    def state(self) -> ViewHudState: ...
    def setLegacyTemplate(self, template: Mapping[str, object]) -> None: ...
    def updateLegacyTemplate(self, values: Mapping[str, object]) -> None: ...
    def clear(self) -> None: ...
    def setMaxPanelWidth(self, width: int) -> None: ...
    def setOptions(self, label_color: PySide6.QtGui.QColor, value_color: PySide6.QtGui.QColor, bg_color: PySide6.QtGui.QColor, bg_visible: bool = False, shadow: bool = False, panel_size: int = 1) -> None: ...
    def setToolInfoMinimized(self, minimized: bool) -> None: ...
    def setToolInfo(self, title: str, description: str, icon: str) -> None: ...
    def toggleToolInfo(self) -> bool: ...
    def updateHotkeys(self) -> None: ...
    def showAll(self) -> None: ...
    def hideAll(self) -> None: ...
    def shutDown(self) -> None: ...
    def fixParents(self) -> None: ...
    def viewerRect(self) -> PySide6.QtCore.QRect: ...

class ViewerPanel(Overlay):
    def __init__(self, hud: ViewerHud, url: str | PySide6.QtCore.QUrl, *, active: bool = True, align: str = 'TopLeft') -> None: ...
    def __del__(self) -> None: ...
    def setupEngine(self) -> None: ...
    def viewer(self) -> hou.SceneViewer: ...
    def viewerRect(self) -> PySide6.QtCore.QRect: ...
    def availableRect(self, avail_rect: PySide6.QtCore.QRect | None = None) -> PySide6.QtCore.QRect: ...

class PortPanel(ViewerPanel):
    def __init__(self, hud: ViewerHud, viewport: hou.GeometryViewport, url: str | PySide6.QtCore.QUrl, *, active: bool = True, align: str = 'TopRight') -> None: ...
    def viewport(self) -> hou.GeometryViewport: ...
    def name(self) -> str: ...
    def showIfNeeded(self) -> None: ...
    def availableRect(self, avail_rect: PySide6.QtCore.QRect | None = None) -> PySide6.QtCore.QRect: ...

class TestView(qmlviews.BaseQmlView[qmlviews.SharedState[config.BaseConfig]]):
    SOURCE_URL: str
    DEFAULT_SIZE: PySide6.QtCore.QSize

from hutil.PySide import QtCore as QtCore
from hutil.PySide.QtCore import Qt as Qt
from pxr import Sdf as Sdf, Usd as Usd

class PrimNode:
    stage: Usd.Stage
    path: str
    def __init__(self, stage: Usd.Stage, parent: PrimNode | VRoot, path: str | Sdf.Path, prim: Usd.Prim | None = None, row: int = -1) -> None: ...
    def parent(self) -> PrimNode | VRoot | None: ...
    @property
    def prim(self) -> Usd.Prim: ...
    @property
    def name(self) -> str: ...
    def rowCount(self) -> int: ...
    @property
    def childNames(self) -> list[str]: ...
    @property
    def children(self) -> list[PrimNode]: ...
    def childAt(self, row: int) -> PrimNode | None: ...
    @property
    def row(self) -> int: ...

class VRoot:
    prim: None
    name: None
    children: tuple[PrimNode]
    row: int
    def __init__(self, stage: Usd.Stage, path: str, prim: Usd.Prim | None = None) -> None: ...
    def parent(self) -> None: ...
    def rowCount(self) -> int: ...
    def childAt(self, row: int) -> PrimNode | None: ...

class PrimTreeModel(QtCore.QAbstractItemModel):
    PrimRole: int
    PathRole: int
    TypeNameRole: int
    KindNameRole: int
    ChildCountRole: int
    SchemasRole: int
    IsActiveRole: int
    HasAuthoredActiveRole: int
    LoadedRole: int
    section_labels: tuple[str, str, str, str]
    def __init__(self, stage: Usd.Stage | None = None, parent: QtCore.QObject | None = None) -> None: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def setStage(self, stage: Usd.Stage) -> None: ...
    def rowCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> int: ...
    def columnCount(self, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> int: ...
    def index(self, row: int, column: int, parent: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> QtCore.QModelIndex: ...
    def parent(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> QtCore.QModelIndex: ...
    def flags(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> QtCore.Qt.ItemFlag: ...
    def headerData(self, section: int, orientation: QtCore.Qt.Orientation, role: int = 0) -> str | None: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = 0) -> str | int | bool | Usd.Prim | list[str] | None: ...
    def usda(self) -> str: ...

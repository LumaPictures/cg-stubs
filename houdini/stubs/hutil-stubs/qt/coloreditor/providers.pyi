from .common import IMAGE_FORMAT as IMAGE_FORMAT
from .displaylut import DisplayLut as DisplayLut
from .images import ImageData as ImageData, ImageModel as ImageModel
from hutil.PySide import QtCore as QtCore, QtGui as QtGui, QtQuick as QtQuick
from hutil.PySide.QtCore import Qt as Qt

class ColorMappingImageProvider(QtQuick.QQuickImageProvider):
    def __init__(self) -> None: ...
    def setDisplay(self, display: str) -> None: ...
    def setView(self, view: str) -> None: ...
    def setColorCorrect(self, enabled: bool) -> None: ...
    def requestImage(self, request_string: str, size: QtCore.QSize, req_size: QtCore.QSize) -> QtGui.QImage: ...
    def generate(self, name: str, size: QtCore.QSize, req_size: QtCore.QSize, params: dict[str, str]) -> QtGui.QImage: ...

class _DisplayTextureFactory(QtQuick.QQuickTextureFactory):
    def __init__(self, lut: DisplayLut) -> None: ...
    def textureSize(self) -> QtCore.QSize: ...
    def textureByteCount(self) -> int: ...
    def createTexture(self, window: QtQuick.QQuickWindow) -> QtQuick.QSGTexture | None: ...

class DisplayTextureProvider(QtQuick.QQuickImageProvider):
    def __init__(self) -> None: ...
    def setLut(self, lut: DisplayLut) -> None: ...
    def requestTexture(self, request_string: str, size: QtCore.QSize, req_size: QtCore.QSize) -> QtQuick.QQuickTextureFactory: ...

class ImageFileProvider(ColorMappingImageProvider):
    def __init__(self, model: ImageModel) -> None: ...
    def reload(self) -> None: ...
    def setBrightness(self, brightness: float) -> None: ...
    def setContrast(self, contrast: float) -> None: ...
    def setOffset(self, offset: float) -> None: ...
    def imageCount(self) -> int: ...
    def planeCount(self, idx: int) -> int: ...
    def planeNames(self, idx: int) -> list[str]: ...
    def sampleImage(self, image_index: int, x: int, y: int) -> QtGui.QColor: ...
    def generate(self, name: str, size: QtCore.QSize, req_size: QtCore.QSize, params: dict[str, str]) -> QtGui.QImage: ...

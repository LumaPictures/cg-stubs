import hou
import pathlib
from .common import ItemModel as ItemModel, LinearRgb as LinearRgb
from .window import ColorState as ColorState
from PySide6 import QtGui as QtGui
from collections.abc import Iterator, Sequence
from hutil.PySide import QtCore as QtCore
from hutil.PySide.QtCore import Qt as Qt
from hutil.qt.common import core as core
from recipeutils import _RecipeDataEntry
from typing import ClassVar, Iterable, Self, TypedDict

class _PaletteColorEntry(TypedDict, total=False):
    color: Sequence[float]
    name: str

PREFS_DIR: pathlib.Path
LEGACY_PALETTE_FILE: str

class Palette(core.Info):
    name: str
    description: str
    columns: int
    colorsChanged: ClassVar[QtCore.Signal]
    def __init__(self, state: ColorState, palette_data: Sequence[_PaletteColorEntry | hou.Color], **kwargs: object) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[LinearRgb]: ...
    def __getitem__(self, at: int) -> LinearRgb: ...
    def __setitem__(self, at: int, color: LinearRgb) -> None: ...
    def index(self, color: LinearRgb) -> int: ...
    def pop(self, at: int) -> LinearRgb: ...
    def insert(self, at: int, color: LinearRgb) -> None: ...
    def append(self, color: LinearRgb) -> None: ...
    def extend(self, colors: Iterable[LinearRgb]) -> None: ...
    def clear(self) -> None: ...
    def state(self) -> ColorState: ...
    def readOnly(self) -> bool: ...
    def isLegacy(self) -> bool: ...
    def colors(self) -> list[LinearRgb]: ...
    def realize(self) -> None: ...
    def modified(self) -> bool: ...
    def setColor(self, row: int, new_color: LinearRgb) -> None: ...
    def save(self) -> bool: ...

class LegacyPalette(Palette):
    @classmethod
    def fromLegacyFile(cls, state: ColorState) -> Self: ...
    def realize(self) -> None: ...
    def readOnly(self) -> bool: ...
    def save(self) -> bool: ...

class RecipePalette(Palette):
    recipeName: str
    @classmethod
    def fromRecipeInfo(cls, state: ColorState, recipe_info: _RecipeDataEntry) -> Self: ...
    def realize(self) -> None: ...
    def readOnly(self) -> bool: ...
    def isLegacy(self) -> bool: ...
    def delete(self) -> None: ...
    def save(self) -> bool: ...

class CatalogModel(ItemModel[Palette]):
    DescriptionRole: int
    CountRole: int
    LinearColorsRole: int
    ViewColorsRole: int
    ReadOnlyRole: int
    IsLegacyRole: int
    def roleNames(self) -> dict[int, bytes]: ...
    def reload(self) -> None: ...
    def findName(self, name: str) -> Palette | None: ...
    def findRecipeName(self, recipe_name: str) -> Palette | None: ...
    def indexOfName(self, name: str) -> int: ...
    def notifyPaletteChanged(self, palette: Palette) -> None: ...
    def subset(self, row: int, count: int) -> list[LinearRgb]: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = ...) -> str | int | bool | list[LinearRgb] | list[QtGui.QColor] | None: ...

class PaletteModel(ItemModel[LinearRgb]):
    LinearRole: int
    ColorRole: int
    def __init__(self, state: ColorState) -> None: ...
    def roleNames(self) -> dict[int, bytes]: ...
    def palette(self) -> Palette: ...
    def setPalette(self, palette: Palette) -> None: ...
    def insertItem(self, row: int, item: LinearRgb) -> None: ...
    def deleteItem(self, row: int) -> None: ...
    def move(self, source_row: int, dest_row: int) -> bool: ...
    def replaceColor(self, row: int, color: LinearRgb) -> None: ...
    def insertRgba(self, at: int, r: float, g: float, b: float, a: float = 1.0) -> None: ...
    def renameColor(self, index: int, new_name: str) -> None: ...
    def setRgba(self, at: int, r: float, g: float, b: float, a: float = 1.0) -> None: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int = ...) -> LinearRgb | QtGui.QColor | None: ...

import hou
from PySide6 import QtGui as QtGui
from hutil.Qt import QtCore as QtCore, QtWidgets as QtWidgets
from hutil.Qt.QtCore import Qt as Qt
from typing import Protocol

class _Searchable(Protocol):
    def isHidden(self) -> bool: ...
    def search(self, regex: QtCore.QRegularExpression | None, backward: bool, allow_current_pos: bool, showall: bool) -> None: ...
    def showAllMatches(self, regex: QtCore.QRegularExpression | None, enabled: bool) -> None: ...

ICON_SIZE: int
MARGIN: int

class TextSearch(QtWidgets.QWidget):
    findbox: hou.qt.SearchLineEdit
    prevbutton: QtWidgets.QPushButton
    nextbutton: QtWidgets.QPushButton
    matchcasecheck: QtWidgets.QPushButton
    regexcheck: QtWidgets.QPushButton
    showall: QtWidgets.QPushButton
    searchables: list[_Searchable]
    @staticmethod
    def createRegex(text: str, ignorecase: bool, text_is_regex: bool) -> QtCore.QRegularExpression | None: ...
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    def addSearchable(self, searchable: _Searchable) -> None: ...
    def eventFilter(self, obj: QtCore.QObject, event: QtCore.QEvent) -> bool: ...
    def handleKeyPress(self, event: QtGui.QKeyEvent) -> bool: ...
    def takeFocus(self) -> None: ...
    def findPrev(self, allow_current_pos: bool = False) -> None: ...
    def findNext(self, allow_current_pos: bool = False) -> None: ...

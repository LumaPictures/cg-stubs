from collections.abc import Mapping, MutableMapping
from typing import Any, Callable, Never, Protocol

from typing import TypeVar
from typing import TypeVar
_C = TypeVar('_C', bound=type)
_F = TypeVar('_F', bound=Callable[..., Any])
class _ClassDecorator(Protocol):
    def __call__(self, cls: _C, /) -> _C: ...

class _ClassRegistrar(Protocol):
    def __call__(self, *names: str) -> _ClassDecorator: ...

method_lookup_registry: dict[int, dict[str, Callable[..., None]]]

def registrar(registry_dict: MutableMapping[str, type[Any]]) -> _ClassRegistrar: ...
def camelToSnake(camel: str, drop_set: bool = False) -> str: ...
def snakeToCamel(snake: str, initial: bool = False) -> str: ...
def settable(*names: str, argtype: type | None = None, converter: Callable[[Never], object] | None = None, sequence: bool = False) -> Callable[[_F], _F]: ...
def getLookup(obj: object) -> dict[str, Callable[..., None]]: ...
def hasSetter(obj: object, key: str) -> bool: ...
def getSetter(obj: object, key: str) -> Callable[..., None]: ...
def setSettable(obj: object, key: str, v: object, *rest: object) -> None: ...

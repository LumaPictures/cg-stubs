class SequenceConverter(Generic[_In, _Out]):
    converter: Callable[[_In], _Out]
    def __init__(self, converter: Callable[[_In], _Out]) -> None: ...
    def __call__(self, seq: Sequence[_In]) -> list[_Out]: ...


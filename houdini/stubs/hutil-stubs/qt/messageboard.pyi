import PySide6.QtGui
import PySide6.QtWidgets
import enum
from hutil.PySide import QtWidgets as QtWidgets
from hutil.PySide.QtCore import Qt as Qt
from typing import Callable as Callable

class MessageLevel(enum.IntEnum):
    none = 0
    info = 1
    warning = 2
    error = 3

BIG_MARGIN: int
SMALL_MARGIN: int
SMALL_ICON_SIZE: int
BLANK_ICON: PySide6.QtGui.QIcon
MESSAGE_ICONS: dict[MessageLevel, PySide6.QtGui.QIcon]
MESSAGE_PIXMAPS: dict[MessageLevel, PySide6.QtGui.QPixmap]

class Message:
    def __init__(self, key: enum.Enum, level: MessageLevel, text: str, icon: PySide6.QtGui.QIcon | None = None) -> None: ...
    def copy(self, key: enum.Enum | None = None) -> Message: ...
    def key(self) -> enum.Enum: ...
    def text(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def level(self) -> MessageLevel: ...
    def setLevel(self, level: MessageLevel) -> None: ...
    def icon(self) -> PySide6.QtGui.QIcon: ...
    def setIcon(self, icon: PySide6.QtGui.QIcon | None) -> None: ...
    def setBoard(self, board: MessageBoard) -> None: ...
    def board(self) -> MessageBoard | None: ...

class MessageBoard(QtWidgets.QFrame):
    '''
    This is a fairly simple widget for displaying informational messges,
    warnings, and/or errors in a Qt interface. For example, if the user inputs
    in a dialog means a file will be overwritten, you can display a warning
    message at the bottom of the dialog UI.

    A `MessageBoard` object can be shared between different components of the
    dialog UI that need to display messages. The pattern for this is for the
    component to have a `setMessageBoard()` method which tells the component
    which board to use to display messages. In that method, the component can
    register any messages it will want to display.

    This widget is primarily designed to display from a set of pre-registered
    messages, rather than dynamically generating messages. This is to make it
    more "type checkable" since your IDE can help ensure you\'re displaying
    existing messages. The "keys" used to reference messages are expected to be
    `enum.Enum` objects for this reason.

    However, you can also display messages dynamically. You can call
    `showCustomMessage()` with a `Message` object, and/or use `updateDisplay()`
    to change the level, text, or icon of a currently visible messasge.
    Using the `setLevel()`, `setText()`, and `setIcon()` of the `Message` object
    will also update the board if the message is currently visible.

    You can also use `{keyword}` placeholders in message text, and then supply
    the replacements in keyword arguments to `showMessage()` or
    `updateDisplay()`.

    "Auto-reize" mode automatically sizes the list view inside the widget to the
    visible message rows. Turn off auto-resize if you want the board to be sized
    normally and scroll when necessary.
    '''
    LevelRole: int
    def __init__(self, link_callback: Callable[[str], None] | None = None, auto_resize: bool = True, parent: PySide6.QtWidgets.QWidget | None = None, transparent: bool = True) -> None: ...
    def view(self) -> PySide6.QtWidgets.QListWidget: ...
    def button(self) -> PySide6.QtWidgets.QPushButton | None: ...
    def setButton(self, button: PySide6.QtWidgets.QPushButton) -> None: ...
    def autoResize(self) -> bool: ...
    def setAutoResize(self, auto_resize: bool) -> None: ...
    def message(self, key: enum.Enum) -> Message: ...
    def updateDisplay(self, key: enum.Enum, level: MessageLevel | None = None, text: str | None = None, icon: PySide6.QtGui.QIcon | None = None, **keywords: str) -> None: ...
    def register(self, message: Message) -> None: ...
    def registerMessage(self, key: enum.Enum, level: MessageLevel, text: str) -> None: ...
    def registerInfo(self, key: enum.Enum, text: str) -> None: ...
    def registerWarning(self, key: enum.Enum, text: str) -> None: ...
    def registerError(self, key: enum.Enum, text: str) -> None: ...
    def setMessageVisible(self, key: enum.Enum, visible: bool, **keywords: str) -> None: ...
    def showCustomMessage(self, message: Message) -> None: ...
    def showMessage(self, key: enum.Enum, **keywords: str) -> None: ...
    def hideMessage(self, key: enum.Enum) -> None: ...
    def clear(self) -> None: ...

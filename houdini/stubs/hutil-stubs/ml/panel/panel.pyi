def applySmoothing(values: Sequence[float] | npt.NDArray[np.number], weight: float, pin_endpoints: bool = False) -> npt.NDArray[np.number]:
    """
    Apply exponential moving average smoothing with debiasing.
    Optionally pins the first and last value to maintain original start/end points.

    Args:
        values: List or numpy array of y-values to smooth
        weight: Smoothing weight from 0.0 (no smoothing) to 1.0 (max smoothing)
        pin_endpoints: Whether to pin first and last point (default: False)

    Returns:
        Smoothed numpy array with same length as input
    """
def analyzeDataForLogScale(plot_lines: Sequence[Line2D]) -> _LogScaleAnalysis:
    """
    Analyze plot data to determine safe parameters for symlog scale.

    Args:
        plot_lines: List of matplotlib Line2D objects containing plot data

    Returns:
        dict with keys:
            - 'has_data': bool
            - 'y_min': minimum non-zero positive Y value (or None)
            - 'y_max': maximum Y value (or None)
            - 'safe_linthresh': recommended linthresh value
            - 'safe_bottom': recommended Y-axis minimum
    """


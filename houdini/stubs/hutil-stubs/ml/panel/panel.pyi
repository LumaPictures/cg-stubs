class GridLinesManager:
    """
    Manages all logic and display related to grid lines.
    The grid will consist of thick lines and multiple thin lines
    between each pair of thick lines. The location of the 
    leftmost, rightmost, topmost, and bottommost lines, which are the 
    boundary lines, will be stored to avoid redraws. The offsets represent 
    the distance between the boundary line and the closest thick line, and 
    therefore will always be a value between 0 and the number of thin lines 
    between each pair of thick lines.
    """
    ax: Axes
    grid_lines: list[Line2D]
    period: int
    line_color: str
    thin_line_style: str
    thick_line_style: str
    thick_line_width: float
    thin_line_width: float
    leftmost: float | None
    rightmost: float | None
    topmost: float | None
    bottommost: float | None
    v_step_size: float | None
    h_step_size: float | None
    left_offset: int
    right_offset: int
    top_offset: int
    bottom_offset: int
    def __init__(self, ax: Axes) -> None: ...
    def setLeftMost(self, leftmost: float | None) -> None: ...
    def setRightMost(self, rightmost: float | None) -> None: ...
    def setTopMost(self, topmost: float | None) -> None: ...

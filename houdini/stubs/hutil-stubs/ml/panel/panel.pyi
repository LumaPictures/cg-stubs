class FileMonitor(QFileSystemWatcher):
    """
    Handles logic related to asynchronous file updates so that changes
    are reflected in the panel
    """
    widget: PlotDisplay
    def __init__(self, widget: PlotDisplay) -> None: ...
    def onFileChange(self, file_path: str) -> None: ...
    def clearFiles(self) -> None: ...

class FilePoller(QWidget):
    """
    Creates a QTimer that fires every second. The timer stops when the file
    is created, at which point the file monitor adds the file to its watchlist.
    """
    callback_func: Callable[[str], object]
    timer: QtCore.QTimer
    file_path: str | None
    def __init__(self, callback_func: Callable[[str], object]) -> None: ...
    def setFilePath(self, file_path: str | None) -> None: ...
    def addFileIfExists(self) -> None: ...

class FilePollersList(list[FilePoller]):
    """
    Manages a list of file pollers
    """
    def addFilePollerWithPath(self, file_path: str, callback_func: Callable[[str], object]) -> None: ...
    def clearFilePollers(self) -> None: ...


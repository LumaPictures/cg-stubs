import os
from . import stores as stores
from .processing import Processor as Processor
from .search.indexing import Document as Document
from .stores import Store as Store
from .zones import Zone as Zone
from _typeshed.wsgi import WSGIApplication as WSGIApplication
from collections.abc import Iterator
from typing import Any, Callable, Iterable, Mapping, Sequence
from werkzeug.routing import Rule

from typing import TypeVar
from typing import TypeVar
_F = TypeVar('_F', bound=Callable[..., Any])
class Config(dict[str, Any]):
    def __init__(self, *args: Mapping[str, object] | Iterable[tuple[str, object]], store: stores._StoreObj | None = None, db_path: str | os.PathLike[str] | None = None, **kwargs: object) -> None: ...
    def plugins(self) -> Sequence[Plugin]: ...
    def pre_processor(self) -> Processor: ...
    def post_processor(self) -> Processor: ...
    def from_envvar(self, variable_name: str, silent: bool = False) -> bool: ...
    def from_prefixed_env(self, prefix: str = 'HELPFX', *, loads: Callable[[str], object] = ...) -> bool: ...
    def from_pyfile(self, path: str | os.PathLike[str], silent: bool = False) -> bool: ...
    def from_object(self, obj: object) -> None: ...
    def from_file(self, path: str | os.PathLike[str], load: Callable[[str], Mapping[str, object]], silent: bool = False) -> bool: ...
    def from_mapping(self, mapping: Mapping[str, object] | None = None, **kwargs: object) -> bool: ...
    def get_plugin(self, name: str) -> Plugin | None: ...
    def start_server(self, name: str | None = 'werkzeug', *args: Any, **kwargs: Any) -> None: ...

class Plugin:
    name: str
    def __init__(self, config: Config) -> None: ...
    def config(self) -> Config: ...
    def static_map(self) -> dict[str, str] | None: ...
    def stores(self) -> Sequence[Store]: ...
    def pre_processors(self) -> Sequence[Processor]: ...
    def post_processors(self) -> Sequence[Processor]: ...
    def provides_server(self) -> bool: ...
    def start_server(self, app: WSGIApplication, address: str, port: str | int, workers: int, debug: bool, reload: bool, static_map: dict[str, str] | None = None, port_callback: Callable[[], int] | None = None) -> None: ...
    def routing_rules(self) -> Iterator[Rule]: ...
    def process_searchable(self, zone: Zone, fields: Document) -> None: ...

def make_plugin(config: Config, obj: Plugin | str | dict[str, Any]) -> Plugin: ...
def endpoint(*points: str, methods: Sequence[str] = ('GET', 'POST'), alias: str | None = None) -> Callable[[_F], _F]: ...
def standard_plugins(config: Config) -> list[Plugin]: ...
def get_default_config() -> Config: ...

from typing import Any
import io
import pathlib
import zipfile
from . import util as util
from .config import Config as Config
from .paths import WikiPath as WikiPath
from collections.abc import Iterator, Mapping
from datetime import datetime
from importlib.resources.abc import Traversable
from typing import IO, Iterable, Sequence

from typing import TypeAlias
from typing import TypeAlias
_StoreObj: TypeAlias = 'str | pathlib.Path | Store | dict[str, Any] | list[_StoreObj] | tuple[_StoreObj, ...] | Config'
DOC_KEY: str
EXTRA_DOC_KEY: str
MOUNTS_KEY: str

def file_etag(path: pathlib.Path) -> str: ...

class ResourceNotFound(Exception): ...

def store_from_config(config: Config) -> Store: ...
def store_from_obj(obj: _StoreObj) -> Store: ...

class Store:
    def filepath(self, path: WikiPath) -> pathlib.Path | None: ...
    def is_dir(self, path: WikiPath) -> bool: ...
    def iterdir(self, path: WikiPath) -> Iterable[str]: ...
    def exists(self, path: WikiPath) -> bool: ...
    def last_modified(self, path: WikiPath) -> datetime: ...
    def size(self, path: WikiPath) -> int: ...
    def redirect(self, top_store: Store, path: WikiPath) -> WikiPath | None: ...
    def open(self, path: WikiPath) -> IO[bytes]: ...
    def open_text(self, path: WikiPath, encoding: str = 'utf-8') -> IO[str]: ...
    def mkdir(self, path: WikiPath, name: str, parents: bool = False, exist_ok: bool = False) -> None: ...
    def read_bytes(self, path: WikiPath) -> bytes: ...
    def read_text(self, path: WikiPath) -> str: ...
    def etag(self, path: WikiPath) -> str | None: ...
    def all_paths(self, start: str | WikiPath = '/') -> Iterator[WikiPath]: ...
    def close(self) -> None: ...
StoreSpec = Store | str | pathlib.Path | Sequence[pathlib.Path]

class FileStore(Store):
    dirpath: pathlib.Path
    def __init__(self, dirpath: str | pathlib.Path) -> None: ...
    def filepath(self, path: str | WikiPath) -> pathlib.Path: ...
    def is_dir(self, path: str | WikiPath) -> bool: ...
    def iterdir(self, path: str | WikiPath) -> Iterable[str]: ...
    def exists(self, path: str | WikiPath) -> bool: ...
    def last_modified(self, path: WikiPath) -> datetime: ...
    def size(self, path: WikiPath) -> int: ...
    def open(self, path: WikiPath) -> io.BytesIO: ...
    def etag(self, path: WikiPath) -> str | None: ...

class ZipStore(Store):
    zip_path: pathlib.Path
    def __init__(self, zip_path: pathlib.Path) -> None: ...
    @property
    def zip_file(self) -> zipfile.ZipFile: ...
    def is_dir(self, path: WikiPath) -> bool: ...
    def etag(self, path: WikiPath) -> str | None: ...
    def exists(self, path: WikiPath) -> bool: ...
    def iterdir(self, path: WikiPath) -> Iterable[str]: ...
    def last_modified(self, path: WikiPath) -> datetime: ...
    def size(self, path: WikiPath) -> int: ...
    def read_bytes(self, path: WikiPath) -> bytes: ...
    def open(self, path: WikiPath) -> io.BytesIO: ...
    def close(self) -> None: ...

class WrappingStore(Store):
    def __init__(self, store: Store) -> None: ...
    def is_dir(self, path: WikiPath) -> bool: ...
    def redirect(self, top_store: Store, path: WikiPath) -> WikiPath | None: ...
    def filepath(self, path: WikiPath) -> pathlib.Path | None: ...
    def etag(self, path: WikiPath) -> str | None: ...
    def exists(self, path: WikiPath) -> bool: ...
    def iterdir(self, path: WikiPath) -> Iterable[str]: ...
    def last_modified(self, path: WikiPath) -> datetime: ...
    def size(self, path: WikiPath) -> int: ...
    def open(self, path: WikiPath) -> IO[bytes]: ...
    def read_bytes(self, path: WikiPath) -> bytes: ...
    def read_text(self, path: WikiPath) -> str: ...
    def close(self) -> None: ...

class MountStore(WrappingStore):
    prefix_path: WikiPath
    def __init__(self, store: Store, prefix_path: str | WikiPath) -> None: ...
    def iterdir(self, path: WikiPath) -> Iterable[str]: ...

class PackageStore(Store):

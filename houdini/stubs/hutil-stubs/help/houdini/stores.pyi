from .api import NodePathComponents as NodePathComponents, dir_to_category as dir_to_category, pathToNodeType as pathToNodeType
from collections.abc import Iterator
from datetime import datetime
from hutil.help.paths import WikiPath as WikiPath
from hutil.help.stores import FileStore as FileStore, HideStore as HideStore, OverlayStore as OverlayStore, ResourceNotFound as ResourceNotFound, Store as Store

class HoudiniPathStore(OverlayStore):
    def __init__(self, path: str = 'help') -> None: ...

class HiddenNodeStore(HideStore):
    def hidden(self, path: WikiPath) -> bool: ...
    def redirect(self, top_store: Store, path: WikiPath) -> WikiPath | None: ...

class AssetStore(Store):
    def exists(self, path: WikiPath) -> bool: ...
    def is_dir(self, path: WikiPath) -> bool: ...
    def iterdir(self, path: WikiPath) -> Iterator[str]: ...
    def last_modified(self, path: WikiPath) -> datetime: ...
    def read_text(self, path: WikiPath) -> str: ...
    def etag(self, path: WikiPath) -> str | None: ...
    def size(self, parts: WikiPath) -> int: ...

class ShelfStore(Store):
    def is_dir(self, path: WikiPath) -> bool: ...
    def exists(self, path: WikiPath) -> bool: ...
    def iterdir(self, path: WikiPath) -> Iterator[str]: ...
    def read_text(self, path: WikiPath) -> str: ...

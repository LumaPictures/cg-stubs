    def fromTypeName(cls, nodetype_name: str, table: str | None = None) -> Self: ...
    @property
    def dirName(self) -> str: ...
    @property
    def category(self) -> hou.NodeTypeCategory: ...
    def nodeType(self) -> hou.NodeType | None: ...
    def filename(self, no_version: bool = False) -> str: ...
    def typeName(self) -> str: ...

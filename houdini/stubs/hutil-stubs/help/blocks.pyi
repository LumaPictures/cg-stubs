import re
import typing
from . import functions as functions
from .paths import WikiPath as WikiPath
from collections.abc import Iterator
from typing import Any, Callable as Callable, Iterable, Self, Sequence, TypeAlias, TypedDict


from typing import TypeAlias
Text: TypeAlias = 'str | SpanType | Sequence[Text]'
_Data: TypeAlias = 'str | Sequence[_Data] | _WikiData | None'
_ToData: TypeAlias = 'str | WikiType | Sequence[_ToData] | None'
class _WikiData(TypedDict, total=False):
    id: str
    type: str
    text: _Data
    attrs: dict[str, Any]
    body: list[_WikiData]

CONTAINER_TYPES: tuple[str, str, str, str]
tag_expr: re.Pattern[str]

def join_text(obj: Text | None) -> Text:
    '''
    Joins adjacent strings in a "text" list together. This function recursively
    descends into "text" keys found on non-string spans in the list.
    '''
@typing.overload
def to_data(obj: str) -> str: ...
@typing.overload
def to_data(obj: None) -> None: ...
@typing.overload
def to_data(obj: WikiType) -> _WikiData: ...
@typing.overload
def to_data(obj: Sequence[WikiType]) -> list[_WikiData]: ...
@typing.overload
def to_data(obj: _ToData) -> _Data: ...
def text_from_data(data: _Data) -> Text: ...
def block_from_data(data: _WikiData, path: WikiPath | None = None) -> BlockType: ...
def text_replace(text: Text, target: str, replacement: str) -> Text: ...
def copytext(text: Text) -> Text: ...

class WikiType:
    attrs: dict[str, Any]
    type: str | None
    text: Text
    shortname: str
    role: str | None
    memo: dict[str, Any]
    def __init__(self, typename: str | None = None, text: Text = '', **kwargs: object) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def id(self) -> str | None: ...
    @id.setter
    def id(self, ident: str) -> None: ...
    def copy(self) -> Self: ...
    def boolean_attr(self, name: str, default: bool) -> bool: ...
    def find_spans(self, typename: str) -> Iterator[SpanType]: ...
    def text_data(self) -> str | list[Text] | None: ...
    def data(self) -> _WikiData: ...

class BlockType(WikiType):
    role: str | None
    shortname: str
    body: list[BlockType]
    def __init__(self, typename: str | None = None, body: Iterable[BlockType] = ..., text: Text = '', role: str | None = None, **kwargs: object) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def dump(self, tab: int = 0) -> None: ...
    def should_index(self) -> bool: ...
    def index_as_doc(self) -> bool: ...
    @property
    def title(self) -> Text | None: ...
    @property
    def title_string(self) -> str | None: ...
    def tags(self) -> set[str] | tuple[()]: ...
    @property
    def is_container(self) -> bool: ...
    @property
    def is_heading(self) -> bool: ...
    @property
    def heading_level(self) -> int: ...
    def copy(self) -> Self: ...
    def keywords(self, attr_name: str) -> frozenset[str]: ...
    def identifier(self) -> str: ...
    def summary(self) -> Text: ...
    def iter_blocks(self, recursive: bool = False, into_containers: bool = True) -> Iterator[BlockType]: ...
    def find_blocks(self, typenampe: str, recursive: bool = True) -> Iterator[BlockType]: ...
    def first_subblock(self, typename: str | None = None) -> BlockType | None: ...
    def find_matching(self, predicate: Callable[[BlockType], bool], into_containers: bool = True, recursive: bool = True) -> Iterator[BlockType]: ...
    def find_id(self, ident: str) -> BlockType | None: ...
    def find_links(self) -> Iterator[SpanType]: ...
    def first_subblock_text(self) -> Text: ...
    def data(self) -> _WikiData: ...

class SpanType(WikiType):
    shortname: str
    def __add__(self, other: str | SpanType | Sequence[str | SpanType]) -> Self | list[str | SpanType]: ...
    def __radd__(self, other: str | SpanType | Sequence[str | SpanType]) -> Self | list[str | SpanType]: ...

class Root(BlockType):
    shortname: str
    path: WikiPath | None
    parents: list[WikiType]
    def __init__(self, body: Iterable[BlockType] = ..., path: WikiPath | None = None, **kwargs: Any) -> None: ...
    @property
    def title(self) -> Text | None: ...
    def summary(self) -> Text: ...
    def subtopics(self) -> BlockType | None: ...
    @property
    def page_type(self) -> str | None: ...

def span(typename: str, text: Text, **kwargs: object) -> SpanType: ...
def block(typename: str, indent: int, text: Text, **kwargs: Any) -> BlockType: ...
def codeblock(indent: int, text: str | list[str], **kwargs: Any) -> BlockType: ...
def remove_common_indent(text: str, indent: int) -> str: ...

    def load(self, path: str | WikiPath, *, context: WikiContext | None = None, searcher: searching.Searcher | None = None, conditional: bool = True, process: bool = True, post_process: bool = True, save_to_cache: bool = True, env: dict[str, Any] | None = None, allow_redirect: bool = False, including: bool = False, depth: int = 0) -> Root: ...

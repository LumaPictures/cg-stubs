class DocPathMissing(Exception): ...

class Document:
    path: str
    title: str | None
    content: str
    summary: str | None
    bestbet: str | None
    modified: datetime
    type: str | None
    icon: str | None
    sortkey: str | None
    category: str | None
    grouping: str | None
    tags: set[str]
    rels: dict[str, str] | dict[str, str | Sequence[str]] | dict[str, str | Sequence[str] | None]
    highlight: str | None
    def __init__(self, path: str, title: str | None = None, content: str | None = None, *, summary: str | None = None, bestbet: str | None = None, modified: float | datetime | None = None, type: str | None = None, icon: str | None = None, sortkey: str | None = None, category: str | None = None, grouping: str | None = None, tags: Collection[str] = ..., rels: dict[str, str] | dict[str, str | Sequence[str]] | dict[str, str | Sequence[str] | None] | None = None, highlight: str | None = None) -> None: ...
    def __eq__(self, other: Document) -> bool: ...
    def row_dict(self) -> dict[str, str | float | None]: ...

class Db:
    lang: str
    tag_table: str
    prop_table: str
    key_field: str
    content_field: str
    doc_fields: dict[str, str]
    fts_fields: dict[str, str]
    trigram_fields: dict[str, str]
    def __init__(self, conn: sqlite3.Connection, lang: str = 'en') -> None: ...
    @classmethod
    def in_memory(cls, lang: str = 'en') -> Db: ...
    @classmethod
    def open_file(cls, filepath: str | pathlib.Path, create: bool = True, clear: bool = False, lang: str = 'en') -> Db: ...
    def drop_tables(self) -> None: ...
    @property
    def fts_table(self) -> str: ...
    @property
    def trigram_table(self) -> str: ...
    @property
    def doc_table(self) -> str: ...
    @property
    def tokenizer(self) -> str: ...
    def field_values(self, path: str) -> dict[str, str | float | None] | None: ...
    def create_tables(self) -> None: ...
    def optimize(self) -> None: ...
    def connection(self) -> sqlite3.Connection: ...
    def cursor(self) -> sqlite3.Cursor: ...
    def doc_count(self, cursor: sqlite3.Cursor | None = None) -> int: ...
    def doc_id_for(self, fieldname: str, value: str, cursor: sqlite3.Cursor | None = None) -> int | None: ...
    def doc_id_for_path(self, path: str, cursor: sqlite3.Cursor | None = None) -> int: ...
    def path_exists(self, path: str, cursor: sqlite3.Cursor | None = None) -> bool: ...
    def all_paths(self, cursor: sqlite3.Cursor | None = None) -> Iterator[str]: ...
    def to_doc_id(self, doc_id: str | int, cursor: sqlite3.Cursor | None = None) -> int: ...
    def all_tags(self, cursor: sqlite3.Cursor | None = None) -> set[str]: ...
    def tag_exists(self, tag: str, cursor: sqlite3.Cursor | None = None) -> bool: ...
    def writer(self) -> Writer: ...
    def searcher(self) -> Searcher: ...
    def clear(self) -> None: ...
    def close(self) -> None: ...

class Writer:
    db: Db
    insert_statement: str
    def __init__(self, db: Db) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...
    def connection(self) -> sqlite3.Connection: ...
    def cursor(self) -> sqlite3.Cursor: ...
    def add_tags(self, doc_id: str | int, tags: Iterable[str]) -> None: ...
    def add_property(self, doc_id: str | int, rel: str, value: str) -> int: ...
    def add_properties(self, doc_id: str | int, items: Iterable[tuple[str, str]]) -> None: ...
    def remove_tags_from_path(self, doc_id: str | int, tags: Collection[str] | None = None) -> None: ...
    def delete_tag(self, tag: str) -> None: ...
    def delete_paths(self, paths: Sequence[str], *, fragments: bool = True, docs: bool = True, tags: bool = True, props: bool = True) -> None: ...
    def delete_path(self, path: str, *, fragments: bool = True, docs: bool = True, tags: bool = True, props: bool = True) -> None: ...
    def index_documents(self, docs: Sequence[Document]) -> None: ...
    def index_document(self, doc: Document, *, with_deletion: bool = True) -> int: ...
    def modified_map(self) -> dict[str, datetime]: ...
    def commit(self, optimize: bool = False, vacuum: bool = False) -> None: ...
    def cancel(self) -> None: ...
    def close(self) -> None: ...

def rebuild_search_index(zone: Zone, clean: bool = False, start: str | WikiPath = '/') -> None: ...
def try_searching() -> None: ...


import enum
import typing
from ..paths import WikiPath as WikiPath
from .indexing import Db as Db, Document as Document
from collections.abc import Iterator
from types import TracebackType
from typing import Collection, Iterable, Literal, Self, Sequence, TypeVar

from typing import TypeAlias
from typing import TypeVar
from typing import TypeAlias
T = TypeVar('T')
_SqlArgs: TypeAlias = dict[str, str | int | float]
RelDict = dict[str, str | list[str]]

def append_rel(d: RelDict, key: str, value: str) -> None: ...

class Searcher:
    db: Db
    def __init__(self, db: Db, caching: bool = True) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> Literal[False]: ...
    def refresh(self) -> None: ...
    def path_exists(self, path: str) -> bool: ...
    def tag_exists(self, tag: str) -> bool: ...
    def doc_count(self) -> int: ...
    def all_tags(self) -> Collection[str]: ...
    def all_paths(self) -> Iterable[str]: ...
    def tag_counts(self) -> dict[str, int]: ...
    def paths_with_tag(self, tag: str) -> list[str]: ...
    def tags_for_path(self, path: str) -> set[str]: ...
    def path_has_tag(self, path: str, tag: str) -> bool: ...
    def paths_matching(self, fieldname: str, value: str | int | float, comparison: str = '==', order_by: str = 'path', limit: int = 999999999) -> Iterator[str]: ...
    def path_matching(self, fieldname: str, value: str | int | float) -> str | None: ...
    def document(self, path: str | WikiPath) -> Document | None: ...
    def document_dict(self, path: str | WikiPath) -> dict[str, str | float | None] | None: ...
    def find_relationships(self, path: str | None = None, rel: str | None = None, value: str | None = None, limit: int | None = None) -> list[tuple[int, str, str]]: ...
    def relationships_from_path(self, path: str) -> RelDict:
        """
        Given a path, return a dict mapping relationship names to the value(s)
        of those relationships (the value is a string if there was only one
        relation for the path with that the name, or a list of strings if there
        were multiple).
        """
    def relationships_of_type(self, rel_name: str) -> RelDict:
        """
        Given a relationship name, return a dict mapping paths to the value(s)
        of that relationship for the path (the value is a string if there was
        only one relation for the path with that name, or a list of strings if
        there were multiple).
        """
    def values(self, path: str, rel: str) -> list[str]:
        """
        Given a path and a relationship name, returns a list of values for that
        relationship for that path. If there is no such relationship, the list
        is empty.
        """
    def from_paths(self, rel: str, value: str) -> list[str]:
        '''
        Given a relationship name and a value, returns a list of paths that have
        that relationship with that value.

        An exmaple would be to find all the pages that have a certain path as
        their "parent": `children = s.from_paths("parent", this_path)`
        '''
    def follow_forward(self, path: str, rel: str, seen: set[str] | None = None) -> list[str]: ...
    def follow_backward(self, path: str, rel: str, seen: set[str] | None = None) -> list[str]: ...
    def run_query(self, query: Query) -> Hits: ...
    def search(self, text: str, *, highlight: bool = False, order_by: str | None = None, limit: int = 999999, trigrams: bool = False) -> Hits: ...
    def close(self) -> None: ...

class Hits:
    docs: Sequence[Document]
    error: str | None
    def __init__(self, docs: Sequence[Document], error: str | None = None) -> None: ...
    def __bool__(self) -> bool: ...
    def __len__(self) -> int: ...
    @typing.overload
    def __getitem__(self, item: int) -> Document: ...
    @typing.overload
    def __getitem__(self, item: slice) -> Sequence[Document]: ...

class Need(enum.Enum):
    optional = enum.auto()
    required = enum.auto()
    banned = enum.auto()

class Predicate: ...

class Fts5Predicate(Predicate):
    def syntax(self) -> str: ...

class SimpleFts5Predicate(Fts5Predicate): ...

class Fts5Word(SimpleFts5Predicate):
    word: str
    def __init__(self, word: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def syntax(self) -> str: ...

class Fts5Prefix(Fts5Word):
    def syntax(self) -> str: ...

class Fts5Initial(Fts5Word):
    def syntax(self) -> str: ...

class Fts5Phrase(Fts5Predicate):
    words: tuple[SimpleFts5Predicate, ...]
    def __init__(self, words: Sequence[SimpleFts5Predicate]) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def syntax(self) -> str: ...

class Fts5Fielded(Fts5Predicate):
    field: str
    q: SimpleFts5Predicate | Fts5Phrase | Fts5Near
    def __init__(self, field: str, q: SimpleFts5Predicate | Fts5Phrase | Fts5Near) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def syntax(self) -> str: ...

class Fts5Binary(Fts5Predicate):
    left: Fts5Predicate
    right: Fts5Predicate
    template: str
    extras: dict[str, object]
    def __init__(self, left: Fts5Predicate, right: Fts5Predicate) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def syntax(self) -> str: ...

class Fts5Near(Fts5Binary):
    template: str
    def __init__(self, left: Fts5Phrase | Fts5Word, right: Fts5Phrase | Fts5Word, max_dist: int = 10) -> None: ...

class Fts5And(Fts5Binary):
    template: str

class Fts5Or(Fts5Binary):
    template: str

class Fts5Not(Fts5Binary):
    template: str
    def __eq__(self, other: object) -> bool: ...

class SqlPredicate(Predicate):
    necessity: Need
    comparison: str
    def __init__(self, necessity: Need = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def optional(self) -> SqlPredicate: ...
    def required(self) -> SqlPredicate: ...
    def banned(self) -> SqlPredicate: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class FieldPredicate(SqlPredicate):
    field: str
    comparison: str
    value: str | int | float
    def __init__(self, field: str, value: str | int | float, op: str = '==', necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class FieldPrefixPredicate(FieldPredicate):
    comparison: str
    def __init__(self, field: str, value: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class TagPredicate(SqlPredicate):
    tag: str
    def __init__(self, tag: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class PropertyPredicate(SqlPredicate):
    rel: str
    value: str
    def __init__(self, rel: str, value: str, necessity: Need = ...) -> None: ...
    def sql(self, table: str, args: _SqlArgs) -> str: ...

class Query:
    db: Db
    fts5: Fts5Predicate | None
    predicates: Sequence[SqlPredicate]
    snippets: bool
    snippet_column: int
    snippet_window: int
    snippet_start: str
    snippet_end: str
    snippet_joiner: str
    def __init__(self, db: Db, fts5: Fts5Predicate | None = None, predicates: Sequence[SqlPredicate] = ..., snippets: bool = True) -> None: ...
    def order_by(self, order_by: str | Sequence[str]) -> Query: ...
    def with_snippets(self, snippets: bool = True, *, column: int | None = None, window: int | None = None, start: str | None = None, end: str | None = None, joiner: str | None = 'None') -> Query: ...
    def find_predicates(self, cls: type[T], necessity: Need | None = None) -> list[T]: ...
    def tag_predicates(self, necesssity: Need | None = None) -> list[TagPredicate]: ...
    def property_predicates(self, necesssity: Need | None = None) -> list[PropertyPredicate]: ...
    def field_predicates(self, necesssity: Need | None = None) -> list[FieldPredicate]: ...
    def sql(self) -> tuple[str, _SqlArgs]: ...

    def __init__(self, aruri: HprUri | None, parent: HprUriItem | None, icon: QtGui.QIcon = ..., node: hou.OpNode | None = None, topLevelItem: HprUriItem | None = None, arWidget: ArVersioner | PinVersionDialog | None = None) -> None: ...
    @staticmethod
    def root() -> HprUriItem: ...
    def clearChildren(self) -> None: ...

class PrimTreeView(_houqt.QT_PrimTreeView):
    """
    The list of source items.
    This is also the base class for the sheet treeview.
    """
    DefaultColumns: tuple[int, ...]
    def __init__(self, enable_create_collections: bool = True, enable_drop: bool = True) -> None:
        """
            :param enable_create_collections: If set to False, the option to add collections
                is omitted from the tree view.
        """
    def addAttributes(self, attr_names: Iterable[str]) -> None: ...
    def setAttributes(self, attr_names: Iterable[str]) -> None: ...
    def attributes(self) -> list[str]: ...
    def setModel(self, model: PySide6.QtCore.QAbstractItemModel | None) -> None: ...
    def mouseReleaseEvent(self, event: PySide6.QtGui.QMouseEvent) -> None: ...
    def dragEnterEvent(self, event: PySide6.QtGui.QDragEnterEvent) -> None: ...
    def dragMoveEvent(self, event: PySide6.QtGui.QDragMoveEvent) -> None: ...
    def dragLeaveEvent(self, event: PySide6.QtGui.QDragLeaveEvent) -> None: ...
    def dropEvent(self, event: PySide6.QtGui.QDropEvent) -> None: ...
    def dropIndicatorColor(self) -> PySide6.QtGui.QColor: ...
    def pendingSelectionPaths(self) -> list[str]:
        """
        Paths saved on the last model reset and not yet reapplied.
        Empty once the restore has run.
        """
    def selectIndexesForRestore(self, indexes: Sequence[PySide6.QtCore.QModelIndex]) -> None:
        """
        Add 'indexes' to the selection as part of restoring a saved selection.
        """
    def getSelected(self, column: int = -1) -> list[PySide6.QtCore.QModelIndex]: ...
    def getSelectedPaths(self) -> list[str]: ...
    def selectItemsByFullPath(self, items: Iterable[str | Sdf.Path], top_level_only: bool = True, parent: PySide6.QtCore.QModelIndex = ..., auto_expand: bool = False, interruptible_op: hou.InterruptableOperation | None = None) -> None:
        """
        Given a list of full paths, select any items in the tree that match.
        'top_level_only' means the top level for the parent path grouping,
        not the root level of the tree.
        """
    def highlightItemsByFullPath(self, items: Iterable[str | Sdf.Path], top_level_only: bool = True, parent: PySide6.QtCore.QModelIndex = ..., auto_expand: bool = False, interruptible_op: hou.InterruptableOperation | None = None) -> None:
        """
        Given a list of full paths, highlight any items in the tree that match.
        'top_level_only' means the top level for the parent path grouping,
        not the root level of the tree.
        """
    def createCollection(self, includes: Sequence[PySide6.QtCore.QModelIndex] = ...) -> None: ...
    def deleteCollections(self, indexes: Sequence[PySide6.QtCore.QModelIndex]) -> None: ...
    def createContextActions(self, indexes: Sequence[PySide6.QtCore.QModelIndex], menu: PySide6.QtWidgets.QMenu) -> None: ...


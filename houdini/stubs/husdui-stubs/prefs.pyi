import collections
import typing
from collections.abc import Sequence
from houtypes import JSONLike, JSONValue
from husdui.common import debug_print as debug_print, error_print as error_print
from typing import Literal, TypedDict

from typing import TypeVar
from typing_extensions import TypeVar
_D = TypeVar('_D', default=None)
class _AttrConfig(TypedDict, total=False):
    default: float | str | Sequence[float]
    identity: float | Sequence[float]
    min: float
    max: float
    type: str
    component_type: str
    modify: str
    scale: str
    precision: float
    uitype: int
    label: str
    component_labels: Sequence[str]
    kwargs: dict[str, JSONValue]

class Prefs:
    def __init__(self, pref_filename: str) -> None: ...
    @typing.overload
    def pref(self, pref_name: Literal['lights.search', 'collections.search', 'sheet.show_attributes', 'mixer.show_attributes'], default: object = ...) -> list[str]: ...
    @typing.overload
    def pref(self, pref_name: Literal['attributes.config'], default: object = ...) -> dict[str, _AttrConfig]: ...
    @typing.overload
    def pref(self, pref_name: Literal['main.default_tab'], default: object = ...) -> int: ...
    @typing.overload
    def pref(self, pref_name: str, default: _D = ...) -> JSONValue | _D: ...
    def writePrefs(self) -> None: ...
    def readPrefs(self) -> None: ...
    def setAttrAllConfig(self, attr_name: str, attr_config: _AttrConfig) -> None: ...
    def attrAllConfig(self, attr_name: str) -> _AttrConfig: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['type', 'component_type', 'modify', 'scale', 'label'], default: _D = ...) -> str | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['min', 'max', 'precision'], default: _D = ...) -> float | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['uitype'], default: _D = ...) -> int | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['default'], default: _D = ...) -> float | str | Sequence[float] | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['identity'], default: _D = ...) -> float | Sequence[float] | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['component_labels'], default: _D = ...) -> Sequence[str] | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: Literal['kwargs'], default: _D = ...) -> dict[str, JSONValue] | _D: ...
    @typing.overload
    def attrConfig(self, attr_name: str, config_name: str, default: _D = ...) -> JSONValue | tuple[JSONValue, ...] | _D: ...

class SimplePrefs:
    def __init__(self, filename: str) -> None: ...
    def setPref(self, name: str, value: JSONLike) -> None: ...
    def getPref(self, name: str, default: _D | None = None) -> JSONValue | _D: ...

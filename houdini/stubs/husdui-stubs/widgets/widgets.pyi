class HSlider(QtWidgets.QSlider):
    """
    A slider that can map a virtual value (the values used by the base
    QSlider) into an arbitrary actual value.  This should be subclassed and the
    functions actualToVirtual() anf virtualToActual() reimplemented to perform
    this mapping.
    """
    LabelsAbove: ClassVar[QtWidgets.QSlider.TickPosition]
    LabelsLeft: ClassVar[QtWidgets.QSlider.TickPosition]
    LabelsBelow: ClassVar[QtWidgets.QSlider.TickPosition]
    LabelsRight: ClassVar[QtWidgets.QSlider.TickPosition]
    NoLabels: ClassVar[QtWidgets.QSlider.TickPosition]
    LabelsBothSides: ClassVar[QtWidgets.QSlider.TickPosition]
    NoValueBox: ClassVar[QtWidgets.QSlider.TickPosition]
    ValueBoxLeft: ClassVar[QtWidgets.QSlider.TickPosition]
    ValueBoxRight: ClassVar[QtWidgets.QSlider.TickPosition]
    ValueBoxAbove: ClassVar[QtWidgets.QSlider.TickPosition]
    ValueBoxBelow: ClassVar[QtWidgets.QSlider.TickPosition]
    editRequested: ClassVar[QtCore.Signal]
    actualValueChanged: ClassVar[QtCore.Signal]
    hotkeyInvoked: ClassVar[QtCore.Signal]
    valueEdited: ClassVar[QtCore.Signal]
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    def setContextMenu(self, menu: QtWidgets.QMenu | None) -> None: ...
    def contextMenu(self) -> QtWidgets.QMenu | None: ...
    def setBreadth(self, breadth: int) -> None: ...
    def setMinimum(self, value: int) -> None: ...
    def setMaximum(self, value: int) -> None: ...
    def offset(self) -> int: ...
    def setOffset(self, offset: int) -> None: ...
    def zero(self) -> int: ...
    def setZero(self, value: int) -> None: ...
    def setValueBox(self, vbox: PointingLabel | None) -> None: ...
    def valueBoxPosition(self) -> QtWidgets.QSlider.TickPosition: ...
    def setValueBoxPosition(self, v: QtWidgets.QSlider.TickPosition) -> None: ...
    def tickColor(self) -> QtGui.QColor: ...
    def setTickColor(self, color: QtGui.QColor | QtCore.Qt.GlobalColor | str) -> None: ...
    def tickLength(self) -> int: ...
    def setTickLength(self, length: int) -> None: ...
    def tickLengthForValue(self, v: int) -> int: ...
    def tickColorForValue(self, v: int) -> QtGui.QColor: ...
    def labelTextColor(self) -> QtGui.QColor: ...
    def setLabelTextColor(self, color: QtGui.QColor | QtCore.Qt.GlobalColor | str) -> None: ...
    def labelTextColorForValue(self, v: int) -> QtGui.QColor: ...
    def labelPosition(self) -> QtWidgets.QSlider.TickPosition: ...
    def setLabelPosition(self, position: QtWidgets.QSlider.TickPosition) -> None: ...
    def setOrientation(self, orient: QtCore.Qt.Orientation) -> None: ...
    def labelTextSize(self) -> int: ...
    def setLabelTextSize(self, pixels: int) -> None: ...
    def labelGap(self) -> int: ...
    def setLabelGap(self, pixels: int) -> None: ...
    def tintColor(self) -> QtGui.QColor | None: ...
    def setTintColor(self, color: QtGui.QColor | None) -> None: ...
    def outlineColor(self) -> QtGui.QColor | None: ...
    def setOutlineColor(self, color: QtGui.QColor | None) -> None: ...
    def unitString(self) -> str: ...
    def setUnitString(self, unit: str) -> None: ...
    def precision(self) -> float: ...
    def setPrecision(self, value: float) -> None:
        """
        The precision is essentially the scale down factor used to go from a
        large range of 'int' values to a smaller more precise range of
        'float' values.  A precision of 0.1 will mean float values are
        accurate to one decimal place.
        """
    def virtualValueToActual(self, vv: float) -> float:
        """
        Virtual value is the internal integer range of the slider.
        Actual value is the externally available slider value.
        """
    def actualValueToVirtual(self, av: float) -> int:
        """
        Virtual value is the internal integer range of the slider.
        Actual value is the externally available slider value.
        """
    def actualRange(self) -> tuple[float, float]: ...
    def actualMinimum(self) -> float: ...
    def actualMaximum(self) -> float: ...
    def setActualRange(self, amin: float, amax: float) -> None:
        """
        Set the range for the slider.
        Actual value is the externally available slider value.
        """
    def actualValue(self) -> float:
        """
        Actual value is the externally available slider value.
        """
    def setActualValue(self, value: float) -> None:
        """
        Actual value is the externally available slider value.
        """
    def labelForValue(self, v: float) -> str:
        """
        Format the slider's value to be shown on a label.  This does not
        include the unit string.
        """
    def labelForTick(self, v: int) -> str | None:
        """
        Return the string to be shown for the tickmark at `value`.
        Labels are shown for every other tick mark.
        Units are not shown.
        Values 1000 or more are compacted using a suffix.
        """
    def grooveColorForValue(self, v: int) -> QtGui.QColor: ...
    def mousePressEvent(self, ev: QtGui.QMouseEvent) -> None: ...
    def mouseMoveEvent(self, ev: QtGui.QMouseEvent) -> None: ...
    def mouseReleaseEvent(self, ev: QtGui.QMouseEvent) -> None: ...
    def leaveEvent(self, ev: QtCore.QEvent) -> None: ...
    def numberformat(self) -> str:
        """
        Return the format string for this slider's labels.
        """
    def resizeEvent(self, ev: QtGui.QResizeEvent) -> None: ...
    def paintEvent(self, ev: QtGui.QPaintEvent) -> None: ...

class XMLMenuButton(QtWidgets.QToolButton):
    """
    A tool button that will show a dynamic XML menu.
    The signal `aboutToShowMenu` is emitted just before the menu will be popped
    up allowing the kwargs for the menu to be set by calling `updatekwargs()`.
    """
    aboutToShowMenu: ClassVar[QtCore.Signal]
    def __init__(self, xmlmenuparser: hou.qt.XMLMenuParser, kwargs: Mapping[str, object] | None = None, parent: QtWidgets.QWidget | None = None) -> None: ...
    def updateKwargs(self, kwargs: Mapping[str, object]) -> None:
        """
        Update the kwargs used when generating and executing menu items to be
        the base kwargs set when the button was created plus the kw args passed
        in now.
        """


from . import itemgrid as itemgrid, itemlibrary as itemlibrary, plglobals as plglobals, pose as pose
from hutil.Qt import QtCore, QtGui, QtWidgets
from poselib import posemodel as posemodel

class PoseGrid(itemgrid.GridView):
    nodeSelectRequested: QtCore.Signal
    blendStarted: QtCore.Signal
    blendEnded: QtCore.Signal
    blendChanged: QtCore.Signal
    blendMoved: QtCore.Signal
    def __init__(self, parent: QtWidgets.QWidget, model: posemodel.PoseGridModel) -> None: ...
    def mousePressEvent(self, event: QtGui.QMouseEvent) -> bool | None: ...
    def mouseMoveEvent(self, event: QtGui.QMouseEvent) -> bool | None: ...
    def mouseReleaseEvent(self, event: QtGui.QMouseEvent) -> bool | None: ...
    def setHasNode(self, has_node: bool) -> None: ...

class PoseGridDelegate(itemgrid.GridDelegate):
    """Represents an item in the Item Library grid interface."""
    indexRemoved: QtCore.Signal
    def paintLabel(self, painter: QtGui.QPainter, option: QtWidgets.QStyleOptionViewItem, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, pose_rect: QtCore.QRect, parm_rect: QtCore.QRect, frame_rect: QtCore.QRect) -> None: ...
    def paintOverlayIcons(self, painter: QtGui.QPainter, option: QtWidgets.QStyleOptionViewItem, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, rect: QtCore.QRect) -> None: ...

class BlendOverlay(QtWidgets.QWidget):
    """Widget which is positioned over a grid entry's name label to
       display the current blend amount."""
    blendChanged: QtCore.Signal
    def __init__(self, parent: PoseGrid) -> None: ...
    def __del__(self) -> None: ...

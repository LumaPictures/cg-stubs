import hou
import typing
from collections.abc import Collection, Iterable, Sequence
from typing import Any, Generic, Literal, Protocol

from typing import TypeVar
from typing import TypeVar
_V = TypeVar('_V', str, Sequence[float])
class _ThemeCallback(Protocol[_V]):
    def __call__(self, theme: ThemeData[_V] | None, node_type: hou.NodeType | None = ..., /) -> None: ...

theNodeCats: list[hou.NodeTypeCategory]
theNodeCatNames: list[str]

class ThemeType(Generic[_V]):
    ext: str
    callback: _ThemeCallback[_V]
    description: str
    default: str
    current: str
    themes: dict[str, ThemeData[_V]]
    def __init__(self, ext: str, callback: _ThemeCallback[_V], description: str, default: str) -> None: ...

class ThemeData(Generic[_V]):
    data: Iterable[tuple[str, _V]]
    name: str | None
    filepath: str | None
    readonly: bool
    patterns: list[tuple[str, _V]]
    exactmap: dict[str, _V]
    def __init__(self, name: str | None = None, filepath: str | None = None, data: Iterable[tuple[str, _V]] = ...) -> None: ...
    def hasPattern(self, key: str) -> bool: ...
    def addKeyValue(self, key: str, value: _V) -> None: ...
    def exactMap(self) -> dict[str, _V]: ...
    def hasPatternValues(self) -> bool: ...
    def getValue(self, key: str) -> _V | None: ...
    def delete(self) -> None: ...
    def duplicate(self, newname: str | None) -> None: ...
    def addData(self, keys: Collection[str], value: _V) -> None: ...

@typing.overload
def loadThemes(ext: Literal['nodecolors']) -> dict[str, ThemeData[Sequence[float]]]: ...
@typing.overload
def loadThemes(ext: Literal['wirestyles', 'nodeshapes']) -> dict[str, ThemeData[str]]: ...
@typing.overload
def loadThemes(ext: str) -> dict[str, ThemeData[Any]]: ...
def applyWireStyleTheme(theme: ThemeData[str] | None, node_type: hou.NodeType | None = None) -> None: ...
def applyNodeColorTheme(theme: ThemeData[Sequence[float]] | None, node_type: hou.NodeType | None = None) -> None: ...
def applyNodeShapeTheme(theme: ThemeData[str] | None, node_type: hou.NodeType | None = None) -> None: ...

theThemeTypes: tuple[ThemeType[str], ThemeType[Sequence[float]], ThemeType[str]]

def initializeThemes() -> None: ...
def nodeTypeAdded(category_name: str, type_name: str) -> None: ...
def saveCurrentThemes() -> None: ...
@typing.overload
def addDataToCurrentTheme(ext: Literal['nodecolors'], keys: Collection[str], value: Sequence[float]) -> None: ...
@typing.overload
def addDataToCurrentTheme(ext: Literal['wirestyles', 'nodeshapes'], keys: Collection[str], value: str) -> None: ...
@typing.overload
def addDataToCurrentTheme(ext: str, keys: Collection[str], value: str | Sequence[float]) -> None: ...
def duplicateCurrentTheme(ext: str, newname: str | None = None) -> None: ...
def getKeys(nodetypes: Iterable[hou.NodeType | hou.EnumValue[hou.colorItemType]]) -> list[str]: ...
def addRulesToColorTheme(nodetypes: Collection[hou.NodeType | hou.EnumValue[hou.colorItemType]], color: hou.Color) -> None: ...
def addRulesToShapeTheme(nodetypes: Collection[hou.NodeType | hou.EnumValue[hou.colorItemType]], shape: str) -> None: ...
def deleteCurrentTheme(ext: str) -> None: ...
def setCurrentTheme(ext: str, themename: str, force: bool = False) -> None: ...
def getThemeTypes() -> tuple[ThemeType[str], ThemeType[Sequence[float]], ThemeType[str]]: ...

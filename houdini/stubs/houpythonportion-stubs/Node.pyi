import hou
import typing
from collections.abc import Generator

@typing.overload
def createInputNode(self: hou.OpNode, input_index: int, node_type_name: str, node_name: str | None = ..., run_init_scripts: bool = ..., load_contents: bool = ..., exact_type_name: bool = ...) -> hou.OpNode: ...
@typing.overload
def createInputNode(self: hou.Node, input_index: int, node_type_name: str, node_name: str | None = ..., run_init_scripts: bool = ..., load_contents: bool = ..., exact_type_name: bool = ...) -> hou.Node: ...
@typing.overload
def createOutputNode(self: hou.OpNode, node_type_name: str, node_name: str | None = ..., run_init_scripts: bool = ..., load_contents: bool = ..., exact_type_name: bool = ...) -> hou.OpNode: ...
@typing.overload
def createOutputNode(self: hou.Node, node_type_name: str, node_name: str | None = ..., run_init_scripts: bool = ..., load_contents: bool = ..., exact_type_name: bool = ...) -> hou.Node: ...
@typing.overload
def allNodes(self: hou.OpNode) -> Generator[hou.OpNode, None, None]: ...
@typing.overload
def allNodes(self: hou.Node) -> Generator[hou.Node, None, None]: ...

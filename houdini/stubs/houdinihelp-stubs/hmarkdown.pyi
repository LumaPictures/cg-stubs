from bookish.text.textify import _EmitKwargs
from bookish.wiki.wikipages import _WikiBlock, _WikiNode, _WikiSpan, _WikiText
from collections.abc import Mapping
from houdinihelp.htextify import HoudiniTextifier as HoudiniTextifier
from typing import Protocol, Unpack

class _RelFn(Protocol):
    def __call__(self, path: str, /, default_ext: str | None = ...) -> str: ...

class HoudiniMarkdownifier(HoudiniTextifier[_WikiBlock]):
    """Converts a processed Houdini wiki JSON tree to CommonMark Markdown."""
    root: _WikiBlock
    path: str
    gap: int
    pagetype: str | None
    rel: _RelFn
    config: Mapping[str, object]
    def __init__(self, root: _WikiBlock, path: str = '', rel: _RelFn | None = None, config: Mapping[str, object] | None = None) -> None: ...
    def transform(self) -> str: ...
    eat_top: bool
    def emit_block_text(self, block: _WikiBlock, **kwargs: Unpack[_EmitKwargs]) -> None: ...
    def render_span(self, span: _WikiText | _WikiSpan) -> str: ...
    def emit(self, text: str, indent: int = 0, wrap: bool = False, top: int = 0, bottom: int = 0, first: str = '', rest: str = '', upper: bool = False, lower: bool = False, before: str = '', after: str = '') -> None:
        """Write a Markdown block without text wrapping or character mapping."""
    def root_block(self, block: _WikiBlock) -> None: ...
    def title_block(self, block: _WikiBlock) -> None: ...
    def h_block(self, block: _WikiBlock) -> None: ...
    def section_block(self, block: _WikiBlock) -> None: ...
    def sep_block(self, block: _WikiBlock) -> None: ...
    def para_block(self, block: _WikiBlock) -> None: ...
    def summary_block(self, block: _WikiBlock) -> None: ...
    def bullet_group_block(self, block: _WikiBlock) -> None: ...
    def bullet_block(self, block: _WikiBlock) -> None: ...
    def ord_group_block(self, block: _WikiBlock) -> None: ...
    def ord_block(self, block: _WikiBlock) -> None: ...
    def dt_group_block(self, block: _WikiBlock) -> None: ...
    def dt_block(self, block: _WikiBlock) -> None: ...
    def item_group_block(self, block: _WikiBlock) -> None: ...
    def item_block(self, block: _WikiBlock) -> None: ...
    def task_group_block(self, block: _WikiBlock) -> None: ...
    def task_block(self, block: _WikiBlock) -> None: ...
    tab_group_block = item_group_block
    tab_block = item_block
    col_group_block = item_group_block
    col_block = item_block
    bubble_group_block = item_group_block
    bubble_block = item_block
    def pre_block(self, block: _WikiBlock) -> None: ...
    def pxml_block(self, block: _WikiBlock) -> None: ...
    def table_block(self, block: _WikiBlock) -> None: ...
    def note_block(self, block: _WikiBlock) -> None: ...
    def tip_block(self, block: _WikiBlock) -> None: ...
    def warning_block(self, block: _WikiBlock) -> None: ...
    def new_block(self, block: _WikiBlock) -> None: ...
    def changed_block(self, block: _WikiBlock) -> None: ...
    def dev_block(self, block: _WikiBlock) -> None: ...
    def improved_block(self, block: _WikiBlock) -> None: ...
    def fixed_block(self, block: _WikiBlock) -> None: ...
    def bug_block(self, block: _WikiBlock) -> None: ...
    def platform_block(self, block: _WikiBlock) -> None: ...
    def methods_item_block(self, block: _WikiBlock) -> None: ...
    def functions_item_block(self, block: _WikiBlock) -> None: ...
    parm_group_block = item_group_block
    parm_block = item_block
    parameters_item_group_block = item_group_block
    values_item_block = item_block
    enums_item_block = item_block
    usage_block = item_block
    def parameters_item_block(self, block: _WikiBlock) -> None: ...
    def properties_item_block(self, block: _WikiBlock) -> None: ...
    def attributes_item_block(self, block: _WikiBlock) -> None: ...
    def top_attributes_item_block(self, block: _WikiBlock) -> None: ...
    def arg_block(self, block: _WikiBlock) -> None: ...
    def globals_item_block(self, block: _WikiBlock) -> None: ...
    def inputs_item_block(self, block: _WikiBlock) -> None: ...
    def outputs_item_block(self, block: _WikiBlock) -> None: ...
    def shelf_set_block(self, block: _WikiBlock) -> None: ...
    def shelf_tab_block(self, block: _WikiBlock) -> None: ...
    def shelf_tool_block(self, block: _WikiBlock) -> None: ...
    def box_block(self, block: _WikiBlock) -> None: ...
    def disclosure_block(self, block: _WikiBlock) -> None: ...
    def fig_block(self, block: _WikiBlock) -> None: ...
    def video_block(self, block: _WikiBlock) -> None: ...
    def vimeo_block(self, block: _WikiBlock) -> None: ...
    vimeo_ref_block = vimeo_block
    def compare_images_block(self, block: _WikiBlock) -> None: ...
    def list_block(self, block: _WikiBlock) -> None: ...
    def subtopics_block(self, block: _WikiBlock) -> None: ...
    def subtopics_item_block(self, block: _WikiBlock) -> None: ...
    def load_example_block(self, block: _WikiBlock) -> None:
        """Render an example entry as a link to the example page.

        The block holds the example's name as its text and the whole included
        example page as its body, which repeats that name as a title.
        """
    def search_block(self, block: _WikiBlock) -> None: ...
    def img_block(self, block: _WikiBlock) -> None: ...
    def xml_block(self, block: _WikiBlock) -> None: ...
    def Anim_link_span(self, span: _WikiSpan) -> str: ...
    def img_span(self, span: _WikiNode) -> str: ...
    def Image_link_span(self, span: _WikiNode) -> str: ...
    def Glyph_link_span(self, span: _WikiSpan) -> str: ...
    def Icon_link_span(self, span: _WikiSpan) -> str: ...
    Largeicon_link_span = Icon_link_span
    Smallicon_link_span = Icon_link_span
    def link_span(self, span: _WikiSpan) -> str: ...
    Wp_link_span = link_span
    def Fold_link_span(self, span: _WikiSpan) -> str: ...
    def strong_span(self, span: _WikiSpan) -> str: ...
    def ui_span(self, span: _WikiSpan) -> str: ...
    def em_span(self, span: _WikiSpan) -> str: ...
    def code_span(self, span: _WikiSpan) -> str: ...
    def var_span(self, span: _WikiSpan) -> str: ...
    def q_span(self, span: _WikiSpan) -> str: ...
    def env_span(self, span: _WikiSpan) -> str: ...
    def xml_span(self, span: _WikiSpan) -> str: ...
    def keys_span(self, span: _WikiSpan) -> str: ...

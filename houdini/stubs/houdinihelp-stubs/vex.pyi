class VexPart:
    """
    Base class for parsing bits of a VEX signature. The parsing methods are
    class methods that return a tree of instances representing the parsed
    signature.
    """
    ws_exp: re.Pattern[str]
    def typecode(self) -> str: ...
    def is_meta(self) -> bool: ...
    def matches(self, other: VexPart) -> bool | None:
        '''
        Returns True if this "template" signature matches the given "target"
        signature.

        Note that this is NOT the same as being equal to other. Equality testing
        is exact, whereas this method tests whether other can match this
        object\'s template pattern.
        '''
    def string(self) -> str:
        """
        Returns a plain string representation of the part.
        """
    def wiki(self) -> _WikiText:
        """
        Returns a wiki text representation of the part.
        """
    @typing.overload
    @classmethod
    def parse(cls: type['TypeChoice'], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> TypeChoice | ArrayType | AnyType | TypeAtom: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def parse(cls: type['VexType'], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> ArrayType | TypeAtom: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def parse(cls: type['Argument'], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> Argument | VariadicArgs: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def parse(cls: type[_P], string: str, pos: int = ..., **kwargs: Unpack[_ContextKwargs]) -> _P: ...
    @typing.overload
    @classmethod
    def take(cls: type['TypeChoice'], ctx: Context, string: str, pos: int) -> tuple[TypeChoice | ArrayType | AnyType | TypeAtom, int]: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def take(cls: type['VexType'], ctx: Context, string: str, pos: int) -> tuple[ArrayType | TypeAtom, int]: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def take(cls: type['Argument'], ctx: Context, string: str, pos: int) -> tuple[Argument | VariadicArgs, int]: ...  # type: ignore[misc]
    @typing.overload
    @classmethod
    def take(cls: type[_P], ctx: Context, string: str, pos: int) -> tuple[_P, int]: ...
    @classmethod
    def expected(cls) -> str: ...
    @classmethod
    def expect(cls, string: str, pos: int, text: str) -> int: ...
    @classmethod
    def expect_regex(cls, string: str, pos: int, expr: re.Pattern[str]) -> int: ...
    @classmethod
    def choice(cls, ctx: Context, string: str, pos: int, choices: Sequence[type[_P]]) -> tuple[_P, int]: ...
    @classmethod
    def optional_text(cls, string: str, pos: int, optstring: str) -> tuple[bool, int]: ...
    @classmethod
    def optional(cls, ctx: Context, string: str, pos: int, optcls: type[_P]) -> tuple[_P | None, int]: ...
    @classmethod
    def ws(cls, string: str, pos: int, required: bool = False) -> int: ...
    @typing.overload
    @classmethod
    def take_type(cls, ctx: Context, string: str, pos: int, allow_array: bool = ..., *, allow_choice: Literal[False]) -> tuple[ArrayType | AnyType | TypeAtom, int]: ...
    @typing.overload
    @classmethod
    def take_type(cls, ctx: Context, string: str, pos: int, allow_array: bool = ..., allow_choice: bool = ...) -> tuple[TypeChoice | ArrayType | AnyType | TypeAtom, int]: ...

class RegexVexPart(VexPart):
    """
    Middleware class for subclasses that parse using a regex.
    """
    exp: re.Pattern[str] | None
    def matches(self, other: VexPart) -> bool | None: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiText: ...
    @classmethod
    def expected(cls) -> str: ...

class Identifier(RegexVexPart):
    """
    Function name or argument name.
    """
    name: str
    exp: re.Pattern[str]
    def __init__(self, name: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def matches(self, other: VexPart) -> bool | None: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiSpan: ...
    @classmethod
    def expected(cls) -> str: ...

class MissingIdentifier(VexPart):
    """
    Represents a missing name (as in a target parsed from `vcc -X` output, which
    doesn't have argument names).
    """
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> str: ...
    @classmethod
    def expected(cls) -> str: ...

class TypeAtom(RegexVexPart):
    """
    Represents an atomic type or struct.
    """
    name: str
    exp: re.Pattern[str]
    def __init__(self, name: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def typecode(self) -> str: ...
    def basetype(self) -> Self: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiSpan: ...

class TypeChoice(VexPart):
    """
    Reresents a choice between two or more types, e.g. int|float. This is not
    actually part of VEX, but is used in the documentation to the docs clearer
    and more compact.
    """
    types: list[TypeAtom | AnyType | ArrayType]
    atom_pattern: str
    def __init__(self, types: Iterable[TypeAtom | AnyType | ArrayType]) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def typecode(self) -> str: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiSpan: ...
    @classmethod
    def expected(cls) -> str: ...

class AnyType(RegexVexPart):
    """
    Represents a metasyntactic wilcard matching any type, e.g. <type>. This is
    not actually part of VEX, but is used in the documentation to the docs
    clearer and more compact.
    """
    name: str
    exp: re.Pattern[str]
    def __init__(self, name: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def is_meta(self) -> bool: ...
    def meta_name(self) -> str: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiSpan: ...
    @classmethod
    def expected(cls) -> str: ...

class ArrayType(VexPart):
    """
    Represents an array type. This is a wrapper around a VexPart instance
    representing the item type.
    """
    subtype: TypeAtom | TypeChoice | AnyType
    def __init__(self, subtype: TypeAtom | TypeChoice | AnyType) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def typecode(self) -> str: ...
    def is_meta(self) -> bool: ...
    def meta_name(self) -> str: ...
    def basetype(self) -> TypeAtom | TypeChoice | AnyType: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> list[_WikiItem]: ...
    @classmethod
    def expected(cls) -> str: ...

class VexType(VexPart): ...

class Argument(VexPart):
    """
    Represents an argument in the function signature. This is a compound object
    containing the various parts of the argument (type, output indicator, name,
    optional).
    """
    type: _TypePart
    out: bool
    ident: Identifier | MissingIdentifier
    optional: str | None
    eq_exp: re.Pattern[str]
    def __init__(self, t: _TypePart, out: bool, ident: Identifier | MissingIdentifier, optional: str | None = None) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def is_meta(self) -> bool: ...
    def meta_name(self) -> str: ...
    def typecode(self) -> str: ...
    def basetype(self) -> TypeAtom | TypeChoice | AnyType: ...
    def matches(self, other: VexPart) -> bool | None: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiArgument: ...

class VariadicArgs(VexPart):
    """
    Represents variadic arguments (...) in a function signature.
    """
    pairs: bool | None
    optional: None
    def __init__(self, pairs: bool | None = False) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def string(self) -> str: ...
    def wiki(self) -> _WikiSpan: ...
    def matches(self, other: VexPart) -> bool: ...

class ArgumentList(VexPart):
    """
    Represents zero or more arguments in a function signature.
    """
    args: Sequence[Argument | VariadicArgs]
    separator_exp: re.Pattern[str]
    def __init__(self, args: Sequence[Argument | VariadicArgs]) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def check_meta_types(self, arglist: ArgumentList, typemap: MutableMapping[str, str]) -> bool: ...
    def matches(self, other: VexPart) -> bool: ...
    def string(self) -> str: ...
    def wiki(self) -> list[_WikiItem]: ...

class Signature(VexPart):
    """
    Top-level object represents the entire signature. Contains the return type,
    function name, and argument list.
    """
    rtype: _TypePart
    ident: Identifier
    arglist: ArgumentList
    original: str | None
    def __init__(self, rtype: _TypePart, ident: Identifier, arglist: ArgumentList, original: str | None = None) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def check_meta_types(self, other: Signature) -> bool: ...
    def matches(self, other: VexPart) -> bool | None: ...
    def string(self) -> str: ...
    def wiki(self) -> list[_WikiItem]: ...
    @classmethod
    def parse_template(cls, string: str) -> Signature: ...
    @classmethod
    def parse_concrete(cls, string: str) -> Signature: ...

class Reporter:
    def start(self, checker: VexChecker) -> None: ...
    def parser_error(self, fnname: str, string: str, exception: NoMatch) -> None: ...
    def parsed_signature(self, context: str, sig: Signature) -> None: ...
    def parsed_doc_page(self, fnname: str) -> None: ...
    def parsed_doc_sig(self, sig: Signature) -> None: ...
    def extra_context(self, name: str) -> None: ...
    def wrong_function_name(self, fnname: str, wrong_string: str) -> None: ...
    def extra_doc(self, fnname: str) -> None: ...
    def missing_doc(self, fnname: str, contexts: str) -> None: ...
    def missing_statement_doc(self, statementname: str, contexts: AbstractSet[str]) -> None: ...
    def compared_signatures(self, docsig: Signature, vccsig: Signature, matched: bool | None) -> None: ...
    def extra_global(self, glob: GlobalVar, context: str) -> None: ...
    def missing_global(self, glob: GlobalVar, context: str) -> None: ...
    def extra_doc_signature(self, fnname: str, sig: Signature) -> None: ...
    def missing_doc_signature(self, fnname: str, vccsig: Signature, docsigs: AbstractSet['Signature']) -> None: ...
    def wrong_contexts(self, fnname: str, stated: str, actual: str) -> None: ...
    def marked_deprecated(self, signature: Signature | str) -> None: ...
    def finish(self, checker: VexChecker) -> None: ...

class PrintReporter(Reporter):
    file: SupportsWrite[str]
    print_footer: bool
    def __init__(self, file: SupportsWrite[str] | None = None, print_footer: bool = True) -> None: ...
    def parser_error(self, fnname: str, string: str, exception: NoMatch) -> None: ...
    def extra_context(self, name: str) -> None: ...
    def wrong_function_name(self, fnname: str, wrong_string: str) -> None: ...
    def extra_doc(self, fnname: str) -> None: ...
    def missing_doc(self, fnname: str, contexts: str) -> None: ...
    def missing_statement_doc(self, sname: str, contexts: AbstractSet[str]) -> None: ...
    def wrong_contexts(self, fnname: str, stated: str, actual: str) -> None: ...
    def extra_global(self, glob: GlobalVar, context: str) -> None: ...
    def missing_global(self, glob: GlobalVar, context: str) -> None: ...
    def extra_doc_signature(self, fnname: str, sig: Signature) -> None: ...
    def missing_doc_signature(self, fnname: str, vccsig: Signature, docsigs: AbstractSet['Signature']) -> None: ...
    def finish(self, checker: VexChecker) -> None: ...

class ContextRewriteReporter(Reporter):
    funcdir: str
    ext: str
    def __init__(self, funcdir: str, extension: str = '.txt') -> None: ...
    def wrong_contexts(self, fnname: str, stated: str, actual: str) -> None: ...

class GlobalVar:
    type: TypeAtom | ArrayType
    name: str
    readable: bool
    writable: bool
    def __init__(self, type_: TypeAtom | ArrayType, name: str, readable: bool, writable: bool) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class VexChecker:
    reporter: Reporter
    all_contexts: set[str]
    signatures: defaultdict[str, set['Signature']]
    documents: defaultdict[str, set['Signature']]
    statement_docs: set[str]
    deprecated: set['Signature']
    fn_to_contexts: defaultdict[str, set[str]]
    context_to_fns: defaultdict[str, set[str]]
    globals: defaultdict[str, set['GlobalVar']]
    global_docs: dict[str, set['GlobalVar']]
    statements: defaultdict[str, set[str]]
    def __init__(self, reporter: Reporter | None = None) -> None: ...
    def add_signature(self, context: str, sig: Signature) -> None: ...
    def parse_vcc_output(self, vccpath: StrPath) -> None: ...
    def parse_vex_docs(self, app: flask.Flask) -> None: ...
    def context_set_to_string(self, contextset: AbstractSet[str]) -> str: ...
    def string_to_context_set(self, string: str) -> set[str]: ...
    def check_contexts(self, fnname: str, contexts: str) -> None: ...
    def compare_function_names(self) -> None: ...
    def match_signatures(self, fnname: str) -> None: ...
    def match_globals(self) -> None: ...
    def match_all_signatures(self) -> None: ...
    def check_statements(self) -> None: ...
    def build(self, vccpath: StrPath, app: flask.Flask) -> None: ...
    def undocumented(self) -> set[str]: ...
    def overdocumented(self) -> set[str]: ...

import weakref
from collections.abc import Callable as Callable
from typing import Concatenate, Generic

from typing import ParamSpec
from typing import TypeVar
from typing import ParamSpec
from typing import TypeVar
_P = ParamSpec('_P')
_R = TypeVar('_R')
_T = TypeVar('_T')
class EventBlocker:
    bypass: bool
    def __init__(self, on_start_callback: Callable[[], object] | None = None, on_end_callback: Callable[[], object] | None = None, on_clear_callback: Callable[[], object] | None = None) -> None: ...
    def __bool__(self) -> bool: ...
    def incr(self) -> None: ...
    def decr(self) -> None: ...
    def clear(self) -> None: ...
    def setBypassFlag(self, on: bool) -> None: ...
    def bypassFlag(self) -> bool: ...

def eventBlocker(blocker_name: str) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...
def blockableEvent(blocker_name: str) -> Callable[[Callable[_P, _R]], Callable[_P, _R | None]]: ...

class DeferredEvent(Generic[_T]):
    obj: weakref.ref[_T]
    event: Callable[[_T], object]
    is_posted: bool
    def __init__(self, obj: _T, event: Callable[[_T], object]) -> None: ...
    def post(self) -> None: ...
    def removePost(self) -> None: ...
    def onEvent(self) -> None: ...

def deferredEvent(event_name: str) -> Callable[[Callable[[_T], object]], Callable[Concatenate[_T, ...], None]]: ...

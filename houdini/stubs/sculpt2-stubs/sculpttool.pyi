import hou
import typing
from _sculpt import BaseBrushOp
from collections.abc import Callable as Callable, Container, Sequence
from frameworkstate.storageinterface import StorageInterface
from houtypes import ViewerStateDrawKwargs, ViewerStateEventKwargs
from sculpt2 import sculptparms as sculptparms
from sculpt2.sculptparms import SculptSettingsWidget as SculptSettingsWidget
from sculpt2.shotsculpthotkeys import ShotSculptHotkeys as ShotSculptHotkeys
from sculpt2.stroke import Stroke as Stroke
from statehud.window import WidgetBundleWindow
from typing import Any, Literal, Protocol, TypedDict

from typing import TypeAlias
from typing import TypeAlias
_MenuParm: TypeAlias = Literal['brush', 'blendshapebrush', 'attributebrush', 'strokeop', 'shape', 'facing', 'activemask']
_FloatSliderParm: TypeAlias = Literal['radius', 'strength', 'spacing', 'falloff', 'radiuspressure', 'strengthpressure', 'falloffpressure', 'lazymousetolerance', 'lazyspeed', 'mirrordistance', 'poissonratio', 'elasticshearmodulus', 'sprayradius']
_IntSliderParm: TypeAlias = Literal['spraycount', 'linearspraylength']
_ToggleParm: TypeAlias = Literal['showmaxradius', 'showbrushduringstroke', 'showstrengthandfalloff', 'lazymouse', 'maskdisconnected', 'usemirror', 'enablemask', 'sprayrandom', 'allowsprayoverflow']
_VectorParm: TypeAlias = Literal['mirrororigin', 'mirrordirection']
_ParmValue: TypeAlias = str | int | float | bool | list[float] | tuple[float, float, float] | None
_ParmInput: TypeAlias = str | float | Sequence[float]
_HudRow: TypeAlias = dict[str, str | int | list[dict[str, str]]]
class _SculptToolState(Protocol):
    @property
    def state_name(self) -> str: ...
    @property
    def scene_viewer(self) -> hou.SceneViewer: ...
    @property
    def hotkeys(self) -> ShotSculptHotkeys: ...
    @property
    def scene_node(self) -> hou.SopNode | None: ...
    startGeometry: hou.Geometry | None
    def getMode(self) -> str: ...
    def getStorageInterface(self) -> StorageInterface | None: ...
    def getAvailableMaskList(self) -> list[str]: ...
    def onCreateMask(self) -> None: ...
    def onDeleteMask(self, deletedMask: str | None) -> None: ...
    def bumpPrimitiveList(self) -> None: ...
    def validateMaskName(self, maskName: str, parmData: Container[str]) -> bool: ...
    def getCurBrushDefaultsGeometry(self) -> hou.Geometry | None: ...
    def getPolygonEdits(self) -> hou.Geometry | None: ...
    def setPolygonEdits(self, edits: hou.Geometry | None, /) -> object: ...
    def getSculptMaskEdits(self) -> hou.Geometry | None: ...
    def setSculptMaskEdits(self, edits: hou.Geometry, /) -> None: ...
    def getInterpolatedPolygons_Clustered(self) -> hou.Geometry | None: ...
    def handleMaskCommit(self) -> None: ...

class _ToolActivateKwargs(TypedDict, total=False):
    """The `on_activate_kwargs` that `frameworkstate.State.setActiveTool` hands a tool's `onActivate`."""
    settings_hud_tab_info: tuple[WidgetBundleWindow | None, str, str | None]

CURSOR_DRAG_FACTOR: float

def makeBrushOpGraphGeo(name: str) -> hou.Geometry: ...
def makeBrushOp(name: str) -> Callable[[], BaseBrushOp]: ...

class SculptTool:
    name: str
    state: _SculptToolState
    default_hud_rows: dict[str, Any]
    hud_parm_hk: str
    HOTKEY_BRUSHES: list[tuple[str, str]]
    hasUpdatedHUD: bool
    state_name: str
    scene_viewer: hou.SceneViewer
    node: None
    hud_rows: list[_HudRow]
    handle_sculpting_undos: bool
    scene_node: hou.SopNode | None
    settings_widget: SculptSettingsWidget
    BRUSH_OPS: list[tuple[str, str, Callable[[], BaseBrushOp]]]
    def __init__(self, state: _SculptToolState) -> None:
        """a tool can be regarded as a sub viewer state. it has access to all the event 
        functions and to the framework state it is being executed and created in
        """
    def updateHUD(self) -> None: ...
    def isSculptNode(self) -> bool: ...
    def registerBrushOps(self) -> None: ...
    def registerBrushOp(self, name: str, label: str, op: Callable[[], BaseBrushOp]) -> None: ...
    def getOpLabel(self, name: str) -> str: ...
    def isShotsculpt(self, node: hou.OpNode) -> bool: ...
    def label(self) -> str:
        """
        that label is being used in the hud to show the current tool name
        """
    def category(self) -> str:
        """
        that label is being used in the hud to show the current tool name
        """
    def hudTemplate(self) -> list[_HudRow]:
        """this is the hud template that is being shown in 
        the main viewer state. the tool might used differnt hotkeys for example than the main state"""
    def setSymmetryData(self) -> None: ...
    def hideHUD(self) -> None: ...
    def getAlphaGeometry(self) -> hou.Geometry: ...
    def getIsPaintMode(self) -> bool: ...
    def getMode(self) -> str: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> bool: ...
    def onDeactivate(self) -> bool:
        """we leave the tool and we can now for example also do something with the tool itself
        """
    def getBrushParm(self) -> Literal['brush', 'blendshapebrush', 'attributebrush']: ...
    def doesCurBrushAffectMask(self) -> bool: ...
    def doesBrushAffectMask(self, brushop: str | None) -> bool: ...
    def isMaskEnabledAndValid(self) -> bool: ...
    def validateMaskPainting(self) -> bool: ...
    def correctNewRad(self, newRad: float, oldRad: float, distFactor: float) -> float: ...
    def resizeCursor(self, dist: float) -> None: ...
    def adjustSF(self, dist_x: float, dist_y: float) -> None: ...
    def handleResize(self, ui_event: hou.ViewerEvent, started_resizing: bool) -> None: ...
    def getCurBrushDefaultsGeometry(self) -> hou.Geometry | None: ...
    def handleAdjustSF(self, ui_event: hou.ViewerEvent, started_adjusting_sf: bool) -> None: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> bool:
        """ Process a mouse wheel event
        """
    def startEdits(self) -> hou.Geometry | None: ...
    def setEdits(self, edits: hou.Geometry | None) -> None: ...
    def getEdits(self) -> hou.Geometry | None: ...
    def setStartGeo(self, geo: hou.Geometry) -> None: ...
    def getStartGeo(self) -> hou.Geometry | None: ...
    def resetStartGeo(self) -> None: ...
    def isSculptStroke(self, ui_event: hou.ViewerEvent) -> bool: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None: ...
    def handleMaskCommit(self) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool:
        """shows how to use the hotkeys of the framework
        """
    @typing.overload
    def getParm(self, parm: _MenuParm) -> str | None: ...
    @typing.overload
    def getParm(self, parm: _FloatSliderParm) -> float: ...
    @typing.overload
    def getParm(self, parm: _IntSliderParm) -> int: ...
    @typing.overload
    def getParm(self, parm: _ToggleParm) -> bool: ...
    @typing.overload
    def getParm(self, parm: _VectorParm) -> list[float]: ...
    @typing.overload
    def getParm(self, parm: Literal['maskcolor']) -> tuple[float, float, float]: ...
    @typing.overload
    def getParm(self, parm: Literal['alphaimgfile']) -> str | None: ...
    @typing.overload
    def getParm(self, parm: str | None) -> _ParmValue: ...
    @typing.overload
    def setParm(self, parm: _MenuParm, val: str) -> None: ...
    @typing.overload
    def setParm(self, parm: _FloatSliderParm, val: float) -> None: ...
    @typing.overload
    def setParm(self, parm: _IntSliderParm, val: int) -> None: ...
    @typing.overload
    def setParm(self, parm: _ToggleParm, val: bool) -> None: ...
    @typing.overload
    def setParm(self, parm: _VectorParm, val: Sequence[float]) -> None: ...
    @typing.overload
    def setParm(self, parm: Literal['maskcolor'], val: Sequence[float]) -> None: ...
    @typing.overload
    def setParm(self, parm: Literal['alphaimgfile'], val: str) -> None: ...
    @typing.overload
    def setParm(self, parm: str | None, val: _ParmInput) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def updateBrushHUDInfo(self) -> None: ...
    def updateShapeHUDInfo(self) -> None: ...
    def getAvailableMaskList(self) -> list[str]: ...
    def onCreateMask(self) -> None: ...
    def onDeleteMask(self, deletedMask: str | None) -> None: ...
    def bumpPrimitiveList(self) -> None: ...
    def getStateConfig(self) -> None: ...
    def validateMaskName(self, maskName: str, parmData: Container[str]) -> bool: ...
    def invertMask(self) -> None: ...
    def clearMask(self) -> None: ...

def load(viewer_state: _SculptToolState) -> SculptTool: ...

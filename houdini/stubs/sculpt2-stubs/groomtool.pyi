import hou
import typing
from _groom import BaseBrushOp
from collections.abc import Container, MutableMapping, Sequence
from frameworkstate.parameterwidget import ParameterWidget as ParameterWidget
from frameworkstate.storageinterface import StorageInterface
from houtypes import ViewerStateEventKwargs, ViewerStateKwargs
from sculpt2 import groomparms as groomparms
from sculpt2.groomparms import GroomSettingsWidget as GroomSettingsWidget
from sculpt2.shotsculpthotkeys import ShotSculptHotkeys as ShotSculptHotkeys
from shotsculpt import utility as utility
from sidefx_stroke import StrokeCursor
from statehud.window import WidgetBundleWindow
from typing import Any, Literal, Protocol, TypedDict

from typing import TypeAlias
from typing import TypeAlias
_GroomVerbParms: TypeAlias = dict[str, hou.OptionMultiArgType | hou.Ramp]
_MenuParm: TypeAlias = Literal['tool', 'blendshapetool', 'attributetool', 'liftmode', 'adjustlengthmode', 'adjustlengthmethod', 'orientbrushupmode', 'activemask']
_SliderParm: TypeAlias = Literal['objectradius', 'screenradius', 'strength', 'spacing', 'soft', 'brushmaintainlength', 'brushbend', 'brushbendfalloff', 'liftangle', 'adjustlengthvalue', 'smoothtargetsmoothness', 'density', 'raybias']
_ToggleParm: TypeAlias = Literal['usemask', 'strandmode', 'collidewithskin', 'brushsurface', 'usepartinglines', 'sculptdoconstrain', 'sculptmaintainevensegments', 'sculptlockroot', 'smoothposition', 'smoothorient', 'orientbrushperpoint', 'moverotatewithskin', 'clumpperpoint', 'blurinskinspace', 'blurperpoint', 'blurshape', 'blurlength', 'blurorient', 'paintmaskpoints', 'mirrorbrush']
_VectorParm: TypeAlias = Literal['mirrororigin', 'mirrordir']
_ParmValue: TypeAlias = str | int | float | bool | list[float] | tuple[float, float, float] | None
_ParmInput: TypeAlias = str | float | Sequence[float]
_HudRow: TypeAlias = dict[str, str | int | list[dict[str, str]]]
class _GroomToolState(Protocol):
    @property
    def state_name(self) -> str: ...
    @property
    def scene_viewer(self) -> hou.SceneViewer: ...
    @property
    def hotkeys(self) -> ShotSculptHotkeys: ...
    @property
    def scene_node(self) -> hou.SopNode | None: ...
    def getMode(self) -> str: ...
    def getStorageInterface(self) -> StorageInterface | None: ...
    def getAvailableMaskList(self) -> list[str]: ...
    def onCreateMask(self) -> None: ...
    def onDeleteMask(self, deletedMask: str | None) -> None: ...
    def validateMaskName(self, maskName: str, parmData: Container[str]) -> bool: ...
    def getPolygonEdits(self) -> hou.Geometry | None: ...
    def getGuidesEdits(self) -> hou.Geometry | None: ...
    def setGuidesEdits(self, geo: hou.Geometry, /) -> None: ...
    def getGroomMaskEdits(self) -> hou.Geometry | None: ...
    def setGroomMaskEdits(self, edits: hou.Geometry, /) -> None: ...
    def getInterpolatedPolygons_Unclustered(self) -> hou.Geometry | None: ...
    def hasStrokeStarted(self) -> bool: ...

class _ToolActivateKwargs(TypedDict, total=False):
    """The `on_activate_kwargs` that `frameworkstate.State.setActiveTool` hands a tool's `onActivate`."""
    settings_hud_tab_info: tuple[WidgetBundleWindow | None, str, str | None]

RADIUS_PARM: Literal['radius']
STRENGTH_PARM: Literal['strength']
BUTTON_NONE: int
BUTTON_LEFT: int
BUTTON_MIDDLE: int

class GroomTool:
    name: str
    default_hud_rows: dict[str, Any]
    state: _GroomToolState
    scene_viewer: hou.SceneViewer
    hud_parm_hk: str
    cursor: StrokeCursor
    hasUpdatedHUD: bool
    HOTKEY_TOOLS: list[tuple[str, str]]
    TOOL_LABELS: dict[str, str]
    lastcampos: None
    lasthit: bool
    lastbutton: int
    basebrushop: BaseBrushOp
    hud_rows: list[_HudRow]
    scene_node: hou.SopNode | None
    settings_widget: GroomSettingsWidget
    skingeo: hou.Geometry | None
    groomverb: hou.SopVerb | None
    lastpos: hou.Vector3
    last_mouse_x: float
    last_mouse_y: float
    BUTTON_NONE: int
    BUTTON_LEFT: int
    BUTTON_MIDDLE: int
    BRUSH_SPHERE: int
    BRUSH_CIRCLE: int
    BRUSH_POINT: int
    def __init__(self, state: _GroomToolState) -> None: ...
    def updateBargraphParm(self, values: MutableMapping[str, str | float], curVal: float, maxVal: float, name: str, label: str) -> None: ...
    def getToolLabel(self, key: str | None) -> str: ...
    def updateParmStatus(self, values: MutableMapping[str, str | float], parm: str) -> None: ...
    def updateHUD(self) -> None: ...
    def updateToolHUDInfo(self) -> None: ...
    def label(self) -> str: ...
    def category(self) -> str: ...
    def hudTemplate(self) -> list[_HudRow]: ...
    def getIsPaintMode(self) -> bool: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None:
        """ Called whenever the state is resumed from an interruption,
            such as by switching back from a volatile state.
        """
    def onInterrupt(self, kwargs: ViewerStateKwargs) -> None:
        """ Called whenever the state is temporary interrupted,
            such as by switching to a volatile state.
        """
    def getUseSurfaceSpace(self) -> bool: ...
    def getRadiusForCursor(self) -> float: ...
    def setRadiusForCursor(self, val: float) -> None: ...
    def set_cursor_surface_proj(self) -> None: ...
    def set_cursor_screen_proj(self) -> None: ...
    def updateCursorColor(self) -> None: ...
    def updateCursorForMode(self) -> None: ...
    def getMode(self) -> str: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> bool: ...
    def getToolParm(self) -> Literal['tool', 'blendshapetool', 'attributetool']: ...
    def onDeactivate(self) -> bool: ...
    def doesCurBrushAffectMask(self) -> bool: ...
    def doesBrushAffectMask(self, brushop: str | None) -> bool: ...
    def groomGeo(self, parms: _GroomVerbParms) -> None: ...
    def setCamParms(self, parms: _GroomVerbParms, ui_event: hou.ViewerEvent) -> None: ...
    def setHUDParms(self, parms: _GroomVerbParms, ui_event: hou.ViewerEvent) -> None: ...
    def setToolSpecificParms(self, parms: _GroomVerbParms) -> None: ...
    def correctNewRad(self, newRad: float, oldRad: float, distFactor: float) -> float: ...
    def resize_cursor(self, dist: float) -> None: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def isSculptStroke(self, ui_event: hou.ViewerEvent) -> bool: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool | None:
        """is being called in the frameworks onMouseEvent func if tool is currently active
        """
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool:
        """shows how to use the hotkeys of the framework
        """
    @typing.overload
    def getParm(self, parm: _MenuParm, as_string: Literal[True] = ...) -> str | None: ...
    @typing.overload
    def getParm(self, parm: _MenuParm, as_string: Literal[False]) -> int | None: ...
    @typing.overload
    def getParm(self, parm: _MenuParm, as_string: bool) -> str | int | None: ...
    @typing.overload
    def getParm(self, parm: _SliderParm, as_string: bool = ...) -> float: ...
    @typing.overload
    def getParm(self, parm: _ToggleParm, as_string: bool = ...) -> bool: ...
    @typing.overload
    def getParm(self, parm: _VectorParm, as_string: bool = ...) -> list[float]: ...
    @typing.overload
    def getParm(self, parm: Literal['maskcolor'], as_string: bool = ...) -> tuple[float, float, float]: ...
    @typing.overload
    def getParm(self, parm: str | None, as_string: bool = ...) -> _ParmValue: ...
    @typing.overload
    def setParm(self, parm: _MenuParm, val: str) -> None: ...
    @typing.overload
    def setParm(self, parm: _SliderParm, val: float) -> None: ...
    @typing.overload
    def setParm(self, parm: _ToggleParm, val: bool) -> None: ...
    @typing.overload
    def setParm(self, parm: _VectorParm, val: Sequence[float]) -> None: ...
    @typing.overload
    def setParm(self, parm: Literal['maskcolor'], val: Sequence[float]) -> None: ...
    @typing.overload
    def setParm(self, parm: str | None, val: _ParmInput) -> None: ...
    def getStateConfig(self) -> None: ...
    def isMaskEnabledAndValid(self) -> bool: ...
    def getAvailableMaskList(self) -> list[str]: ...
    def validateMaskName(self, maskName: str) -> bool: ...
    def onCreateMask(self) -> None: ...
    def onDeleteMask(self, maskName: str | None) -> None: ...
    def invertMask(self) -> None: ...
    def clearMask(self) -> None: ...

def load(viewer_state: _GroomToolState) -> GroomTool: ...

import io
import re
from bookish import compat as compat, util as util
from bookish.avenue import avenue as avenue
from bookish.avenue.patterns import Pattern as Pattern
from bookish.compat import BytesIO as BytesIO, StringIO as StringIO, string_type as string_type, text_type as text_type, unichr as unichr

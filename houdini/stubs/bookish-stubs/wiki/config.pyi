from bookish.util import find_object as find_object
from collections.abc import Iterable, Mapping
from typing import Any

class Config(dict[str, Any]):
    root_path: str
    def __init__(self, root_path: str, defaults: Mapping[str, object] | None = None) -> None: ...
    def from_envvar(self, variable_name: str, silent: bool = False) -> bool: ...
    def from_pyfile(self, filename: str, silent: bool = False) -> bool: ...
    def from_object(self, obj: object) -> None: ...
    def from_json(self, filename: str, silent: bool = False) -> bool: ...
    def from_mapping(self, *mapping: Mapping[str, Any] | Iterable[tuple[str, Any]], **kwargs: Any) -> bool: ...

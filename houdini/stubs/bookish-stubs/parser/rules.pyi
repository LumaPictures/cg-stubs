class Rule(Generic[_OutT_co]):
    """
    Base class for all rules.
    """
    def __init__(self) -> None: ...
    @typing.overload
    def __add__(self, other: Rule[_U]) -> Seq[_U]: ...
    @typing.overload
    def __add__(self, other: str) -> Seq[str]: ...
    def __radd__(self, other: Rule | str) -> Seq[_OutT_co]: ...
    @typing.overload
    def __or__(self, other: Rule[_U]) -> Or[_OutT_co | _U]: ...
    @typing.overload
    def __or__(self, other: str) -> Or[_OutT_co | str]: ...
    def __ror__(self, other: Rule | str) -> Seq[_OutT_co]: ...
    def __pow__(self, name: str) -> Self: ...
    def _repr(self) -> str | None: ...
    def dump(self, pctx: ParserContext | None, level: int = 0) -> None: ...
    def children(self) -> tuple[Rule, ...] | list[Rule]: ...
    def set_name(self, name: str) -> Self: ...
    def rulename(self) -> str | None: ...
    def fixed_length(self, pctx: ParserContext | None = None) -> int | None: ...
    def is_optional(self) -> bool: ...
    def first_chars(self, pctx: ParserContext | None) -> _FirstChars: ...
    def __call__(self, stream: str, i: int, context: ParserContext) -> _Result[_OutT_co]: ...
    def accept(self, stream: str, i: int, context: ParserContext) -> _Result[_OutT_co]: ...
    def has_binding(self, bld: Builder) -> bool: ...
    def snap(self, pctx: ParserContext, seen: MutableSet[Rule]) -> Rule: ...
    def build(self, bld: Builder) -> None: ...


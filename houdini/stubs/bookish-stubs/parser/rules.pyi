class Or(MultiRule[_OutT_co]):
    """
    Checks multiple sub-rules in sequence, returns the output of the first one
    that matches, or Miss if none of the sub-rules match.
    """
    rules: list[Rule]
    @typing.overload
    def __init__(self: Or[_U], *rules: Rule[_U]) -> None: ...
    @typing.overload
    def __init__(self: Or[_U | str], *rules: Rule[_U] | str) -> None: ...
    def fixed_length(self, pctx: ParserContext | None = None) -> int | None: ...
    def is_optional(self) -> bool: ...
    def first_chars(self, pctx: ParserContext | None) -> str | None: ...
    def __call__(self, stream: str, i: int, context: ParserContext) -> _Result[_OutT_co]: ...
    def build(self, bld: Builder) -> None: ...

class Seq(MultiRule[_OutT_co]):
    """
    Checks that a sequence of sub-rules match one after the other. This rule
    only matches if all sub-rules match in sequence.

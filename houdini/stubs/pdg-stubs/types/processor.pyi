import _pdg
from pdg.processor import PyProcessor as PyProcessor

class PythonProcessor(PyProcessor):
    """
    Base processor implementation
    """
    def __init__(self, node: _pdg.Node) -> None:
        """
        __init__(self, pdg.Node) -> NoneType

        Initializes the processor with a C++ node referencee
        """
    @classmethod
    def templateName(cls) -> str: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onRegenerate(self, item_holder: _pdg.WorkItemHolder, existing_items: _pdg.WorkItemList, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> _pdg.result: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> _pdg.result: ...
    def onAddInternalDependencies(self, dep_holder: _pdg.DependencyHolder, items: _pdg.WorkItemList, is_static: bool) -> _pdg.result: ...
    def onCookTask(self, item: _pdg.WorkItem) -> _pdg.result: ...

def registerTypes(type_registry: _pdg.TypeRegistry) -> None: ...

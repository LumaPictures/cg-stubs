import _pdg
from collections.abc import Sequence
from houtypes import JSONValue
from pdg import PyProcessor as PyProcessor, feedback as feedback
from typing import TypedDict

class _BinaryCallArg(TypedDict):
    b64: str

class _CallArg(TypedDict):
    arg: JSONValue

class _CallRecord(TypedDict):
    fn: str
    args: list[_BinaryCallArg | _CallArg]

XMLRPC: int
RAW: int

class SendCommandRpcApi:
    @staticmethod
    def process_rpc(callobj: _CallRecord, work_item: _pdg.WorkItem) -> None: ...
    @staticmethod
    def result(work_item: _pdg.WorkItem, data: bytes, datatag: str, hashcode: int, jobid: str) -> None: ...
    @staticmethod
    def success_and_result(work_item: _pdg.WorkItem, data: bytes, datatag: str, hashcode: int, duration: float, jobid: str) -> None: ...
    @staticmethod
    def failed(work_item: _pdg.WorkItem, jobid: str) -> None: ...
    @staticmethod
    def cancelled(work_item: _pdg.WorkItem, jobid: str) -> None: ...
    @staticmethod
    def warning(work_item: _pdg.WorkItem, message: str, jobid: str) -> None: ...
    @staticmethod
    def set_string_attrib_array(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: Sequence[str], jobid: str) -> None: ...
    @staticmethod
    def set_int_attrib_array(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: Sequence[int], jobid: str = '') -> None: ...
    @staticmethod
    def set_float_attrib_array(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: Sequence[float], jobid: str = '') -> None: ...
    @staticmethod
    def set_file_attrib_array(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: Sequence[tuple[str, str, int, bool]], jobid: str = '') -> None: ...
    @staticmethod
    def set_pyobject_attrib(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: str, jobid: str = '') -> None: ...
    @staticmethod
    def set_string_attrib(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: str, attr_index: int, jobid: str = '') -> None: ...
    @staticmethod
    def set_int_attrib(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: int, attr_index: int, jobid: str = '') -> None: ...
    @staticmethod
    def set_float_attrib(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: float, attr_index: int, jobid: str = '') -> None: ...
    @staticmethod
    def set_file_attrib(work_item: _pdg.WorkItem, subindex: int, attr_name: str, attr_value: tuple[str, str, int, bool], attr_index: int, jobid: str = '') -> None: ...

class SendCommand(PyProcessor):
    def __init__(self, node: _pdg.Node) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> None: ...
    def getCommandString(self, work_item: _pdg.WorkItem) -> str: ...
    def onCookTask(self, work_item: _pdg.WorkItem) -> _pdg.result: ...

class GenerativeSendCommand(PyProcessor):
    """
    Send Command where work items must be generated at generation time, instead
    of cook time.
    """
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> None: ...
    def get_data(self, work_item: _pdg.WorkItem | None, sharedservername: str) -> str | None: ...

class CommandServerFeedback(PyProcessor):
    """
    Base class for CommandChain servers.
    These are host applications which are run with an embedded RPC server
    in order to be remote controlled by PDG CommandSend tasks.
    Uses the sharedserver resource in PDG to share server instances between
    work items.
    """
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def evaluateStartupCommandline(self, upstream_item: _pdg.WorkItem) -> str: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> _pdg.result: ...
    def onAddInternalDependencies(self, dependency_holder: _pdg.DependencyHolder, internal_items: _pdg.WorkItemList, is_static: bool) -> _pdg.result: ...

class PythonServer(CommandServerFeedback):
    """
    A Server that runs vanilla python
    """
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...

class HoudiniServer(PythonServer):
    """

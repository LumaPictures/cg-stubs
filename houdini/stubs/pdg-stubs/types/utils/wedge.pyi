import _pdg
import hou
from houtypes import ParmCallbackKwargs
from pdg import PyProcessor as PyProcessor
from typing import TypedDict

class _NodeKwargs(TypedDict):
    node: hou.OpNode

class Wedge(PyProcessor):
    """
    Generates work items with wedged attributes
    """
    Float: int
    FloatVec: int
    Int: int
    IntVec: int
    Str: int
    Color: int
    Range: int
    Value: int
    ValueList: int
    Bracket: int
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onDeselectTask(self, work_item: _pdg.WorkItem) -> _pdg.result: ...
    def onSelectTask(self, work_item: _pdg.WorkItem) -> _pdg.result: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> _pdg.result: ...

def restoreCallback(kwargs: ParmCallbackKwargs) -> None: ...
def restoreAllCallback(kwargs: _NodeKwargs) -> None: ...
def stashCallback(kwargs: ParmCallbackKwargs) -> None: ...
def stashAllCallback(kwargs: _NodeKwargs) -> None: ...
def jumpCallback(kwargs: ParmCallbackKwargs) -> None: ...
def targetChanged(kwargs: ParmCallbackKwargs) -> None: ...
def chooseCallback(kwargs: ParmCallbackKwargs) -> None: ...
def registerTypes(type_registry: _pdg.TypeRegistry) -> None: ...

_T = TypeVar('_T')
class _CSVFormatKwargs(TypedDict, total=False):
    delimiter: str
    quotechar: str | None
    escapechar: str | None
    doublequote: bool
    skipinitialspace: bool
    lineterminator: str
    quoting: _QuotingType
    strict: bool

class CSVOutput(PyProcessor):
    """
    Writes workitem data to a csv file.
    """
    QueryData: int
    QueryAttrib: int
    QueryPattern: int
    MissingNone: int
    MissingError: int
    MissingWarning: int
    def __init__(self, node: _pdg.Node) -> None: ...
    @classmethod
    def templateName(cls) -> str: ...
    @classmethod
    def templateBody(cls) -> str: ...
    def onConfigureNode(self, node_options: _pdg.NodeOptions) -> _pdg.result: ...
    def onGenerate(self, item_holder: _pdg.WorkItemHolder, upstream_items: _pdg.WorkItemList, generation_type: _pdg.generationType) -> _pdg.result: ...

def unicode_csv_reader(unicode_csv_data: Iterable[str], dialect: _DialectLike = ..., **kwargs: Unpack[_CSVFormatKwargs]) -> Generator[list[str], None, None]: ...
def utf_8_encoder(unicode_csv_data: Iterable[_T]) -> Generator[_T, None, None]: ...


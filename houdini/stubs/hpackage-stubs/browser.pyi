class _ResourceEventKwargs(TypedDict, extra_items=hou._ResourceEventValue):  # type: ignore[call-arg]
    event_type: hou.EnumValue[hou.resourceEventMessage]
    resource_type: hou.EnumValue[hou.resourceType]

DIALOG_WIDTH: int
DROP_FILE_TYPES: tuple[str, str]

class PackageBrowser(QtWidgets.QFrame):
    marker_count: int
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def dragEnterEvent(self, event: PySide6.QtGui.QDragEnterEvent) -> None:
        """ Handle the drag enter event to accept supported files.
        """
    def dropEvent(self, event: PySide6.QtGui.QDropEvent) -> None:
        """ Handle the drop event to accept and process the ZIP file.
        """
    def sourceModel(self) -> model.PackageModel: ...
    def loadPackage(self, package_file_path: str) -> None: ...
    def loadPackageArchive(self, package_file_path: str, install_path: str | None = None) -> None: ...
    def reloadPackage(self, package_file_path: str) -> None: ...
    def printMessage(self, msg: str | list[str | None], msg_type: hou.EnumValue[hou.severityType] = ...) -> None: ...
    def onActivate(self) -> None:
        """ called by the pypanel framework """
    def onDeactivate(self) -> None:
        """ Called by the pypanel framework 
        """
    def onDestroy(self) -> None:
        """ called by the pypanel framework 
        """
    def onPackageApplyAction(self, **kwargs: int | float | bool | str) -> None:
        """
        Package editor callback
        """
    def onContextMenu(self, pos: PySide6.QtCore.QPoint) -> None: ...
    def onExpandNode(self) -> None: ...
    def onLoadPackage(self) -> None: ...
    def onLoadPackageArchive(self) -> None: ...
    def unloadPackage(self, package_filepath: str) -> None: ...
    def onUnloadPackage(self, package_filepath: str) -> None: ...
    def onRemovePackage(self) -> None: ...
    def onDeletePackage(self) -> None: ...
    def onReloadPackage(self) -> None: ...
    def onEditPackage(self) -> None: ...
    def onEditSelectedPackage(self) -> None: ...
    def onNewPackage(self) -> None:
        """ Create a new package.
        """
    def onNewPackageArchive(self) -> None: ...
    def onEditPackageFile(self) -> None:
        """ Load and edit a package file in the editor.
        """
    def onCheckAutoLoad(self, index: PySide6.QtCore.QModelIndex) -> None:
        ''' Set a package to load on startup when checked. When unchecked,
            mark the package to not load on startup. This only applies to
            non-scannable packages.
            
            checked: We add an "autoload" package in the user folder to
                     load a target package on startup. The autoload
                     package is a simple package with an instruction to
                     load the real package (target).

                     If the folder has already a package with the same 
                     name as the target package, we just remove it instead. 
                     
            unchecked:  Remove the "autoload" package if one exists for 
                        the target package. 
        '''
    def onCheckActivate(self, index: PySide6.QtCore.QModelIndex) -> None:
        """ Activate or deactivate the package that maps to index.
        """
    def onActivatePackage(self, package_filepath: str, node: model.NodeItem) -> None: ...
    def onDeactivatePackage(self, package_filepath: str, node: model.NodeItem) -> None: ...
    def onSceneLoaded(self, event_type: hou.EnumValue[hou.hipFileEventType]) -> None: ...
    def onSelectionChanged(self, selected: PySide6.QtCore.QItemSelection, deselected: PySide6.QtCore.QItemSelection) -> None: ...
    def onClearMessages(self) -> None: ...
    def onResourceEvent(self, **kwargs: Unpack[_ResourceEventKwargs]) -> None: ...


class NewPackageDialog(QtWidgets.QDialog):
    """ Dialog for creating a new package file in the user packages
        folder. The dialog creates a default package path buts allows 
        user to edit the package path and its content.
    """
    margin: PySide6.QtCore.QMargins | None
    spacing: int
    textsize: int
    def __init__(self, start_folder: str, parent: PackageBrowser | None = None) -> None: ...
    def setFilePath(self, file_path: str | None) -> None:
        """ Set file path and enable widgets.
        """
    def filePath(self) -> str: ...
    def onPackagePathEditingFinished(self, package_path: str) -> None: ...
    def onApplyChange(self) -> bool: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...

class NewPackageArchiveDialog(QtWidgets.QDialog):
    """ A dialog for creating package archives (zip files). 
        A package archive contains a content folder along with 
        a package installation file. The dialog provides a dialog 
        for choosing the content folder and a dialog for choosing
        the folder to save the archive. By default, archives are 
        saved under the user packages folder: 
          $HOUDINI_USER_PREF_DIR/packages/archives
        
        The package installation file can be created and edited
        as well with the dialog. 

        Package archives can be loaded from the browser with the
        File|Load Package Archive... menu
    """
    margin: PySide6.QtCore.QMargins | None
    spacing: int
    textsize: int
    def __init__(self, start_folder: str, parent: PackageBrowser | None = None) -> None: ...
    def onIncludePackage(self, state: int) -> None: ...
    def onContentFolderEditingFinished(self, folder_path: str) -> None: ...
    def onContentFolderChoosen(self, folder_path: str) -> None: ...
    def onPackagePathEditingFinished(self, file_path: str) -> None: ...
    def onPackageChosen(self, file_path: str) -> None: ...
    def onApplyChange(self) -> bool:
        """ Create a new package archive with the captured data.
        """
    def accept(self) -> None: ...
    def reject(self) -> None: ...

class LoadPackageArchiveDialog(QtWidgets.QDialog):
    """ A dialog for loading and deploying package archives 
        (zip files). 

        [Package Archive][Edit field][Open Dialog Button]
        Package archives can be created from the browser with the
        File|New Package Archive... menu
    """
    margin: PySide6.QtCore.QMargins | None
    spacing: int
    textsize: int
    def __init__(self, start_folder: str, parent: PackageBrowser | None = None) -> None: ...
    def archiveSelector(self) -> ArchiveSelector: ...
    def setInstallFolder(self, folder_path: str | Path, override: bool = True) -> None: ...
    def onArchivePathEditingFinished(self, file_path: str) -> None: ...
    def onArchiveChoosen(self, file_path: str) -> None: ...
    def onArchiveInstallFolderEditingFinished(self, folder_path: str) -> None: ...
    def onArchiveInstallFolderChosen(self, folder_path: str) -> None: ...
    def onApplyChange(self) -> None:
        """ Install the selected package archive.
        """
    @staticmethod
    def canOverwrite(install_path: str | Path) -> bool: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...

class PackageSelector(QtWidgets.QFrame):
    """ A widget for selecting and editing a package file.
    """
    packageChosen: PySide6.QtCore.Signal
    packagePathEditingFinished: PySide6.QtCore.Signal
    def __init__(self, view: PackageBrowser | None = None, start_folder: str | None = None, use_chooser: bool = True, package_type: str | None = None, reload_on_edit: bool = False, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def filePath(self) -> str: ...
    def setFilePath(self, file_path: str | None) -> None: ...
    def setEditEnabled(self, value: bool) -> None: ...
    @staticmethod
    def canOverwrite(package_file_path: str | Path) -> bool: ...
    def createPackage(self, package_type: str | None = None) -> Literal[-1, 0, 1]:
        """ Create a package on disk from a package template.
            Return 1 if successful, 0 if no package template was
            provided, -1 if an error occured.
        """
    def onChoosePackage(self) -> None: ...
    def onPackageChanged(self, package_file_path: str) -> None: ...
    def onPackagePathEditingFinished(self) -> None: ...
    def onPackageApplyAction(self, **kwargs: int | float | bool | str) -> None: ...
    def onEditPackage(self) -> None:
        """ Edit the package specified in the text box, create
            the package if it doesn't exist yet.
        """

class ArchiveSelector(QtWidgets.QFrame):
    archiveChosen: PySide6.QtCore.Signal
    filePathEditingFinished: PySide6.QtCore.Signal
    def __init__(self, start_folder: str, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def filePath(self) -> str: ...
    def setFilePath(self, file_path: str | None) -> None: ...
    def onEditingFinished(self) -> None: ...
    def onChooseArchive(self) -> None: ...


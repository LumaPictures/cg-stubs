class ReportUndefined(jinja2.ChainableUndefined):
    """A tolerant Undefined for rendering reports from images that don't carry
    every husk metadata key.  Chained attribute access, direct printing and
    iteration degrade to undefined/empty rather than raising, so a partial EXR
    still produces a report."""
    def __iter__(self) -> Iterator[Never]: ...


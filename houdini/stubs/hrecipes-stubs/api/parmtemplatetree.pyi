import hou
from . import utils as utils
from collections.abc import Collection, Generator

def iterWithParent(group_or_folder: hou.ParmTemplateGroup | hou.FolderParmTemplate, iterate_folders: bool = True, iterate_multiparms: bool = True, parent_template: hou.ParmTemplate | None = None) -> Generator[tuple[hou.ParmTemplate, hou.ParmTemplate | None], None, None]:
    '''
    Generator to use for iterating over the parameter templates of the incoming parm template group.
    This iterator also returns the inside of multiparm blocks, as well as the parent template inside folders.

    Usage:
    for parmtemplate, parent_template in iterParmTemplatesWithParent(node.parmTemplateGroup()):
        print(parmtemplate, parent_template.name() if parent_template is not None else "root")
    '''

class ParmLeaf:
    """
    Representing a generic parameter node in the tree, containing data both about the template and the parameter.

    The tree initializes this object using a parameter template, therefore multiparm contents are not expended at first.
    Upon multiparm expansion, self.name is changed to reflect the multi parm index.

    """
    tree_parms: dict[str, ParmLeaf]
    name: str
    parmtype: str | None
    parmtemplate: hou.ParmTemplate | None
    parent_name: str | None
    template_children: list[str]
    expanded_instances: list[str]
    multiparm_index: int
    path_indices: list[int]
    checked: bool
    tree: ParmTree | None
    def __init__(self, tree_parms: dict[str, ParmLeaf], parmtemplate: hou.ParmTemplate | None = None, name: str = '/', parmtype: str | None = 'root', tree: ParmTree | None = None) -> None: ...
    def templateChildIndex(self, name: str) -> int: ...
    def appendTemplateChild(self, name: str) -> None: ...
    def clearTemplateChildren(self) -> None: ...
    def appendExpandedInstance(self, instance: str) -> None: ...
    def disconnect(self) -> None: ...
    def childCount(self) -> int: ...
    def childAt(self, index: int = 0) -> ParmLeaf: ...
    def hasChildren(self) -> bool: ...
    def parent(self) -> ParmLeaf | None: ...
    def indexOfChild(self, name: str) -> int: ...
    def row(self) -> int: ...
    def setChecked(self, checked: bool) -> None: ...
    def hasCheckedChild(self) -> bool: ...
    def hasCheckedChildren(self) -> bool: ...
    def filterName(self) -> str: ...
    def label(self) -> str: ...
    def interfaceType(self) -> str | None: ...
    def initPathIndiciesFromParent(self) -> None:
        """Call this for each parm that is not a root to increment the path index list
         based on it's parent's path index list"""
    @property
    def depth(self) -> int: ...

class ParmTree:
    """
    Builds a tree structure of a given set of parameters for the node. It uses the parm template group of a node,
    to get ordered parameter structure.

    The tree
    """
    node: hou.OpNode | None
    parms: dict[str, ParmLeaf]
    def __init__(self) -> None: ...
    def buildTreeFromNode(self, node: hou.OpNode, expand_multiparms: bool = True, parmtype_filters: Collection[str] | None = None) -> None:
        """
        Builds the tree for all parameters on the node.
        """
    def buildTreeFromMultiParm(self, parm: hou.Parm, expand_multiparms: bool = True) -> None: ...
    def buildTreeFromMultiParmTemplate(self, parmtemplate: hou.FolderParmTemplate) -> None: ...
    def iterTemplateChildren(self, startname: str = '/', inclusive: bool = False, exclude_multiparm_instances: bool = False, parmtype_filters: Collection[str] | None = None) -> Generator[ParmLeaf, None, None]: ...
    def iterParents(self, startname: str, parmtype_filters: Collection[str] | None = None) -> Generator[ParmLeaf, None, None]: ...
    def iterExpandedInstances(self, startname: str = '/', inclusive: bool = False, parmtype_filters: Collection[str] | None = None, exclude_multiparm_instances: bool = False) -> Generator[ParmLeaf, None, None]: ...
    def iterAll(self, startname: str = '/', parmtype_filters: Collection[str] | None = None, inclusive: bool = False) -> Generator[ParmLeaf, None, None]: ...
    def printTree(self, startname: str = '/', brief: bool = True) -> None: ...
    def __getitem__(self, key: str) -> ParmLeaf: ...
    def __setitem__(self, key: str, item: ParmLeaf) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> list[bool]: ...

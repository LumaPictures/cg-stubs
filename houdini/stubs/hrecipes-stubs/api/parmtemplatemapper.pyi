import hou
from . import utils as utils
from collections import Counter as Counter
from collections.abc import Generator
from typing import Iterable

class NodeBase:
    def __init__(self, parent: NodeBase | None, name: str, label: str) -> None: ...
    def parent(self) -> NodeBase | None: ...
    def setParent(self, parent: NodeBase) -> None: ...
    def name(self) -> str: ...
    def setName(self, name: str) -> None: ...
    def label(self) -> str: ...
    def setLabel(self, label: str) -> None: ...
    def baseName(self) -> str: ...
    def setBaseName(self, basename: str) -> None: ...
    def setBaseNameFromDigit(self, digit: int) -> None: ...
    def setMatched(self, matched: bool) -> None: ...
    def matched(self) -> bool: ...
    def nameMatch(self, other_node: NodeBase) -> bool: ...
    def labelMatch(self, other_node: NodeBase) -> bool: ...
    def isSpare(self) -> bool: ...
    def appendChild(self, node: NodeBase) -> None: ...
    def hasChildren(self) -> bool: ...
    def children(self) -> list[NodeBase]: ...
    def childCount(self) -> int: ...
    def childNames(self) -> list[str]: ...
    def childLabels(self) -> list[str]: ...
    def splitName(self) -> tuple[str, None] | tuple[str, int]: ...
    def groupByStem(self) -> list[StemGroup]: ...
    def folderTabContainers(self) -> list[TabFolderContainer]:
        """
        Return a flat list of TabFolderContainer objects in the tree.
        """
    def groupingFolders(self) -> list[GroupingFolder]:
        """
        Return a flat list of GroupingFolder objects in the tree.
        """
    def matchingNameInList(self, other_folders: Iterable[NodeBase]) -> NodeBase | None: ...
    def matchingLabelInList(self, other_folders: Iterable[NodeBase]) -> NodeBase | None: ...
    def iterParents(self, folder: NodeBase | None = None) -> Generator[NodeBase | None, None, None]: ...
    def mapping(self) -> dict[str, str]: ...
    def path(self) -> str: ...
    def iterTree(self, node: NodeBase | None = None, inclusive: bool = True, dive_folders: bool = True, dive_multiparms: bool = True, depth: int = 0) -> Generator[tuple[NodeBase, int], None, None]: ...
    def printTree(self, include_parms: bool = False) -> None: ...
    def printTreePath(self) -> None: ...

class RootFolder(NodeBase):
    def __init__(self) -> None: ...

class GroupingFolder(NodeBase):
    """
    Class for Simple, Collapsible folders, anything that is not tabbed.
    """
    def __init__(self, parent: NodeBase, name: str, label: str) -> None: ...

class TabFolderContainer(NodeBase):
    """
    Class to store individual tabs.
    This class represents an abstract folder that does not exist,
    but knows about all the tab folders it contains
    """
    def __init__(self, parent: NodeBase, name: str, label: str) -> None: ...
    def updateNameFromCommonPrefix(self) -> None: ...
    def updateChildNames(self) -> None: ...
    def appendChild(self, folder: NodeBase) -> None: ...
    def hasExactMatchingLabels(self, other_node: TabFolderContainer) -> bool: ...
    def folderByLabel(self, label: str) -> NodeBase | None: ...

class TabFolder(NodeBase):
    """
    Class for individual tabs in a Tab Container
    """
    def __init__(self, parent: NodeBase, name: str, label: str) -> None: ...

class Parameter(NodeBase):
    """
    Class to store a parameter, except a multiparm parent
    """
    def __init__(self, parent: NodeBase, name: str, label: str) -> None: ...

class MultiparmParent(NodeBase):
    """
    Convenient class to store a multiparm parent
    """
    def __init__(self, parent: NodeBase, name: str, label: str) -> None: ...

class StemGroup:
    """
    Helper class to store a flat list of nodes matching their name's stem.
    For example,
    foo
    foo0
    foo1
    """
    def __init__(self, stem: str, nodes: list[GroupingFolder | TabFolderContainer | Parameter | MultiparmParent]) -> None: ...
    def stem(self) -> str: ...
    def getLargestAvailableDigit(self) -> int: ...
    def resolveNameConflict(self) -> None:
        """
        Reconstruction of the renaming that take place for folders when the Edit Parameter Interface is opened...
        1) First find all the used digits.
        2) If there is a name without a digit, we have to solve that first, otherwise skip this:
            a) For some strange reason, we have to assign '2' to those names.
            b) If '2' is already used, find the next available higher digit.
        4) For all remaining names, find the next available higher digit in order.

        a  -> a2

        b  -> b3
        b2 -> b4

        c   -> c2
        c1  -> c3

        d0  -> d1

        e   -> e2
        e0  -> e1

        f0  -> f2
        f1  -> f3

        g0  -> g1
        g2  -> g3

        h   -> h3
        h1  -> h4
        h2  -> h6
        h5  -> h7

        i   -> i3
        i0  -> i4
        i1  -> i5
        i2  -> i6

        j5  -> j7
        j6  -> j8

        """

def mappingToAvoidNameConflict(ptg_base: hou.ParmTemplateGroup, ptg_new: hou.ParmTemplateGroup) -> dict[str, str]: ...
def treeFromTemplate(ptg: hou.ParmTemplateGroup) -> RootFolder: ...

class TemplateMapper:
    def __init__(self, node: hou.OpNode) -> None: ...
    def nativeToSpare(self, name: str) -> str: ...
    def spareToNative(self, name: str) -> str: ...
    def spareName(self, name: str) -> str: ...
    def nativeName(self, name: str) -> str: ...
    def isSpare(self, name: str) -> bool: ...
    def findTemplate(self, name: str) -> hou.ParmTemplate | None: ...

def findGroomOutputInInputs(startnode: hou.NetworkMovableItem | None, outputindex: int = -1, includeme: bool = False) -> tuple[hou.OpNode | hou.SubnetIndirectInput | None, int]:
    """ Finds a groom node output in the inputs of 'startnode' and returns
        (foundnode, outputindex), where 'foundnode' is the found groom node and
        outputindex is the index of the output by which the search reached the
        node.

        Note that groomnode may be a hou.SubnetIndirectInput since we stop at
        subnet boundaries and these are treated as groom nodes.

        If includeme is True the first node will be returned if it is a groom
        node. In that case the outputindex by which the startnode was reached
        should be supplied.

        Returns (None, -1) when no groom node was found.
    """

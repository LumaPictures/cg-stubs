@dataclass
class Target:
    """
    Tweak control vertex.
    """
    id_: int
    source_time: float
    time: float
    position: hou.Vector3
    is_anchor: bool
    @staticmethod
    def fromParmDict(config_dict: _TargetConfig | apex.Dict) -> Target | None: ...
    def asConfigDict(self) -> _TargetConfig: ...

class TargetSequence:
    """
    Ad-hoc wrapper class for a sequence of targets.

    Targets are stored sorted by increasing source time and time.
    """
    @staticmethod
    def fromList(targets: Iterable[Target]) -> TargetSequence: ...
    @staticmethod
    def fromConfigDictList(config_dict_list: Iterable[_TargetConfig | apex.Dict]) -> TargetSequence: ...
    def asConfigDictList(self) -> list[_TargetConfig]: ...
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def getTargetById(self, id_: int) -> Target: ...
    def getTargetBeforeTime(self, time: float) -> Target | None: ...
    def getTargetAfterTime(self, time: float) -> Target | None: ...
    def createTarget(self, source_time: float, time: float, position: hou.Vector3) -> Target: ...
    def removeTarget(self, id_: int) -> bool: ...
    def getTargetNeighbours(self, id_: int) -> tuple[Target, Target]:
        """
        Retrieves the neighbouring targets of this target. If a given neighbour
        does not exist, this target is returned as that neighbour.
        """
    def getTargetSectionEndpoints(self, id_: int) -> tuple[Target, Target]:
        """
        Retrieves the endpoints of this target's section. A section is bounded
        either by an anchor or the first or last targets of the path.
        """
    def iterTargetsById(self) -> Iterator[Target]: ...
    def iterTargetsByTime(self) -> Iterator[Target]: ...
    def iterTargetsByTimeRange(self, start: float, end: float, inclusive: bool = True) -> Iterator[Target]: ...
    def iterAnchorsByTime(self) -> Iterator[Target]: ...
    def _find(self, comparator: Callable[[Target], float]) -> tuple[bool, int]:
        """
        Finds the index of target using the provided comparator.
        
        Returns either a pre-existing index or an index where the target
        should be inserted. Specifically, the return value is a tuple where
        the first component is True if the target exists, and the second
        component is its index.
        """

class GraphBuilder:
    """
    Constructs and manages the character path rig.

    Creates the initial graph, resolves target additions/removals,
    handles creation of anchors, and manages the target naming scheme.
    """
    GRAPH: str
    TARGET_GRAPH: str
    tweak_target_graph: apex.Graph
    tweak_prefix: str
    target_prefix: str
    def __init__(self, tool: GlideTool) -> None: ...
    @property
    def tool(self) -> GlideTool | None: ...
    @property
    def graph_holder(self) -> acpu.GraphHolder: ...
    @property
    def graph(self) -> apex.Graph: ...
    @property
    def id_cache(self) -> acpu.GraphIdCache: ...
    @property
    def prefix(self) -> str: ...
    def createTargetName(self, target: Target) -> str:
        """Create a target name from the graph prefix and target ID."""
    def findTargetByCtrlPath(self, sequence: TargetSequence, ctrl_path: str) -> Target | None:
        """Find a target by its control path."""
    def targetAddNodeName(self, target: Target) -> str:
        """The name of a target's add node."""
    def targetScaleFactorNodeName(self, target: Target) -> str:
        """The name of a target's scale factor node."""
    def targetSourceTimeInputName(self, target: Target) -> str:
        """The name of a target's source time input."""
    def targetTimeInputName(self, target: Target) -> str:
        """The name of a target's time input."""
    def targetPositionInputName(self, target: Target) -> str:
        """The name of a target's position input."""
    def targetAnchorInputName(self, target: Target) -> str:
        """The name of a target's anchor input."""
    def targetTranslateInputName(self, target: Target) -> str:
        """The name of a target's translation input."""
    def targetRotateInputName(self, target: Target) -> str:
        """The name of a target's rotate input."""
    def targetPositionOutputName(self, target: Target) -> str:
        """The name of a target's position output."""
    def isGraphConstructed(self) -> bool:
        """Checks that the graph has been constructed in general."""
    def isTargetCreationComplete(self, sequence: TargetSequence) -> bool:
        """
        Checks whether target subgraphs have been generated for each target
        in the specified sequence.
        """
    def build(self, sequence: TargetSequence) -> None:
        """
        Constructs the glide rig graph. A target subgraph is created for each
        target in the provided sequence.
        """
    def rebuild(self, sequence: TargetSequence) -> None: ...
    def loadSequence(self) -> TargetSequence | None:
        """Load a target sequence from the graph config."""
    def saveSequence(self, sequence: TargetSequence) -> None:
        """Save a target sequence to the graph config."""
    def updateParmsWithTargets(self, sequence: TargetSequence) -> None:
        """
        Synchronizes the graph input parms with a target sequence.
        """
    def updateTargetsWithOutputs(self, sequence: TargetSequence) -> None:
        """
        Synchronizes the target sequence with the graph outputs.
        """
    def buildTranslateResetParms(self, targets: TargetSequence) -> apex.Dict:
        """
        Create a parms dict that sets the translate parm of all targets to the
        zero vector.
        """


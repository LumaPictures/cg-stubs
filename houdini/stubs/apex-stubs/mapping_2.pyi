_Mode: TypeAlias = Literal[0, 1, 2, 3]
class _AnimateState(asu._AnimateState, Protocol):
    """The Animate viewer state (`viewer_states/apexanimate.py`): this module uses only the members `apex.stateutils_2._AnimateState` declares."""

class _UpdateHandler(Protocol):
    """What `MappingGadget.setEvaluateCallback` takes: `update()` returns True when it has positioned the line points."""
    def update(self, geo: hou.Geometry, /) -> bool: ...

MAPPING_GADGET_GRAPH: str
DRAWABLE_SRC_XFORM_PROPERTY: str
DRAWABLE_DST_XFORM_PROPERTY: str
DRAWABLE_SRC_PROPERTY: str
DRAWABLE_DST_PROPERTY: str
DRAWABLE_NUM_ARROWS_PROPERTY: str
DRAWABLE_SOURCES_PROPERTY: str
DRAWABLE_SCALE_PROPERTY: str
DRAWABLE_VP_SCALE_PROPERTY: str
DRAWABLE_VP_MINVERTED_PROPERTY: str
GADGET_SELECTION_ATTRIBUTE: str
GADGET_LABEL_ATTRIBUTE: str
ENDPOINT_DEFAULT_COLOR: hou.Color
SRC_DEFAULT_RADIUS: int
DST_DEFAULT_RADIUS: int
SRC_DEFAULT_HIGHLIGHT_MODE: hou.EnumValue[hou.drawableHighlightMode]
DST_DEFAULT_HIGHLIGHT_MODE: hou.EnumValue[hou.drawableHighlightMode]
DST_GEO: str
SRC_GEO: str
SRC_LINES_GEO: str
ONE_TO_ONE: Literal[0]
ONE_TO_MANY: Literal[1]
MANY_TO_ONE: Literal[2]
MANY_TO_MANY: Literal[3]

class MappingEndpoint:
    def __init__(self) -> None: ...
    def xform(self, control_manager: ControlManager) -> hou.Matrix4: ...
    def color(self) -> hou.Color: ...
    def setColor(self, color: hou.Color) -> None: ...
    def alpha(self) -> float: ...
    def addControlToManager(self, scene: Scene, control_manager: ControlManager) -> None: ...

class ControlEndpoint(MappingEndpoint):
    control_name: str
    control_path: str
    def __init__(self, control_path: str) -> None: ...
    @typing.overload
    def xform(self, control_manager: ControlManager) -> hou.Matrix4: ...
    @typing.overload
    def xform(self, control_manager: None) -> None: ...
    def addControlToManager(self, scene: Scene, control_manager: ControlManager) -> None: ...

class Mapping:
    color: hou.Color
    alpha: float
    src: MappingEndpoint
    dst: MappingEndpoint
    def __init__(self, src: MappingEndpoint, dst: MappingEndpoint, color: hou.Color = ..., alpha: float = 1.0, name: str | None = None, label: str | None = None) -> None: ...
    def name(self) -> str: ...
    def label(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    @staticmethod
    def controls(src: str, dst: str, name: str | None = None, label: str | None = None) -> Mapping: ...

class MappingCollection:
    mode: _Mode
    mappings: list[Mapping]
    mapping_srcs: Sequence[MappingEndpoint] | None
    mapping_dsts: Sequence[MappingEndpoint] | None
    def __init__(self, mode: _Mode = ..., mapping_srcs: Sequence[MappingEndpoint] | None = None, mapping_dsts: Sequence[MappingEndpoint] | None = None) -> None: ...
    def __bool__(self) -> bool: ...
    def __len__(self) -> int: ...
    def changeCount(self) -> int: ...
    def incrementChangeCount(self) -> None: ...
    def updateMappingSrcs(self, mapping_srcs: Sequence[MappingEndpoint] | None) -> None: ...
    def updateMappingDsts(self, mapping_dsts: Sequence[MappingEndpoint] | None) -> None: ...
    def findMappingEndpoints(self, name: str) -> list[MappingEndpoint]: ...
    def isValidMapping(self, mapping: Mapping) -> Mapping | Literal[False]: ...
    def isEmpty(self) -> bool: ...
    def merge(self, other: MappingCollection, remove_existing: bool = True) -> None: ...
    def asDict(self) -> dict[MappingEndpoint, MappingEndpoint] | dict[MappingEndpoint, list[MappingEndpoint]]: ...
    def asApexDict(self) -> _apex.Dict:
        """
        Return an apex.Dict object containing the mappings.
        Unlike the python dict equivalent, this only supports
        string mappings.
        """
    @staticmethod
    def mappingCollectionFromDict(src_dict: SupportsKeysAndGetItem[str, str] | SupportsKeysAndGetItem[str, Iterable[str]], mode: _Mode = ..., controls: bool = False) -> MappingCollection: ...
    def checkForCycles(self) -> tuple[MappingEndpoint, Mapping] | tuple[None, None]: ...
    def checkForChains(self) -> bool: ...
    def findMappings(self, src: MappingEndpoint | None = None, dst: MappingEndpoint | None = None) -> tuple[Mapping, ...]: ...
    def findMappingFromNames(self, src: str, dst: str) -> Mapping | None:
        """
        Given a src and dst strings 
        return a Mapping(src, dst) if it exists within the collection
        otherwise return None    
        """
    def sources(self) -> set[MappingEndpoint]: ...
    def destinations(self) -> set[MappingEndpoint]: ...
    def addMapping(self, mapping: Mapping, remove_existing: bool = True) -> bool: ...
    def removeMapping(self, mapping: Mapping) -> None: ...
    def buildMappingGeometry(self) -> hou.Geometry: ...

class MappingGadget:
    scene_viewer: hou.SceneViewer
    drawable_graph: _apex.Graph
    drawable_parms: _apex.Dict
    custom_sel_handler: MappingGadgetSelectionHandler | None
    control_manager: ControlManager
    src_offset: hou.Matrix4
    dst_offset: hou.Matrix4
    src_line_drawable: hou.GeometryDrawable
    src_arrow_drawable: hou.GeometryDrawable
    arrow_scale: float
    num_arrows: int
    src_rigs: None
    dst_rigs: None
    line_geo: hou.Geometry
    drawables: list[hou.GeometryDrawable]
    src_alpha: float
    dst_alpha: float
    line_alpha: float
    arrow_alpha: float
    src_geo: hou.Geometry
    dst_geo: hou.Geometry
    arrow_geo: hou.Geometry
    src_drawable: hou.GeometryDrawable
    dst_drawable: hou.GeometryDrawable
    current_control: None
    current_control_name: None
    temp_line_geo: hou.Geometry | None
    temp_line_drawable: hou.GeometryDrawable | None
    temp_line_src: hou.Point
    temp_line_dst: hou.Point
    geos_initialized: bool
    isMappingMode: bool
    last_sel: ControlEndpoint | None
    current_mirror: ControlEndpoint | None
    last_mirror: ControlEndpoint | None
    is_active: bool
    def __init__(self, state: _AnimateState, scene: Scene) -> None: ...
    def __del__(self) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> Scene: ...
    @property
    def mapping_collection(self) -> MappingCollection: ...
    @mapping_collection.setter
    def mapping_collection(self, mapping_collection: MappingCollection | None) -> None: ...
    def setIsControl(self, on: bool) -> None: ...
    def setSrcVisible(self, on: bool) -> None: ...
    def setSrcColor(self, color: hou.Color, alpha: float | None = None) -> None: ...
    def setSrcStyle(self, style: hou.EnumValue[hou.drawableGeometryPointStyle]) -> None: ...
    def setEndpointColorsFromMapping(self) -> None:
        """
        Sets src and dst color and alpha based on 
        endpoint.color() and endpoint.alpha()    
        """
    def setDstVisible(self, on: bool) -> None: ...
    def setDstColor(self, color: hou.Color, alpha: float | None = None) -> None: ...
    def setDstStyle(self, style: hou.EnumValue[hou.drawableGeometryPointStyle]) -> None: ...
    def setSrcRadius(self, radius: float) -> None: ...
    def setDstRadius(self, radius: float) -> None: ...
    def setSrcHighlightMode(self, highlight: hou.EnumValue[hou.drawableHighlightMode]) -> None: ...
    def setDstHighlightMode(self, highlight: hou.EnumValue[hou.drawableHighlightMode]) -> None: ...
    def setLineColor(self, color: hou.Color, alpha: float | None = None) -> None: ...
    def setLineColorAndSelectionAttrib(self) -> None:
        """
        Sets Color Alpha and GADGET_SELECTION_ATTRIBUTE on the line geometry    
        """
    def setLineStyle(self, style: hou.EnumValue[hou.drawableGeometryLineStyle]) -> None: ...
    def setLineWidth(self, width: float) -> None: ...
    def setLineGlowWidth(self, width: float) -> None: ...
    def setArrowsVisible(self, on: bool) -> None: ...
    def setArrowColor(self, color: hou.Color, alpha: float | None = None) -> None: ...
    def initParms(self) -> None: ...
    def initGeo(self, geo: hou.Geometry | None = None) -> hou.Geometry: ...
    def initGraph(self) -> None: ...
    def initGeos(self) -> None: ...
    def initDrawables(self) -> None: ...
    def updateGeos(self) -> None: ...
    def setGeometry(self, line_geo: hou.Geometry) -> None: ...
    def setEvaluateCallback(self, handler: _UpdateHandler | None) -> None: ...
    def updateGeoFromMapping(self, mapping_collection: MappingCollection) -> None: ...
    def addMappingEntry(self, src: MappingEndpoint, dst: MappingEndpoint, update: bool = False) -> None: ...
    def removeMappingEntry(self, dst: MappingEndpoint | None) -> None: ...
    def clear(self) -> None: ...
    def draw(self, handle: int) -> None: ...
    def saveToGeometry(self, geo: hou.Geometry, prefix: str = '', suffix: str = '') -> None: ...
    def evaluate(self) -> None: ...
    def show(self, on: bool = True) -> None: ...
    def startInteractiveMapping(self, mapping_collection: MappingCollection) -> None: ...
    def stopInteractiveMapping(self, hide: bool = True) -> None:
        """
            Stops the interactive mapping.

            hide: If True, hides the mappings. (i.e. self.show(False))
        """
    def initCustomSelectionHandler(self) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> bool:
        """
            This function should be called in your tool's onMouseEvent for the
            interactive mapping to work properly.

            This function will return False when not in interactive mapping mode,
            and return true if in interactive mapping mode, and you should consume
            the mouse event if this function returns True, since it assumes
            that the selection_handler does not get the mouse event.

            Your tool's onMouseEvent could look something like this:

            def onMouseEvent(self, kwargs):
                if self.mapping_gadget.onMouseEvent(kwargs):
                    return True # consume the mouse event
                ...
                rest of your onMouseEvent function
                ...

            This way, you consume the mouse event if you have started the
            interactive mapping, and do your regular onMouseEvent otherwise.
        """

@typing.overload
def getMappingFromRig(rig_graph: _apex.Graph, target: str, mapping_name: str = ..., as_dict: Literal[False] = ...) -> MappingCollection: ...
@typing.overload
def getMappingFromRig(rig_graph: _apex.Graph, target: str, mapping_name: str, as_dict: Literal[True]) -> dict[MappingEndpoint, MappingEndpoint]: ...
@typing.overload
def getMappingFromRig(rig_graph: _apex.Graph, target: str, mapping_name: str = ..., *, as_dict: Literal[True]) -> dict[MappingEndpoint, MappingEndpoint]: ...
@typing.overload
def getMappingFromRig(rig_graph: _apex.Graph, target: str, mapping_name: str = ..., as_dict: bool = ...) -> MappingCollection | dict[MappingEndpoint, MappingEndpoint]: ...


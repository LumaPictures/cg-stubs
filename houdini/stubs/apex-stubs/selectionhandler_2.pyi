import hou
import resourceutils as ru
from collections.abc import Iterable
from houtypes import ViewerStateEventKwargs
from typing import TypeAlias


from typing import TypeAlias
from typing import TypeVar
from collections.abc import Sequence
from typing import TypeVar
_PrimsT = TypeVar('_PrimsT', bound=Sequence[hou.Prim])
SelectionRegionDrawable: TypeAlias = ru.SelectionRegionDrawable
class AttribMapCache:
    """
    Cache for retrieving prim numbers from attribute values.
    We build this mapping once with a given vexAttribDataId, and
    then while that stays the same, we can reuse it to look up prims.
    """
    geo: hou.Geometry
    query_attrib: str
    data_id: tuple[int, ...]
    query_attrib_map: dict[str, int]
    def __init__(self, geo: hou.Geometry, query_attrib: str) -> None: ...
    def buildCache(self) -> None:
        """ Build the cache using the geometry and query attribute. """
    def lookupPrimnum(self, val: str) -> int:
        """
        Lookup the first prim number in the supplied geometry with
        the given attribute value. Return -1 if not found.

        :val: The attribute value to lookup.
        """
    def isValidForGeo(self, geo: hou.Geometry) -> bool:
        """
        Whether this geometry has the same vexAttribDataId
        as the original geometry we supplied.

        :geo: The geometry to check.
        """

class DrawableSelector(ru.DrawableSelector):
    query_attrib: str
    pre_selection: list[str] | str | None
    pre_selection_prims: dict[hou.SimpleDrawable | hou.AdvancedDrawable, list[hou.Prim] | tuple[hou.Prim, ...]]
    pre_selection_paths: dict[hou.SimpleDrawable | hou.AdvancedDrawable, list[str]]
    ctrl_paths: list[str]
    selection: list[str] | list[list[str] | str | None]
    selection_prims: dict[hou.SimpleDrawable | hou.AdvancedDrawable, list[hou.Prim] | tuple[hou.Prim, ...]]
    intersect_pos: hou.Vector3
    is_skin_selector: bool
    rig_paths: list[str]
    attrib_map_caches: dict[int, AttribMapCache]
    def __init__(self, scene_viewer: hou.SceneViewer, drawables: Iterable[hou.SimpleDrawable | hou.AdvancedDrawable], query_attrib: str, is_skin_selector: bool = False, make_select_region_drawable: bool = False) -> None: ...
    @property
    def drawables(self) -> list[hou.SimpleDrawable | hou.AdvancedDrawable]:
        """ 
        Property to allow retrieving the single drawable class for
        this drawable selector.
        """
    @drawables.setter
    def drawables(self, drawables: list[hou.SimpleDrawable | hou.AdvancedDrawable]) -> None:
        """ Setter for the drawables property. Needed for the ragdoll tool. """
    def initDrawableRigPaths(self) -> None:
        """creates a list of the rigpaths that we can deduce from the drawable names
        for each drawable. this can be used to deduce the absolute control path from 
        a relative controlname attirbute on an intersection geometry.
        """
    def getDrawableAttribCache(self, geo: hou.Geometry, drawable_index: int) -> AttribMapCache:
        """
        Get the drawable attribute value cache for this geometry
        for this drawable.
        """
    def getSkinControlValues(self, sel_obj: hou.Selection, geo: hou.Geometry, drawable_index: int) -> tuple[list[str], list[hou.Prim]]:
        """
        Given a selection object on primitives, the geometry, and the drawable
        index in the list of drawables, return the list of control paths and
        a corresponding hou.Prim for each of the control values found.

        :sel_obj: The hou.Selection generated by scene_viewer._query
        """
    def getPrimControlValues(self, prims: _PrimsT, drawable_index: int = 0) -> tuple[list[str], list[hou.Prim] | _PrimsT]:
        """
        Finds a set of all control prim attributes on a given number of
        prims of a given drawable. Return the absolute control paths by
        assembling the rig path of the drawable with the relative control
        name queried by the given attribute.

        :prims: The list of hou.Prim's to look up control values on.
        :drawable_index: The index of the drawable in the drawables list.
        """
    def getPrimControlValue(self, prim: hou.Prim, drawable_index: int = 0, absolute_path: bool = True) -> str | None:
        """finds the absolute control path a prim of a given drawable. 
        """
    def startBoxSelect(self, ui_event: hou.ViewerEvent) -> None:
        """ Start a box selection. """
    def onLocateBoxSelection(self, kwargs: ViewerStateEventKwargs, box_select_results: ru.BoxSelectResult) -> int:
        """ Respond to located box selected elements. """
    def onBoxSelection(self, kwargs: ViewerStateEventKwargs, result: ru.BoxSelectResult) -> int:
        """ Respond to box selected elements. """
    def _intersectSingleSelection(self, kwargs: ViewerStateEventKwargs, result: ru.SingleSelectResult, precise: bool = True) -> tuple[str | None, hou.Vector3]:
        """
        On single selections, intersect the prim under the mouse with a ray
        to get the intersect position and the attribute value telling us
        the control path.

        :precise: when True, ray-intersect the geometry to determine an
                  exact hit position.
        """
    def onLocateSingleSelection(self, kwargs: ViewerStateEventKwargs, result: ru.SingleSelectResult) -> bool:
        """ Respond to located single selection. """
    def onSingleSelection(self, kwargs: ViewerStateEventKwargs, result: ru.SingleSelectResult) -> int:
        """ Respond to a single selection. """
    def performSingleSelect(self, kwargs: ViewerStateEventKwargs, ui_event: hou.ViewerEvent) -> tuple[str | None, hou.Vector3]: ...
    def getDragLocate(self, kwargs: ViewerStateEventKwargs) -> bool:
        """ Get whether to do drag locating. """
    def getAllowSelectDrag(self, kwargs: ViewerStateEventKwargs) -> bool:
        """ Get whether select and drag is enabled. """

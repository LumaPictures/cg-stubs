class GeometryBuilder:
    def __init__(self) -> None: ...
    def addCircle(self, radius: float = 1.0) -> GeometryBuilder: ...
    def addLine(self, offset: float = 0.0, angle: float = 0.0) -> GeometryBuilder: ...
    def build(self) -> hou.Geometry: ...


class BrushShape:
    """
    The brush shape visualizer.

    All options are provided in screenspace units.
    """
    def __init__(self, scene_viewer: hou.SceneViewer, name: str) -> None: ...
    @property
    def vp(self) -> hou.GeometryViewport: ...
    def show(self, on: bool) -> None: ...
    def setCenter(self, x: float, y: float) -> None: ...
    def setRadius(self, radius: float) -> None: ...
    def setGeometry(self, geometry: hou.Geometry) -> None: ...
    def setVisibleInViewport(self, vp: hou.GeometryViewport) -> None: ...
    def updateTransformFromRay(self, viewer_ray: Ray) -> None: ...

class TransformHolder:
    ndc_to_world: hou.Matrix4
    world_to_ndc: hou.Matrix4
    def __init__(self) -> None: ...
    def updateViewportTransforms(self, vp: hou.GeometryViewport) -> None:
        """Update the cached view transforms. Should be called by onResume."""
    def worldToNdc(self, world: hou.Vector3) -> tuple[hou.Vector2, float, float]: ...
    def ndcToWorld(self, ndc: hou.Vector2, z: float, w: float) -> hou.Vector3: ...

class BrushOperation:
    """
    Containerized brush operation. Applied to each point independently.
    """
    EPSILON: float
    scale: hou.Vector2
    falloff_threshold: float
    strength: float
    def __init__(self, transform_holder: TransformHolder) -> None: ...
    def contains(self, point: hou.Point) -> bool: ...
    def apply(self, point: hou.Point) -> None: ...
    def setCenter(self, pos: hou.Vector2) -> None: ...

class PushOperation(BrushOperation):
    """Pushes points away from the brush center."""
    def apply(self, point: hou.Point) -> None: ...

class DragOperation(BrushOperation):
    """Drags points in the cursor's direction of motion."""
    def apply(self, point: hou.Point) -> None: ...

class SmoothOperation(BrushOperation):
    """He's a smooth operator..."""
    chord_offset: float
    def __init__(self, transform_holder: TransformHolder) -> None: ...
    def apply(self, point: hou.Point) -> None: ...
    def setChordAngle(self, angle: float) -> None: ...

class BlendBackOperation(BrushOperation):
    rest_geometry: hou.Geometry
    def __init__(self, transform_holder: TransformHolder) -> None: ...
    def apply(self, point: hou.Point) -> None: ...

class BrushKind(Enum):
    Push = 0
    Drag = 1
    Smooth = 2
    BlendBack = 3
    @staticmethod
    def fromToken(name: str) -> BrushKind | None: ...
    def token(self) -> str: ...
    def label(self) -> str: ...

def brushKindToMenuIndex(brush_kind: BrushKind) -> int: ...
def brushKindFromMenuIndex(index: int) -> BrushKind | None: ...

INITIAL_BRUSH_X: int
INITIAL_BRUSH_Y: int
INITIAL_BRUSH_RADIUS: int
INITIAL_BRUSH_FALLOFF_THRESHOLD: float
MIN_BRUSH_RADIUS: int
MAX_BRUSH_RADIUS: int

class Brush:
    """
    Point brush base class.

    A brush handles interaction, visualization, and operation application.
    """
    def __init__(self, kind: BrushKind, scene_viewer: hou.SceneViewer, operation: BrushOperation, shape: BrushShape) -> None: ...
    @property
    def vp(self) -> hou.GeometryViewport: ...
    def kind(self) -> BrushKind: ...
    def setActive(self) -> None: ...
    def show(self, on: bool) -> None: ...
    def reset(self) -> None: ...
    def startStroke(self, geo: hou.Geometry) -> None: ...
    def continueStroke(self, geo: hou.Geometry) -> None: ...
    def endStroke(self) -> None: ...
    def updateShape(self) -> None: ...
    def config(self) -> dict[str, float]: ...
    def loadConfig(self, config: Mapping[str, float] | apex.Dict) -> None: ...
    def x(self) -> float: ...
    def y(self) -> float: ...
    def setCenter(self, x: float, y: float) -> None: ...
    def radius(self) -> float: ...
    def setRadius(self, radius: float) -> None: ...
    def falloffThreshold(self) -> float: ...
    def setFalloffThreshold(self, falloff_threshold: float) -> None: ...
    def strength(self) -> float: ...
    def setStrength(self, strength: float) -> None: ...
    def refreshRadius(self) -> None: ...
    def _pixelRadiusToNdcScale(self, length: float) -> hou.Vector2: ...

class PushBrush(Brush):
    def __init__(self, scene_viewer: hou.SceneViewer, transform_holder: TransformHolder, shape: BrushShape) -> None: ...
    def reset(self) -> None: ...

class DragBrush(Brush):
    def __init__(self, scene_viewer: hou.SceneViewer, transform_holder: TransformHolder, shape: BrushShape) -> None: ...
    def reset(self) -> None: ...

class SmoothBrush(Brush):
    def __init__(self, scene_viewer: hou.SceneViewer, transform_holder: TransformHolder, shape: BrushShape) -> None: ...
    def reset(self) -> None: ...
    def updateShape(self) -> None: ...
    def config(self) -> dict[str, float]: ...
    def loadConfig(self, config: Mapping[str, float] | apex.Dict) -> None: ...
    def chordOffset(self) -> float: ...
    def setChordOffset(self, offset: float) -> None: ...
    def chordAngle(self) -> float: ...
    def setChordAngle(self, angle: float) -> None: ...

class BlendBackBrush(Brush):
    def __init__(self, scene_viewer: hou.SceneViewer, transform_holder: TransformHolder, shape: BrushShape) -> None: ...
    def setRestGeometry(self, rest_geo: hou.Geometry) -> None: ...
    def reset(self) -> None: ...

class BrushManager:
    def __init__(self, scene_viewer: hou.SceneViewer) -> None: ...
    @property
    def vp(self) -> hou.GeometryViewport: ...
    def isStrokeActive(self) -> bool:
        """
        Whether a stroke is currently active.

        A stroke is defined by a single continuous motion that is grouped as
        one undo action. E.g., a stroke should begin on mouse press and end on
        the next mouse release.
        """
    def onStartStroke(self, geo: hou.Geometry) -> None:
        """Start a new stroke."""
    def onContinueStroke(self, geo: hou.Geometry) -> dict[Never, Never] | None:
        """
        Within the current stroke, apply the active brush to all points in a
        geometry.
        """
    def onEndStroke(self) -> None:
        """End the current stroke."""
    def brush(self, kind: BrushKind) -> Brush:
        """Brush of the indicated kind."""
    def iterBrushes(self) -> Iterator[Brush]: ...
    def activeBrush(self) -> Brush:
        """The active brush."""
    def setActiveBrush(self, brush: BrushKind) -> None:
        """Set the active brush."""
    def showBrush(self, on: bool) -> None:
        """Display the current brush visualizer."""
    def setActiveBrushCenter(self, x: float, y: float) -> None:
        """Set the center of the brush in pixels."""
    def activeBrushRadius(self) -> float:
        """Retrieve the active brush's radius."""
    def setActiveBrushRadius(self, radius: float) -> None:
        """Set the radius of the brush in pixels."""
    def activeBrushFalloffThreshold(self) -> float:
        """Retrieve the active brush's falloff threshold."""
    def setActiveBrushFalloffThreshold(self, falloff_threshold: float) -> None:
        """Set the falloff threshold of the brush."""
    def activeBrushStrength(self) -> float:
        """Retrieve the active brush's strength."""
    def setActiveBrushStrength(self, strength: float) -> None:
        """Set the active brush's strength."""
    def setRestGeometry(self, geo: hou.Geometry) -> None:
        """Set the rest geometry."""
    def updateBrushShape(self, viewer_ray: Ray) -> None:
        """Update the shape of the brush from a given viewer ray."""
    def updateViewportTransforms(self) -> None:
        """Update the TransformHolder and relevant brush properties."""


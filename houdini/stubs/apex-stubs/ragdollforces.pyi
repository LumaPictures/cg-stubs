import _apex
_V = TypeVar('_V', bound=_apex._ValueArg)
class RagdollForcesType:
    WIND: str
    DRAG: str
    MAGNET: str
    TURBULENCE: str
    map: ClassVar[dict[str, int]]

@dataclass
class ForcesStateHolder:
    char_channels: apex.Dict
    parms: apex.Dict
    id: int
    selected_forces: list[str]

class RagdollForcesManager:
    """
    Class that stores forces dict and channels
    self.parms is a dictionnary that stores all the forces
    """
    parms: apex.Dict
    MAPPING_ATTR: str
    DEFAULT_NAME: str
    DEFAULT_SCREENSPACE_OFFSET: float
    last_id: int
    def __init__(self) -> None: ...
    def addForce(self, type: str) -> str: ...
    def updateParms(self, name: str, type: str, index: int) -> apex.Dict: ...
    def loadParms(self, parms: apex.Dict | dict[str, _V]) -> None: ...
    def empty(self) -> bool: ...
    def indices(self) -> list[int]: ...
    def forceLabel(self, name: str) -> str: ...
    def index(self, name: str) -> int: ...
    def forceFromIndex(self, idx: int) -> apex.Dict | dict[str, Never]: ...
    def forceNames(self) -> list[str]: ...
    def dragForcesCount(self) -> int: ...
    @property
    def path(self) -> str: ...
    @property
    def attrib_name(self) -> str: ...
    @property
    def influence_name(self) -> str: ...
    @staticmethod
    def getForceNameFromControl(control: str) -> str: ...
    @staticmethod
    def forceIsDrag(force_type: str) -> bool: ...
    @staticmethod
    def findOrCreateMappingAttrib(geo: hou.Geometry) -> hou.Attrib: ...
    def createInfluenceChannel(self, channel_prims: hou.Geometry, name: str, idx: int) -> hou.ChannelPrim: ...
    def findInfluenceChannel(self, channel_prims: hou.Geometry, force: str, joint_name: str) -> bool: ...
    def removeInfluenceChannels(self, channel_prims: hou.Geometry, forces: Iterable[str]) -> hou.Geometry: ...

class RagdollForcesRigBuilder:
    _component: apex.Graph | None
    def __init__(self, do_compile: bool = True) -> None: ...
    def compile(self) -> None: ...
    def isCompiled(self) -> bool: ...
    def build(self, graph: apex.Graph, name: str, type: str, force_id: int, force_label: str, screenspace_offset: float) -> apex.Graph: ...
    def clear(self, graph: apex.Graph) -> apex.Graph: ...

class RagdollAnimStackGetter:
    drawables: list[apexscene.SceneOutputDrawable]
    KEY: str
    _tool: weakref.ref[RagdollTool]
    dirty: bool
    def __init__(self, tool: RagdollTool) -> None: ...
    @property
    def tool(self) -> RagdollTool | None: ...
    def setActive(self) -> None: ...
    def setDirty(self) -> None: ...
    def __call__(self, time: float, **kwargs: object) -> None: ...

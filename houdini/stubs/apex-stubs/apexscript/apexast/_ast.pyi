import ast
from . import utils as utils
from .. import types as types

class AST:
    def apexName(self) -> str: ...
    def setApexName(self, apex_name: str): ...
    def apexType(self) -> str: ...
    def setApexType(self, apex_type: str): ...
    def apexTypeHint(self) -> str: ...
    def setApexTypeHint(self, type_hint: str): ...
    def apexValue(self) -> None: ...
    def setApexValue(self, apex_value) -> None: ...
    @classmethod
    def ApexNode(cls, ast_node: ast.AST): ...
    @classmethod
    def __init_subclass__(cls, ast_class, **kwargs) -> None: ...
    def __init__(self, node: ast.AST) -> None: ...
    def __getattr__(self, attr_name: str): ...
    def node(self) -> ast.AST: ...
    def resolveType(self, **kwargs) -> None:
        """Resolves the apex type and apex value associated with the node.

        If the node has a type hint, it is checked against the resolved type to
        verify that the resolved type matches the type hint. If the resolved
        type is ambiguous, the type hint may be used to disambiguate the
        resolved type.

        An apex value is assigned to the node when the node represents a
        literal (or is a compound type constructed of all literals).

        Note: ALL child nodes must be visited before calling resolveType().
              This ensures all dependent types and values are available during
              the type resolution process.
        """
    def resolveName(self, **kwargs) -> None:
        """Resolves the apex name associated with an identifier node."""

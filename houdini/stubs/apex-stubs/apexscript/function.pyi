import abc
import apex
from . import types as types
from _typeshed import Incomplete

class Function:
    def __init__(self, name, signature, defaults: Incomplete | None = None, resolver: Incomplete | None = None) -> None: ...
    def name(self): ...
    def signature(self): ...
    def defaults(self): ...
    def resolver(self): ...
    def inplace(self): ...

class RegisteredFunction(Function):
    def __init__(self, name, version: str = '', registry=...) -> None: ...
    def registry(self): ...

class BuiltinArg:
    argname: Incomplete
    portname: Incomplete
    default: Incomplete
    def __init__(self, argname, portname: str = '', default: Incomplete | None = None) -> None: ...

class BuiltinFunction(Function):
    def __init__(self, object_type, name, function, input_args: Incomplete | None = None, output_args: Incomplete | None = None) -> None: ...
    def object_type(self): ...
    def inplace(self): ...

class UserDefinedFunction:
    def __init__(self) -> None: ...

class Resolver(abc.ABC, metaclass=abc.ABCMeta):
    @abc.abstractmethod
    def __init__(self): ...
    def __bool__(self) -> bool: ...
    def oldName(self) -> str: ...
    def newName(self) -> str: ...
    def oldSignature(self) -> apex.Signature: ...
    def newSignature(self) -> apex.Signature: ...
    def numInputs(self) -> int: ...
    def numOutputs(self) -> int: ...
    def inputIndex(self, index_or_name: int | str) -> int: ...
    def outputIndex(self, index_or_name: int | str) -> int: ...
    def inputName(self, index_or_name: int | str) -> str: ...
    def outputName(self, index_or_name: int | str) -> str: ...
    def isValid(self): ...

class BuiltinResolver(Resolver):
    def __init__(self, object_type, name, function, input_args: Incomplete | None = None, output_args: Incomplete | None = None) -> None: ...

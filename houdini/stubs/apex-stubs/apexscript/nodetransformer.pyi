import apex
import ast
from . import apexast as apexast, builtins as builtins, callutils as callutils, scope as scope, specials as specials, types as types
from _typeshed import Incomplete

class ApexNodeTransformer(ast.NodeTransformer):
    MAIN_SCOPE: str
    graph: Incomplete
    registry: Incomplete
    scope_data: Incomplete
    scope_stack: Incomplete
    def __init__(self, graph: Incomplete | None = None, registry: apex.Registry | None = None, houdini_version: str = '') -> None: ...
    def getHoudiniVersion(self) -> str:
        """Returns the value of the houdini version in the current scope."""
    def setHoudiniVersion(self, houdini_version: str):
        """Sets the houdini version for the current scope."""
    def currentScope(self) -> scope.Scope: ...
    def scope(self, scope_name: str) -> scope.Scope: ...
    def pushScope(self, scope_name: str): ...
    def popScope(self) -> None: ...
    def annotateIdentifier(self, apex_name: str, apex_type: str):
        """Records the identifier's type (but does NOT imply assignment)."""
    def assignIdentifier(self, apex_name: str, apex_type: str):
        """Records the assignment of an identifier."""
    def identifierAssigned(self, apex_name: str) -> bool:
        """Checks if the identifier has been assigned (not just annotated)."""
    def identifierType(self, apex_name: str) -> str:
        """Returns the identifier's type from an annotation or assigment."""
    def visit_Constant(self, node: ast.Constant): ...
    def visit_Tuple(self, node: ast.Tuple): ...
    def visit_List(self, node: ast.List): ...
    def visit_Dict(self, node: ast.Dict): ...
    def visit_JoinedStr(self, node: ast.JoinedStr): ...
    def visit_Name(self, node: ast.Name): ...
    def visit_Attribute(self, node: ast.Attribute): ...
    def visit_Subscript(self, node: ast.Subscript): ...
    def visit_Call(self, node: ast.Call): ...
    def visit_Assign(self, node: ast.Assign): ...
    def visit_AnnAssign(self, node: ast.AnnAssign): ...

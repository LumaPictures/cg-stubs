class _RigConfig(_SelectJointsRigConfig, total=False):
    """A rig's entry of the `config` apexmirror.startMirrorTool() starts the tool with."""
    controls: Required[list[str]]
    use_mirror_point_rots: bool
    mirror_axis: hou.Vector3

TOOL_PATH: str
MIRROR_RIG_PATH: str
MIRRORTOOL_ANIM_LAYER_NAME: str
CFG_MIRROR_TO_OPPOSITE: Final[str]
CFG_CURRENT_COMPONENTS: Final[str]
CFG_FLIP_AXES_MODE: Final[str]
CFG_RIG_MIRROR_PLANE: Final[str]
CFG_PLANE_FOLLOW_JOINT: Final[str]
CFG_SHOW_PLANE_INTERSECTION: Final[str]
CFG_LIVE_PREVIEW: Final[str]
CFG_LIVE_PREVIEW_OUTLINE: Final[str]
EVALUATION_PARMS: dict[str, _HUDParmTemplate]


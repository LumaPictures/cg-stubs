class MirrorTool(SelectJointsTool[_AnimateState, RigMirrorData, _RigConfig]):
    settings_widget: MirrorToolSettingsHudWidget | None
    flip_axes_mode: FlipAxesMode
    show_plane_intersection: PlaneIntersect | None
    rig_mirror_normal_override: MirrorPlane | None
    mirror_ctrl_paths: list[str]
    selectable_ctrls: list[str]
    mirror_components: str
    selection_mode: SelectControlsMode
    mirror_to_opposite: bool
    plane_follow_joint: bool
    has_singular_ctrls: bool
    posing: bool
    disable_outline_overlay: bool
    live_preview: bool
    loaded: bool
    def __init__(self, viewer_state: _AnimateState) -> None: ...
    @property
    def mirror_rig(self) -> apex.SceneGraph | None: ...
    def createRigData(self) -> RigMirrorData: ...
    def onActivate(self, kwargs: _SelectJointsActivateKwargs[_RigConfig]) -> None: ...
    def afterLoadFromConfig(self) -> None:
        """
        Only create mirrorer after  the config is loaded!
        This is very important, since the config will set certain values,
        (such as the components, live preview etc.) and each of these things
        could trigger a mirror.
        So if the mirrorer is already created when loading the config, we could
        be doing 3 or 4 extra mirrors which slow the startup time. 
        """
    def onConfirmation(self) -> None: ...
    def onDeactivate(self) -> None: ...
    def loadMirrorToolData(self) -> None: ...
    def saveMirrorToolData(self) -> None: ...
    def showIntersectionDrawable(self) -> bool: ...
    def loadIntersectionDrawable(self, scene_viewer: hou.SceneViewer, rig_path: str) -> hou.GeometryDrawable: ...
    def updateIntersectionDrawable(self, rig_path: str, rig_data: RigMirrorData, preview_transform: hou.Matrix4) -> None: ...
    def loadIntersectionDrawables(self) -> None: ...
    def updatePreviewDrawableVisibility(self) -> None: ...
    def setComponents(self, components: str) -> None: ...
    def setFlipAxesMode(self, flip_axes: FlipAxesMode) -> None: ...
    def setMirrorToOpposite(self, value: bool) -> None: ...
    def setPlaneFollowJoint(self, value: bool) -> None: ...
    def setShowPlaneIntersection(self, show: PlaneIntersect | None) -> None: ...
    def setLivePreview(self, value: bool) -> None: ...
    def setOverlayPreview(self, value: bool) -> None: ...
    @property
    def overlay(self) -> bool: ...
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def getSelectedJointXform(self, selected_joint: hou.Point | None) -> hou.Matrix4: ...
    def onJointSelectionChanged(self) -> None: ...
    def setMirrorAxis(self, plane: MirrorPlane | None) -> None: ...
    def updateMirrorXform(self, reset_local: bool = False) -> None: ...
    def muteAnimBindings(self) -> None: ...
    def unmuteAnimBindings(self) -> None: ...
    def onPreEvaluationEvent(self, kwargs: float) -> None: ...
    def onPostEvaluationEvent(self, kwargs: float) -> None: ...
    def mirrorPose(self, frame: float) -> None: ...
    def previewMirror(self) -> None: ...
    def onPoseStartEvent(self, kwargs: ViewerStateEventKwargs | _HandleStartUpdateKwargs) -> bool: ...
    def onPoseEndEvent(self, kwargs: ViewerStateEventKwargs | _HandleUpdateKwargs) -> bool: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def drawExtraDrawables(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    def onPreSelectionSetsSelectControls(self, kwargs: ViewerStateCommandKwargs, ctrls: Iterable[str]) -> None: ...

def load(viewer_state: _AnimateState) -> MirrorTool: ...

import PySide6.QtCore
import PySide6.QtGui
import PySide6.QtWidgets
import apex
import hou
from collections.abc import KeysView, Sequence
from hutil.PySide import QtCore, QtWidgets

class CallbackFilterProxyModel(QtCore.QSortFilterProxyModel):
    def __init__(self, parent: PySide6.QtCore.QObject | None = None) -> None: ...
    def filterAcceptsRow(self, source_row: int, source_parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...

class CallbackModel(QtCore.QAbstractListModel):
    nested: list[list[str | bool]]
    lookup: dict[str, list[int]]
    verbs: KeysView[str]
    def __init__(self, parent: PySide6.QtCore.QObject | None = None) -> None: ...
    def update(self, definitions: Sequence[str]) -> None: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int) -> list[str | bool] | None: ...

class CallbackDelegateList(QtWidgets.QStyledItemDelegate):
    callback_clicked: PySide6.QtCore.Signal
    def __init__(self, parent: PySide6.QtCore.QObject | None = None) -> None: ...
    def sizeHint(self, option: PySide6.QtWidgets.QStyleOptionViewItem, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.QSize: ...
    def editorEvent(self, event: PySide6.QtCore.QEvent, model: PySide6.QtCore.QAbstractItemModel, option: PySide6.QtWidgets.QStyleOptionViewItem, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...
    def paint(self, painter: PySide6.QtGui.QPainter, option: PySide6.QtWidgets.QStyleOptionViewItem, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> None: ...

class CallbackPanel(QtWidgets.QWidget):
    node: hou.OpNode | None
    view: PySide6.QtWidgets.QListView
    proxymodel: CallbackFilterProxyModel
    listdelegate: CallbackDelegateList
    model: CallbackModel
    filter: PySide6.QtWidgets.QLineEdit
    registry: apex.Registry
    layout: PySide6.QtWidgets.QVBoxLayout
    columns: int
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def doFilter(self, val: str) -> None: ...
    def updateRegistry(self) -> None: ...

class CallbackPopup(QtWidgets.QWidget):
    node: hou.OpNode | None
    view: PySide6.QtWidgets.QListView
    proxymodel: CallbackFilterProxyModel
    listdelegate: CallbackDelegateList
    model: CallbackModel
    filter: PySide6.QtWidgets.QLineEdit
    registry: apex.Registry
    layout: PySide6.QtWidgets.QVBoxLayout
    columns: int
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def hide(self) -> None: ...
    def keyPressEvent(self, event: PySide6.QtGui.QKeyEvent) -> bool | None: ...
    def doFilter(self, val: str) -> None: ...
    def updateRegistry(self) -> None: ...
    def createNode(self, callback_name: str) -> str | None: ...

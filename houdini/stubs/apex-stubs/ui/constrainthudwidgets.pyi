CONTROL_SHAPE_MENU: tuple[str, str, str, str, str]
CONTROL_SHAPE_PARMS: dict[str, ws._HUDParmTemplate]

class ControlGroup:
    name: str
    allow_many: bool
    sets: dict[str, list[str]]
    def __init__(self, name: str, allow_many: bool) -> None: ...
    def __setitem__(self, key: str, value: list[str]) -> None: ...
    def __getitem__(self, key: str) -> list[str]: ...
    def __len__(self) -> int: ...
    def items(self) -> ItemsView[str, list[str]]: ...
    def keys(self) -> KeysView[str]: ...
    def values(self) -> ValuesView[list[str]]: ...
    def allowsMany(self) -> bool: ...
    def getLabel(self, set_name: str) -> str: ...
    def addSet(self, set_name: str) -> None: ...
    def clearControls(self) -> None: ...
    def setControls(self, ctrls: str | Sequence[str], start_idx: int = 0) -> int: ...
    def controlsAsDict(self) -> dict[str, list[str]] | dict[str, str]: ...
    def getFirstControl(self) -> str | None: ...
    def validateSelection(self) -> bool: ...

class ConstraintConfig:
    is_valid: bool
    constraint_type: apex.ConstraintType | None
    graph: apex.Graph | None
    name: str
    driven_ctrls: Sequence[str]
    first_driver: str
    driver_groups: dict[str, ControlGroup]
    num_drivers: int
    allow_many_drivers: bool
    single_driver: bool
    DEFAULT_GROUP: str
    def __init__(self, scene: apex.Scene | None = None, graph_path: str | None = None) -> None: ...
    def reset(self) -> None: ...
    def freeze(self) -> ConstraintConfig: ...
    def animatedParms(self) -> list[str]: ...
    def isValid(self) -> bool: ...
    def allowsManyDriven(self) -> bool: ...
    def getDrivenLabel(self) -> str: ...
    def getDriverLabel(self, driver_name: str) -> str: ...
    def setDrivenControls(self, driven_ctrls: Sequence[str]) -> None: ...
    def setDriverControlsFromDict(self, driver_dict: _ControlDict) -> None: ...
    def setDriverControlGroup(self, driver_ctrls: str | Sequence[str], group: str) -> None: ...
    def setControlsFromList(self, ctrl_paths: Sequence[str]) -> None: ...
    def drivenControls(self) -> Sequence[str]: ...
    def driverDict(self) -> dict[str, str | list[str]]: ...
    def clearDrivers(self) -> None: ...
    def clearDriven(self) -> None: ...
    def clearControls(self) -> None: ...
    def updateMapping(self, collection: MappingCollection) -> None: ...
    def validateSelection(self) -> bool: ...

CONSTRAINT_MODE_DENSE: str
CONSTRAINT_MODE_UPDATE: str
CONSTRAINT_DISABLE_AFTER_BAKE: str
UPDATE_CONSTRAINT_VISUALIZER: str
UPDATE_CONSTRAINT_BOOKMARKS: str
CONSTRAINT_BAKE_MODE: str
CONSTRAINT_AFTER_BUTTON: str
CONSTRAINT_BEFORE_BUTTON: str
CONSTRAINT_LAYER_TOGGLE: str
COMMON_CONSTRAINT_SETTINGS: dict[str, ws._HUDParmTemplate]
TRANSIENT_CONSTRAINT_SETTINGS: dict[str, ws._HUDParmTemplate]

class ConstraintSettingsWidget(apexhud.ParameterWidget[_AnimateState, WidgetBundleWindow]):
    """
    Menu for general constraint settings
    """
    hud_window: WidgetBundleWindow
    common_parm_set: ws.ParmWidgetSet
    transient_parm_set: ws.ParmWidgetSet
    constraint_copy_paste: apexhud.ToolbarWidget
    DEFAULT_SIZE: int
    DEFAULT_WIDTH: int
    TRANSIENT_FOLDER_NAME: str
    TRANSIENT_FOLDER_LABEL: str
    def __init__(self, tool: ConstraintTool, hud_window: WidgetBundleWindow | None = None, tab_widget_name: str | None = None, tab_name: str | None = None) -> None: ...
    @property
    def tool(self) -> ConstraintTool | None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def initHud(self) -> None: ...
    def loadFromConfig(self, config: AbstractConfig, **kwargs: object) -> None:
        """ Load from userdata on entering tool. """
    def saveToConfig(self, config: AbstractConfig, **kwargs: object) -> None:
        """ Save to userdata on exiting tool. """
    def onParmChanged(self, name: str) -> None: ...
    def onCopyBookmarks(self) -> None: ...
    def onPasteBookmarks(self) -> None: ...
    def onConstraintOffsetAfter(self) -> None: ...
    def onConstraintOffsetBefore(self) -> None: ...
    def getDisableConstraintAfterBake(self) -> _HUDParmValue: ...

class ConstraintParmWidget(apexhud.ParameterWidget[_AnimateState, WidgetBundleWindow]):
    """
    Menu for constraint parameters related to the currently selected control.
    """
    hud_window: WidgetBundleWindow
    focused_constraints: list[str]
    pinned_constraint: str | None
    constraint_type: str | None
    constraint_items: list[str]
    constraint_type_paths: list[str]
    constraint_config: ConstraintConfig
    options_set: ws.ParmWidgetSet
    options: int
    constraint_ctrl_set: ws.ParmWidgetSet
    constraint_parm_set: ws.ParmWidgetSet
    control_shape_parm_set: ws.ParmWidgetSet
    blend_options_set: ws.ParmWidgetSet
    blend_options: int
    blend_parm_set: ws.ParmWidgetSet
    blend_ctrl_path: str | None
    pinned_blend_control: str | None
    blend_constraint_paths: dict[str, str]
    TAB_WIDGET_NAME: str
    PARMS_TAB_NAME: str
    PARMS_TAB_LABEL: str
    BLEND_TAB_NAME: str
    BLEND_TAB_LABEL: str
    CONTROL_TAB_NAME: str
    CONTROL_TAB_LABEL: str
    DEFAULT_WIDTH: int
    LABEL_WIDTH: int
    MOUSE_OFFSET: int
    FIELD_WIDTH: int
    def __init__(self, tool: ConstraintTool, hud_window: WidgetBundleWindow | None = None, tab_widget_name: str | None = None, tab_name: str | None = None) -> None: ...
    @property
    def tool(self) -> ConstraintTool | None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: object) -> None:
        """ Load from userdata on entering tool. """
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: object) -> None:
        """ Save to userdata on exiting tool. """
    def constraint(self) -> apex.Constraint | None: ...
    def focusedConstraintPaths(self) -> list[str]: ...
    def animatedParms(self) -> list[str]: ...
    def setFocusedConstraints(self, constraint_paths: Iterable[str], ctrl_paths: Sequence[str], constrainable_ctrl_paths: Sequence[str]) -> None: ...
    def onConstraintOptionChangedEvent(self, name: str) -> None: ...
    def onConstraintParmChangedEvent(self, name: str) -> None: ...
    def onSliderStartEvent(self, name: str) -> None: ...
    def onSliderEndEvent(self, name: str) -> None: ...
    def onHotkeyEvent(self, name: str, hk: str | None = None) -> None:
        """
        these are the hotkeys defined in the animate state like
        shift+click ...
        hk are 
        - del_key_all
        - key_all
        - key
        - del_key    
        """
    def onShapeParmChangedEvent(self, name: str) -> None: ...
    def onShapeSliderStartEvent(self, name: str) -> None: ...
    def onShapeSliderEndEvent(self, name: str) -> None: ...
    def onConstraintTypeCallback(self, value: int) -> None: ...
    def getConstraintTypePath(self) -> str | None: ...
    def getConstraintName(self) -> str | None: ...
    def onConstraintLabelCallback(self, label: list[str]) -> None: ...
    def getConstraintParms(self, menus_as_int: bool = True) -> dict[str, _HUDParmValue]: ...
    def setConstraintParms(self, parms: Mapping[str, object] | apex.Dict) -> None: ...
    def contextMenuCallback(self, action: str, slider_names: Sequence[str]) -> bool:
        """
        Callback for a context menu action on the given slider.
        """
    def updateAnimatedParms(self, skip_scene: bool = False) -> None: ...
    def blendControlPath(self) -> str | None: ...
    def blendConstraintPaths(self) -> list[str]: ...
    def updateBlendTab(self) -> None: ...
    def onConstraintBlendChangedEvent(self, name: str) -> None: ...
    def onBlendSliderStartEvent(self, name: str) -> None: ...
    def onBlendSliderEndEvent(self, name: str) -> None: ...
    def onBlendHotkeyEvent(self, name: str, hk: str | None = None) -> None:
        """
        these are the hotkeys defined in the animate state like
        shift+click ...
        hk are 
        - del_key_all
        - key_all
        - key
        - del_key    
        """
    def onBlendActionButtonEvent(self, name: str) -> None: ...
    def updateConstraintLabels(self) -> None:
        """
        Update all instances of constraint labels in the parameter HUD
        without reseting the parameters.
        """
    def blendWithBookmarks(self) -> bool: ...
    def blendWithRetime(self) -> int: ...
    def updateBlendOptions(self) -> None: ...
    def onBlendOptionChangedEvent(self, name: str) -> None: ...

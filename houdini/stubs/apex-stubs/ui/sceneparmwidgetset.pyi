import apex
from apex.secondarymotiontool import _ParmWidgetSetKwargs
from statehud.parmwidgetset import ParmWidgetSet
from typing import Unpack

class ChannelSourceBase:
    """
    A base class to be used for associating scene channel sources
    with state hud parameters.
    """
    path: str
    parm_map: dict[str, str]
    def __init__(self, path: str) -> None: ...
    def parmMap(self) -> dict[str, str]: ...
    def parmNames(self) -> list[str]: ...
    def channelNames(self) -> list[str]: ...
    def clear(self) -> None: ...
    def addParms(self, parm_map: dict[str, str]) -> None: ...
    def updateParms(self, parm_widget_set: ParmWidgetSet, scene: apex.Scene, frame: float | None = None) -> None: ...

class ChannelRigSource(ChannelSourceBase):
    """
    A class for associating rig channels with state hud parameters
    """
    layer: str | None
    def __init__(self, path: str, layer: str | None = None) -> None: ...
    def updateParms(self, parm_widget_set: ParmWidgetSet, scene: apex.Scene, frame: float | None = None) -> None: ...

class ChannelGeoSource(ChannelSourceBase):
    """
    A class for associating channel geometry primitives with state
    hud parameters
    """
    def __init__(self, path: str) -> None: ...
    def updateParms(self, parm_widget_set: ParmWidgetSet, scene: apex.Scene, frame: float | None = None) -> None: ...

class SceneParmWidgetSet(ParmWidgetSet):
    """
    An extension of the statehud.parmwidgetset.ParmWidgetSet class for
    associating scene channel data with parameters.
    """
    channel_sources: dict[str, ChannelSourceBase]
    def __init__(self, scene: apex.Scene, *args: *tuple[()], **kwargs: Unpack[_ParmWidgetSetKwargs]) -> None: ...
    @property
    def scene(self) -> apex.Scene | None: ...
    def clearChannelSources(self) -> None: ...
    def removeChannelSource(self, path: str) -> None: ...
    def addChannelSource(self, source: ChannelSourceBase) -> None: ...
    def addChannelMap(self, path: str, parm_map: dict[str, str]) -> None: ...
    def updateAnimatedParms(self, frame: float | None = None) -> None: ...

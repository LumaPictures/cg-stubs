class _InitWindowKwargs(TypedDict, total=False):
    """ChannelWidgetHandler.initWindow()'s keyword arguments."""
    width: int
    callback: Callable[[_ParmEventDict], object] | None

SPLIT_MODE_KEY: str
SPLITTER_SIZES_KEY: str
VERTICAL_TABS_KEY: str
SPLIT_MINIMIZED_KEY: str
SPLIT_COLLAPSED_KEY: str
SELECTION_TAB_INDEX: int
LAYERS_TAB_INDEX: int
SETTINGS_TAB_INDEX: int
_USE_NEW_UI: bool

class CollapseManager(QtCore.QObject):
    """Manages collapsing the split HUD to show only tab bars.
    Collapse is triggered by the minimize button (via override hook).
    Clicking any tab on either bar expands back."""
    def __init__(self, top_tab_widget: rui.TabWidget, bottom_tab_widget: rui.TabWidget, hud_window: shud.WidgetBundleWindow, splitter: QSplitter | None = None) -> None: ...
    def isCollapsed(self) -> bool: ...
    def collapse(self) -> None: ...
    def expand(self) -> None: ...
    def eventFilter(self, obj: QObject, event: QEvent) -> bool:
        """Only handles expand-on-tab-click. Collapse is triggered
        externally via the minimize button."""

class BottomTabPanel(QtWidgets.QWidget):
    """
    Bottom half of the split pane. Contains vertical tabs:
    - Selection Sets: embedded SelectionSetHUDWidget (shared model)
    - Settings: reparented settings tab widget from AnimateSettingsWidget
    """
    def __init__(self, scene_viewer: hou.SceneViewer, sel_model: SelectionManagerModelHandle, sel_panel_delegate: SelectionSetHUDPanel | None, settings_widget: AnimateSettingsWidget | None = None, use_vertical_tabs: bool = False) -> None: ...
    @typing.overload
    def getSelectedSets(self, controls_in_tree_format: Literal[True] = ...) -> dict[str, _SelectedSetTree]: ...
    @typing.overload
    def getSelectedSets(self, controls_in_tree_format: Literal[False]) -> dict[str, _SelectedSetList]: ...
    @typing.overload
    def getSelectedSets(self, controls_in_tree_format: bool = ...) -> dict[str, _SelectedSetTree] | dict[str, _SelectedSetList]: ...
    def embedSettings(self, settings_widget: AnimateSettingsWidget | None) -> None:
        """Reparent the settings widget's internal TOOL_TAB_WIDGET into
        the Settings tab of this panel."""
    def unembedSettings(self, settings_widget: AnimateSettingsWidget | None) -> None:
        """Restore the settings widget's internal tab widget back to its
        standalone WidgetBundleWindow."""
    def addTab(self, widget: QWidget, label: str) -> int:
        """Add a tab to the bottom panel. Returns the tab index."""
    def removeTab(self, index: int) -> None:
        """Remove a tab from the bottom panel by index."""
    def setCurrentTab(self, index: int) -> None:
        """Set the active tab by index."""
    def filterCurrentSelection(self) -> None:
        """Filter the embedded tree to the current selection."""
    def setVisualSize(self, visual_size: int) -> None:
        """Sync font sizes with the HUD visual size for all child widgets."""

class SplitChannelWidgetHandler:
    """
    Drop-in wrapper for ChannelWidgetHandler that supports an optional
    horizontal split pane with Selection Sets and Settings tabs in the
    bottom half.

    All public API is delegated to the inner ChannelWidgetHandler so that
    apexanimate.py needs no changes beyond the constructor call.
    """
    def __init__(self, state: _AnimateState, scene_viewer: hou.SceneViewer, callback: Callable[[_ParmEventDict], object] | None = None, sel_model: SelectionManagerModelHandle | None = None, settings_widget: AnimateSettingsWidget | None = None, sel_panel_delegate: SelectionSetHUDPanel | None = None, use_vertical_tabs: bool = False, config_split_default: bool = True) -> None: ...
    @property
    def bottom_panel(self) -> BottomTabPanel | None: ...
    @property
    def hud_window(self) -> shud.WidgetBundleWindow: ...
    @property
    def widgethotkey(self) -> str | None: ...
    @widgethotkey.setter
    def widgethotkey(self, val: str) -> None: ...
    @property
    def active_sliders(self) -> list[cu.ControlChannelWidget]: ...
    @property
    def active_tool_huds(self) -> list[_ToolHud]: ...
    @property
    def channel_parm_widget(self) -> cu.ControlChannelWidget: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def is_visible(self) -> bool: ...
    @is_visible.setter
    def is_visible(self, val: bool) -> None: ...
    @typing.overload
    def initWindow(self, *args: Unpack[tuple[int, Callable[[_ParmEventDict], object] | None]]) -> None: ...
    @typing.overload
    def initWindow(self, *args: int, **kwargs: Unpack[_InitWindowKwargs]) -> None: ...
    def initSliders(self) -> None: ...
    def bindHud(self, hud_widget: _ToolHud) -> None: ...
    def unbindHud(self, hud_widget: _ToolHud) -> None: ...
    def resetToolTabLabel(self) -> None: ...
    def setTitleFromCurrentTab(self) -> None: ...
    def onSelectionChanged(self) -> None: ...
    def handleSettingsHotkey(self, kwargs: ViewerStateEventKwargs) -> bool:
        """Handle settings hotkey when split mode is active.
        Ensures the panel is visible, expanded, and the Settings tab
        is active in the bottom panel. Returns True if handled."""
    def handleSelectionHotkey(self, kwargs: ViewerStateEventKwargs, hotkey: str | None) -> bool:
        """Handle selection sets hotkey when split mode is active.
        Ensures the panel is visible, expanded, and the Selection tab
        is active in the bottom panel. Returns True if handled."""
    def handleChannelHotkey(self, kwargs: ViewerStateEventKwargs) -> bool:
        '''Handle channel panel hotkey (G) when split mode is active.
        Toggles minimize/maximize. For vertical tabs, "minimize" is the
        tab-only collapse; for horizontal tabs, "minimize" is split-minimize.
        Returns True if handled.'''
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> bool: ...
    def onPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> bool: ...
    def onParmChangedEvent(self, kwargs: Mapping[str, object]) -> bool: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def contextMenuCallback(self, action: str, slider_names: list[str]) -> None: ...
    def isVisible(self) -> bool: ...
    def hideWindows(self) -> None: ...
    def show(self, on: bool = True) -> None: ...
    def activeWidget(self) -> cu.ControlChannelWidget | None: ...
    def activateWindow(self, title: str = 'Control Parms') -> None: ...
    def setActiveSliders(self) -> None: ...
    def currentTabChangedCallback(self, index: int) -> None: ...
    def addSplitModeCallback(self, callback: Callable[[bool], object]) -> None:
        """Register a callback(enabled:bool) called when split mode changes."""
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def isSplitMode(self) -> bool: ...
    def toggleSplitMode(self) -> None: ...
    def setSplitMode(self, on: bool) -> None: ...
    def loadFromConfig(self, config: HUDConfig) -> None: ...
    def saveToConfig(self, config: HUDConfig) -> None: ...

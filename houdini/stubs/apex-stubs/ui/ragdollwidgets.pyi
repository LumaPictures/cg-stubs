class RagdollBaseSliderWidget:
    """
    Base Slider Widget for Ragdoll and Ragdoll Posing    
    """
    tab_widget_name: str | None
    tab_name: str | None
    hud_window: shud.WidgetBundleWindow
    toolbars: dict[str, ToolbarWidget]
    JOINT_PHYSICAL_DEFAULTS: dict[str, float]
    JOINT_SLIDER_DEFAULTS: dict[str, float]
    BACKGROUND_COLOR_KEY: ClassVar[dict[int, KeyState | None]]
    JOINT_MATCHWORLD_ATTRIB_DEFAULTS: ClassVar[dict[str, float]]
    CHARACTER_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    JOINT_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    DEBUG_TOGGLE_DEFAULTS: ClassVar[dict[str, bool]]
    def __init__(self) -> None: ...
    @property
    def tool(self) -> RagdollStateBase | None: ...
    def onValueCallback(self, name: str) -> Callable[[str], None]: ...
    @property
    def widgethotkey(self) -> str | None: ...
    @widgethotkey.setter
    def widgethotkey(self, val: str) -> None: ...
    def onExit(self) -> None: ...
    def loadFromConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def saveToConfig(self, hud_config: AbstractConfig, **kwargs: object) -> None: ...
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> bool: ...
    def onStaticSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def onStaticSliderValueChange(self, slider_name: str, v: float) -> None: ...
    def onSliderValueChangeCallback(self, slider_name: str) -> Callable[[float], None]: ...
    def resetColor(self, name: str) -> None:
        """Resets a slider or toggle to its default background color """
    def updateSlidersFromChannelPrimsGeo(self, channel_prims_geo: hou.Geometry, joint_name: str, onlyAnimated: bool = False) -> None: ...
    def resetSlider(self, name: str) -> None: ...
    def isVisible(self) -> bool: ...
    def hideWindow(self) -> None: ...
    def getDisplayedTab(self) -> str:
        """Return the currently active ragdoll section name.
        With folders, returns the first expanded folder or the first one."""
    def _updateSlider(self, name: str, val: float) -> None: ...
    def _getToggleState(self, name: str) -> bool: ...
    def show(self, on: bool = True) -> None: ...
    def enableAll(self) -> None: ...
    def disableAll(self) -> None: ...
    def revertBaseParmsToDefault(self) -> None: ...
    def resetValues(self, cur_tab: str | None = None) -> None: ...
    def keyAll(self, cur_tab: str | None = None) -> None: ...
    def copyValues(self, cur_tab: str | None = None) -> None: ...
    def pasteValues(self, cur_tab: str | None = None) -> None: ...
    def setTitle(self, title: str | None) -> None: ...
    def revertToDefaults(self) -> None: ...
    def onCustomDisable(self) -> None: ...
    def setTabLabel(self) -> None: ...
    def onSliderValueChange(self, slider_name: str, v: float, key: bool = False, del_keys: bool = False, single: bool = False) -> None:
        """
        RagdollSliderWidget must override to deal with constraints..    
        """
    def valueAction(self, name: str, hk: str | None = None) -> None:
        """
        these are the hotkeys defined in the animate state like
        shift+click ...
        hk are 
        - del_key_all
        - key_all
        - key
        - del_key
        This should be overriden by Ragdoll Posing    
        """


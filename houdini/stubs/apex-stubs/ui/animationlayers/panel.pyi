import hou
from .commands import retrieveMembershipModel as retrieveMembershipModel, retrieveModel as retrieveModel, setActiveClip as setActiveClip
from .membership import AnimationLayerMembershipModel as AnimationLayerMembershipModel, AnimationLayerMembershipView as AnimationLayerMembershipView
from .model import AnimationLayersModel as AnimationLayersModel, AnimationLayersModelHandle as AnimationLayersModelHandle, Column as Column, LayerType as LayerType
from .utils import createModel as createModel
from .view import AnimationLayersView as AnimationLayersView
from PySide6 import QtGui as QtGui
from hutil.PySide import QtCore, QtWidgets
from typing import Literal

class ShrinkableComboBox(QtWidgets.QComboBox):
    """A QComboBox that sizes to its contents but can shrink smaller."""
    def minimumSizeHint(self) -> QtCore.QSize: ...

class ToolButton(QtWidgets.QToolButton):
    """
    A Tool button, used for the New Layer button etc.
    """
    def __init__(self, *args: QtWidgets.QWidget | None, icon: QtGui.QIcon | None = None, tooltip: str | None = None) -> None: ...

class AnimationLayersPanel(QtWidgets.QFrame):
    """The main panel used for Animation Layers."""
    CONFIG_PREFIX: str
    LAYER_TYPE_PREF: str
    SHOW_WEIGHT_SLIDERS_PREF: str
    COLUMN_PREF_NAMES: dict[Column, str]
    _model_handle: AnimationLayersModelHandle | None
    def __init__(self, *args: QtWidgets.QWidget | None, background_color: QtGui.QColor | None = None, show_help_button: bool = True, config_prefix: str | None = None, show_weight_sliders_default: bool = True) -> None: ...
    def setBackgroundOverride(self, color: QtGui.QColor) -> None:
        """Override the panel's background color with the given QColor."""
    def setVisualSize(self, visual_size: int) -> None:
        """Scale the panel's font size to match the given visual size.
        Called by parent tab widgets to sync sizing with HUD windows.
        Qt fonts don't always inherit (children may have their own from
        the QStyle), so we apply explicitly to all descendants."""
    def getPreferencePath(self, pref: str, shared: bool = False) -> str: ...
    def getDefaultLayerTypePreference(self) -> LayerType: ...
    def setDefaultLayerTypePreference(self, layer_type: LayerType) -> None: ...
    def getShowColumnPreference(self, column: Column) -> bool: ...
    def setShowColumnPreference(self, column: Column, show: bool) -> None: ...
    def getShowWeightSlidersPreference(self) -> bool: ...
    def setShowWeightSlidersPreference(self, show: bool) -> None: ...
    def getModel(self) -> AnimationLayersModel | None:
        """Get the model used for the view."""
    def getMembershipModel(self) -> AnimationLayerMembershipModel | None:
        """Get the membership model."""
    def addPersistentMenu(self, menu: QtWidgets.QMenu) -> None:
        """Add a menu to the menu bar that stays enabled when the panel is
        disabled."""
    def removePersistentMenu(self, menu: QtWidgets.QMenu) -> None:
        """Removes menu previously called with addPersistentMeny."""
    def setModel(self, model: AnimationLayersModelHandle | None = None, clear: bool = False) -> None:
        """
        Set the model that the view uses. If set to None, will set to
        a default empty model, otherwise will change the model to point
        to the one provided.
        """
    def setMembershipModel(self, membership_model: AnimationLayerMembershipModel | None = None) -> None: ...
    def enable(self, enable: bool) -> None: ...
    def createColumnToggleAction(self, name: str, column: Column, menu: QtWidgets.QMenu) -> QtGui.QAction: ...
    def reloadModel(self) -> None:
        """Reload the controls and the selected controls from the state."""
    def createEmptyLayer(self, name: str | None = None) -> tuple[Literal[True], str] | tuple[Literal[False], None]: ...
    def createFromSelected(self) -> tuple[Literal[True], str] | tuple[Literal[False], None]: ...
    def duplicateActiveLayer(self) -> None: ...
    def bakeToBaseLayer(self, keys_only: bool) -> None: ...
    def bakeToNewLayer(self, keys_only: bool) -> None: ...
    def addSelectedControlsToActiveLayer(self) -> None: ...
    def removeSelectedControlsFromActiveLayer(self) -> None: ...
    def deleteLayer(self) -> None: ...
    def setDefaultLayerType(self, layer_type: LayerType) -> None: ...
    def toggleMembership(self) -> None: ...
    def toggleWeightSliders(self) -> None: ...
    def toggleColumn(self, column: Column, item: QtGui.QAction) -> None: ...
    def clearSelection(self) -> None: ...
    def selectRow(self, layer: str) -> None: ...
    def activate(self, pane: hou.PaneTab) -> None: ...
    def deactivate(self) -> None: ...
    def _paneActivated(self, pane_tab: hou.PaneTab) -> None:
        """Called when the python panel pane is activated."""
    def _paneDeactivated(self) -> None:
        """Called when the python panel pane is deactivated."""
    def _paneClosed(self) -> None:
        """Called when the python panel pane is closed."""
    def _panePathChanged(self, node: hou.Node) -> None:
        """Called when the pane path changes."""

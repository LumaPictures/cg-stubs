import apex
import hou
from collections.abc import Iterable
from typing import TypeGuard

class ApexSopNodeBase:
    subnetid: int
    node: hou.SopNode
    nodeid: int
    has_expressions: bool
    @staticmethod
    def isType(node: hou.Node) -> TypeGuard[hou.SopNode]: ...
    def __init__(self, graph: apex.Graph, subnetid: int, node: hou.SopNode) -> None: ...
    def initGraphNode(self, graph: apex.Graph) -> int: ...
    def recordExpressions(self, graph: apex.Graph) -> bool: ...
    def getGeoInput(self, graph: apex.Graph, idx: int) -> int: ...
    def getGeoOutput(self, graph: apex.Graph, idx: int) -> int: ...
    def isPlaceholder(self) -> bool: ...
    def containsPlaceholder(self) -> bool: ...
    def hasExpressions(self) -> bool: ...
    def containsExpressions(self) -> bool: ...
    def setNodeColor(self, graph: apex.Graph) -> None: ...
    def setNodeTags(self, graph: apex.Graph) -> None: ...

class ApexSopVerb(ApexSopNodeBase):
    nodeid: int
    auxgeo_nodeid: int
    @staticmethod
    def isType(node: hou.Node) -> TypeGuard[hou.SopNode]: ...
    def __init__(self, graph: apex.Graph, subnetid: int, node: hou.SopNode) -> None: ...
    def initGraphNode(self, graph: apex.Graph) -> int: ...
    def getGeoInput(self, graph: apex.Graph, idx: int) -> int: ...
    def getGeoOutput(self, graph: apex.Graph, idx: int) -> int: ...

class ApexSopNetworkBase(ApexSopNodeBase):
    def getGeoInput(self, graph: apex.Graph, idx: int) -> int: ...
    def getGeoOutput(self, graph: apex.Graph, idx: int) -> int: ...
    def addSubnetInput(self, graph: apex.Graph, name: str, data_type: str) -> int: ...
    def addSubnetOutput(self, graph: apex.Graph, name: str, data_type: str) -> int: ...
    def setNodeParms(self, graph: apex.Graph) -> dict[str, int]: ...

class ApexSopNetwork(ApexSopNetworkBase):
    nodeid: int
    contains_placeholder: bool
    contains_expressions: bool
    @staticmethod
    def isType(node: hou.Node) -> TypeGuard[hou.SopNode]: ...
    def __init__(self, graph: apex.Graph, subnetid: int, node: hou.SopNode) -> None: ...
    def initGraphNode(self, graph: apex.Graph) -> int: ...
    def containsPlaceholder(self) -> bool: ...
    def containsExpressions(self) -> bool: ...

class ApexSopPlaceholder(ApexSopNetworkBase):
    nodeid: int
    def initGraphNode(self, graph: apex.Graph) -> int: ...
    def isPlaceholder(self) -> bool: ...

apex_sop_types: list[type[ApexSopNodeBase]]

def importSopNodes(graph: apex.Graph, src_nodes: Iterable[hou.Node], subnetid: int = -1) -> dict[str, ApexSopNodeBase]: ...

from enum import Enum, StrEnum

class DynamicMotionToolbox(StrEnum):
    StateMachine = 'apex_dynamicmotion_state_machine'
    Add = 'apex_dynamicmotion_add'
    Remove = 'apex_dynamicmotion_remove'
    Mode = 'apex_dynamicmotion_mode'
    TargetingMethod = 'apex_dynamicmotion_targeting_method'
    Life = 'apex_dynamicmotion_life'
    Reset = 'apex_dynamicmotion_reset_rig'
    VisibleControls = 'apex_dynamicmotion_visible_controls'
    LimitFrames = 'apex_dynamicmotion_limit_frames'
    FramesBefore = 'apex_dynamicmotion_frames_before'
    FramesAfter = 'apex_dynamicmotion_frames_after'
    Tool = 'apex_dynamicmotion'

class Mode(Enum):
    Basic = 0
    Advanced = 1
    def token(self) -> str: ...
    def label(self) -> str: ...

def modeToMenuIndex(mode: Mode) -> int: ...
def modeFromMenuIndex(index: int) -> Mode | None: ...
def modeToToolBoxName(mode: Mode) -> str: ...
def modeFromToolBoxName(name: str) -> Mode | None: ...
def modeToContextMenuAction(mode: Mode) -> str: ...
def modeFromContextMenuAction(action_id: str) -> Mode | None: ...

class TargetingMethod(Enum):
    Life = 0
    HeightPlane = 1
    def token(self) -> str: ...
    def label(self) -> str: ...

def targetingMethodToMenuIndex(targeting_method: TargetingMethod) -> int: ...
def targetingMethodFromMenuIndex(index: int) -> TargetingMethod | None: ...

class VisibleControls(Enum):
    Current = 0
    All = 1
    def token(self) -> str: ...
    def label(self) -> str: ...

def visibleControlsToMenuIndex(visible_controls: VisibleControls) -> int: ...
def visibleControlFromMenuIndex(index: int) -> VisibleControls | None: ...

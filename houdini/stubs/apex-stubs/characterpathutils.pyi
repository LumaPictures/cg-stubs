from apex.autorigtool import _ToolActivateKwargs
from collections.abc import Mapping
from dataclasses import dataclass
from enum import Enum
from statehud.parmutils import _HUDParmValue
from statehud.parmwidgetset import _HUDParmInput, _HUDParmTemplate
from typing import Callable as Callable, ClassVar, Generic, Protocol

from typing import ParamSpec
from typing import TypeAlias
from typing import TypeVar
from typing import ParamSpec
from typing import TypeAlias
from typing_extensions import TypeVar
_T = TypeVar('_T')
_P = ParamSpec('_P')
_R = TypeVar('_R')
_V = TypeVar('_V', bound=_apex._ValueArg)
_StateT_co = TypeVar('_StateT_co', bound=_AnimateState, covariant=True, default=_AnimateState)
_InputMapping: TypeAlias = tuple[tuple[str, tuple[str, str]], ...]
_PortMap: TypeAlias = tuple[tuple[tuple[str, str], tuple[str, str]], ...]
_U_co = TypeVar('_U_co', bound=Undo, covariant=True)
class _AnimateState(asu._AnimateState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""
    def bindBakeConfigParm(self, name: str, value: _HUDParmInput, parm_dict: _HUDParmTemplate) -> None: ...

class _EventBlocker(Protocol):
    """What eventutils.eventBlocker() returns: a decorator that keeps the signature."""
    def __call__(self, f: Callable[_P, _R], /) -> Callable[_P, _R]: ...

class Undo:
    """
    Character path undo. Holds a weakref to the state and accesses the tool
    through the state's tool list.
    """
    module_name: str
    def __init__(self, tool: CharacterPathToolBase) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    def tool(self) -> CharacterPathToolBase | None:
        """Reference to the character path tool."""

class EndpointUndo(Undo):
    """Undo that runs only if the 'end' flag is false."""
    end: bool
    def __init__(self, tool: CharacterPathToolBase, end: bool = False) -> None: ...
    def execute(self, tool: CharacterPathToolBase) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class EndpointParmsUndo(EndpointUndo):
    """Undo for graph parameters."""
    graph_parms: apex.Dict
    def __init__(self, tool: CharacterPathToolBase, graph_parms: apex.Dict, end: bool = False) -> None: ...
    def execute(self, tool: CharacterPathToolBase) -> None: ...

class WrapperUndo(Generic[_U_co]):
    """
    Undo that holds two undos, calling undo on the first and redo on the second.
    """
    start_undo: _U_co
    end_undo: _U_co
    def __init__(self) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class ParmsUndo(WrapperUndo[EndpointParmsUndo]):
    """Wrapper undo for graph parameters."""
    start_undo: EndpointParmsUndo
    end_undo: EndpointParmsUndo
    def __init__(self, tool: CharacterPathToolBase, pre_graph_parms: apex.Dict, post_graph_parms: apex.Dict) -> None: ...

class GraphUndo(Undo):
    """Character path graph undo."""
    pre_graph: apex.Graph
    pre_graph_parms: apex.Dict
    post_graph: apex.Graph
    post_graph_parms: apex.Dict
    channel_undos: list[asu.SetChannelsUndo]
    def __init__(self, tool: CharacterPathToolBase, pre_graph: apex.Graph, pre_graph_parms: apex.Dict, post_graph: apex.Graph, post_graph_parms: apex.Dict, channel_undos: list[asu.SetChannelsUndo] = ...) -> None: ...
    def undo(self) -> None:
        """Undo to the previous graph."""
    def redo(self) -> None:
        """Redo to the last undone graph."""

class CharacterPathEvaluator(ase.AnimationEvaluatorBase):
    def __init__(self, tool: CharacterPathToolBase) -> None: ...
    def updateStop(self) -> None: ...

PATHARRAY_INPUT_NODES: set[str]

@dataclass
class GraphIdCache:
    patharray_input_ports: list[int]
    parms: int = ...
    inputpath_parms: int = ...
    draw_parms: int = ...
    output: int = ...
    samplerate_input: int = ...
    patharray_inputs: int = ...

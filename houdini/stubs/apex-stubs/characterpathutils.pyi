    def replaceRootPaths(self, num: int) -> None: ...

class ActivateResult(Enum):
    Failed = 0
    Created = 1
    Loaded = 2

class CharacterPathToolBase(Generic[_StateT_co]):
    """
    Base class for tools that deal with a character path rig.

    A character path represents the trajectory of an entire character. The
    default rig supports no interaction. Internally, the path is represented
    with an APEX DynamicPath.

    Subgraphs can be merged into the path rig graph. These subgraphs can contain
    controls used to manipulate the path. Using the deformed path, the source
    character's controls can be baked following along the path.

    A set of controls is chosen as the center of mass (COM), which is used
    mainly for identifying the character to create a path for, but additionally
    provides the position for the path visualization. The visualization follows
    the centroid of the set of COM controls at each frame.
    """
    module_name: str
    selectionEventBlocker: _EventBlocker
    name: str
    active: bool
    joint_ctrl_paths: list[str]
    root_ctrl_paths: list[tuple[str, int]]
    constrained_ctrl_paths: list[str]
    verify_active_layer_event_posted: bool
    hud_rows: list[hou._HudRow]
    def __init__(self, name: str, state: _StateT_co, folder_path: str, rig_name: str) -> None: ...
    @property
    def state(self) -> _StateT_co | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def rig_path(self) -> str: ...
    @property
    def rig_save_path(self) -> str: ...
    @property
    def constraints_path(self) -> str: ...
    @property
    def evaluator_key(self) -> str: ...
    @property
    def layer_name(self) -> str: ...
    def label(self) -> str: ...
    def hudTemplate(self) -> list[hou._HudRow]: ...
    def rig(self) -> apex.SceneGraph | None: ...
    def graph_parms(self) -> apex.Dict | None: ...
    def control_manager(self) -> apex.ControlManager: ...
    def control_template(self) -> hou.Geometry: ...
    def anim_binding(self) -> apex.ChannelPrimBindings: ...
    def constraint_manager(self) -> apex.ConstraintManager: ...
    def isLookatConstrained(self) -> bool: ...
    def setIsLookatConstrained(self, on: bool) -> None: ...
    def isTwistConstrained(self) -> bool: ...
    def setIsTwistConstrained(self, on: bool) -> None: ...
    def isRotationConstrained(self) -> bool: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> ActivateResult: ...
    def onDeactivate(self) -> bool: ...
    def onPreSave(self) -> None: ...
    def onPostSave(self) -> None: ...
    def loadWithGraph(self, graph: apex.Graph, parms: apex.Dict) -> None:
        """Load a graph then set the tool state."""
    def loadWithGraphAndChannelPrims(self, graph: apex.Graph, parms: apex.Dict, channel_undos: list[asu.SetChannelsUndo], undo: bool) -> None:
        """Load a graph and channels then set the tool state."""
    def loadWithGraphParms(self, graph_parms: apex.Dict) -> None: ...
    def freeze(self) -> tuple[apex.Graph, apex.Dict]: ...
    def recreateRig(self) -> None:
        """Creates the rig's SceneGraph with the character path graph."""
    def onResetRig(self) -> None: ...
    def setConstantGraphParms(self) -> None: ...
    def setGraphParms(self, parms: Mapping[str, _apex._ValueArg] | apex.Dict) -> None: ...
    def setControlParms(self, parms: dict[str, _V] | apex.Dict) -> None: ...
    def getGraphParm(self, parm: str, default: _T | None = None, graph_parms: apex.Dict | None = None) -> _apex._Value | _T | None: ...
    def addConstraints(self) -> None: ...
    def removeConstraints(self) -> None: ...
    def addLayer(self) -> tuple[bool, str]: ...
    def duplicateLayer(self, set_op_layer: bool = False) -> tuple[bool, str]: ...
    def verifyActiveLayer(self) -> None: ...
    def onVerifyActiveLayerEvent(self, **kwargs: object) -> None: ...
    def postVerifyActiveLayerEvent(self) -> None: ...
    def onPreActiveLayerChanged(self) -> None: ...
    def onActiveLayerChanged(self, kwargs: _ActiveLayerChangedKwargs) -> None: ...
    def onPostActiveLayerChanged(self) -> None: ...
    def setComControlsFromSelection(self) -> bool:
        """Set the COM controls from the current control selection."""
    def setComControls(self, ctrl_paths: list[str]) -> bool:
        """Set the COM controls from a list of control paths."""
    def resetComControls(self, force: bool = False) -> bool:
        """Remove the current COM controls and reset the graph."""
    def clearComControls(self) -> bool:
        """Remove the current COM controls."""
    @selectionEventBlocker
    def deselectAllPathControls(self) -> None: ...
    def reloadAnim(self) -> bool: ...
    def updateControlPositions(self, skip_hud_update: bool = False) -> None: ...
    def updateControlParms(self) -> None: ...
    def shiftKeys(self, revert: bool = False, add_undo: bool = False, shift_frame: bool = True, layer_name: str | None = None) -> bool: ...
    def createEvalGraph(self) -> apex.Graph: ...
    def getOrigTimeFromTime(self, time: float, eval_graph: apex.Graph | None = None) -> float: ...
    def getTimeFromSourceTime(self, sourcetime: float, eval_graph: apex.Graph | None = None) -> float: ...
    def getSourceTimeFromTime(self, time: float, eval_graph: apex.Graph | None = None) -> float: ...
    def evaluatePositionAtTime(self, time: float, eval_graph: apex.Graph | None = None) -> hou.Vector3: ...
    def evaluatePositionAtSourceTime(self, time: float, eval_graph: apex.Graph | None = None) -> hou.Vector3: ...
    def evaluateOutputAtTime(self, output: str, time: float, eval_graph: apex.Graph | None = None) -> _apex._Value | None: ...
    def onBakeEvent(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def bakePath(self, kwargs: Mapping[str, _HUDParmValue]) -> bool: ...
    def getPathEvaluatorActive(self) -> bool: ...
    def blockReload(self) -> None: ...
    def unblockReload(self) -> None: ...
    def setPathEvaluatorChannels(self) -> None: ...
    def updatePathEvaluatorChannelDataIds(self) -> bool: ...
    def updatePathEvaluator(self) -> None: ...
    def getPathEvaluator(self) -> CharacterPathEvaluator | None: ...
    def isolateCharacterIfNeeded(self, char_name: str, on: bool) -> None: ...

def setParms(state: _AnimateState, control_parm: str, value: _apex._ValueArg, evaluate: bool = True, control_manager: apex.ControlManager | None = None, ctrl_paths: Iterable[str] | None = None) -> None: ...

class LocatorSettingsWidget(ParameterWidget[_AnimateState]):
    DEFAULT_SIZE: int
    DEFAULT_LABEL_WIDTH: int
    def __init__(self, tool: LocatorTool, hud_window: shud.WidgetBundleWindow | None = None, tab_widget_name: str | None = None, tab_name: str | None = None) -> None: ...
    @property
    def tool(self) -> LocatorTool | None: ...
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None:
        """ Load from userdata on entering tool. """
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: Never) -> None:
        """ Save to userdata on exiting tool. """
    def onOriginCallback(self, name: str) -> Callable[[bool], bool]: ...
    def onOrigin(self, name: str, v: bool) -> Literal[False]:
        """set manual handle xform mode for the state here"""


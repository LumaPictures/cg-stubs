class LocatorTool:
    processor_graph: apex.Graph | None
    processor_parms: apex.Dict
    locator_rig: None
    add_hk: str
    remove_hk: str
    reparent_hk: str
    shape_names: list[str]
    use_hud_widget: bool
    hud_widget: LocatorHudWidget | None
    use_mapping_gadget: bool
    mapping_gadget: MappingGadget
    interrupted: bool
    use_rest_update: bool
    constraint_rig: None
    compute_world: hou.SopVerb
    compute_local: hou.SopVerb
    name: str
    hud_template: None
    hud_rows: list[hou._HudRow]
    settings_widget: LocatorSettingsWidget | None
    create_at_origin: bool
    mapping_collection: MappingCollection
    key_consumed: bool
    def __init__(self, state: _AnimateState) -> None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    def label(self) -> str: ...
    def hudTemplate(self) -> list[hou._HudRow]: ...
    def rig(self) -> apex.SceneGraph | None: ...
    def initProcessor(self) -> None: ...
    def setLocatorSettings(self, name: str | None = None, position: hou.Vector3 | None = None, parent: apex.Control | Literal[False] = False) -> tuple[bool, str] | None: ...
    def reparentLocator(self) -> bool: ...
    def createLocator(self) -> None: ...
    def addLocator(self, name: str | None = None, position: hou.Vector3 | None = None, parent: apex.Control | Literal[False] = False) -> None: ...
    def addConstraintEntry(self, driver: apex.Control, driven: apex.Control) -> None:
        """
        This would be the typical animator use case of a single driver,
        multiple driven constraint
        """
    def removeConstraintEntry(self, control: apex.Control) -> bool: ...
    def initGadget(self) -> None: ...
    def onDraw(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def removeLocator(self, name: str | None = None) -> None: ...
    def updateMappingGadget(self) -> None: ...
    def evaluatMappingGadget(self) -> None: ...
    def updateScale(self, controls: Iterable[str], scale: hou.Vector3, relative: bool = True) -> None: ...
    def updateColor(self, color: hou.Vector3) -> None: ...
    def updateShape(self, shape_name: str) -> None: ...
    def getControlProperty(self, control: apex.Control) -> apex.Dict: ...
    def setControlProperty(self, control: apex.Control, properties: apex.Dict) -> None: ...
    def getControlShape(self, control: apex.Control) -> str: ...
    def getControlColor(self, control: apex.Control) -> hou.Vector3: ...
    def createDefaultRig(self, parent: apex.Control | None = None) -> apex.Graph: ...
    def skeleton_from_graph(self) -> None: ...
    def updateLocatorRig(self, settings: apex.Dict | None = None) -> None: ...
    def setLocatorRig(self, graph: apex.Graph | None = None) -> None: ...
    def updateGraphForPoseState(self, graph: apex.Graph) -> apex.Graph: ...
    def getLocatorRig(self) -> None: ...
    def addLocatorCharacter(self, parent: apex.Control | None = None) -> None: ...
    def setParent(self, control: apex.Control, new_parent: apex.Control | None = None) -> None: ...
    def updateRestpostion(self, ctrl_paths: Sequence[str] | None = None, update: bool = True) -> hou.Geometry | None: ...
    def updateFromSkeleton(self, skel: hou.Geometry, ctrl_paths: Sequence[str] | None) -> None: ...
    def writeToGeo(self) -> None: ...
    def onActivate(self, kwargs: _ToolActivateKwargs) -> None: ...
    def control_manager(self) -> apex.ControlManager | None: ...
    def onPostPlaybackChangeEvent(self, kwargs: ViewerStatePlaybackChangeKwargs) -> Literal[False]: ...
    def onDrawInterrupt(self, kwargs: ViewerStateDrawKwargs) -> None: ...
    def onDeactivate(self) -> None: ...
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    def onSelectionChanged(self, selection: Sequence[str], **kwargs: Never) -> None: ...
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def getShapeOffset(self, control: apex.Control) -> hou.Matrix4: ...
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    def onPostSelectionEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def onPostEvaluationEvent(self, time: float) -> Literal[False]: ...
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    def onHUDSettingEvent(self, kwargs: _ParmEventDict) -> None:
        """
        Call updatetoolbox to run a state command on the animate state
        that updates our toolbox
        """
    def onKeyTransitEvent(self, kwargs: ViewerStateEventKwargs) -> Literal[False]: ...
    def onVolatileClientEvent(self, kwargs: ViewerStateVolatileClientKwargs) -> Literal[False]: ...
    def updateStateParms(self, state_parms: Mapping[str, ViewerParmProperties]) -> None: ...


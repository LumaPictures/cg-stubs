class LinkedParmWidgetSet(SceneParmWidgetSet):
    """
    This class is responsible for linking different ParmWidgetSet's together
    to support hide/disable-when conditionals that depends on parameters from
    different ParmWidgetSet instances.
    Linked ParmWidgetSet references should exist on the same hud_window.
    """
    widget_set_refs: list[weakref.ref[ParmWidgetSet]]
    def __init__(self, *args: *tuple[apex.Scene], **kwargs: Unpack[_ParmWidgetSetKwargs]) -> None: ...
    def addRef(self, widget_sets: Iterable[ParmWidgetSet]) -> None: ...

class SecondaryMotionSettingsWidget(EffectParmHudWidget[LinkedParmWidgetSet]):
    parm_widget_set: LinkedParmWidgetSet
    effect_widget_set: LinkedParmWidgetSet | None
    transform_widget_set: LinkedParmWidgetSet | None
    def __init__(self, tool: SecondaryMotionTool, hud_window: WidgetBundleWindow | None = None, tab_widget_name: str | None = None, tab_name: str | None = None) -> None: ...
    def createParmWidgetSet(self, tool: EffectTool) -> LinkedParmWidgetSet: ...
    def bindGraphParms(self, graph: apex.Graph, pattern: str | None = None) -> bool: ...
    def getParmKeys(self) -> list[str]: ...
    def updateParmValue(self, parm_name: str, val: _WidgetValue, refresh_hide_disable: bool = True) -> bool: ...
    def updateAnimatedParms(self) -> bool: ...
    def clearBindings(self) -> None: ...
    def onParmValueChange(self, parm_name: str, start_slider: bool = False, end_slider: bool = False, active: bool | None = None) -> None:
        """
        This function is a callback on self.parm_widget_set.
        When parameter changes are made on the widget, this function gets called. 
        Changes are propagated to the toolbox and to the rest of the tool.
        """
    def updateSelectionLabels(self, val: int | None = None) -> None: ...
    def updateActiveSubtool(self, subtool: SecondaryMotionSubtool) -> None: ...
    @property
    def tool(self) -> SecondaryMotionTool | None: ...
    @property
    def focused_subtool(self) -> SecondaryMotionSubtool | None: ...


class _AnimateState(_ChannelState, _BakeState, Protocol):
    """The members of the Animate viewer state (`viewer_states/apexanimate.py`) this module uses."""
    def _runSceneCallbacks(self) -> None: ...
    def addMissingChannelsForParms(self, scoped_parms: Mapping[str, Sequence[str]]) -> None: ...

class _ParmChangeKwargs(TypedDict, total=False):
    """What `EffectTool.onParmValueChange` passes to the subtools' `onParmWidgetValueChangeToGraph`."""
    parm_name: Required[str]
    val: Required[_ParmValue]
    active: bool
    start_slider: bool
    end_slider: bool
    focused_subtool_only: bool

class _AnimatedParmActionKwargs(TypedDict):
    parm_name: str
    action: str
    frame: float | None
    value: float | None

class _ActionButtonKwargs(TypedDict):
    parm_name: str

class _CollectionNamesKwargs(TypedDict):
    collection_names: Sequence[str]

class _PreSelectionChangedKwargs(TypedDict):
    """What the Animate state's `onPreSelectionChanged` tool event passes; tools may edit `ctrl_paths`."""
    ctrl_paths: list[str]
    pick_modifier: hou.EnumValue[hou.pickModifier]
    primary_control: str | None

class _BakeKwargs(TypedDict, total=False, extra_items=_HUDParmValue):  # type: ignore[call-arg]
    """The Animate state's bake parameters (its settings HUD's `getBakeParms()`), by name.

    The tools set `bake_newlayer` in it, and secondarymotiontool `controls_to_bake`.
    """
    controls_to_bake: set[str]

UNDO_TAG: str
EFFECT_ENABLE_PARM: str
EFFECT_LABLE_WIDTH: int
EFFECT_FIELD_WIDTH: int

def loadGraph(graph_path: str) -> apex.Graph: ...

EFFECT_PARM_TAGS: dict[str, dict[str, bool | str]]
STYLE_SETTINGS: pws._StyleSettings

class EffectParmHudWidget(apexhud.ParameterWidget[_AnimateState, WidgetBundleWindow], Generic[_PWS_co]):
    """
    Generic UI widget for effect paramters
    """
    hud_window: WidgetBundleWindow
    parm_widget_set: _PWS_co
    def __init__(self, tool: EffectTool, hud_window: WidgetBundleWindow | None = None, tab_widget_name: str | None = None, tab_name: str | None = None) -> None: ...
    @property
    def tool(self) -> EffectTool | None: ...
    @property
    def focused_subtool(self) -> EffectSubtool | None: ...
    @property
    def channel_manager(self) -> SceneChannelManager | None: ...
    def isVisible(self) -> bool: ...
    def onHotkeyEvent(self, name: str, hk: str | None = None) -> None:
        """
        these are the hotkeys defined in the animate state like
        shift+click ...
        hk are 
        - del_key_all
        - key_all
        - key
        - del_key    
        """
    def createParmWidgetSet(self, tool: EffectTool) -> SceneParmWidgetSet: ...
    def initBindings(self, graph: apex.Graph | None = None) -> None: ...
    def refreshTabLabel(self) -> None: ...
    def bindGraphParms(self, graph: apex.Graph, pattern: str | None = None) -> bool: ...
    def getParmKeys(self) -> list[str]: ...
    def getParmDict(self) -> dict[str, _HUDParmValue]: ...
    def getParmValue(self, parm_name: str) -> _HUDParmValue: ...
    def getParmTags(self, parm_name: str) -> dict[str, str] | None: ...
    def updateParmValue(self, parm_name: str, val: _WidgetValue, refresh_hide_disable: bool = True) -> bool:
        """ Attempts to update an existing parameter. """
    def updateParmValuesFromDict(self, d: Mapping[str, _WidgetValue] | apex.Dict) -> bool:
        """
        Attempts to update a set of parm values.
        Returns `True` if all parms updated. Returns `False` otherwise.
        """
    def updateAnimatedParms(self) -> bool:
        """
        This function updates all animated parameter values displayed on the widget.
        Animated parameters are represented as channel primitives on the geommetry
        stored in the scene at the path `self.channel_prims_path`.
        Pending values are used if they exist.
        """
    def setParmWidgetEnabled(self, name: str | list[str], enabled: bool) -> None: ...
    def setAllParmWidgetsEnabled(self, enabled: bool) -> None: ...
    def setParmWidgetVisible(self, name: str | list[str], visible: bool) -> None: ...
    def setAllParmWidgetsVisible(self, visible: bool) -> None: ...
    def clearBindings(self) -> None: ...
    def onParmValueChange(self, parm_name: str, start_slider: bool = False, end_slider: bool = False, active: bool | None = None) -> None:
        """
        This function is a callback on self.parm_widget_set.
        When parameter changes are made on the widget, this function gets called. 
        Changes are propagated to rest of the tool and subtools.
        """
    def onSliderStartCallback(self, parm_name: str) -> None: ...
    def onSliderEndCallback(self, parm_name: str) -> None: ...
    def onActionButtonEvent(self, name: str) -> None: ...
    def onButtonClickCallback(self, name: str) -> Callable[[], bool]: ...
    def loadFromConfig(self, the_config: AbstractConfig, **kwargs: object) -> None:
        """ Load from userdata on entering tool. """
    def saveToConfig(self, the_config: AbstractConfig, **kwargs: object) -> None:
        """ Save to userdata on exiting tool. """

class EffectParmUndo(Generic[_T]):
    prev_parm: _T

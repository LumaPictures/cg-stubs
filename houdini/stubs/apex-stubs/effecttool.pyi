    callback: Callable[[_T], object]
    def __init__(self, prev_parm: _T, parm: _T, callback: Callable[[_T], object]) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...

class EffectParmSelectable(Generic[_HW_co, _SW_co]):
    hud_widget: _HW_co | None
    settings_widget: _SW_co | None
    selected: set[str]
    is_reselecting: bool
    is_selecting: bool
    single_select: bool
    confirm_selection_hk: str
    abort_selection_hk: str
    cur_parm: str
    prev_parm_value: str
    char_path: str
    select_joint_path: str
    joint_rig_name: str
    joint_rig_path: str
    joint_skel_drawable: apexscene.SceneOutputDrawable | None
    joint_hidden: bool | None
    control_rig_path: str
    saved_control_cols: dict[str, tuple[float, ...]]
    control_hidden: bool | None
    class SELECT_MODE(Enum):
        Default = 'default'
        SingleSelect = 'single_select'
    class SELECT_TARGET(Enum):
        Joints = 'joint'
        Controls = 'control'
    @dataclass
    class ColConfig:
        targets: set[str]
        default_col: hou.Vector3 | None
        select_col: hou.Vector3 | None
        debug_col: hou.Vector3 | None
    DEFAULT_COL_CONFIG: ClassVar[ColConfig]
    @dataclass
    class Parm:
        mode: EffectParmSelectable.SELECT_MODE
        target: EffectParmSelectable.SELECT_TARGET
        saved_selection: dict[str, set[str]]
    debug: EffectParmSelectable.SELECT_TARGET | None
    parms: dict[str, EffectParmSelectable.Parm]
    joint_rig_graph: apex.Graph | None
    def __init__(self, subtool: EffectSubtool, hud_widget: _HW_co | None = None, settings_widget: _SW_co | None = None) -> None: ...
    @property
    def subtool(self) -> EffectSubtool | None: ...
    @property
    def state(self) -> _AnimateState | None: ...
    @property
    def scene(self) -> apex.Scene: ...
    @property
    def cur_select_target(self) -> EffectParmSelectable.SELECT_TARGET | None: ...
    @property
    def prompt_message(self) -> str | None: ...
    @property
    def joint_ctrl_scale(self) -> float: ...
    def joint_rig(self) -> apex.SceneGraph: ...
    def joint_control_template(self) -> hou.Geometry: ...
    def rig_path(self) -> str: ...
    def getName(self, path: str) -> str: ...
    def addSelectableParm(self, parm_name: str, mode: str, select_target: str = '') -> None: ...
    def buildSelectionRig(self) -> None: ...
    def updateRig(self, config_list: list[ColConfig] | None = None, force: bool = False) -> None: ...
    def startSelection(self, parm_name: str = '') -> None: ...
    def endSelection(self, cancel: bool = False, exit: bool = False, modifier: hou.EnumValue[hou.pickModifier] = ..., parm_name: str | None = None, focused_subtool_only: bool = True) -> bool:
        """
        start -> cur_parm
        modify -> parm_name
        cancel/exit
        """
    def switchSelectTarget(self, parm_name: str, select_target: EffectParmSelectable.SELECT_TARGET, cur_val: str | None = None) -> bool: ...
    def switchDebugMode(self, debug_mode: SELECT_TARGET | None) -> None: ...
    def onActivate(self, parms: Iterable[str]) -> None: ...
    def onDeactivate(self) -> None: ...
    def onSelectionChanged(self, control_selection: tuple[str, ...]) -> None: ...
    def onKeyEvent(self, kwargs: ViewerStateEventKwargs) -> bool: ...
    def onPlaybackChanged(self, kwargs: ViewerStatePlaybackChangeKwargs) -> None: ...
    def saveControlSettings(self) -> None: ...
    def loadControlSettings(self) -> None: ...


@dataclass
class StateData:
    callback: Callable[[bool], tuple[bool, acpu.GraphUndo | None]]
    forward_undo_message: str
    backward_undo_message: str
    prompt_message: str
    add_hotkey_label: str
    remove_hotkey_label: str

class StateId(Enum):
    SelectCOM = 0
    SelectStart = 1
    SelectTarget = 2

@dataclass
class StateTransition:
    forward: StateId
    backward: StateId

class StateMachine:
    '''
    A linear state machine that manages the sequence of interactions that the
    user must perform to create projectile motions.

    Each state has precisely two transitions labelled "forward" and "backward",
    corresponding to the "Add" (h) and "Remove" (Ctrl + h) hotkeys,
    respectively.
    '''
    INITIAL_STATE: ClassVar[StateId]
    prompt: str | None
    hud_add_label: str
    hud_remove_label: str
    stepping: bool
    start_time: float
    target_time: float
    def __init__(self, tool: DynamicMotionTool) -> None: ...
    @property
    def tool(self) -> DynamicMotionTool | None: ...
    def activate(self, tool: DynamicMotionTool) -> None:
        """Set up the state machine with the tool."""
    def deactivate(self) -> None:
        """Clear the state machine."""
    def currentState(self) -> StateId: ...
    def stepState(self, forward: bool) -> None:
        """Step the state"""
    def update(self) -> None: ...
    def freeze(self) -> StateMachine: ...

class StateMachineUndo(acpu.Undo):
    """Undo for the current interaction state."""
    pre_sm: StateMachine
    post_sm: StateMachine
    graph_undo: acpu.GraphUndo | None
    def __init__(self, tool: DynamicMotionTool, pre_sm: StateMachine, post_sm: StateMachine, graph_undo: acpu.GraphUndo | None = None) -> None: ...
    def undo(self) -> None:
        """Undo to the previous interaction state."""
    def redo(self) -> None:
        """Redo to the last undone interaction state."""

class ModeUndo(acpu.Undo):
    """Undo for mode changes."""
    pre_mode: bool
    post_mode: bool
    def __init__(self, tool: DynamicMotionTool, pre_mode: bool, post_mode: bool) -> None: ...
    def undo(self) -> None:
        """Undo to the previous graph parms."""
    def redo(self) -> None:
        """Redo to the last undone graph parms."""

class GraphBuilder:
    """
    Builds the dynamic motion graph.
    """
    GRAPH_PATH: str
    PREVIEW_GRAPH_PATH: str
    PROJ_PLANE_NODE_SUFFIX: str
    PROJ_LIFE_NODE_SUFFIX: str
    INPUT_MAPPING: ClassVar[_PortMapping]
    OUTPUT_MAPPING: ClassVar[_PortMapping]
    PATHARRAY_PORTS: ClassVar[tuple[tuple[str, str], ...]]
    PREVIEW_INPUT_MAPPING: ClassVar[_PortMapping]
    PREVIEW_DRAW_INPUT_MAPPING: ClassVar[_PortMapping]
    num_motions: int
    motion_numbers: list[int]
    next_motion_number: int
    def __init__(self, tool: DynamicMotionTool) -> None: ...
    @property
    def tool(self) -> DynamicMotionTool | None: ...
    @property
    def graph_holder(self) -> acpu.GraphHolder: ...
    @property
    def graph(self) -> apex.Graph: ...
    @property
    def id_cache(self) -> acpu.GraphIdCache: ...
    def initializeMotionNumbers(self) -> None:
        """Initialize motion numbers from a loaded graph"""
    def updatePlaneControlScale(self) -> None: ...
    def getPrefix(self, num: int) -> str: ...
    def prefixName(self, name: str, idx: int | None = None) -> str: ...
    def createProjectilePathFromPlane(self) -> None: ...
    def removeMotion(self, num: int) -> None: ...


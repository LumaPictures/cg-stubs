from collections.abc import Sequence
from cop.copsettings import getCopProjectSettings as getCopProjectSettings
from hutil.PySide import QtCore, QtGui, QtWidgets
from typing import TypedDict, Unpack

class _QSliderKwargs(TypedDict, total=False):
    parent: QtWidgets.QWidget | None
    tickPosition: QtWidgets.QSlider.TickPosition | None
    tickInterval: int | None

WINDOW_WIDTH: int
WINDOW_HEIGHT: int
SMALL_MARGIN: int
BIG_MARGIN: int
SMALL_TEXT_SIZE: int
MEDIUM_ICON_SIZE: int
PRECISION_TYPES: list[tuple[str, int]]
BORDER_MODES: list[str]
UNLOAD_MODES: list[tuple[str, str]]
PIXSCALE_MIN: int
PIXSCALE_MAX: int

class IntegerSlider(QtWidgets.QSlider):
    """ Slider for int values
    """
    @staticmethod
    def dataType() -> type[int]: ...
    def __init__(self, *args: QtCore.Qt.Orientation | QtWidgets.QWidget | None, tickmarks: bool = False, tickrate: int = 1, **kwargs: Unpack[_QSliderKwargs]) -> None: ...
    def toType(self, value: str | float) -> int: ...
    def intValue(self, value: int) -> int: ...
    def toTypeValue(self, value: int) -> int: ...
    def enumType(self) -> int: ...
    def lockUI(self, value: bool) -> None:
        """ Disable the widget if we are locked.
        """

class COPManager(QtWidgets.QDialog):
    """
    Copernicus Default Settings Window to replace Old Compositor Settings
    Created from Main Menu -> Edit -> Copernicus Settings
    """
    theInstance: COPManager | None
    def __new__(cls, *args: QtWidgets.QWidget | None, **kwargs: QtWidgets.QWidget | None) -> COPManager: ...
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    @classmethod
    def instance(cls) -> COPManager: ...
    def setupUI(self) -> None: ...
    def updateFromSettings(self) -> None: ...
    def minimumLocked(self) -> bool: ...
    def maximumLocked(self) -> bool: ...
    def parseResolutions(self, strs: str) -> tuple[list[str], list[str]]: ...
    def setOptions(self) -> None: ...
    def getOptions(self) -> None: ...
    def saveOptions(self) -> None:
        """
        Save compositor options locally in dictionary
        """
    def applyChanges(self) -> None:
        """
        Apply changes to the compositor options with set context options
        """
    def loadOptions(self) -> None: ...
    def setToDefault(self) -> None: ...
    def mapToSlider(self, value: float) -> float:
        """
        Map input field values to slider tick values
        """
    def pixelEditFinished(self, value: Sequence[float]) -> None: ...
    def pixelSliderMoved(self, value: int) -> None: ...
    def pixelSliderChanged(self, value: int) -> None: ...
    def vramEditFinished(self, value: Sequence[float]) -> None: ...
    def vramSliderMoved(self, value: int) -> None: ...
    def vramSliderChanged(self, value: int) -> None: ...
    def filecacheEditFinished(self, value: Sequence[float]) -> None: ...
    def filecacheSliderMoved(self, value: int) -> None: ...
    def filecacheSliderChanged(self, value: int) -> None: ...
    def presetMenuChanged(self, action: QtGui.QAction) -> None: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...

def showCOPManager() -> None: ...

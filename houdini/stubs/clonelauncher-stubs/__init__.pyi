import hou
from typing import Any

class CloneLauncher:
    def startClone(self, clone: hou.clone.Connection) -> bool: ...
    def getConfigurationFromUI(self, **kwargs: Any) -> dict[str, Any] | None: ...

class Manager:
    def __init__(self) -> None: ...
    def registerCloneLauncher(self, label: str, launcher_cls: type[CloneLauncher]) -> None: ...
    def getAllCloneLauncherNames(self) -> list[str]: ...
    def getCloneLauncher(self, label: str) -> CloneLauncher: ...

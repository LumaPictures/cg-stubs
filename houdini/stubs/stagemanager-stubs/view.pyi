    def __init__(self, model: QtCore.QAbstractItemModel, parent: QtWidgets.QWidget | None = None) -> None: ...

class ColumnIconCenterDelegate(QtWidgets.QStyledItemDelegate):
    """
    A delegate to counter Qt's weirdness in centering icons in a column.
    """
    def __init__(self, columns: Iterable[int], parent: QtWidgets.QAbstractItemView | None = None) -> None: ...
    def paint(self, painter: QtGui.QPainter, option: QtWidgets.QStyleOptionViewItem, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> None: ...
    def editorEvent(self, event: QtCore.QEvent, model: QtCore.QAbstractItemModel, option: QtWidgets.QStyleOptionViewItem, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> bool: ...


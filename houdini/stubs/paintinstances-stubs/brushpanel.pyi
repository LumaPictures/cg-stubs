class ToolbarListView(QtWidgets.QListView):
    """
    QListView subclass to override sizeHint to provide a proper width
    based on the brush icon size and spacing. This is needed to make sure
    the toolbar is sized correctly when the brush icons are large and
    have long labels. Without this, the toolbar width will be too small
    and the labels will be elided.
    """
    def sizeHint(self) -> PySide6.QtCore.QSize: ...

class ToolbarWidget(QtWidgets.QWidget):
    """
    A widget that contains a QListView and up/down buttons to scroll the
    list. The buttons are enabled/disabled based on the scroll position of
    the list. Also forwards QListView methods to the contained list
    view to make it easier to use as a replacement for a QListView.
    """
    def __init__(self, list_view: PySide6.QtWidgets.QListView, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def model(self) -> PySide6.QtCore.QAbstractItemModel: ...
    def currentIndex(self) -> PySide6.QtCore.QModelIndex: ...
    def setCurrentIndex(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> None: ...
    def selectionModel(self) -> PySide6.QtCore.QItemSelectionModel: ...
    def itemDelegate(self) -> PySide6.QtWidgets.QAbstractItemDelegate: ...
    def scrollTo(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, hint: PySide6.QtWidgets.QAbstractItemView.ScrollHint = ...) -> None: ...
    def clearSelection(self) -> None: ...
    def setVisible(self, visible: bool) -> None: ...
    def sizeHint(self) -> PySide6.QtCore.QSize: ...


def moveNodesToAvoidOverlap(editor: hou.NetworkEditor | None, avoid_nodes: Sequence[hou.NetworkMovableItem], update_graph: bool = True) -> None:
    '''
    Moves nodes around to avoid having conneted nodes overlapping each
    other. It will only move ouputs of the "avoid_nodes", and the
    "avoid_nodes" themselves (to avoid overlapping their inputs).
    The "avoid_nodes" always move as a block, and the ouputs move as
    a block. So it\'s really just moving two blocks of items to avoid
    each other and a third block of items.
    The positions are animated to provide a nice smooth transition.

    When this is called for newly added nodes, "update_graph" must
    be set to True so that the graph will be updated before
    calculating dimensions. Otherwise, the editor won\'t have the
    corresponding graph items avaliable until the next paint loop.
    '''

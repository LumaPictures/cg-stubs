        Eg, \'"PxrSurface" "color diffuseColor" [0.25 0.25 0.25]\'
    '''
def buildVopShaderString(style: str, shopname: str, vopname: str, time: float, parmnames: Iterable[str], parmmap: Mapping[str, str] | None, vopparms: Iterable[str], shaderinputs: Mapping[str, str], options: _ShopOptions) -> str: ...

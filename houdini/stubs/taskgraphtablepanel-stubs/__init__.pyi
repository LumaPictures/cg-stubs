import _pdgd
import hou
from hutil.PySide import QtWidgets

class TaskGraphTablePanel(QtWidgets.QWidget):
    """ Entry panel for the different options of task graph tables """
    data_layer: _pdgd.DataLayerInterface | None
    owns_data_layer: bool
    current_node: hou.OpNode | None
    def __init__(self, parent: QtWidgets.QWidget | None = None) -> None: ...
    def onActivateInterface(self) -> None: ...
    def onDeactivateInterface(self) -> None: ...
    def onNodePathChanged(self, node: hou.OpNode | None) -> None: ...
    def onDestroyInterface(self) -> None: ...
    def connectToRemote(self) -> None: ...
    def connectToLocal(self) -> None: ...
    def connect(self, address: str, interface_type: str) -> None: ...

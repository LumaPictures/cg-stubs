class JsonLineMapper:
    """
    A class used to find the line number for each key/entry in a JSON-formatted string. It expects a JSON-formatted
    string, such as the result of json.dumps(), made from a recipe data and outputs a dictionary mapping that maps each
    data path to a line number:
    {
        '/data': 2,
        '/info': 36,
        '/info/author': 37,
        '/info/created': 38,
        '/info/houdini_version': 39,
        '/properties': 41,
        '/properties/recipe_category': 42,
        '/tool': 49,
        '/options': 60,
    }

    JSON structure: https://www.json.org/json-en.html
    """
    SPACE: str
    TAB: str
    RETURN: str
    CARRIAGE_RETURN: str
    WHITESPACE: tuple[str, str, str, str]
    BEGIN_ARRAY: str
    END_ARRAY: str
    BEGIN_OBJECT: str
    END_OBJECT: str
    NAME_SEPARATOR: str
    VALUE_SEPARATOR: str
    QUOTATION_MARK: str
    ESCAPE: str
    CONTROL_CHARACTER: tuple[str, str, str, str, str, str]
    def __init__(self, source: str) -> None:
        """
        param source: A JSON-formatter string, such as the result of json.dumps()
        """
    def asdict(self) -> dict[str, int]:
        """
        Returns the dictionary mapping.
        """


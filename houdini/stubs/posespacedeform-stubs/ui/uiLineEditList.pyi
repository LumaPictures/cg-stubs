class UiTable(QtWidgets.QTableWidget):
    min_rows: int
    max_rows: int
    draggable: bool
    dropped_item_index: int
    dragged_item_indexes: list[int]
    ignore_updating_empty_rows: bool
    last_shown_item_index: int
    editor_list: list[QtWidgets.QWidget | None]
    dropped_item: ClassVar[QtCore.Signal]
    def __init__(self, rows: int, columns: int, min_rows: int, max_rows: int, item_size: int = 18, draggable: bool = True) -> None: ...
    def defaultRowHeight(self) -> int: ...
    def dragEnterEvent(self, event: QtGui.QDragEnterEvent) -> None: ...
    def dropEvent(self, event: QtGui.QDropEvent) -> None: ...
    def dragLeaveEvent(self, event: QtGui.QDragLeaveEvent) -> None: ...
    def dragMoveEvent(self, event: QtGui.QDragMoveEvent) -> None: ...
    def setEditor(self, index: int, editor: QtWidgets.QWidget) -> None: ...
    def getEditor(self, index: int) -> QtWidgets.QWidget | None: ...
    def clearEditors(self) -> None: ...
    def getNumItems(self) -> int: ...
    def getItem(self, index: int) -> QtWidgets.QWidget | None: ...
    def selectItem(self, index: int) -> None: ...
    def sizeHint(self) -> QtCore.QSize: ...
    def resizeEvent(self, event: QtGui.QResizeEvent) -> None: ...
    def insertEmptyRows(self) -> None:
        """ Adds additional empty rows at the end of the list to give a continual alternating row appearance. """

class UiLineEditListItem(UiLineEdit):
    item: QtWidgets.QTableWidgetItem
    op_list: UiLineEditList
    parent: QtWidgets.QWidget | None
    deletebutton: QtWidgets.QToolButton
    deletewarn: bool
    def __init__(self, op_list: UiLineEditList, parent: QtWidgets.QWidget | None, item: QtWidgets.QTableWidgetItem) -> None: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_value: BaseException | None, traceback: TracebackType | None) -> None: ...
    def setDeleteVisible(self, value: bool, warn: bool = True) -> None: ...

class UiLineEditList(QtWidgets.QWidget):
    relative_node: hou.OpNode | None
    filter_type: hou.EnumValue[hou.nodeTypeFilter]
    operator_type_name: str
    jumpIsVisible: bool
    deleteIsVisible: bool
    deleteWarnUser: bool
    settingsIsVisible: bool
    chooserIsVisible: bool
    onSelectedCallback: Callable[[UiLineEditListItem, int], object] | None
    editItemCallback: Callable[[int], object] | None
    deleteItemCallback: Callable[[int], object] | None
    tablewidget: UiTable
    title: QtWidgets.QLabel
    namelayout: QtWidgets.QVBoxLayout
    operator_list: list[str]
    start_moving_items: ClassVar[QtCore.Signal]
    stop_moving_items: ClassVar[QtCore.Signal]
    def __init__(self, label: str | None, placeholder: str = '', operator_type_name: str = 'Operator', filter_type: hou.EnumValue[hou.nodeTypeFilter] = ..., min_rows: int = 2, max_rows: int = 10, item_size: int = 18, draggable: bool = True) -> None: ...
    def setTitle(self, label: str | None) -> None: ...
    def setDeleteVisible(self, value: bool, warn: bool) -> None: ...
    def setEditVisible(self, value: bool) -> None: ...
    def setJumpVisible(self, value: bool) -> None: ...
    def setChooserVisible(self, value: bool) -> None: ...
    def clearOperators(self) -> None: ...
    def setRelativeNode(self, relative_node: hou.OpNode | None) -> None: ...
    def setOperators(self, operator_path_list: list[str]) -> None: ...
    def rebuildOperators(self) -> None: ...
    def getRelativeNode(self) -> hou.OpNode | None: ...
    def getOperator(self, index: int) -> str: ...
    def getOperators(self) -> list[str]: ...
    def refreshItems(self) -> None: ...
    def getNumItems(self) -> int: ...
    def getItem(self, index: int) -> UiLineEditListItem | None: ...
    def selectItem(self, index: int) -> None: ...
    def unselectItem(self, index: int) -> None: ...
    def addNewOperator(self, path: str) -> int | None: ...
    def updateOperator(self, index: int, path: str) -> None: ...
    def setOnItemSelected(self, fcn: Callable[[UiLineEditListItem, int], object] | None) -> None: ...
    def setOnEditFinished(self, callback: Callable[[int], object] | None) -> None: ...
    def setOnDeleteItem(self, callback: Callable[[int], object] | None) -> None: ...

from typing import ParamSpec
from typing import TypeAlias
from typing import TypeVar
_P = ParamSpec('_P')
_R = TypeVar('_R')
_T = TypeVar('_T')
_SerializedValue: TypeAlias = str | list[float] | tuple[hou.Vector3, hou.Vector3] | hou.UIEventDevice | None
_RecordedValue: TypeAlias = 'None | bool | int | float | str | list[_RecordedValue] | dict[str, _RecordedValue] | BaseState.EventRecorder.MethodDict | hou.OpNode | hou.Vector3'
class _NodeSettings(TypedDict, total=False):
    physics: bool
    drawsimguide: bool
    pivotmode: str

class BulletSim:
    dopsim: hou.DopSimulation
    def __init__(self) -> None: ...
    def setTime(self, time: float) -> None: ...
    def time(self) -> float: ...
    def createCollisionRelationship(self, objects: Sequence[hou.DopObject]) -> hou.DopRelationship: ...
    def addGravity(self, obj: hou.DopData) -> hou.DopData: ...
    def createConstraintNetworkRelationship(self, objects: Sequence[hou.DopObject], relname: str, dataname: str) -> hou.DopData: ...
    def createSoftConstraint(self, constraintrel: hou.DopData, restlength: float = 1.0, stiffness: float = 1.0, disablecollisions: bool = False) -> hou.DopData: ...
    def createGlueConstraint(self, constraintrel: hou.DopData, strength: float = 10000.0, halflife: float = 0.1) -> hou.DopData: ...
    def createPackedObject(self, geo: hou.Geometry) -> hou.DopObject: ...
    def getSimObject(self, index: int) -> hou.DopObject: ...

class MultiTimer:
    duration: float | None
    label: str
    starttime: float | None
    lastduration: float
    enabled: bool
    mode: str | None
    def __init__(self, label: str, mode: str = 'avg') -> None: ...
    def reset(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> float | None: ...
    def stopAndPrint(self) -> None: ...
    def printLastDuration(self) -> None: ...

class BaseState(Incomplete, metaclass=abc.ABCMeta):
    state_name: str
    scene_viewer: hou.SceneViewer
    logger: viewerstate.utils.Logger
    node: hou.LopNode | None
    network: hou.LopNetwork | None
    deltageo: hou.Geometry | None
    deltapointdict: dict[str, hou.Point] | None
    deltachanged: bool
    newdeltageo: hou.Geometry | None
    applychangedpivot: bool
    handleactive: bool
    beginhandle: bool
    haschangestocommit: bool
    handledeltaxform: hou.Matrix4
    handleinitxform: hou.Matrix4
    guidephysicsgeo: hou.Geometry
    guidephysics: hou.SimpleDrawable | None
    selstr: str
    selprimnums: set[int]
    selchildnums: dict[str, list[int]]
    physprimpattern: str
    seldraginitxforms: dict[str, hou.Matrix4]
    snapselectside: bool
    bulletsim: BulletSim | None
    constraintrel: hou.DopData | None
    physicshandlechangedxform: bool
    initsetuptimer: MultiTimer
    setuptimer: MultiTimer
    simtimer: MultiTimer
    setdeltatimer: MultiTimer
    temptimer: MultiTimer
    timers: dict[str, MultiTimer]
    modifyingdelta: bool
    modifyingselection: bool
    forceupdate: bool
    prompt: str | None
    deltapoints: Sequence[hou.Point]
    edittreepanel: None
    parmsthatskipcommit: set[str]
    delayedhandleselection: bool
    xformparmset: set[str]
    pivotparmset: set[str]
    nodesettings: dict[str, _NodeSettings]
    debug_drawconstraints: bool
    generated: bool
    isselectingsecondarypattern: bool
    instance_pattern: re.Pattern[str]
    class PrimData:
        ptnum: int
        point: hou.Point
        inputxform: hou.Matrix4
        initxform: hou.Matrix4
        initdragpos: hou.Vector3
        draginitxform: hou.Matrix4
        def __init__(self) -> None: ...
    @staticmethod
    def addEditBaseParameters(template: hou.ViewerStateTemplate) -> None: ...
    @staticmethod
    def bindParameters(template: hou.ViewerStateTemplate) -> None: ...
    @staticmethod
    def bindHandles(template: hou.ViewerStateTemplate) -> None: ...
    @staticmethod
    def addEditBaseMenuItems(menu: hou.ViewerStateMenu) -> None: ...
    @staticmethod
    def bindMenu(template: hou.ViewerStateTemplate, menu: hou.ViewerStateMenu) -> None: ...
    class EventRecorder:
        events: list[tuple[str, dict[str, JSONValue]]]
        enabled: bool
        class MethodDict:
            """ Provides basic getter methods constructed from a dictionary.
                Every key in the dict is a valid method returning the
                corresponding dict value.
            """
            mydict: dict[str, _RecordedValue]
            def __init__(self, literal: dict[str, _RecordedValue]) -> None: ...
            def __getattribute__(self, name: str) -> Callable[..., _RecordedValue | hou.EnumValue[hou.uiEventReason]]: ...
        @classmethod
        def clear(myclass: type[BaseState.EventRecorder]) -> None: ...
        @classmethod
        def enable(myclass: type[BaseState.EventRecorder]) -> None: ...
        @classmethod
        def disable(myclass: type[BaseState.EventRecorder]) -> None: ...
        @classmethod
        def serializeHook(myclass: type[BaseState.EventRecorder], obj: _T) -> dict[str, _SerializedValue] | _T | None: ...
        @classmethod
        def unserializeHook(myclass: type[BaseState.EventRecorder], literal: dict[str, _RecordedValue]) -> BaseState.EventRecorder.MethodDict | hou.OpNode | hou.Vector3 | dict[str, _RecordedValue] | None: ...
        @classmethod
        def writeEvents(myclass: type[BaseState.EventRecorder], filepath: str) -> None: ...
        @classmethod
        def readEvents(myclass: type[BaseState.EventRecorder], filepath: str) -> list[list[str | dict[str, _RecordedValue]]]: ...
        @classmethod
        def recordEvent(myclass: type[BaseState.EventRecorder], func: Callable[_P, _R]) -> Callable[_P, _R]: ...
    physicsprimdata: list['BaseState.PrimData']
    def __init__(self, state_name: str, scene_viewer: hou.SceneViewer) -> None: ...
    def getOrCreatePerNodeSettings(self) -> _NodeSettings: ...
    def addParmsThatSkipCommit(self, parm_tuple_names: Iterable[str]) -> None: ...
    def physicsEnabled(self) -> bool: ...
    def setPhysicsEnabled(self, enabled: bool) -> None: ...
    def drawsimguideEnabled(self) -> bool: ...
    def setDrawSimGuideEnabled(self, enabled: bool) -> None: ...
    def pivotMode(self) -> str: ...
    def setPivotMode(self, value: str) -> None: ...
    def localXformEnabled(self) -> int: ...
    def setLocalXformEnabled(self, value: int) -> None: ...
    def updateGuides(self) -> None: ...
    @abc.abstractmethod
    def locateObject(self, uievent: hou.UIEvent, get_selection_kind: bool = True) -> tuple[float, str]:
        """ Abstract function that returns a tuple of the depth and
        descriptor for the object currently under the
        mouse.

        uievent - hou.UIEvent
        <optional> get_selection_kind - bool
        """
    @abc.abstractmethod
    def getCorrectDescriptor(self, descriptor: str) -> str:
        """ Abstract function that returns an instance of the
        object identified by the descriptor. For LOPS this might
        be a primitive, for sops it might be geometry.
        """
    @abc.abstractmethod
    def getPrimaryDescriptor(self) -> str | None:
        """ Abstract function that returns the primary descriptor
        which might have to be adjusted.
        """
    @abc.abstractmethod
    def getSelectionPattern(self) -> list[str]:
        """ Abstract function that gets the selection pattern
        appropriately for nodes that implement the edit state.
        """
    @abc.abstractmethod
    def setSelectionPattern(self, sel_str: str) -> None:
        """ Abstract function that sets the selection pattern
        appropriately for nodes that implement the edit state.
        """
    @abc.abstractmethod
    def setViewportSelection(self, selection: Sequence[str]) -> None:
        """ Abstract function that sets the selection for the
        scene viewer. For LOPs and SOPs these will be different
        functions.
        """
    @abc.abstractmethod
    def validatePhysicsSelection(self) -> None:
        """ Abstract function that gets called when the selection
        has changed in physics mode to verify if the new selection
        is valid.
        """
    def normalizePhysicsPaths(self, paths: Iterable[str]) -> list[str]:
        """ Hook for subclasses to canonicalize selection paths before
        they are written to physprimpattern. Default: pass through.
        """
    def getPrimaryObjectXform(self) -> hou.Matrix4: ...
    def isSelectionPatternEmpty(self) -> bool: ...
    def setSelInitXforms(self) -> None: ...
    def applyNewDeltas(self) -> None: ...
    def applyEditsToDuplicatedPoints(self, points_geo: hou.Geometry, first_new_point_index: int, duplicated_points: hou.Geometry, instancer_path: str) -> None: ...
    def handleSelectionChange(self, sel: Collection[str]) -> None: ...
    @abc.abstractmethod
    def getPivotFromSelection(self) -> tuple[hou.Vector3, hou.Vector3, hou.Vector3 | None, hou.Vector3 | None]:
        ''' Abstract method to get the pivot info for the current selection.
        Returns (p, pr, singlelocalp or None, singlelocalpr or None)
            * all values are hou.Vector3
            * p and pr must always be returned
            * the "singlelocal" values will not be None if there is only one
              prim selected, and it has XformCommonAPI from which we can
              extract the local p, pr values from that prim. This information
              is necessary to let the user modify the pivot attributes with
              the handle later.
        '''
    @abc.abstractmethod
    def handleDescriptorDNE(self, simgeo: hou.Geometry, descriptor: str) -> str:
        """ Abstract function that gets called when
        the current descriptor does not exist in the physics
        world.
        """
    @abc.abstractmethod
    def getWorldXformWithoutDelta(self, descriptor: str, deltapointdict: Mapping[str, hou.Point]) -> hou.Matrix4:
        """ Abstact function that returns the xform for the object with the
        id descriptor, without delta.
        """
    def createDragConstraints(self, congeo: hou.Geometry, currentpos: hou.Vector3, singlepath: str | None = None) -> None: ...
    def createSelectionGlueConstraints(self, simgeo: hou.Geometry, congeo: hou.Geometry) -> None: ...
    def createXformConstraints(self, congeo: hou.Geometry, handledeltaxform: hou.Matrix4, reuse: bool = False, localxform: int = False) -> None:
        """
            localxform: when True, the passed in handledeltaxform should be in
            local space
        """
    @EventRecorder.recordEvent
    def onEnter(self, kwargs: ViewerStateEnterKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onResume(self, kwargs: ViewerStateKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onGenerate(self, kwargs: ViewerStateKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onMouseEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onMouseWheelEvent(self, kwargs: ViewerStateEventKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onStartSelection(self, kwargs: ViewerStateSelectionKwargs[list[str]]) -> None: ...
    @EventRecorder.recordEvent
    def onSelection(self, kwargs: ViewerStateSelectionKwargs[list[str]]) -> None: ...
    @EventRecorder.recordEvent
    def onStopSelection(self, kwargs: ViewerStateSelectionKwargs[list[str]]) -> bool: ...
    @EventRecorder.recordEvent
    def onNodeSelectionChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    @EventRecorder.recordEvent
    def onMenuPreOpen(self, kwargs: ViewerStateMenuPreOpenKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onMenuAction(self, kwargs: ViewerStateMenuActionKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onParmChangeEvent(self, kwargs: ViewerStateParmChangeKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onCommand(self, kwargs: ViewerStateCommandKwargs) -> None: ...
    def transformFromSopPoint(self, geo: hou.Geometry) -> hou.Matrix4: ...
    def transformFromNode(self) -> hou.Matrix4: ...
    def xformPivot(self, xform: hou.Matrix4) -> None: ...
    def matrixFromHandleParms(self, handle_parms: Mapping[str, float], include_pivots: bool) -> hou.Matrix4: ...
    def editHandleToState(self, kwargs: ViewerStateHandleToStateKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onBeginHandleToState(self, kwargs: ViewerStateHandleDragKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onHandleToState(self, kwargs: ViewerStateHandleToStateKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onEndHandleToState(self, kwargs: ViewerStateHandleDragKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onParmTupleChanged(self, **kwargs: Unpack[NodeEventKwargs]) -> None: ...
    def addBulletAttribs(self, geo: hou.Geometry) -> None: ...
    @abc.abstractmethod
    def initSimGeo(self, geo: hou.Geometry) -> None:
        """ Abstract function that should initialize the geo
        parameter for simulation purposes.
        """
    def setSimXforms(self, simgeo: hou.Geometry) -> None: ...
    def updateSimXforms(self) -> None: ...
    def zeroSimVelocities(self) -> None: ...
    def getDeltaGeo(self) -> hou.Geometry | None: ...
    def updateDeltaGeoCacheIfNeeded(self) -> None: ...
    def getDeltaPointDict(self) -> dict[str, hou.Point] | None: ...
    def setActive(self, primnumbers: Container[int], onlyadd: bool = False) -> None: ...
    def setViewerStateDeltaGeo(self, deltageo: hou.Geometry | None) -> None: ...
    def setDeltaToSimGeo(self, simgeo: hou.Geometry) -> None: ...
    def stateToEditHandle(self, kwargs: ViewerStateStateToHandleKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onStateToHandle(self, kwargs: ViewerStateStateToHandleKwargs) -> None: ...
    def nothingToEdit(self) -> bool: ...
    def getInputNodeWrapper(self) -> loputils.LopOutputWrapper | None: ...
    def getPrimXform(self, prim: hou.Prim) -> hou.Matrix4: ...
    def getPrimSimXform(self, prim: hou.Prim) -> hou.Matrix4:
        """
            returns the xform as seen by the simulation, with the point
            position set by bullet on the first sim step.
        """
    def initSim(self) -> None: ...
    def updateSimSelection(self) -> None: ...
    def reinitSim(self) -> None: ...
    def enablePhysics(self) -> None: ...
    def commitChangesToNode(self) -> None: ...
    @EventRecorder.recordEvent
    def onExit(self, kwargs: ViewerStateKwargs) -> None: ...
    @EventRecorder.recordEvent
    def onInterrupt(self, kwargs: ViewerStateKwargs) -> None: ...
    def sopGeometryIntersection(self, geometry: hou.Geometry, ray_origin: hou.Vector3, ray_dir: hou.Vector3) -> tuple[int, hou.Vector3, hou.Vector3, hou.Vector3]: ...
    def getCamXform(self) -> hou.Matrix4: ...
    def setWarning(self, warning: str | None = None) -> None:
        """
            Optional function that gets called whenever
            there is a problem with the current selection.
        """
    def updatePrompt(self) -> None: ...

    def consume(self, kind: Kind | None = None) -> Token: ...
    def current(self) -> Token: ...
    def lookahead(self, distance: int) -> Token: ...
    def current_infix(self) -> Parselet | None: ...
    def infix_precedence(self) -> int: ...
    def expression(self, precedence: int = 0) -> JsonPath: ...
    def parse(self) -> JsonPath: ...


class Token(NamedTuple):
    kind: Kind
    payload: str
    pos: int

ws_expr: re.Pattern[str]

def hashable(value: JsonValue) -> int | float | str | tuple[JsonValue, ...] | None: ...
def to_index(string: str) -> int: ...
def get_keys(value: JsonValue) -> list[JsonValue]: ...
def get_items(value: JsonValue) -> list[JsonValue]: ...
def regex_compare(expr: JsonValue, target: JsonValue) -> bool: ...
def lex_string_literal(text: str, pos: int) -> tuple[Token, int] | None: ...

token_exprs: dict[Kind, str | re.Pattern[str] | LexerFn]

def lex_token(text: str, pos: int) -> tuple[Token, int] | None: ...
def lex(text: str) -> list[Token]: ...

class Match(NamedTuple):
    value: JsonValue
    key: _MatchKey
    parents: tuple[Match, ...]
    name: str | None = ...
    env: dict[str, JsonValue] | None = ...
    debug: bool = ...
    debug_indent: int = ...
    @property
    def root(self) -> Match: ...
    def replace_value(self, value: JsonValue) -> Match: ...
    def push_parent(self, key: _MatchKey, value: JsonValue, name: str | None = None) -> Match: ...
    def path(self) -> tuple[_MatchKey, ...]: ...
    def bindings(self) -> dict[str, JsonValue]: ...
    def add_debug_level(self) -> Match: ...

def every_child(obj: JsonPath, match: Match) -> Iterator[Match]: ...
def debug_msg(obj: JsonPath, match: Match, msg: str) -> None: ...

class JsonPath:
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def find(self, match: JSONLike | Match, env: dict[str, JsonValue] | None = None, debug: bool = False) -> Iterable[Match]: ...
    def values(self, data: JSONLike, debug: bool = False) -> list[JsonValue]: ...
    def itervalues(self, data: JSONLike, debug: bool = False) -> Iterator[JsonValue]: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...
    def literal_value(self) -> JsonValue: ...

class BinaryJsonPath(JsonPath):
    left: JsonPath
    right: JsonPath
    def __init__(self, left: JsonPath, right: JsonPath) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...

class UnaryJsonPath(JsonPath):
    child: JsonPath
    def __init__(self, child: JsonPath) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def pos(self) -> int: ...
    def set_pos(self, pos: int) -> None: ...


class Parselet:
    def parse_prefix(self, parser: Parser, token: Token) -> JsonPath: ...
    def parse_infix(self, parser: Parser, left: JsonPath, token: Token) -> JsonPath: ...
    def precedence(self) -> int: ...

class GroupParselet(Parselet):
    def parse_prefix(self, parser: Parser, token: Token) -> JsonPath: ...

class SingletonParselet(Parselet):
    path: JsonPath
    def __init__(self, path: JsonPath) -> None: ...
    def parse_prefix(self, parser: Parser, token: Token) -> JsonPath: ...

class KeyParselet(Parselet):
    def parse_prefix(self, parser: Parser, token: Token) -> JsonPath: ...

class VarParselet(Parselet):

import enum
import re
from collections.abc import Iterator
from houtypes import JSONLike
from typing import Callable, Iterable, NamedTuple, Protocol, TypeAlias

from typing import TypeAlias
from typing import Any
JsonValue: TypeAlias = int | float | str | list['JsonValue'] | tuple['JsonValue', ...] | dict[str, 'JsonValue'] | None
LexerFn: TypeAlias = Callable[[str, int], 'tuple[Token, int] | None']
_Operator: TypeAlias = Callable[[Any, Any], JsonValue]
_MatchKey: TypeAlias = str | int | float | None
__all__ = ['JsonValue', 'JsonPath', 'ParserError', 'BinaryJsonPath', 'UnaryJsonPath', 'Root', 'This', 'Parent', 'Every', 'Literal', 'Child', 'Where', 'Descendants', 'Or', 'Merge', 'Intersect', 'Discard', 'Key', 'Index', 'Bind', 'TransformFunction', 'LookupComputedKey', 'Comparison', 'Math', 'Wildcard', 'parse']


class _PathMaker(Protocol):
    def __call__(self, *args: JsonPath) -> JsonPath: ...

class ParserError(Exception): ...


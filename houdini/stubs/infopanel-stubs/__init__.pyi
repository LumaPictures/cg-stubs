from hutil.PySide import QtGui
from hutil.qt.data.panels import _HudRow
from typing import Sequence

class HudInfoPanel:
    def __init__(self, width: int = 1920, height: int = 1080, title: str = 'HUD Info Panel', icon: str = 'MISC_donut', description: str = '', bold_values: bool = True, fill_background: bool = True, shadowed: bool = True, visualsize: int = 3) -> None: ...
    def setInfoTemplate(self, rows: Sequence[_HudRow]) -> None: ...
    def save(self, filepath: str) -> None: ...
    def grab(self) -> QtGui.QImage: ...

def plain(label: str = 'Label', value: str = '', wide: bool = False) -> _HudRow: ...
def frame(label: str = 'Label', num: str = '', seq: str = '') -> _HudRow: ...
def renderTime(label: str = 'Label', value: Sequence[float] | None = None) -> _HudRow: ...
def spacer(label: str = 'Spacer') -> _HudRow: ...
def choiceGraph(count: int = 3, value: int = 0) -> _HudRow: ...
def barGraph(value: float = 0) -> _HudRow: ...

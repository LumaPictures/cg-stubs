from collections.abc import Mapping
from hutil.PySide import QtGui
from typing import Sequence

class HudInfoPanel:
    def __init__(self, width: int = 1920, height: int = 1080, title: str = 'HUD Info Panel', icon: str = 'MISC_donut', description: str = '', bold_values: bool = True, fill_background: bool = True, shadowed: bool = True, visualsize: int = 3) -> None: ...
    def setInfoTemplate(self, rows: Sequence[Mapping[str, object]]) -> None: ...
    def save(self, filepath: str) -> None: ...
    def grab(self) -> QtGui.QImage: ...

def plain(label: str = 'Label', value: str = '', wide: bool = False) -> dict[str, str | bool]: ...
def frame(label: str = 'Label', num: str = '', seq: str = '') -> dict[str, str]: ...
def renderTime(label: str = 'Label', value: Sequence[float] | None = None) -> dict[str, str]: ...
def spacer(label: str = 'Spacer') -> dict[str, str]: ...
def choiceGraph(count: int = 3, value: int = 0) -> dict[str, str | int]: ...
def barGraph(value: float = 0) -> dict[str, str | float]: ...

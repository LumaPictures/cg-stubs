    def config(self) -> OCIO.Config: ...
    def copyOfConfig(self) -> OCIO.Config: ...
    def setConfig(self, config: OCIO.Config) -> None: ...
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def canDelete(self) -> bool: ...
    def canUndo(self) -> bool: ...
    def canRedo(self) -> bool: ...

class MessageBoard(hutil.qt.messageboard.MessageBoard):
    def __init__(self) -> None: ...
    def hideMessages(self) -> None: ...

class RuleModel(QtCore.QAbstractTableModel):
    column_labels: tuple[str, ...]
    NameColumn: int
    PatternColumn: int
    ExtensionColumn: int
    RegexColumn: int
    SpaceColumn: int
    ItemRole: int
    def __init__(self, config: OCIO.Config, parent: PySide6.QtCore.QObject | None = None) -> None: ...
    def config(self) -> OCIO.Config: ...
    def setConfig(self, config: OCIO.Config) -> None: ...
    def setDragIcon(self, pixmap: PySide6.QtGui.QPixmap) -> None: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def headerData(self, section: int, orientation: PySide6.QtCore.Qt.Orientation, role: int = ...) -> str | PySide6.QtCore.QSize | None: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> str | PySide6.QtGui.QPixmap | PySide6.QtGui.QFont | PySide6.QtCore.QSize | None: ...
    def setData(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, value: object, role: int = ...) -> bool: ...
    def isDefaultRule(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...
    def insertRule(self, index: int, name: str, space: str, pattern: str | None = '', ext: str | None = '', regex: str | None = '') -> None: ...
    def removeRow(self, row: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> None: ...
    def moveRow(self, src_parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, source_row: int, dest_parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, dest_row: int) -> bool: ...
    def supportedDropActions(self) -> PySide6.QtCore.Qt.DropAction: ...
    def mimeTypes(self) -> list[str]: ...
    def canDropMimeData(self, data: PySide6.QtCore.QMimeData, action: PySide6.QtCore.Qt.DropAction, row: int, column: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...
    def mimeData(self, indexes: Sequence[PySide6.QtCore.QModelIndex]) -> PySide6.QtCore.QMimeData: ...
    def dropMimeData(self, data: PySide6.QtCore.QMimeData, action: PySide6.QtCore.Qt.DropAction, row: int, column: int, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> bool: ...

class NewRuleDialog(QtWidgets.QDialog):
    def __init__(self, config: OCIO.Config, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def ruleName(self) -> str: ...
    def isRegex(self) -> bool: ...
    def pattern(self) -> str: ...
    def ext(self) -> str: ...
    def regex(self) -> str: ...
    def colorSpaceName(self) -> str: ...


    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None, components: int = 1, is_vector: bool = False) -> None: ...
    @staticmethod
    def typeName() -> str: ...
    def getValue(self, hud_window: WidgetBundleWindow, **kwargs: object) -> float | hou.Vector2 | hou.Vector3 | hou.Vector4 | list[float] | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: float | hou.Vector2 | hou.Vector3 | hou.Vector4 | Sequence[float]) -> None: ...
    def triggerWidgetChanged(self, widget: QtWidgets.QWidget, value: float | Sequence[float]) -> None: ...
    def loadValueFromConfig(self, config: AbstractConfig, name: str) -> float | None: ...
    def saveValueToConfig(self, config: AbstractConfig, name: str, value: float) -> None: ...

class StringParm(HUDParm[str | None, str]):
    """
    A class for managing string parameters.
    """
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None) -> None: ...

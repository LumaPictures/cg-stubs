    @typing.overload
    def getValue(self, hud_window: WidgetBundleWindow, menus_as_int: bool, **kwargs: object) -> int | str | list[str] | None: ...
    def getAltValue(self, hud_window: WidgetBundleWindow) -> str | list[str] | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: int | tuple[str | None, bool]) -> None: ...

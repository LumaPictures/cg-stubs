    def getValue(self, hud_window: WidgetBundleWindow, **kwargs: object) -> str | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: str) -> None: ...
    def triggerChangedEvent(self, hud_window: WidgetBundleWindow) -> None: ...

class MenuParm(HUDParm[int | str | None, int | str]):
    """
    A class for managing ordered menu parameters.
    """
    menu_tokens: Sequence[str]
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None, menu_tokens: Sequence[str]) -> None: ...
    @staticmethod
    def typeName() -> str: ...
    def menuTokens(self) -> Sequence[str]: ...
    @typing.overload
    def getValue(self, hud_window: WidgetBundleWindow, menus_as_int: Literal[True] = ..., **kwargs: object) -> int | None: ...
    @typing.overload
    def getValue(self, hud_window: WidgetBundleWindow, menus_as_int: Literal[False], **kwargs: object) -> str | None: ...
    @typing.overload
    def getValue(self, hud_window: WidgetBundleWindow, menus_as_int: bool, **kwargs: object) -> int | str | None: ...
    def getAltValue(self, hud_window: WidgetBundleWindow) -> str | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: int | str) -> None: ...
    def loadFromConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def saveToConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def triggerChangedEvent(self, hud_window: WidgetBundleWindow) -> None: ...


import hou
import typing
from PySide6 import QtWidgets as QtWidgets
from collections.abc import Callable as Callable, Sequence
from enum import Enum
from statehud.baseconfig import AbstractConfig as AbstractConfig
from statehud.window import WidgetBundleWindow as WidgetBundleWindow
from typing import Generic, Literal

from typing import TypeAlias
from typing import TypeVar
from typing import Never
from typing import TypeAlias
from typing_extensions import TypeVar
_HUDParmValue: TypeAlias = bool | int | float | str | list[int] | list[float] | list[str] | hou.Vector2 | hou.Vector3 | hou.Vector4 | None
_NumT = TypeVar('_NumT', int, float)
_GetT_co = TypeVar('_GetT_co', covariant=True, default=_HUDParmValue)
_SetT_contra = TypeVar('_SetT_contra', contravariant=True, default=Never)
class ParmEvent(Enum):
    Start = 0
    Active = 1
    Changed = 2
    HotkeyInvoked = 3
    ContextMenuAction = 4
    SelectionChanged = 5

class HUDParm(Generic[_GetT_co, _SetT_contra]):
    """
    A base class to be overloaded when creating a new parameter type
    that is compatible with the python viewer state HUDs.
    """
    parm_name: str
    tab_widget_name: str | None
    tab_name: str | None
    callback: Callable[..., object] | None
    callback_args: int
    active: bool
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None) -> None: ...
    def isActive(self) -> bool: ...
    def setActive(self, on: bool) -> None: ...
    def name(self, prefix: str = '') -> str: ...
    def tabWidgetName(self) -> str | None: ...
    def tabName(self) -> str | None: ...
    @staticmethod
    def typeName() -> str | None: ...
    def hasComponents(self) -> bool: ...
    def getComponent(self, i: int) -> str | None: ...
    def getComponents(self) -> list[str] | None: ...
    def getComponentIndex(self, component_name: str) -> int | None: ...
    def getValue(self, hud_window: WidgetBundleWindow, **kwargs: object) -> _GetT_co: ...
    def getAltValue(self, hud_window: WidgetBundleWindow) -> str | list[str] | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: _SetT_contra) -> None: ...
    def saveToConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def loadFromConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def setCallback(self, callback: Callable[..., object] | None) -> None: ...
    def executeCallback(self, *args: object) -> None: ...
    def triggerHotkey(self, hud_window: WidgetBundleWindow, hotkey: str, index: int | None) -> None: ...
    def triggerChangedEvent(self, hud_window: WidgetBundleWindow) -> None: ...

class ToggleParm(HUDParm[bool, bool]):
    """
    A class for managing toggle type parameters.
    """
    outer_name: str | None
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None, outer_name: str | None = None) -> None: ...
    @staticmethod
    def typeName() -> str: ...
    def getValue(self, hud_window: WidgetBundleWindow, **kwargs: object) -> bool: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: bool) -> None: ...
    def loadFromConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def saveToConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def triggerHotkey(self, hud_window: WidgetBundleWindow, hotkey: str, index: int | None) -> None: ...
    def triggerChangedEvent(self, hud_window: WidgetBundleWindow) -> None: ...

class NumericParm(HUDParm[_GetT_co, _SetT_contra], Generic[_NumT, _GetT_co, _SetT_contra]):
    """
    A base class for managing integer and float slider parameters.
    """
    components: int
    is_vector: bool
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None, components: int, is_vector: bool) -> None: ...
    def hasComponents(self) -> bool: ...
    def getComponent(self, i: int, force: bool = False) -> str | None: ...
    def getComponents(self) -> list[str] | None: ...
    def triggerHotkey(self, hud_window: WidgetBundleWindow, hotkey: str, index: int | None) -> None: ...
    def triggerChangedEvent(self, hud_window: WidgetBundleWindow) -> None: ...
    def triggerWidgetChanged(self, widget: QtWidgets.QWidget, value: _NumT | Sequence[_NumT]) -> None: ...
    def loadFromConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def loadValueFromConfig(self, config: AbstractConfig, name: str) -> _NumT | None: ...
    def saveToConfig(self, hud_window: WidgetBundleWindow, config: AbstractConfig, prefix: str = '') -> None: ...
    def saveValueToConfig(self, config: AbstractConfig, name: str, value: _NumT) -> None: ...

class IntegerParm(NumericParm[int, int | list[int] | None, int | Sequence[int]]):
    """
    A class for managing integer slider parameters.
    """
    def __init__(self, parm_name: str, tab_widget_name: str | None, tab_name: str | None, components: int = 1, is_vector: bool = False) -> None: ...
    @staticmethod
    def typeName() -> str: ...
    def getValue(self, hud_window: WidgetBundleWindow, **kwargs: object) -> int | list[int] | None: ...
    def setValue(self, hud_window: WidgetBundleWindow, value: int | Sequence[int]) -> None: ...
    def triggerWidgetChanged(self, widget: QtWidgets.QWidget, value: int | Sequence[int]) -> None: ...
    def loadValueFromConfig(self, config: AbstractConfig, name: str) -> int | None: ...
    def saveValueToConfig(self, config: AbstractConfig, name: str, value: int) -> None: ...

class FloatParm(NumericParm[float, float | hou.Vector2 | hou.Vector3 | hou.Vector4 | list[float] | None, float | Sequence[float]]):
    """
    A class for managing float slider parameters.

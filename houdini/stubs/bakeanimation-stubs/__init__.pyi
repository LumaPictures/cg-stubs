import hou
from collections.abc import MutableSequence, Sequence

def matchesPattern(pattern: str, n: str) -> bool: ...
def getConstrainedObjects(n: hou.OpNode) -> str: ...
def channelNames(n: hou.OpNode, t: int) -> str: ...
def createChannelNames(n: hou.OpNode) -> str: ...
def targetChannelNames(n: hou.OpNode) -> str: ...
def removeLockedChannelNames(n: hou.ChopNode) -> str: ...
def renameChannelNames(n: hou.ChopNode) -> str: ...
def sort_by_ancestor(a: Sequence[hou.Node | int | None], b: Sequence[hou.Node | int | None]) -> int: ...

class BakeAnimation:
    n: hou.OpNode
    hda: hou.OpNode
    messages: list[str]
    parm_filter: str
    copy_parms: int
    delete_animation: int
    revert_parms: int
    write_to_chop_channel: int
    user_samples: list[float]
    refit: bool
    refit_tol: float
    refit_preserve_extremas: bool
    refit_bezier: bool
    refit_smooth: bool
    resample: bool
    resample_tol: float
    range_: bool
    bake_chop: hou.EnumValue[hou.parmBakeChop]
    resample_rate: float
    start_frame: float
    end_frame: float
    operation: hou.InterruptableOperation
    chop_nodes: set[hou.ChopNode]
    chop_parms: list[list[hou.Parm]]
    def __init__(self, n: hou.OpNode) -> None: ...
    def disableConstraint(self, c: hou.OpNode | None) -> bool: ...
    def getConstraintExportTransforms(self, c: hou.OpNode | None) -> hou.Parm | None: ...
    def processParm(self, src_node: hou.OpNode, src_parm: hou.Parm, dst_node: hou.OpNode, gather: bool = False) -> None: ...
    def processParms(self, source: str, target: str) -> None: ...
    def gatherParms(self, source: str, target: str) -> None: ...
    def extractChopParmOverrides(self, p: hou.Parm | None) -> None: ...
    def extractChopOverrides(self, source: str, target: str, controls: hou.OpNode, bake: hou.ChopNode) -> None: ...
    def bakeObj(self, source: str, target: str, controls: hou.OpNode, bake: hou.ChopNode, stash: hou.OpNode, compare: hou.ChopNode) -> None: ...
    def refitKeyframes(self, p: hou.Parm, expr: str = '') -> None: ...
    def reorderByTargetDependencyOrder(self, source: MutableSequence[str], target: MutableSequence[str]) -> None: ...
    def bakeRange(self) -> None: ...
    def bake(self) -> None: ...
    def log(self) -> None: ...

def onBakeRig(n: hou.OpNode) -> None: ...

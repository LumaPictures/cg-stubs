from collections.abc import Mapping
from typing import Generic

from typing import TypeVar
from typing import Any
from typing import TypeVar
_V = TypeVar('_V', default=Any)
class StorageInterface(Generic[_V]):
    bindings: Mapping[str, str]
    reverseBindings: dict[str, str]
    def __init__(self, bindings: Mapping[str, str]) -> None: ...
    def getStorageVal(self, storageKey: str) -> _V: ...
    def storeStorageVal(self, storageKey: str, val: _V) -> None: ...
    def getHUDParmByStorageKey(self, storageKey: str) -> str | None: ...
    def loadParmByStorageKey(self, storageKey: str) -> tuple[str | None, _V]: ...
    def loadParmFromStorage(self, parm: str) -> _V | None: ...
    def saveParmToStorage(self, parm: str, val: _V) -> None: ...

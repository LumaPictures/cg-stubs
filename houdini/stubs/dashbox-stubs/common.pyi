import PySide6.QtGui
import hou
import re
import typing
from .ui import DashWindow as DashWindow
from collections.abc import Iterator, ValuesView
from difflib import SequenceMatcher
from typing import Callable as Callable, Iterable, Self, Sequence, TypeVar

from typing import TypeVar
from typing import Union as Union
T = TypeVar('T')
TAG_NORMAL: int

def blankIcon() -> PySide6.QtGui.QIcon: ...

BLANK_ICON: PySide6.QtGui.QIcon
hashtag_expr: re.Pattern[str]

def sugList(sugx: Sug | Sequence[Hit] | Iterator[Hit] | None) -> list[Hit]: ...
def fuzzyWordMatch(sm: SequenceMatcher[str], seq1: str, seq2: str) -> float: ...
def substrMatch(q: str, target: str) -> float: ...
def matchFn(text: str, fuzzy: bool = True, union: bool = False) -> Callable[[str], float]: ...

class Tag:
    text: str
    kind: int
    desc: str
    source: Callable[[], TagSource | None]
    def __init__(self, text: str, desc: str = '', kind: int = ..., source: TagSource | None = None) -> None: ...
    def withSource(self, source: TagSource) -> Tag: ...

class TagSource:
    def __init__(self) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __contains__(self, text: str | Tag) -> bool: ...
    def values(self) -> ValuesView[Tag]: ...
    def addTag(self, tag: Tag) -> None: ...
    def add(self, text: str, desc: str, kind: int = ...) -> None: ...
    def tag(self, text: str, desc: str = '', kind: int = ..., add: bool = False) -> Tag: ...
    def clear(self) -> None: ...

class SearchSpec:
    fragments: Sequence[Tag | str]
    taglist: tuple[Tag, ...]
    tagset: set[str]
    def __init__(self, fragments: Sequence[Tag | str], fuzzy: bool = False, union: bool = False, defuzz_factor: int = 0) -> None: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, tagname: str | Tag) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def cancel(self) -> None: ...
    def isFuzzy(self) -> bool: ...
    def setFuzzy(self, fuzzy: bool) -> None: ...
    def isUnion(self) -> bool: ...
    def setUnion(self, union: bool) -> None: ...
    def hasText(self) -> bool: ...
    def hasTags(self) -> bool: ...
    def plaintext(self) -> str: ...
    def withoutTags(self) -> str: ...
    def hasAny(self, tags: Iterable[str | Tag]) -> bool: ...
    def hasTag(self, tagname: str) -> bool: ...
    def hasWord(self, word: str) -> bool: ...
    def matchFn(self, fuzzy: bool | None = None) -> Callable[[str], float]: ...
    @typing.overload
    def hits(self, hitmaker: Callable[[str], Hit], targets: Iterable[str], key: None = ...) -> list[Hit]: ...
    @typing.overload
    def hits(self, hitmaker: Callable[[T], Hit], targets: Iterable[T], key: Callable[[T], str]) -> list[Hit]: ...

class Category:
    """
    Search category that generates list of ResultItem
    """
    setup_time: float
    search_time: float
    def __init__(self) -> None: ...
    def knownTags(self) -> Sequence[Tag]: ...
    def label(self) -> str: ...
    def icon(self) -> PySide6.QtGui.QIcon: ...
    def suggestedInputs(self) -> str | Sequence[str]: ...
    def initialSuggestions(self) -> Sug | Sequence[Hit] | None: ...
    def suggestions(self, search: SearchSpec, matched: int) -> Sug | Sequence[Hit] | None: ...
    def hits(self, search: SearchSpec) -> tuple[float, list[Hit]]: ...
    def heading(self, search: SearchSpec) -> Heading: ...

class Hit:
    score: float
    def __init__(self) -> None: ...
    def isHeading(self) -> bool: ...
    def skippable(self) -> bool: ...
    def isCompletion(self) -> bool: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str | None: ...
    def icon(self) -> PySide6.QtGui.QIcon | None: ...
    def toolTip(self) -> str: ...
    def prompt(self) -> str: ...
    def hasNext(self) -> bool: ...
    def enter(self) -> Sequence[Category]: ...
    def closeAfterAction(self) -> bool: ...
    def action(self, dashbox: DashWindow) -> None: ...
    def background(self) -> PySide6.QtGui.QColor | PySide6.QtGui.QBrush | None: ...
    def hasCompletion(self) -> bool: ...
    def completion(self) -> str: ...

class Heading(Hit):
    def __init__(self, label: str, secondary_label: str | None = None, icon: PySide6.QtGui.QIcon | None = None, tooltip: str = '') -> None: ...
    def isHeading(self) -> bool: ...
    def skippable(self) -> bool: ...
    def label(self) -> str: ...
    def icon(self) -> PySide6.QtGui.QIcon | None: ...
    def secondaryLabel(self) -> str | None: ...
    def toolTip(self) -> str: ...

class Sug(Hit):
    def __init__(self, suggested: str, label: str | None = None, icon_name: str | None = None, completion_index: int | None = None) -> None: ...
    @classmethod
    def fromTag(cls, tag: Tag, completion_index: int | None = None) -> Self: ...
    def skippable(self) -> bool: ...
    def icon(self) -> hou.qt.Icon: ...
    def label(self) -> str: ...
    def secondaryLabel(self) -> str | None: ...
    def closeAfterAction(self) -> bool: ...
    def action(self, dashbox: DashWindow) -> None: ...
    def isCompletion(self) -> bool: ...
    def completionIndex(self) -> int | None: ...
    def completion(self) -> str: ...
    def background(self) -> PySide6.QtGui.QColor: ...

def defaultClasses() -> tuple[type[Category], ...]: ...
def defaultCategories() -> list[Category]: ...
def findPaneTab(pt_type: hou.EnumValue[hou.paneTabType], cond: Callable[[hou.PaneTab], bool] = ...) -> hou.PaneTab | None: ...

class HitModel(QtCore.QAbstractListModel):
    """
    Item model to display dash hits in a list view.
    """
    ITEM_ROLE: int
    def __init__(self, parent: PySide6.QtWidgets.QWidget | None = None) -> None: ...
    def isAllHeadings(self) -> bool: ...
    def setHits(self, hits: list[Hit]) -> None: ...
    def hitAt(self, i: int) -> Hit: ...
    def flags(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex) -> PySide6.QtCore.Qt.ItemFlag | None: ...
    def columnCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def rowCount(self, parent: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex | None = None) -> int: ...
    def data(self, index: PySide6.QtCore.QModelIndex | PySide6.QtCore.QPersistentModelIndex, role: int = ...) -> Hit | str | PySide6.QtGui.QFont | PySide6.QtCore.QSize | PySide6.QtGui.QIcon | PySide6.QtCore.Qt.AlignmentFlag | None: ...

class DashWindow(QtWidgets.QDialog):

import hou
from ..common import Category as Category, Hit as Hit, SearchSpec as SearchSpec, Sug as Sug, Tag as Tag
from ..ui import DashWindow as DashWindow

PANE_TYPE_LABELS: dict[hou.EnumValue[hou.paneTabType], str]
PANE_ICON: hou.qt.Icon
CREATE_ICON: hou.qt.Icon

def tabLabel(tab: hou.PaneTab) -> str: ...

class PaneTabCategory(Category):
    DESC: str
    TAG1: Tag
    TAG2: Tag
    def __init__(self) -> None: ...
    def knownTags(self) -> list[Tag]: ...
    def label(self) -> str: ...
    def icon(self) -> hou.qt.Icon: ...
    def suggestedInputs(self) -> list[str]: ...
    def initialSuggestions(self) -> Sug: ...
    def hits(self, search: SearchSpec) -> tuple[float, list[Hit]]: ...

class PaneTabHit(Hit):
    score: float
    def __init__(self, tab: hou.PaneTab, label: str, score: float = 0.0) -> None: ...
    def label(self) -> str: ...
    def icon(self) -> hou.qt.Icon: ...
    def secondaryLabel(self) -> str: ...
    def prompt(self) -> str: ...
    def action(self, dashbox: DashWindow) -> None: ...

class CreatePaneHit(PaneTabHit):
    score: float
    def __init__(self, panetype: hou.EnumValue[hou.paneTabType], label: str, score: float = 0.0) -> None: ...
    def icon(self) -> hou.qt.Icon: ...
    def prompt(self) -> str: ...
    def action(self, dashbox: DashWindow) -> None: ...

class CreatePyPanelHit(CreatePaneHit):
    score: float
    def __init__(self, iface_name: str, label: str, score: float = 0.0) -> None: ...
    def action(self, dashbox: DashWindow) -> None: ...

import datetime
import hou
import typing
from hutil.Qt import QtCore, QtGui, QtWidgets

QUICKNAV_KEY: str
ICON_SIZE: int
NETBOX_ICON: QtGui.QIcon
DEFAULT_WINDOW_WIDTH: int
DEFAULT_WINDOW_HEIGHT: int

def tintedIcon(icon: QtGui.QIcon, qcolor: QtGui.QColor, alpha: float = 0.5) -> QtGui.QIcon: ...

class ItemRef:
    ItemTypes: tuple[hou.EnumValue[hou.networkItemType], hou.EnumValue[hou.networkItemType]]
    def __init__(self, path: str, itemtype: hou.EnumValue[hou.networkItemType]) -> None: ...
    @typing.overload
    @classmethod
    def forItem(cls, netitem: hou.Node) -> NodeRef: ...
    @typing.overload
    @classmethod
    def forItem(cls, netitem: hou.NetworkBox) -> NetboxRef: ...
    @typing.overload
    @classmethod
    def forItem(cls, netitem: hou.NetworkMovableItem) -> NodeRef | NetboxRef: ...
    @classmethod
    def forPath(cls, path: str) -> NodeRef | NetboxRef: ...
    def parent(self, allow_boxes: bool = False) -> NodeRef | NetboxRef | None: ...
    def netitem(self) -> hou.NetworkMovableItem | None: ...
    def path(self) -> str: ...
    def namePath(self, allow_boxes: bool = False) -> str: ...
    def icon(self) -> QtGui.QIcon | None: ...
    def name(self) -> str | None: ...
    def exists(self) -> bool: ...
    def childNames(self) -> list[str | None]: ...
    def hasChildren(self) -> bool: ...
    def rowCount(self) -> int: ...
    def rowForName(self, name: str | None) -> int: ...
    def row(self) -> int | None: ...
    def childAt(self, row: int) -> NodeRef | NetboxRef | None: ...
    def childNamed(self, name: str) -> NodeRef | NetboxRef | None: ...
    def children(self) -> list[NodeRef | NetboxRef]: ...
    def sortKey(self) -> tuple[int, str | None]: ...

class NetboxRef(ItemRef):
    def __init__(self, path: str) -> None: ...
    def icon(self) -> QtGui.QIcon | None: ...
    def typeName(self) -> str: ...
    def typeCategoryName(self) -> str: ...
    def sortKey(self) -> tuple[int, str | None]: ...

class NodeRef(ItemRef):
    def __init__(self, path: str) -> None: ...
    def icon(self) -> QtGui.QIcon | None: ...
    def netitem(self) -> hou.OpNode | None: ...
    def typeName(self) -> str | None: ...
    def categoryName(self) -> str | None: ...

class NetworkTreeModel(QtCore.QAbstractItemModel):
    AbsolutePathRole: int
    RelativePathRole: int
    NamePathRole: int
    ItemName: int
    ItemTypeCategory: int
    ItemType: int
    Comment: int
    CreationTime: int
    ModificationTime: int
    Creator: int
    CreatorState: int
    BuiltExplicitly: int
    TimeDependent: int
    Hidden: int
    def __init__(self, parent: QtCore.QObject | None = None) -> None: ...
    def rootItem(self) -> NodeRef | NetboxRef: ...
    def rootPath(self) -> str: ...
    def setRootPath(self, rootpath: str) -> None: ...
    def clear(self) -> None: ...
    def indexForItem(self, netitem: hou.NetworkMovableItem, column: int = 0) -> QtCore.QModelIndex: ...
    def indexForPath(self, path: str, column: int = 0) -> QtCore.QModelIndex: ...
    def index(self, row: int, column: int, parentindex: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> QtCore.QModelIndex: ...
    def parent(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> QtCore.QModelIndex: ...
    def hasChildren(self, parentindex: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> bool: ...
    def rowCount(self, parentindex: QtCore.QModelIndex | QtCore.QPersistentModelIndex | None = None) -> int: ...
    def columnCount(self, _: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> int: ...
    def data(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex, role: int) -> QtGui.QIcon | str | datetime.datetime | hou.OpNode | bool | None: ...

class NodePathCompleter(QtWidgets.QCompleter):
    def splitPath(self, path: str) -> list[str]: ...
    def pathFromIndex(self, index: QtCore.QModelIndex | QtCore.QPersistentModelIndex) -> str: ...

class NavLineEdit(QtWidgets.QLineEdit):
    def selectionRange(self) -> tuple[int, int]: ...

class QuickNavWindow(QtWidgets.QWidget):
    editor: hou.NetworkEditor
    def __init__(self, editor: hou.NetworkEditor) -> None: ...
    @staticmethod
    def divable(netitem: hou.Node) -> bool: ...
    def clearToRoot(self) -> None: ...
    def take(self) -> None: ...
    def untake(self) -> None: ...
    def slash(self) -> bool: ...
    def eventFilter(self, obj: QtCore.QObject, event: QtCore.QEvent) -> bool: ...
    def keyPressEvent(self, event: QtGui.QKeyEvent) -> None: ...
    def resetInterface(self) -> None: ...
    def showEvent(self, event: QtGui.QShowEvent) -> None: ...
    def changeEvent(self, event: QtCore.QEvent) -> None: ...
    def selectLastPathElement(self) -> None: ...
    def setNetworkPath(self, path: str, hilite: bool = True) -> None: ...
    def highlight(self, netitem: hou.NetworkMovableItem) -> None: ...
    def highlightSelected(self) -> None: ...
    def selectSearchString(self) -> None: ...
    def selectItem(self, path: str) -> None: ...
    def cancel(self) -> None: ...
    def accept(self) -> None: ...

def showQuickNav(editor: hou.NetworkEditor) -> QuickNavWindow: ...
